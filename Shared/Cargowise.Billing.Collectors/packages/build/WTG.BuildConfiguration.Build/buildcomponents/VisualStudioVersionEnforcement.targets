<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
		<WTGBranchMinVisualStudioVersion>16.0</WTGBranchMinVisualStudioVersion>
		<WTGBranchMinVisualStudioVersionName>Visual Studio 2019</WTGBranchMinVisualStudioVersionName>

		<BuildDependsOn>WTGValidateVisualStudioVersion;$(BuildDependsOn)</BuildDependsOn>
	</PropertyGroup>

	<Target Name="WTGValidateVisualStudioVersion">
		<Error
			Text="This branch requires $(WTGBranchMinVisualStudioVersionName) ($(WTGBranchMinVisualStudioVersion)) or higher to build. You are using $(VisualStudioVersion)."
			Condition="'$(WTGBranchMinVisualStudioVersion)' &gt; '$(VisualStudioVersion)'" />
	</Target>

</Project>
