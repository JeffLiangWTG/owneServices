<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
		<WTGAllPackagesPath Condition=" '$(WTGPaketBuildItemsGroupName)' != '' ">$(WTGPaketPackagesRoot)\$(WTGPaketBuildItemsGroupName)</WTGAllPackagesPath>
		<WTGAllPackagesPath Condition=" '$(WTGPaketBuildItemsGroupName)' == '' ">$(WTGPaketPackagesRoot)</WTGAllPackagesPath>
	</PropertyGroup>
	<Import Project="$(WTGAllPackagesPath)\WTG.BuildConfiguration.Analysis\build\WTG.BuildConfiguration.Analysis.props"/>
	<Import Project="$(WTGAllPackagesPath)\WTG.BuildConfiguration.Build\build\WTG.BuildConfiguration.Build.props"/>
	<Import Project="$(WTGAllPackagesPath)\WTG.BuildConfiguration.Signing\build\WTG.BuildConfiguration.Signing.props"/>
</Project>
