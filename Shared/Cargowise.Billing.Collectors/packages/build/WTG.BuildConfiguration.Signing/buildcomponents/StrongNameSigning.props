<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
	</PropertyGroup>
	<PropertyGroup Condition="'$(WTGStrongNameSigning)' != 'False'">
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\keys\EDI-Release-private.snk</AssemblyOriginatorKeyFile>
		<SignAssembly>true</SignAssembly>
	</PropertyGroup>
</Project>
