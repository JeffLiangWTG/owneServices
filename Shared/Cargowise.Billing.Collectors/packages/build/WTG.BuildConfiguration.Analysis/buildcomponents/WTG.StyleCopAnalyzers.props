<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
		<WTGStyleCopAnalyzersPath Condition=" '$(WTGPaketBuildItemsGroupName)' != '' ">$(WTGPaketPackagesRoot)\$(WTGPaketBuildItemsGroupName)\StyleCop.Analyzers</WTGStyleCopAnalyzersPath>
		<WTGStyleCopAnalyzersPath Condition=" '$(WTGPaketBuildItemsGroupName)' == '' ">$(WTGPaketPackagesRoot)\StyleCop.Analyzers</WTGStyleCopAnalyzersPath>
	</PropertyGroup>
	
	<ItemGroup>
		<Analyzer Include="$(WTGStyleCopAnalyzersPath)\analyzers\dotnet\cs\StyleCop.Analyzers.dll" />
		<Analyzer Include="$(WTGStyleCopAnalyzersPath)\analyzers\dotnet\cs\StyleCop.Analyzers.CodeFixes.dll" />
	</ItemGroup>
</Project>
