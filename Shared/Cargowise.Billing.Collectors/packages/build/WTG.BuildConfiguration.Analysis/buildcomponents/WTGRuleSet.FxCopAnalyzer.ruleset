<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="FxCopAnalyzers Ruleset" ToolsVersion="14.0">
  <Rules AnalyzerId="Microsoft.CodeQuality.Analyzers" RuleNamespace="Microsoft.CodeQuality.Analyzers">
    <Rule Id="CA1010" Action="None" />
    <Rule Id="CA1030" Action="None" />
    <Rule Id="CA1040" Action="None" />
    <Rule Id="CA1063" Action="None" />
    <Rule Id="CA1710" Action="None" />
    <Rule Id="CA2007" Action="None" />

    <!--
      - FxCop has some fanciful ideas on what qualifies as a type name.
      -->
    <Rule Id="CA1720" Action="None" />

    <!--
      - CA1724 has gotten too agressive, forbidding the use of identifiers that happen to appear in unrelated namespaces
      - even namespaces that aren't in scope.
      -->
    <Rule Id="CA1724" Action="None" />

    <!--
      - CA1801 - Review unused parameters
      - Would be nice to enforce this, but it doesn't seems to notice when the method is
      - used as a delegate from generated code.
      -->
    <Rule Id="CA1801" Action="Info" />
  </Rules>
  <Rules AnalyzerId="Microsoft.CodeQuality.CSharp.Analyzers" RuleNamespace="Microsoft.CodeQuality.CSharp.Analyzers">
    <Rule Id="CA1200" Action="None" />
  </Rules>
  <Rules AnalyzerId="Microsoft.NetCore.Analyzers" RuleNamespace="Microsoft.NetCore.Analyzers">
    <Rule Id="CA1716" Action="None" />
    <Rule Id="CA1816" Action="None" />
    <!-- CA1826 is largely a duplicate of WTG3002 & WTG3003 -->
    <Rule Id="CA1826" Action="None" />
    <Rule Id="CA2008" Action="None" />
    <Rule Id="CA2227" Action="None" />
  </Rules>
  <Rules AnalyzerId="Microsoft.NetCore.CSharp.Analyzers" RuleNamespace="Microsoft.NetCore.CSharp.Analyzers">
    <!-- We don't use the ResourceManager for string localization. -->
    <Rule Id="CA1303" Action="None" />
    <!-- CA1825 is a duplicate of WTG3004 -->
    <Rule Id="CA1825" Action="None" />
  </Rules>
</RuleSet>
