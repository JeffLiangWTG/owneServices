<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
		<WTGAnalyzersPropsPath Condition=" '$(WTGPaketBuildItemsGroupName)' != '' ">$(WTGPaketPackagesRoot)\$(WTGPaketBuildItemsGroupName)\WTG.Analyzers\build\WTG.Analyzers.props</WTGAnalyzersPropsPath>
		<WTGAnalyzersPropsPath Condition=" '$(WTGPaketBuildItemsGroupName)' == '' ">$(WTGPaketPackagesRoot)\WTG.Analyzers\build\WTG.Analyzers.props</WTGAnalyzersPropsPath>
	</PropertyGroup>
	<Import Project="$(WTGAnalyzersPropsPath)" Condition="$(WTGAnalyersImportProps) != 'false'"/>
</Project>
