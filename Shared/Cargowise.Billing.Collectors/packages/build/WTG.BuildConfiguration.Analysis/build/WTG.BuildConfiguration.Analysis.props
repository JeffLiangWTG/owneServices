<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
	</PropertyGroup>
	<Import Project="$(MSBuildThisFileDirectory)..\buildcomponents\WTG.Analyzers.props" Condition="'$(WTGDisableAnalyzers)' != 'True'"/>
	<Import Project="$(MSBuildThisFileDirectory)..\buildcomponents\WTG.StyleCopAnalyzers.props" Condition="'$(WTGDisableAnalyzers)' != 'True'"/>
</Project>
