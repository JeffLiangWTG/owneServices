<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <NoWarn >$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8622;CS8765</NoWarn>
    <OutputPath>..\..\bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Billing.API">
      <HintPath>..\..\bin\CargoWise.Billing.API\$(TargetFramework)\CargoWise.Billing.API.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.Billing.Kafka.API">
      <HintPath>..\..\bin\CargoWise.Billing.API\$(TargetFramework)\CargoWise.Billing.Kafka.API.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.Billing.Client">
      <HintPath>..\..\bin\CargoWise.Billing.Client\$(TargetFramework)\CargoWise.Billing.Client.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>