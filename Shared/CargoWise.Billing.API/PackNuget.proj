<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="PackNuget">
  <Target Name="PackNuget">
    <PropertyGroup>
      <AProject>$(MSBuildThisFileDirectory)\src\A\AA.csproj</AProject>
      <BProject>$(MSBuildThisFileDirectory)\src\B\BB.csproj</BProject>
    </PropertyGroup>
    <Exec Command="dotnet pack $(AProject) --configuration Release --output $(MSBuildThisFileDirectory)\bin" />
    <Exec Command="dotnet pack $(BProject) --configuration Release --output $(MSBuildThisFileDirectory)\bin" />
  </Target>
</Project>