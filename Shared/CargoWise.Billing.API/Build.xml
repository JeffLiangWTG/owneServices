<?xml version="1.0" encoding="utf-8"?>
<Build xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" MSBuild="16.0" xmlns="http://wisetechglobal.com/DevTools/Build.xsd">
 <PreBuild>
    <!-- paket is only used for code analyzers -->
    <Command cacheable="false">pre-build.cmd</Command>
  </PreBuild>

  <Solutions>
    <Solution Filename="src\CargoWise.Billing.API.sln" />
  </Solutions>
  <DatSettings BuildDeployerType="eHub.DatImplementation.Deployment.BuildDeployer, eHub.DatImplementation.Deployment" IntegrationAssembliesSubdir="DAT">
    <TestAdapters>
      <TestAdapter Key="VSTest" Type="Dat.Implementation.VSTest.VSTestAdapter, Dat.Implementation.VSTest">
        <Options>
          <Option Name="TestAssemblyFileFilter">*.*Tests.dll</Option>
        </Options>
      </TestAdapter>
    </TestAdapters>
  </DatSettings>
  <Task Name="FindMSBuildAndPack">
     <Step>src\packnuget.cmd</Step>
  </Task>
 <PostBuild>
    <!-- paket is only used for code analyzers -->
    <Command cacheable="false">post-build.cmd</Command>
  </PostBuild>
</Build>