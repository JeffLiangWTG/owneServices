    </TestAdapters>
    <DeploymentTargets>
      <DeploymentTarget Type="AutoDeployLatestBuild" BuildConfiguration="RELEASE" IsProduction="false" DeploymentConfiguration="CargoWise.Billing.API.*" />
    </DeploymentTargets>
  </DatSettings>
  <PostBuild>
    <Command cacheable="false">post-build.cmd</Command>
  </PostBuild>
</Build>