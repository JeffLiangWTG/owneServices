<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="PackAll">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <PackageId>CargoWise.Billing.API</PackageId>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <PackageVersion Condition="'$(PackageVersion)' == ''">1.0.0</PackageVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReleaseNotes>
      V1.0.0
      - WI00919389 - Generate a package for CargoWise.Billing.API
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="/CargoWise.Billing.API/CargoWise.Billing.API.csproj" />
    <ProjectReference Include="/CargoWise.Billing.Kafka.API/CargoWise.Billing.Kafka.API.csproj" />
    <ProjectReference Include="/CargoWise.Billing.Service/CargoWise.Billing.Service.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Content Include="../bin/net8.0/CargoWise.Billing.API.dll" Pack="true" />
    <Content Include="../bin/net8.0/CargoWise.Billing.Kafka.API.dll" Pack="true" />
    <Content Include="../bin/net8.0/CargoWise.Billing.Service.dll" Pack="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Content Include="../bin/net48/CargoWise.Billing.API.dll" Pack="true" />
    <Content Include="../bin/net48/CargoWise.Billing.Kafka.API.dll" Pack="true" />
    <Content Include="../bin/net48/CargoWise.Billing.Service.dll" Pack="true" />
  </ItemGroup>

  <Target Name="PackAll">
    <Exec Command="dotnet pack --configuration Release --no-build --output packages/" />
  </Target>

</Project>