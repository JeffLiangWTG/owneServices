<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- Basic settings -->
	<PropertyGroup>
		<DevRootDirectory>$(MSBuildThisFileDirectory)</DevRootDirectory>
		<DevBuildSettingsDirectory>$(DevRootDirectory)\BuildSettings\</DevBuildSettingsDirectory>
		<DevPackagesRootDirectory>$([System.IO.Path]::GetFullPath('$(DevRootDirectory)\packages'))</DevPackagesRootDirectory>
	</PropertyGroup>
	  
	<PropertyGroup>
		<RunCodeAnalysis>False</RunCodeAnalysis>
	</PropertyGroup>
</Project>