  <Rules AnalyzerId="Microsoft.CodeQuality.Analyzers" RuleNamespace="Microsoft.CodeQuality.Analyzers">
    <Rule Id="CA1062" Action="None" />             <!-- Validate arguments of public methods -->
    <Rule Id="CA1307" Action="None" />             <!-- Methods string.Replace/Contains("","", StringComparison) is not available in net48/netstandard2.0 -->	
    <Rule Id="CA1707" Action="None" />             <!-- Identifiers should not contain underscores -->	
    <Rule Id="CA1819" Action="None" />             <!-- Properties should not return arrays -->
    <Rule Id="CA1416" Action="None" />             <!-- Validate platform compatibility, we call Registry.GetValue and this method is only available on windows -->
    <Rule Id="CA1054" Action="None" />             <!-- URI parameters should not be strings, eventually we should rework all the places we are using string -->
    <Rule Id="CA1812" Action="None" />             <!-- Avoid uninstantiated internal classes -->
    <Rule Id="CA1711" Action="None" />             <!-- Identifiers should not have incorrect suffix -->
    <Rule Id="CA1056" Action="None" />             <!-- Uri properties should not be strings -->
    <Rule Id="CA1034" Action="None" />             <!-- Do not nest type. Alternatively, change its accessibility so that it is not externally visible -->
    <Rule Id="CA1506" Action="None" />             <!-- Rewrite or refactor the code to decrease its class coupling below '96' -->
  </Rules>
