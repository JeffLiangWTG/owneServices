<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CargoWise.RefDbRepo.Staging.Common</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.Staging.Common</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\..\Bin\Staging\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Configurations>Debug;Release;UAT</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CargoWise.RefDbRepo.Common.Argument">
      <HintPath>..\..\..\Bin\Staging\net8.0\CargoWise.RefDbRepo.Common.Argument.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.RefDbRepo.Common.ErrorReporting">
      <HintPath>..\..\..\Bin\Staging\net8.0\CargoWise.RefDbRepo.Common.ErrorReporting.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.RefDbRepo.Common.Utils">
      <HintPath>..\..\..\Bin\Staging\net8.0\CargoWise.RefDbRepo.Common.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Schema_New\Schema_New.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CargoWise.RefDbRepo.Staging.Common.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\UniversalXMLProducers\net8.0\&quot;&#xD;&#xA;if not $(Configuration) == Release (&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\UniversalXMLProducers\net8.0\&quot;)&#xD;&#xA;" />
  </Target>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>