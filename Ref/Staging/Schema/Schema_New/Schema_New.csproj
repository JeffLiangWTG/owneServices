<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CargoWise.RefDbRepo.Staging.Schema_New</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.Staging.Schema_New</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Configurations>Debug;Release;UAT</Configurations>
    <OutputPath>..\..\..\Bin\Staging\</OutputPath>
    <NoWarn>CA1505</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CargoWise.RefDbRepo.Common.Argument">
      <HintPath>..\..\..\Bin\Staging\net8.0\CargoWise.RefDbRepo.Common.Argument.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.RefDbRepo.Common.TypeProvider">
      <HintPath>..\..\..\Bin\Staging\net8.0\CargoWise.RefDbRepo.Common.TypeProvider.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.RefDbRepo.Common.Utils">
      <HintPath>..\..\..\Bin\Staging\net8.0\CargoWise.RefDbRepo.Common.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\UniversalXMLProducers\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Tools\net8.0\&quot;" />
  </Target>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>
