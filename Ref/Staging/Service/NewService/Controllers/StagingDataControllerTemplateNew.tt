<#@ template language="C#" debug="false" hostspecific="true"#>
<#@ include file="..\..\..\..\Tools\T4Runner\T4Includes\Template.Utility.CS.ttinclude"#>
<#@ assembly name="netstandard" #>
<#@ 
 output extension=".cs"#><#

const string modelFolder = @"..\..\..\Staging\Schema\Schema_New\Models";
var textTransform = DynamicTextTransformation.Create(this);
var code = new CodeGenerationTools(this);
var typeMapper = new TypeMapper(code, textTransform.Errors);
var itemCollection = typeMapper.GetEntitiesToGenerate(modelFolder);
var codeStringGenerator = new CodeStringGenerator(code, typeMapper);

if (!typeMapper.VerifyCaseInsensitiveTypeUniqueness(itemCollection, modelFolder))
{
    return string.Empty;
}

WriteHeader(codeStringGenerator);


BeginNamespace(code);
#>
<#=codeStringGenerator.UsingDirectives(inHeader: false)#>
<#

foreach (var entity in itemCollection.Where(x => x != "SystemData"))
{
#>
<#=codeStringGenerator.EntityClassOpening(entity)#>
{
    public <#=code.Escape(entity)#>UpdateController(IAuthorizationHelper authorizationHelper)
        : base(authorizationHelper)
    {
    }
}
<#
}
EndNamespace(code);
#>
<#+

public void WriteHeader(CodeStringGenerator codeStringGenerator)
{

#>
//------------------------------------------------------------------------------
// <auto-generated>
// <#=CodeGenerationTools.Template_GeneratedCodeCommentLine1 #>
//
// <#=CodeGenerationTools.Template_GeneratedCodeCommentLine2 #>
// <#=CodeGenerationTools.Template_GeneratedCodeCommentLine3 #>
// </auto-generated>
//------------------------------------------------------------------------------
<#=codeStringGenerator.UsingDirectives(inHeader: true)#>
<#+

}

public void BeginNamespace(CodeGenerationTools code)
{
    var codeNamespace = code.VsNamespaceSuggestion();
    if (!String.IsNullOrEmpty(codeNamespace))
    {
#>
namespace <#=code.EscapeNamespace(codeNamespace)#>
{
<#+
        PushIndent("    ");
    }
}

public void EndNamespace(CodeGenerationTools code)
{
    if (!String.IsNullOrEmpty(code.VsNamespaceSuggestion()))
    {
        PopIndent();
#>
}
<#+
    }
}

public class CodeStringGenerator
{
    private readonly CodeGenerationTools _code;
    private readonly TypeMapper _typeMapper;

    public CodeStringGenerator(CodeGenerationTools code, TypeMapper typeMapper)
    {
        ArgumentNotNull(code, "code");
        ArgumentNotNull(typeMapper, "typeMapper");

        _code = code;
        _typeMapper = typeMapper;
    }

    public string EntityClassOpening(string entity)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            "{0} {1}partial class {2}{3}",
            "public",
            _code.SpaceAfter(String.Empty),
            _code.Escape(entity) + "UpdateController",
            " : StagingDataController<CargoWise.RefDbRepo.Staging.Schema_New." + entity + ">");
    }

    public string UsingDirectives(bool inHeader, bool includeCollections = true)
    {
        return inHeader == string.IsNullOrEmpty(_code.VsNamespaceSuggestion())
            ? string.Format(
                CultureInfo.InvariantCulture,
                "{0}using System;{1}" +
                "{2}"+
                "using CargoWise.RefDbRepo.Common.Web.Auth;",
                inHeader ? Environment.NewLine : "",
                includeCollections ? (Environment.NewLine + "using System.Collections.Generic;") : "",
                inHeader ? "" : Environment.NewLine)
            : "";
    }
}

public class TypeMapper
{
    private const string ExternalTypeNameAttributeName = @"http://schemas.microsoft.com/ado/2006/04/codegeneration:ExternalTypeName";

    private readonly System.Collections.IList _errors;
    private readonly CodeGenerationTools _code;

    public TypeMapper(CodeGenerationTools code, System.Collections.IList errors)
    {
        ArgumentNotNull(code, "code");
        ArgumentNotNull(errors, "errors");

        _code = code;
        _errors = errors;
    }

    public static string FixNamespaces(string typeName)
    {
        return typeName.Replace("System.Data.Spatial.", "System.Data.Entity.Spatial.");
    }

    public bool VerifyCaseInsensitiveTypeUniqueness(IEnumerable<string> types, string modelFolder)
    {
        ArgumentNotNull(types, "types");
        ArgumentNotNull(modelFolder, "modelFolder");
        
        var hash = new HashSet<string>(StringComparer.InvariantCultureIgnoreCase);
        if (types.Any(item => !hash.Add(item)))
        {
            _errors.Add(
                new CompilerError(modelFolder, -1, -1, "6023",
                    String.Format(CultureInfo.CurrentCulture, CodeGenerationTools.Template_CaseInsensitiveTypeConflict)));
            return false;
        }
        return true;
    }

    public IEnumerable<string> GetEntitiesToGenerate(string modelFolder)
    {
        var files = Directory.GetFiles(modelFolder);
        return files.Select(x => Path.GetFileNameWithoutExtension(x));
    }
}

public static void ArgumentNotNull<T>(T arg, string name) where T : class
{
    if (arg == null)
    {
        throw new ArgumentNullException(name);
    }
}
#>
