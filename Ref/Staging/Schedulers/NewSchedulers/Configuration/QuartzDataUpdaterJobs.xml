<job-scheduling-data xmlns="http://quartznet.sourceforge.net/JobSchedulingData"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                version="2.0">
  <processing-directives>
    <overwrite-existing-data>true</overwrite-existing-data>
  </processing-directives>
  <schedule>
    <job>
      <name>Data Updater Scheduler</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.QuartzDataUpdater, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
    </job>
    <job>
      <name>Health Checker</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.HealthChecker, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
    </job>
  </schedule>
</job-scheduling-data>
