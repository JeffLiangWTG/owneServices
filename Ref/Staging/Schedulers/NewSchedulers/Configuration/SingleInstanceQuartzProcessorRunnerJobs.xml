<job-scheduling-data xmlns="http://quartznet.sourceforge.net/JobSchedulingData"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                version="2.0">
  <processing-directives>
    <overwrite-existing-data>true</overwrite-existing-data>
  </processing-directives>
  <schedule>
    <job>
      <name>Data Purging</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.SingleInstanceQuartzAppRunner, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
      <job-data-map>
        <entry>
          <key>ProgramExePath</key>
          <value>..\net8.0\CargoWise.RefDbRepo.Staging.DataPurgingProcessor.exe</value>
        </entry>
      </job-data-map>
    </job>
    <job>
      <name>Tariff Rule Runner</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.SingleInstanceQuartzAppRunner, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
      <job-data-map>
        <entry>
          <key>ProgramExePath</key>
          <value>..\net8.0\CargoWise.RefDbRepo.Staging.RuleRunner.exe</value>
        </entry>
      </job-data-map>
    </job>
    <job>
      <name>E-Hub Messages Downloader</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.SingleInstanceQuartzAppRunner, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
      <job-data-map>
        <entry>
          <key>ProgramExePath</key>
          <value>..\net8.0\CargoWise.RefDbRepo.Staging.eHubMessageDownloader.exe</value>
        </entry>
        <entry>
          <key>ProgramArgs</key>
          <value>EHUB</value>
        </entry>
      </job-data-map>
    </job>
    <job>
      <name>Data Publisher</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.SingleInstanceQuartzAppRunner, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
      <job-data-map>
        <entry>
          <key>ProgramExePath</key>
          <value>..\net8.0\CargoWise.RefDbRepo.Staging.DataPublishingProcessor.exe</value>
        </entry>
        <entry>
          <key>ProgramArgs</key>
          <value>AUTO</value>
        </entry>
      </job-data-map>
    </job>
    <job>
      <name>Data Publisher Push</name>
      <group>Reference Data</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.SingleInstanceQuartzAppRunner, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
      <job-data-map>
        <entry>
          <key>ProgramExePath</key>
          <value>..\net8.0\CargoWise.RefDbRepo.Staging.DataPublishingProcessor.exe</value>
        </entry>
        <entry>
          <key>ProgramArgs</key>
          <value>PUSH</value>
        </entry>
      </job-data-map>
    </job>
  </schedule>
</job-scheduling-data>
