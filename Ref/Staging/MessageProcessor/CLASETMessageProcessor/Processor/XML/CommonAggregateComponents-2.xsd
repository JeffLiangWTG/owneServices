<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="urn:crimsonlogic:tn:schema:xsd:CommonAggregateComponents-2" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="urn:crimsonlogic:tn:schema:xsd:CommonAggregateComponents-2"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="CommonBasicComponents-2.xsd" namespace="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" />
  <xs:element name="CustomsRemarks">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="2" xmlns:q1="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q1:FreeText" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="CustomsCommonCodeInformation">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" xmlns:q2="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q2:CustomsCommonCodeTableName" />
        <xs:element minOccurs="0" maxOccurs="999999" name="Record">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" xmlns:q3="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q3:ReferenceID" />
              <xs:element minOccurs="0" maxOccurs="9" xmlns:q4="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q4:Code" />
              <xs:element minOccurs="0" maxOccurs="9" name="Description">
                <xs:complexType mixed="true">
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="5" xmlns:q5="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q5:FreeText" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="0" xmlns:q6="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q6:EffectiveDate" />
              <xs:element minOccurs="0" xmlns:q7="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q7:ExpiryDate" />
              <xs:element minOccurs="0" maxOccurs="99" xmlns:q8="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" ref="q8:Field" />
            </xs:sequence>
            <xs:attribute name="OperationCode" type="xs:string" use="optional" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
