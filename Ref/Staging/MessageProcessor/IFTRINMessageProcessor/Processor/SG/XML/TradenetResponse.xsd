<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:cbc="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2"
  xmlns:out="urn:crimsonlogic:tn:schema:xsd:OutwardDeclaration"
  xmlns:coo="urn:crimsonlogic:tn:schema:xsd:CertificateOfOrigin"
  xmlns:fee="urn:crimsonlogic:tn:schema:xsd:FeeMessage"
  xmlns:rej="urn:crimsonlogic:tn:schema:xsd:RejectionMessage"
  xmlns:inp="urn:crimsonlogic:tn:schema:xsd:InNonPayment"
  xmlns:cux="urn:crimsonlogic:tn:schema:xsd:CustomsExchangeRate"
  xmlns:err="urn:crimsonlogic:tn:schema:xsd:ErrorMessage"
  xmlns:tnp="urn:crimsonlogic:tn:schema:xsd:TranshipmentMovement"
  xmlns:ipt="urn:crimsonlogic:tn:schema:xsd:InPayment"
  xmlns:app="urn:crimsonlogic:tn:schema:xsd:ApprovalMessage"
  xmlns:cac="urn:crimsonlogic:tn:schema:xsd:CommonAggregateComponents-2" attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="urn:crimsonlogic:tn:schema:xsd:TradenetResponse"
  xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="CommonBasicComponents-2.xsd" namespace="urn:crimsonlogic:tn:schema:xsd:CommonBasicComponents-2" />
  <xs:import schemaLocation="CustomsExchangeRate.xsd" namespace="urn:crimsonlogic:tn:schema:xsd:CustomsExchangeRate" />
  <xs:element name="TradenetResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" ref="cbc:MessageVersion" />
        <xs:element minOccurs="0" ref="cbc:SenderID" />
        <xs:element minOccurs="0" ref="cbc:RecipientID" />
        <xs:element minOccurs="0" ref="cbc:TotalNumberOfResponse" />
        <xs:element minOccurs="0" name="OutboundMessage">
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" ref="cux:CustomsExchangeRate" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="dateTime" type="xs:string" use="optional" />
      <xs:attribute name="instanceIdentifier" type="xs:string" use="optional" />
    </xs:complexType>
  </xs:element>
</xs:schema>
