<service>
  <id>SeleniumHub</id>
  <name>Selenium Standalone</name>
  <description>This service runs the Selenium in Standalone mode.</description>
  <executable>C:\Program Files (x86)\Java\jre1.8.0_251\bin\java</executable>
  <arguments>-jar "C:\Selenium\selenium-server-standalone-3.9.1.jar" -log "C:\Selenium\logs.txt"</arguments>
  <env name="JAVA_HOME" value="C:\Program Files (x86)\Java\jre1.8.0_251\bin\java" />
  <env name="SELENIUM_HOME" value="C:\Selenium" />
</service>