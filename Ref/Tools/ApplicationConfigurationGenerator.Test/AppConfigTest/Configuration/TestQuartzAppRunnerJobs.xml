        </entry>
      </job-data-map>
    </job>
    <job>
      <name>TestingApplicationJson</name>
      <group>Test Group 2</group>
      <job-type>CargoWise.RefDbRepo.Staging.Schedulers.Common.QuartzAppRunner, CargoWise.RefDbRepo.Staging.Schedulers.Common</job-type>
      <durable>true</durable>
      <recover>false</recover>
      <job-data-map>
        <entry>
          <key>ProgramExePath</key>
          <value>CargoWise.RefDbRepo.TestingApplicationJson.exe</value>
        </entry>
      </job-data-map>
    </job>
  </schedule>
</job-scheduling-data>
