<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CargoWise.RefDbRepo.T4Runner.Test</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.T4Runner.Test</AssemblyName>
    <OutputPath>..\..\Bin\Tools\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Configurations>Debug</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.RefDbRepo.Common.Utils">
      <HintPath>..\..\Bin\Tools\net8.0\CargoWise.RefDbRepo.Common.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\T4Runner\T4Runner.csproj">
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="T4TestResources\TestT4File.csproj">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="T4TestResources\TestT4File.tt">
      <Generator>TextTemplatingFilePreprocessor</Generator>
      <LastGenOutput>TestT4File.cs</LastGenOutput>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CustomToolNamespace>CargoWise.RefDbRepo.T4Runner.Test.T4TestResources</CustomToolNamespace>
    </Content>
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>