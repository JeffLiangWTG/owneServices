{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DEBUG_DisableAuthentication": true,

  "RefCurrency_MergeTimeout": "1800",
  "EnableRawResponse": "true",
  "RawResponseMaxSize": "1048576",
  "Cache.Folder": "FileCache",
  "Cache.MaxSize": "107374182400",
  "Cache.ExpirationInHours": "48",
  "Cache.CleanIntervalInHours": "12",
  "Cache.CacheSizeSyncIntervalInMinutes": "60",
  "Cache.CacheSizeSyncBeginPercentage": "50",
  "CommandTimeout": "600",
  "PortalUri": "http://localhost:19488",

  "serilog:using:RollingFile": "Serilog.Sinks.RollingFile",
  "serilog:write-to:RollingFile.pathFormat": "%BASEDIR%\\logs\\{RefLogFileName}-{Date}.txt",
  "serilog:write-to:RollingFile.outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}",

  "S2SAuthority": "https://login.microsoftonline.com/1b20b87e-cebd-43cc-97bd-bdd41a2f5cf1/v2.0",
  "S2SAudience": "4ec2a7e9-7281-4144-82b4-fce61faff360",

  "Endpoint": "https:\/\/aws.wisecloud.zone\/authentication\/",
  "CacheDuration": "300",

  "MemoryUsageLogging": {
    "IntervalSeconds": 60
  }
}
