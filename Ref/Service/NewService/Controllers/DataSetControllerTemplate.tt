public const string TemplateId = "CSharp_DbContext_Types_EF6";

public class CodeStringGenerator
{
    private readonly CodeGenerationTools _code;
    private readonly TypeMapper _typeMapper;

    public CodeStringGenerator(CodeGenerationTools code, TypeMapper typeMapper)
    {
        ArgumentNotNull(code, "code");
        ArgumentNotNull(typeMapper, "typeMapper");

        _code = code;
        _typeMapper = typeMapper;
    }

    public string EntityClassOpening(string entity)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            "{0} {1}partial class {2}{3}",
            "public",
            _code.SpaceAfter(String.Empty),
            _code.Escape(entity) + "Controller",
            " : DataSetControllerBase<Models." + entity + ">");
    }

    public string UsingDirectives(bool inHeader, bool includeCollections = true)
    {
        return inHeader == string.IsNullOrEmpty(_code.VsNamespaceSuggestion())
            ? string.Format(
                CultureInfo.InvariantCulture,
                "{0}{1}" +
                "using CargoWise.RefDbRepo.Common.Argument;" +
                 Environment.NewLine +
                "using CargoWise.RefDbRepo.Common.Utils;" +
                 Environment.NewLine +
                "using CargoWise.RefDbRepo.Service.DataContractAdaptor;" +
                Environment.NewLine +
                "using Models = CargoWise.RefDbRepo.Common.Contract_0_9;" +
                "{2}",
                inHeader ? Environment.NewLine : "",
                includeCollections ? ("using System.Collections.Generic;" + Environment.NewLine) : "",
                inHeader ? "" : Environment.NewLine)
            : "";
    }
}

public class TypeMapper
{
    private const string ExternalTypeNameAttributeName = @"http://schemas.microsoft.com/ado/2006/04/codegeneration:ExternalTypeName";

    private readonly System.Collections.IList _errors;
    private readonly CodeGenerationTools _code;

    public TypeMapper(CodeGenerationTools code, System.Collections.IList errors)
    {
        ArgumentNotNull(code, "code");
        ArgumentNotNull(errors, "errors");

        _code = code;
        _errors = errors;
    }

    public static string FixNamespaces(string typeName)
    {
        return typeName.Replace("System.Data.Spatial.", "System.Data.Entity.Spatial.");
    }
    
    public bool VerifyCaseInsensitiveTypeUniqueness(IEnumerable<string> types, string modelFolder)
    {
        ArgumentNotNull(types, "types");
        ArgumentNotNull(modelFolder, "modelFolder");
        
        var hash = new HashSet<string>(StringComparer.InvariantCultureIgnoreCase);
        if (types.Any(item => !hash.Add(item)))
        {
            _errors.Add(
                new CompilerError(modelFolder, -1, -1, "6023",
                    String.Format(CultureInfo.CurrentCulture, CodeGenerationTools.Template_CaseInsensitiveTypeConflict)));
            return false;
        }
        return true;
    }
    
    public IEnumerable<string> GetEntitiesToGenerate(string modelFolder)
    {
        var files = Directory.GetFiles(modelFolder);
        return files.Select(x => Path.GetFileNameWithoutExtension(x));
    }
}

public static void ArgumentNotNull<T>(T arg, string name) where T : class
{
    if (arg == null)
    {
        throw new ArgumentNullException(name);
    }
}
#>
