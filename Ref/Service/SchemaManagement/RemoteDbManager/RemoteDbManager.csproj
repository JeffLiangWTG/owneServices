<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CargoWise.RefDbRepo.RemoteDbManager</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.RemoteDbManager</AssemblyName>
    <Configurations>Debug;Release;UAT</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>..\..\..\Bin\Server\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CA1506</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CargoWise.RefDbRepo.Common">
      <HintPath>..\..\..\Bin\Server\net8.0\CargoWise.RefDbRepo.Common.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.RefDbRepo.Common.Utils">
      <HintPath>..\..\..\Bin\Server\net8.0\CargoWise.RefDbRepo.Common.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /r /y &quot;$(TargetDir)..\RemoteDbSqlFiles.zip&quot; &quot;$(TargetDir)..\net8.0\&quot;" />
  </Target>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>