  <Target Name="Zip" BeforeTargets="AfterBuild">
    <ItemGroup>
      <ZipFiles Include="$(ProjectDir)dbo\Tables\" />
      <ZipFiles Include="$(ProjectDir)dbo\Views\" />
      <ZipFiles Include="$(ProjectDir)dbo\Triggers\" />
    </ItemGroup>
