<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="kurse">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="kurs"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="kurs">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="land"/>
        <xs:element ref="iso2" minOccurs="0"/>
        <xs:element ref="kurswert"/>
        <xs:element ref="iso3"/>
        <xs:element ref="startdatum"/>
        <xs:element ref="enddatum"/>
        <xs:element minOccurs="0" ref="anmerkungen"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="land" type="xs:string"/>
  <xs:element name="iso2" type="xs:string"/>
  <xs:element name="kurswert" type="xs:string"/>
  <xs:element name="iso3" type="xs:string"/>
  <xs:element name="startdatum" type="xs:string"/>
  <xs:element name="enddatum" type="xs:string"/>
  <xs:element name="anmerkungen" type="xs:string"/>
</xs:schema>
