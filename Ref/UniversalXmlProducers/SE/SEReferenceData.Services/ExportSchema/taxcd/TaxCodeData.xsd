<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 96000 and 96010
 -->
	<xsd:element name="taxCode">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:taxCodeDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID of tax code -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date of tax code -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of tax code -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Tax code -->
            <xsd:attribute ref="at:taxCode"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="taxCodeDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Long description of tax code -->
            <xsd:attribute ref="at:description"/>
			<xsd:attribute ref="at:SID"/>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
