<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 37000, 37005, 37010, 37015
 -->
	<xsd:element name="quotaDefinition">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:quotaAssociation" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:quotaBlockingPeriod" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:quotaSuspensionPeriod" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:extendedQuotaInformation" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Quota definition SID -->
            <xsd:attribute ref="at:SID"/>
            <!-- Quota order number id -->
            <xsd:attribute ref="at:quotaOrderNumber"/>
            <!-- Quota order number SID -->
            <xsd:attribute ref="at:SIDQuotaOrderNumber"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Volume -->
            <xsd:attribute ref="at:volume"/>
            <!-- Initial volume -->
            <xsd:attribute ref="at:initialVolume"/>
            <!-- Monetary unit code -->
            <xsd:attribute ref="at:monetaryUnitCode"/>
            <!-- Measurement unit code -->
            <xsd:attribute ref="at:measurementUnitCode"/>
            <!-- Measurement unit qualifier code -->
            <xsd:attribute ref="at:measurementUnitQualifierCode"/>
            <!-- Maximum precision -->
            <xsd:attribute ref="at:quotaMaximumPrecision"/>
            <!-- Quota critical state -->
            <xsd:attribute ref="at:quotaCriticalStateCode"/>
            <!-- Quota critical threshold -->
            <xsd:attribute ref="at:quotaCriticalThreshold"/>
            <!-- Short description related to the quota definition -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="quotaAssociation">
        <xsd:complexType>
            <!-- Quota definition SID (sub-quota) -->
            <xsd:attribute ref="at:SIDSubQuota"/>
            <!-- Sub-Quota Relation Type -->
            <xsd:attribute ref="at:relationType"/>
            <!-- Coefficient -->
            <xsd:attribute ref="at:coefficient"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element> 
    
    <xsd:element name="quotaBlockingPeriod">
        <xsd:complexType>
            <!-- Quota blocking period definition SID -->
            <xsd:attribute ref="at:SID"/>
            <!-- Blocking start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Blocking end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Blocking period type -->
            <xsd:attribute ref="at:blockingPeriodType"/>
            <!-- Short description related to the quota blocking period -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="quotaSuspensionPeriod">
        <xsd:complexType>
            <!-- Quota suspension period definition SID -->
            <xsd:attribute ref="at:SID"/>
            <!-- Suspension start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Suspension end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Short description of suspension reason -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="extendedQuotaInformation">
        <xsd:complexType>
            <!-- balance -->
            <xsd:attribute ref="at:balance"/>
            <!-- Imported amount -->
            <xsd:attribute ref="at:importedAmount"/>
            <!-- Last allocation date -->
            <xsd:attribute ref="at:lastAllocationDate"/>
            <!-- Allocated percentage -->
            <xsd:attribute ref="at:allocatedPercentage"/>
            <!-- Last import date -->
            <xsd:attribute ref="at:lastImportDate"/>
            <!-- Quota exhaustion state -->
            <xsd:attribute ref="at:quotaExhaustionStateCode"/>
            <!-- Exhaustion date -->
            <xsd:attribute ref="at:exhaustionDate"/>
            <!-- Quota blocked state -->
            <xsd:attribute ref="at:quotaBlockedStateCode"/>
            <!-- Quota suspended state -->
            <xsd:attribute ref="at:quotaSuspendedStateCode"/>
            <!-- Total awaiting allocation -->
            <xsd:attribute ref="at:totalAwaitingAllocation"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
