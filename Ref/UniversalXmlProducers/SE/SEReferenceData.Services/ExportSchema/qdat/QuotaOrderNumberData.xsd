<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 36000, 36010
 -->            
	<xsd:element name="quotaOrderNumber">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:quotaOrderNumberOrigin" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Quota order number SID -->
            <xsd:attribute ref="at:SID"/>
            <!-- Quota order number id -->
            <xsd:attribute ref="at:quotaOrderNumber"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    				    
    <xsd:element name="quotaOrderNumberOrigin">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:quotaOrderNumberOriginExclusion" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID for Quota order number origin -->
            <xsd:attribute ref="at:SID"/>
            <!-- SID for geographical area -->
            <xsd:attribute ref="at:SIDGeographicalArea"/>
            <!-- Geographical area id -->
            <xsd:attribute ref="at:geographicalAreaId"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="quotaOrderNumberOriginExclusion">
        <xsd:complexType>
            <!-- Geographical area id -->
            <xsd:attribute ref="at:geographicalAreaId"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
