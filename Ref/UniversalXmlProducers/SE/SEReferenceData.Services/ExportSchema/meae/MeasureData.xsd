<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 43000, 43005, 43010, 43011, 43015, 43020, 43025
 -->            

	<xsd:element name="measure">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:measureComponent" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:measureCondition" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:measureExcludedGeographicalArea" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:measureFootnoteAssociation" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:measurePartialTemporaryStop" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            
            <!-- SID for measure -->
            <xsd:attribute ref="at:SID"/>
            <!-- Measure type -->
            <xsd:attribute ref="at:measureType"/>
            <!-- Geographical area id -->
            <xsd:attribute ref="at:geographicalAreaId"/>
            <!-- Goods nomenclature item id -->
            <xsd:attribute ref="at:goodsNomenclatureCode"/>

            <!-- Additional code type -->
            <xsd:attribute ref="at:additionalCodeType"/>
            <!-- Additional code -->
            <xsd:attribute ref="at:additionalCodeId"/>
            <!-- Quota order number -->
            <xsd:attribute ref="at:quotaOrderNumber"/>
            <!-- Reduction indicator -->
            <xsd:attribute ref="at:reductionIndicator"/>
            <!-- Validity start date of measure -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of measure -->
            <xsd:attribute ref="at:dateEnd"/>

            <!-- Role of measure-generating regulation -->
            <xsd:attribute ref="at:regulationRoleType"/>
            <!-- Id of measure-generating regulation -->
            <xsd:attribute ref="at:regulationId"/>
            <!-- Role of justification regulation -->
            <xsd:attribute ref="at:justificationRegulationRoleType"/>
            <!-- Id of Justification regulation -->
            <xsd:attribute ref="at:justificationRegulationId"/>

            <!-- Stopped flag -->
            <xsd:attribute ref="at:stoppedFlag"/>
            <!-- SID for geographical area -->
            <xsd:attribute ref="at:SIDGeographicalArea"/>
            <!-- SID for goods nomenclature item -->
            <xsd:attribute ref="at:SIDGoodsNomenclature"/>
            <!-- SID for additional code -->
            <xsd:attribute ref="at:SIDAdditionalCode"/>
            <!-- SID for export refund nomenclature -->
            <xsd:attribute ref="at:SIDExportRefundNomenclature"/>

            <!-- Represent the national column X_EXPRESSION, which holds national duty expressions -->
            <xsd:attribute ref="at:expression"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureComponent">
        <xsd:complexType>
            <!-- Duty expression id -->
            <xsd:attribute ref="at:dutyExpressionId"/>
            <!-- Duty amount -->
            <xsd:attribute ref="at:dutyAmount"/>
            <!-- Monetary unit code -->
            <xsd:attribute ref="at:monetaryUnitCode"/>
            <!-- Measurement unit code -->
            <xsd:attribute ref="at:measurementUnitCode"/>
            <!-- Measurement unit qualifier code -->
            <xsd:attribute ref="at:measurementUnitQualifierCode"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureCondition">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:measureConditionComponent" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
        
            <!-- SID for measure condition -->
            <xsd:attribute ref="at:SID"/>
            <!-- Condition code -->
            <xsd:attribute ref="at:conditionCodeId"/>
            <!-- Component sequence number -->
            <xsd:attribute ref="at:sequenceNumber"/>
            <!-- Condition duty amount -->
            <xsd:attribute ref="at:dutyAmount"/>
            <!-- Condition monetary unit code -->
            <xsd:attribute ref="at:monetaryUnitCode"/>
            <!-- Condition measurement unit code -->
            <xsd:attribute ref="at:measurementUnitCode"/>
            <!-- Condition measurement unit qualifier code -->
            <xsd:attribute ref="at:measurementUnitQualifierCode"/>
            <!-- Action code -->
            <xsd:attribute ref="at:actionCode"/>
            <!-- Certificate type code -->
            <xsd:attribute ref="at:certificateType"/>
            <!-- Certificate code -->
            <xsd:attribute ref="at:certificateCode"/>
            <!-- Represent the national column X_EXPRESSION, which holds national duty expressions -->
            <xsd:attribute ref="at:expression"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureConditionComponent">
        <xsd:complexType>
            <!-- Duty Expression id -->
            <xsd:attribute ref="at:dutyExpressionId"/>
            <!-- Duty amount -->
            <xsd:attribute ref="at:dutyAmount"/>
            <!-- Monetary unit code -->
            <xsd:attribute ref="at:monetaryUnitCode"/>
            <!-- Measurement unit code -->
            <xsd:attribute ref="at:measurementUnitCode"/>
            <!-- Measurement unit qualifier code -->
            <xsd:attribute ref="at:measurementUnitQualifierCode"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureExcludedGeographicalArea">
        <xsd:complexType>
            <!-- Geographical area id -->
            <xsd:attribute ref="at:geographicalAreaId"/>
            <!-- SID for excluded geographical area -->
            <xsd:attribute ref="at:SIDGeographicalArea"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureFootnoteAssociation">
        <xsd:complexType>
            <!-- Footnote type id -->
            <xsd:attribute ref="at:footnoteType"/>
            <!-- Footnote id-->
            <xsd:attribute ref="at:footnoteId"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measurePartialTemporaryStop">
        <xsd:complexType>
            <!-- Start date of partial temporary stop -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- End date of partial temporary stop -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Partial temporary stop regulation id -->
            <xsd:attribute ref="at:regulationId"/>
            <!-- Official journal number of partial temporary stop regulation -->
            <xsd:attribute ref="at:officialJournalId"/>
            <!-- Official journal page of partial temporary stop regulation -->
            <xsd:attribute ref="at:journalPage"/>
            <!-- Abrogation regulation id -->
            <xsd:attribute ref="at:abrogationRegulationId"/>
            <!-- Official journal number of abrogation regulation -->
            <xsd:attribute ref="at:abrogationOfficialJournalId"/>
            <!-- Official journal page of abrogation regulation -->
            <xsd:attribute ref="at:abrogationJournalPage"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    
    
</xsd:schema>
