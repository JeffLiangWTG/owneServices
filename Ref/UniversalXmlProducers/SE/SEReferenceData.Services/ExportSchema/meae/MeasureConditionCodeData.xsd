<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 35000, 35005
 -->
	<xsd:element name="measureConditionCode">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:measureConditionCodeDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Condition code -->
            <xsd:attribute ref="at:conditionCode"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureConditionCodeDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Short description of measure condition -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
