<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 94000 and 94005
	Export all entries which are valid at the requested queryDateStart or later.
 -->            
	<xsd:element name="preferenceCode">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:preferenceCodeDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Preference code -->
            <xsd:attribute ref="at:prefCode"/>
            <!-- Validity start date of preference code -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of preference code -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="preferenceCodeDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Long description of preference code -->
            <xsd:attribute ref="at:description"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
