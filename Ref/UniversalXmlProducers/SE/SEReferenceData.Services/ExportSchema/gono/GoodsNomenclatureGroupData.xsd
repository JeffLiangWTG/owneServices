<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 27000, 27005
 -->            
	<xsd:element name="goodsNomenclatureGroup">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:goodsNomenclatureGroupDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Goods nomenclature group type -->
            <xsd:attribute ref="at:goodsNomenclatureGroupType"/>
            <!-- Goods nomenclature group id -->
            <xsd:attribute ref="at:goodsNomenclatureGroupId"/>
            <!-- Validity start date of goods nomenclature group -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of goods nomenclature group -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Nomenclature group facility code -->
            <xsd:attribute ref="at:nomenclatureGroupFacilityCode"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="goodsNomenclatureGroupDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Short description of nomenclature group -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
