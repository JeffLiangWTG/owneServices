<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 40000, 40005, 40010, 40015, 40020, 40025
 -->            
	<xsd:element name="goodsNomenclature">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:goodsNomenclatureIndent" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:goodsNomenclatureDescriptionPeriod" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:goodsNomenclatureFootnoteAssociation" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:goodsNomenclatureGroupMembership" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            
            <!-- SID for goods nomenclature item -->
            <xsd:attribute ref="at:SID"/>
            <!-- Goods nomenclature item id -->
            <xsd:attribute ref="at:goodsNomenclatureCode"/>
            <!-- Product line suffix -->
            <xsd:attribute ref="at:productLineSuffix"/>
            <!-- Validity start date of goods nomenclature item -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of goods nomenclature item -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Statistical/non statistical indicator -->
            <xsd:attribute ref="at:statisticalIndicator"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="goodsNomenclatureIndent">
        <xsd:complexType>
            <!-- SID for goods nomenclature indent -->
            <xsd:attribute ref="at:SID"/>
            <!-- Number of indents -->
            <xsd:attribute ref="at:quantityIndents"/>
            <!-- Validity start date of goods nomenclature indent -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of goods nomenclature indent -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="goodsNomenclatureDescriptionPeriod">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:goodsNomenclatureDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            
            <!-- SID for goods nomenclature description period -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date of goods nomenclature description -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of goods nomenclature description -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="goodsNomenclatureDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Long description for goods nomenclature  -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="goodsNomenclatureFootnoteAssociation">
        <xsd:complexType>
            <!-- Footnote type -->
            <xsd:attribute ref="at:footnoteType"/>
            <!-- Footnote id -->
            <xsd:attribute ref="at:footnoteId"/>
            <!-- Validity start date of association between goods nomenclature item and footnote -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of association between goods nomenclature item and footnote -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="goodsNomenclatureGroupMembership">
        <xsd:complexType>
            <!-- Goods nomenclature group type -->
            <xsd:attribute ref="at:goodsNomenclatureGroupType"/>
            <!-- Goods nomenclature group -->
            <xsd:attribute ref="at:goodsNomenclatureGroupId"/>
            <!-- Validity start date of membership of goods nomenclature group -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of membership of goods nomenclature group -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
