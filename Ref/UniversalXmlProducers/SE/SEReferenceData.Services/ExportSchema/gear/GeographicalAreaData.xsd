<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 25000, 25005, 25010, 25015
 -->
	<xsd:element name="geographicalArea">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:geographicalAreaMembership" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:geographicalAreaDescriptionPeriod" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID for geographical area -->
            <xsd:attribute ref="at:SID"/>
            <!-- Geographical area code -->
            <xsd:attribute ref="at:geographicalAreaCode"/>
            <!-- Geographical area id -->
        	<xsd:attribute ref="at:geographicalAreaId"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- SID for parent geographical area group -->
            <xsd:attribute ref="at:SIDParentGroup"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="geographicalAreaMembership">
        <xsd:complexType>
            <!-- SID for geographical area group -->
            <xsd:attribute ref="at:SIDGeographicalAreaGroup"/>
            <!-- Validity start date of geographical area membership -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of geographical area membership -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="geographicalAreaDescriptionPeriod">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:geographicalAreaDescription" minOccurs="1" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID for geographical area description period -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date of geographical area description -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of geographical area description -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="geographicalAreaDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Geographical area name (description) -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
