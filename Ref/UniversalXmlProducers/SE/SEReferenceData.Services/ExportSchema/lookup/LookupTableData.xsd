<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 90000, 90010, 90015
 -->            
	<xsd:element name="lookupTable">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:lookupTableItem" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:lookupTableDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID of lookup table -->
            <xsd:attribute ref="at:SID"/>
            <!-- Lookup table id -->
            <xsd:attribute ref="at:tableId"/>
            <!-- Validity start date of lookup table -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of lookup table -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Minimum interval of lookup table -->
            <xsd:attribute ref="at:minInterval"/>
            <!-- Maximum interval of lookup table -->
            <xsd:attribute ref="at:maxInterval"/>
            <!-- Interpolate -->
            <xsd:attribute ref="at:interpolate"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="lookupTableItem">
        <xsd:complexType>
            <!-- Threshold -->
            <xsd:attribute ref="at:threshold"/>
            <!-- Value of threshold -->
            <xsd:attribute ref="at:value"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="lookupTableDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Long description of lookup table -->
            <xsd:attribute ref="at:description"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
