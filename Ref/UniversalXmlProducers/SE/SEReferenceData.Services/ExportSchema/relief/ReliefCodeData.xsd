<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 91200, 91230, 91220
 -->            
	<xsd:element name="reliefCode">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:reliefCodeDescriptionPeriod" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID of relief code -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date of relief code -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of relief code -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Type id of relief code -->
            <xsd:attribute ref="at:reliefCodeType"/>
            <!-- Relief code -->
            <xsd:attribute ref="at:reliefCode"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="reliefCodeDescriptionPeriod">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:reliefCodeDescription" minOccurs="1" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID of relief code description period -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date of relief code description -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of relief code description -->
            <xsd:attribute ref="at:dateEnd"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="reliefCodeDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Long description of relief code -->
            <xsd:attribute ref="at:description"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
