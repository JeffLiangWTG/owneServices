<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 20500, 20505, 20510
 -->            
	<xsd:element name="certificate">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:certificateDescriptionPeriod" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Certificate type code -->
        	<xsd:attribute ref="at:certificateType"/>
            <!-- Certificate code -->
        	<xsd:attribute ref="at:certificateCode"/>
            <!-- Validity start date of certificate -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of certificate -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="certificateDescriptionPeriod">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:certificateDescription" minOccurs="1" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID for certificate description period -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="certificateDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Short description of certificate -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>            
