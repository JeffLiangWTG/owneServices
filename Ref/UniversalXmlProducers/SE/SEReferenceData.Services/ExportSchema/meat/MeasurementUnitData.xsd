<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 21000, 21005
 -->
	<xsd:element name="measurementUnit">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:measurementUnitDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Measurement unit code -->
            <xsd:attribute ref="at:measurementUnitCode"/>
            <!-- Validity start date of measurement unit code -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of measurement unit code -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_SCALE_TO_REF -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the national column X_NATIONAL_ABBREV -->
            <xsd:attribute ref="at:nationalAbbreviation"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measurementUnitDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Short description of measurement unit -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
