<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 41000, 41005, 41010, 41015, 41020
 -->
	<xsd:element name="exportRefundNomenclature">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:exportRefundNomenclatureIndent" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:exportRefundNomenclatureDescriptionPeriod" minOccurs="0" maxOccurs="unbounded"/>
                <xsd:element ref="at:exportRefundNomenclatureFootnoteAssociation" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            
            <!-- SID for export refund nomenclature -->
            <xsd:attribute ref="at:SID"/>
            <!-- SID for goods nomenclature -->
            <xsd:attribute ref="at:SIDGoodsNomenclature"/>
            <!-- Goods nomenclature item id -->
        	<xsd:attribute ref="at:goodsNomenclatureCode"/>
            <!-- Additional code type -->
        	<xsd:attribute ref="at:additionalCodeType"/>
            <!-- Export refund code -->
        	<xsd:attribute ref="at:exportRefundCode"/>
            <!-- Product line suffix -->
        	<xsd:attribute ref="at:productLineSuffix"/>
            <!-- Validity start date of export refund nomenclature -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of export refund nomenclature -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="exportRefundNomenclatureIndent">
        <xsd:complexType>
            <!-- Validity start date of export refund nomenclature indent -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of export refund nomenclature indent -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Number of export refund nomenclature indents -->
            <xsd:attribute ref="at:quantityIndents"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="exportRefundNomenclatureDescriptionPeriod">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:exportRefundNomenclatureDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            
            <!-- SID for export refund nomenclature description period -->
            <xsd:attribute ref="at:SID"/>
            <!-- Validity start date of export refund nomenclature description -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of export refund nomenclature description -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="exportRefundNomenclatureDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Long description of export refund nomenclature -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="exportRefundNomenclatureFootnoteAssociation">
        <xsd:complexType>
            <!-- Footnote type  -->
            <xsd:attribute ref="at:footnoteType"/>
            <!-- Footnote id -->
            <xsd:attribute ref="at:footnoteId"/>
            <!-- Validity start date of association between export refund nomenclature and footnote -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of association between export refund nomenclature and footnote -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
