<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 44000, 44005
 -->
    <xsd:element name="monetaryExchangePeriod">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:monetaryExchangeRate" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- SID for exchange period -->
            <xsd:attribute ref="at:SID"/>
            <!-- ‘Parent’ monetary unit code -->
            <xsd:attribute ref="at:monetaryUnitCode"/>
            <!-- Start date of exchange period -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- End date of exchange period -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="monetaryExchangeRate">
        <xsd:complexType>
            <!-- ‘Child’ monetary unit code -->
            <xsd:attribute ref="at:monetaryUnitCode"/>
            <!-- Exhange rate -->
            <xsd:attribute ref="at:monetaryConversionRate"/>
            <!-- Represent the national column X_MONETARY_EXCHANGE_UNIT -->
            <xsd:attribute ref="at:calculationUnit"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
