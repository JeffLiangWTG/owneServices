<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export" targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified">
<!--  ============================  -->
<!--   Definition of simple types   -->
<!--  ============================  -->
<!--   Simple type definitions of the data export record   -->
<xsd:complexType name="parameters">
<xsd:sequence> </xsd:sequence>
</xsd:complexType>
<xsd:complexType name="items">
<xsd:sequence> </xsd:sequence>
</xsd:complexType>
<xsd:simpleType name="goodsNomenclatureCode">
<xsd:restriction base="xsd:string">
<xsd:pattern value="[0-9]{10}|[0-9]{8}"/>
</xsd:restriction>
</xsd:simpleType>
<xsd:simpleType name="changeType">
<xsd:restriction base="xsd:string">
<xsd:pattern value="[U]|[D]"/>
</xsd:restriction>
</xsd:simpleType>
<xsd:simpleType name="type">
<xsd:restriction base="xsd:string">
<xsd:pattern value="[I]|[E]"/>
</xsd:restriction>
</xsd:simpleType>
<!--   Simple element definitions of the data export record   -->
<xsd:element name="id" type="xsd:string"/>
<xsd:element name="exportType" type="xsd:string"/>
<xsd:element name="parameters" type="at:parameters"/>
<xsd:element name="items" type="at:items"/>
<!--   Other element definitions   -->
<xsd:element name="queryDateStart" type="xsd:date"/>
<xsd:element name="queryDateEnd" type="xsd:date"/>
<xsd:element name="dateStart" type="xsd:date"/>
<xsd:element name="dateEnd" type="xsd:date"/>
<!--  ==========================  -->
<!--   Definition of attributes   -->
<!--  ==========================  -->
<xsd:attribute name="changeType" type="at:changeType"/>
<xsd:attribute name="dateStart" type="xsd:date"/>
<xsd:attribute name="dateEnd" type="xsd:date"/>
<xsd:attribute name="goodsNomenclatureCode" type="at:goodsNomenclatureCode"/>
<xsd:attribute name="type" type="at:type"/>
<!--  ======================================  -->
<!--   Definition of the data export record   -->
<!--  ======================================  -->
<xsd:element name="export">
<xsd:complexType mixed="true">
<xsd:sequence>
<xsd:element ref="at:id"/>
<xsd:element ref="at:exportType"/>
<xsd:element ref="at:parameters"/>
<xsd:element ref="at:items"> </xsd:element>
</xsd:sequence>
</xsd:complexType>
</xsd:element>
</xsd:schema>