{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Measures",
	"description": "Footnotes process schema",
	"type": "array",
	"items": {
		"type": "object",
		"properties": {
			"footnote_id": {
				"description": "The unique identifier for a footnote",
				"type": "string"
			},
			"descriptions": {
				"type": [ "array", "null" ],
				"items": {
					"type": "object",
					"properties": {
						"lang": {
							"type": "string"
						},
						"text": {
							"type": "string"
						}
					},
					"required": [
						"lang",
						"text"
					]
				},
				"uniqueItems": true,
				"maxItems": 2
			}
		},
		"required": [
			"footnote_id",
			"descriptions"
		]
	},
	"minItems": 1,
	"uniqueItems": true
}
