{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Measures",
	"description": "Measures process schema",
	"type": "array",
	"items": {
		"type": "object",
		"properties": {
			"goods_id": {
				"description": "The unique identifier for a tariff",
				"type": "string"
			},
			"flow": {
				"type": "string"
			},
			"geographical_area": {
				"type": "string"
			},
			"excluded_geographical_area": {
				"type": [ "array", "null" ],
				"items": {
					"type": "string"
				}
			},
			"measure_type": {
				"type": "string"
			},
			"footnotes": {
				"type": [ "array", "null" ],
				"items": {
					"type": "string"
				},
				"uniqueItems": true
			},
			"start_date": {
				"type": [ "string", "null" ],
				"format": "dd/MM/yyyy"
			},
			"end_date": {
				"type": [ "string", "null" ],
				"format": "dd/MM/yyyy"
			},
			"legal_reference": {
				"type": "string"
			},
			"duty": {
				"type": [ "string", "null" ]
			},
			"conditions": {
				"type": [ "string", "null" ]
			},
			"codadd": {
				"type": [ "string", "null" ]
			},
			"order_number_id": {
				"type": [ "string", "null" ]
			}
		},
		"required": [
			"goods_id",
			"flow",
			"measure_type"
		]
	},
	"minItems": 1
}
