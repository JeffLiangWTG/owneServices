    </EmbeddedResource>
    <EmbeddedResource Include="TariffOne\Schemas\DataExportJsonSchema.json" />
    <EmbeddedResource Include="CodeLists\CSVProcessor\*.csv" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.RefDbRepo.Common.Argument">
      <HintPath>..\..\..\bin\UniversalXMLProducers\net8.0\CargoWise.RefDbRepo.Common.Argument.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.RefDbRepo.SharedReferenceData.Services">
      <HintPath>..\..\..\bin\UniversalXmlProducers\net8.0\CargoWise.RefDbRepo.SharedReferenceData.Services.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>