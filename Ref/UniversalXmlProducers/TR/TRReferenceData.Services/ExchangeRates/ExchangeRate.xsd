<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="Tarih_Date">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Currency"/>
      </xs:sequence>
      <xs:attribute name="Bulten_No" use="required"/>
      <xs:attribute name="Date" use="required"/>
      <xs:attribute name="Tarih" use="required" type="xs:NMTOKEN"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Currency">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Unit" type="xs:integer"/>
        <xs:element name="Isim" type="xs:string"/>
        <xs:element name="CurrencyName" type="xs:string"/>
        <xs:element name="ForexBuying" type="xs:string"/>
        <xs:element name="ForexSelling" type="xs:string"/>
        <xs:element name="BanknoteBuying" type="xs:string"/>
        <xs:element name="BanknoteSelling" type="xs:string"/>
        <xs:element name="CrossRateUSD" type="xs:string"/>
        <xs:element name="CrossRateOther" type="xs:string"/>
      </xs:sequence>
      <xs:attribute name="CrossOrder" use="required" type="xs:integer"/>
      <xs:attribute name="CurrencyCode" use="required" type="xs:NCName"/>
      <xs:attribute name="Kod" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
