<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="FsisEstNumbersCrawler.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="UpdateType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">FULL</Value>
    </Setting>
    <Setting Name="DataSource" Type="System.String" Scope="Application">
      <Value Profile="(Default)">US FSIS Establishment Numbers Code List</Value>
    </Setting>
    <Setting Name="ZZD_ZZK_NKCodeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">FSIS</Value>
    </Setting>
    <Setting Name="ZZD_ZZZ_NKDataGrouping" Type="System.String" Scope="Application">
      <Value Profile="(Default)">US</Value>
    </Setting>
    <Setting Name="ZZD_EndDate" Type="System.DateTime" Scope="Application">
      <Value Profile="(Default)">06/06/2079 23:59:00</Value>
    </Setting>
    <Setting Name="ServiceUrl" Type="System.String" Scope="Application">
      <Value Profile="(Default)">http://www.fsis.usda.gov/mpidirectory</Value>
    </Setting>
    <Setting Name="ServiceHost" Type="System.String" Scope="Application">
      <Value Profile="(Default)">https://www.fsis.usda.gov/</Value>
    </Setting>
    <Setting Name="Schema" Type="System.String" Scope="Application">
      <Value Profile="(Default)">		
		&lt;EntityType Name="RefCusCodeList" Data="true"&gt;
			&lt;Key&gt;
				&lt;PropertyRef Name="ZZD_ZZK_NKCodeType" /&gt;
				&lt;PropertyRef Name="ZZD_ZZZ_NKDataGrouping" /&gt;
				&lt;PropertyRef Name="ZZD_Code" /&gt;
			&lt;/Key&gt;
			&lt;Property Name="ZZD_ZZK_NKCodeType" Type="varchar" MaxLength="5" /&gt;
			&lt;Property Name="ZZD_Code" Type="varchar" MaxLength="35" /&gt;
			&lt;Property Name="ZZD_Description" Type="nvarchar(max)" /&gt;
			&lt;Property Name="ZZD_StartDate" Type="smalldatetime" /&gt;
			&lt;Property Name="ZZD_EndDate" Type="smalldatetime" /&gt;
			&lt;Property Name="ZZD_ZZZ_NKDataGrouping" Type="varchar" MaxLength="3" /&gt;
			&lt;Property Name="RefCusCodeListAttribute" Type="RefCusCodeListAttribute" /&gt;
		&lt;/EntityType&gt;
		&lt;EntityType Name="RefCusCodeListAttribute" Data="true"&gt;
			&lt;Key&gt;
				&lt;PropertyRef Name="ZZE_ZXE_NKName" /&gt;
			&lt;/Key&gt;
			&lt;Property Name="ZZE_ZXE_NKName" Type="varchar" MaxLength="32" /&gt;
			&lt;Property Name="ZZE_Value" Type="varchar" MaxLength="100" /&gt;
		&lt;/EntityType&gt;
	</Value>
    </Setting>
    <Setting Name="CompanyAttributeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">USFSISEstablishmentNumberCompany</Value>
    </Setting>
    <Setting Name="StreetAttributeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">USFSISEstablishmentNumberStreet</Value>
    </Setting>
    <Setting Name="CityAttributeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">USFSISEstablishmentNumberCity</Value>
    </Setting>
    <Setting Name="StateAttributeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">USFSISEstablishmentNumberState</Value>
    </Setting>
    <Setting Name="ZipAttributeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">USFSISEstablishmentNumberZip</Value>
    </Setting>
    <Setting Name="PhoneAttributeType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">USFSISEstablishmentNumberPhone</Value>
    </Setting>
    <Setting Name="OutputPath" Type="System.String" Scope="Application">
      <Value Profile="(Default)">..\UxmlFiles</Value>
    </Setting>
  </Settings>
</SettingsFile>