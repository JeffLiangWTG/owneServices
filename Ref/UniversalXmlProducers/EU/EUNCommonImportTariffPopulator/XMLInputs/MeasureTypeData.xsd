<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://www.arcticgroup.se/tariff/arctictariff/export" elementFormDefault="qualified"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:at="http://www.arcticgroup.se/tariff/arctictariff/export">
<!--
	Representation of TARIC record 23500, 23505
 -->
	<xsd:include schemaLocation="BaseDataExport.xsd"/>
	<xsd:element name="measureType">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element ref="at:measureTypeDescription" minOccurs="0" maxOccurs="unbounded"/>
            </xsd:sequence>
            <!-- Measure type id -->
            <xsd:attribute ref="at:measureType"/>
            <!-- Validity start date of measure type id -->
            <xsd:attribute ref="at:dateStart"/>
            <!-- Validity end date of measure type id -->
            <xsd:attribute ref="at:dateEnd"/>
            <!-- Trade movement code -->
            <xsd:attribute ref="at:tradeMovementCode"/>
            <!-- Priority code -->
            <xsd:attribute ref="at:priorityCode"/>
            <!-- Measure component applicable code -->
            <xsd:attribute ref="at:measureComponentApplicableCode"/>
            <!-- Origin/destination code -->
            <xsd:attribute ref="at:originDestinationCode"/>
            <!-- Order number capture code -->
            <xsd:attribute ref="at:orderNumberCaptureCode"/>
            <!-- Measure explosion level -->
            <xsd:attribute ref="at:explosionLevel"/>
            <!-- Measure type series id -->
            <xsd:attribute ref="at:measureTypeSeriesId"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
            <!-- Represent the type of update that has been performed for this element -->
        	<xsd:attribute ref="at:changeType"/>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:element name="measureTypeDescription">
        <xsd:complexType>
            <!-- Language id of description -->
            <xsd:attribute ref="at:languageId"/>
            <!-- Short description of measure type -->
            <xsd:attribute ref="at:description"/>
            <!-- Represent the national column X_NATIONAL -->
            <xsd:attribute ref="at:national"/>
        </xsd:complexType>
    </xsd:element>
    
</xsd:schema>
