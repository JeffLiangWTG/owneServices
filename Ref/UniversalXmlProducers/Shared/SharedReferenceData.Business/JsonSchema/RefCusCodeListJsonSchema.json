{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "RefCusCodeList",
	"description": "RefCusCodeList process schema",
	"type": "array",
	"items": {
		"type": "object",
		"properties": {
			"CodeType": {
				"type": "string",
				"maxLength": 5
			},
			"Code": {
				"type": "string"
			},
			"Description": {
				"type": "string"
			},
			"StartDate": {
				"type": "string",
				"format": "MM/dd/yyyy"
			},
			"EndDate": {
				"type": "string",
				"format": "MM/dd/yyyy"
			},
			"Country": {
				"type": "string",
				"maxLength": 3
			},
			"Attributes": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"Type": {
							"type": "string"
						},
						"Value": {
							"type": "string"
						}
					}
				}
			}
		},
		"required": [
			"CodeType",
			"Code",
			"Description",
			"Country"
		]
	}
}
