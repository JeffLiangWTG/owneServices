{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "RefCusTariff",
	"description": "RefCusTariff process schema",
	"type": "array",
	"items": {
		"type": "object",
		"properties": {
			"TariffCode": {
				"description": "The unique identifier for a tariff",
				"type": "string"
			},
			"Description": {
				"type": "string"
			},
			"Country": {
				"type": "string",
				"maxLength": 3
			},
			"TariffType": {
				"type": "string",
				"maxLength": 5
			},
			"StartDate": {
				"type": "string",
				"format": "MM/dd/yyyy"
			},
			"EndDate": {
				"type": "string",
				"format": "MM/dd/yyyy"
			},
			"Attributes": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"Type": {
							"type": "string"
						},
						"Value": {
							"type": "string"
						}
					},
					"required": [
						"Type",
						"Value"
					]
				},
				"uniqueItems": true
			},
			"ParentTariffs": {
				"type": "array",
				"items": {
					"type": "string"
				},
				"uniqueItems": true
			},
			"Rates": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"RateType": {
							"type": "string"
						},
						"RateCode": {
							"type": "string"
						},
						"RateFormula": {
							"type": "string"
						},
						"StartDate": {
							"type": "string",
							"format": "MM/dd/yyyy"
						},
						"EndDate": {
							"type": "string",
							"format": "MM/dd/yyyy"
						},
						"Applicabilitys": {
							"type": "array",
							"items": {
								"type": "object",
								"properties": {
									"TradeGroup": {
										"type": "string"
									},
									"StartDate": {
										"type": "string",
										"format": "MM/dd/yyyy"
									},
									"EndDate": {
										"type": "string",
										"format": "MM/dd/yyyy"
									},
									"Exclusions": {
										"type": "array",
										"items": {
											"type": "string"
										}
									}
								},
								"required": [
									"TradeGroup"
								]
							},
							"uniqueItems": true
						}
					},
					"required": [
						"RateType",
						"RateCode"
					]
				},
				"uniqueItems": true
			}
		},
		"required": [
			"TariffCode",
			"Country",
			"TariffType",
			"StartDate",
			"EndDate"
		]
	},
	"minItems": 1,
	"uniqueItems": true
}
