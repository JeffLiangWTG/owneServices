<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="MXRefLocoMap.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="UpdateType" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Partial</Value>
    </Setting>
    <Setting Name="OutputPath" Type="System.String" Scope="Application">
      <Value Profile="(Default)">..\UxmlFiles</Value>
    </Setting>
    <Setting Name="ZZD_EndDate" Type="System.String" Scope="Application">
      <Value Profile="(Default)">06/06/2079 23:59:00</Value>
    </Setting>
    <Setting Name="Schema" Type="System.String" Scope="Application">
      <Value Profile="(Default)">
					&lt;EntityType Name="RefLocoMap" Data="true"&gt;
					&lt;Key&gt;
					&lt;PropertyRef Name="RY_LocalPortCode" /&gt;
					&lt;PropertyRef Name="RY_RL_NKLocoPort" /&gt;
					&lt;PropertyRef Name="RY_SystemUsage" /&gt;
					&lt;PropertyRef Name="RY_RN_NKCountryCode" /&gt;
					&lt;/Key&gt;
					&lt;Property Name="RY_LocalPortCode" Type="varchar" MaxLength="10" /&gt;
					&lt;Property Name="RY_RL_NKLocoPort" Type="varchar" MaxLength="5" /&gt;
					&lt;Property Name="RY_SystemUsage" Type="varchar" MaxLength="3" /&gt;
					&lt;Property Name="RY_RN_NKCountryCode" Type="char" MaxLength="2" /&gt;
					&lt;/EntityType&gt;
				</Value>
    </Setting>
    <Setting Name="DataSource" Type="System.String" Scope="Application">
      <Value Profile="(Default)">Customs Port Code List</Value>
    </Setting>
  </Settings>
</SettingsFile>