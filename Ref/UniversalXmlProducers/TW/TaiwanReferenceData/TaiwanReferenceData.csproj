      <DependentUpon>Reference.svcmap</DependentUpon>
    </None>
    <None Update="Connected Services\TurnkeyPlugInUpdateService\TaiwanReferenceData.TurnkeyPlugInUpdateService.updateInfoBean.datasource">
      <DependentUpon>Reference.svcmap</DependentUpon>
    </None>
    <None Update="Connected Services\TurnkeyPlugInUpdateService\UpdateInfoServiceService.xsd">
