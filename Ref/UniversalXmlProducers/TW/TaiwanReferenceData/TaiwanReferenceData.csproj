    <AssemblyName>CargoWise.RefDbRepo.TaiwanReferenceData</AssemblyName>
    <RootNamespace>CargoWise.RefDbRepo.TaiwanReferenceData</RootNamespace>
    <Configurations>Debug;Release;UAT</Configurations>
