  <xsd:simpleType name="CertificateTemplateType">
    <xsd:restriction base="xsd:token">
      <xsd:minLength value="1" />
      <xsd:maxLength value="11" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="CertificateEndorsementType">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="11" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="CommodityType">
    <xsd:annotation>
      <xsd:documentation>Value is restricted to code values from the ECM_COMMODITY_TYPE code table.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="3" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StateType">
    <xsd:annotation>
      <xsd:documentation>The state/province of an address.  For overseas state/provinces use the full description - not the code</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="20" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AustralianStateType">
    <xsd:annotation>
      <xsd:documentation>Correspondends to a state code in the ECM_STATE codeset.</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="3" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ProcessType">
    <xsd:annotation>
      <xsd:documentation>A two alpha character code identifying a process type for the enclosing production
				process. For
				example inspection or packaging.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="2" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ProcessingIndicatorType">
    <xsd:annotation>
      <xsd:documentation>Value is restricted to code values from the ECM_ESTABLISHMENT_INDICATOR code table.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="2" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="MessageId">
    <xsd:restriction base="xsd:token" />
  </xsd:simpleType>
  <xsd:simpleType name="PreservationType">
    <xsd:annotation>
      <xsd:documentation>Value is restricted to code values from the ECM_PRESERVATION_TYPE code table.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token" />
  </xsd:simpleType>
  <xsd:simpleType name="AheccCodeType">
    <xsd:annotation>
      <xsd:documentation>Code which correlates to the Australian Harmonized Export Commodity Classification.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="12" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ReissueReasonCodeType">
    <xsd:annotation>
      <xsd:documentation>Value is restricted to code values from the ECM_REISSUE_REASON code table.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="2" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ReissueReasonTextType">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="500" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TokenType">
    <xsd:annotation>
      <xsd:documentation>A unique token presented as a UUID.</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:maxLength value="40" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="EmailAddressType">
    <xsd:annotation>
      <xsd:documentation>email address with a max length of 250 chars.</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[^@]+@[^\.]+\..+" />
      <xsd:maxLength value="250" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="NatureOfCommodityType">
    <xsd:annotation>
      <xsd:documentation>Value is restricted to code values from the ECM_NATURE_OF_COMMODITY code table.</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:minLength value="1" />
      <xsd:maxLength value="15" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="NexdocSoapFaultItem">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="1" name="FaultCode" type="xsd:string" />
      <xsd:element minOccurs="0" maxOccurs="1" name="FaultReason" type="xsd:string" />
      <xsd:element minOccurs="0" maxOccurs="1" name="FaultMessage" type="xsd:string" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="NexdocSoapFault">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" maxOccurs="1" name="FaultTimestamp" type="xsd:dateTime" />
        <xsd:element minOccurs="0" maxOccurs="unbounded" name="NexdocSoapFaultItem" type="ct:NexdocSoapFaultItem" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:complexType name="AttachmentsType">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="unbounded" name="attachment" type="ct:AttachmentType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="AttachmentType">
    <xsd:sequence>
      <xsd:element name="name" type="ct:AlphaNumeric200Type" />
      <xsd:choice>
        <xsd:sequence minOccurs="0" maxOccurs="1">
          <xsd:element minOccurs="0" default="false" name="removeEntry" type="xsd:boolean" />
        </xsd:sequence>
        <xsd:sequence minOccurs="0" maxOccurs="1">
          <xsd:element minOccurs="0" name="attachmentType" type="ct:AlphaNumeric6Type" />
          <xsd:element name="description" type="ct:AlphaNumeric200Type" />
          <xsd:element name="mimeType" type="ct:AlphaNumeric100Type" />
          <xsd:element minOccurs="0" name="data" type="xsd:base64Binary" />
        </xsd:sequence>
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>