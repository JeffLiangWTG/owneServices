      <xsd:element minOccurs="0" name="forward" type="ct:UserIdType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="IdentificationType">
    <xsd:annotation>
      <xsd:documentation>This type contains the Rex number which is used to uniquely relate to a created Rex
				record.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element minOccurs="1" maxOccurs="1" name="rexNumber" type="ct:RexNumberType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ValidationsNoticeType">
    <xsd:sequence>
      <xsd:element minOccurs="0" name="noticeId" type="xsd:string" />
      <xsd:element name="noticeType" type="et:NoticeType" />
      <xsd:element name="noticeMessage" type="xsd:string" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ConsigneeType">
    <xsd:annotation>
      <xsd:documentation>Contains the name and address elements relating to the consignee information for a Rex
				record or
				related certificate.
			</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element minOccurs="0" name="consigneeName" type="ct:RestrictedAlphaNumeric70Type" />
      <xsd:element minOccurs="0" name="consigneeAddress" type="ct:AddressType" />
      <xsd:element minOccurs="0" name="consigneePhoneNumber" type="ct:AlphaNumeric20Type" />
      <xsd:element minOccurs="0" name="consigneeRepresentative" type="ct:AlphaNumeric254Type" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="AddressType">
    <xsd:annotation>
      <xsd:documentation>This type contains the related elements which constitute an address.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element minOccurs="0" name="streetAddress" type="ct:StreetAddressType" />
      <xsd:element minOccurs="0" name="city" type="ct:RestrictedAlphaNumeric35TokenType" />
      <xsd:element minOccurs="0" name="state" type="ct:StateType" />
      <xsd:element minOccurs="0" name="country" type="ct:CountryType" />
      <xsd:element minOccurs="0" name="postalCode" type="ct:RestrictedAlphaNumeric10TokenType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="StreetAddressType">
    <xsd:sequence minOccurs="0" maxOccurs="2">
      <xsd:element name="streetLine" type="ct:RestrictedAlphaNumeric35TokenType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ExporterStreetAddressType">
    <xsd:sequence minOccurs="0" maxOccurs="3">
      <xsd:element name="streetLine" type="xsd:string" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CustomsAgentType">
    <xsd:simpleContent>
      <xsd:extension base="et:YesNoType" />
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="WeightType">
