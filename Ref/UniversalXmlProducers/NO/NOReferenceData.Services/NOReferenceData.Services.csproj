<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CargoWise.RefDbRepo.NOReferenceData.Services</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.NOReferenceData.Services</AssemblyName>
    <Configurations>Debug;Release;UAT</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>..\..\..\bin\UniversalXMLProducers</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs"/>
    <EmbeddedResource Include="ExchangeRates\*.xsd"/>
    <EmbeddedResource Include="ReferenceCodes\*.xsd"/>
    <EmbeddedResource Include="Tariff\*.xsd"/>
    <EmbeddedResource Include="TradeGroups\*.xsd"/>
    <EmbeddedResource Include="RefCusConditions\*.xml"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="**\*.en.cs">
      <DependentUpon>$([System.String]::Copy(%(Filename)).Replace(".en",".xsd"))</DependentUpon>
    </Compile>
  </ItemGroup>
  <Import Project="..\..\..\.paket\Paket.Restore.targets"/>
</Project>