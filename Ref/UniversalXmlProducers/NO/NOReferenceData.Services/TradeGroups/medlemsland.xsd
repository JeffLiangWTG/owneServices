<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="medlemsland" type="MedlemLandListe"/>

  <xs:complexType name="MedlemLandListe">
    <xs:complexContent>
      <xs:extension base="norskDataset">
        <xs:sequence>
          <xs:element name="medlem" type="Medlemsland" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="norskDataset" abstract="true">
    <xs:complexContent>
      <xs:extension base="dataset">
        <xs:sequence>
          <xs:element name="versjon" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="dataset" abstract="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="Medlemsland">
    <xs:sequence>
      <xs:element name="landkode" type="xs:string" minOccurs="0"/>
      <xs:element name="landnavn" type="xs:string" minOccurs="0"/>
      <xs:element name="landgrupper" type="Landgruppe" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Landgruppe">
    <xs:sequence>
      <xs:element name="landgruppekode" type="xs:string" minOccurs="0"/>
      <xs:element name="landgruppenavn" type="xs:string" minOccurs="0"/>
      <xs:element name="preferansekode" type="xs:string" minOccurs="0"/>
      <xs:element name="fomdato" type="xs:string" minOccurs="0"/>
      <xs:element name="tomdato" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
