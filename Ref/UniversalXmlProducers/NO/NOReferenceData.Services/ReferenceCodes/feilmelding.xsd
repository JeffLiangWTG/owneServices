<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="feilmelding" type="FeilmeldingListe"/>

  <xs:complexType name="FeilmeldingListe">
    <xs:complexContent>
      <xs:extension base="norskDataset">
        <xs:sequence>
          <xs:element name="feilmelding" type="Feilmelding" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="norskDataset" abstract="true">
    <xs:complexContent>
      <xs:extension base="dataset">
        <xs:sequence>
          <xs:element name="versjon" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="dataset" abstract="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="Feilmelding">
    <xs:sequence>
      <xs:element name="meldingNummer" type="xs:string" minOccurs="0"/>
      <xs:element name="meldingTekst" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>

