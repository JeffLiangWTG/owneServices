<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="referanser" type="referanserListe"/>

  <xs:complexType name="referanserListe">
    <xs:complexContent>
      <xs:extension base="norskDataset">
        <xs:sequence>
          <xs:element name="referanse" type="Referanse" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="norskDataset" abstract="true">
    <xs:complexContent>
      <xs:extension base="dataset">
        <xs:sequence>
          <xs:element name="versjon" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="dataset" abstract="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="Referanse">
    <xs:sequence>
      <xs:element name="kode" type="xs:string" minOccurs="0"/>
      <xs:element name="beskrivelse" type="xs:string" minOccurs="0"/>
      <xs:element name="fomdato" type="xs:string" minOccurs="0"/>
      <xs:element name="tomdato" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>

