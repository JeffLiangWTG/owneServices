<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="varenumre" type="VarenummerListe"/>

  <xs:complexType name="VarenummerListe">
    <xs:complexContent>
      <xs:extension base="norskDataset">
        <xs:sequence>
          <xs:element name="varenummer" type="varenummer" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="norskDataset" abstract="true">
    <xs:complexContent>
      <xs:extension base="dataset">
        <xs:sequence>
          <xs:element name="versjon" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="dataset" abstract="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="varenummer">
    <xs:sequence>
      <xs:element name="id" type="xs:string" minOccurs="0"/>
      <xs:element name="enhet" type="xs:string" minOccurs="0"/>
      <xs:element name="enhetBeskrivelse" type="xs:string" minOccurs="0"/>
      <xs:element name="annenEnhet" type="xs:string" minOccurs="0"/>
      <xs:element name="annenEnhetBeskrivelse" type="xs:string" minOccurs="0"/>
      <xs:element name="fomdato" type="xs:string" minOccurs="0"/>
      <xs:element name="tomdato" type="xs:string" minOccurs="0"/>
      <xs:element name="fomperiode" type="xs:string" minOccurs="0"/>
      <xs:element name="tomperiode" type="xs:string" minOccurs="0"/>
      <xs:element name="klassifiseringer" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="klassifisering" type="Klassifisering" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Klassifisering">
    <xs:sequence>
      <xs:element name="kode" type="xs:string" minOccurs="0"/>
      <xs:element name="klassifiseringBeskrivelse" type="xs:string" minOccurs="0"/>
      <xs:element name="fomdato" type="xs:string" minOccurs="0"/>
      <xs:element name="tomdato" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>

