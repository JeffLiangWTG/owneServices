<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />
	<Import Project="..\packages\Fody\build\Fody.targets" Condition="!$(MSBuildProjectFullPath.Contains('Test')) And !$(MSBuildProjectFullPath.Contains('Common\Common\Common.csproj')) And Exists('..\packages\Fody\build\Fody.targets')" />
	<!-- Custom target to check for the package reference -->
	<Target Name="CheckAndIncludePackageReference" AfterTargets="PaketRestore">
		<ItemGroup>
			<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.1" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Logging.Abstractions')) == false" />
			<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.6.3" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.IdentityModel.Tokens')) == false" />
			<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.3" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'System.IdentityModel.Tokens.Jwt')) == false" />
			<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.4" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.DependencyInjection.Abstractions')) == false" />
			<PackageReference Include="System.Security.Permissions" Version="6.0.0" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'System.Security.Permissions')) == false" />
			<PackageReference Include="System.Drawing.Common" Version="7.0.0" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'System.Drawing.Common')) == false" />
			<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Extensions.Configuration.Abstractions')) == false" />
			<PackageReference Include="System.CodeDom" Version="7.0.0" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'System.CodeDom')) == false" />
			<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Microsoft.Data.SqlClient')) == false" />
	  </ItemGroup>
	</Target>
</Project>
