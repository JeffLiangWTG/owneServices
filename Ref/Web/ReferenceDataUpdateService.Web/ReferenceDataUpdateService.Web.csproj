<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ReferenceDataUpdateService.Web</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.ReferenceDataUpdateService.Web</AssemblyName>
    <OutputPath>..\..\Bin\Portal\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Configurations>Debug;Release;UAT</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>
  <ItemGroup>
    <None Include="DataSets.ttinclude">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>DataSets.cs</LastGenOutput>
    </None>
    <Content Include="build.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="RefDbRepoModels.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <CustomToolNamespace>NoNameSpaceForWeb</CustomToolNamespace>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="npm run-script build:DEV -- --output-path=&quot;wwwroot&quot;" Condition="'$(Configuration)' == 'Debug'" />
  </Target>
</Project>