<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CargoWise.RefDbRepo.Common.TypeProvider</RootNamespace>
    <AssemblyName>CargoWise.RefDbRepo.Common.TypeProvider</AssemblyName>
    <OutputPath>..\..\..\Bin\Common\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release;UAT</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\EDI-Release-private.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Argument\Argument.csproj" />
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Server\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Staging\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\UniversalXmlProducers\net8.0\&quot;&#xD;&#xA;if not $(Configuration) == Release (&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\Server\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\Staging\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\UniversalXmlProducers\net8.0\&quot;&#xD;&#xA;)" />
  </Target>
  <Import Project="..\..\..\.paket\Paket.Restore.targets" />
</Project>