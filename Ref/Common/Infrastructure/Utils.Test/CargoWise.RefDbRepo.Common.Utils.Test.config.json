{
	"serilog:using:RollingFile": "Serilog.Sinks.RollingFile",
	"serilog:write-to:RollingFile.pathFormat": "%TempPath%\\{RefLogFileName}-{Date}.txt",
	"serilog:write-to:RollingFile.outputTemplate": "{Timestamp:HH:mm:ss.fff} [{NamedContext}] [{Level}] {Message}{NewLine}{Exception}",
	"serilog:write-to:RollingFile.shared": true
}
