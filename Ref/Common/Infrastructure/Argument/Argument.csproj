<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CargoWise.RefDbRepo.Common.Argument</AssemblyName>
    <RootNamespace>CargoWise.RefDbRepo.Common.Argument</RootNamespace>
    <Configurations>Debug;Release;UAT</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\EDI-Release-private.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>..\..\..\Bin\Common\</OutputPath>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Server\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Staging\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\UniversalXmlProducers\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Tools\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetPath)&quot; &quot;$(TargetDir)..\..\Portal\net8.0\&quot;&#xD;&#xA;if not $(Configuration) == Release (&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\Server\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\Staging\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\UniversalXmlProducers\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\StagingService\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\Tools\net8.0\&quot;&#xD;&#xA;xcopy /r /y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(TargetDir)..\..\Portal\net8.0\&quot;&#xD;&#xA;)" />
  </Target>

  <ItemGroup>
    <Compile Include="..\..\..\CommonAssemblyInfo.cs" Link="CommonAssemblyInfo.cs" />
  </ItemGroup>

</Project>
