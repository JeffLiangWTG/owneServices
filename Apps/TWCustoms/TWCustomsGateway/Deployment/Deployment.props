<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_SiteName>Default Web Site</_SiteName>
    <_ServiceName>TWCustomsGateway</_ServiceName>
    <_AnonymousAuthenticationEnabled>true</_AnonymousAuthenticationEnabled>
    <_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
    <_BackupFolder>c:\eServicesTesting\TWCustomsGateway_backup</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
  <ItemGroup>
    <_Binding Include="1">
      <IPAddress>*</IPAddress>
      <Port>80</Port>
      <Protocol>http</Protocol>
    </_Binding>
  </ItemGroup>
</Project>