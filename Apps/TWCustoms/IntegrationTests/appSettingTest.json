{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "LevelSwitches": {
      "$appLevelSwitch": "Debug"
    },
    "MinimumLevel": {
      "ControlledBy": "$appLevelSwitch"
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "TWCustomsGateway"
    }
  },
  "AllowedHosts": "*",
}