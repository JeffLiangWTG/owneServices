{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console", "Serilog.Sinks.EventLog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "fileSizeLimitBytes": 10485760,
          "path": "logs\\KafkaProducerService.log",
          "retainedFileCountLimit": 10,
          "rollOnFileSizeLimit": true,
          "formatter": "CargoWise.eHub.MessageEvent.KafkaProducerService.Logging.IndentationFormatterWrapper::Formatter, CargoWise.eHub.MessageEvent.KafkaProducerService"
        }
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "MessageEvent",
          "manageEventSource": true,
          "restrictedToMinimumLevel": "Error",
          "formatter": "CargoWise.eHub.MessageEvent.KafkaProducerService.Logging.IndentationFormatterWrapper::Formatter, CargoWise.eHub.MessageEvent.KafkaProducerService"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "eHubTransactions": "Data Source=localhost;Initial Catalog=eHubTransactions;Integrated Security=SSPI;TrustServerCertificate=true;"
  },
  "ServiceBroker": {
    "BatchSize": 4000,
    "TimeoutSecond": 600,
    "RetryIntervalSeconds": 5 
  },
  "Kafka": {
    "EnableIdempotence": "true",
    "BootstrapServers": "106-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,107-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,108-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,109-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,110-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044",
    "SaslUsername": "eservices-message-events-test",
    "Topic": "eservices-message-events-test",
    "TransactionTimeoutSecond": 60,
    "TransactionalId": "eservices-message-events-test-txn-id"
  }
}
