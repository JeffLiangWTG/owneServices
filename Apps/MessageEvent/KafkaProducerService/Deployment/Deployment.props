<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_BinPath>Bin</_BinPath>
    <_ServiceName>MessageEventKafkaProducerService</_ServiceName>
    <_ServiceDisplayName>MessageEvent KafkaProducerService</_ServiceDisplayName>
    <_ServiceDescription>MessageEvent KafkaProducerService</_ServiceDescription>
    <_ServiceFilesPath>$(_BinPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eHub.MessageEvent.KafkaProducerService.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServices</_DeploymentFolder>
    <_BackupFolder>c:\eServices\Backup</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>