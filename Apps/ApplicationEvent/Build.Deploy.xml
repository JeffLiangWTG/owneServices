        <Add Name="DEST_CONNECTION" Value="wmsvc=au2wp-smsg-403b.wisecloud.zone,username=PROD\s_eServicesDeploy,password=&quot;$(Secrets:ESERVICES_DEPLOY_PWD_PROD)&quot;" />
