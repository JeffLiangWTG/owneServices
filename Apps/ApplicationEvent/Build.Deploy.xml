  <!-- Common Settings
         Default settings that are available in deployments are:
            DAT_DEPLOYMENT_CONFIGURATION  - Value of DeploymentConfiguration in Build.xml.
            DAT_DEPLOYMENT_NAME           - DeploymentConfiguration with special characters removed.
            DAT_SOURCE_PATH               - Path to root of repo source files.
            DAT_BIN_PATH                  - Path to Bin folder.
            TIMESTAMP                     - UTC time at start of build. Format is "yyyyMMdd.HHmmssZ".-->
  <Settings>
    <Add Name="MSDEPLOY" Value="&quot;%ProgramFiles%\IIS\Microsoft Web Deploy V3\msdeploy.exe&quot; -allowUntrusted -verbose" />
    <Add Name="PUBLISH_PATH" Value="%DAT_BIN_PATH%\Publish\eServices.ApplicationEvent.EnrichmentService" />
    <Add Name="DEPLOY_STAGING_DIR" Value="C:\eServices.Deploy\%DAT_DEPLOYMENT_CONFIGURATION%" />
    <Add Name="DEPLOY_STAGING_PATH" Value="%DEPLOY_STAGING_DIR%\%TIMESTAMP%" />
    <Add Name="SVC_NAME" Value="eServices.ApplicationEvent.EnrichmentService" />
    <Add Name="SVC_DISPNAME" Value="eServices Application Event Enrichment" />
    <Add Name="SVC_PATH" Value="C:\eServices\eServices.ApplicationEvent.EnrichmentService" />
    <Add Name="SVC_FC_GROUP_PROD" Value="esv-appevents" />
    <Add Name="CMD_VERIFY_DOTNET">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell $runtimes = (dotnet --list-runtimes ^| Select-Object @{n='Parts';e={$_ -split ' '}} ^| Select-Object @{n='Name';e={$_.Parts[0]}}, @{n='Version';e={[version]$_.Parts[1]}}); if (-not ($runtimes ^| Where-Object { ($_.Name -eq 'Microsoft.AspNetCore.App') -and ($_.Version -ge [version]'9.0.0') }) -or -not ($runtimes ^| Where-Object { ($_.Name -eq 'Microsoft.NETCore.App') -and ($_.Version -ge [version]'9.0.0') })) { Write-Host 'Installed runtimes:'; $runtimes ^| Write-Host; throw 'Missing required dotnet runtimes' }",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_STOP_SERVICE"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell if (Get-Service %SVC_NAME% -ErrorAction SilentlyContinue) { Stop-Service %SVC_NAME% -Force -Verbose }",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_START_SERVICE"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell Start-Service %SVC_NAME% -Verbose;",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_MOVE_FC_GROUP"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell Get-ClusterGroup %SVC_FC_GROUP% ^| Where-Object OwnerNode -EQ $env:COMPUTERNAME ^| Move-ClusterGroup -Verbose",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_MOVE_FC_GROUP_LOCAL"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell Move-ClusterGroup %SVC_FC_GROUP% $env:COMPUTERNAME -Verbose",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_CLEANUP_BACKUPS"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell if (Test-Path %DEPLOY_STAGING_DIR%) { Get-ChildItem %DEPLOY_STAGING_DIR% ^| Sort-Object Name ^| Select-Object -SkipLast 20 ^| Where-Object { ($_.Name -match '^^\d{8}\.\d{6}Z(\.Backup)?') } ^| Where-Object { ([DateTime]::ParseExact($_.Name.Substring(0,16), 'yyyyMMdd.HHmmssZ', $null) -lt [DateTime]::UtcNow.AddDays(-30)) } ^| Remove-Item -Recurse }",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_PUBLISH_TO_STAGING_DIR"><![CDATA[
ROBOCOPY %PUBLISH_PATH%\Deployment\%PUBLISH_ENVIRONMENT% %PUBLISH_PATH%
IF %ERRORLEVEL% GTR 8 EXIT /B %ERRORLEVEL%
%MSDEPLOY% -verb:sync -source:dirPath="%PUBLISH_PATH%" -dest:dirPath="%DEPLOY_STAGING_PATH%",%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_BACKUP_CURRENT_FILES"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="IF EXIST %SVC_PATH% ROBOCOPY %SVC_PATH% %DEPLOY_STAGING_PATH%.Backup /NFL /NDL /NP /NJH /NJS /E /XD Logs & IF %ERRORLEVEL% LEQ 8 EXIT /B 0",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_DEPLOY_RUNTIME_FILES"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="ROBOCOPY %DEPLOY_STAGING_PATH% %SVC_PATH% /NP /NJH /NJS /MIR /XD Logs Deployment & IF %ERRORLEVEL% LEQ 8 EXIT /B 0",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_DEPLOY_SERVICE">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell if ((Get-Service %SVC_NAME% -ErrorAction SilentlyContinue) -eq $null) { New-Service %SVC_NAME% 'dotnet' -Verbose }; Set-ItemProperty -Path HKLM:\System\CurrentControlSet\Services\%SVC_NAME% -Name ImagePath -Value '"""C:\Program Files\dotnet\dotnet.exe""" %SVC_PATH%\eServices.ApplicationEvent.EnrichmentService.dll --environment %PUBLISH_ENVIRONMENT% --Kafka:MessageEvents:Password %KAFKA_MESSAGEEVENTS_PASSWORD% --Kafka:ApplicationEvents:Password %KAFKA_APPLICATIONEVENTS_PASSWORD% --ConnectionStrings:eHubTransactions """%EHUBTRANSACTIONS_CONNECTIONSTRING%"""'; Set-Service %SVC_NAME% -DisplayName '%SVC_DISPNAME%';",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
IF %ERRORLEVEL% NEQ 0 EXIT /B %ERRORLEVEL%
]]></Add>
    <Add Name="CMD_CONFIGURE_STARTUP_AUTOMATIC"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell Set-Service %SVC_NAME% -StartupType Automatic -Verbose; Set-ItemProperty -Path HKLM:\System\CurrentControlSet\Services\%SVC_NAME% -Name FailureActions -Value ([Convert]::FromBase64String('gFEBAAAAAAAAAAAAAwAAABQAAAABAAAAYOoAAAEAAABg6gAAAQAAAGDqAAA=')); Start-Service %SVC_NAME% -Verbose",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
    <Add Name="CMD_CONFIGURE_STARTUP_MANUAL"><![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell Set-Service %SVC_NAME% -StartupType Manual -Verbose;",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]></Add>
  </Settings>
