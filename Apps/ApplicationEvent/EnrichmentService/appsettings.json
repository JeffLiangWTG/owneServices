{
  "Enrichers": {
    "eHub": {
      "Type": "eServices.ApplicationEvent.EnrichmentService.Enrichers.EHub"
    },
    "Air": {
      "Type": "eServices.ApplicationEvent.EnrichmentService.Enrichers.AirMessaging",
      "Includes": [ "eHub" ],
      "Criteria": [
        {
          "Parameters": [ "MessageEvent.Event.Type", "MessageEvent.Message.RecipientID" ],
          "Expression": "(p[0] is \"Processed\" or  \"Delivered\" or \"DeliveryFailed\") && Regex.IsMatch(p[1], \"^(ARINC_SP|BT|BT_WithUnsupported|Cargonaut|CargoStart|CCN|CCN_CMD|CCSJ|CCSJ_FHL|CCSJ_FWB|Delta|Descartes|Descartes_WithUnsupported|GLSHK|GLSHK_WithUnsupported|Nallian|PakFresh|Qatar|Tradevan|Traxon|Traxon_EDP|Traxon_RCF)$\", RegexOptions.Compiled)"
        },
        {
          "Parameters": [ "MessageEvent.Event.Type", "MessageEvent.Message.SenderID" ],
          "Expression": "(p[0] is \"Processed\" or \"Delivered\" or \"DeliveryFailed\") && Regex.IsMatch(p[1], \"^(ARINC_SP|BT|Cargonaut|CargoStart|CCN|CCSJ|Delta|Descartes|GLSHK|Nallian|PakFresh|Qatar|Tradevan|Traxon)$\", RegexOptions.Compiled)"
        }
      ],
      "AggregateMessageInformationFormat": "^(?<MessageType>.*?)_(?<MAWB>.*?)_(?<HAWB>.*?)_(?<Carrier>.*?)_(?<RecipientPIMA>.*)$"
    },
    "Ocean": {
      "Type": "eServices.ApplicationEvent.EnrichmentService.Enrichers.OceanMessaging",
      "Includes": [ "eHub" ],
      "Criteria": [
        {
          "Name": "Inbound",
          "Parameters": [ "MessageEvent.Event.Type", "MessageEvent.Message.SenderID", "MessageEvent.Message.RecipientID" ],
          "Expression": "(p[0] is \"Processed\" or \"Delivered\" or \"DeliveryFailed\") && Array.Exists(l[\"Providers\"], i => p[1] == i)"
        },
        {
          "Name": "Outbound",
          "Parameters": [ "MessageEvent.Event.Type", "MessageEvent.Message.RecipientID" ],
          "Expression": "(p[0] is \"Processed\" or \"Delivered\" or \"DeliveryFailed\") && Array.Exists(l[\"Providers\"], i => p[1].Length > i.Length && p[1].StartsWith(i) && p[1][i.Length] is '_')"
        },
        {
          "Name": "OutboundError",
          "Parameters": [ "MessageEvent.Event.Type", "MessageEvent.Message.RecipientID" ],
          "Expression": "(p[0] is \"DeliveryFailed\") && (p[1] is \"SHIPPING_INSTRUCTION\")"
        },
        {
          "Name": "DeliveryNotification",
          "Parameters": [ "MessageEvent.Event.Type", "MessageEvent.Message.SenderID" ],
          "Expression": "(p[0] is \"Processed\" or \"Delivered\" or \"DeliveryFailed\") && (p[1] is \"SHIPPING_INSTRUCTION\")"
        }
      ],
      "Lookups": {
        "Providers": [
          "CARGOSMART",
          "CARGOWISE",
          "CargoWorldNetwork",
          "CAROTRANS",
          "CARRIER_EMAIL",
          "CHARTERLINK",
          "CMACGM",
          "CMLOG",
          "CROWLEY",
          "CWTG",
          "EASIPASS",
          "ECULINE",
          "EMIRATESLINE",
          "EVERGREEN",
          "EVERRICH",
          "FAMOUS",
          "GREATASIA",
          "GTNEXUS",
          "HAPAG_LLOYD",
          "HYUNDAI",
          "ICARGOALLIANCE",
          "ICL",
          "INTTRA",
          "KMTC",
          "MAERSK",
          "MARFRET",
          "MSC",
          "NGBEDI",
          "ODYSSEY",
          "ONE",
          "PENAVICO",
          "PIL",
          "PORTRIX",
          "SINOLINE",
          "SINOTRANS",
          "SINOTRANS_EASTERN",
          "SINOTRANS_MINGZHOU",
          "SMLINE",
          "SOUTHEAST",
          "SWIRE",
          "TRANSOCEAN",
          "TSLINE",
          "TURKON",
          "UNIWILL",
          "VANGUARD",
          "WANHAI",
          "WECC",
          "WORLDEX",
          "WWA",
          "YANGMING",
          "ZIM"
        ]
      }
    }
  },
  "Kafka": {
    "MessageEvents": {
      "Brokers": [ "localhost:9092" ],
      "Topic": "message-events-dev",
      "GroupId": "enrichmentservice-dev",
      "AdminTopic": "message-events-dev-admin1",
      "BufferSize": 10,
      "WorkersCount": 1,
      "RetryIntervalSeconds": 5
    },
    "ApplicationEvents": {
      "Brokers": [ "localhost:9092" ],
      "Topic": "application-events-dev"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "RollingFile": {
      "File": "Logs\\eServices.ApplicationEvent.EnrichmentService.log",
      "MaxFileSize": "10MB",
      "MaxFileCount": "10"
    }
  },
  "Metrics": {
    "HealthCheckCountersEnabled": true,
    "ExportToConsole": false,
    "LagErrorThreshold": 1000000
  },
  "ConnectionStrings": {
    "eHubTransactions": "Data Source=localhost;Initial Catalog=eHubTransactions;Integrated Security=True;Encrypt=False;"
  },
  "DbConnectionMaxRetries": 30,
  "CacheSizeLimit": 2000000000,
  "CacheExpirationDefaultMinutes": 30,
  "Urls": "http://localhost:5101",
  "AllowedHosts": "localhost",
  "IssueManagerUri": ""
}
