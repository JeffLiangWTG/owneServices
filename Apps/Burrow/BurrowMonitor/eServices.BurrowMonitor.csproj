<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('eServices.BuildTools.props','$(MSBuildProjectDirectory)..\'))" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Copyright>© WiseTech Global</Copyright>
    <BaseOutputPath>..\Bin\Build\$(MSBuildProjectName)</BaseOutputPath>
    <EnvironmentName Condition="'$(EnvironmentName)' == ''">$(BuildToolsEnvironment)</EnvironmentName>
    <PublishDir>..\Bin\Publish\$(MSBuildProjectName)</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Deployment\**\*" />
    <None Include="Deployment\**\*" />
    <EnvironmentFiles Include="Deployment\$(BuildToolsEnvironment)\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EnvironmentFiles>
    <Content Remove="@(EnvironmentFiles->Metadata('Link'))" />
    <Content Include="@(EnvironmentFiles)" />
  </ItemGroup>
</Project>
