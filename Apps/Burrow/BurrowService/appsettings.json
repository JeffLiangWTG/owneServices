{
	"ProcRoll": {
		"Processes": {
			"Zookeeper": {
				"Filename": "Zookeeper\\bin\\zkServer.cmd",
				"StartMode": "Background",
				"StopMethod": "CtrlC",
				"UseShellExecute": true,
				"StartedStringMatch": "Created server"
			},
			"Burrow": {
				"Filename": "Burrow\\bin\\Burrow.exe",
				"Arguments": "--config-dir=Burrow\\config",
				"StartMode": "Hosted",
				"UseShellExecute": true,
				"DependsOn": [ "Zookeeper" ]
			}
		}
	},
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console",
			"Serilog.Sinks.EventLog",
			"Serilog.Sinks.File",
			"Serilog.Enrichers.Environment",
			"Serilog.Enrichers.Thread",
			"Serilog.Expressions"
		],
		"Enrich": [ "WithMachineName", "WithThreadId" ],
		"WriteTo:BurrowService": {
			"Name": "Conditional",
			"Args": {
				"expression": "not StartsWith(SourceContext, 'ProcRoll.')",
				"configureSink": [
					{
						"Name": "File",
						"Args": {
							"path": "Logs\\BurrowService.log",
							"outputTemplate": "{Timestamp:o} [{MachineName}] ({ThreadId:D5}) [{Level:u3}] {SourceContext} {Message}{NewLine}{Exception}",
							"rollOnFileSizeLimit": true,
							"fileSizeLimitBytes": 10000000,
							"retainedFileCountLimit": 10
						}
					},
					{
						"Name": "EventLog",
						"Args": {
							"source": "Burrow",
							"restrictedToMinimumLevel": "Warning"
						}
					}
				]
			}
		},
		"WriteTo:Burrow": {
			"Name": "Conditional",
			"Args": {
				"expression": "SourceContext = 'ProcRoll.Burrow'",
				"configureSink": [
					{
						"Name": "File",
						"Args": {
							"path": "Logs\\Burrow.log",
							"outputTemplate": "{Timestamp:o} [{MachineName}] {Message:l}{NewLine}{Exception}",
							"rollOnFileSizeLimit": true,
							"fileSizeLimitBytes": 10000000,
							"retainedFileCountLimit": 10
						}
					}
				]
			}
		},
		"WriteTo:Zookeeper": {
			"Name": "Conditional",
			"Args": {
				"expression": "SourceContext = 'ProcRoll.Zookeeper'",
				"configureSink": [
					{
						"Name": "File",
						"Args": {
							"path": "Logs\\Zookeeper.log",
							"outputTemplate": "{Timestamp:o} [{MachineName}] {Message:l}{NewLine}{Exception}",
							"rollOnFileSizeLimit": true,
							"fileSizeLimitBytes": 10000000,
							"retainedFileCountLimit": 10
						}
					}
				]
			}
		}
	}
}
