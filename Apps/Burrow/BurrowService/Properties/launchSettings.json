{
  "profiles": {
    "BurrowService": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "workingDirectory": "$(OutDir)",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "Serilog__MinimumLevel": "Verbose",
        "Serilog__WriteTo__Console__Name": "Console"
      }
    }
  }
}