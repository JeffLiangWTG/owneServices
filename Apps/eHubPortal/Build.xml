  </Solutions>
  <PreBuild>
    <Command>cmd /c dotnet tool restore</Command>
  </PreBuild>
  <Tasks>
    <Task Name="Initialize eServices.BuildTools.DatTool">
      <Step>dotnet esv-dattool init --output Bin\DatTool</Step>
    </Task>
    <Task Name="Publish eServices.eHubPortal">
      <Dependency Type="Solution">eServices.eHubPortal.sln</Dependency>
      <Step>dotnet publish eHubPortal\eServices.eHubPortal.csproj --no-build</Step>
    </Task>
  </Tasks>
  <BuildConfigurations>
    <Configuration BuildOnDat="true" TestOnDat="true" Publishable="false" GenerateMSBuildBinLogs="true">Release</Configuration>
  </BuildConfigurations>
  <DatSettings IntegrationAssembliesSubdir="DatTool\net48" BuildDeployerType="eServices.BuildTools.DatDeploy.Deployer, eServices.BuildTools.DatDeploy" DisableWorkspaceJobs="true">
    <TestAdapter Type="Dat.Implementation.VSTest.VSTestAdapter, Dat.Implementation.VSTest">
      <Options>
        <Option Name="TestAssemblyFileFilter">*Tests.dll</Option>
      </Options>
    </TestAdapter>
    <DeploymentTargets>
      <DeploymentTarget Type="DeployOnDemand" BuildConfiguration="Release" DeploymentConfiguration="eServices.eHubPortal_STG_au2sp-shub-401" IsProduction="false" />
      <DeploymentTarget Type="DeployOnDemand" BuildConfiguration="Release" DeploymentConfiguration="eServices.eHubPortal_PRD_au2co-siis-401b" />
    </DeploymentTargets>
  </DatSettings>
</Build>