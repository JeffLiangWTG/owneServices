<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <BaseOutputPath>..\Bin\HealthCheckService</BaseOutputPath>
    <SignAssembly>True</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\AccountingAppProfile.pubxml" />
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\InternationAppProfile.pubxml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.8.0" />
    <PackageReference Include="NEST.JsonNetSerializer" Version="7.17.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.1" />
    <PackageReference Include="XH.Framework.GrpcClient" Version="6.2.6" />
    <PackageReference Include="CargoWise.eServices.Encryption.Common" Version="1.0.1" />
    <PackageReference Include="CargoWise.eServices.Encryption.Server.Decryptor" Version="2.0.1" />
    <PackageReference Include="XH.Framework.Logging" Version="2.11.0" />
    <PackageReference Include="XH.Framework.XT.REST.API.Common" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="XH.XT.ArchiveService.Common">
      <HintPath>..\Bin\XH.XT.ArchiveService.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
    <InternalsVisibleTo Include="XH.XT.Monitoring.HealthCheckService.IntegrationTests, " />
  </ItemGroup>

  <PropertyGroup>
    <PackageProjectPath>..\Bin\Deployment\WebServiceDotNetCore\Package.proj</PackageProjectPath>
    <DeploymentProjectPath>..\Bin\Deployment\WebService\Deploy.proj</DeploymentProjectPath>
  </PropertyGroup>
  <Import Project="$(PackageProjectPath)" Condition="Exists('$(PackageProjectPath)')" />
  <Import Project="$(DeploymentProjectPath)" Condition="Exists('$(DeploymentProjectPath)')" />
</Project>