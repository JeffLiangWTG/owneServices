{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GrpcConfigurationPath": "gRPC.config",
  "Options": {
    "/wtg/status": [
      "ServiceHealthCheck"
    ],
    "/grpc/wtg/status": [
      "gRPCHealthCheck"
    ],
    "/TrackingMessage/wtg/status": [
      "TrackingMessageHealthCheck"
    ]
  },
  "HealthCheckSettings": {
    "SkipCheck": false
  },
  "HttpClient": {
    "TimeoutInSeconds": 100
  }
}