<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <Authors>WiseTech Global</Authors>
    <Company>WiseTech Global</Company>
    <Copyright>Copyright © 2020-2025 WiseTech Global</Copyright>
  </PropertyGroup>

  <!-- Code analyzers -->
  <PropertyGroup>
    <CodeAnalysisEnabled Condition="$(Configuration) == 'DEBUG'">True</CodeAnalysisEnabled>
    <_SkipUpgradeNetAnalyzersNuGetWarning>true</_SkipUpgradeNetAnalyzersNuGetWarning>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectFile.Contains('Test'))">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)TestConfig\.globalconfig" />
  </ItemGroup>
  <ItemGroup Condition="'$(CodeAnalysisEnabled)' == 'true'">
    <PackageReference Include="WTG.BuildConfiguration.All" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WTG.BuildConfiguration.Signing" Version="3.1.0" />
  </ItemGroup>
</Project>