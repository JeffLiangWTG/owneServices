<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <BaseOutputPath>..\Bin\HealthCheckService.IntegrationTests\</BaseOutputPath>
    <LangVersion>11.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.IntegrationTest.json" />
    <None Remove="HealthCheckSettings.json" />
    <None Remove="InvalidWebServers.json" />
    <None Remove="xTHealthCheck\TestFiles\ClickToMonitor\CTMObjects.json" />
    <None Remove="xTHealthCheck\TestFiles\ClickToMonitor\ProblemDetail.json" />
    <None Remove="xTHealthCheck\TestFiles\ClickToMonitor\XTFolderList.json" />
    <None Remove="xTHealthCheck\TestFiles\SearchRequestSender1.json" />
    <None Remove="xTHealthCheck\TestFiles\SearchRequestSender2.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.IntegrationTest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="HealthCheckSettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="xTHealthCheck\TestFiles\ClickToMonitor\CTMObjects.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\ClickToMonitor\ProblemDetail.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\ClickToMonitor\XTFolderList.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\ClickToMonitor\XTSubFolderList.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\Customs\MailServers.InvalidHost.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\Customs\MailServers.InvalidName.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\TrackingMessage\SearchRequestSender2.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\TrackingMessage\SearchRequestSender1.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\TrackingMessage\InvalidTrackingMessages.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\Customs\WebServers.InvalidUrl.json" />
    <EmbeddedResource Include="xTHealthCheck\TestFiles\Customs\MailServers.InvalidPort.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="6.0.18" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="NUnit" Version="3.13.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HealthCheckService\XH.XT.Monitoring.HealthCheckService.csproj" />
  </ItemGroup>

</Project>