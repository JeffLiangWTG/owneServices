  <!-- Common Settings
         Default settings that are available in deployments are:
            DAT_DEPLOYMENT_CONFIGURATION  - Value of DeploymentConfiguration in Build.xml.
            DAT_DEPLOYMENT_NAME           - DeploymentConfiguration with special characters removed.
            DAT_SOURCE_PATH               - Path to root of repo source files.
            DAT_BIN_PATH                  - Path to Bin folder.
            TIMESTAMP                     - UTC time at start of build. Format is "yyyyMMdd.HHmmssZ".-->
  <Settings>
    <Add Name="PROFILE_PATH" Value="%DAT_SOURCE_PATH%\Gateway\Deployment\Profiles\%PROFILE%" />
    <Add Name="PUBLISH_PATH" Value="%DAT_BIN_PATH%\Publish\CargoWise.eHub.Gateway" />
    <Add Name="XDT_PATH" Value="C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\VisualStudio\v17.0\Web\Microsoft.Web.XmlTransform.dll" />
    <Add Name="CMD_TRANSFORM_WEB_CONFIG"><![CDATA[powershell "Add-Type -Path '%XDT_PATH%'; $doc = New-Object 'Microsoft.Web.XmlTransform.XmlTransformableDocument'; $doc.PreserveWhitespace = $true; $doc.Load('%PUBLISH_PATH%\web.config'); $transf = New-Object Microsoft.Web.XmlTransform.XmlTransformation('%PROFILE_PATH%\web.config'); if ($transf.Apply($doc) -eq $false) { throw "Transformation failed." }; $doc.Save('%PUBLISH_PATH%\web.config');" ]]></Add>
    <Add Name="CMD_TRANSFORM_LOG4NET_CONFIG"><![CDATA[powershell "Add-Type -Path '%XDT_PATH%'; $doc = New-Object 'Microsoft.Web.XmlTransform.XmlTransformableDocument'; $doc.PreserveWhitespace = $true; $doc.Load('%PUBLISH_PATH%\CargoWise.eHub.Gateway.Host.log4net.config'); $transf = New-Object Microsoft.Web.XmlTransform.XmlTransformation('%PROFILE_PATH%\CargoWise.eHub.Gateway.Host.log4net.config'); if ($transf.Apply($doc) -eq $false) { throw "Transformation failed." }; $doc.Save('%PUBLISH_PATH%\CargoWise.eHub.Gateway.Host.log4net.config');" ]]></Add>
    <Add Name="CMD_UPDATE_WEB_CONFIG"><![CDATA[powershell "(Get-Content -Path '%PUBLISH_PATH%\web.config' -Raw).Replace('$eHubTransactionsPassword$','%EHUBTRANSACTIONSPASSWORD%').Replace('$GatewayKafkaSaslPassword$','%GATEWAYKAFKASASLPASSWORD%').Replace('$BillingKafkaPassword$','%BILLINGKAFKAPASSWORD%') | Set-Content -Path '%PUBLISH_PATH%\web.config'" ]]></Add>
    <Add Name="MSDEPLOY" Value="&quot;%ProgramFiles%\IIS\Microsoft Web Deploy V3\msdeploy.exe&quot; -allowUntrusted -verbose" />
    <Add Name="MSDEPLOY_CONN"><![CDATA[wmsvc="https://%SERVER%:8172/msdeploy.axd?Site=%SITENAME%",username=%DEPLOY_USR%,password="%DEPLOY_PWD%"]]></Add>
    <Add Name="CMD_APP_STOP"><![CDATA[%MSDEPLOY% -verb:sync -source:recycleApp -dest:recycleApp="%SITENAME%/eHubGateway",%MSDEPLOY_CONN%,recycleMode="StopAppPool"]]></Add>
    <Add Name="CMD_APP_START"><![CDATA[%MSDEPLOY% -verb:sync -source:recycleApp -dest:recycleApp="%SITENAME%/eHubGateway",%MSDEPLOY_CONN%,recycleMode="StartAppPool"]]></Add>
    <Add Name="CMD_DEPLOY_SITE">%MSDEPLOY% -verb:sync -source:iisApp="%PUBLISH_PATH%" -dest:iisApp="%SITENAME%/eHubGateway",%MSDEPLOY_CONN% -enableRule:EncryptWebConfig -skip:objectName=dirPath,absolutePath='logs' -skip:objectName=filePath,absolutePath='app_offline.htm'</Add>
    <Add Name="CMD_ENCRYPT_CONFIG">%MSDEPLOY% -verb:sync -source:runcommand='C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe -pe sensitiveAppSettings -site "%SITENAME%" -app /eHubGateway -prov RsaProtectedConfigurationProvider' -dest:auto,%MSDEPLOY_CONN%</Add>
  </Settings>
