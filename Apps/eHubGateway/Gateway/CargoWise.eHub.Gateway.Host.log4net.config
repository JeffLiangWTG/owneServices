<?xml version="1.0" encoding="utf-8"?>
<log4net>

  <appender name="Error" type="log4net.Appender.RollingFileAppender">
    <file value="logs/error.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="100" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <filter type="log4net.Filter.StringMatchFilter">
      <StringToMatch value="Application Code SCV" />
      <AcceptOnMatch value="false" />
    </filter>
    <filter type="log4net.Filter.StringMatchFilter">
      <StringToMatch value="Processing billing message" />
      <AcceptOnMatch value="false" />
    </filter>
    <threshold value="ERROR" />
  </appender>

  <appender name="BillingMessageHandler" type="log4net.Appender.RollingFileAppender">
    <file value="logs/BillingMessageHandler.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="100" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.BillingMessageHandler" />
    </filter>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.BillingClient" />
    </filter>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.BillingMessageHandlerV1" />
    </filter>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.BillingMessageHandlerV2" />
    </filter>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.BillingMessageHandlerV3" />
    </filter>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.BillingMessageHandlerV4" />
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
    <threshold value="TRACE" />
  </appender>

  <appender name="Login" type="log4net.Appender.RollingFileAppender">
    <file value="logs/login.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="100" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.eHubUserNamePasswordValidator" />
    </filter>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.DataAccess.Sql.SecurityAccessor" />
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
    <threshold value="WARN" />
  </appender>

  <appender name="RoutingRuleService" type="log4net.Appender.RollingFileAppender">
    <file value="logs/RoutingRuleService.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="20" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level - %message%newline" />
    </layout>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <loggerToMatch value="CargoWise.eHub.Gateway.Routing.RoutingRuleService" />
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
    <threshold value="INFO" />
  </appender>

  <logger name="TransactionLog" additivity="False">
    <level value="INFO" />
    <appender-ref ref="TransactionLogAppender"/>
  </logger>

  <appender name="TransactionLogAppender" type="log4net.Appender.RollingFileAppender">
    <file value="logs/Transaction.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%utcdate{yyyy-MM-dd HH:mm:ss} %P{log4net:HostName} %message%newline" />
    </layout>
  </appender>

  <appender name="eHubStreamedService" type="log4net.Appender.RollingFileAppender">
    <file value="logs/eHubStreamedService.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%-5level] %message%newline" />
    </layout>
    <filter type="log4net.Filter.StringMatchFilter">
      <StringToMatch value="orwarding the messages to the test gateway" />
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
  </appender>

  <logger name="UsageMessageHandler" additivity="False">
    <level value="DEBUG" />
    <appender-ref ref="UsageMessageHandlerAppender"/>
    <appender-ref ref="KafkaAppender" />
  </logger>

  <appender name="UsageMessageHandlerAppender" type="log4net.Appender.RollingFileAppender">
    <file value="logs/UsageMessageHandler.log" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="20" />
    <maximumFileSize value="10MB" />
  </appender>

  <logger name="KafkaLog" additivity="False">
    <level value="INFO" />
    <appender-ref ref="EventLogAppender"/>
  </logger>

  <appender name="EventLogAppender" type="log4net.Appender.EventLogAppender">
    <applicationName value="CargoWise.eHub.Gateway.KafkaAppender" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
  </appender>

  <appender name="KafkaAppender" type="CargoWise.eHub.Gateway.KafkaAppender">
    <KafkaOptions>
      <brokers value="106-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,107-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,108-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,109-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,110-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044" />
      <topic value="topic-au1-test-ehubgw-logs-test" />
      <SaslUsername value="topic-au1-test-ehubgw-logs-test" />
      <SecurityProtocol value="3"/>
      <SaslMechanism value="1"/>
      <acks value="0" />
    </KafkaOptions>
    <threshold value="INFO" />
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="KafkaAppender" />
    <appender-ref ref="Login" />
    <appender-ref ref="Error" />
    <appender-ref ref="BillingMessageHandler" />
    <appender-ref ref="RoutingRuleService" />
    <appender-ref ref="eHubStreamedService" />
  </root>

</log4net>

