      IncludeBinFilesForWebPublish;
      $(CopyAllFilesToSingleFolderForPackageDependsOn);
    </CopyAllFilesToSingleFolderForPackageDependsOn>
    <CopyAllFilesToSingleFolderForMsdeployDependsOn>
      IncludeBinFilesForWebPublish;
      $(CopyAllFilesToSingleFolderForMsdeployDependsOn);
    </CopyAllFilesToSingleFolderForMsdeployDependsOn>
  </PropertyGroup>
  <Target Name="IncludeBinFilesForWebPublish">
    <ItemGroup>
      <_KafkaFiles Include="$(OutDir)librdkafka\**\*" />
      <FilesForPackagingFromProject Include="@(_KafkaFiles)">
        <DestinationRelativePath>bin\librdkafka\%(RecursiveDir)%(Filename)%(Extension)</DestinationRelativePath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </FilesForPackagingFromProject>
    </ItemGroup>
  </Target>
</Project>