<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<sensitiveAppSettings>
		<add key="GatewayKafkaSaslPassword" value="$GatewayKafkaSaslPassword$"
			xdt:Transform="SetAttributes(value)"
			xdt:Locator="Match(key)"/>
	</sensitiveAppSettings>
  <billingKafkaClientSettings>
    <add key="bootstrap.servers" value="106-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,107-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,108-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,109-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,110-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="sasl.username" value="topic-au2-prod-billing-prod"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="sasl.password" value="$BillingKafkaPassword$"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
  </billingKafkaClientSettings>
  <billingKafkaProducerSettings>
    <add key="linger.ms" value="50"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="message.timeout.ms" value="30000"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
  </billingKafkaProducerSettings>
	<appSettings>
		<add key="MessageLoggingFolder" xdt:Transform="Remove" xdt:Locator="Match(key)" />
		<add key="SpecialTreatmentServerAddress" xdt:Transform="Remove" xdt:Locator="Match(key)" />
		<add key="CargoWise.eServices.Authentication.ServiceClient.Endpoint" value="https://aws.wisecloud.zone/authentication/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BillingKafkaTopic" value="topic-au2-prod-billing-prod"
			 xdt:Transform="SetAttributes(value)"
			 xdt:Locator="Match(key)"/>
		<add key="BillingUsageKafkaTopic" value="topic-au2-prod-ehubgatewaynonbilledusage-prod"
			 xdt:Transform="SetAttributes(value)"
			 xdt:Locator="Match(key)"/>
		<add key="SendBillingToKafka" value="true"
			 xdt:Transform="SetAttributes(value)"
			 xdt:Locator="Match(key)"/>
		<add key="KafkaMessageTimeoutInSeconds" value="30"
				 xdt:Transform="SetAttributes(value)"
				 xdt:Locator="Match(key)"/>
		<add key="IssueManagerUri" value="https://errors.cargowise.net/"
			 xdt:Transform="Replace"
				 xdt:Locator="Match(key)"/>
		<add key="ShouldForwardToProxyGateway" value="True" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="XHGatewayUrl" value="http://xHub-eservices.wisegrid.net/xHGateway.Core/"
		 xdt:Transform="SetAttributes(value)"
		 xdt:Locator="Match(key)"/>
		<add key="USCustomsLicenceOverrideToProd" value="T_____USC,USC_SHCK_REPO"
			 xdt:Transform="Replace"
			 xdt:Locator="Match(key)" />
	</appSettings>
	<connectionStrings>
		<add name="CargoWise.eHub.DataAccess.Sql.eHubTransactions" connectionString="Data Source=ehubtransactions.db.wisegrid.net;App=eHub Gateway;Initial Catalog=eHubTransactions;User Id=eHubGateway;Password=$eHubTransactionsPassword$" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
		<add name="CargoWise.eHub.DataAccess.ediProdCache" connectionString="Data Source=ediprodcache.db.wisegrid.net;App=eHub Gateway;Initial Catalog=ediProdCache;User Id=eHubGateway;Password=$eHubTransactionsPassword$" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
		<add name="eHubTransactionsContext" connectionString="Data Source=ehubtransactions.db.wisegrid.net;App=eHub Gateway;Initial Catalog=eHubTransactions;User Id=eHubGateway;Password=$eHubTransactionsPassword$" providerName="System.Data.SqlClient" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
	</connectionStrings>
	<system.net>
		<mailSettings xdt:Transform="Remove"/>
		<mailSettings xdt:Transform="Insert">
			<smtp deliveryMethod="Network">
				<network host="mail.wtg.zone" userName="noreply@wtg.zone" password="M@1lN0R3ply"/>
			</smtp>
		</mailSettings>
	</system.net>
	<system.serviceModel>
		<bindings>
			<customBinding>
				<binding name="HttpStreamingService" xdt:Locator="Match(name)">
					<httpsTransport  xdt:Transform="Remove" />
					<httpTransport maxBufferPoolSize="1048576" maxBufferSize="1048576" maxReceivedMessageSize="104857600" transferMode="Streamed" xdt:Transform="Insert" />
				</binding>
			</customBinding>
		</bindings>
		<extensions>
			<behaviorExtensions>
				<add name="errorHandling" type="CargoWise.eHub.Gateway.eHubErrorHandler, CargoWise.eHub.Gateway" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
			</behaviorExtensions>
		</extensions>
		<client>
			<endpoint address="net.tcp://biztalk.wisecloud.zone:11809/eHub2Gateway/eHub2Gateway.svc" name="eHub2GatewayService" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
			<endpoint address="https://billing.wtg.zone/BillingService.svc" name="billing_service" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
			<endpoint address="https://sydwp-sxtr-2.wisecloud.zone/XHubGateway/XHubGateway.svc/SOAP" name="SOAP" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
		</client>
		<behaviors>
			<serviceBehaviors>
				<behavior name="CargoWise.eHub.Gateway.eHubStreamedServiceBehavior" xdt:Locator="Match(name)">
					<serviceCredentials>
						<userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="CargoWise.eHub.Gateway.IntegrationUserNamePasswordValidator, CargoWise.eHub.Gateway, PublicKeyToken=4f570df270576350" xdt:Transform="Replace" />
					</serviceCredentials>
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
	<system.webServer>
		<rewrite xdt:Transform="Insert">
			<rules>
				<rule name="Forward Heartbeat to HealthCheck">
					<match url="^$" />
					<action type="Rewrite" url="eHubGateway/wtg/status" />
				</rule>
				<rule name="Rewrite to wsdl.aspx">
					<match url="eHubStreamedService.svc" />
					<conditions>
						<add input="{QUERY_STRING}" pattern="(wsdl|xsd|disco)" ignoreCase="true" />
						<add input="{HTTP_x_request_original}" pattern="^true$" negate="true" />
						<add input="{REQUEST_METHOD}" pattern="^GET$" ignoreCase="true" />
					</conditions>
					<action type="Rewrite" url="wsdl.aspx" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
	<system.diagnostics xdt:Transform="Remove" />
</configuration>