<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
  <PropertyGroup>
    <Company>WiseTech Global Pty Ltd</Company>
    <Product>eHubAdmin</Product>
    <Copyright>© Copyright WiseTech Global</Copyright>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <AssemblyFileVersion>3.0.0.0</AssemblyFileVersion>
    <DeploymentProjectsPath>$(MsBuildThisFileDirectory)Bin\Deployment</DeploymentProjectsPath>
    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MsBuildThisFileDirectory)EDI-Release-private.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
