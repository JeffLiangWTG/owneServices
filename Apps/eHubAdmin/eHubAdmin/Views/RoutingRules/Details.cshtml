@model eServices.Shared.RoutingRuleEngine.Rule

@{
    ViewBag.Title = Model.ServiceName;
}

<h2>@ViewBag.Title</h2>

<div>
    <h4>Service</h4>
    <hr />

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" href="#Rules">Rules</a>
            </h4>
        </div>
        <div id="Rules" class="panel-collapse collapse in">
            <div class="panel-body">
                @(Html.Partial("~/Views/RoutingRules/_RuleDetails.cshtml", Model))
            </div>
        </div>
    </div>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" href="#Facts">Facts</a>
            </h4>
        </div>
        <div id="Facts" class="panel-collapse collapse in">
            <div class="panel-body">
                @Html.Partial("~/Views/RoutingRules/_Facts.cshtml", Model.Facts)
            </div>
        </div>
    </div>

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" href="#ServiceProviders">Service Providers</a>
            </h4>
        </div>
        <div id="ServiceProviders" class="panel-collapse collapse in">
            <div class="panel-body">
                @Html.Partial("~/Views/RoutingRules/_ServiceProviders.cshtml", Model.ServiceProviders)
            </div>
        </div>
    </div>

</div>
<p>
    @Html.ActionLink("Back to List", "Index")
</p>
