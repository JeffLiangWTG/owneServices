@model eServices.Shared.RoutingRuleEngine.ServiceProviderCollection

<table class="table table-responsive">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Rule</th>
    </tr>

    @foreach (var item in Model.OrderBy(m => m.ProviderClient.CC_ID))
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProviderClient.CC_ID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProviderClient.CC_FriendlyName)
            </td>
            <td class="col-md-9">
                @if (item.RoutingRule != null)
                {
                    @(Html.Partial("~/Views/RoutingRules/_RuleDetails.cshtml", item.RoutingRule))
                }
            </td>
        </tr>
    }

</table>
