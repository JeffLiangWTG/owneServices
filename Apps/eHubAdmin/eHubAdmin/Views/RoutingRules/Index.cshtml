@model IEnumerable<eServices.eHubDataModel.eHubTransactions.eHubClient>

@{
    ViewBag.Title = Constants.ContollerDisplayName["RoutingRules"];
}

<h2>@ViewBag.Title</h2>

<table class="table">
    <tr>
        <th class="col-sm-4">Name</th>
        <th class="col-sm-6">eHub Client ID</th>
        <th class="col-sm-2"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CC_FriendlyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CC_ID)
            </td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.CC_ID })
            </td>
        </tr>
    }
</table>
