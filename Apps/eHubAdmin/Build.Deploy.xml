<?xml version="1.0" encoding="utf-8"?>
<DatDeploy xmlns="http://eservices.buildtools/datdeploy">
	<Targets>
		<Target Name="STAGING">
			<Steps>
				<Step Command="%DECRYPT_DB_PWD_IN_WEB_CONFIG%" />
				<Step Command="%DEPLOY_STAGING%" />
			</Steps>
		</Target>
		<Target Name="PRODUCTION">
			<Steps>
				<Step Command="%DECRYPT_DB_PWD_IN_WEB_CONFIG%" />
				<Step Command="%DEPLOY_PRODUCTION%" />
			</Steps>
		</Target>
	</Targets>
	<Settings>
		<Add Name="MSDEPLOY" Value="&quot;C:\Program Files\IIS\Microsoft Web Deploy V3\msdeploy.exe&quot; -allowUntrusted -enableRule:AppOffline -enableRule:EncryptWebConfig -source:iisApp=&quot;%DAT_BIN_PATH%\eHubAdmin\%DAT_DEPLOYMENT_CONFIGURATION%&quot; -verbose -verb:sync" />
		<Add Name="DECRYPT_DB_PWD_IN_WEB_CONFIG" Value="powershell &quot;(Get-Content '%DAT_BIN_PATH%\eHubAdmin\%DAT_DEPLOYMENT_CONFIGURATION%\Web.config') -replace '\$DBPassword\$', '$(Secrets:DB_PWD)' | Set-Content '%DAT_BIN_PATH%\eHubAdmin\%DAT_DEPLOYMENT_CONFIGURATION%\Web.config'&quot;" />
		<Add Name="DEPLOY_STAGING" Value="%MSDEPLOY% -dest:iisApp=&quot;ehubadmin-test.wtg.zone&quot;,wmsvc=&quot;au2sp-shub-401.sand.wtg.zone&quot;,userName=&quot;s_eServicesDeploy@wtg.zone&quot;,password=&quot;$(Secrets:ESERVICES_DEPLOY_PWD)&quot;" />
