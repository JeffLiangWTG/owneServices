### Microsoft VisualStudio Threading Analyzers
dotnet_diagnostic.VSTHRD111.severity = none

### WTG Analyzers
# DoNotUseThePrivateKeyword
dotnet_diagnostic.WTG1001.severity = error
# UseVarWherePossible
dotnet_diagnostic.WTG1002.severity = silent
# DoNotLeaveWhitespaceOnTheEndOfTheLine
dotnet_diagnostic.WTG1003.severity = suggestion
# IndentWithTabsRatherThanSpaces
dotnet_diagnostic.WTG1004.severity = error
# UseConsistentLineEndings
dotnet_diagnostic.WTG1005.severity = suggestion
# DoNotUseTheInternalKeywordForTopLevelTypes
dotnet_diagnostic.WTG1006.severity = silent
# DoNotCompareBoolToAConstantValue
dotnet_diagnostic.WTG1007.severity = error
# DoNotCompareBoolToAConstantValueInAnExpression
dotnet_diagnostic.WTG1008.severity = error
# UsingDirectivesMustBeOrderedByKind
dotnet_diagnostic.WTG1009.severity = suggestion
# UseOutVarWherePossible
dotnet_diagnostic.WTG1010.severity = silent
# DeconstructWithSingleVar
dotnet_diagnostic.WTG1011.severity = suggestion
# DeconstructWithVar
dotnet_diagnostic.WTG1012.severity = silent
# AvoidTupleTypesInPublicInterfaces
dotnet_diagnostic.WTG1013.severity = suggestion
# DontNestConditionalOperators
dotnet_diagnostic.WTG1014.severity = suggestion
# ConditionalOperatorsShouldNotHaveMultilineValues
dotnet_diagnostic.WTG1015.severity = suggestion
# AvoidDiscardCoalesceThrow
dotnet_diagnostic.WTG1016.severity = suggestion
# VariableCouldBeConfusedWithDiscard
dotnet_diagnostic.WTG1017.severity = suggestion
# UseNamedArgumentsWhenPassingBooleanLiterals
dotnet_diagnostic.WTG1018.severity = suggestion
# DoNotConfigureAwaitFromAsyncVoid
dotnet_diagnostic.WTG2001.severity = error
# AvoidConditionalCompilationBasedOnDebug
dotnet_diagnostic.WTG2002.severity = suggestion
# FlagEnumsShouldSpecifyExplicitValues
dotnet_diagnostic.WTG2003.severity = suggestion
# DoNotUseCodeContracts
dotnet_diagnostic.WTG2004.severity = suggestion
# UseCorrectEmitOverload
dotnet_diagnostic.WTG2005.severity = warning
# ForbidCompiledInStaticRegexMethods
dotnet_diagnostic.WTG2006.severity = error
# ForbidCustomHttpReasonPhraseValues
dotnet_diagnostic.WTG2007.severity = error
# DoNotUsePathSeparatorsInPathLiterals
dotnet_diagnostic.WTG2008.severity = suggestion
# ForbidMSBuildLocatorRegisterDefaults
dotnet_diagnostic.WTG2009.severity = suggestion
# RemovedOrphanedSuppressions
dotnet_diagnostic.WTG3001.severity = suggestion
# PreferDirectMemberAccessOverLinq
dotnet_diagnostic.WTG3002.severity = suggestion
# PreferDirectMemberAccessOverLinqInAnExpression
dotnet_diagnostic.WTG3003.severity = suggestion
# PreferArrayEmptyOverNewArrayConstruction
dotnet_diagnostic.WTG3004.severity = warning
# DontCallToStringOnAString
dotnet_diagnostic.WTG3005.severity = error
# PreferNameofOverCallingToStringOnAnEnum
dotnet_diagnostic.WTG3006.severity = warning
# RemovePointlessOverrides
dotnet_diagnostic.WTG3007.severity = suggestion
# DontEquateValueTypesWithNull
dotnet_diagnostic.WTG3008.severity = suggestion
# PreferCompletedTask
dotnet_diagnostic.WTG3009.severity = suggestion
# DontAwaitTriviallyCompletedTasks
dotnet_diagnostic.WTG3010.severity = suggestion
# DontMutateAppendedStringArguments
dotnet_diagnostic.WTG3011.severity = none
# AvoidBoolLiteralsInLargerBoolExpressions
dotnet_diagnostic.WTG3012.severity = error
# DoNotNestRegions
dotnet_diagnostic.WTG3101.severity = suggestion
# RegionsShouldNotSplitStructures
dotnet_diagnostic.WTG3102.severity = suggestion
# ConditionalCompilationDirectivesShouldNotSplitStructures
dotnet_diagnostic.WTG3103.severity = suggestion
# UsingEnumerableExtensionMethodsOnAQueryable
dotnet_diagnostic.WTG4001.severity = error

### New Lines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true:warning
csharp_new_line_before_catch = true:warning
csharp_new_line_before_finally = true:warning
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_within_query_expression_clauses = true

### Indentation
csharp_indent_block_contents = true
csharp_indent_braces = false

csharp_indent_case_contents = true:warning
csharp_indent_switch_labels = true:warning
csharp_indent_labels = flush_left

### Avoid `this.` unless neccesary
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

### Prefer `var`, though WTG.Analyzers does a better job of this.
csharp_style_var_for_built_in_types = true:none
csharp_style_var_when_type_is_apparent  = true:none
csharp_style_var_elsewhere  = true:none

### Prefer language keywords over BCL types
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

### Constant fields should be Pascal-cased
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

### Prefer method-like constructs to have a block body
csharp_style_expression_bodied_methods = false:none
csharp_style_expression_bodied_constructors = false:none
csharp_style_expression_bodied_operators = false:none
csharp_style_expression_bodied_properties = true:none
csharp_style_expression_bodied_accessors = true:none

### Code style defaults
dotnet_sort_system_directives_first = true
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

### Prefer modern language features when available
dotnet_style_object_initializer = true:none
dotnet_style_collection_initializer = true:none
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_throw_expression = true:suggestion

### Spacing preferences
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = do_not_ignore
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

### XML-based project files
[*.{csproj,vcxproj,vcxproj.filters,fsproj,nativeproj,locproj,shproj,ruleset,props,targets,proj,common,tasks}]
indent_style = space
indent_size = 2
charset = utf-8-bom
insert_final_newline = false

[*.{xml,config}]
indent_style = space
indent_size = 2
insert_final_newline = false

[*.{yaml,py,ruleset}]
indent_style = space
indent_size = 2

[*.{fs,fsx}]
indent_style = space
indent_size = 4

### Paket Configuration files
[*.{dependencies,references]
indent_style = space
indent_size = 4

[*.cshtml]
indent_style = space
indent_size = 4

[{Winzor/**}]
# CA3002: Review code for XSS vulnerabilities
dotnet_diagnostic.CA3002.severity = warning
