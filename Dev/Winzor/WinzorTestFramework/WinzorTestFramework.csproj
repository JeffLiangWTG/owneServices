<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>$(NoWarn);CW1015;CW1021;CW1118;CW1161</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="WTG.PlaywrightTesting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BArchitecture.GUI\WinzorFramework.csproj" />
    <ProjectReference Include="..\Infrastructure\CargoWise.Blazor.Common\CargoWise.Blazor.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Blazor.Client.Integration" />
    <Reference Include="CargoWise.Blazor.Client.Integration.Server" />
    <Reference Include="ToxiproxyNetCore" />
    <Reference Include="WTG.ToxicNetworkEffect" />
  </ItemGroup>
  <ItemGroup>
    <ContentWithTargetPath Include="..\BArchitecture.GUI\wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>WinzorTestFramework\wwwroot\_content\WinzorFramework\%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="testhost.modules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>WinzorTestFramework\wwwroot\%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
</Project>
