@*
    Blazor requires a page attribute to be able to render any components at a given route
    Add a default page for Winzor which will render an EntryPointComponent at both the
    root url and the entry point pool path
*@
@using Enterprise.Winzor.Architecture
@page "/"
@attribute [Route(EntryPointPool.EntryPointPoolPath + "{PoolRequestId}")]

<EntryPointComponent />
