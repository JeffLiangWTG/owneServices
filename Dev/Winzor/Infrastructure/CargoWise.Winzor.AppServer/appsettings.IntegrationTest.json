{
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console"
		],
		"MinimumLevel": {
			"Default": "Debug"
		}
	},
	"CargoWiseOptions": {
		"DisconnectedCircuitRetentionPeriod": "0:0:2"
	},
	"CargoWiseAuthOptions": {
		"AllowAnonymousDeveloperLogins": true
	},
	"TelemetryOptions": {
		"TraceEnableProbability": 1,
		"MetricEnableProbability": 1,
		"OtlpEndpoint": "",
		"MetricExportInterval": "00:01:00",
		"SqlClientInstrumentation": true,
		"ServiceName": "CargoWise Winzor AppServer",
		"Sources": [
			{
				"Name": "CargoWise.Winzor.*",
				"Enabled": true
			},
			{
				"Name": "WinzorFramework",
				"Enabled": true
			},
			{
				"Name": "CargoWise.Blazor.*",
				"Enabled": true
			},
			{
				"Name": "Enterprise.*",
				"Enabled": true
			}
		],
		"ResourceAttributes": {
			"service.owner.customerId": "WTG",
			"service.owner.team": "WZR"
		}
	}
}
