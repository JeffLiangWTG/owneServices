<div class="connection-lost-overlay" id="components-reconnect-modal" data-confirm="">
    <div class="connection-lost-dialog">
        <div class="connection-lost-dialog__header">
            <div class="connection-lost-dialog--reconnecting connection-lost-dialog__header--warning">
                @WarningIcon
                <span>Connection lost</span>
            </div>

            <div class="connection-lost-dialog--confirmation connection-lost-dialog__header--warning">
                @WarningIcon
                <span>Disconnect session</span>
            </div>

            <div class="connection-lost-dialog--disconnected connection-lost-dialog__header--critical">
                @CriticalIcon
                <span>Reconnection failed</span>
            </div>
        </div>
        <div class="connection-lost-dialog__body">
            <div class="connection-lost-dialog__content">
                <div class="connection-lost-dialog--reconnecting">
                    <p><strong>Attempting to reconnect to your session.</strong></p>
                    <p>Please check your network connection.</p>
                    <p><strong>If you decide to disconnect all unsaved changes will be lost.</strong></p>
                    <p class="connection-lost-dialog__progresstext"><span id="components-reconnect-current-attempt"></span> out of <span id="components-reconnect-max-retries"></span> attempts</p>
                </div>

                <div class="connection-lost-dialog--confirmation">
                    <p><strong>If you decide to disconnect all unsaved changes will be lost.</strong></p>
                </div>

                <div class="connection-lost-dialog--disconnected">
                    <p><strong>Could not reconnect to your session.</strong></p>
                    <p>You can restart the application.</p>
                    <p>Your windows will re-open but <strong>all unsaved changes have been lost.</strong></p>
                </div>
            </div>

            <hr class="connection-lost-dialog__separator" />

            <div class="connection-lost-dialog__buttons">
                <div class="connection-lost-dialog--reconnecting">
                    <button class="connection-lost-dialog__button connection-lost-dialog__button--secondary"
                            onclick="document.getElementById('components-reconnect-modal').dataset.confirm = 'exit'">
                        Exit
                    </button>
                    <button class="connection-lost-dialog__button connection-lost-dialog__button--primary"
                            onclick="document.getElementById('components-reconnect-modal').dataset.confirm = 'restart'">
                        Restart
                    </button>
                </div>

                <div class="connection-lost-dialog--confirmation">
                    <button class="connection-lost-dialog__button connection-lost-dialog__button--secondary"
                        onclick="document.getElementById('components-reconnect-modal').dataset.confirm = ''">
                        Continue to wait
                    </button>
                    <button class="connection-lost-dialog__button connection-lost-dialog--confirmation-exit connection-lost-dialog__button--primary"
                        onclick="window.exit()">
                        Exit
                    </button>
                    <button class="connection-lost-dialog__button connection-lost-dialog--confirmation-restart connection-lost-dialog__button--primary"
                            onclick="window.restart()">
                        Exit and restart
                    </button>
                </div>

                <div class="connection-lost-dialog--disconnected">
                    <button class="connection-lost-dialog__button connection-lost-dialog__button--secondary"
                            onclick="window.exit()">
                        Exit
                    </button>
                    <button class="connection-lost-dialog__button connection-lost-dialog__button--critical"
                            onclick="window.restart()">
                        Restart
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

