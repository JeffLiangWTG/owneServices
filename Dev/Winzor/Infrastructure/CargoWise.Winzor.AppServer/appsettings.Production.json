{
	"Serilog": {
		"Using": [
			"WTG.Logging",
			"Serilog.Sinks.File",
			"Serilog.Sinks.Console",
			"Serilog.Sinks.Async"
		],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning",
				"System.Windows.Forms": "Information",
				"Microsoft.Hosting.Lifetime": "Information",
				"Microsoft.AspNetCore.Hosting.Diagnostics": "100" //Turns this logger off. Serilog doesn't have LogLevel.None
			}
		},
		"WriteTo": [
			{
				"Name": "Async",
				"Args": {
					"configure": [
						{
							"Name": "File",
							"Args": {
								"path": "%LOCALAPPDATA%/WiseTech Global/AppServer/as-.log",
								"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {Version} {AppName} {Hostname} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {AppServerProcessCorrelationId} {Message:lj} {NewLine}{Exception}",
								"rollingInterval": "Day",
								"buffered": true,
								"flushToDiskInterval": "00:00:01"
							}
						},
						{
							"Name": "Console",
							"Args": {
								"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {Version} {AppName} {Hostname} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {AppServerProcessCorrelationId} {Message:lj} {NewLine}{Exception}"
							}
						}
					]
				}
			}
		],
		"Properties": {
			"Environment": "Production"
		}
	},
	"AllowedHosts": "*"
}
