{
	"Serilog": {
		"Using": [
			"WTG.Logging",
			"Serilog.Sinks.File",
			"Serilog.Sinks.Console",
			"Serilog.Sinks.Async"
		],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning",
				"System.Windows.Forms": "Information",
				"Microsoft.Hosting.Lifetime": "Information",
				"Microsoft.AspNetCore.Hosting.Diagnostics": "100" //Turns this logger off. Serilog doesn't have LogLevel.None
			}
		},
		"WriteTo": [
			{
				"Name": "Async",
				"Args": {
					"configure": [
						{
							"Name": "File",
							"Args": {
								"path": "%LOCALAPPDATA%/WiseTech Global/AppServer/as-.log",
								"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {Version} {AppName} {Hostname} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {AppServerProcessCorrelationId} {Message:lj} {NewLine}{Exception}",
								"rollingInterval": "Day",
								"buffered": true,
								"flushToDiskInterval": "00:00:01"
							}
						},
						{
							"Name": "Console",
							"Args": {
								"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {Version} {AppName} {Hostname} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {AppServerProcessCorrelationId} {Message:lj} {NewLine}{Exception}"
							}
						}
					]
				}
			}
			// Note: to turn on logging to Kafka/Elastic, uncomment this
			//,
			//{
			//	"Name": "Kafka",
			//	"Args": {
			//		"brokers": "1.test-1.kafka.wtg.ws:9093,2.test-1.kafka.wtg.ws:9093,3.test-1.kafka.wtg.ws:9093",
			//		"topic": "topic-au1-test-cwblazor-test",
			//		"sslCertificatePath": "./kafkaCertificate.pem"
			//	}
			//}
			//
			//[WARNNING] Following section is for WTC production servers only
			//{
			//	"Name": "Kafka",
			//	"Args": {
			//		"brokers": "1.prod-1.kafka.wtg.ws:9093,2.prod-1.kafka.wtg.ws:9093,3.prod-1.kafka.wtg.ws:9093,4.prod-1.kafka.wtg.ws:9093,5.prod-1.kafka.wtg.ws:9093",
			//		"topic": "topic-au2-prod-cwblazor-prod",
			//		"sslCertificatePath": "./kafkaCertificate.pem"
			//	}
			//}
		],
		"Properties": {
			"Environment": "Development"
		}
	},
	"CargoWiseOptions": {
		"DisconnectedCircuitRetentionPeriod": "0:0:2"
	},
	"CargoWiseAuthOptions": {
		"AllowAnonymousDeveloperLogins": true
	},
	"TelemetryOptions": {
		"TraceEnableProbability": 0,
		"MetricEnableProbability": 0,
		"OtlpEndpoint": "http://otel-collector-test.wtg.ws:8318",
		"MetricExportInterval": "00:01:00",
		"SqlClientInstrumentation": false,
		"ServiceName": "CargoWise Winzor AppServer",
		"Sources": [
			{
				"Name": "CargoWise.Winzor.*",
				"Enabled": true
			},
			{
				"Name": "WinzorFramework",
				"Enabled": true
			},
			{
				"Name": "CargoWise.Blazor.*",
				"Enabled": true
			},
			{
				"Name": "Enterprise.*",
				"Enabled": true
			}
		],
		"ResourceAttributes": {
			"service.owner.customerId": "WTG",
			"service.owner.team": "WZR"
		}
	}
}
