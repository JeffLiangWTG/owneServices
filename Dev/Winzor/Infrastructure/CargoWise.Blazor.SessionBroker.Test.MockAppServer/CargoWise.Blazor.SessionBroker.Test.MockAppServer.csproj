<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <UseCommonOutputDirectory>false</UseCommonOutputDirectory>
    <OutputPath>$(WTGBinPath)$(MSBuildProjectName)-bin\</OutputPath>
    <!--- Disabling reference status check since output path is not bin\winzor -->
    <CWEnableReferenceStatusSafeGuard>false</CWEnableReferenceStatusSafeGuard>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>