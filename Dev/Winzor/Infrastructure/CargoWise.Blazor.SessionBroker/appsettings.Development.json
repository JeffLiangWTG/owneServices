{
	"Serilog": {
		"Using": [
			"WTG.Logging",
			"Serilog.Sinks.File",
			"Serilog.Sinks.Console",
			"Serilog.Sinks.Async"
		],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning",
				"Microsoft.Hosting.Lifetime": "Information"
			}
		},
		"WriteTo": [
			{
				"Name": "Async",
				"Args": {
					"configure": [
						{
							"Name": "File",
							"Args": {
								"path": "%LOCALAPPDATA%/WiseTech Global/SessionBroker/sb-.log",
								"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {Version} {AppName} {Hostname} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {Message:lj} {NewLine}{Exception}",
								"rollingInterval": "Day",
								"buffered": true,
								"flushToDiskInterval": "00:00:01"
							}
						},
						{
							"Name": "Console",
							"Args": {
								"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {Version} {AppName} {Hostname} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {Message:lj} {NewLine}{Exception}"
							}
						}
					]
				}
			}
			// Note: to turn on logging to Kafka/Elastic, uncomment this
			//,
			//{
			//	"Name": "Kafka",
			//	"Args": {
			//		"brokers": "1.test-1.kafka.wtg.ws:9093,2.test-1.kafka.wtg.ws:9093,3.test-1.kafka.wtg.ws:9093",
			//		"topic": "topic-au1-test-cwblazor-test",
			//		"sslCertificatePath": "./kafkaCertificate.pem"
			//	}
			//}

			//
			//[WARNNING] Following section is for WTC production servers only
			//{
			//	"Name": "Kafka",
			//	"Args": {
			//		"brokers": "1.prod-1.kafka.wtg.ws:9093,2.prod-1.kafka.wtg.ws:9093,3.prod-1.kafka.wtg.ws:9093,4.prod-1.kafka.wtg.ws:9093,5.prod-1.kafka.wtg.ws:9093",
			//		"topic": "topic-au2-prod-cwblazor-prod",
			//		"sslCertificatePath": "./kafkaCertificate.pem"
			//	}
			//}
		],
		"Properties": {
			"Environment": "Development"
		}
	},
	"CargoWiseOptions": {
		"AppServerPathOverride": "winzor\\CargoWise.Winzor.AppServer.exe",
		"DatabaseName": "Odyssey"
	},
	"ShutdownOptions": {
		"DueTime": "00:15:00"
	}
}
