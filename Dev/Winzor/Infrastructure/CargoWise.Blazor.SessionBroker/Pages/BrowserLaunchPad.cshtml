@page
@model CargoWise.Blazor.SessionBroker.Pages.BrowserLaunchPadModel

<html>
    <head>
    @{
        if (!string.IsNullOrEmpty(Model.ClientAppLaunchUri))
        {
            <meta http-equiv="refresh" content="1;URL='@Model.ClientAppLaunchUri'" />
        }
    }

        <title>CargoWise</title>
        <style>
            body {
                font-family: sans-serif;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                background-color: #fafafa;
                margin: 0;
            }

            .container {
                padding: 20px;
                border-radius: 5px;
                background-color: #fff;
                border-top: 4px solid #00A8E1;
                box-shadow: 0 4px 6px rgba(0,0,0,.2);
                max-width: 650px;
                display: flex;
                flex-direction: column;
            }

            h2 {
                text-align: center;
                color: #00A8E1;
                margin-top: 10px;
                margin-bottom: 30px;
            }

            p {
                margin: 0;
            }

                p + p {
                    margin-top: 8px;
                }

            .button {
                transition: 0.1s ease-in-out;
                border-radius: 8px;
                background-color: #003479;
                padding: 15px;
                margin: 8px 0 10px;
                color: #fff;
                text-decoration: none;
                align-self: center;
            }

                .button:hover {
                    background-color: #00A8E1;
                    text-decoration: none;
                }

                .button:active {
                    opacity: 0.6;
                }

            #downloadButton {
                width: 104px;
                height: 15px;
            }

            .download-link {
                margin-top: 2%;
            }
        </style>
    </head>

    <body>
        <div>
            <div class="container">
                <h2>CargoWise</h2>
                <p>Please wait while CargoWise is launched...</p>
                <p>If CargoWise does not start after a few seconds, click the button below to launch the loader again.</p>
                <a class="button" href="@Model.ClientAppLaunchUri">Launch</a>
            </div>
            <div class="download-link">
                Don't have CargoWise Web Version?
                <a id="downloadButton" href="@Model.MsixAppInstallerUrl">Download it now</a>
            </div>
        </div>
    </body>
</html>
