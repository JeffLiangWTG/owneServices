@page "/_sessionbroker/auth"
@model CargoWise.Blazor.SessionBroker.Pages.AuthenticatorModel

<script>
    window.addEventListener('load', () => {
        window.cargoWiseClient.handleLoginMessage('@Html.Raw(Model.ConstructLoginMessage())');
    });
</script>

<body>
    <h4>
        Please login via your web browser and then return to the application.
    </h4>
</body>
