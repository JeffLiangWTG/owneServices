@page
<head>
    <title>Automatic update failed</title>

    <style>
        * {
            text-align: inherit;
            font-family: inherit;
            font-size: inherit;
            line-height: inherit;
            margin: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body {
            text-align: left;
            overflow: hidden;
        }

        .picturebox {
            display: flex;
        }

        .mnemonickey {
            text-decoration: none;
        }

        .button {
            padding: 0px;
            border-radius: 0;
            border: none;
            background-color: unset;
        }

        .button--standard {
            padding: 2px;
            background-color: #e1e1e1;
            border: 1px solid #b4b4b4;
        }

        .button:hover {
            border: 1px solid #3996e0;
        }

        .button > div .button__text {
            text-align: center;
            overflow: hidden;
            min-height: 0;
            min-width: 0;
        }

        .textbox {
            text-align: left;
            resize: none;
        }

        .textbox--scrollbar::-webkit-scrollbar {
            width: 0;
        }

        .textbox--border-none {
            border: 0;
            padding: 0;
        }
    </style>
    <script>
        window.cargoWiseClient.setApplicationReady("\"00:00:10\"");

        window.chrome.webview.postMessage(JSON.stringify({
            $type: 'FormInitializationStyleMessage, CargoWise.Blazor.Client.Integration',
            FormBorderStyle: '1',
            StartPosition: '1',
            InitialSize: {
                preferSize: '300, 140',
            }
        }));

        window.chrome.webview.postMessage(JSON.stringify({
            $type: 'FormStyleMessage, CargoWise.Blazor.Client.Integration',
            maximizeBox: false,
            minimizeBox: false,
            ControlBox: false,
            FormBorderStyle: '1'
        }));

        function shutdown() {
            window.cargoWiseClient.shutDownApplication();
        }
    </script>
</head>

<body>
    <div class='form' style='position:absolute;overflow:hidden;width:300px;height:140px;background-color:#FFFFFFFF;color:#000000FF;font-family:Tahoma;line-height:13px;font-size:8pt;' tabindex='-1'>
        <div style='position:absolute;width:40px;height:40px;top:4px;left:4px;background-color:#FFFFFFFF;' tabindex='-1'>
            <div class='picturebox ' style='width:40px;height:40px;'>
                <img src='data:image/png;base64,' style='width:40px;height:40px;' draggable='false'>
            </div>
        </div>
        <button id='btn-ok' onclick='shutdown()' title='OK' style=' position: absolute; top: 105px; left: 108px; width: 73px; height: 21px;' class='button button--standard' tabindex='0'>
            <div style='position: absolute; top: 2px; left: 2px; width: 67px; height: 15px;background-color:#C4C7C8FF;overflow: hidden;' class=' button--overlay'>
                <div class='button__text' style='position: absolute; top: 1px; left: 22px; width: 20px; height: 14px;line-height: 13px;  '>
                    <span class='mnemonickey'>O</span>K
                </div>
            </div>
        </button>
        <textarea class='textbox textbox--scrollbar   textbox--border-none' type='text' maxlength='32767' readonly='' style='position:absolute;width:240px;height:90px;top:8px;left:56px;background-color:#FFFFFFFF;color:#000000FF;--current-cursor:text; --current-background-color:#FFFFFFFF; overflow-x:hidden;overflow-y:auto;' spellcheck='false' tabindex='-1'>
Your CargoWise app needs to be updated to work with this CargoWise server.

Restart CargoWise to automatically update the app. If this error continues, uninstall the CargoWise app and install the latest version.
            </textarea>
    </div>
</body>
