{
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console",
			"WTG.Logging"
		],
		"MinimumLevel": {
			"Default": "Debug"
		},
		"WriteTo": [
			{
				"Name": "File",
				"Args": {
					"path": "%LOCALAPPDATA%/WiseTech Global/AppServer/as-.log",
					"outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {MachineName} {AppName} {VersionBrokerProcessCorrelationId} {SessionBrokerProcessCorrelationId} {AppServerProcessCorrelationId} {Message:lj} {NewLine}{Exception}",
					"rollingInterval": "Day",
					"configure": [
						{
							"Name": "Console"
						}
					]
				}
			// Note: to turn on logging to Kafka/Elastic, uncomment this
			//},
			//{
			//	"Name": "Kafka",
			//	"Args": {
			//		"brokers": "1.test-1.kafka.wtg.ws:9093,2.test-1.kafka.wtg.ws:9093,3.test-1.kafka.wtg.ws:9093",
			//		"topic": "topic-au1-test-cwblazor-test",
			//		"sslCertificatePath": "./kafkaCertificate.pem"
			//	}
			}
		],
		"Properties": {
			"Environment": "Development"
		}
	},
	"CargoWiseOptions": {
		"DisconnectedCircuitRetentionPeriod": "0:0:2"
	},
	"CargoWiseAuthOptions": {
		"AllowAnonymousDeveloperLogins": true
	}
}
