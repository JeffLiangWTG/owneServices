<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DefineConstants Condition="'$(CanNetCoreLibBeReferencedFromWinzor)' == 'true'">$(DefineConstants);USE_NET_CORE_LIBS_IN_WINZOR</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- this project is a dependency of the tooling tasks lib -->
    <DisableWtgBlazorTooling>true</DisableWtgBlazorTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="Serilog.Settings.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWiseNext.Infrastructure.Authentication" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="WTG.OpenIDConnect.Token" />
    <Reference Include="WTG.Logging" />
    <Reference Include="WTG.Logging.Extensions" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Semaphores.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="System.IdentityModel.Tokens.Jwt" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>