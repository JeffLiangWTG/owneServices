@namespace CargoWise.Blazor.Controls

<button title="@Description" class="@CssClass"
        @onclick="@OnClick" @onclick:stopPropagation
        @oncontextmenu="@OnClick" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation
        @onfocusin="@OnFocusIn" @onfocusin:stopPropagation>
    @if (!string.IsNullOrEmpty(Text))
    {
        <span>@Text</span>
    }
</button>
