@using CargoWise.NetworkVisualisation.GUI.Models
@inherits NetworkNode<AnnotationNodeModel>

<div class="networknode annotationnode">
    <div class="annotationnode__cardwrapper">
        <div class="networknode__card annotationnode__card" style="@StatusColorStyle" title="@Node.Tooltip">
            <DynamicTextArea Class="networknode__diagramname annotationnode__diagramname"
                             Style=@($"font-weight: {StatusFontWeight};")
                             Placeholder="Note Title"
                             AriaLabel="Note Title"
                             IsMoving=@Node.IsMoving
                             @bind-Value=@Node.DiagramName
                             @bind-Value:after=@Node.Diagram_DiagramNameChangedAsync
                             />
            <DynamicTextArea Class="networknode__notes annotationnode__notes"
                             Placeholder=@Node.NotesPlaceholder
                             AriaLabel="Note Body"
                             IsMoving=@Node.IsMoving
                             @bind-Value=@Node.Notes
                             @bind-Value:after=@Node.Diagram_NotesChangedAsync
                             />
        </div>
    </div>
</div>
