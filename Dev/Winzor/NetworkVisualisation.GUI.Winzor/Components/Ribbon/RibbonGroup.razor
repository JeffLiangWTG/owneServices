@namespace CargoWise.NetworkVisualisation.GUI

@if (ViewModel is not null)
{
    <div class="ribbongroup">
        <div class="ribbongroup__items">
            @foreach (var item in ViewModel.Items)
            {
                switch (item)
                {
                    case RibbonMenuButtonViewModel ribbonMenuButtonViewModel:
                    {
                        <RibbonMenuButton ViewModel="ribbonMenuButtonViewModel" />
                        break;
                    }
                    case RibbonToggleButtonViewModel ribbonToggleButtonViewModel:
                    {
                        <RibbonToggleButton ViewModel="ribbonToggleButtonViewModel" />
                        break;
                    }
                    default:
                    {
                        <RibbonButton ViewModel="item" />
                        break;
                    }
                }
            }
        </div>
        <span class="ribbongroup__header">@ViewModel.Header</span>
    </div>
}
