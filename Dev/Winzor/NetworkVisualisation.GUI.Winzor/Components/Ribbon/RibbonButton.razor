@namespace CargoWise.NetworkVisualisation.GUI

@if (ViewModel is not null)
{
    <button @ref="ribbonButtonRef" class="@(ButtonType) @(GetImageLayoutStyle())" disabled="@(!ViewModel.IsEnabled)" @onclick=OnClickAsync @onclick:stopPropagation title="@ViewModel.Tooltip" data-checked="@Checked">
        @if (!string.IsNullOrEmpty(ViewModel.Image))
        {
            <img class="ribbonbutton__image" src="@ViewModel.Image" draggable="false" />
        }
        <span class="ribbonbutton__label">@ViewModel.Label</span>
        @if (HasChildButtons)
        {
            <img class="ribbonbutton__dropdownarrow" src=@Resources.ArrowDown />
        }
    </button>
}
