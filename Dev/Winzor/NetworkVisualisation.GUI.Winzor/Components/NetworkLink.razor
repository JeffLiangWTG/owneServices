@if (@Link.PathGeneratorResult != null)
{
    <g class="networklink" data-source=@Link.SourceName data-target=@Link.TargetName display=@(Link.IsVisible ? string.Empty : "none")>
        <title>@Link.DisplayText</title>
        <path d="@Link.PathGeneratorResult.FullPath.ToString()" stroke-width="2" fill="none" stroke="@linkColor" stroke-dasharray="@linkAppearance" onmouseenter=@OnMouseEnter onmouseleave="@OnMouseLeave" />
        <polygon points="@ArrowVertices" style="fill:@(linkColor);" />
        <foreignObject x=@DeleteIconPosition.X y=@DeleteIconPosition.Y>
            <DeleteIcon Visible=@DeleteIconVisible QuickHide=@Link.QuickHideDeleteIcon ImagePath=@Resources.DeleteLink Tooltip="@Link.DeleteTooltip" DeleteCallback=@DeleteLink @key=Link />
        </foreignObject>
	</g>
}
