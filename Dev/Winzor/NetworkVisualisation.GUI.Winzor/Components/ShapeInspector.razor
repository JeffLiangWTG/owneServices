@using CargoWise.NetworkVisualisation.GUI.Models
<div class="shapeinspector">
	<span class="shapeinspector__heading">Shape Inspector</span>
    <div class="shapeinspector__content">
		@switch (Model)
        {
        	case AnnotationNodeModel annotation:
        		<AnnotationNode Node=@annotation/>
        		break;
        	case JobNodeModel job:
        		<JobNode Node=@job/>
        		break;
            case BufferNodeModel buffer:
                <BufferNode Node=buffer />
                break;
        	case null:
                <div class="shapeinspector__instructions">
        			@Instructions
        		</div>
        		break;
        	default:
        		throw new NotImplementedException();
        }
	</div>
</div>
