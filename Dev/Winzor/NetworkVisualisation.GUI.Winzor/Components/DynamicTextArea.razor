@inherits ComponentBase;

<div class=@(Class + " textarea__resizable-wrapper") data-value=@Value style=@Style>
    <textarea
        class="textarea__resizable"
        @bind=@Value
        @bind:after=@OnValueChanged
        placeholder=@Placeholder
        aria-label=@AriaLabel
        maxlength=@Maxlength
        readonly=@Readonly
        style=@($"cursor: {(IsMoving ? "move" : "text")};")
        @ondblclick:stopPropagation
        @onpointerdown:stopPropagation
        @onkeydown:stopPropagation
        @ref=elementReference
        @oncontextmenu=OpenContextMenuAsync
        @oncontextmenu:stopPropagation
        @oncontextmenu:preventDefault
        oninput="event.target.parentNode.dataset.value = event.target.value"
         />
</div>
