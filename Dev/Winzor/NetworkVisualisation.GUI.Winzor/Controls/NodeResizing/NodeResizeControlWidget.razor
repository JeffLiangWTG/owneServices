@using CargoWise.NetworkVisualisation.GUI.Models;

@if (IsVisible)
{
    <div class="@Control.Class" style="z-index: @Model.ZIndex" />
}

@code
{
    [Parameter]
    public NodeResizeControl Control { get; set; } = null!;

    [Parameter]
    public NetworkNodeModel Model { get; set; } = null!;

    bool IsVisible => Control.IsVisible;
}
