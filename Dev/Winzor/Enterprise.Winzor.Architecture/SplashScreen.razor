@namespace Enterprise.Winzor.Architecture
@inherits System.Windows.Forms.Control

<div class="splash">
    <div class="splash__top">
        <div class="splash__center">
            <div class="splash__cwnextlogo" />
        </div>
        <div class="splash__progressbar">
            <div class="progressbar__filler" style="width: @ProgressStyleString;"></div>
        </div>
    </div>
    <div class="splash__bottom">
        <div class="splash__status">
            <div class="splash__inProgress">
            </div>
            <div class="splash__message">
                @currentMessage
            </div>
        </div>
        <div class="splash__wtglogo" />
    </div>
</div>
