<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WinzorFramework.RemoteClientServices</RootNamespace>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8602;CS8603;CS8604;CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(CodeAnalysisEnabled)' == 'True'">
    <Analyzer Include="$(WTGPaketPackagesRoot)\$(WTGPaketBuildItemsGroupName)\Microsoft.VisualStudio.Threading.Analyzers\analyzers\cs\Microsoft.VisualStudio.Threading.Analyzers.CSharp.dll" />
    <Analyzer Include="$(WTGPaketPackagesRoot)\$(WTGPaketBuildItemsGroupName)\Microsoft.VisualStudio.Threading.Analyzers\analyzers\cs\Microsoft.VisualStudio.Threading.Analyzers.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\RemoteClientServicesConfiguration.xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration\RemoteClientServicesConfiguration.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Architecture\Windows.UI\CargoWise.Windows.UI.Winzor.csproj" />
    <ProjectReference Include="..\BArchitecture.GUI\WinzorFramework.csproj" />
    <ProjectReference Include="..\Infrastructure\CargoWise.Blazor.Common\CargoWise.Blazor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CargoWise.Blazor.Client.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Microsoft.IdentityModel.Tokens" />
    <Reference Include="WTG.OpenIDConnect.Login" />
    <Reference Include="WTG.OpenIDConnect.Token" />
  </ItemGroup>
</Project>
