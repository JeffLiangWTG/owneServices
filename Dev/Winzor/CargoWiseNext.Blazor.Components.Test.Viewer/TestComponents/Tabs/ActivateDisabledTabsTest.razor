<CwnTabs Elevation="1" @ref="_tabElement" PanelClass="test-active-panel" TabPanelClass="test-panel-selector" Position="Position.Top">
    @for (int i = 0; i < Tabs.Count; i++)
    {
        int tempIndex = i;

        <CwnTabPanel @key="@Tabs[tempIndex].Name" @ref="Tabs[tempIndex].Panel" Text="@Tabs[tempIndex].Name" ID="@Tabs[tempIndex].Tag" @bind-Disabled="@Tabs[tempIndex].Disabled">
            <CwnText>@Tabs[tempIndex].Content</CwnText>
        </CwnTabPanel>
    }
</CwnTabs>
