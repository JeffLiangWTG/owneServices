<CwnButton OnClick="AddTab">Add Tab</CwnButton>
<CwnButton OnClick="RemoveLast">Remove Last</CwnButton>

<CwnTabs Elevation="1" @ref="Tabs">
    @foreach (var tab in _tabs)
    {
        <CwnTabPanel @key="tab" Text="@tab">
            <CwnText>@tab</CwnText>
        </CwnTabPanel>
    }    
</CwnTabs>
