<CwnTabs @bind-ActivePanelIndex="@SelectedTab" @ref="Tabs">
    <CwnTabPanel Text="Tab One">
        <CwnText>Content One</CwnText>
    </CwnTabPanel>
    <CwnTabPanel Text="Tab Two">
        <CwnText>Content Two</CwnText>
    </CwnTabPanel>
    <CwnTabPanel Text="Tab Three">
        <CwnText>Content Three</CwnText>
    </CwnTabPanel>
    <CwnTabPanel Text="Tab Disabled" Disabled="true">
        <CwnText>Content Disabled</CwnText>
    </CwnTabPanel>
</CwnTabs>

@code {
    public static int SelectedTab { get; set; } = 1;

    public CwnTabs Tabs { get; set; } = null!;
}
