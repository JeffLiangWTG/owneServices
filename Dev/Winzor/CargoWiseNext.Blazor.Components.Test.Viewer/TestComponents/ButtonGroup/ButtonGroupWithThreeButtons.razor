<CwnButtonGroup FullWidth="ButtonGroupFullWidth">
    @if(Button1Displayed)
    {
        <CwnButton FullWidth="Button1FullWidth">Button One</CwnButton>
    }
    @if(Button2Displayed)
    {
        <CwnButton FullWidth="Button2FullWidth">Button Two</CwnButton>
    }
    @if(Button3Displayed)
    {
        <CwnButton FullWidth="Button3FullWidth">Button Third</CwnButton>
    }
</CwnButtonGroup>

@code {
    [Parameter]
    public bool ButtonGroupFullWidth { get; set; } = true;

    [Parameter]
    public bool Button1Displayed { get; set; } = true;

    [Parameter]
    public bool Button1FullWidth { get; set; }

    [Parameter]
    public bool Button2Displayed { get; set; } = true;

    [Parameter]
    public bool Button2FullWidth { get; set; }

    [Parameter]
    public bool Button3Displayed { get; set; } = true;

    [Parameter]
    public bool Button3FullWidth { get; set; }
}
