@using WinzorFramework
@using System.Drawing;
@namespace System.Windows.Forms
@inherits Control

<div @attributes="DataAttributes" class="datetimepicker" @ref="ElementReference">
	<input class="datetimepicker__input" type="date" value=@FormatDateTime(value, format) @onchange=UpdateDateAsync @onchange:stopPropagation @onblur="OnBlurAsync" @onblur:stopPropagation max=@FormatDateTime(MaxDate, format) min=@FormatDateTime(MinDate, format) />
	<div class="datetimepicker__dropdownbutton">
		<span class="datetimepicker__dropdownbuttonwithcalendar" @onmousedown=@ShowCalendarAsync @onmousedown:stopPropagation></span>
	</div>
	@if (Calendar != null)
	{
        <ControlProxyComponent Control="Calendar" @key=Calendar.WinzorControlGuid />
	}
</div>
