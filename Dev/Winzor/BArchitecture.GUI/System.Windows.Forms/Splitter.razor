@namespace System.Windows.Forms
@inherits Control
@using System.Drawing
@using WinzorFramework
@using WinzorFramework.Extensions
@using WebMouseEventArgs = Microsoft.AspNetCore.Components.Web.MouseEventArgs

<div style="@SplitterStyleString" class="splitter" @attributes="DataAttributes"
    @ref="SplitterReference" @onwinzorfocusin=BeginSplitterMoveAsync
    @onwinzorfocusin:stopPropagation @onsplittermoved="HandleSplitterMoveAsync" @onsplittermoved:stopPropagation
	tabindex="@this.TabIndexHtmlAttributeValue()">
    @RenderControls()
</div>
