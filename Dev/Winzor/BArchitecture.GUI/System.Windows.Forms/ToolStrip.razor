@using WinzorFramework
@namespace System.Windows.Forms
@inherits ScrollableControl

<div class="toolstrip"
    style="@ControlStyleString"
    @attributes="DataAttributes"
    @ref=ElementReference
    @oncontextmenu="OnContextMenuAsync" @oncontextmenu:stopPropagation @oncontextmenu:preventDefault
    @onmousedown="OnMouseDownAsync" @onmousedown:stopPropagation
    @onwinzorfocusin:stopPropagation
    @onwinzorfocusout="OnFocusOutAsync" @onwinzorfocusout:stopPropagation>
    @foreach (var item in DisplayedItems)
    {
        <ControlProxyComponent Control=item @key=item.WinzorControlGuid />
    }
</div>
