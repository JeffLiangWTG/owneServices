@namespace CargoWiseNext.Blazor.Components

@inherits CwnComponentBase

<CwnElement HtmlTag="div" Class="@Classname" Style="@Style" Tag="@Tag" UserAttributes="@UserAttributes">
	<CascadingValue IsFixed="true" Value="this">
		@ChildContent
	</CascadingValue>
</CwnElement>

@{
	UserAttributes.TryAdd("role", "group");
}
