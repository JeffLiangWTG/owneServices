@namespace CargoWiseNext.Blazor.Components
@inherits CwnComponentBase

<div class="@Classname" style="@Style" @attributes="UserAttributes">
    @if (CardHeaderContent is not null)
    {
        <div class="@ClassnameHeaderContent">@CardHeaderContent</div>
    }
    @if (CardHeaderActions is not null)
    {
        <div class="@ClassnameHeaderActions">@CardHeaderActions</div>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
</div>
