@namespace CargoWiseNext.Blazor.Components
@inherits CwnComponentBase

<CwnElement Class="@Classname"
            Style="@Stylename"
            OnSingleClick="OnClickHandlerAsync"
            OnContextMenu="OnContextMenuHandlerAsync"
            ContextMenuStopPropagation="@(OnRightClick.HasDelegate)"
            ContextMenuPreventDefault="@(OnRightClick.HasDelegate)"
            UserAttributes="UserAttributes"
            HtmlTag="li"
            OnMouseDown="OnMouseDownHandlerAsync">
    @ChildContent
</CwnElement>
