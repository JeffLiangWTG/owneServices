@namespace CargoWiseNext.Blazor.Components
@inherits CwnComponentBase

<div class="@Classname" style="@Style" @attributes="UserAttributes" @onclick="async () => await FocusAsync()" @onclick:stopPropagation>
    <CwnIcon Icon=@(Icon.Search) Color="@(Color.Default)" />
    <CwnTextField @ref="_inputRef" Class="cwn-search--input" InputType="@InputType.Text" Placeholder="@Placeholder" OnInput="@OnInput" OnFocus="@OnFocus" />
    <CwnShortcut Shortcuts="@Shortcut"></CwnShortcut>
</div>
