@namespace CargoWiseNext.Blazor.Components
@inherits CwnComponentBase

@if (Bottom)
{
<footer @attributes="UserAttributes" class="@Classname" style="@Style">
    <CwnToolBar Dense="@Dense" Gutters="@Gutters" Class="@ToolBarClassname" WrapContent="@WrapContent">
        @ChildContent
    </CwnToolBar>
</footer>
}
else
{
<header @attributes="UserAttributes" class="@Classname" style="@Style">
    <CwnToolBar Dense="@Dense" Gutters="@Gutters" Class="@ToolBarClassname" WrapContent="@WrapContent">
        @ChildContent
    </CwnToolBar>
</header>
}
