@namespace CargoWiseNext.Blazor.Components
@inherits CwnBaseButton
@implements IDisposable

<CwnElement @bind-Ref="@_elementReference"
            Class="@Classname"
            Style="@Style"
            OnSingleClick="OnClickHandlerAsync"
            OnFocusIn="HandleOnFocusInAsync"
            OnMouseDown="OnMouseDownHandlerAsync"
            UserAttributes="UserAttributes"
            Disabled="@Disabled"
            HtmlTag="button">

    <span class="cwn-button__content">
        @if (StartIcon.HasValue)
        {
            <CwnIcon Disabled="@Disabled"
                     Size="@IconSize"
                     Icon="@StartIcon.Value" />
        }
        <span class="@ClassnameCaption">
            @ChildContent
        </span>
        @if (EndIcon.HasValue)
        {
            <CwnIcon Disabled="@Disabled"
                     Size="@IconSize"
                     Icon="@EndIcon.Value" />
        }
    </span>
</CwnElement>
