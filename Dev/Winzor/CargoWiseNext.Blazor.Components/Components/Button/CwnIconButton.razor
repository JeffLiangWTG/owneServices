@namespace CargoWiseNext.Blazor.Components
@inherits CwnBaseButton

<CwnElement Ref="@_elementReference"
    Class="@Classname"
    Style="@Style"
    AccessKey="@AccessKey"
    Disabled="@Disabled"
    OnSingleClick="OnSingleClick"
    OnMouseDown="OnMouseDownHandlerAsync"
    UserAttributes="UserAttributes"
    HtmlTag="button">
    @if(Icon.HasValue)
    {
        <CwnIcon Class="@ClassIcon"
            Disabled="@Disabled"
            Size="@Size.FillParent"
            Icon="@Icon.Value"
            HoverIcon="@HoverIcon"
            Color="@Color"/>
    }
    else
    {
        @ChildContent
    }
    </CwnElement>
