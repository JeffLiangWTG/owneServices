@namespace CargoWiseNext.Blazor.Components
@inherits CwnComponentBase

<CwnElement HtmlTag="div" Class="@Classname" Style="@Stylename" UserAttributes="@UserAttributes">
    @if (StartIcon.HasValue)
    {
        <CwnIcon Icon="@StartIcon.Value" Size="@IconSize" Color="@IconColor" />
    }
    <input
        type="@InputType.GetDescription()"
        placeholder="@Placeholder"
        value="@internalValue"
        class="cwn-input__input"
        maxlength="@MaxLength"
        disabled="@Disabled"
        @oninput="HandleOnInputAsync"
        @oninput:stopPropagation=@(ValueChanged.HasDelegate)
        @onkeydown="HandleKeyDownAsync"
        @onkeydown:stopPropagation=@(OnKeyDown.HasDelegate)
        @onfocus="HandleOnFocusedAsync"
        @onfocus:stopPropagation="@(OnFocus.HasDelegate)"
        @onblur="HandleOnBlurAsync"
        @onblur:stopPropagation="@(OnBlur.HasDelegate)"/>
    @if (EndIcon.HasValue)
    {
        <CwnIcon Icon="@EndIcon.Value" Size="@IconSize" Color="@IconColor" />
    }
</CwnElement>
