@namespace CargoWiseNext.Blazor.Components
@inherits CwnComponentBase

<input class="@Classname"
       type="@InputType.GetDescription()"
       style="@Style"
       placeholder="@Placeholder"
       @ref="_elementReference"
       @bind="@Value"
       @attributes="UserAttributes"
       @onfocus="OnFocusedAsync"
       @onfocus:stopPropagation="@(OnFocus.HasDelegate)"
       @oninput="OnInputChangeAsync"
       @oninput:stopPropagation=@(OnInput.HasDelegate)>
