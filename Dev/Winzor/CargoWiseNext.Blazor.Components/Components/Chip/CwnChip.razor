@namespace CargoWiseNext.Blazor.Components

@inherits CwnComponentBase

<div class="@Classname" @attributes="UserAttributes">
    @if (Icon.HasValue)
    {
	    <CwnIcon Size="@IconSize"
	             Icon="@Icon.Value"
	             Color="@IconColor" />
    }
    <span class="cwn-chip--outlined__content">
        @ChildContent
    </span>
</div>
