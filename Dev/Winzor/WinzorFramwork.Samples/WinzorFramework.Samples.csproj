<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <CWUsesSqlClient>false</CWUsesSqlClient>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AppServer\**" />
    <Compile Remove="Components\**" />
    <Compile Remove="wwwroot\**" />
    <EmbeddedResource Remove="AppServer\**" />
    <EmbeddedResource Remove="Components\**" />
    <EmbeddedResource Remove="wwwroot\**" />
    <None Remove="AppServer\**" />
    <None Remove="Components\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Properties\launchSettings.json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="wwwroot\**" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="Components\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="AppServer\**" />
  </ItemGroup>
</Project>