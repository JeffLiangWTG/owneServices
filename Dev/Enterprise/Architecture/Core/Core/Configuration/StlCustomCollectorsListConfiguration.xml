<?xml version="1.0" encoding="utf-8"?>

<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
	<!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
	<!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- StlCustomCollectors -->
  <object id="StlCustomCollectorsList" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList">
      <list>
        <ref object="StorageUsedSizeCollector" />
        <ref object="UsageCollectorScript" />
        <ref object="UsageSummaryCollectorScript" />
      </list>
    </property>
  </object>
  <object id="StorageUsedSizeCollector" type="Enterprise.Billing.StlCollector.Retriever.Scripts.Core.StorageUsedSizeCollector, Enterprise.Billing.StlCollector.Retriever" singleton="false" />
  <object id="UsageCollectorScript" type="Enterprise.Billing.StlCollector.Retriever.Scripts.eServices.UsageCollectorScript, Enterprise.Billing.StlCollector.Retriever" singleton="false" />
  <object id="UsageSummaryCollectorScript" type="Enterprise.Billing.StlCollector.Retriever.Scripts.eServices.UsageSummaryCollectorScript, Enterprise.Billing.StlCollector.Retriever" singleton="false" />
</objects>
