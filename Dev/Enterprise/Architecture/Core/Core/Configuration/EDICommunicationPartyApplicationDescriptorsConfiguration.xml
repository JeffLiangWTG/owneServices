<?xml version="1.0" encoding="utf-8"?>

<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
	<!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
	<!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- ApplicationDescriptors -->
  <object id="EDIClientApplicationDescriptors" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext" singleton="true">
    <property name="SourceDictionary">
      <dictionary>
        <entry>
          <key>
            <value>EAN</value>
          </key>
          <value>eAdaptorNext</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="eAdaptorNext" type="Enterprise.MasterFiles.Business.eAdaptorNextApplicationDescriptor, Enterprise.MasterFiles.Business" singleton="false" />
  <object id="IEDIClientApplicationDescriptors" type="Enterprise.MasterFiles.Business.EDIClientApplicationDescriptors, Enterprise.MasterFiles.Business" singleton="true"></object>
</objects>
