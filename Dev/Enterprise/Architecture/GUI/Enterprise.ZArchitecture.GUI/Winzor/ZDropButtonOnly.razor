@using WinzorFramework
@using Microsoft.AspNetCore.Components.Web
@using Winform = System.Windows.Forms;
@namespace Enterprise.ZArchitecture.GUI
@inherits ZButton

<button data-winzor-control-id="@WinzorControlId" class="zdropbuttononly" style="@ControlStyleString" @onclick="OnClickAsync" @onclick:stopPropagation @onwinzorfocusin="OnFocusInAsync" @onwinzorfocusin:stopPropagation @onwinzorfocusout="OnFocusOutAsync" @onwinzorfocusout:stopPropagation @ref="ElementReference"
        @oncontextmenu="OnContextMenuAsync" @oncontextmenu:stopPropagation @oncontextmenu:preventDefault disabled="@(!Enabled)">keyboard_arrow_down</button>
