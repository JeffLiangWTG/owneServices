@using WinzorFramework
@using Microsoft.AspNetCore.Components.Web
@using Winform = System.Windows.Forms;
@namespace Enterprise.ZArchitecture.GUI

@inherits ZPanel

<div class="collapsible-panel">
    
    <button class="collapsible-panel__button" data-winzor-control-id="@WinzorControlId" @onclick="OnButtonClickAsync" @onclick:stopPropagation>
        <svg width="16px" height="16px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="rotate(@Rotation)">
            <path stroke-width="0" stroke-linecap="round" stroke-linejoin="round" fill-rule="evenodd" clip-rule="evenodd" d="M12.0001 3.75317L21.5509 20.2501H2.44922L12.0001 3.75317ZM5.05089 18.7501H18.9492L12.0001 6.74697L5.05089 18.7501Z" fill="#080341"></path>
        </svg>
    </button>
    @if (!IsCollapsed)
    {
        <h1 class="collapsible-panel__label"> @Text </h1>
        <div class="collapsible-panel__inner @InnerPanelClass">
            @RenderControls()
        </div>
    }
    else
    {
        <h1 class="collapsible-panel__label @CollapsedLabelClass "> @Text </h1>
    }   
</div>

