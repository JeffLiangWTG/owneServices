<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Enterprise.ZArchitecture.Web.Shared.Test</RootNamespace>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <SuppressObsoleteWarnings>SYSLIB0014;SYSLIB0024</SuppressObsoleteWarnings>
    <IsCwTestProject>false</IsCwTestProject>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <ProjectReference Include="..\Shared.Test.Common.Strong\Enterprise.ZArchitecture.Web.Shared.Test.Common.Strong.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.ActiveDirectory.TestFramework" />
    <Reference Include="CargoWise.ApplicationManager.Common" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWiseOne.WebInfrastructure" />
    <Reference Include="HtmlAgilityPack" />
    <Reference Include="Microsoft.Web.Administration" />
    <Reference Include="Moq" />
    <Reference Include="nunit.framework" />
    <Reference Include="NUnitCore" />
    <Reference Include="Polly" />
    <Reference Include="WTG.DevTools.Common" />
    <Reference Include="WTG.DevTools.Configuration" />
    <Reference Include="WTG.DevTools.TestFramework" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="Microsoft.AspNetCore.Http" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>
</Project>