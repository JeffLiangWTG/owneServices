<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <AssemblyName>Enterprise.ZArchitecture.Benchmark.Framework</AssemblyName>
    <WarningsAsErrors>;NU1605</WarningsAsErrors>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />

  <!-- Unit test related references: ITestContext -->
  <ItemGroup>
    <Reference Include="NUnitCore" />
    <Reference Include="nunit.framework" />
  </ItemGroup>

  <!--- Local environment references: ILocalEnvironment -->
  <ItemGroup>
    <Reference Include="CargoWise.Data" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Management" />
  </ItemGroup>
</Project>