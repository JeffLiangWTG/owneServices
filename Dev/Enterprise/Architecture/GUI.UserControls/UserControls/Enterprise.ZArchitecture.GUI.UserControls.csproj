<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Enterprise.ZArchitecture.GUI</RootNamespace>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <NoWarn>$(NoWarn);1591;1573;1596;</NoWarn>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <OverrideDesignerFileGetDataNamespace>Enterprise.ZArchitecture.GUI.UserControls</OverrideDesignerFileGetDataNamespace>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Compile Remove="Winzor\**" />
    <EmbeddedResource Remove="Winzor\**" />
    <None Remove="Winzor\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Interop" />
    <Reference Include="System.Resources.Extensions" />
  </ItemGroup>
    <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <Reference Include="System.Windows.Forms.Primitives" />
    <Reference Include="System.Windows.Forms.Design" />
    <Reference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\PublishedFilter.ico" />
    <None Include="Resources\glyphicons_207_remove_2-small.png" />
    <None Include="Resources\MailIconinvalid.png" />
    <None Include="Resources\MailIconunverified.png" />
    <None Include="Resources\MailIconvalidresize.png" />
    <None Include="Resources\Mail.png" />
    <None Include="Resources\Search.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aga.Business\Aga.Business.csproj" />
    <ProjectReference Include="..\Aga.Controls\Aga.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>