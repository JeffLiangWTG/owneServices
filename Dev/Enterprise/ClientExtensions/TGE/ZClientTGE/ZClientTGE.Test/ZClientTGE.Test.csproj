  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="DataManipulation\PMSInterface\TestFile\expconTestDataWithException.tsv">
      <LogicalName>expconTestDataWithException.tsv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="DataManipulation\PMSInterface\TestFile\expconTestForMAWBHAWBExistWarning.tsv">
      <LogicalName>expconTestForMAWBHAWBExistWarning.tsv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="DataManipulation\PMSInterface\TestFile\expconWithValidTestData.tsv">
      <LogicalName>expconWithValidTestData.tsv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZClientTGE\ZClientTGE.csproj" />
  </ItemGroup>
