	name="ProductAreaAssignment"
	>
	
	<StringColumn>
		<Name>ProductArea</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	
	<StringColumn>
		<Name>Staff</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	
	<Serialisation>
