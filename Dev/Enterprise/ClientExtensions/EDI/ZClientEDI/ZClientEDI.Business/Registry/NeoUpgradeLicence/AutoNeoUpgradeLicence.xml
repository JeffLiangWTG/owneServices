<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="NeoUpgradeLicence"
	>
	
	<GuidColumn>
		<Name>LicencePK</Name>
		<Caption>License ID</Caption>
	</GuidColumn>

	<StringColumn>
		<Name>EnterpriseCode</Name>
		<Caption>Enterprise Code</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>
	
	<Serialisation>
		<Template>
			<LicencePK>{value:LicencePK}</LicencePK>
			<EnterpriseCode>{value:EnterpriseCode}</EnterpriseCode>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
