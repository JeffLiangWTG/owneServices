<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="BillingUnitCountAdjustment"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<StringColumn>
		<Name>PriceCode</Name>
		<Caption>Usage Code</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

  <DecimalColumn>
    <Name>DefaultAdjustedIncrement</Name>
    <Caption>Subsequent Adjusted Usage Increment</Caption>
    <Precision>14</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <StringColumn>
		<Name>Comment</Name>
		<Caption>Comment</Caption>
		<MaxLength>256</MaxLength>
	</StringColumn>
  
	<Serialisation>
		<Template>
			<PriceCode>{value:PriceCode}</PriceCode>
      <DefaultAdjustedIncrement>{value:DefaultAdjustedIncrement}</DefaultAdjustedIncrement>
      <Comment>{value:Comment}</Comment>
			<AdjustmentSettings>{method:AdjustmentSettings}</AdjustmentSettings>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
