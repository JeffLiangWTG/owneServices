<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="OpportunityValueAnalysisDefault"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->
	
	<StringColumn>
		 <Name>Code</Name>
		 <MaxLength>3</MaxLength>
		 <AllowUnicode>false</AllowUnicode>
	</StringColumn>
	
	 <StringColumn>
		<Name>Description</Name>
		<MaxLength>80</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	 </StringColumn>
	
	<DecimalColumn>
		<Name>ValueInUSD</Name>
		<Precision>9</Precision>
		<Scale>2</Scale>
	</DecimalColumn>

	<Serialisation>
		<Template>
			<Code>{value:Code}</Code>
			<Description>{value:Description}</Description>
			<ValueInUSD>{value:ValueInUSD}</ValueInUSD>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
