<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="StlRawUsageReportRefCaption"
	>

  <!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

  <StringColumn>
    <Name>Category</Name>
    <MaxLength>3</MaxLength>
    <Caption>Category</Caption>
  </StringColumn>
  <StringColumn>
		<Name>UsageCode</Name>
		<MaxLength>3</MaxLength>
		<Caption>Code</Caption>
	</StringColumn>
	<StringColumn>
		<Name>UsageDescription</Name>
		<MaxLength>100</MaxLength>
		<Caption>Description</Caption>
	</StringColumn>
  <StringColumn>
    <Name>Ref1Caption</Name>
    <MaxLength>100</MaxLength>
		<Caption>Ref 1 Caption</Caption>
  </StringColumn>
	<StringColumn>
		<Name>Ref2Caption</Name>
		<MaxLength>100</MaxLength>
		<Caption>Ref 2 Caption</Caption>
	</StringColumn>
	<StringColumn>
		<Name>Ref3Caption</Name>
		<MaxLength>100</MaxLength>
		<Caption>Ref 3 Caption</Caption>
	</StringColumn>
	<StringColumn>
		<Name>Ref4Caption</Name>
		<MaxLength>100</MaxLength>
		<Caption>Ref 4 Caption</Caption>
	</StringColumn>
	<StringColumn>
		<Name>Ref5Caption</Name>
		<MaxLength>100</MaxLength>
		<Caption>Ref 5 Caption</Caption>
	</StringColumn>

  <Serialisation>
    <Template>
      <Category>{value:Category}</Category>
      <UsageCode>{value:UsageCode}</UsageCode>
			<UsageDescription>{value:UsageDescription}</UsageDescription>
			<Ref1Caption>{value:Ref1Caption}</Ref1Caption>
			<Ref2Caption>{value:Ref2Caption}</Ref2Caption>
			<Ref3Caption>{value:Ref3Caption}</Ref3Caption>
			<Ref4Caption>{value:Ref4Caption}</Ref4Caption>
			<Ref5Caption>{value:Ref5Caption}</Ref5Caption>		
		</Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>
