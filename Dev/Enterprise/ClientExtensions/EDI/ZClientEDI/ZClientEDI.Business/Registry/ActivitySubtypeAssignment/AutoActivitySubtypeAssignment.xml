<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ActivitySubtypeAssignment"
	>

  <StringColumn>
    <Name>ActivitySubtype</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>Description</Name>
    <MaxLength>255</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>Capitalization</Name>
  </BoolColumn>  

  <Serialisation>
    <Template>
      <ActivitySubtype>{value:ActivitySubtype}</ActivitySubtype>
      <Description>{value:Description}</Description>
      <Capitalization>{value:Capitalization}</Capitalization>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>

