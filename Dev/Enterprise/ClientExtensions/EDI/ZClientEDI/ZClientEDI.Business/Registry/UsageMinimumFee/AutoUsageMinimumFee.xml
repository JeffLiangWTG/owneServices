<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="UsageMinimumFee">
  <StringColumn>
    <Name>ProductCode</Name>
    <Caption>Product Code</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>PriceListCode</Name>
    <Caption>Price List Code</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>MinimumFeeCode</Name>
    <Caption>Minimum Fee Code</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <Serialisation>
    <Template>
      <ProductCode>{value:ProductCode}</ProductCode>
      <PriceListCode>{value:PriceListCode}</PriceListCode>
      <MinimumFeeCode>{value:MinimumFeeCode}</MinimumFeeCode>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>