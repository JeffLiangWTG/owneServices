<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="SystemProduct"
	>
	<StringColumn>
		<Name>Description</Name>
		<MaxLength>100</MaxLength>
	</StringColumn>
  <StringColumn>
    <Name>Code</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>
  <BoolColumn>
    <Name>Enabled</Name>
  </BoolColumn>
	<BoolColumn>
		<Name>IsInternal</Name>
	</BoolColumn>
	<Serialisation>
		<Template>
			<Code>{value:Code}</Code>
			<Description>{value:Description}</Description>
      <Enabled>{value?:Enabled}</Enabled>
			<IsInternal>{value?:IsInternal}</IsInternal>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
