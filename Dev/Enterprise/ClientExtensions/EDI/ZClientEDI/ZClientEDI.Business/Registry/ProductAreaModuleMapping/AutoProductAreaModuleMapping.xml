<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ProductAreaModuleMapping"
	>
	<StringColumn>
		<Name>ModuleCode</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>ModuleDescription</Name>
		<MaxLength>100</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>ProductArea</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	<BoolColumn>
		<Name>IsInternal</Name>
	</BoolColumn>
	<BoolColumn>
		<Name>IsEnabled</Name>
	</BoolColumn>
	<Serialisation>
		<Template>
			<ModuleCode>{value:ModuleCode}</ModuleCode>
			<ModuleDescription>{value:ModuleDescription}</ModuleDescription>
			<ProductArea>{value:ProductArea}</ProductArea>
			<IsInternal>{value:IsInternal}</IsInternal>
			<IsEnabled>{value:IsEnabled}</IsEnabled>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
