<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="UsageBillingPriceList"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<StringColumn>
		<Name>ProductCode</Name>
		<Caption>Product Code</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

  <StringColumn>
    <Name>RawUsageCategory</Name>
    <Caption>Raw Usage Category</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>PriceListCode</Name>
    <Caption>Price List Code</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>Description</Name>
    <Caption>Description</Caption>
    <MaxLength>256</MaxLength>
  </StringColumn>

	<Serialisation>
		<Template>
      <ProductCode>{value:ProductCode}</ProductCode>
      <RawUsageCategory>{value:RawUsageCategory}</RawUsageCategory>
      <PriceListCode>{value:PriceListCode}</PriceListCode>
      <Description>{value:Description}</Description>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
