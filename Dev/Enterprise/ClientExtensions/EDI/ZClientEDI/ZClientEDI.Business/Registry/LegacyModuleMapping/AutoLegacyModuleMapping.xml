<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="LegacyModuleMapping"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->
	
	<StringColumn>
		<Name>Code</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>Description</Name>
		<MaxLength>100</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>CriticalityMapping</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>ModuleMapping</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
  <StringColumn>
    <Name>CountryMapping</Name>
    <MaxLength>2</MaxLength>
  </StringColumn>

	<Serialisation>
		<Template>
			<Code>{value:Code}</Code>
			<Description>{value:Description}</Description>
			<CriticalityMapping>{value:CriticalityMapping}</CriticalityMapping>
			<ModuleMapping>{value:ModuleMapping}</ModuleMapping>
      <CountryMapping>{value:CountryMapping}</CountryMapping>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
