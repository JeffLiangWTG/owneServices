<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
        xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
        name="IncidentGroupType">

  <StringColumn>
    <Name>GroupType</Name>
    <MaxLength>3</MaxLength>
    <Caption>Group Type</Caption>
  </StringColumn>

  <StringColumn>
    <Name>Description</Name>
    <Caption>Description</Caption>
    <MaxLength>100</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>IsSystem</Name>
  </BoolColumn>

  <Serialisation>
    <Template>
      <GroupType>{value:GroupType}</GroupType>
      <Description>{value:Description}</Description>
      <IsSystem>{value:IsSystem}</IsSystem>
      <Configurations>{method:Configurations}</Configurations>
  </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>