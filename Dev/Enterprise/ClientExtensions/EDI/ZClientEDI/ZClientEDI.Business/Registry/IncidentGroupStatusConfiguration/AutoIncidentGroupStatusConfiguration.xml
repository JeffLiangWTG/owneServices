<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
        xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
        name="IncidentGroupStatusConfiguration">

  <IntColumn>
    <Name>Sequence</Name>
    <Caption>Sequence</Caption>
    <ShortCaption>Seq.</ShortCaption>
  </IntColumn>

  <StringColumn>
    <Name>Code</Name>
    <Caption>Code</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>DescriptionOnGroup</Name>
    <Caption>Description</Caption>
    <MaxLength>100</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>ApprovalGate</Name>
    <Caption>Approval Gate</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>ControlIncidents</Name>
    <Caption>Control Incidents</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>CascadeCriticality</Name>
    <Caption>Cascade Criticality</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>CascadeProductDetails</Name>
    <Caption>Cascade Product Details</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>GroupCompleted</Name>
    <Caption>Group Completed</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>IncidentCompleted</Name>
    <Caption>Incident Completed</Caption>
  </BoolColumn>

  <StringColumn>
    <Name>TriggerOn</Name>
    <Caption>Trigger On</Caption>
    <MaxLength>100</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>Enabled</Name>
    <Caption>Enabled</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>IsSystem</Name>
  </BoolColumn>

  <BoolColumn>
    <Name>IsReversible</Name>
    <Caption>Reversible</Caption>
  </BoolColumn>

  <Serialisation>
    <Template>
      <Sequence>{value:Sequence}</Sequence>
      <Code>{value:Code}</Code>
      <DescriptionOnGroup>{value:DescriptionOnGroup}</DescriptionOnGroup>
      <ApprovalGate>{value:ApprovalGate}</ApprovalGate>
      <ControlIncidents>{value:ControlIncidents}</ControlIncidents>
      <CascadeCriticality>{value:CascadeCriticality}</CascadeCriticality>
      <CascadeProductDetails>{value:CascadeProductDetails}</CascadeProductDetails>
      <GroupCompleted>{value:GroupCompleted}</GroupCompleted>
      <IncidentCompleted>{value:IncidentCompleted}</IncidentCompleted>
      <TriggerOn>{value:TriggerOn}</TriggerOn>
      <Enabled>{value:Enabled}</Enabled>
      <IsSystem>{value:IsSystem}</IsSystem>
      <IsReversible>{value:IsReversible}</IsReversible>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>