<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="PriceTierLicenceSettingLine"
	validationStyle="ObsoleteValidation"
>
  <IntColumn>
    <Name>UnitBreak</Name>
    <Caption>Unit Break</Caption>
  </IntColumn>

  <DecimalColumn>
    <Name>Price</Name>
    <Precision>19</Precision>
    <Scale>4</Scale>
    <Caption>Price</Caption>
  </DecimalColumn>

  <DecimalColumn>
    <Name>Units</Name>
    <Precision>19</Precision>
    <Scale>4</Scale>
    <Caption>License Units</Caption>
  </DecimalColumn>
  
  <Serialisation>
    <Template>
      <UnitBreak>{value:UnitBreak}</UnitBreak>
      <Price>{value:Price}</Price>
      <Units>{value:Units}</Units>
    </Template>
  </Serialisation>

</NonPersistentBusinessObject>
