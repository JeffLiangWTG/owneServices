<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DomesticDiscount"
	validationStyle="ObsoleteValidation"
>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<BoolColumn>
		<Name>RequiresDevelopingCountry</Name>
	</BoolColumn>
	<IntColumn>
		<Name>MaxForeignUserCount</Name>
	</IntColumn>
	<DecimalColumn>
		<Name>MaxForeignUserPercent</Name>
		<Precision>5</Precision>
		<Scale>2</Scale>
	</DecimalColumn>
	<IntColumn>
		<Name>MaxForeignCompanyCount</Name>
	</IntColumn>
	<DecimalColumn>
		<Name>MultiEntityPercent</Name>
		<Precision>5</Precision>
		<Scale>2</Scale>
	</DecimalColumn>
	<IntColumn>
		<Name>ExpiryMonthCount</Name>
	</IntColumn>

	<Serialisation>
		<Template>
			<RequiresDevelopingCountry>{value:RequiresDevelopingCountry}</RequiresDevelopingCountry>
			<MaxForeignUserCount>{value:MaxForeignUserCount}</MaxForeignUserCount>
			<MaxForeignUserPercent>{value:MaxForeignUserPercent}</MaxForeignUserPercent>
			<MaxForeignCompanyCount>{value:MaxForeignCompanyCount}</MaxForeignCompanyCount>
			<MultiEntityPercent>{value:MultiEntityPercent}</MultiEntityPercent>
			<ExpiryMonthCount>{value:ExpiryMonthCount}</ExpiryMonthCount>
			<Lines>{method:Lines}</Lines>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>
