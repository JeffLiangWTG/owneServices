<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="CountryDiscountLine"
	validationStyle="ObsoleteValidation"
>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<StringColumn>
		<Name>Country</Name>
		<MaxLength>2</MaxLength>
	</StringColumn>
	<DecimalColumn>
		<Name>Percent</Name>
		<Precision>5</Precision>
		<Scale>2</Scale>
	</DecimalColumn>
	<BoolColumn>
		<Name>RequiresDomesticDiscount</Name>
	</BoolColumn>

	<Serialisation>
		<Template>
			<Country>{value:Country}</Country>
			<Percent>{value:Percent}</Percent>
			<RequiresDomesticDiscount>{value:RequiresDomesticDiscount}</RequiresDomesticDiscount>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>
