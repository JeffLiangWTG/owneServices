<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="VolumeDiscountLine"
	validationStyle="ObsoleteValidation"
>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<DecimalColumn>
		<Name>UnitCount</Name>
		<Precision>20</Precision>
		<Scale>0</Scale>
		<Caption>&gt;= Units</Caption>
	</DecimalColumn>
	<DecimalColumn>
		<Name>Percent</Name>
		<Precision>5</Precision>
		<Scale>2</Scale>
		<Caption>%</Caption>
	</DecimalColumn>

	<Serialisation>
		<Template>
			<UnitCount>{value:UnitCount}</UnitCount>
			<Percent>{value:Percent}</Percent>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>
