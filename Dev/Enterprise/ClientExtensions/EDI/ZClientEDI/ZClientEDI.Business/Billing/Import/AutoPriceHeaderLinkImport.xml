<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="PriceHeaderLinkImport"
	validationStyle="ObsoleteValidation">

	<StringColumn>
		<Name>OrgCode</Name>
		<MaxLength>12</MaxLength>
		<Caption>Org. Code</Caption>
	</StringColumn>

	<StringColumn>
		<Name>ServerCode</Name>
		<MaxLength>3</MaxLength>
		<Caption>Server Code</Caption>
	</StringColumn>

	<StringColumn>
		<Name>Currency</Name>
		<MaxLength>3</MaxLength>
		<Caption>Currency Code</Caption>
	</StringColumn>

	<DateTimeColumn>
		<Name>ValidFrom</Name>
		<Caption>Valid From</Caption>
	</DateTimeColumn>

	<DateTimeColumn>
		<Name>ValidTo</Name>
		<Caption>Valid To</Caption>
	</DateTimeColumn>
	
	<StringColumn>
		<Name>PricelistVersion</Name>
		<MaxLength>50</MaxLength>
		<Caption>Price List Version</Caption>
	</StringColumn>

	<StringColumn>
		<Name>Volume</Name>
		<MaxLength>3</MaxLength>
		<Caption>Volume</Caption>
	</StringColumn>
	
	<DecimalColumn>
		<Name>VolumePercent</Name>
		<Precision>5</Precision>
		<Scale>2</Scale>
		<Caption>Volume %</Caption>
	</DecimalColumn>

	<StringColumn>
		<Name>CorePack</Name>
		<MaxLength>3</MaxLength>
		<Caption>Core Pack</Caption>
	</StringColumn>

	<DecimalColumn>
		<Name>CoreUpliftPercent</Name>
		<Precision>5</Precision>
		<Scale>2</Scale>
		<Caption>Core Uplift %</Caption>
	</DecimalColumn>
</NonPersistentBusinessObject>