<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="TriageAssistBusinessObject"
	validationStyle="ObsoleteValidation"
>

  <StringColumn>
    <Name>Product</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>SearchTerm</Name>
    <GenerateValidation>false</GenerateValidation>
    <MaxLength>512</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>SearchTermOperator</Name>
    <MaxLength>20</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>ShowSearchOptions</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Show Search Options</Caption>
  </BoolColumn>

  <StringColumn>
    <Name>CriteriaTypeFilter</Name>
    <MaxLength>20</MaxLength>
    <Caption>Criteria Type</Caption>
  </StringColumn>

  <BoolColumn>
    <Name>ShouldSearchKeywords</Name>
    <Caption>Keywords</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>ShouldSearchDescription</Name>
    <Caption>Description</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>ShouldSearchSuggestedList</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Also search suggested list</Caption>
  </BoolColumn>
  
  <BoolColumn>
    <Name>ShowFocusedObjectsOnly</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Show in focus only</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>ShowFocusedTriageNodesOnly</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Show in focus only</Caption>
  </BoolColumn>
  
  <BoolColumn>
    <Name>ShowFocusedSuggestedCriteriaOnly</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Show in focus only</Caption>
  </BoolColumn>

</NonPersistentBusinessObject>
