<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="SourceModule"
	validationStyle="ObsoleteValidation"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->
	
	<StringColumn>
		<Name>Code</Name>
		<MaxLength>50</MaxLength>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</StringColumn>
	<StringColumn>
		<Name>Description</Name>
		<MaxLength>100</MaxLength>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</StringColumn>
	<StringColumn>
		<Name>Path</Name>
		<MaxLength>50</MaxLength>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</StringColumn>
	<StringColumn>
		<Name>ModuleTypeCode</Name>
		<MaxLength>20</MaxLength>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</StringColumn>
	<StringColumn>
		<Name>DefaultMenuSection</Name>
		<MaxLength>3</MaxLength>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</StringColumn>
	<BoolColumn>
		<Name>IsSelectableForOverride</Name>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</BoolColumn>
	<BoolColumn>
		<Name>IsSearchable</Name>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</BoolColumn>
	<StringColumn>
		<Name>Product</Name>
		<MaxLength>3</MaxLength>
		<DeserialiseIntoField>true</DeserialiseIntoField>
	</StringColumn>

	<Serialisation>
		<Template>
			<Code>{value:Code}</Code>
			<Description>{value:Description}</Description>
			<Path>{value:Path}</Path>
			<ModuleTypeCode>{value?:ModuleTypeCode}</ModuleTypeCode>
			<DefaultMenuSection>{value:DefaultMenuSection}</DefaultMenuSection>
			<IsSelectableForOverride>{value:IsSelectableForOverride}</IsSelectableForOverride>
			<IsSearchable>{value:IsSearchable}</IsSearchable>
			<Product>{value?:Product}</Product>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>
