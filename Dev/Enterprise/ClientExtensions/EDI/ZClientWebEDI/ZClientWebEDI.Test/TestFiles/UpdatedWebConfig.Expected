		</assemblyBinding>
	</runtime>
	<system.webServer>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
			<add name="ScriptResource-Integrated" verb="GET,HEAD" path="ScriptResource.axd" type="System.Web.Handlers.ScriptResourceHandler, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
			<add name="ReportRequestHandler-Integrated" verb="GET" path="ReportRequestHandler.axd" type="Enterprise.Tracking.Web.ReportRequestHandler,Enterprise.Tracking.Web"/>
			<add name="OdplUsageReportRequestHandler-Integrated" verb="GET" path="OdplUsageReportRequestHandler.axd" type="Enterprise.ZClientWebCargoWiseEDI.OdplUsageReportRequestHandler,ZClientWebEDI"/>
			<add name="OdplUsageReportStreamRequestHandler-Integrated" verb="GET" path="OdplUsageReportStreamRequestHandler.axd" type="Enterprise.ZClientWebCargoWiseEDI.OdplUsageCsvReportRequestHandler,ZClientWebEDI"/>
			<add name="StlUsageReportRequestHandler-Integrated" verb="GET" path="StlUsageReportRequestHandler.axd" type="Enterprise.ZClientWebCargoWiseEDI.StlUsageReportRequestHandler,ZClientWebEDI"/>
			<add name="StlUsageReportStreamRequestHandler-Integrated" verb="GET" path="StlUsageReportStreamRequestHandler.axd" type="Enterprise.ZClientWebCargoWiseEDI.StlUsageCsvReportRequestHandler,ZClientWebEDI"/>
			<add name="CourseOutlineRequestHandler-Integrated" verb="GET" path="CourseOutlineRequestHandler.axd" type="Enterprise.ZClientWebCargoWiseEDI.CourseOutlineRequestHandler,ZClientWebEDI"/>
			<add name="InvoiceRequestHandler-Integrated" verb="GET" path="InvoiceRequestHandler.axd" type="Enterprise.ZClientWebCargoWiseEDI.InvoiceRequestHandler,ZClientWebEDI"/>
		</handlers>
		<validation validateIntegratedModeConfiguration="false"/>
	</system.webServer>
</configuration>
