<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Client.FSH</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <None Update="TsManifest\CodeLists\FSHRecordFields.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>FSHRecordFields.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Client.FSH.TsManifest</CustomToolNamespace>
    </None>
    <Content Include="TsManifest\Spec\cgn77s.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
  </ItemGroup>
</Project>