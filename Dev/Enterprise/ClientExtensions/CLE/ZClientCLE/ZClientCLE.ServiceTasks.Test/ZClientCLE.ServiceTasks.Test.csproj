    <Reference Include="CargoWise.Types" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="Enterprise.ClientSharedComponents" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="Enterprise.ServiceManager.Shared" />
    <Reference Include="ServiceManager.Integration.ServiceTasks.CW.Test" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="NUnitCore" />
    <Reference Include="ServiceManager.Integration.Abstractions" />
    <Reference Include="ServiceManager.Integration.ServiceTasks.CW" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data Import\Test files\order-4splits.csv">
      <LogicalName>order-4splits.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Import\Test files\order-exception.csv">
      <LogicalName>order-exception.csv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZClientCLE\ZClientCLE.csproj" />
