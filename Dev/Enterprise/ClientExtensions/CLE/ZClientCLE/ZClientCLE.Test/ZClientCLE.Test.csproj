<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Client.CLE.Testing</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'BatchProcessor|AnyCPU' ">
    <OutputPath>bin\BatchProcessor\</OutputPath>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <EmbeddedResource Include="ContainerDeHireUpload\TestFiles\ContainerDeHireUpload.csv">
      <LogicalName>ContainerDeHireUpload.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Export\MattelARInvoiceExport\TestFiles\AUINV_200612121212_JOBDEC.EDI">
      <LogicalName>AUINV_200612121212_JOBDEC.EDI</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Export\MattelARInvoiceExport\TestFiles\NZINV_200612121212_JOBDEC.EDI">
      <LogicalName>NZINV_200612121212_JOBDEC.EDI</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Import\Test files\order-4splits.csv">
      <LogicalName>order-4splits.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Import\Test files\order-2splits.csv">
      <LogicalName>order-2splits.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Import\Test files\crap.wtf">
      <LogicalName>crap.wtf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data Import\Test files\TwoOrderBothUnmatchedDeliveryPoints.csv">
      <LogicalName>TwoOrderBothUnmatchedDeliveryPoints.csv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZClientCLE\ZClientCLE.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Memory" />
  </ItemGroup>
</Project>