<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      This library should not be multi-targeted since it does not contain tests.
      It is loaded on SqlServer during tests to check that SqlClr tech is working and SqlClr is supporting only net48.
    -->
    <AssemblyName>Enterprise.SqlSecurity.Test.SqlClrAssembly</AssemblyName>
    <TargetFrameworks>net48</TargetFrameworks>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
</Project>