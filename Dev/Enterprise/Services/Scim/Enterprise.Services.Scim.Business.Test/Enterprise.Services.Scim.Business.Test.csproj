<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CWNetCoreTargetFramework);net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AssemblyName>Enterprise.Services.Scim.Business.Test</AssemblyName>
    <ErrorReport>prompt</ErrorReport>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetFx\NetFxCommon.props" Condition="'$(TargetFramework)' == 'net48' And Exists('$(WTGBranchRoot)NetFx\NetFxCommon.props')" />
  <ItemGroup>
    <ProjectReference Include="..\Enterprise.Services.Scim.Business\Enterprise.Services.Scim.Business.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Integration">
      <HintPath>..\..\..\..\Bin\CargoWise.Integration.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.ResourceStrings.Cache">
      <HintPath>..\..\..\..\Bin\CargoWise.ResourceStrings.Cache.dll</HintPath>
    </Reference>
    <Reference Include="Enterprise.Integration">
      <HintPath>..\..\..\..\Bin\Enterprise.Integration.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.Common" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Moq" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="nunit.framework" />
    <Reference Include="NUnitCore" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.IO" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="ServiceManager.Integration.ServiceTasks.CW" />
    <Reference Include="SimpleIdServer.Scim.Domains.WTG" />
    <Reference Include="SimpleIdServer.Scim.Parser.WTG" />
    <Reference Include="SimpleIdServer.Scim.WTG" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Enterprise.Services.Scim.Api\Schemas\*.json" LinkBase="Schemas" />
  </ItemGroup>
  <ItemGroup>
    <None Update="test-ip-ranges.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>