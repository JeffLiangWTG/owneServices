<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputPath>..\..\..\..\bin\</OutputPath>
    <OutputType>Library</OutputType>
    <AssemblyName>Enterprise.Services.Scim.Api</AssemblyName>
    <RootNamespace>Enterprise.Services.Scim.Api</RootNamespace>
    <TransformOnBuild>true</TransformOnBuild>
    <OverwriteReadOnlyOutputFiles>true</OverwriteReadOnlyOutputFiles>
    <TransformOutOfDateOnly>false</TransformOutOfDateOnly>
    <TargetFramework>net48</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RunCommand>$(MSBuildExtensionsPath64)\..\IIS Express\iisexpress</RunCommand>
    <RunArguments>/path:"$(MSBuildProjectDirectory)" /port:57636</RunArguments>
    <NoWarn>$(NoWarn);1701;1702;1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DAT_IS_BUILDING)' != 'true'">
    <PostBuildEvent>if not exist $(MSBuildProjectDirectory)\Bin goto Make
echo found : $(MSBuildProjectDirectory)\Bin
goto end
:Make
echo Making junction from $(MSBuildProjectDirectory)\Bin to $(MSBuildProjectDirectory)\$(OutputPath)
mklink /J $(MSBuildProjectDirectory)\Bin $(MSBuildProjectDirectory)\$(OutputPath)
:end</PostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Schemas\CargoWiseGroupSchema.json" />
    <Content Remove="Schemas\CargoWiseUserSchema.json" />
    <Content Remove="Schemas\GroupSchema.json" />
    <Content Remove="Schemas\UserSchema.json" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Config\Kafka.pem" />
    <None Remove="Error.aspx" />
    <None Remove="Global.asax" />
    <None Remove="default.htm" />
