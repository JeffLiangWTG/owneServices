<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputPath>..\..\..\bin\</OutputPath>
    <CodeAnalysisLogFile>..\..\..\bin\Enterprise.Services.ServiceHost.Tests.dll.CodeAnalysisLog.xml</CodeAnalysisLogFile>
    <CodeAnalysisRuleSetDirectories>;C:\Program Files (x86)\Microsoft Visual Studio 10.0\Team Tools\Static Analysis Tools\\Rule Sets</CodeAnalysisRuleSetDirectories>
    <CodeAnalysisIgnoreBuiltInRuleSets>true</CodeAnalysisIgnoreBuiltInRuleSets>
    <CodeAnalysisRuleDirectories>;C:\Program Files (x86)\Microsoft Visual Studio 10.0\Team Tools\Static Analysis Tools\FxCop\\Rules</CodeAnalysisRuleDirectories>
    <CodeAnalysisIgnoreBuiltInRules>true</CodeAnalysisIgnoreBuiltInRules>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestSchemas\UniversalResponse.xsd">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="..\ServiceHost\Web.config">
      <Link>Web.config</Link>
    </EmbeddedResource>
  </ItemGroup>
  <!--NOTE: If you need to add a new reference, please add it to the TestProject.CommonReferences.props file.-->
  <Import Project="../TestProject.CommonReferences.props" />
  <!--Below section is for .Net Framework references only-->
  <ItemGroup>
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="FluentValidation" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.configuration" />
    <Reference Include="System.Data.Linq" />
    <Reference Include="System.IdentityModel" />
    <Reference Include="System.Web.Http" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization.Formatters.Soap" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceHost\Enterprise.Services.ServiceHost.csproj" />
  </ItemGroup>
</Project>