<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>$(CWNetCoreTargetFramework)</TargetFramework>
    <PublishForWebDeploy>Services</PublishForWebDeploy>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="ServiceHost.Migration.props" />
  <!--NOTE: If you need to add a new reference, please add it to the Project.CommonReferences.props file.-->
  <Import Project="../Project.CommonReferences.props" />
  <!--Below section is for NET Core references only-->
  <ItemGroup>
    <Reference Include="NetCore.WebInfrastructure" />
    <Reference Include="CargoWise.DataProtection.SqlExtensions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="System.Data.SqlClient" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>
