<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ServerName" value="."/>
    <add key="DatabaseName" value="Odyssey"/>
    <add key="StreamingBufferSize" value="65536"/>
    <add key="AuthenticationClockSkew" value="00:00:15"/>

    <add key="owin:AutomaticAppStartup" value="false"/>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="aspnet:RequestQueueLimitPerSession" value="2147483647"/>
  </appSettings>
  <system.web>
    <customErrors mode="On" />
    <hostingEnvironment shadowCopyBinAssemblies="false"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="100000000"/>
    <webServices>
      <protocols>
        <add name="HttpGet"/>
        <add name="HttpPost"/>
      </protocols>
    </webServices>
    <compilation debug="true">
      <assemblies>
        <remove assembly="*"/>
        <add assembly="System.Core, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Xml.Linq, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Data.DataSetExtensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="Enterprise.Services.ServiceHost"/>
      </assemblies>
    </compilation>
    <pages>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI" assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls" assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </controls>
    </pages>
    <httpHandlers>
      <remove verb="*" path="*.asmx"/>
      <add verb="*" path="*.asmx" validate="false" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      <add verb="*" path="*_AppService.axd" validate="false" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      <add verb="GET,HEAD" path="ScriptResource.axd" validate="false" type="System.Web.Handlers.ScriptResourceHandler, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
    </httpHandlers>
    <httpModules>
      <add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
    </httpModules>
  </system.web>
  <system.serviceModel>
    <protocolMapping>
      <add scheme="https" binding="wsHttpBinding" />
    </protocolMapping>
    <behaviors>
      <endpointBehaviors>
        <behavior name="webHttpBehavior">
          <webHttp/>
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="httpBehavior">
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
        <behavior name="Enterprise.Services.ServiceHost.eAdapterStreamedServiceBehavior">
          <serviceCredentials>
            <userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="Enterprise.Services.ServiceHost.eHubUserNamePasswordValidator, Enterprise.Services.ServiceHost, Version=2.0.0.0, Culture=neutral, PublicKeyToken=4f570df270576350"/>
          </serviceCredentials>
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true" externalMetadataLocation="..\eAdapterStreamedService.wsdl"/>
          <serviceDebug includeExceptionDetailInFaults="false"/>
          <authenticationMessageInspectorExtension></authenticationMessageInspectorExtension>
        </behavior>
        <behavior name="EnterpriseBehaviour">
          <serviceCredentials>
            <userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="Enterprise.Services.ServiceHost.EnterpriseUserNamePasswordValidator, Enterprise.Services.ServiceHost, Version=2.0.0.0, Culture=neutral, PublicKeyToken=4f570df270576350"/>
          </serviceCredentials>
          <serviceAuthorization>
            <authorizationPolicies>
              <add policyType="Enterprise.Services.ServiceHost.EnterpriseAuthorizationPolicy, Enterprise.Services.ServiceHost, Version=2.0.0.0, Culture=neutral, PublicKeyToken=4f570df270576350"/>
            </authorizationPolicies>
          </serviceAuthorization>
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
        <behavior name="EnterpriseNoNamePasswordValidationBehavior">
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
        <behavior name="EnterpriseStaffAndContactBehaviour">
          <serviceCredentials>
            <userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="Enterprise.Services.ServiceHost.EnterpriseStaffAndContactValidator, Enterprise.Services.ServiceHost, Version=2.0.0.0, Culture=neutral, PublicKeyToken=4f570df270576350"/>
          </serviceCredentials>
          <serviceAuthorization>
            <authorizationPolicies>
              <add policyType="Enterprise.Services.ServiceHost.EnterpriseStaffAndContactAuthorizationPolicy, Enterprise.Services.ServiceHost, Version=2.0.0.0, Culture=neutral, PublicKeyToken=4f570df270576350"/>
            </authorizationPolicies>
          </serviceAuthorization>
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
        <behavior name="Enterprise.Services.ServiceHost.OrganizationMergeServiceBehavior">
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="false"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <bindings>
      <wsHttpBinding>
        <binding name="securityWsHttpBinding" maxReceivedMessageSize="16384000">
          <security mode="Transport">
            <transport clientCredentialType="None"/>
          </security>
        </binding>
      </wsHttpBinding>
      <webHttpBinding>
        <binding name="webHttpBinding" maxReceivedMessageSize="16384000">
          <readerQuotas maxArrayLength="16384000"/>
        </binding>
      </webHttpBinding>
      <basicHttpBinding>
        <binding name="HttpStreamingService" receiveTimeout="04:00:00" sendTimeout="04:00:00" maxBufferPoolSize="524288000" maxReceivedMessageSize="104857600" transferMode="Streamed">
          <security mode="TransportWithMessageCredential">
            <transport>
              <extendedProtectionPolicy policyEnforcement="Never"/>
            </transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="Enterprise" maxReceivedMessageSize="16384000">
          <security mode="TransportWithMessageCredential">
            <transport>
              <extendedProtectionPolicy policyEnforcement="Never"/>
            </transport>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
        <binding name="EnterpriseTransportSecurityOnly" maxReceivedMessageSize="16384000">
          <security mode="Transport">
            <transport clientCredentialType="None"/>
          </security>
        </binding>
      </basicHttpBinding>
      <mexHttpsBinding>
        <binding name="SecureMex"/>
      </mexHttpsBinding>
    </bindings>
    <services>
      <service behaviorConfiguration="EnterpriseStaffAndContactBehaviour" name="Enterprise.Services.ServiceHost.Security">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="Enterprise" bindingNamespace="http://cargowise.com" contract="Enterprise.Security.ISecurityService"/>
        <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange"/>
      </service>
      <service behaviorConfiguration="EnterpriseStaffAndContactBehaviour" name="Enterprise.Services.ServiceHost.AccountingBilling">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="Enterprise" bindingNamespace="http://cargowise.com" contract="Enterprise.Accounting.Business.JobInvoicing.IAccountingBillingService"/>
        <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange"/>
      </service>
      <service behaviorConfiguration="Enterprise.Services.ServiceHost.eAdapterStreamedServiceBehavior" name="Enterprise.Services.ServiceHost.eAdapterStreamedService">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="HttpStreamingService" contract="CargoWise.eHub.Common.IeAdapterInboundStreamedService"/>
        <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange"/>
      </service>
      <service behaviorConfiguration="Enterprise.Services.ServiceHost.OrganizationMergeServiceBehavior" name="Enterprise.Services.ServiceHost.OrganizationMerge">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="securityWsHttpBinding" contract="Enterprise.Services.ServiceHost.IOrganizationMerge"/>
        <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange"/>
      </service>
      <service behaviorConfiguration="EnterpriseNoNamePasswordValidationBehavior" name="Enterprise.Services.ServiceHost.AcceptabilityBandCalculation">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="EnterpriseTransportSecurityOnly" bindingNamespace="http://cargowise.com" contract="Enterprise.BufferManagement.Service.Shared.IAcceptabilityBandCalculationService"/>
        <!-- We don't need metadata here unless we add or refresh service reference: http://www.synergex.com/blog/2015/06/25/why-is-that-first-wcf-operation-so-slow/ -->
        <!-- Otherwise use mexHttpsBinding instead of mexHttpBinding-->
      </service>
    </services>
    <extensions>
      <behaviorExtensions>
        <add name="errorHandling" type="Enterprise.Services.ServiceHost.eHubErrorHandler, Enterprise.Services.ServiceHost, Version=2.0.0.0, Culture=neutral, PublicKeyToken=4f570df270576350"/>
        <add name="authenticationMessageInspectorExtension" type="Enterprise.Services.ServiceHost.MessageAuthenticationInspectorExtensionElement, Enterprise.Services.ServiceHost"/>
      </behaviorExtensions>
    </extensions>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true"/>
  </system.serviceModel>
  <system.webServer>
    <httpErrors errorMode="Custom" />
    <httpProtocol>
      <customHeaders>
        <remove name="x-powered-by" />
      </customHeaders>
    </httpProtocol>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="ScriptModule"/>
      <!-- Removing WebDAVModule is required for PUT, POST, PATCH, DELETE commands to work -->
      <remove name="WebDAVModule"/>
      <add name="ScriptModule" preCondition="managedHandler" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
    </modules>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648"/>
        <hiddenSegments>
          <add segment="privatekey.xml"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
    <validation validateIntegratedModeConfiguration="false"/>
    <handlers>
      <remove name="WebServiceHandlerFactory-Integrated"/>
      <remove name="ScriptHandlerFactory"/>
      <remove name="ScriptHandlerFactoryAppServices"/>
      <remove name="ScriptResource"/>
      <remove name="NudgeServiceTaskHandler"/>
      <remove name="WiseTechHealthCheckHttpHandler"/>
      <add name="ScriptHandlerFactory" verb="*" path="*.asmx" preCondition="integratedMode" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      <add name="ScriptHandlerFactoryAppServices" verb="*" path="*_AppService.axd" preCondition="integratedMode" type="System.Web.Script.Services.ScriptHandlerFactory, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      <add name="ScriptResource" verb="GET,HEAD" path="ScriptResource.axd" preCondition="integratedMode" type="System.Web.Handlers.ScriptResourceHandler, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      <add name="NudgeServiceTaskHandler" verb="*" path="NudgeServiceTask" type="Enterprise.Services.ServiceHost.NudgeServiceTaskHandler, Enterprise.Services.ServiceHost"/>
      <add name="WiseTechHealthCheckHttpHandler" verb="GET" path="wtg/status" type="Enterprise.Services.ServiceHost.WiseTechHealthCheck.WiseTechHealthCheckHttpHandler, Enterprise.Services.ServiceHost"/>
      <remove name="TraceHandler-Integrated" />
      <remove name="TraceHandler-Integrated-4.0" />
    </handlers>
  </system.webServer>
