<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Enterprise</RootNamespace>
    <AssemblyName>CargoWiseOne</AssemblyName>
    <ApplicationManifest>..\..\..\..\..\main.manifest</ApplicationManifest>
    <OutputPath>..\..\..\..\..\Bin\</OutputPath>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineConstants>NOASSEMBLYINFOVERSION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>NOASSEMBLYINFOVERSION</DefineConstants>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="Enterprise.Upgrades" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Placeholder.Shared\Program.cs">
      <Link>Program.cs</Link>
    </Compile>
    <None Include="..\Placeholder.Shared\app.config">
      <Link>app.config</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\..\ReleaseInfo.xml">
      <Link>ReleaseInfo.xml</Link>
    </EmbeddedResource>
  </ItemGroup>
</Project>