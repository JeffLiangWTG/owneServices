<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AssemblyName>CargoWise.Main</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <SuppressObsoleteWarnings>SYSLIB0014;SYSLIB0051</SuppressObsoleteWarnings>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <None Remove="Navigation\Resources\regionflags.png" />
    <None Remove="Startup\Tasks\SqlServerVersionDiscontinuedSupport.rtf" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Startup\Tasks\SqlServerVersionDiscontinuedSupport.rtf" LogicalName="Enterprise.Startup.Tasks.SqlServerVersionDiscontinuedSupport.rtf" />
    <EmbeddedResource Include="Startup\Tools\JetBrains\license.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' != 'true'">
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Data.HttpClient" />
    <Reference Include="CargoWise.Data.Providers.Common" />
    <Reference Include="CargoWise.DataProtection" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="CargoWise.Main.Navigation" />
    <Reference Include="Enterprise.EConversation.Business" />
    <Reference Include="CargoWise.SystemToSystemTrust" />
    <Reference Include="Enterprise.RemoteDesktopServices.Server" />
    <Reference Include="Enterprise.RemoteDesktopServices.Shared" />
    <Reference Include="Enterprise.DataTransfer" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="Microsoft.IdentityModel.Tokens" />
    <Reference Include="System.IdentityModel.Tokens.Jwt" />
    <Reference Include="CargoWise.Interop" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Resources.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Startup\Tasks\RegisterWinzorUrlHandlerService.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <Reference Include="WinForms.DataVisualization" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Navigation\Resources\regionflags.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Startup\MainForm\DeveloperFeatureControlOverrideForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>