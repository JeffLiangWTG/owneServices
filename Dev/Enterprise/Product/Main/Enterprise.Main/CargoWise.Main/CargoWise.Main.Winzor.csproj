<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CargoWise.Main</AssemblyName>
    <RootNamespace>CargoWise.Main</RootNamespace>
    <EnableWinzorTests>true</EnableWinzorTests>
    <UseLegacyRsa>false</UseLegacyRsa>
    <NoWarn>$(NoWarn);SYSLIB0014;</NoWarn>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Startup\RemoteDesktopServices\**" />
    <Compile Remove="Startup\Tools\NetworkMonitor\**" />
    <EmbeddedResource Remove="Startup\RemoteDesktopServices\**" />
    <EmbeddedResource Remove="Startup\Tools\NetworkMonitor\**" />
    <None Remove="Startup\RemoteDesktopServices\**" />
    <None Remove="Startup\Tools\NetworkMonitor\**" />
    <None Remove="Startup\Tools\JetBrains\license.txt" />
    <EmbeddedResource Include="Startup\Tools\JetBrains\license.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Formats.Asn1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Resources.Extensions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="WTG.Data.SqlClient.Both" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Startup\Tasks\EnableHybridModeStartupTask.cs" />
    <Compile Remove="Startup\Tasks\EnforceWebVersionTask.cs" />
    <Compile Remove="Startup\Tasks\ForceCW1HomeScreenTask.cs" />
    <Compile Remove="Startup\Tasks\StartupADPasswordExpiryChecker.cs" />
    <Compile Remove="Startup\Tasks\StartupDocManagerCommandLineHandler.cs" />
    <Compile Remove="Startup\Tasks\StartupInitEnterpriseUrlHandlerService.cs" />
    <Compile Remove="Testing\TestingMenuBuilder.cs" />
    <Compile Remove="Testing\UserSubmittedTestRunsMenuBuilder.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Blazor.Client.Integration" />
    <Reference Include="CargoWise.SystemToSystemTrust" />
    <Reference Include="Enterprise.DataTransfer" />
    <Reference Include="WinzorFramework" />
    <Reference Include="WinzorFramework.RemoteClientServices" />
    <Reference Include="Enterprise.DataTransfer" />
    <Reference Include="CargoWise.Interop" />
    <Reference Include="CargoWiseNext.Infrastructure.Authentication" />
  </ItemGroup>
</Project>