	<DrawingImage Drawing="{StaticResource down_xaml}" x:Key="di_down_xaml"/>
	<Style x:Key="CancelButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="70"/>
		<Setter Property="Margin" Value="3,0,3,3"/>
		<Setter Property="FontSize" Value="14"></Setter>
		<Setter Property="FontWeight" Value="Bold"></Setter>
		<Setter Property="Foreground" Value="Black"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<ui:MultilingualTextLabel IsTranslatable="False" HorizontalAlignment="Center" VerticalAlignment="Center">
						<ContentPresenter Content="{TemplateBinding Content}"></ContentPresenter>
					</ui:MultilingualTextLabel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Cursor" Value="Hand"></Setter>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEditing}" Value="false">
				<Setter Property="Visibility" Value="Collapsed"></Setter>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="EditButtonStyle" TargetType="Button">
		<Setter Property="Margin" Value="3,0,3,3"/>
		<Setter Property="Content" Value="{Binding EditText}"></Setter>
		<Setter Property="FontSize" Value="14"></Setter>
		<Setter Property="FontWeight" Value="Medium"></Setter>
		<Setter Property="Foreground" Value="#30302e"></Setter>
		<Setter Property="HorizontalAlignment" Value="Center"></Setter>
		<Setter Property="VerticalAlignment" Value="Top"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border BorderThickness="1" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" Background="White" Padding="6">
						<ui:MultilingualTextLabel IsTranslatable="False" Width="{TemplateBinding Width}" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}">
							<ContentPresenter></ContentPresenter>
						</ui:MultilingualTextLabel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Cursor" Value="Hand"></Setter>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEditing}" Value="true">
				<Setter Property="Visibility" Value="Collapsed"></Setter>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="SaveChangesButtonStyle" TargetType="Button">
		<Setter Property="Visibility" Value="Collapsed"></Setter>
		<Setter Property="Margin" Value="3,0,0,3"/>
		<Setter Property="FontSize" Value="14"></Setter>
		<Setter Property="FontWeight" Value="Medium"></Setter>
		<Setter Property="Foreground" Value="White"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Padding="6" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{StaticResource MenuBackgroundColorBrush}" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
						<ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEditing}" Value="true">
				<Setter Property="Visibility" Value="Visible"></Setter>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="AddSnapshotButtonStyle" TargetType="Button">
		<Setter Property="Margin" Value="0,5,0,0"/>
		<Setter Property="Foreground" Value="#30302e"/>
		<Setter Property="HorizontalAlignment" Value="Left"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Padding="6" CornerRadius="5" BorderThickness="1" BorderBrush="Black">
						<StackPanel Orientation="Horizontal">
							<Image Height="10"  Source="{StaticResource di_add_xaml}"/>
							<ui:MultilingualTextLabel IsTranslatable="False">
								<TextBlock Margin="10,0,0,0" Text="{Binding AddText}" FontSize="14" FontWeight="Medium"/>
							</ui:MultilingualTextLabel>
							<StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
								<Image Height="4" Source="{StaticResource di_up_xaml}"></Image>
								<Image Height="4" Margin="0,1,0,0" Source="{StaticResource di_down_xaml}"></Image>
							</StackPanel>
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="EmptyContainerStyle" TargetType="StackPanel">
		<Setter Property="Margin" Value="5"/>
		<Setter Property="Orientation" Value="Horizontal"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEmpty}" Value="true">
				<Setter Property="Visibility" Value="Visible"></Setter>
			</DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEmpty}" Value="false">
				<Setter Property="Visibility" Value="Collapsed"></Setter>
			</DataTrigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="SnapshotRectangleStyle" TargetType="Rectangle">
		<Setter Property="Stroke" Value="Black"/>
		<Setter Property="StrokeThickness" Value="0.8"/>
		<Setter Property="RadiusX" Value="10"/>
		<Setter Property="RadiusY" Value="10"/>
		<Setter Property="StrokeDashArray" Value="3 3"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEmpty}" Value="true">
				<Setter Property="Visibility" Value="Visible"></Setter>
			</DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEmpty}" Value="false">
				<Setter Property="Visibility" Value="Collapsed"></Setter>
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SnapshotsPanelStyle" TargetType="Border">
		<Setter Property="Height" Value="170" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEmpty}" Value="true">
				<Setter Property="Visibility" Value="Collapsed" />
			</DataTrigger>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=IsEmpty}" Value="false">
				<Setter Property="Visibility" Value="Visible" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<DataTemplate x:Key="AddSnapshotCardTemplate">
		<Border CornerRadius="8"
				Background="Transparent"
				SnapsToDevicePixels="True">
			<Border.Resources>
				<Style TargetType="Rectangle">
					<Setter Property="Stroke"
							Value="{StaticResource BorderBrush}" />
					<Setter Property="RadiusX"
							Value="8" />
					<Setter Property="RadiusY"
							Value="8" />
					<Setter Property="StrokeThickness"
							Value="1" />
					<Setter Property="StrokeDashArray"
							Value="8 8" />
					<Setter Property="StrokeDashCap"
							Value="Round" />
					<Setter Property="Margin"
							Value="0" />
					<Setter Property="SnapsToDevicePixels"
							Value="True" />
					<Setter Property="HorizontalAlignment"
							Value="Stretch" />
				</Style>
				<Style TargetType="Button">
					<Setter Property="Margin"
							Value="0,5,0,0" />
					<Setter Property="HorizontalAlignment"
							Value="Center" />
					<Setter Property="VerticalAlignment"
							Value="Center" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="Button">
								<Border Padding="6 4"
										CornerRadius="5"
										BorderThickness="1"
										BorderBrush="#6B6B6859"
										Background="{StaticResource AddSnapshotButtonBackgroundBrush}">
									<StackPanel Orientation="Horizontal">
										<Image Height="10"
											   Source="{StaticResource di_add_xaml}" />
										<ui:MultilingualTextLabel IsTranslatable="False">
											<TextBlock Margin="10,0,0,0"
													   Text="{Binding DataContext.AddText, RelativeSource={RelativeSource AncestorType=UserControl}}"
													   Foreground="{StaticResource AddSnapshotButtonForeBrush}"
													   FontSize="14"
													   FontWeight="Medium" />
										</ui:MultilingualTextLabel>
										<StackPanel VerticalAlignment="Center"
													Margin="8,0,0,0">
											<Image Height="4"
												   Source="{StaticResource di_up_xaml}" />
											<Image Height="4"
												   Margin="0,1,0,0"
												   Source="{StaticResource di_down_xaml}" />
										</StackPanel>
									</StackPanel>
								</Border>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Border.Resources>
			<Grid>
				<Rectangle />
				<Button Command="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=AddSnapshotCommand}" />
			</Grid>
		</Border>
	</DataTemplate>
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="..\NextHomeResources.xaml" />
	</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
