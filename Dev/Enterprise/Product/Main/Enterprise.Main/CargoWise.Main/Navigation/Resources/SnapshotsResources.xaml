				<PathGeometry Figures="M 440 -440 H 200 v -80 h 240 v -240 h 80 v 240 h 240 v 80 H 520 v 240 h -80 v -240 Z" FillRule="Nonzero"/>
			</GeometryDrawing.Geometry>
		</GeometryDrawing>
	</DrawingGroup>
	<DrawingImage Drawing="{StaticResource add_xaml}" x:Key="di_add_xaml"/>
	<DrawingGroup x:Key="up_xaml">
		<DrawingGroup.ClipGeometry>
			<RectangleGeometry Rect="0.0,-960.0,960.0,960.0"/>
		</DrawingGroup.ClipGeometry>
		<GeometryDrawing Brush="#ff1f1f1f">
			<GeometryDrawing.Geometry>
				<PathGeometry Figures="m 280 -400 l 200 -200 l 200 200 H 280 Z" FillRule="Nonzero"/>
			</GeometryDrawing.Geometry>
		</GeometryDrawing>
	</DrawingGroup>
	<DrawingImage Drawing="{StaticResource up_xaml}" x:Key="di_up_xaml"/>
	<DrawingGroup x:Key="down_xaml">
		<DrawingGroup.ClipGeometry>
			<RectangleGeometry Rect="0.0,-960.0,960.0,960.0"/>
		</DrawingGroup.ClipGeometry>
		<DrawingGroup Transform="1.0,0.0,0.0,1.0,-8.9330583,-15.044112">
			<GeometryDrawing Brush="#ff1f1f1f">
				<GeometryDrawing.Geometry>
					<PathGeometry Figures="M 480 -360 L 280 -560 h 400 z" FillRule="Nonzero"/>
				</GeometryDrawing.Geometry>
			</GeometryDrawing>
		</DrawingGroup>
