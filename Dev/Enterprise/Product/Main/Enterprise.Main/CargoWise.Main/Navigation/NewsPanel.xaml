<UserControl x:Class="CargoWise.Main.Navigation.NewsPanel"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:CargoWise.Main.Navigation"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:ui="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
			 mc:Ignorable="d"
			 d:DesignHeight="400"
			 d:DesignWidth="400"
			 d:DataContext="{d:DesignInstance Type=local:NewsViewModel, IsDesignTimeCreatable=True}">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="NextHomeResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style TargetType="Button"
				   x:Key="LightButtonStyle">
				<Setter Property="BorderThickness"
						Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border CornerRadius="2"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="0.5">
								<ContentPresenter x:Name="contentPresenter"
												  ContentTemplate="{TemplateBinding ContentTemplate}"
												  Content="{TemplateBinding Content}"
												  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
												  Margin="{TemplateBinding Padding}"
												  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Setter Property="BorderBrush"
						Value="Transparent" />
				<Setter Property="Background"
						Value="Transparent" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Border Style="{StaticResource PanelBorderStyle}"
			Margin="8,8,2,0"
			Padding="16">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Border Grid.Row="0"
					Background="{StaticResource NeutralBackgroundBrush}"
					Padding="2"
					CornerRadius="2">
				<ItemsControl ItemsSource="{Binding Sections}"
							  BorderThickness="0"
							  Background="Transparent">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Rows="1"
										 Columns="{Binding Items.Count, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid ToolTipService.ToolTip="{Binding SectionName}">
								<Button x:Name="TitleButton"
										Style="{StaticResource  LightButtonStyle}"
										Padding="6, 5"
										FontSize="12"
										Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
										CommandParameter="{Binding}">
									<TextBlock Text="{Binding SectionName}"
											   TextTrimming="CharacterEllipsis" />
								</Button>
							</Grid>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding IsSelected}"
											 Value="True">
									<Setter TargetName="TitleButton"
											Property="Background"
											Value="White" />
									<Setter TargetName="TitleButton"
											Property="FontWeight"
											Value="SemiBold" />
									<Setter TargetName="TitleButton"
											Property="BorderBrush"
											Value="{StaticResource DetailsBorderBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
			<ScrollViewer Grid.Row="1"
						  Margin="0, 5, 0, 0"
						  Padding="2, 4"
						  Style="{StaticResource DefaultScrollViewerStyle}">
				<ScrollViewer.Resources>
					<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
				</ScrollViewer.Resources>
				<ItemsControl Margin="2, 0"
							  BorderThickness="0"
							  ItemsSource="{Binding FilteredNewsItems}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border BorderBrush="{StaticResource SectionDividerBrush}"
									BorderThickness="0,0,0,0.5"
									Padding="0, 4"
									Margin="0, 0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="16" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0"
												VerticalAlignment="Top">
										<ui:MultilingualTextLabel IsTranslatable="False">
											<TextBlock Text="{Binding ReleaseDateAsText}"
													   Foreground="{StaticResource DefaultTextBrush}"
													   FontSize="10px" />
										</ui:MultilingualTextLabel>

										<ui:MultilingualTextLabel IsTranslatable="False">
											<TextBlock FontSize="13px"
													   FontWeight="Normal"
													   TextWrapping="Wrap"
													   Margin="0, 3">
							<Hyperlink TextDecorations="None"
												Foreground="{StaticResource HyperlinkTextBrush}"
												Command="{Binding DataContext.ShowItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
								<ui:MultilingualTextLabel IsTranslatable="False">
									<TextBlock Text="{Binding Summary}"
														FontWeight="Normal"
														TextWrapping="Wrap" />
								</ui:MultilingualTextLabel>
							</Hyperlink>
						</TextBlock>
										</ui:MultilingualTextLabel>
									</StackPanel>
									<Grid Grid.Column="1" />
									<Border Grid.Column="2"
											Width="120"
											Height="75"
											CornerRadius="4"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Visibility="{Binding ThumbnailVisibility}">
										<Border.Background>
											<ImageBrush ImageSource="{Binding ThumbnailBitmap}"
														Stretch="Fill" />
										</Border.Background>
									</Border>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
			<Border x:Name="NoNewsToShow"
					Grid.RowSpan="2"
					Visibility="{Binding NoNewsPanelVisibility, FallbackValue=Hidden}"
					IsVisibleChanged="NoNewsToShow_IsVisibleChanged">
			</Border>
		</Grid>
	</Border>
</UserControl>
