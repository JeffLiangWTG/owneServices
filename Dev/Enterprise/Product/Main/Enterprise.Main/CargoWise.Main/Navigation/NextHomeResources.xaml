							Value="Normal" />
					<Setter Property="TextElement.FontWeight"
							Value="SemiBold" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Status}"
									 Value="SUS">
							<Setter Property="BorderBrush"
									Value="{StaticResource TasksSuspendedBorderBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Status}"
									 Value="WRK">
							<Setter Property="BorderBrush"
									Value="{StaticResource TasksWorkingBorderBrush}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<StackPanel Orientation="Horizontal">
				<Image Width="24"
					   Height="24"
					   VerticalAlignment="Center">
					<Image.Style>
						<Style TargetType="Image">
							<Setter Property="Source"
									Value="{x:Null}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Status}"
											 Value="SUS">
									<Setter Property="Source"
											Value="{StaticResource SuspendedIconImage}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Status}"
											 Value="WRK">
									<Setter Property="Source"
											Value="{StaticResource WorkingIconImage}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Image.Style>
				</Image>
			</StackPanel>
		</Border>
	</DataTemplate>

