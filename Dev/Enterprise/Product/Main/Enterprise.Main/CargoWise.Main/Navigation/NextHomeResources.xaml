										Value="{StaticResource FavoritesItemTemplate}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsCompressedView}"
												 Value="True">
										<Setter Property="ItemTemplate"
												Value="{StaticResource FavoritesItemTemplateCompressed}" />
