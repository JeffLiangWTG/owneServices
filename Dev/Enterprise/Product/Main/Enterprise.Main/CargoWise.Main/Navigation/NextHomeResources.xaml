					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<ui:MultilingualTextLabel IsTranslatable="False">
					<TextBlock Text="·"
							   Style="{StaticResource DescriptionSeparatorStyle}"
							   Visibility="{Binding AreBothParentIDandSummarySet, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}" />
				</ui:MultilingualTextLabel>
				<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
										  MultilingualText="{Binding ParentSummary}"
										  Grid.Column="1">
					<TextBlock Style="{StaticResource TaskParentDescriptionStyle}"
							   TextTrimming="CharacterEllipsis"/>
				</ui:MultilingualTextLabel>
				<Grid.Visibility>
					<MultiBinding Converter="{StaticResource EqualityToCollapsedConverter}">
						<Binding Path="ParentId" />
						<Binding Path="ParentSummary" />
					</MultiBinding>
				</Grid.Visibility>
				<Grid.ToolTip>
					<TextBlock Text="{Binding ParentSummary}" />
				</Grid.ToolTip>
			</Grid>
		</ui:MultilingualTextLabel>
