	<!-- #region Styles -->
	<Style x:Key="FavoritesTextStyle">
		<Setter Property="TextBlock.Foreground"
				Value="{StaticResource HyperlinkTextBrush}" />
		<Setter Property="TextBlock.TextDecorations"
				Value="{x:Null}" />
		<Setter Property="TextBlock.FontSize"
				Value="13px" />
		<Setter Property="TextBlock.FontWeight"
				Value="Normal" />
	</Style>

	<Style x:Key="MainMenuItemStyle">
		<Setter Property="TextBlock.Foreground"
				Value="{StaticResource HyperlinkTextBrush}" />
		<Setter Property="TextBlock.TextDecorations"
				Value="{x:Null}" />
		<Setter Property="TextBlock.FontSize"
				Value="13px" />
		<Setter Property="TextBlock.FontWeight"
				Value="Normal" />
		<Style.Triggers>
			<Trigger Property="FrameworkElement.IsMouseOver"
					 Value="True">
				<Setter Property="TextBlock.TextDecorations"
						Value="Underline" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="EmptySectionStyle"
		   TargetType="TextBlock">
		<Setter Property="Visibility"
				Value="Hidden" />
		<Setter Property="Padding"
				Value="4" />
		<Setter Property="FontSize"
				Value="13px" />
		<Setter Property="FontWeight"
				Value="Regular" />
		<Setter Property="LineHeight"
				Value="20px" />
		<Setter Property="Foreground"
				Value="{StaticResource NoModulesTextBrush}" />
	</Style>

	<Style x:Key="FavoritesHeaderStyle"
		   TargetType="{x:Type TextBlock}">
		<Setter Property="FontSize"
				Value="13px" />
		<Setter Property="FontFamily"
				Value="Inter" />
		<Setter Property="FontWeight"
				Value="DemiBold" />
		<Setter Property="LineHeight"
				Value="20px" />
		<Setter Property="Foreground"
				Value="{StaticResource FavoriteHeaderTextBrush}" />
	</Style>

	<Style x:Key="NoResultsText"
		   TargetType="TextBlock">
		<Setter Property="FontSize"
				Value="16px" />
		<Setter Property="FontWeight"
				Value="Bold" />
		<Setter Property="HorizontalAlignment"
				Value="Center" />
		<Setter Property="Foreground"
				Value="{StaticResource EmptyResultsText}" />
	</Style>

	<Style x:Key="TryAnotherSearchTermText"
		   TargetType="TextBlock">
		<Setter Property="FontSize"
				Value="14px" />
		<Setter Property="HorizontalAlignment"
				Value="Center" />
		<Setter Property="Margin"
				Value="0 5 0 0" />
		<Setter Property="Foreground"
				Value="{StaticResource TryAnotherSearchText}" />
	</Style>

	<Style x:Key="FavouritesListBoxItemStyle"
		   TargetType="ListBoxItem">
		<Setter Property="SnapsToDevicePixels"
				Value="true" />
		<Setter Property="OverridesDefaultStyle"
				Value="true" />
		<Setter Property="nav:ListBoxExtension.ParentListBox"
				Value="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneTime}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBoxItem">
					<ContentPresenter />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FavouritesListBoxStyle"
		   TargetType="{x:Type ListBox}">
		<Setter Property="SnapsToDevicePixels"
				Value="true" />
		<Setter Property="OverridesDefaultStyle"
				Value="true" />
		<Setter Property="MinWidth"
				Value="304" />
		<Setter Property="Margin"
				Value="0" />
		<Setter Property="Padding"
				Value="8" />
		<Setter Property="FocusVisualStyle"
				Value="{x:Null}" />
		<Setter Property="ItemContainerStyle"
				Value="{StaticResource FavouritesListBoxItemStyle}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBox">
					<Grid IsItemsHost="True"
						  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}">
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FavoritesShortcutIndexTextStyle"
		   TargetType="{x:Type TextBlock}">
		<Setter Property="FontSize"
				Value="10px" />
		<Setter Property="FontWeight"
				Value="Normal" />
		<Setter Property="LineHeight"
				Value="10px" />
		<Setter Property="FontFamily"
				Value="Inter" />
		<Setter Property="Foreground"
				Value="{StaticResource NeutralTextDefaultBrush}" />
	</Style>

	<Style x:Key="FooterGridStyle"
		   TargetType="{x:Type Grid}">
		<Setter Property="Height"
				Value="52" />
		<Setter Property="Background"
				Value="Transparent" />
		<Style.Resources>
			<Style TargetType="{x:Type Border}">
				<Setter Property="Margin"
						Value="16 12" />
				<Setter Property="Padding"
						Value="8 4" />
				<Setter Property="VerticalAlignment"
						Value="Center" />
				<Setter Property="Width"
						Value="Auto" />
			</Style>
			<Style TargetType="{x:Type Image}">
				<Setter Property="HorizontalAlignment"
						Value="Right" />
				<Setter Property="Margin"
						Value="16" />
				<Setter Property="Source"
						Value="{StaticResource CWNextWordmarkDrawingImage}" />
				<Setter Property="Stretch"
						Value="Uniform" />
				<Setter Property="VerticalAlignment"
						Value="Center" />
			</Style>
		</Style.Resources>
	</Style>

	<Style x:Key="FooterPanelStyle"
		   TargetType="{x:Type StackPanel}">
		<Setter Property="Orientation"
				Value="Horizontal" />
		<Setter Property="VerticalAlignment"
				Value="Center" />
