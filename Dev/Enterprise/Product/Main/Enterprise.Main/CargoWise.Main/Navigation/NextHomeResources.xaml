						<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
					</ScrollViewer.Resources>
					<ItemsControl Grid.Row="1"
								  ItemsSource="{Binding Items}">
						<ItemsControl.Style>
							<Style TargetType="ItemsControl">
