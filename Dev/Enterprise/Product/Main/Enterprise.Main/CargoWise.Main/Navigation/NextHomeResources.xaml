	<DataTemplate x:Key="TasksStatusTemplate">
		<Border HorizontalAlignment="Left">
			<Border.Style>
				<Style TargetType="Border">
					<Setter Property="BorderThickness"
							Value="1" />
					<Setter Property="CornerRadius"
							Value="4" />
					<Setter Property="Height"
							Value="20" />
					<Setter Property="Padding"
							Value="5 2" />
					<Setter Property="VerticalAlignment"
							Value="Center" />
					<Setter Property="TextElement.FontSize"
							Value="12px" />
					<Setter Property="TextElement.FontStyle"
							Value="Normal" />
					<Setter Property="TextElement.FontWeight"
							Value="SemiBold" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Status}"
									 Value="SUS">
							<Setter Property="BorderBrush"
									Value="{StaticResource TasksSuspendedBorderBrush}" />
							<Setter Property="Background"
									Value="{StaticResource TasksSuspendedBackgroundBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Status}"
									 Value="WRK">
							<Setter Property="BorderBrush"
									Value="{StaticResource TasksWorkingBorderBrush}" />
							<Setter Property="Background"
									Value="{StaticResource TasksWorkingBackgroundBrush}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<StackPanel Orientation="Horizontal">
				<Image Width="10"
					   Height="10"
					   VerticalAlignment="Center">
					<Image.Style>
						<Style TargetType="Image">
							<Setter Property="Visibility"
									Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Status}"
											 Value="SUS">
									<Setter Property="Source"
											Value="{StaticResource SuspendedIconImage}" />
									<Setter Property="Visibility"
											Value="Visible" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Status}"
											 Value="WRK">
									<Setter Property="Source"
											Value="{StaticResource WorkingIconImage}" />
									<Setter Property="Visibility"
											Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Image.Style>
				</Image>
				<TextBlock Text="{Binding StatusText}"
						   Margin="5,0,0,0"
						   Padding="0 0 1 2"
						   VerticalAlignment="Center">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility"
									Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Status}"
											 Value="SUS">
									<Setter Property="Foreground"
											Value="{StaticResource TasksSuspendedForeBrush}" />
									<Setter Property="Visibility"
											Value="visible" />
								</DataTrigger>
								<DataTrigger Binding="{Binding Status}"
											 Value="WRK">
									<Setter Property="Foreground"
											Value="{StaticResource TasksWorkingForeBrush}" />
									<Setter Property="Visibility"
											Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="MyTasksTitleTemplateCompact">
