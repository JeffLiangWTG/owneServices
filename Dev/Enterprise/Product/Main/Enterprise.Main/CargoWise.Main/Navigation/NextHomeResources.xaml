		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="FavoriteContentTemplate">
		<StackPanel>
			<TextBlock Style="{StaticResource WorkItemNumberStyle}"
					   Text="{Binding ID}"
					   x:Name="WINumber" />
			<ui:MultilingualTextLabel IsTranslatable="False">
				<Grid Background="Transparent"
					  Style="{StaticResource FavoritesTextStyle}">
					<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
											  MultilingualText="{Binding MultilingualText}">
						<TextBlock TextTrimming="CharacterEllipsis"
								   Text="{Binding Name}" />
					</ui:MultilingualTextLabel>
				</Grid>
			</ui:MultilingualTextLabel>
		</StackPanel>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding ID}"
						 Value="{x:Null}">
				<Setter TargetName="WINumber"
						Property="Visibility"
						Value="Collapsed" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="MenuCategoryTemplate">
		<StackPanel>
			<Border Name="Border"
					Padding="5,10"
					Margin="0"
					SnapsToDevicePixels="True"
					HorizontalAlignment="Center">
				<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
										  MultilingualText="{Binding MultilingualText}">
					<TextBlock Name="Name"
							   Style="{StaticResource MenuCategoryNameStyle}"
							   TextWrapping="NoWrap"
							   TextTrimming="CharacterEllipsis"
							   Margin="0 0 0 0" />
				</ui:MultilingualTextLabel>
			</Border>
			<StackPanel.ToolTip>
				<ToolTip Name="ToolTip"
						 Placement="Bottom"
						 BorderThickness="0"
						 Padding="1 3 1 3"
						 HorizontalContentAlignment="Center"
						 Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}"
						 Background="{StaticResource ShortcutIndexBorderBrush}">
					<StackPanel Orientation="Horizontal">
						<ui:MultilingualTextLabel IsTranslatable="False">
							<TextBlock Text="Ctrl+"
									   Style="{StaticResource ShortcutIndexTextStyle}"
									   Foreground="{StaticResource ShortCutTextBrush}" />
						</ui:MultilingualTextLabel>
						<ui:MultilingualTextLabel IsTranslatable="False">
							<TextBlock Text="{Binding ShortcutIndex}"
									   Style="{StaticResource ShortcutIndexTextStyle}"
									   Foreground="{StaticResource ShortCutTextBrush}" />
						</ui:MultilingualTextLabel>
					</StackPanel>
				</ToolTip>
			</StackPanel.ToolTip>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="SubMenuItemTemplate">
		<Border Padding="4"
				Name="ItemBorder"
				CornerRadius="4"
				Width="310">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="0" />
				</Grid.ColumnDefinitions>
				<ui:MultilingualTextLabel IsTranslatable="False"
										  Grid.Column="0">
					<Grid Style="{StaticResource MainMenuItemStyle}">
						<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
												  MultilingualText="{Binding MultilingualText}">
							<TextBlock TextTrimming="CharacterEllipsis" />
						</ui:MultilingualTextLabel>
						<Grid.ToolTip>
							<TextBlock Text="{Binding MultilingualText}" />
						</Grid.ToolTip>
					</Grid>
				</ui:MultilingualTextLabel>
				<ui:MultilingualTextLabel IsTranslatable="False"
										  HorizontalAlignment="Right"
										  VerticalAlignment="Center"
										  Name="FavImageBorder"
										  Grid.Column="1">
					<TextBlock>
					<Hyperlink Command="{Binding FavoriteAction}"
							   ToolTip="{Binding AddToFavoriteTooltip}"
							   Style="{StaticResource ItemHyperlinkStyle}">
						<Image Cursor="Hand"
							   Name="Image"
							   SnapsToDevicePixels="True"
							   Visibility="Hidden"
							   Height="14"
							   Source="{StaticResource EmptyStarImage}" />
					</Hyperlink>
					</TextBlock>
				</ui:MultilingualTextLabel>
			</Grid>
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
			</Border.InputBindings>
			<Border.Style>
				<Style TargetType="Border">
					<Setter Property="Background"
							Value="Transparent" />
				</Style>
			</Border.Style>
		</Border>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, ElementName=FavImageBorder}"
						 Value="true">
				<Setter TargetName="Image"
						Property="Source"
						Value="{StaticResource FilledStarImage}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsMouseOver, ElementName=ItemBorder}"
						 Value="true">
				<Setter TargetName="ItemBorder"
						Property="Background"
						Value="{StaticResource ItemsHoverBackgroundBrush}" />
				<Setter TargetName="Image"
						Property="Visibility"
						Value="Visible" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

