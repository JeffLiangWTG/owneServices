		<Setter Property="Width" Value="5" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ScrollBar">
					<Grid Background="Transparent">
						<Track Name="PART_Track" IsDirectionReversed="true" Focusable="false">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" BorderThickness="0" Background="Transparent" Focusable="False">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Background="{TemplateBinding Background}" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Width="5">
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
											<Border x:Name="ThumbBorder" Background="#e5e5e5" CornerRadius="3" Width="5"/>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="ThumbBorder" Property="Background" Value="#b2b2b2"/>
												</Trigger>
												<Trigger Property="IsDragging" Value="True">
													<Setter TargetName="ThumbBorder" Property="Background" Value="#999999"/>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" BorderThickness="0" Background="Transparent" Focusable="False">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border Background="{TemplateBinding Background}" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseRepeatButton>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

