	<!-- Trash icon for delete button -->
	<DrawingGroup x:Key="TrashIcon_xaml">
		<DrawingGroup.ClipGeometry>
			<RectangleGeometry Rect="0,0,24,24" />
		</DrawingGroup.ClipGeometry>
