	<DataTemplate x:Key="SnapshotsCardTemplate">
		<Border Style="{StaticResource SnapshotCardBorderStyle}">
			<Canvas>
				<!-- Content area (fills entire card) -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0"
								VerticalAlignment="Top"
								HorizontalAlignment="Stretch">
						<ui:MultilingualTextLabel IsTranslatable="False">
							<TextBlock Text="{Binding ModuleFilter.ModuleFilterName}"
									   Style="{StaticResource SnapshotCardTitleStyle}" />
						</ui:MultilingualTextLabel>
						<ui:MultilingualTextLabel IsTranslatable="False">
							<TextBlock Text="{Binding ModuleFilter.ModuleName}"
									   Style="{StaticResource SnapshotCardSubTitleStyle}" />
						</ui:MultilingualTextLabel>
						<ui:MultilingualTextLabel IsTranslatable="False">
							<TextBlock Text="{Binding Value}"
									   Style="{StaticResource SnapshotCardValueStyle}" />
						</ui:MultilingualTextLabel>
					</StackPanel>
				</Grid>

				<!-- Arrow button -->
				<Border x:Name="SnapshotsArrowBtn"
						Canvas.Right="5"
						Canvas.Top="5"
						Style="{StaticResource SnapshotArrowBtnStyle}">
					<Border.InputBindings>
						<MouseBinding MouseAction="LeftClick"
									  Command="{Binding DataContext.RunOpenModuleFilterCommand, ElementName=SnapshotsPanel}"
									  CommandParameter="{Binding}" />
					</Border.InputBindings>
					<Image Height="16"
						   Width="16"
						   Source="{StaticResource ArrowRightIconImage}" />
				</Border>

				<!-- Floating edit panel OVERLAY -->
				<Border Background="#181C33"
						Height="30"
						Width="80"
						CornerRadius="8,8,0,0"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						ClipToBounds="True"
						Canvas.Left="30"
						Canvas.Top="73"
						Panel.ZIndex="1">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility"
									Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:SnapshotsControl}}, Path=IsEditing}"
											 Value="True">
									<Setter Property="Visibility"
											Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>

					<UniformGrid Rows="1"
								 Columns="2"
								 Background="Transparent">
						<Button Style="{StaticResource SnapshotEditModeSettingsButtonStyle}">
							<Image Source="{StaticResource GearIconImage}"
								   Width="15"
								   Height="15" />
						</Button>
						<Button Style="{StaticResource SnapshotEditModeDeleteButtonStyle}"
								Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
								CommandParameter="{Binding}">
							<Image Source="{StaticResource TrashIconImage}"
								   Width="15"
								   Height="15" />
						</Button>
					</UniformGrid>
				</Border>
			</Canvas>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="RecentItemsFavoriteIconTemplate">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="0" />
			</Grid.ColumnDefinitions>
			<ui:MultilingualTextLabel Name="ImageBorder"
									  Grid.Column="0"
									  IsTranslatable="False"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Center">
				<TextBlock>
					<Hyperlink Command="{Binding FavoriteAction}"
							   ToolTip="{Binding AddToFavoriteTooltip}"
							   Style="{StaticResource ItemHyperlinkStyle}">
						<Image Name="Image"
							   SnapsToDevicePixels="True"
							   Height="14"
							   Cursor="Hand">
							<Image.Style>
								<Style TargetType="Image">
									<Setter Property="Source"
											Value="{StaticResource EmptyStarImage}" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsInFavorites}"
													 Value="true">
											<Setter Property="Source"
													Value="{StaticResource FilledStarImage}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Image.Style>
						</Image>
					</Hyperlink>
				</TextBlock>
			</ui:MultilingualTextLabel>
		</Grid>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, ElementName=ImageBorder}"
						 Value="true">
				<Setter TargetName="Image"
						Property="Source"
						Value="{StaticResource FilledStarImage}" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="RecentItemsRowTemplate">
		<Border x:Name="RecentItemRowBorder"
				Style="{StaticResource RecentItemsRowStyle}">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
			</Border.InputBindings>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="30" />
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="300*" />
					<ColumnDefinition Width="150" />
				</Grid.ColumnDefinitions>
				<ContentPresenter ContentTemplate="{StaticResource RecentItemsFavoriteIconTemplate}"
								  Content="{Binding}" />
				<ui:MultilingualTextLabel Grid.Column="1"
										  IsTranslatable="False"
										  Margin="0,0,10,0">
					<TextBlock Text="{Binding ID}"
							   TextTrimming="CharacterEllipsis"></TextBlock>
				</ui:MultilingualTextLabel>
				<ContentPresenter Grid.Column="2"
								  ContentTemplate="{StaticResource RecentItemsTitleTemplate}" />
				<ui:MultilingualTextLabel Grid.Column="3"
										  IsTranslatable="False"
										  Margin="10,0,0,0">
					<TextBlock Text="{Binding Module}"
							   TextTrimming="CharacterEllipsis"></TextBlock>
				</ui:MultilingualTextLabel>
			</Grid>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="RecentItemsRowTemplateSmallScreen">
		<Border x:Name="RecentItemRowBorder"
				Style="{StaticResource RecentItemsRowStyleSmallScreen}">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
			</Border.InputBindings>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="100*" />
					<ColumnDefinition Width="30" />
				</Grid.ColumnDefinitions>
				<ContentPresenter Grid.Column="1"
								  ContentTemplate="{StaticResource RecentItemsFavoriteIconTemplate}"
								  Content="{Binding}" />
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<ui:MultilingualTextLabel IsTranslatable="False">
							<TextBlock Text="{Binding ID}"
									   TextTrimming="CharacterEllipsis"
									   TextWrapping="NoWrap"
									   Style="{StaticResource WorkItemNumberStyle}" />
						</ui:MultilingualTextLabel>
						<ui:MultilingualTextLabel IsTranslatable="False"
												  Grid.Column="1">
							<TextBlock Text="·"
									   Style="{StaticResource DescriptionSeparatorStyle}"
									   Visibility="{Binding AreBothIDandModuleSet, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}" />
						</ui:MultilingualTextLabel>
						<ui:MultilingualTextLabel IsTranslatable="False"
												  Grid.Column="2">
							<TextBlock Text="{Binding Module}"
									   TextTrimming="CharacterEllipsis"
									   TextWrapping="NoWrap"
									   Style="{StaticResource TaskParentDescriptionStyle}" />
						</ui:MultilingualTextLabel>
					</Grid>
					<ContentPresenter Grid.Row="1"
									  ContentTemplate="{StaticResource RecentItemsTitleTemplate}"/>
				</Grid>
			</Grid>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="TasksRowTemplate">
		<Border x:Name="TaskRowBorder"
				Style="{StaticResource RecentItemsRowStyle}">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
			</Border.InputBindings>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="100" />
					<ColumnDefinition Width="130*" />
					<ColumnDefinition Width="105*" />
					<ColumnDefinition Width="70*"
									  MinWidth="100" />
				</Grid.ColumnDefinitions>
				<ui:MultilingualTextLabel Grid.Column="0"
										  IsTranslatable="False"
										  Margin="0,0,10,0">
					<TextBlock Text="{Binding ParentId}"
							   TextTrimming="CharacterEllipsis"></TextBlock>
				</ui:MultilingualTextLabel>
				<ContentPresenter Grid.Column="1"
								  ContentTemplate="{StaticResource MyTasksTitleTemplate}"
								  Margin="0,0,10,0" />
				<ui:MultilingualTextLabel Grid.Column="2"
										  IsTranslatable="False">
					<TextBlock Text="{Binding Description}"
							   TextTrimming="CharacterEllipsis"></TextBlock>
				</ui:MultilingualTextLabel>
				<ContentPresenter Grid.Column="3"
								  ContentTemplate="{StaticResource TasksStatusTemplate}"
								  Margin="10,0,0,0" />
			</Grid>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="TasksRowTemplateCompact">
		<Border x:Name="TaskRowBorder"
				Style="{StaticResource TasksRowStyle}">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
			</Border.InputBindings>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto"
									  MinWidth="20" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ui:MultilingualTextLabel IsTranslatable="False"
											  Margin="0,0,0,0">
						<TextBlock Text="{Binding ParentId}" Style="{StaticResource WorkItemNumberStyle}" TextTrimming="CharacterEllipsis">
							<TextBlock.ToolTip>
								<TextBlock Text="{Binding ParentId}" />
							</TextBlock.ToolTip>
						</TextBlock>
					</ui:MultilingualTextLabel>
					<ContentPresenter Grid.Column="1"
									  ContentTemplate="{StaticResource MyTasksTitleTemplateCompact}"
									  Margin="0,0,4,0"/>
				</Grid>
				<ContentPresenter Grid.Column="1" Grid.RowSpan="2" ContentTemplate="{StaticResource TasksStatusTemplateCompact}" Margin="2,0,0,0"/>
				<ui:MultilingualTextLabel Grid.Column="0" Grid.Row="1" IsTranslatable="False">
					<TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis">
						<TextBlock.ToolTip>
							<TextBlock Text="{Binding Description}" />
						</TextBlock.ToolTip>
					</TextBlock>
				</ui:MultilingualTextLabel>
			</Grid>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="RecentMessagesRowTemplate">
		<Border x:Name="RecentMessagesRowBorder"
				Style="{StaticResource RecentMessagesRowStyle}">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding DataContext.OpenJobCommand, ElementName=RecentMessagesPanel}"
							  CommandParameter="{Binding Id}" />
			</Border.InputBindings>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ui:MultilingualTextLabel IsTranslatable="False">
						<TextBlock Text="{Binding SenderName}"
								   FontWeight="DemiBold"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel IsTranslatable="False"
											  Grid.Column="1"
											  Style="{StaticResource RecentMessagesIdStyle}">
						<TextBlock Text="{Binding JobCode}"
								   TextDecorations="Underline"></TextBlock>
					</ui:MultilingualTextLabel>
				</Grid>
				<Grid Grid.Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="auto"
										  MinWidth="80" />
					</Grid.ColumnDefinitions>
					<ui:MultilingualTextLabel IsTranslatable="False"
											  Style="{StaticResource RecentMessagesOrgNameStyle}">
						<TextBlock Text="{Binding SenderCompanyName}"
								   TextTrimming="CharacterEllipsis"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel IsTranslatable="False"
											  Grid.Column="1"
											  HorizontalAlignment="Right"
											  Style="{StaticResource RecentMessagesDetailStyle}">
						<TextBlock Text="{Binding PostedTimeAgo}"></TextBlock>
					</ui:MultilingualTextLabel>
				</Grid>
				<Grid Grid.Row="2">
					<ui:MultilingualTextLabel IsTranslatable="False"
											  Style="{StaticResource RecentMessagesDetailStyle}"
											  Margin="0,2,8,0">
						<TextBlock Text="{Binding Body}"
								   TextWrapping="Wrap"
								   TextTrimming="CharacterEllipsis"
								   MaxHeight="56"></TextBlock>
					</ui:MultilingualTextLabel>
				</Grid>
			</Grid>
		</Border>
	</DataTemplate>

	<CollectionViewSource x:Key="GroupedHolidays"
						  Source="{Binding PublicHolidaysViewModel.PublicHolidays}">
		<CollectionViewSource.GroupDescriptions>
			<PropertyGroupDescription PropertyName="Month" />
		</CollectionViewSource.GroupDescriptions>
	</CollectionViewSource>

	<DataTemplate x:Key="PublicHolidaysRowTemplate">
		<Border Style="{StaticResource RecentMessagesRowStyle}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="78" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition MaxWidth="50" />
				</Grid.ColumnDefinitions>
				<StackPanel Margin="0 0 8 0">
					<ui:MultilingualTextLabel IsTranslatable="False"
											  HorizontalAlignment="Center">
						<TextBlock Text="{Binding Weekday}"
								   FontSize="11"
								   Foreground="{StaticResource DefaultTextBrush}"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel IsTranslatable="False"
											  HorizontalAlignment="Center">
						<TextBlock Text="{Binding Date, StringFormat={}{0:dd}}"
								   FontWeight="700"
								   FontSize="20"></TextBlock>
					</ui:MultilingualTextLabel>
				</StackPanel>
				<Grid Grid.Column="1">
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<ui:MultilingualTextLabel IsTranslatable="False">
						<TextBlock Text="{Binding Description}"
								   FontWeight="Bold"
								   TextWrapping="NoWrap"
								   TextTrimming="CharacterEllipsis"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel IsTranslatable="False" Grid.Row="1">
						<TextBlock Text="{Binding RegionName}"></TextBlock>
					</ui:MultilingualTextLabel>
				</Grid>
				<Grid Grid.Column="2"
					  HorizontalAlignment="Right"
					  Height="40"
					  VerticalAlignment="Center">
					<Border Width="33"
							Height="24"
							VerticalAlignment="Center"
							CornerRadius="4"
							BorderBrush="#BFBEB9"
							BorderThickness="1"
							ClipToBounds="True">
						<Border.Background>
							<ImageBrush Stretch="UniformToFill" ImageSource="{Binding RegionCode, Converter={StaticResource RegionFlagConverter}}" />
						</Border.Background>
					</Border>
				</Grid>
			</Grid>
		</Border>
	</DataTemplate>

	<DataTemplate x:Key="PublicHolidaysGroupHeaderTemplate">
		<ui:MultilingualTextLabel IsTranslatable="False"
								  Style="{StaticResource PublicHolidaysMonthStyle}">
			<TextBlock Text="{Binding Name}"></TextBlock>
		</ui:MultilingualTextLabel>
	</DataTemplate>

	<DataTemplate x:Key="SearchResultFavoriteItemTemplate">
		<Border Name="SearchResultFavouriteItemBorder"
				CornerRadius="4"
				Padding="5 4"
				VerticalAlignment="Center"
				Margin="0 0 3 0"
				Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
				<KeyBinding Key="Enter"
							Command="{Binding LinkAction}" />
			</Border.InputBindings>
			<Grid Name="IndividualItem">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="22" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="20" />
				</Grid.ColumnDefinitions>
				<Image Grid.Column="0"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Center"
					   Margin="2 2"
					   Stretch="Uniform"
					   Height="14"
					   Source="{StaticResource StarFilledDrawingImage}" />
				<ContentPresenter Grid.Column="1"
								  ContentTemplate="{StaticResource MenuItemTitleTemplate}" />
				<Border Grid.Column="2"
						Margin="0 0 0 0"
						Style="{StaticResource SearchShortcutBorderStyle}">
					<Image Height="8"
						   HorizontalAlignment="Left"
						   Stretch="Uniform"
						   VerticalAlignment="Center"
						   Source="{StaticResource ReturnIconDrawingImage}" />
				</Border>
			</Grid>

		</Border>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, ElementName=IndividualItem}"
						 Value="true">
				<Setter TargetName="SearchResultFavouriteItemBorder"
						Property="Background"
						Value="{StaticResource ItemsHoverBackgroundBrush}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsSelected}"
						 Value="True">
				<Setter TargetName="SearchResultFavouriteItemBorder"
						Property="Background"
						Value="{StaticResource ItemsHoverBackgroundBrush}" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="SearchResultRecentItemTemplate">
		<Border Name="SearchResultRecentItemBorder"
				CornerRadius="4"
				Padding="5 4"
				VerticalAlignment="Center"
				Margin="0 0 3 0"
				Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
				<KeyBinding Key="Enter"
							Command="{Binding LinkAction}" />
			</Border.InputBindings>
			<Grid Name="IndividualItem">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="22" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="20" />
				</Grid.ColumnDefinitions>
				<Image Grid.Column="0"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Center"
					   Margin="0 0"
					   Stretch="Uniform"
					   Width="14"
					   Source="{StaticResource HistoryIconDrawingImage}" />
				<ContentPresenter Grid.Column="1"
								  ContentTemplate="{StaticResource MenuItemTitleTemplate}" />
				<Border Grid.Column="2"
						Margin="0 0 0 0"
						Style="{StaticResource SearchShortcutBorderStyle}">
					<Image Height="8"
