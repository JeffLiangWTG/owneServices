				CornerRadius="8"
				Margin="8"
				BorderBrush="{StaticResource BorderBrush}"
				BorderThickness="1"
				Padding="16">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0"
						Margin="0 0 0 4"
						Padding="4 0 4 0"
						CornerRadius="4">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
												  MultilingualText="{Binding MultilingualText}">
							<TextBlock Style="{StaticResource FavoritesHeaderStyle}"
									   Text="{Binding DisplayName}">
							</TextBlock>
						</ui:MultilingualTextLabel>
						<ui:MultilingualTextLabel IsTranslatable="False"
												  Grid.Column="1"
												  HorizontalAlignment="Right"
												  Margin="5,0,0,0">
							<TextBlock>
									<Hyperlink ToolTip="{Binding SwitchViewText}"
											   Command="{Binding SwitchViewAction}"
											   Style="{StaticResource ItemHyperlinkStyle}">
										<Image Cursor="Hand"
											   SnapsToDevicePixels="True"
											   Width="14"
											   Height="14">
											<Image.Style>
												<Style TargetType="Image">
													<Setter Property="Source"
															Value="{StaticResource DensityTightImage}" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsCompressedView}"
																	 Value="True">
															<Setter Property="Source"
																	Value="{StaticResource DensityRelaxedImage}" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Image.Style>
										</Image>
									</Hyperlink>
							</TextBlock>
						</ui:MultilingualTextLabel>
					</Grid>
					<Border.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{Binding RemoveAllLinksText}"
									  Command="{Binding RemoveAllLinksAction}" />
						</ContextMenu>
					</Border.ContextMenu>
				</Border>
				<ui:MultilingualTextLabel Grid.Row="1"
										  IsTranslatable="{Binding IsTranslatable}"
										  MultilingualText="{Binding MultilingualText}">
					<TextBlock Text="{Binding DataContext.MainViewModel.NoFavoritesText, RelativeSource={RelativeSource AncestorType=UserControl}}">
						<TextBlock.Style>
							<Style TargetType="{x:Type TextBlock}"
								   BasedOn="{StaticResource EmptySectionStyle}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding Items.Count}"
												 Value="0">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
