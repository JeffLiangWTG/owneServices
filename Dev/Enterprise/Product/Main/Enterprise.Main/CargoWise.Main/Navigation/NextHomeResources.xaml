	</DataTemplate>

	<DataTemplate x:Key="SearchResultItemTemplate">
		<Border Name="SearchResultItemBorder"
				CornerRadius="4"
				Padding="5 4"
				VerticalAlignment="Center"
				Margin="0 0 3 0"
				Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding LinkAction}" />
				<MouseBinding MouseAction="RightClick"
							  Command="{Binding LinkRightClickAction}" />
				<KeyBinding Key="Enter"
							Command="{Binding LinkAction}" />
			</Border.InputBindings>
			<Grid Name="IndividualItem">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="22" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="20" />
				</Grid.ColumnDefinitions>
				<Image Grid.Column="0"
					   HorizontalAlignment="Left"
					   VerticalAlignment="Center"
					   Margin="2 0"
					   Stretch="Uniform"
					   Height="12"
					   Source="{StaticResource ModuleDrawingImage}" />
				<ContentPresenter Grid.Column="1"
								  ContentTemplate="{StaticResource MenuItemTitleTemplate}" />
				<Border Grid.Column="2"
						Margin="0 0 0 0"
						Style="{StaticResource SearchShortcutBorderStyle}">
					<Image Height="8"
						   HorizontalAlignment="Left"
						   Stretch="Uniform"
						   VerticalAlignment="Center"
						   Source="{StaticResource ReturnIconDrawingImage}" />
				</Border>
			</Grid>
			<behaviors:Interaction.Triggers>
				<behaviors:DataTrigger Binding="{Binding IsSelected}"
									   Value="True">
					<!-- Bring this into view -->
					<behaviors:CallMethodAction MethodName="BringIntoView"
												TargetObject="{Binding ElementName=SearchResultItemBorder}" />
				</behaviors:DataTrigger>
			</behaviors:Interaction.Triggers>
		</Border>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, ElementName=IndividualItem}"
						 Value="true">
				<Setter TargetName="SearchResultItemBorder"
						Property="Background"
						Value="{StaticResource ItemsHoverBackgroundBrush}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsSelected}"
						 Value="True">
				<Setter TargetName="SearchResultItemBorder"
						Property="Background"
						Value="{StaticResource ItemsHoverBackgroundBrush}" />
			</DataTrigger>
		</DataTemplate.Triggers>

	</DataTemplate>

	<DataTemplate x:Key="SearchResultSectionHeaderTemplate">
		<StackPanel Orientation="Horizontal">
			<ui:MultilingualTextLabel Padding="0" IsTranslatable="False">
				<TextBlock Style="{StaticResource SearchResultSectionTitleStyle}" Text="{Binding DisplayName}" />
			</ui:MultilingualTextLabel>
			<ui:MultilingualTextLabel IsTranslatable="False">
				<TextBlock Style="{StaticResource SearchResultSectionTitleStyle}"
						   FontWeight="Normal">
					<Run Text=" (" /><Run Text="{Binding Items.Count, Mode=OneWay}" /><Run Text=")" />
				</TextBlock>
			</ui:MultilingualTextLabel>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="SearchDetailsSectionTemplate">
		<StackPanel Margin="0 0 0 10"
					Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
			<ContentControl Content="{Binding }"
							ContentTemplate="{StaticResource SearchResultSectionHeaderTemplate}" />
			<ItemsControl x:Name="SearchResultsChildItemsControl"
						  Padding="1"
						  FocusManager.IsFocusScope="True"
						  Focusable="True"
						  ItemTemplate="{StaticResource SearchResultItemTemplate}"
						  ItemsSource="{Binding Items}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="SearchResultFavoriteSectionTemplate">
		<StackPanel Margin="0 0 0 10"
					Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
			<ContentControl Content="{Binding }"
							ContentTemplate="{StaticResource SearchResultSectionHeaderTemplate}" />
			<ItemsControl x:Name="SearchResultsChildItemsControl"
						  Padding="1"
						  FocusManager.IsFocusScope="True"
						  Focusable="True"
						  ItemTemplate="{StaticResource SearchResultFavoriteItemTemplate}"
						  ItemsSource="{Binding Items}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>

	<DataTemplate x:Key="SearchResultRecentItemSectionTemplate">
		<StackPanel Margin="0 0 0 10"
					Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
			<ContentControl Content="{Binding }"
							ContentTemplate="{StaticResource SearchResultSectionHeaderTemplate}" />
			<ItemsControl x:Name="SearchResultsChildItemsControl"
						  Padding="1"
						  FocusManager.IsFocusScope="True"
						  Focusable="True"
						  ItemTemplate="{StaticResource SearchResultRecentItemTemplate}"
						  ItemsSource="{Binding Items}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>

	<!-- #endregion DataTemplates -->

	<!--#region  NavigationList-->
	<Style x:Key="NavigationListStyle"
		   TargetType="{x:Type TextBlock}">
		<Setter Property="SnapsToDevicePixels"
				Value="true" />
		<Setter Property="OverridesDefaultStyle"
				Value="true" />
		<Setter Property="Margin"
				Value="2 0" />
		<Setter Property="Padding"
				Value="0 2 0 0" />
		<Setter Property="FontSize"
				Value="14" />
		<Setter Property="HorizontalAlignment"
				Value="Left" />
		<Setter Property="FocusVisualStyle"
				Value="{x:Null}" />
		<Setter Property="Visibility"
				Value="Visible" />
		<Setter Property="FontFamily"
				Value="Inter" />
		<Setter Property="FontWeight"
				Value="DemiBold" />
		<Setter Property="VerticalAlignment"
				Value="Center" />
		<Setter Property="Foreground"
				Value="{StaticResource FavoriteIndexBackgroundBrush}" />
	</Style>
	<!-- #endregion NavigationList -->

	<!--#region  SearchResultItemTemplate selectors-->
	<nav:SearchResultTemplateSelector x:Key="SearchResultDetailsTemplateSelector"
									  SearchDetailsTemplate="{StaticResource SearchDetailsSectionTemplate}"
									  FavoriteItemResultsTemplate="{StaticResource SearchResultFavoriteSectionTemplate}"
									  RecentItemResultsTemplate="{StaticResource SearchResultRecentItemSectionTemplate}"
									  SearchItemResultsTemplate="{StaticResource SearchDetailsSectionTemplate}" />
	<!--#endregion MenuTemplate selectors-->

	<!--#region  MenuTemplate selectors-->
	<nav:MenuTemplateSelector x:Key="MenuDetailsTemplateSelector"
							  SectionTemplate="{StaticResource EmptyBlockTemplate}"
							  DetailsTemplate="{StaticResource MenuDetailsItemTemplate}"
							  FavoritesTemplate="{StaticResource EmptyBlockTemplate}"
							  RecentTemplate="{StaticResource EmptyBlockTemplate}"
							  RecentItemsTemplate="{StaticResource EmptyBlockTemplate}" />
	<!--#endregion MenuTemplate selectors-->

	<Style x:Key="RefreshButtonStyle"
		   TargetType="Button">
		<Setter Property="Command"
				Value="NavigationCommands.Refresh"></Setter>
		<Setter Property="HorizontalAlignment"
				Value="Right"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Border">
						<Image Margin="3"
							   x:Name="img"
							   Height="20"
							   Width="20"
							   RenderTransformOrigin="0.5,0.5"
							   Source="{StaticResource RefreshMyTaskIconImage}">
						</Image>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter Property="Cursor"
									Value="Hand" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="RecentMessagesRefreshButtonStyle"
		   TargetType="Button"
		   BasedOn="{StaticResource RefreshButtonStyle}">
		<Setter Property="Command"
				Value="{x:Static local:NextHomeNavigation.RefreshRecentMessagesCommand}"></Setter>
	</Style>

	<Style x:Key="NewToggleButtonStyle"
		   TargetType="ToggleButton">
		<Setter Property="IsChecked"
				Value="{Binding RelativeSource={RelativeSource AncestorType=local:NextHomeNavigation}, Path=ShowNewsPanel}"></Setter>
		<Setter Property="ToolTip"
				Value="{Binding RelativeSource={RelativeSource AncestorType=local:NextHomeNavigation}, Path=ToggleNewsButtonToolTip}"></Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border x:Name="border"
							Width="16">
						<Grid>
							<ui:MultilingualTextLabel IsTranslatable="False">
								<TextBlock x:Name="ToggleText"
										   Text="⟪"
										   FontSize="16"
										   FontWeight="Bold" />
							</ui:MultilingualTextLabel>
						</Grid>
					</Border>

					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter Property="Cursor"
									Value="Hand" />
						</Trigger>
						<Trigger Property="IsChecked"
								 Value="True">
							<Setter TargetName="ToggleText"
									Property="Text"
									Value="⟫" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/CargoWise.Main.Navigation;component/WPF/MultilingualTextLabelResources.xaml" />
	</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
