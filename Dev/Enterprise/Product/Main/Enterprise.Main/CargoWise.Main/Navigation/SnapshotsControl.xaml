<UserControl x:Class="CargoWise.Main.Navigation.SnapshotsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CargoWise.Main.Navigation"
			 xmlns:ui="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
		     xmlns:converter="clr-namespace:CargoWise.Main.Navigation.Converters"
             mc:Ignorable="d" d:DesignHeight="150" d:DesignWidth="800"
             x:Name="Root">
	<UserControl.Resources>
		<ResourceDictionary >
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources\SnapshotsResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:SnapshotsVisibilityConverter x:Key="SnapshotsVisibilityConverter" />
			<local:SnapshotTemplateSelector x:Key="SnapshotTemplateSelector"
											SnapshotTemplate="{StaticResource SnapshotsCardTemplate}"
											AddSnapshotTemplate="{StaticResource AddSnapshotCardTemplate}" />
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"></RowDefinition>
			<RowDefinition ></RowDefinition>
		</Grid.RowDefinitions>
		<Grid  Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition></ColumnDefinition>
				<ColumnDefinition></ColumnDefinition>
			</Grid.ColumnDefinitions>
			<ui:MultilingualTextLabel IsTranslatable="False" HorizontalAlignment="Left" VerticalAlignment="Center">
				<TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Style="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=HeaderStyle}"/>
			</ui:MultilingualTextLabel>
			<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Grid.Column="1">
				<Button x:Name="CancelButton" Style="{StaticResource CancelButtonStyle}" Content="{Binding CancelText}" Click="CancelClick"></Button>
				<Button x:Name="EditButton" Style="{StaticResource EditButtonStyle}" Click="EditClick"></Button>
				<Button x:Name="SaveChangesButton" Style="{StaticResource SaveChangesButtonStyle}" Content="{Binding SaveChangesText}" Click="SaveChangesClick"/>
			</StackPanel>
		</Grid>
		<Grid Grid.Row="1" Grid.ColumnSpan="2" >
			<Rectangle x:Name="EmptyContainerRectangle" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SnapshotRectangleStyle}"/>
			<StackPanel Margin="16" x:Name="ShowEmptyContainer" Style="{StaticResource EmptyContainerStyle}">
				<Image Source="{StaticResource SnapshotFrames}"/>
				<StackPanel VerticalAlignment="Center" Margin="30,0,0,0">
					<ui:MultilingualTextLabel IsTranslatable="False" HorizontalAlignment="Center">
						<TextBlock Text="{Binding SnapshotsHint}" TextWrapping="Wrap" Width="200"/>
					</ui:MultilingualTextLabel>
					<Button Style="{StaticResource AddSnapshotButtonStyle}" Content="{Binding AddText}" Click="AddSnapshotClick"/>
				</StackPanel>
			</StackPanel>
		</Grid>
		<Border Grid.Row="1" Grid.ColumnSpan="2" x:Name="SnapshotsPanel">
			<Border.Style>
				<Style TargetType="Border">
					<Style.Triggers>
						<DataTrigger Binding="{Binding Path=IsEmpty, ElementName=Root}" Value="True">
							<Setter Property="Height" Value="170" />
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
				<ItemsControl x:Name="SnapshotsItemsControl"
							  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:SnapshotsControl}, Path=SnapshotsWithOptionalAdd}"
							  ItemTemplateSelector="{StaticResource SnapshotTemplateSelector}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="5" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemContainerStyle>
						<Style TargetType="ContentPresenter">
							<Setter Property="Margin"
									Value="0,0,8,0" />
						</Style>
					</ItemsControl.ItemContainerStyle>
				</ItemsControl>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
