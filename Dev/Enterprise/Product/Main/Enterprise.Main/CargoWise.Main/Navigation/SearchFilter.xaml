<UserControl x:Class="CargoWise.Main.Navigation.SearchFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:CargoWise.Main.Navigation.ViewModels;assembly=CargoWise.Main.Navigation" xmlns:local1="clr-namespace:CargoWise.Main.Navigation"
             xmlns:ui="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
			 mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
			 d:DataContext="{d:DesignInstance Type=local:SearchViewModel, IsDesignTimeCreatable=True}" >
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="NextHomeResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<Border Grid.Row="1" VerticalAlignment="Stretch" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3 0">
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3 3">
			<ItemsControl ItemsSource="{Binding Filters}" BorderThickness="0" Background="Transparent">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid ToolTipService.ToolTip="{Binding Name}" Margin="0 0">
							<ToggleButton IsChecked="{Binding IsSelected}" Focusable="False">
								<ToggleButton.Style>
									<Style TargetType="ToggleButton">
										<Setter Property="BorderThickness" Value="2"/>
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate TargetType="ToggleButton">
													<ContentPresenter x:Name="contentPresenter" 
															ContentTemplate="{TemplateBinding ContentTemplate}" 
															Content="{TemplateBinding Content}" 
															HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
															Margin="{TemplateBinding Padding}" 
															VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</ToggleButton.Style>
								<Border Padding="8 5" x:Name="Border" CornerRadius="4" BorderThickness="1" Margin="0 0 6 0">
									<ui:MultilingualTextLabel IsTranslatable="False">
										<TextBlock x:Name="ButtonText" FontSize="14px"/>
									</ui:MultilingualTextLabel>
								</Border>
							</ToggleButton>
						</Grid>
						<DataTemplate.Triggers>
							<DataTrigger Binding="{Binding IsSelected}" Value="False">
								<Setter TargetName="ButtonText" Property="Text" Value="{Binding Name}"/>
								<Setter TargetName="ButtonText" Property="Foreground" Value="{StaticResource NeutralTextDefaultBrush}"/>
								<Setter TargetName="Border" Property="Background" Value="{StaticResource NeutralBackgroundBrush}" />
							</DataTrigger>
							<DataTrigger Binding="{Binding IsSelected}" Value="True">
								<Setter TargetName="ButtonText" Property="Text" Value="{Binding Name, StringFormat= ✓ {0}}"/>
								<Setter TargetName="ButtonText" Property="Foreground" Value="{StaticResource MenuTextColorBrush}" />
								<Setter TargetName="Border" Property="Background" Value="{StaticResource MenuBackgroundColorBrush}" />
							</DataTrigger>
						</DataTemplate.Triggers>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</Border>
</UserControl>
