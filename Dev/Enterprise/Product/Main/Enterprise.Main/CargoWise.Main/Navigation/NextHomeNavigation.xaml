<UserControl x:Class="CargoWise.Main.Navigation.NextHomeNavigation"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="clr-namespace:CargoWise.Main.Navigation"
			 xmlns:login="clr-namespace:CargoWise.Main.Startup.Login"
			 xmlns:ui="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
			 xmlns:nav="clr-namespace:CargoWise.Main.Navigation;assembly=CargoWise.Main.Navigation"
			 xmlns:vm="clr-namespace:CargoWise.Main.Navigation.ViewModels;assembly=CargoWise.Main.Navigation"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
			 mc:Ignorable="d"
			 x:Name="NextHomeControl"
			 d:DesignHeight="450"
			 d:DesignWidth="800"
			 KeyboardNavigation.TabNavigation="Contained">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="NextHomeResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<local:MenuTextConverter x:Key="MenuTextConverter" />
			<local:PercentageConverter x:Key="PercentageConverter" />
		</ResourceDictionary>
	</UserControl.Resources>
	<UserControl.CommandBindings>
		<CommandBinding Command="Search"
						Executed="HandleSearchShortcut" />
		<CommandBinding Command="{x:Static local:NextHomeNavigation.PopupMenuClick}"
						Executed="HandlePopupMenu" />
		<CommandBinding Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}"
						Executed="CloseSearchWindow" />
		<CommandBinding Command="{x:Static local:NextHomeNavigation.NavigateSearchResultsCommand}"
						Executed="NavigateSearchResults" />
		<CommandBinding Command="{x:Static local:NextHomeNavigation.ExecuteSearchItemHyperlinkCommand}"
						Executed="ExecuteSearchItemHyperlink" />
		<CommandBinding Command="NavigationCommands.Refresh"
						Executed="RefreshTask" />
		<CommandBinding Command="{x:Static local:NextHomeNavigation.RefreshRecentMessagesCommand}"
						Executed="RefreshRecentMessages" />
	</UserControl.CommandBindings>
	<UserControl.InputBindings>
		<KeyBinding Key="Q"
					Modifiers="Control"
					Command="Search" />
	</UserControl.InputBindings>
	<Grid Background="{StaticResource BackgroundBrush}"
		  x:Name="NextHomeControlGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1.05*"
							  MinWidth="320" />
			<ColumnDefinition Width="2*" />
			<ColumnDefinition x:Name="NewsPanelColumnDefinition"
							  Width="1*"
							  MinWidth="300" />
			<ColumnDefinition Width="20" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="50" />
			<RowDefinition Height="*" />
			<RowDefinition Height="50" />
		</Grid.RowDefinitions>
		<StackPanel Grid.Column="3"
					Grid.Row="1"
					Grid.RowSpan="3"
					Orientation="Vertical"
					HorizontalAlignment="Left"
					Margin="2,10,2,0">
			<ToggleButton x:Name="ToggleNewsVisibilityButton"
						  HorizontalAlignment="Left"
						  Margin="2"
						  Style="{StaticResource NewToggleButtonStyle}">
			</ToggleButton>
		</StackPanel>
		<!--#region Footer -->
		<Grid x:Name="FooterGrid"
			  Grid.Row="2"
			  Grid.ColumnSpan="4"
			  Style="{StaticResource FooterGridStyle}">
			<Grid.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
			</Grid.InputBindings>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Border>
				<StackPanel Style="{StaticResource FooterPanelStyle}">
					<Ellipse>
						<Ellipse.Fill>
							<ImageBrush ImageSource="{Binding Path=UserImage, ElementName=NextHomeControl}"
										Stretch="UniformToFill" />
						</Ellipse.Fill>
					</Ellipse>
					<ui:MultilingualTextLabel>
						<TextBlock Text="{Binding Path=UserName, ElementName=NextHomeControl}"></TextBlock>
					</ui:MultilingualTextLabel>
					<Rectangle />
					<ui:MultilingualTextLabel Margin="0 0 4 0"
											  IsTranslatable="True"
											  MultilingualText="{Binding FooterBranchText}">
						<TextBlock Text="{Binding FooterBranchText}"
								   FontWeight="Medium"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel Margin="0 0 8 0">
						<TextBlock Text="{Binding Path=Branch, ElementName=NextHomeControl}"></TextBlock>
					</ui:MultilingualTextLabel>
					<Rectangle />
					<ui:MultilingualTextLabel Margin="0 0 4 0"
											  IsTranslatable="True"
											  MultilingualText="{Binding FooterCompanyText}">
						<TextBlock Text="{Binding FooterCompanyText}"
								   FontWeight="Medium"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel Margin="0 0 8 0">
						<TextBlock Text="{Binding Path=Company, ElementName=NextHomeControl}"></TextBlock>
					</ui:MultilingualTextLabel>
					<Rectangle />
					<ui:MultilingualTextLabel Margin="0 0 4 0"
											  IsTranslatable="True"
											  MultilingualText="{Binding FooterDepartmentText}">
						<TextBlock Text="{Binding FooterDepartmentText}"
								   FontWeight="Medium"></TextBlock>
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel>
						<TextBlock Text="{Binding Path=Department, ElementName=NextHomeControl}"></TextBlock>
					</ui:MultilingualTextLabel>
				</StackPanel>
			</Border>
			<Image Grid.Column="2" />
		</Grid>
		<!--#endregion Footer -->
		<!--#region Left Panel with favourites and recent modules -->
		<Grid Grid.Row="1"
			  Background="Transparent">
			<Grid.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
			</Grid.InputBindings>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<ListBox Grid.Row="0"
					 TextSearch.TextPath="Letter"
					 DataContext="{Binding MainViewModel}"
					 ui:ListBoxExtension.HoveredItem="{Binding HoveredItem, IsAsync=True, Mode=TwoWay}"
					 Style="{StaticResource FavouritesListBoxStyle}"
					 SelectedItem="{Binding SelectedItem}"
					 ItemsSource="{Binding Favorites}"
					 ItemTemplate="{StaticResource FavoritesSectionTemplate}">
			</ListBox>
			<ListBox Grid.Row="1"
					 MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualHeight, Converter={StaticResource PercentageConverter}, ConverterParameter=0.4}"
					 TextSearch.TextPath="Letter"
					 DataContext="{Binding MainViewModel}"
					 ui:ListBoxExtension.HoveredItem="{Binding HoveredItem, IsAsync=True, Mode=TwoWay}"
					 Style="{StaticResource FavouritesListBoxStyle}"
					 SelectedItem="{Binding SelectedItem}"
					 ItemsSource="{Binding RecentModules}"
					 ItemTemplate="{StaticResource RecentSectionTemplate}">
			</ListBox>
		</Grid>
		<!--#endregion Left Panel with favourites and recent modules -->
		<!--#region Center sections -->
		<Grid Grid.Column="1"
			  Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="auto" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="1*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<!--#region Snapshots -->
            <Border x:Name="SnapshotsPanel"
					Grid.ColumnSpan="2"
					Style="{StaticResource SnapshotsPanelStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<!-- Snapshots Header with Edit/Cancel buttons -->
					<Border Grid.Row="0"
							Padding="0,0,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
						</Grid>
					</Border>
					<!-- Snapshots Content -->
					<local:SnapshotsControl Grid.Row="1"
											DataContext="{Binding SnapshotsViewModel}"
											VerticalAlignment="Stretch"
											SnapShotsData="{Binding Snapshots}"
											HorizontalAlignment="Stretch"
                                            Grid.ColumnSpan="2"
                                            HeaderStyle="{StaticResource FavoritesHeaderStyle}"
											IsEditing="{Binding IsEditMode, Mode=TwoWay}"/>
				</Grid>
			</Border>
			<!--#endregion Snapshots -->
			<!--#region Recent Items -->
			<Border x:Name="RecentItemsPanel"
					Grid.Row="1"
					Grid.Column="0"
					DataContext="{Binding MainViewModel}"
					Style="{StaticResource RecentItemsBorderStyle}">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
				</Border.InputBindings>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border DataContext="{Binding RecentItems}"
							Padding="0 0 0 4">
						<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
												  MultilingualText="{Binding MultilingualText}">
							<TextBlock Style="{StaticResource FavoritesHeaderStyle}"
									   Text="{Binding DisplayName}" />
						</ui:MultilingualTextLabel>
						<Border.ContextMenu>
							<ContextMenu>
								<MenuItem Header="{Binding RemoveAllLinksText}"
										  Command="{Binding RemoveAllLinksAction}" />
							</ContextMenu>
						</Border.ContextMenu>
					</Border>
					<Grid Grid.Row="1" x:Name="RecentItemsPanelLargeScreen" Style="{StaticResource DisableCompactLayoutStyle}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Border Grid.Row="0" Style="{StaticResource RecentItemsHeaderRowStyle}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="30" />
									<ColumnDefinition Width="120" />
									<ColumnDefinition Width="300*" />
									<ColumnDefinition Width="150" />
								</Grid.ColumnDefinitions>
								<ui:MultilingualTextLabel IsTranslatable="False" Grid.Column="0">
									<TextBlock Text=""></TextBlock>
								</ui:MultilingualTextLabel>
								<ui:MultilingualTextLabel Grid.Column="1" IsTranslatable="True" MultilingualText="{Binding RecentItemsIDText}">
									<TextBlock Text="{Binding RecentItemsIDText}"></TextBlock>
								</ui:MultilingualTextLabel>
								<ui:MultilingualTextLabel Grid.Column="2" IsTranslatable="True" MultilingualText="{Binding RecentItemsNameText}">
									<TextBlock Text="{Binding RecentItemsNameText}"></TextBlock>
								</ui:MultilingualTextLabel>
								<ui:MultilingualTextLabel Grid.Column="3" IsTranslatable="True" MultilingualText="{Binding RecentItemsModuleText}">
									<TextBlock Text="{Binding RecentItemsModuleText}"></TextBlock>
								</ui:MultilingualTextLabel>
							</Grid>
						</Border>
						<ScrollViewer x:Name="RecentItemsScrollViewer" Grid.Row="1" Style="{StaticResource DefaultScrollViewerStyle}">
							<ScrollViewer.Resources>
								<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
							</ScrollViewer.Resources>
							<StackPanel>
								<ItemsControl
									ItemTemplate="{StaticResource RecentItemsRowTemplate}"
									ItemsSource="{Binding RecentMenuItems, IsAsync=True}" />
								<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}" MultilingualText="{Binding MultilingualText}">
									<TextBlock Style="{StaticResource NoRecentItemsTextStyle}" Text="{Binding DataContext.MainViewModel.NoRecentItemsText, RelativeSource={RelativeSource AncestorType=UserControl}}" >
									</TextBlock>
								</ui:MultilingualTextLabel>
							</StackPanel>
						</ScrollViewer>
					</Grid>
					<Grid Grid.Row="1" x:Name="RecentItemsPanelSmallScreen" Style="{StaticResource EnableCompactLayoutStyle}">
						<ScrollViewer x:Name="RecentItemsScrollViewerSmallScreen" Style="{StaticResource DefaultScrollViewerStyle}">
							<ScrollViewer.Resources>
								<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
							</ScrollViewer.Resources>
							<StackPanel>
								<ItemsControl ItemTemplate="{StaticResource RecentItemsRowTemplateSmallScreen}"
											  ItemsSource="{Binding RecentMenuItems, IsAsync=True}" />
								<ui:MultilingualTextLabel IsTranslatable="{Binding IsTranslatable}"
														  MultilingualText="{Binding MultilingualText}">
									<TextBlock Style="{StaticResource NoRecentItemsTextStyle}"
											   Text="{Binding DataContext.MainViewModel.NoRecentItemsText, RelativeSource={RelativeSource AncestorType=UserControl}}">
									</TextBlock>
								</ui:MultilingualTextLabel>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>

			<!--#endregion Recent Items -->
			<!--#region Holidays -->
			<Border x:Name="PublicHolidaysPanel"
					Visibility="Visible"
					Grid.Row="2"
					Grid.Column="1"
					DataContext="{Binding PublicHolidaysViewModel}"
					Style="{StaticResource RecentItemsMessagesStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition></ColumnDefinition>
								<ColumnDefinition></ColumnDefinition>
							</Grid.ColumnDefinitions>
							<ui:MultilingualTextLabel x:Name="PublicHolidaysTitle"
													  HorizontalAlignment="Left"
													  IsTranslatable="true"
													  MultilingualText="{Binding Title}">
								<ui:MultilingualTextLabel.Style>
									<Style TargetType="ui:MultilingualTextLabel">
										<Style.Triggers>
											<Trigger Property="IsMouseOver"
													 Value="True">
												<Trigger.Setters>
													<Setter Property="Cursor"
															Value="Hand"></Setter>
												</Trigger.Setters>
											</Trigger>
										</Style.Triggers>
									</Style>
								</ui:MultilingualTextLabel.Style>
								<ui:MultilingualTextLabel.InputBindings>
									<MouseBinding MouseAction="LeftClick"
												  Command="{Binding OpenHolidayFormCommand}"></MouseBinding>
								</ui:MultilingualTextLabel.InputBindings>
								<TextBlock Style="{StaticResource FavoritesHeaderStyle}"
										   Text="{Binding Title}" />
							</ui:MultilingualTextLabel>
						</Grid>
					</Border>
					<ScrollViewer x:Name="PublicHolidaysScrollViewer" Grid.Row="1" Style="{StaticResource DefaultScrollViewerStyle}">
						<ScrollViewer.Resources>
							<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
						</ScrollViewer.Resources>
						<StackPanel>
							<ItemsControl ItemsSource="{Binding Source={StaticResource GroupedHolidays}}"
										  ItemTemplate="{Binding Source={StaticResource PublicHolidaysRowTemplate}}">           
								<ItemsControl.GroupStyle>
									<GroupStyle HeaderTemplate="{StaticResource PublicHolidaysGroupHeaderTemplate}" />
								</ItemsControl.GroupStyle>
							</ItemsControl>
							<ui:MultilingualTextLabel IsTranslatable="true"
													  MultilingualText="{Binding EmptyLabel}">
								<TextBlock Style="{StaticResource NoPublicHolidaysTextStyle}"
										   Text="{Binding EmptyLabel}" />
							</ui:MultilingualTextLabel>
						</StackPanel>
					</ScrollViewer>
				</Grid>
			</Border>
			<!--#endregion Holidays -->
			<!--#region Tasks -->
			<Border x:Name="MyTasksPanel"
					Grid.Row="2"
					Grid.Column="0"
					DataContext="{Binding MyTasksViewModel}"
					Style="{StaticResource RecentItemsBorderStyle}">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
				</Border.InputBindings>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Padding="0 0 0 4">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition></ColumnDefinition>
								<ColumnDefinition></ColumnDefinition>
							</Grid.ColumnDefinitions>
							<ui:MultilingualTextLabel x:Name="MyTaskDisplayNameLabel"
													  HorizontalAlignment="Left"
													  IsTranslatable="true"
													  MultilingualText="{Binding DisplayName}">
								<ui:MultilingualTextLabel.Style>
									<Style TargetType="ui:MultilingualTextLabel">
										<Style.Triggers>
											<Trigger Property="IsMouseOver"
													 Value="True">
												<Trigger.Setters>
													<Setter Property="Cursor"
															Value="Hand"></Setter>
												</Trigger.Setters>
											</Trigger>
										</Style.Triggers>
									</Style>
								</ui:MultilingualTextLabel.Style>
								<ui:MultilingualTextLabel.InputBindings>
									<MouseBinding MouseAction="LeftClick"
												  Command="{Binding OpenTaskFormCommand}"></MouseBinding>
								</ui:MultilingualTextLabel.InputBindings>
								<TextBlock Style="{StaticResource FavoritesHeaderStyle}"
										   Text="{Binding DisplayName}" />
							</ui:MultilingualTextLabel>
							<Button x:Name="MyTaskRefreshButton"
									Style="{StaticResource RefreshButtonStyle}"
									Grid.Column="1"></Button>
						</Grid>
					</Border>
					<Grid Grid.Row="1" Style="{StaticResource EnableCompactLayoutStyle}">
						<ScrollViewer x:Name="MyTasksScrollViewerCompact" Style="{StaticResource DefaultScrollViewerStyle}">
							<ScrollViewer.Resources>
								<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
							</ScrollViewer.Resources>
							<StackPanel>
								<ItemsControl ItemTemplate="{StaticResource TasksRowTemplateCompact}"
											  ItemsSource="{Binding MyTasks, IsAsync=True}" />
								<ui:MultilingualTextLabel IsTranslatable="true"
														  MultilingualText="{Binding NoMyTasksText}">
									<TextBlock Style="{StaticResource NoMyTasksTextStyle}"
											   Text="{Binding NoMyTasksText}">
									</TextBlock>
								</ui:MultilingualTextLabel>
							</StackPanel>
						</ScrollViewer>
					</Grid>
					<Grid Grid.Row="1"
						  Style="{StaticResource DisableCompactLayoutStyle}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Border Grid.Row="0"
								Style="{StaticResource RecentItemsHeaderRowStyle}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="130*" />
									<ColumnDefinition Width="110*" />
									<ColumnDefinition Width="70*"
													  MinWidth="100" />
								</Grid.ColumnDefinitions>
								<ui:MultilingualTextLabel Style="{StaticResource TasksColumnHeaderStyle}"
														  MultilingualText="{Binding IdHeaderText}">
									<TextBlock Text="{Binding IdHeaderText}"></TextBlock>
								</ui:MultilingualTextLabel>
								<ui:MultilingualTextLabel Grid.Column="1"
														  Style="{StaticResource TasksColumnHeaderStyle}"
														  MultilingualText="{Binding NameHeaderText}">
									<TextBlock Text="{Binding NameHeaderText}"></TextBlock>
								</ui:MultilingualTextLabel>
								<ui:MultilingualTextLabel Grid.Column="2"
														  Style="{StaticResource TasksColumnHeaderStyle}"
														  MultilingualText="{Binding TaskDescriptionHeaderText}">
									<TextBlock Text="{Binding TaskDescriptionHeaderText}"></TextBlock>
								</ui:MultilingualTextLabel>
								<ui:MultilingualTextLabel Grid.Column="3"
														  Style="{StaticResource TasksColumnHeaderStyle}"
														  MultilingualText="{Binding StatusHeaderText}">
									<TextBlock Text="{Binding StatusHeaderText}"></TextBlock>
								</ui:MultilingualTextLabel>
							</Grid>
						</Border>
						<ScrollViewer x:Name="MyTasksScrollViewer" Grid.Row="1" Style="{StaticResource DefaultScrollViewerStyle}">
							<ScrollViewer.Resources>
								<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
							</ScrollViewer.Resources>
							<StackPanel>
								<ItemsControl ItemTemplate="{StaticResource TasksRowTemplate}"
											  ItemsSource="{Binding MyTasks, IsAsync=True}" />
								<ui:MultilingualTextLabel IsTranslatable="true"
														  MultilingualText="{Binding NoMyTasksText}">
									<TextBlock Style="{StaticResource NoMyTasksTextStyle}"
											   Text="{Binding NoMyTasksText}">
									</TextBlock>
								</ui:MultilingualTextLabel>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Border>
			<!--#endregion Tasks -->
			<!--#region Recent Messages -->
			<Border x:Name="RecentMessagesPanel"
					Visibility="Visible"
					Grid.Row="1"
					Grid.Column="1"
					DataContext="{Binding RecentMessagesViewModel}"
					Style="{StaticResource RecentItemsMessagesStyle}">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
				</Border.InputBindings>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Padding="0 0 0 4">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition></ColumnDefinition>
								<ColumnDefinition></ColumnDefinition>
							</Grid.ColumnDefinitions>
							<ui:MultilingualTextLabel HorizontalAlignment="Left"
													  IsTranslatable="true"
													  MultilingualText="{Binding Title}">
								<TextBlock Style="{StaticResource FavoritesHeaderStyle}"
										   Text="{Binding Title}" />
							</ui:MultilingualTextLabel>
							<Button x:Name="RecentMessagesRefreshButton"
									Style="{StaticResource RecentMessagesRefreshButtonStyle}"
									Grid.Column="1"></Button>
						</Grid>
					</Border>
					<ScrollViewer x:Name="RecentMessagesScrollViewer" Grid.Row="1" Style="{StaticResource DefaultScrollViewerStyle}">
						<ScrollViewer.Resources>
							<Style TargetType="ScrollBar" BasedOn="{StaticResource CustomScrollBar}" />
						</ScrollViewer.Resources>
						<StackPanel>
							<ItemsControl x:Name="RecentMessagesItemsControl"
										  ItemTemplate="{StaticResource RecentMessagesRowTemplate}"
										  ItemsSource="{Binding RecentMessages}" />
							<ui:MultilingualTextLabel IsTranslatable="true"
													  MultilingualText="{Binding NoRecentMessagesLabel}">
								<TextBlock x:Name="NoRecentMessagesLabel"
										   Style="{StaticResource NoRecentMessagesTextStyle}"
										   Text="{Binding NoRecentMessagesLabel}">
								</TextBlock>
							</ui:MultilingualTextLabel>
						</StackPanel>
					</ScrollViewer>
				</Grid>
			</Border>
			<!--#endregion Recent Messages -->
		</Grid>

		<!--#endregion Center sections -->
		<!--#region Right Panel with News -->
		<Grid Grid.Row="1"
			  Grid.Column="2"
			  Background="Transparent">
			<Grid.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
			</Grid.InputBindings>
			<Grid.RowDefinitions>
				<RowDefinition Height="1*" />
				<RowDefinition Height="1*" />
			</Grid.RowDefinitions>
			<local:NewsPanel Grid.Row="0">
				<local:NewsPanel.DataContext>
					<local:NewsViewModel SectionsToLoad="Top" />
				</local:NewsPanel.DataContext>
			</local:NewsPanel>
			<local:NewsPanel Grid.Row="1">
				<local:NewsPanel.DataContext>
					<local:NewsViewModel SectionsToLoad="Bottom" />
				</local:NewsPanel.DataContext>
			</local:NewsPanel>
		</Grid>
		<!--#endregion Right Panel with News -->
		<!--#region MainMenu -->
		<Canvas Grid.Row="1"
				Grid.ColumnSpan="3"
				Visibility="{Binding SelectedCategory, Converter={StaticResource MainMenuVisibilityConverter}}">
			<Border
				Height="584"
				Canvas.Left="19"
				Canvas.Top="0"
				x:Name="MainMenuBorder"
				BorderThickness="1"
				BorderBrush="{StaticResource BorderBrush}"
				CornerRadius="0,0,4,4"
				Background="White"
				VerticalAlignment="Top" HorizontalAlignment="Left">
				<Grid Margin="6">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid>
						<ScrollViewer x:Name="CategoryMenu"
									  VerticalScrollBarVisibility="{Binding Path=SelectedCategory, Converter={StaticResource ScrollBarVisibilityConverter}}"
									  Style="{StaticResource DefaultScrollViewerStyle}">
							<ListBox x:Name="SectionsMenu"
									 VerticalAlignment="Top"
									 MinWidth="251"
									 BorderThickness="0"
									 Padding="0 0 -1 16"
									 TextSearch.TextPath="Letter"
									 DataContext="{Binding SelectedCategory}"
									 ui:ListBoxExtension.HoveredItem="{Binding HoveredItem, IsAsync=True, Mode=TwoWay}"
									 SelectedItem="{Binding SelectedItem}"
									 ItemsSource="{Binding MenuSections}"
									 ItemContainerStyle="{StaticResource MenuItemCategoryStyle}"
									 ItemTemplate="{StaticResource MenuItemCategoryTemplate}">
							</ListBox>
						</ScrollViewer>
					</Grid>
					<Grid Grid.Column="1">
						<Border Background="{StaticResource BackgroundBrush}"
								CornerRadius="0,4,4,0"
								Margin="0 1 0 0">
							<ListBox VerticalAlignment="Top"
									 VerticalContentAlignment="Top"
									 HorizontalAlignment="Left"
									 HorizontalContentAlignment="Left"
									 TextSearch.TextPath="Letter"
									 DataContext="{Binding SelectedCategory}"
									 ui:ListBoxExtension.HoveredItem="{Binding HoveredItem, IsAsync=True, Mode=TwoWay}"
									 Style="{StaticResource MenuDetailsListBoxStyle}"
									 SelectedItem="{Binding SelectedItem}"
									 ItemsSource="{Binding Buttons}"
									 ItemTemplateSelector="{StaticResource MenuDetailsTemplateSelector}" />
						</Border>
					</Grid>
				</Grid>
			</Border>
		</Canvas>
		<!--#endregion MainMenu-->
		<!-- #region Search Panel -->
		<Grid Grid.Row="1"
			  Grid.Column="0"
			  Margin="0,0,2,0"
			  Grid.ColumnSpan="4"
			  Name="SearchWindow"
			  Background="Transparent"
			  Visibility="{Binding IsInSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1.89*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>
			<Grid.InputBindings>
				<KeyBinding Key="Escape"
							Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
			</Grid.InputBindings>
			<Border Grid.ColumnSpan="3"
					Background="Gray"
					Opacity="0.19"
					Name="SearchWindowBackground">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{x:Static local:NextHomeNavigation.CloseSearchWindowCommand}" />
				</Border.InputBindings>
			</Border>
			<local:SearchResultPanel x:Name="SearchResultPanel" Grid.Column="1" />
		</Grid>
		<!-- #endregion Search Panel -->
		<!--#region Top Panel with main menu items, search, testing, options and help buttons-->
		<local:NextAppBar x:Name="NextAppBar"
						  Grid.Row="0"
						  Grid.ColumnSpan="4"
						  MouseLeftButtonDown="TopPanel_MouseLeftButtonDown"></local:NextAppBar>
		<!--#endregion Top Panel with main menu items search, testing, options and help buttons-->
	</Grid>
</UserControl>
