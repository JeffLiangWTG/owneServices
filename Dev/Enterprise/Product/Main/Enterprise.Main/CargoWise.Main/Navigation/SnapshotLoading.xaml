<UserControl x:Class="CargoWise.Main.Navigation.SnapshotLoading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CargoWise.Main.Navigation"
             mc:Ignorable="d" 
             d:DesignHeight="450"
             d:DesignWidth="800"
             Height="150"
             Width="300"
             Background="White">

	<UserControl.Resources>
		<local:PercentageConverter x:Key="MultiplyConverter"/>

		<Style x:Key="ShineBarStyle" TargetType="Rectangle">
			<Setter Property="Opacity" Value="0.8" />
			<Setter Property="Fill">
				<Setter.Value>
					<LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
						<GradientStop Color="#99FFFFFF" Offset="0"/>
						<GradientStop Color="#00FFFFFF" Offset="1"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="Width" Value="60"/>
			<Setter Property="Height">
				<Setter.Value>
					<Binding 
                        Path="ActualHeight" 
                        RelativeSource="{RelativeSource AncestorType=UserControl}"
                        Converter="{StaticResource MultiplyConverter}"
                        ConverterParameter="0.2"/>
				</Setter.Value>
			</Setter>
			<Setter Property="RadiusX" Value="4"/>
			<Setter Property="RadiusY" Value="4"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform>
						<TranslateTransform.X>300</TranslateTransform.X>
					</TranslateTransform>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Border BorderBrush="#FF999999" 
            BorderThickness="1" 
            CornerRadius="4"
            Background="White"
            Margin="5">

		<Grid x:Name="mainGrid">
			<Grid.RowDefinitions>
				<RowDefinition Height="1*"/>
				<RowDefinition Height="1*"/>
				<RowDefinition Height="2*"/>
			</Grid.RowDefinitions>

			<!-- Row 1 -->
			<Grid Grid.Row="0"
                  Margin="20,10,0,0"
                  HorizontalAlignment="Left"
                  Width="{Binding ActualWidth, 
                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                  Converter={StaticResource MultiplyConverter},
                                  ConverterParameter=0.6}"
                  Height="{Binding ActualHeight, 
                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource MultiplyConverter},
                                   ConverterParameter=0.11}">
				<Rectangle Fill="#FFE5E5E5"
                           RadiusX="4"
                           RadiusY="4"
                           HorizontalAlignment="Stretch"/>
				<Rectangle Style="{StaticResource ShineBarStyle}"
                           HorizontalAlignment="Left" />
			</Grid>

			<!-- Row 2 -->
			<Grid Grid.Row="1"
                  Margin="20,10,20,10"
                  HorizontalAlignment="Left"
                  Width="{Binding ActualWidth, 
                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                  Converter={StaticResource MultiplyConverter},
                                  ConverterParameter=0.5}"
                  Height="{Binding ActualHeight, 
                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource MultiplyConverter},
                                   ConverterParameter=0.1}">
				<Rectangle Fill="#FFE5E5E5"
                           RadiusX="5"
                           RadiusY="5"
                           HorizontalAlignment="Stretch"/>
				<Rectangle Style="{StaticResource ShineBarStyle}"
                           HorizontalAlignment="Left"/>
			</Grid>

			<!-- Row 3 -->
			<Grid Grid.Row="2"
                  Margin="20,10,20,10"
                  HorizontalAlignment="Left"
                  Width="{Binding ActualWidth, 
                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                  Converter={StaticResource MultiplyConverter},
                                  ConverterParameter=0.3}"
                  Height="{Binding ActualHeight, 
                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                   Converter={StaticResource MultiplyConverter},
                                   ConverterParameter=0.2}">
				<Rectangle Fill="#FFE5E5E5"
                           RadiusX="5"
                           RadiusY="5"
                           HorizontalAlignment="Stretch"/>
				<Rectangle Style="{StaticResource ShineBarStyle}"
                           HorizontalAlignment="Left"/>
			</Grid>
		</Grid>
	</Border>
</UserControl>
