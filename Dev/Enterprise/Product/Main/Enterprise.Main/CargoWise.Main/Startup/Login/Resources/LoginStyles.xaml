<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
					xmlns:vc="clr-namespace:CargoWise.Main.Navigation.Converters;assembly=CargoWise.Main.Navigation"
					mc:Ignorable="d">
	<!--#region Converters-->
	<vc:StringToVisibilityConverter x:Key="StringToVisibilityConverter" IsCollapsed="True" />
	<vc:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" IsCollapsed="True" />
	<!--#endregion Converters-->

	<!--#region Brushes-->
	<SolidColorBrush x:Key="NeutralColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="NeutralTextColor" Color="#30302E" />
	<SolidColorBrush x:Key="NeutralTextActiveColor" Color="#111110" />
	<SolidColorBrush x:Key="NeutralBorderActiveColor" Color="#1B1B1A" />
	<SolidColorBrush x:Key="NeutralBorderWeakColor" Color="#6B6B6880" />
	<SolidColorBrush x:Key="PrimaryColor" Color="#371EE1" />
	<SolidColorBrush x:Key="PrimaryTextColor" Color="#F6F8FF" />
	<SolidColorBrush x:Key="ErrorBorderColor" Color="#D50047" />
	<SolidColorBrush x:Key="ErrorTextColor" Color="#D50047" />
	<SolidColorBrush x:Key="ErrorWeakColor" Color="#FEF6F9" />
	<SolidColorBrush x:Key="WarningBorderColor" Color="#716D28" />
	<SolidColorBrush x:Key="WarningTextColor" Color="#716D28" />
	<SolidColorBrush x:Key="WarningWeakColor" Color="#FAF9E3" />
	<SolidColorBrush x:Key="InfoBorderColor" Color="#8351C2" />
	<SolidColorBrush x:Key="InfoTextColor" Color="#8351C2" />
	<SolidColorBrush x:Key="InfoWeakColor" Color="#F9F7FC" />
	<!--#endregion Brushes-->

	<!--#region Styles-->
	<Style x:Key="BaseControl" TargetType="{x:Type Control}">
		<Setter Property="FontFamily" Value="Inter" />
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Foreground" Value="{StaticResource NeutralTextColor}"/>
		<Setter Property="Background" Value="{StaticResource NeutralColor}"/>
		<Setter Property="BorderBrush" Value="{x:Null}"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{StaticResource NeutralTextActiveColor}"/>
				<Setter Property="Background" Value="{StaticResource NeutralColor}"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="PasswordBoxInput" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource BaseControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type PasswordBox}">
					<Border x:Name="border" BorderBrush="{StaticResource NeutralBorderWeakColor}" BorderThickness="1" CornerRadius="4">
						<ScrollViewer x:Name="PART_ContentHost"
							Focusable="false"
							HorizontalScrollBarVisibility="Hidden"
							VerticalScrollBarVisibility="Hidden"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="TextBoxInput" TargetType="TextBox" BasedOn="{StaticResource BaseControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type TextBox}">
					<Border x:Name="border" BorderBrush="{StaticResource NeutralBorderWeakColor}" BorderThickness="1" CornerRadius="4">
						<ScrollViewer x:Name="PART_ContentHost"
							Focusable="false"
							HorizontalScrollBarVisibility="Hidden"
							VerticalScrollBarVisibility="Hidden"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="BaseLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="Inter" />
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Foreground" Value="{StaticResource NeutralTextColor}" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
	</Style>
	<Style x:Key="TitleLabel" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
		<Setter Property="Foreground" Value="{StaticResource PrimaryColor}" />
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="DemiBold" />
		<Setter Property="Margin" Value="0,0,0,32" />
	</Style>
	<Style x:Key="LongTitleLabel" TargetType="Label" BasedOn="{StaticResource TitleLabel}">
		<Setter Property="FontSize" Value="16"/>
	</Style>
	<Style x:Key="BaseButton" TargetType="{x:Type Button}">
		<Setter Property="FontWeight" Value="DemiBold" />
		<Setter Property="FontFamily" Value="Inter" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="4"/>
		<Setter Property="Width" Value="auto"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Cursor" Value="Hand"/>
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style x:Key="NeutralButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
		<Setter Property="Foreground" Value="{StaticResource NeutralTextColor}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border CornerRadius="4" BorderThickness="0" Background="Transparent" Padding="4,0,4,0">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FilledNeutralButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NeutralButton}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border
						CornerRadius="4"
						BorderThickness="1"
						BorderBrush="{StaticResource NeutralBorderWeakColor}"
						Background="Transparent"
						Padding="4,0,4,0">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButton}">
		<Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border
						CornerRadius="4"
						BorderThickness="1"
						BorderBrush="{StaticResource PrimaryColor}"
						Background="{StaticResource PrimaryColor}"
						Padding="4,0,4,0">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="CalloutLabel" TargetType="{x:Type Label}" BasedOn="{StaticResource BaseLabel}">
		<Setter Property="Padding" Value="0,8,0,8" />
	</Style>
	<Style x:Key="BaseCallout" TargetType="{x:Type Border}">
		<Setter Property="Padding" Value="8"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="BorderThickness" Value="4,0,0,0"/>
	</Style>
	<Style x:Key="ErrorCallout" TargetType="{x:Type Border}" BasedOn="{StaticResource BaseCallout}">
		<Setter Property="BorderBrush" Value="{StaticResource ErrorBorderColor}"/>
		<Setter Property="Background" Value="{StaticResource ErrorWeakColor}" />
	</Style>
	<Style x:Key="WarningCallout" TargetType="{x:Type Border}" BasedOn="{StaticResource BaseCallout}">
		<Setter Property="BorderBrush" Value="{StaticResource WarningBorderColor}"/>
		<Setter Property="Background" Value="{StaticResource WarningWeakColor}" />
	</Style>
	<Style x:Key="InfoCallout" TargetType="{x:Type Border}" BasedOn="{StaticResource BaseCallout}">
		<Setter Property="BorderBrush" Value="{StaticResource InfoBorderColor}"/>
		<Setter Property="Background" Value="{StaticResource InfoWeakColor}" />
	</Style>
	<Style x:Key="InputGroup" TargetType="{x:Type StackPanel}">
		<Setter Property="Margin" Value="0,0,0,16"/>
	</Style>
	<!--#endregion Styles-->

	<!--#region Flat ComboBox -->
	<SolidColorBrush x:Key="ComboBoxNormalBorderBrush" Color="#e3e9ef" />
	<SolidColorBrush x:Key="ComboBoxDisabledForegroundBrush" Color="#888" />
	<SolidColorBrush x:Key="ComboBoxDisabledBackgroundBrush" Color="#eee" />
	<SolidColorBrush x:Key="ComboBoxDisabledBorderBrush" Color="#888" />

	<DrawingImage x:Key="ComboBoxIconDrawingImage">
		<DrawingImage.Drawing>
			<DrawingGroup ClipGeometry="M0,0 V21 H20 V0 H0 Z">
				<DrawingGroup Opacity="1">
					<DrawingGroup Opacity="1">
						<GeometryDrawing Brush="#FF1B1B1A" Geometry="F1 M20,21z M0,0z M13.6413,11.7042C13.6158,11.6435 13.573,11.5917 13.5181,11.5554 13.4632,11.5191 13.3988,11.4998 13.333,11.5L6.66671,11.5C6.60091,11.4998 6.53652,11.5191 6.48165,11.5554 6.42678,11.5917 6.3839,11.6435 6.3584,11.7042 6.33438,11.7657 6.32829,11.8328 6.34083,11.8977 6.35336,11.9626 6.38401,12.0226 6.42923,12.0708L9.76238,15.404C9.82609,15.4656 9.91125,15.5 9.99987,15.5 10.0885,15.5 10.1736,15.4656 10.2374,15.404L13.5705,12.0708C13.6157,12.0226 13.6464,11.9626 13.6589,11.8977 13.6715,11.8328 13.6654,11.7657 13.6413,11.7042z" />
						<GeometryDrawing Brush="#FF1B1B1A" Geometry="F1 M20,21z M0,0z M13.6413,9.29584C13.6158,9.3565 13.573,9.40826 13.5181,9.44459 13.4632,9.48093 13.3988,9.5002 13.333,9.5L6.66671,9.5C6.60091,9.5002 6.53652,9.48093 6.48165,9.44459 6.42678,9.40826 6.3839,9.3565 6.3584,9.29584 6.33438,9.23427 6.32829,9.16717 6.34083,9.10228 6.35336,9.0374 6.38401,8.97739 6.42923,8.92919L9.76238,5.59604C9.82609,5.53444 9.91125,5.5 9.99987,5.5 10.0885,5.5 10.1736,5.53444 10.2374,5.59604L13.5705,8.92919C13.6157,8.97739 13.6464,9.0374 13.6589,9.10228 13.6715,9.16717 13.6654,9.23427 13.6413,9.29584z" />
