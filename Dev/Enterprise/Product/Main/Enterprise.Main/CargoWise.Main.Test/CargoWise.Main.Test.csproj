<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AssemblyName>CargoWise.Main.Test</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <SuppressObsoleteWarnings>SYSLIB0024</SuppressObsoleteWarnings>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Compile Remove="Winzor\**" />
    <EmbeddedResource Remove="Winzor\**" />
    <None Remove="Winzor\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\CargoWise.Main\Startup\Tools\JetBrains\license.txt" Link="Startup\Tools\JetBrains\license.txt" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.ActiveDirectory" />
    <Reference Include="CargoWise.Main.Navigation.Test" />
    <Reference Include="Enterprise.RemoteDesktopServices.Server" />
    <Reference Include="Enterprise.RemoteDesktopServices.Shared" />
    <Reference Include="Enterprise.RemoteDesktopServices.Testing" />
    <Reference Include="Enterprise.URLHandler" />
    <Reference Include="Enterprise.EConversation.Business" />
    <Reference Include="nunit.framework" />
    <Reference Include="CargoWise.Interop" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Web" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="UIAutomationProvider" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CargoWise.Main\CargoWise.Main.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="Winzor\**" />
  </ItemGroup>
</Project>