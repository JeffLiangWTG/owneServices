<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MockMsiExec</RootNamespace>
    <AssemblyName>MsiExec</AssemblyName>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationManifest>$(WTGBranchRoot)main.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <None Include="$(WTGBranchRoot)main.manifest" Link="main.manifest" />
  </ItemGroup>
</Project>