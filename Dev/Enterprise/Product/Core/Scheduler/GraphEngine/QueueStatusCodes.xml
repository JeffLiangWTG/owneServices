<?xml version="1.0" encoding="utf-8" ?>
<CodeDescriptionPairList
	xmlns="http://www.edi.com.au/CodeDescriptionPairList.xsd"
	xmlns:cdpl="http://www.edi.com.au/CodeDescriptionPairList.xsd"
	cdpl:Sort="true">
	
	<Item>
		<Identifier>Processed</Identifier>
		<Code>PRS</Code>
		<Description>This has been processed.</Description>
	</Item>
  <Item>
    <Identifier>Queued</Identifier>
    <Code>QUE</Code>
    <Description>This can be processed at any time.</Description>
  </Item>
  <Item>
    <Identifier>Blocked</Identifier>
    <Code>BLK</Code>
    <Description>Other items need to be processed before this can be queued.</Description>
  </Item>
  <Item>
    <Identifier>PreKey</Identifier>
    <Code>PKE</Code>
    <Description>This item is ready to be added to the queue.</Description>
  </Item>
  <Item>
    <Identifier>Notify</Identifier>
    <Code>NTF</Code>
    <Description>This item has been processed and following items need to be dequeued.</Description>
  </Item>
</CodeDescriptionPairList>