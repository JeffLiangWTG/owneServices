<?xml version="1.0" encoding="utf-8" ?>
<CodeDescriptionPairList
  xmlns="http://www.edi.com.au/CodeDescriptionPairList.xsd"
  xmlns:cdpl="http://www.edi.com.au/CodeDescriptionPairList.xsd"
  cdpl:Sort="true"
  cdpl:SortType="Code|Description"
  cdpl:Localizable="true" >
  <Namespace Name="Enterprise.Licensing" />
  <Item>
    <Identifier>Pending</Identifier>
    <Code>PND</Code>
    <Description>License is waiting to be approved or accepted.</Description>
  </Item>
  <Item>
    <Identifier>Queued</Identifier>
    <Code>QUE</Code>
