<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.ResourceStrings.Business</RootNamespace>
    <AssemblyName>Enterprise.ResourceStrings.Business</AssemblyName>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Reflection" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="BuildTools" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.StaticAnalysis" />
    <Reference Include="Enterprise.Billing.Integration" />
    <Reference Include="Enterprise.DocumentEngineCore" />
    <Reference Include="Enterprise.eHubMessaging.Business" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="Enterprise.Messaging.Business" />
    <Reference Include="Enterprise.Messaging.Integration" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="WTG.SecurityRights" />
    <Reference Include="Enterprise.Security.Core" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.MasterData.Common" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Mono.Cecil" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Resources" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="WTG.TranslationMemoryExchange" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Runtime.Caching" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="CustomizableData\AutoCustomizableDataTranslationEntry.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoCustomizableDataTranslationEntry.xml</DependentUpon>
    </Compile>
    <Compile Update="Data\Autos\AutoHelpDataString.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoHelpDataString.xml</DependentUpon>
    </Compile>
    <Compile Update="Data\EditReasons.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>EditReasons.xml</DependentUpon>
    </Compile>
    <Compile Update="TranslationFeedback\AutoTranslationSearchCriteria.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoTranslationSearchCriteria.xml</DependentUpon>
    </Compile>
    <Compile Update="TranslationFeedback\StmTranslationFeedback\TranslationFeedbackApplicationsList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TranslationFeedbackApplicationsList.xml</DependentUpon>
    </Compile>
    <Compile Update="TranslationFeedback\StmTranslationFeedback\TranslationFeedbackStatusList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TranslationFeedbackStatusList.xml</DependentUpon>
    </Compile>
    <EmbeddedResource Include="TM\Abbreviations.txt" />
    <EmbeddedResource Include="LocalLanguages\RefLocalLanguageResourceStrings.xml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="CustomizableData\AutoCustomizableDataTranslationEntry.xml">
      <CustomToolNamespace>Enterprise.ResourceStrings.Business</CustomToolNamespace>
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoCustomizableDataTranslationEntry.cs</LastGenOutput>
    </None>
    <None Update="Data\Autos\AutoHelpDataString.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoHelpDataString.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ResourceStrings.Business</CustomToolNamespace>
    </None>
    <None Update="Data\EditReasons.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>EditReasons.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ResourceStrings.Business</CustomToolNamespace>
    </None>
    <None Update="TranslationFeedback\AutoTranslationSearchCriteria.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoTranslationSearchCriteria.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ResourceStrings.Business</CustomToolNamespace>
    </None>
    <None Update="TranslationFeedback\StmTranslationFeedback\TranslationFeedbackApplicationsList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TranslationFeedbackApplicationsList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ResourceStrings.Business</CustomToolNamespace>
    </None>
    <None Update="TranslationFeedback\StmTranslationFeedback\TranslationFeedbackStatusList.xml">
      <CustomToolNamespace>Enterprise.ResourceStrings.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TranslationFeedbackStatusList.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>