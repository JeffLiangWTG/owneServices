<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="TranslationSearchCriteria"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<BoolColumn>
		<Name>SearchSource</Name>
	</BoolColumn>	
	<StringColumn>
		<Name>SourceText</Name>
		<MaxLength>32767</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>
	<BoolColumn>
		<Name>SearchTarget</Name>
	</BoolColumn>
	<StringColumn>
		<Name>TargetText</Name>
		<MaxLength>32767</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>
	<StringColumn>
		<Name>TargetLanguage</Name>
		<MaxLength>7</MaxLength>
	</StringColumn>
	<BoolColumn>
		<Name>Replace</Name>
	</BoolColumn>
	<StringColumn>
		<Name>ReplacementText</Name>
		<MaxLength>32767</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>
	<BoolColumn>
		<Name>MatchCase</Name>
	</BoolColumn>
	<BoolColumn>
		<Name>MatchWord</Name>
	</BoolColumn>
	<BoolColumn>
		<Name>UseRegularExpressions</Name>
	</BoolColumn>
</NonPersistentBusinessObject>
