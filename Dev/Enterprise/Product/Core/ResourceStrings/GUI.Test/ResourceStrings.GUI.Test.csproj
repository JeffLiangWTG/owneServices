<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.ResourceStrings.GUI.Testing</RootNamespace>
    <AssemblyName>Enterprise.ResourceStrings.GUI.Test</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <ProjectReference Include="..\GUI\ResourceStrings.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Enterprise.RemoteDesktopServices.Server" />
    <Reference Include="Enterprise.RemoteDesktopServices.Testing" />
    <Reference Include="Moq" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
</Project>