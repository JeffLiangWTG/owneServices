<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AssemblyName>Enterprise.Registry.GUI.Test</AssemblyName>
    <RootNamespace>Enterprise.Registry.GUI.Test</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Async" />
    <Reference Include="Enterprise.MasterData.Common" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <Reference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Registry.GUI\Registry.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Form\RegistryItemChangeLogFilter\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="RegistryItemEditors\DeniedPartyScreening\AddressMatchingLevel\AddressMatchingLevelControlForTest.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
</Project>