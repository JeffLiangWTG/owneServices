<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="KafkaSecurity"
	>

  <StringColumn>
    <Name>SecurityProtocol</Name>
    <MaxLength>15</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>SslCaLocation</Name>
    <EditableState>Conditional</EditableState>
    <MaxLength>256</MaxLength>
    <GenerateValidation>true</GenerateValidation>
  </StringColumn>
  
  <StringColumn>
    <Name>SaslUsername</Name>
    <EditableState>Conditional</EditableState>
    <MaxLength>50</MaxLength>
    <GenerateValidation>true</GenerateValidation>
  </StringColumn>

  <StringColumn>
    <Name>SaslPassword</Name>
    <EditableState>Conditional</EditableState>
    <MaxLength>50</MaxLength>
    <GenerateValidation>true</GenerateValidation>
  </StringColumn>

  <Serialisation>
    <Template>
      <SecurityProtocol>{value:SecurityProtocol}</SecurityProtocol>
      <SslCaLocation>{value:SslCaLocation}</SslCaLocation>
      <SaslUsername>{value:SaslUsername}</SaslUsername>
      <SaslPassword>{value:SaslPassword}</SaslPassword>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>