<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="ShippingPortsMessagingEHubID">

  <StringColumn>
    <Name>Port</Name>
    <Caption>Port</Caption>
    <FullDescription>The port to which these settings apply.</FullDescription>
    <MaxLength>5</MaxLength>
    <EditableState>Conditional</EditableState>
  </StringColumn>

  <StringColumn>
    <Name>Module</Name>
    <Caption>Module</Caption>
    <MaxLength>50</MaxLength>
    <EditableState>Conditional</EditableState>
  </StringColumn>

  <StringColumn>
    <Name>RecipientID</Name>
    <Caption>Recipient ID</Caption>
    <MaxLength>255</MaxLength>
    <EditableState>Conditional</EditableState>
  </StringColumn>

  <Serialisation>
    <Template>
      <Port>{value:Port}</Port>
      <Module>{value:Module}</Module>
      <RecipientID>{value:RecipientID}</RecipientID>
    </Template>
  </Serialisation>
</RegistryBusinessObjectTemplate>