<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="BillOfLadingNumberCustomisation"
	>

  <BoolColumn>
    <Name>RemoveFountainPrefix</Name>
  </BoolColumn>

  <BoolColumn>
    <Name>AutoAllocateMasterBillNumbersToConsols</Name>
  </BoolColumn>

  <StringColumn>
    <Name>CheckDigitAlgorithm</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>UseShipmentSequenceNumber</Name>
  </BoolColumn>

  <IntColumn>
    <Name>MaxGeneratedLength</Name>
    <EditableState>GetterOnly</EditableState>
    <GenerateValidation>true</GenerateValidation>
  </IntColumn>

	<StringColumn>
		<Name>ServiceLevel</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>
	
  <Serialisation>
    <Template>
	  <ServiceLevel>{value?:ServiceLevel}</ServiceLevel>
	  <RemoveFountainPrefix>{value:RemoveFountainPrefix}</RemoveFountainPrefix>
      <AutoAllocateMasterBillNumbersToConsols>{value?:AutoAllocateMasterBillNumbersToConsols}</AutoAllocateMasterBillNumbersToConsols>
      <CheckDigitAlgorithm>{value:CheckDigitAlgorithm}</CheckDigitAlgorithm>
      <UseShipmentSequenceNumber>{value:UseShipmentSequenceNumber}</UseShipmentSequenceNumber>
      <Elements>{method:NumberElements}</Elements>
    </Template>
  </Serialisation>
</RegistryBusinessObjectTemplate>
