<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="NotificationFrequency"
	>

  <StringColumn>
    <Name>Settings</Name>
    <MaxLength>15</MaxLength>
  </StringColumn>

  <IntColumn>
    <Name>TimeInterval</Name>
    <EditableState>Conditional</EditableState>
    <GenerateValidation>true</GenerateValidation>
  </IntColumn>

  <Serialisation>
    <Template>
      <Settings>{value:Settings}</Settings>
      <TimeInterval>{value:TimeInterval}</TimeInterval>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>