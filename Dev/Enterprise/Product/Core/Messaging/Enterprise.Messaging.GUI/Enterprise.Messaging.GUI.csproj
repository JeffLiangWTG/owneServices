<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="Enterprise.DocumentEngineCore" />
    <Reference Include="Enterprise.MasterData.Common" />
    <Reference Include="Enterprise.ZArchitecture.Schema" />
    <Reference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="EDICommunicationParty\Outbound\Modes\OutboundNoAuthenticationUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="EDIInterchange\InterchangeEventUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="EDICommunicationParty\EDICommunicationPartyUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="EDICommunicationParty\Inbound\InboundCommunicationPartyConfigUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="EDICommunicationParty\CommunicationModeMigratorForm.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>