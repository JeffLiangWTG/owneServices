<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
    <CWEnableIsExternalInitForNetFrameworkOnly>true</CWEnableIsExternalInitForNetFrameworkOnly>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
    <CWGenerateXmlSerializationAssemblies>true</CWGenerateXmlSerializationAssemblies>
    <CWUsesSqlClient>true</CWUsesSqlClient>
    <NoWarn>$(NoWarn);CS8073</NoWarn>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="BouncyCastle.Cryptography" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.eHub.Common" />
    <Reference Include="CargoWise.EventReference" />
    <Reference Include="CargoWise.FeatureControl.Abstractions" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.IO" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Enterprise.Accounting.Integration" />
    <Reference Include="Enterprise.Billing.Integration" />
    <Reference Include="Enterprise.DocumentEngineCore" />
    <Reference Include="Enterprise.DocumentScanning.Integration" />
    <Reference Include="Enterprise.Dash.Integration" />
    <Reference Include="Enterprise.Edifact.D96B" />
    <Reference Include="Enterprise.Edifact.D99B" />
    <Reference Include="Enterprise.eTail.Integration" />
    <Reference Include="Enterprise.Freight.Integration" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterData.Common" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="Enterprise.Messaging.Integration" />
    <Reference Include="Edifact" />
    <Reference Include="Enterprise.StabilityChecker" />
    <Reference Include="Enterprise.UniversalDataBuss.Integration" />
    <Reference Include="Enterprise.xTMessaging.Shared" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="CryptoUtilities" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="MailManager" />
    <Reference Include="MailManager.Integration" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Resources" />
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Memory" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="Xware.Xt.Grpc.Config" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DiagnosticConsol\DiagnosticConsolActions.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>DiagnosticConsolActions.xml</DependentUpon>
    </Compile>
    <Compile Update="DiagnosticConsol\DiagnosticStatusList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>DiagnosticStatusList.xml</DependentUpon>
    </Compile>
    <Compile Update="EDIMessage\EDIMessageInterpreter\AutoEDIMessageInterpreter.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoEDIMessageInterpreter.xml</DependentUpon>
    </Compile>
    <Compile Update="EDIMessage\EDIMessageSchemaNameList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>EDIMessageSchemaNameList.xml</DependentUpon>
    </Compile>
    <EmbeddedResource Include="EDIInterchange\EDIInterchangeResourceStrings.xml" />
    <EmbeddedResource Include="EDIMessage\EDIMessageResourceStrings.xml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="DiagnosticConsol\DiagnosticConsolActions.xml">
      <CustomToolNamespace>Enterprise.Messaging.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>DiagnosticConsolActions.cs</LastGenOutput>
    </None>
    <None Update="DiagnosticConsol\DiagnosticStatusList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <CustomToolNamespace>Enterprise.Messaging.Business</CustomToolNamespace>
      <LastGenOutput>DiagnosticStatusList.cs</LastGenOutput>
    </None>
    <None Update="EDIMessage\EDIMessageInterpreter\AutoEDIMessageInterpreter.xml">
      <CustomToolNamespace>Enterprise.Messaging.Business</CustomToolNamespace>
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoEDIMessageInterpreter.cs</LastGenOutput>
    </None>
    <None Update="EDIMessage\EDIMessageSchemaNameList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>EDIMessageSchemaNameList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Messaging.Business</CustomToolNamespace>
    </None>
    <EmbeddedResource Include="EDIMessage\XmlToHtmlTransformation.txt" />
    <EmbeddedResource Include="MessageProcessor\Template\Response.htm" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>