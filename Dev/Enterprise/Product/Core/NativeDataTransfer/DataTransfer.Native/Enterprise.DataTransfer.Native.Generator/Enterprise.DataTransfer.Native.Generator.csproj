<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Windows.UI" />
    <Reference Include="Enterprise.DataTransfer.Native.Integration" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Initialisation" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Resources" />
    <Reference Include="WTG.TestHelpers" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Enterprise.DataTransfer.Native.Business\Enterprise.DataTransfer.Native.Business.csproj" />
    <ProjectReference Include="..\Enterprise.DataTransfer.Native.Common\Enterprise.DataTransfer.Native.Common.csproj" />
    <ProjectReference Include="..\Enterprise.DataTransfer.Native.Utils\Enterprise.DataTransfer.Native.Utils.csproj" />
  </ItemGroup>
  <ItemGroup>
    <WCFMetadata Include="Service References\" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
  </ItemGroup>
</Project>