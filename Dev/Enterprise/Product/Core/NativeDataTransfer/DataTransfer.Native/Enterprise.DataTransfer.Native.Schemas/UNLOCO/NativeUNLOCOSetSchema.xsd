<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Universal" version="1.0" xmlns:cw="http://www.cargowise.com/Schemas/Universal" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="UniversalCommonSchema.xsd" />
	<xs:element name="NativeUNLOCOSetSchema">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RefUNLOCO" type="cw:RefUNLOCO" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RefUNLOCO">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="5" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CoOrdinates" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="12" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="HasAirport" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasBorderCrossing" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasCustomsLodge" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasDischarge" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasOutport" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasPost" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasRail" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasRoad" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasSeaport" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasStore" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasTerminal" minOccurs="0" type="xs:boolean" />
			<xs:element name="HasUnload" minOccurs="0" type="xs:boolean" />
			<xs:element name="IATA" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IsActive" minOccurs="0" type="xs:boolean" />
			<xs:element name="IsSystem" minOccurs="0" type="xs:boolean" />
			<xs:element name="NameWithDiacriticals" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="35" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
			<xs:element name="PortName" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="35" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="RefTimeZoneSet" type="cw:RefTimeZoneSet" />
			<xs:element name="RefCountry" type="cw:RefCountry" />
			<xs:element name="CountryCode" type="cw:CountryCode" />
			<xs:element name="RefCountryStates" type="cw:RefCountryStates" />
			<xs:element name="RefZonePivotCollection">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="RefZonePivot" type="cw:RefZonePivot" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefZonePivot">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="PK" type="xs:string" />
			<xs:element name="RefZoneHeader" type="cw:RefZoneHeader" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefTimeZoneSet">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="StandardZone" type="xs:string" />
			<xs:element name="DaylightSavingZone" minOccurs="0" type="xs:string" />
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefCountry">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="CountryCode">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefCountryStates">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="RefCountry" type="xs:string" />
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefZoneHeader">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="4" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Description" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="35" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
</xs:schema>