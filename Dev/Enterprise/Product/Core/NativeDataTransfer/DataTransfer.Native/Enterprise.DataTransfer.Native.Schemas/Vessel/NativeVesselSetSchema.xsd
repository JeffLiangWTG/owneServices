<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Universal" version="1.0" xmlns:cw="http://www.cargowise.com/Schemas/Universal" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="UniversalCommonSchema.xsd" />
	<xs:element name="NativeVesselSetSchema">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RefVessel" type="cw:RefVessel" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RefVessel">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="CarrierCode" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="4" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="35" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomAttrib1" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomAttrib2" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomAttrib3" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IsActive" minOccurs="0" type="xs:boolean" />
			<xs:element name="LloydsNumber" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="7" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="NetRegisterTon" minOccurs="0" type="xs:int" />
			<xs:element name="PK" type="xs:string" />
			<xs:element name="RadioCallSign" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="VesselType" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="YearOfConstruction" minOccurs="0" type="xs:int" />
			<xs:element name="OrgHeader" type="cw:OrgHeader" />
			<xs:element name="RefCarrierConsortium" type="cw:RefCarrierConsortium" />
			<xs:element name="RefCountry" type="cw:RefCountry" />
			<xs:element name="CountryOfReg" type="cw:CountryOfReg" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="OrgHeader">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="12" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefCarrierConsortium">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefCountry">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="CountryOfReg">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="2" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
</xs:schema>