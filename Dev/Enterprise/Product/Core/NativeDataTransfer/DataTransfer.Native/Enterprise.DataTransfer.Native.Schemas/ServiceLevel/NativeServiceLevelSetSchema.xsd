<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Universal" version="1.0" xmlns:cw="http://www.cargowise.com/Schemas/Universal" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="UniversalCommonSchema.xsd" />
	<xs:element name="NativeServiceLevelSetSchema">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RefServiceLevel" type="cw:RefServiceLevel" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RefServiceLevel">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Description" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="35" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IsActive" minOccurs="0" type="xs:boolean" />
			<xs:element name="IsDoorToDoor" minOccurs="0" type="xs:boolean" />
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
</xs:schema>