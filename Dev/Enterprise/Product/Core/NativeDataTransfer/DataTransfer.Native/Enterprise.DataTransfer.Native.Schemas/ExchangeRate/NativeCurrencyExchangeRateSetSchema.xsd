<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Universal" version="1.0" xmlns:cw="http://www.cargowise.com/Schemas/Universal" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="UniversalCommonSchema.xsd" />
	<xs:element name="NativeCurrencyExchangeRateSetSchema">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RefExchangeRate" type="cw:RefExchangeRate" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RefExchangeRate">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="ExpiryDate" minOccurs="0" type="xs:dateTime" />
			<xs:element name="ExRateType" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
			<xs:element name="SellRate" minOccurs="0" type="xs:decimal" />
			<xs:element name="StartDate" type="xs:dateTime" />
			<xs:element name="GlbCompany" type="cw:GlbCompany" />
			<xs:element name="RefCurrency" type="cw:RefCurrency" />
			<xs:element name="ExCurrency" type="cw:ExCurrency" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="GlbCompany">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="RefCurrency">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="ExCurrency">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
</xs:schema>