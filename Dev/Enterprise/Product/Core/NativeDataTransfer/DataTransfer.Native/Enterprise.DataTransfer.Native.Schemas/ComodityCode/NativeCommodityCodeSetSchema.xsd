<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Universal" version="1.0" xmlns:cw="http://www.cargowise.com/Schemas/Universal" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:include schemaLocation="UniversalCommonSchema.xsd" />
	<xs:element name="NativeCommodityCodeSetSchema">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RefCommodityCode" type="cw:RefCommodityCode" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RefCommodityCode">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="4" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CommodityType" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="3" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ContainerVentRequired" minOccurs="0" type="xs:boolean" />
			<xs:element name="Description" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="35" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ExpiryDate" minOccurs="0" type="xs:dateTime" />
			<xs:element name="IsActive" minOccurs="0" type="xs:boolean" />
			<xs:element name="IsFlamable" minOccurs="0" type="xs:boolean" />
			<xs:element name="IsHazardous" minOccurs="0" type="xs:boolean" />
			<xs:element name="IsPerishable" minOccurs="0" type="xs:boolean" />
			<xs:element name="IsTimber" minOccurs="0" type="xs:boolean" />
			<xs:element name="PK" type="xs:string" />
			<xs:element name="ReeferMaxTemperature" minOccurs="0" type="xs:decimal" />
			<xs:element name="ReeferMinTemperature" minOccurs="0" type="xs:decimal" />
			<xs:element name="NMFC" type="cw:NMFC" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
	<xs:complexType name="NMFC">
		<xs:sequence>
			<xs:element name="Key" type="cw:TableKey" />
			<xs:element name="Code" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="PK" type="xs:string" />
		</xs:sequence>
		<xs:attribute name="Action" type="cw:Action" />
	</xs:complexType>
</xs:schema>