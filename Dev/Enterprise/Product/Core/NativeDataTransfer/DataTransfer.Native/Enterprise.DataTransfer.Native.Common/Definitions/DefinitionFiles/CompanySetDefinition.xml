<NativeSchemaSet Name="Company" Root="GlbCompany">
  <Entities>
    <Entity Name="AccCFXUpliftConfigurationView"/>
    <Entity Name="AccExchangeRateConfigurationView"/>
    <Entity Name="GlbCompany">
      <ExcludedProperty Name="GC_GeoLocation" />
      <ExcludedProperty Name="GC_ValidationStatus" />
    </Entity>
    <Entity Name="GlbBranch">
      <ExcludedProperty Name="GB_GeoLocation" />
      <ExcludedProperty Name="GB_ValidationStatus" />
    </Entity>
  </Entities>
  <Associations>
    <Association From="GlbBranch" To="GlbCompany" Key="GB_GC"/>
    <Association From="AccCFXUpliftConfigurationView" To="GlbCompany" Key="JCF_GC"  WhereThisColumnIsNull="JCF_ParentID"/>
    <Association From="AccCFXUpliftConfigurationView" To="GlbBranch" Key="JCF_ParentID"/>
    <Association From="AccExchangeRateConfigurationView" To="GlbCompany" Key="JCE_GC"  WhereThisColumnIsNull="JCE_ParentID"/>
  </Associations>  
</NativeSchemaSet>
