<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CWNetCoreTargetFramework);net48</TargetFrameworks>
    <RootNamespace>Enterprise.MailManager.ServiceTask.Test</RootNamespace>
    <SuppressObsoleteWarnings>SYSLIB0014</SuppressObsoleteWarnings>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Remote Batchprocessor|AnyCPU' ">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Update="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Business\MailItem\TestFiles\*.*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Azure.Core" />
    <Reference Include="Microsoft.Graph" />
    <Reference Include="Microsoft.Graph.Core" />
    <Reference Include="Microsoft.Identity.Client" />
  </ItemGroup>
</Project>