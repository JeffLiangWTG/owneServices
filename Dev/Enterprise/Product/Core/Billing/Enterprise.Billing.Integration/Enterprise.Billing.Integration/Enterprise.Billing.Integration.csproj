<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
    <CWGenerateXmlSerializationAssemblies>true</CWGenerateXmlSerializationAssemblies>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <EmbeddedResource Include="BillingTransaction.xsd">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="UsageTransaction.xsd">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Database.ExtendedProperties" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Core.Encryption" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Memory" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="OldBillingTransactions\NoVersion\BillingTransaction.cs">
      <DependentUpon>BillingTransaction.xsd</DependentUpon>
    </Compile>
    <Compile Update="OldBillingTransactions\OneTwo\BillingTransaction.cs">
      <DependentUpon>BillingTransaction.xsd</DependentUpon>
    </Compile>
    <Compile Update="BillingTransaction.cs">
      <DependentUpon>BillingTransaction.xsd</DependentUpon>
    </Compile>
    <Compile Update="BillingTransaction.Custom.cs">
      <DependentUpon>BillingTransaction.xsd</DependentUpon>
    </Compile>
    <Compile Update="UsageTransaction.cs">
      <DependentUpon>UsageTransaction.xsd</DependentUpon>
    </Compile>
    <Compile Update="UsageTransaction.Custom.cs">
      <DependentUpon>UsageTransaction.xsd</DependentUpon>
    </Compile>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>