<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Billing.StlCollector.Retriever.Testing</RootNamespace>
    <AssemblyName>Enterprise.Billing.StlCollector.Retriever.Test</AssemblyName>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Billing.Collectors" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.Database.TestFramework" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Billing.Business" />
    <Reference Include="Enterprise.Billing.Integration" />
    <Reference Include="Enterprise.BufferManagement.Integration" />
    <Reference Include="Enterprise.Customs.Universal" />
    <Reference Include="Enterprise.DocumentScanning.Business" />
    <Reference Include="Enterprise.DocumentScanning.Business.Test" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="Enterprise.Workflow.Integration" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="Enterprise.ZArchitecture.Web.Shared" />
    <Reference Include="Moq" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="NUnitCore" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- net framework only: make System.Data.SqlClient a global using-->
    <Using Condition="'$(IsNetFrameworkTargetFramework)' == 'true'" Include="System.Data.SqlClient"/>

    <!-- net core only: add package to Microsoft.Data.SqlClient and make Microsoft.Data.SqlClient a global using-->
    <PackageReference Condition="'$(IsNetCoreTargetFramework)' == 'true'" Include="Microsoft.Data.SqlClient"/>
    <Using Condition="'$(IsNetCoreTargetFramework)' == 'true'" Include="Microsoft.Data.SqlClient"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Retriever\Retriever.csproj" />
  </ItemGroup>
</Project>