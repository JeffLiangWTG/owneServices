<?xml version="1.0" encoding="utf-8"?>
<xs:schema
	xmlns="http://www.edi.com.au/EnterpriseService/"
	attributeFormDefault="unqualified"
	elementFormDefault="qualified"
	targetNamespace="http://www.edi.com.au/EnterpriseService/"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
>

	<xs:include schemaLocation="..\..\DataTransfer\DataFileDefinitions\Xml\Version1\Elements.xsd" />

	<!--Top Level Collection-->

	<xs:complexType name="SystemMergeStorageDocs">
		<xs:sequence>
			<xs:element maxOccurs="unbounded" name="SystemMergeStorageDoc" type="SystemMergeStorageDoc" />
		</xs:sequence>
	</xs:complexType>

	<!--Top Level Entity-->

	<xs:complexType name="SystemMergeStorageDoc">
		<xs:sequence>
			<xs:element name="PK" type="xs:string"/>
			<xs:element name="OrgHeaderPk" type="xs:string"/>
			<xs:element name="DataType" type="xs:string" minOccurs="0"/>
			<xs:element name="DocType" type="xs:string"/>
			<xs:element name="Desc" type="xs:string" minOccurs="0"/>
			<xs:element name="FileName" type="xs:string" minOccurs="0"/>
			<xs:element name="Date" type="xs:dateTime" minOccurs="0"/>
			<xs:element name="IsPublished" type="xs:boolean" minOccurs="0"/>
			<xs:element name="IsSystemGenerated" type="xs:boolean" minOccurs="0"/>
			<xs:element name="SaveVersions" type="xs:boolean" minOccurs="0"/>
			<xs:element name="ImageData" type="xs:base64Binary"/>
		</xs:sequence>
	</xs:complexType>

</xs:schema>
