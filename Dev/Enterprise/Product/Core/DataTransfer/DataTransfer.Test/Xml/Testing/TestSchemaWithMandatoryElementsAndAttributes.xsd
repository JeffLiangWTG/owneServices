<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns="http://www.edi.com.au/EnterpriseService/" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="WithMandatoryElementsAndAttributes">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NestedElement">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="MandatoryElement1" type="xs:string" />
							<xs:element name="MandatoryElement2" type="xs:string" />
							<xs:element name="EmptyElement1" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="SomeAttribute" type="xs:string" />
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="EmptyElement2" minOccurs="0">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="SomeOtherAttribute" type="xs:string" />
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="AnArray" minOccurs="0">
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element name="MandatoryElementInArray">
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="MandatoryAttribute" type="xs:string" />
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:choice minOccurs="0">
					<xs:element name="Choice1" type="xs:string" minOccurs="0" />
					<xs:element name="Choice2" type="xs:string" minOccurs="0" />
				</xs:choice>
			</xs:sequence>
			<xs:attribute name="MandatoryAttribute1" type="xs:string" use="required" />
			<xs:attribute name="MandatoryAttribute2" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
</xs:schema>