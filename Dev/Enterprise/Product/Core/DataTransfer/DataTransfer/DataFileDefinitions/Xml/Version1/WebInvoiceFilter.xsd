<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:include schemaLocation="Elements.xsd" />
  <xs:include schemaLocation="FinancialInvoice.xsd" />
  <xs:complexType name="WebInvoiceFilter">
    <xs:sequence>
      <xs:element name="PostDateFrom" type="xs:dateTime" />
      <xs:element name="PostDateTo" type="xs:dateTime" />
      <xs:element name="LedgerTypes" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="LedgerType" type="TxnLedgerType" minOccurs="0" maxOccurs="unbounded" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="TxnTypes" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="TxnType" type="TxnType" minOccurs="0" maxOccurs="unbounded" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Company">
        <xs:simpleType>
          <xs:restriction base="xs:normalizedString">
            <xs:length value="3" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>