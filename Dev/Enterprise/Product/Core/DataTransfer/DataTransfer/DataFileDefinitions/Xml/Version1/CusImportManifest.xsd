<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="Elements.xsd"/>
	<xs:element name="CusImportManifests">
		<xs:annotation>
			<xs:documentation>Comment.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CusImportManifest" type="CusImportManifest" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="CusImportManifest">
		<xs:sequence>
			<xs:element name="OceanBills">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="OceanBill" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:complexContent>
									<xs:extension base="OceanBill">
										<xs:sequence>
											<xs:element name="OceanBillDetails">
												<xs:complexType>
													<xs:sequence>
														<xs:element name="OceanBillDetail" minOccurs="0" maxOccurs="unbounded">
															<xs:complexType>
																<xs:sequence>
																	<xs:element name="ContainerNumber" type="xs:string"/>
																	<xs:element name="ContainerMode" type="xs:string" minOccurs="0"/>
																	<xs:element name="SealNumber" type="xs:string" minOccurs="0"/>
																	<xs:element name="ContainerSizeOrISOCode" type="xs:string" minOccurs="0"/>
																	<xs:element name="ContainerType" type="xs:string" minOccurs="0"/>
																	<xs:element name="PackageType" type="xs:string" minOccurs="0"/>
																	<xs:element name="NumberOfPackages" type="xs:int" minOccurs="0"/>
																	<xs:element name="Weight" type="DimensionValue" minOccurs="0"/>
																	<xs:element name="Volume" type="DimensionValue" minOccurs="0"/>
																	<xs:element name="MarksAndNumbers" type="xs:string" minOccurs="0"/>
																	<xs:element name="GoodsDescription" type="xs:string" minOccurs="0"/>
																	<xs:element name="Indicators" minOccurs="0">
																		<xs:complexType>
																			<xs:sequence>
																				<xs:element name="ReportableDocuments" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="PersonalEffects" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="SAC" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="ShipperOwnedContainer" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="Fumigation" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="Timber" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="HazardousGoods" type="xs:boolean" minOccurs="0"/>
																				<xs:element name="PerishableGoods" type="xs:boolean" minOccurs="0"/>
																			</xs:sequence>
																		</xs:complexType>
																	</xs:element>
																</xs:sequence>
															</xs:complexType>
														</xs:element>
													</xs:sequence>
												</xs:complexType>
											</xs:element>
											<xs:element name="PortOfLoading" type="Movement" minOccurs="0"/>
											<xs:element name="PortOfDischarge" type="Movement" minOccurs="0"/>
											<xs:element name="PortOfOrigin" type="Movement" minOccurs="0"/>
											<xs:element name="PortOfDestination" type="Movement" minOccurs="0"/>
											<xs:element name="CargoType" type="xs:string" minOccurs="0"/>
											<xs:element name="CountryOfOrigin" type="CountryCode" minOccurs="0"/>
											<xs:element name="MethodOfPayment" type="xs:string" minOccurs="0"/>
											<xs:element name="IsForwarder" type="xs:boolean" minOccurs="0"/>
											<xs:element name="Consignee" type="Organisation" minOccurs="0"/>
											<xs:element name="Consignor" type="Organisation" minOccurs="0"/>
											<xs:element name="OceanBillNumber" type="xs:string"/>
										</xs:sequence>
									</xs:extension>
								</xs:complexContent>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Arrivals">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Arrival" minOccurs="0" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ArrivalPort" type="Movement"/>
									<xs:element name="BerthCode" type="xs:string" minOccurs="0"/>
									<xs:element name="CTOAddress" type="AddressReference" minOccurs="0"/>
									<xs:element name="StevedoreID" type="xs:string" minOccurs="0"/>
									<xs:element name="CTOEstablishmentID" type="xs:string" minOccurs="0"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="SlotCharterers" type="Organisations"/>
			<xs:element name="LastForeignPortOfDeparture" type="Movement" minOccurs="0"/>
			<xs:element name="Vessel">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Name" type="xs:string"/>
						<xs:element name="Lloyds" type="xs:string" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="VoyageNumber" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OceanBill"/>
</xs:schema>
