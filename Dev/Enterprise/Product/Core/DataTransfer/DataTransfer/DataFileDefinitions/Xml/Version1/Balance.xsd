<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="Elements.xsd"/>
  <xs:include schemaLocation="FinancialInvoice.xsd" />
    
  <xs:element name="Balances">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Balance" type="Balance" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:complexType name="Balance">
    <xs:sequence>
      <xs:element name="OrganisationCode" type="xs:string" />
      <xs:element name="BranchCode" type="xs:string"/>
      <xs:element name="DepartmentCode" type="xs:string" minOccurs="0"/>
      <xs:element name="Ledger" type="TxnLedgerType"/>
      <xs:element name="BalanceValue" type="xs:decimal" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>
