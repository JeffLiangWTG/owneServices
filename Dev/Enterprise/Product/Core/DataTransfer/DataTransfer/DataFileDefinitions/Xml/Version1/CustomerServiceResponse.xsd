<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="Elements.xsd" />
	<xs:include schemaLocation="CustomerService.xsd" />
	<xs:complexType name="CustomerServiceResponse">
		<xs:sequence>
			<xs:element name="PK" type="xs:string" minOccurs="0" />
			<xs:element name="ClientReferenceNumber" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentNumber" type="xs:string" />
			<xs:element name="LicenceCode" type="xs:string" />
			<xs:element name="Status" type="xs:string" />
			<xs:element name="Module" type="xs:string" minOccurs="0" />
			<xs:element name="Criticality" type="xs:string" minOccurs="0" />
			<xs:element name="ModuleDescription" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentSummary" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentDetails" type="xs:string" minOccurs="0" />
			<xs:element name="ContactEmailAddress" type="xs:string" minOccurs="0" />
			<xs:element name="SystemReservedEmailAddresses" type="xs:string" minOccurs="0" />
			<xs:element name="SentTimeUtc" type="xs:string" minOccurs="0" />
			<xs:element name="Action" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentConversationUpdate" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Message" type="ConversationMessage" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="IncidentEmails" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Email" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Subject" type="xs:string" />
									<xs:element name="Body" type="xs:string" />
									<xs:element name="ToEmailAddress" type="xs:string" minOccurs="0" />
									<xs:element name="Cc" type="xs:string" minOccurs="0" />
									<xs:element name="Attachments" minOccurs="0">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="Attachment" maxOccurs="unbounded">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="FileName" type="xs:string" />
															<xs:element name="Data" type="xs:base64Binary" />
														</xs:sequence>
													</xs:complexType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Attachments" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Attachment" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="FileName" type="xs:string" />
									<xs:element name="Data" type="xs:base64Binary" />
									<xs:element name="DocType" type="xs:string" />
									<xs:element name="DocTypeDescription" type="xs:string" minOccurs="0" />
									<xs:element name="Desc" type="xs:string" />
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>