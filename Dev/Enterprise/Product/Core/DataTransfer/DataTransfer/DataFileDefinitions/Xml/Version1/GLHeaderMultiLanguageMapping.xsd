							<xs:element name="Language" type="xs:string"/>
							<xs:element name="LocalAccountNumber" type="xs:string"/>
							<xs:element name="Description" type="xs:string"/>
							<xs:element name="DebitCredit" type="xs:string"/>
							<xs:element name="ParentAccount" type="xs:string"/>
							<xs:element name="ReportType" type="xs:string"/>
