<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="Elements.xsd" />
	<xs:include schemaLocation="CustomerService.xsd" />
	<xs:complexType name="CustomerServiceRequest">
		<xs:sequence>
			<xs:element name="PK" type="xs:string" minOccurs="0" />
			<xs:element name="ClientReferenceNumber" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentNumber" type="xs:string" minOccurs="0" />
			<xs:element name="LicenceCode" type="xs:string" minOccurs="0" />
			<xs:element name="CompanyCode" type="xs:string" minOccurs="0" />
			<xs:element name="CompanyName" type="xs:string" minOccurs="0" />
			<xs:element name="CompanyCountry" type="xs:string" minOccurs="0" />
			<xs:element name="DatabaseNumber" type="xs:int" minOccurs="0" />
			<xs:element name="Password" type="xs:string" minOccurs="0" />
			<xs:element name="ReportingStaffMemberName" type="xs:string" />
			<xs:element name="ReportingStaffEmail" type="xs:string" minOccurs="0" />
			<xs:element name="Product" type="xs:string" minOccurs="0" />
			<xs:element name="Module" type="xs:string" minOccurs="0" />
			<xs:element name="ActiveModuleId" type="xs:string" minOccurs="0" />
			<xs:element name="Language" type="xs:string" minOccurs="0" />
			<xs:element name="Criticality" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentSummary" type="xs:string" />
			<xs:element name="IncidentDetails" type="xs:string" minOccurs="0" />
			<xs:element name="Status" type="xs:string" minOccurs="0" />
			<xs:element name="Action" type="xs:string" minOccurs="0" />
			<xs:element name="SentTimeUtc" type="xs:string" minOccurs="0" />
			<xs:element name="LastSyncTimeUtc" type="xs:string" minOccurs="0" />
			<xs:element name="OriginalCriticality" type ="xs:string" minOccurs="0" />
			<xs:element name="OriginalIncidentSummary" type="xs:string" minOccurs="0" />
			<xs:element name="OriginalIncidentDetails" type="xs:string" minOccurs="0" />
			<xs:element name="OriginalStatus" type ="xs:string" minOccurs="0" />
			<xs:element name="OriginalModule" type="xs:string" minOccurs="0" />
			<xs:element name="CurrentStaffQueryString" type="xs:string" minOccurs="0" />
			<xs:element name="IncidentConversationUpdate" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Message" type="ConversationMessage" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ConversationMessageRatingUpdate" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Raing" type="ConversationMessageRating" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Attachments" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Attachment" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="FileName" type="xs:string" />
									<xs:element name="Data" type="xs:base64Binary" />
									<xs:element name="DocType" type="xs:string" />
									<xs:element name="Desc" type="xs:string" />
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Staff">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Staff" type="OrgContact" maxOccurs="unbounded" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ApprovingUser" type="xs:string" />
			<xs:element name="ApprovingUserEmail" type="xs:string" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>
</xs:schema>