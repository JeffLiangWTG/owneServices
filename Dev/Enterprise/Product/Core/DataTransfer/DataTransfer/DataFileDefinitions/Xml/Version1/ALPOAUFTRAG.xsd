<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">
	<xs:element name="ZusatzAngaben">
		<xs:annotation>
			<xs:documentation>addtional information transport items</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="TransportTemp" minOccurs="0"/>
				<xs:element ref="Freistellnummer" minOccurs="0"/>
				<xs:element ref="OrderNummer" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Zolldaten">
		<xs:annotation>
			<xs:documentation>flag for kind data for customs</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="BHT"/>
				<xs:enumeration value="ZAPP"/>
				<xs:enumeration value="ZAPP-AES"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ZollamtGeprueft">
		<xs:annotation>
			<xs:documentation>checked by customs office</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="True"/>
				<xs:enumeration value="False"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ZollZaehler" type="xs:int">
		<xs:annotation>
			<xs:documentation>counter for custom segments</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ZollPositionen">
		<xs:annotation>
			<xs:documentation>customs items</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence maxOccurs="999">
				<xs:element ref="ZollDaten"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ZollPosZaehler" type="xs:int">
		<xs:annotation>
			<xs:documentation>counter customs items</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ZollPos" type="xs:int">
		<xs:annotation>
			<xs:documentation>custom item / position at custom document</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ZollDaten">
		<xs:annotation>
			<xs:documentation>customs data</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ZollPosZaehler" minOccurs="0"/>
				<xs:element ref="AESZollDaten" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Zeit" type="xs:string">
		<xs:annotation>
			<xs:documentation>time</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Zaehler" type="xs:int">
		<xs:annotation>
			<xs:documentation>counter</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Wert">
		<xs:annotation>
			<xs:documentation>amount</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:decimal"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Wassergefaehrdungsklasse">
		<xs:annotation>
			<xs:documentation>water dangerous class</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:length value="1"/>
				<xs:enumeration value="0"/>
				<xs:enumeration value="1"/>
				<xs:enumeration value="2"/>
				<xs:enumeration value="3"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Warenrichtung">
		<xs:annotation>
			<xs:documentation>transport direction</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="Export"/>
				<xs:enumeration value="Import"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Warenbeschreibung">
		<xs:annotation>
			<xs:documentation>good description</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="240"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="WarenWert">
		<xs:annotation>
			<xs:documentation>good value</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value=""/>
				<xs:enumeration value="> 1000 €"/>
				<xs:enumeration value="> 3000 €"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="WarenVerpackungsDaten">
		<xs:annotation>
			<xs:documentation>equipment and goods data</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Zaehler"/>
				<xs:element ref="Bemerkungen" minOccurs="0"/>
				<xs:element ref="Gefahrgut">
					<xs:annotation>
						<xs:documentation>flag dangerous good</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Spezifikation" minOccurs="0"/>
				<xs:element ref="WarenPositionen" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="WarenPositionen">
		<xs:annotation>
			<xs:documentation>good items</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence maxOccurs="999">
				<xs:element ref="WarenDaten"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="WarenPosKomplett">
		<xs:annotation>
			<xs:documentation>good position complete (AES)</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="True"/>
				<xs:enumeration value="False"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="WarenPos" type="xs:int">
		<xs:annotation>
			<xs:documentation>good item</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="WarenDaten">
		<xs:annotation>
			<xs:documentation>goods data</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Zaehler"/>
				<xs:element ref="Bemerkungen" minOccurs="0"/>
				<xs:element ref="Gefahrgut"/>
				<xs:element ref="Markierung" minOccurs="0"/>
				<xs:element ref="WarenAngaben" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="WarenAngaben">
		<xs:annotation>
			<xs:documentation>good information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Anzahl"/>
				<xs:element ref="VerpackungsArt" minOccurs="0"/>
				<xs:element ref="Warenbeschreibung"/>
				<xs:element ref="BLGWaCo" minOccurs="0"/>
				<xs:element ref="MarksNos" minOccurs="0"/>
				<xs:element ref="FahrzeugID" minOccurs="0"/>
				<xs:element ref="MasseGewichte" minOccurs="0"/>
				<xs:element ref="Umschlagshinweise" minOccurs="0"/>
				<xs:element ref="ZusatzAngaben" minOccurs="0"/>
				<xs:element ref="GefahrgutPositionen" minOccurs="0"/>
				<xs:element ref="ZollPositionen" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Vorpapier">
		<xs:annotation>
