				<xs:enumeration value="Gefahrgut Vermerke"/>
				<xs:enumeration value="besondere Vermerke"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Verkehrstraeger">
		<xs:annotation>
			<xs:documentation>transport type</xs:documentation>
