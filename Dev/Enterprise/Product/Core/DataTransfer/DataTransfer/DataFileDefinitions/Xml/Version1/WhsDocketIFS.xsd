<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSPY v2004 rel. 3 U (http://www.xmlspy.com) by Richard White (Eagle Datamation International) --><xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">	<xs:element name="ConNotes" type="ConNotes"/>	<xs:complexType name="ConNotes">		<xs:sequence>			<xs:element name="ConNote" type="ConNote" maxOccurs="unbounded"/>		</xs:sequence>	</xs:complexType>	<xs:complexType name="ConNote">		<xs:sequence>            <xs:element name="ConNo" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>ConNote Number.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="ConPrfx" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>ConNote Prefix.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="RecAccNo" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Receiver Account Number or Debtor Code. Each Receiver must have a unique number.</xs:documentation>				</xs:annotation>			</xs:element>            <xs:element name="RecName" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Consignee (eg. Geoff).</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="AdHocRec" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Ad Hoc Receiver (if you do not wish address to be added permanently to receiver database in SmartFreight}. Default of 'N' will add the address.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="RecAddr" type="RecAddr" minOccurs="0"/>            <xs:element name="SendName" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Client (eg. Myer).</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="SendAddr" type="RecAddr" minOccurs="0"/>            <xs:element name="ChargeTo" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Charge to Sender (S); Receiver (R); Third Party (T).</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="CarrierName" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Must match SmartFreight list.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="AccNo" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Carrier Account No.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="Service" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Carrier Service Level. Must match SmartFreight list.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name ="TpyAdHoc" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Ad Hoc Third Party (if you do not wish address to be added permanently to receiver database in SmartFreight}. Default of 'N' will add the address.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="TpyAccNo" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Third Party Account Number or Debtor Code.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="TpyName" type="xs:string" minOccurs="0">                <xs:annotation>                    <xs:documentation>Name of the Third Party who is paying the freight costs.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="TpyAddr" type="RecAddr" minOccurs="0"/>            <xs:element name="TotCost" type="xs:decimal" minOccurs="0">                <xs:annotation>                    <xs:documentation>Total Cost for Consignment.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="TotCostPlusMrkup" type="xs:decimal" minOccurs="0">                <xs:annotation>                    <xs:documentation>Total Cost for Consignment plus Markup.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:element name="SpIns" type="SpecialInstructions" minOccurs="0">                <xs:annotation>                    <xs:documentation>Special Instructions.</xs:documentation>                </xs:annotation>            </xs:element>            <xs:sequence>				<xs:element name="FreightLineDetails" type="FreightLineDetails" maxOccurs="5"/>			</xs:sequence>		</xs:sequence>	</xs:complexType>	<xs:complexType name="ConNoteObject">		<xs:sequence>			<xs:element name="ConNote" type="ConNote" maxOccurs="unbounded"/>		</xs:sequence>	</xs:complexType>	<xs:complexType name="FreightLineDetails">		<xs:sequence>			<xs:element name="Ref" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Sender Reference eg. Customer Order No., Picking Slip No., Invoice No.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Desc" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Description, eg. "BAG". Must match a SmartFreight list.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Amt" type="xs:int" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Count.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Wgt" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Weight.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Cube" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Volume.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Len" type="xs:decimal" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Length. Currently not used in CargoWise One.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Hgt" type="xs:decimal" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Height. Currently not used in CargoWise One.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Wdt" type="xs:decimal" minOccurs="0">				<xs:annotation>					<xs:documentation>Unit Width. Currently not used in CargoWise One.</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>	</xs:complexType>	<xs:complexType name="SpecialInstructions">		<xs:sequence>			<xs:element name="Sp1" type="xs:string">				<xs:annotation>					<xs:documentation>Special Instructions #1.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Sp2" type="xs:string">				<xs:annotation>					<xs:documentation>Special Instructions #2.</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="Sp3" type="xs:string">				<xs:annotation>					<xs:documentation>Special Instructions #3.</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>	</xs:complexType>	<xs:complexType name="RecAddr">		<xs:sequence>			<xs:element name="add1" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Address Line #1 (mandatory).</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="add2" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Address Line #2. (mandatory for SendAddr)</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="add3" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Town / Suburb (mandatory).</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="add4" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>State (mandatory, must match list).</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="add5" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>PostCode (mandatory, must match list).</xs:documentation>				</xs:annotation>			</xs:element>			<xs:element name="add6" type="xs:string" minOccurs="0">				<xs:annotation>					<xs:documentation>Country</xs:documentation>				</xs:annotation>			</xs:element>		</xs:sequence>	</xs:complexType></xs:schema>