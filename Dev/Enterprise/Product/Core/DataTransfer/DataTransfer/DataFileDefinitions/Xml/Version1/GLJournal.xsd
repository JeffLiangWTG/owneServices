<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="Elements.xsd"/>
	<xs:element name="GLJournals">
		<xs:annotation>
			<xs:documentation>Comment describing your root element</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="GLJournal" type="GLJournal" maxOccurs="unbounded"></xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="GLJournal" type="GLJournal" />
	<xs:complexType name="GLJournal">
		<xs:sequence>
			<xs:element name="GLDetail">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="JournalType">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:enumeration value="GJL"/>
									<xs:enumeration value="AJL"/>
									<xs:enumeration value="RJL"/>
									<xs:enumeration value="NJL"/>
									<xs:enumeration value="FCB"/>
							</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="JournalNumber" type="xs:string" minOccurs="0"/>
						<xs:element name="Presentation" type="xs:NMTOKEN" minOccurs="0"/>
						<xs:element name="Description" type="xs:string" minOccurs="0"/>
						<xs:element name="InPeriod" type="xs:NMTOKEN" minOccurs="0"/>
						<xs:element name="InPeriodDate" type="xs:date" minOccurs="0"/>
						<xs:element name="OutPeriod" type="xs:NMTOKEN" minOccurs="0"/>
						<xs:element name="OutPeriodDate" type="xs:date" minOccurs="0"/>
						<xs:element name="Branch" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:maxLength value="3"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="Department" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:NMTOKEN">
									<xs:maxLength value="3"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="JournalLines">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="JournalLine" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Account">
										<xs:simpleType>
											<xs:restriction base="xs:NMTOKEN">
												<xs:maxLength value="10"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Branch" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:NMTOKEN">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Department" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:NMTOKEN">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Description" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="50"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="Amount" type="MonetaryAmount" minOccurs="0"/>
									<xs:element name="LocalAmount" type="MonetaryAmount"/>
									<xs:element name="DRCR">
										<xs:simpleType>
											<xs:restriction base="xs:NMTOKEN">
												<xs:enumeration value="DR"/>
												<xs:enumeration value="CR"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="SubAccount" type="SubAccount" minOccurs="0" />
									<xs:element name="Currency" type="xs:NMTOKEN" minOccurs="0" />
									<xs:element name="ExchangeRate" type="xs:decimal" minOccurs="0" />
									<xs:element name="Organisation" type="Organisation" minOccurs="0" />
									<xs:element name="PK" type="Guid" minOccurs="0" />
									<xs:element name="SubAccounts">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="SubAccount" type="SubAccount" maxOccurs="unbounded" />
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="ORG" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="20"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="OCG" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="LFO" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="LFE" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TIC" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="SPR" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
