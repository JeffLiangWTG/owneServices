<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.edi.com.au/EnterpriseService/" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:include schemaLocation="Elements.xsd"/>
  <xs:element name="GLHeaders">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="GLHeader" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="AccNumber" type="xs:string"/>
              <xs:element name="DebitCredit" type="xs:string"/>
              <xs:element name="Description" type="xs:string"/>
              <xs:element name="AccountType" type="xs:string"/>
              <xs:element name="PercentNum" type="xs:string"/>
              <xs:element name="ConsolidationNum" type="xs:string"/>
              <xs:element name="AlternateNum" type="xs:string"/>
              <xs:element name="HeaderDependsOnTotal" type="xs:string"/>
              <xs:element name="TotalLevel" type="xs:int" default="0"/>
              <xs:element name="ControlAccount" type="xs:string"/>
              <xs:element name="DisallowDirectPosting" type="xs:string"/>
              <xs:element name="PrintSequence" type="xs:int" default="0"/>
              <xs:element name="Section" type="xs:string"/>
              <xs:element name="SubAccountType">
                <xs:simpleType>
                  <xs:restriction base="xs:NMTOKEN">
                    <xs:length value="3" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="IsSubAccountMandatory" type="xs:string"/>
              <xs:element name="CashFlowType">
                <xs:simpleType>
                  <xs:restriction base="xs:NMTOKEN">
                    <xs:length value="3" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="CompanyFilterList" type="xs:string" default="ALL"/>
              <xs:element name="StatisticalUnits" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
