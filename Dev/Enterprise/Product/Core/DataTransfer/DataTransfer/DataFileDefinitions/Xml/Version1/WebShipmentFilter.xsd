<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="Elements.xsd"/>
	<xs:element name="WebShipmentFilter">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Number" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="NumberSearchField" type="ShipmentNumberFieldsList" default="ALL"/>
							<xs:element name="NumberValue" type="xs:NMTOKEN"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Status" type="ShipmentStatusList" minOccurs="0"/>
				<xs:element name="Date" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DateSearchField" type="ShipmentDateFieldsList" default="ALL"/>
							<xs:element name="FromDate" type="xs:date"/>
							<xs:element name="ToDate" type="xs:date"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Organisation" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="OrganisationSearchField" type="ShipmentOrganisationFieldsList" default="ALL"/>
							<xs:element name="Organisation1" type="xs:NMTOKEN"/>
							<xs:element name="Organisation2" type="xs:NMTOKEN"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Location" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="LocationSearchField" type="ShipmentLocationFieldsList" default="ALL"/>
							<xs:element name="Location1" type="UNLOCO"/>
							<xs:element name="Location2" type="UNLOCO"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="VoyageFlight" type="xs:NMTOKEN" minOccurs="0"/>
				<xs:element name="Vessel" type="xs:normalizedString" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="Version" type="Version" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="ShipmentNumberFieldsList">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="ALL"/>
			<xs:enumeration value="Common"/>
			<xs:enumeration value="ShipmentNumber"/>
			<xs:enumeration value="HouseBill"/>
			<xs:enumeration value="ConsolNumber"/>
			<xs:enumeration value="MasterBillNumber"/>
			<xs:enumeration value="ClientReference"/>
			<xs:enumeration value="OrderNumber"/>
			<xs:enumeration value="InterimReceiptNumber"/>
			<xs:enumeration value="PackRefNumber"/>
			<xs:enumeration value="ContainerNo"/>
			<xs:enumeration value="DirectMAWB"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ShipmentDateFieldsList">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="ALL"/>
			<xs:enumeration value="ETA"/>
			<xs:enumeration value="ETD"/>
			<xs:enumeration value="Tranship"/>
			<xs:enumeration value="Forward"/>
			<xs:enumeration value="FirstArrivalPort"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ShipmentOrganisationFieldsList">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="ALL"/>
			<xs:enumeration value="ShipperConsignee"/>
			<xs:enumeration value="SendingReceivingAgent"/>
			<xs:enumeration value="ExportBrokerCartage"/>
			<xs:enumeration value="ImportBrokerCartage"/>
			<xs:enumeration value="DeliveryAgent"/>
			<xs:enumeration value="TranshipAgent"/>
			<xs:enumeration value="ConsolSendingRecvAgent"/>
			<xs:enumeration value="ShipmentSendingRecvAgent"/>
			<xs:enumeration value="ConsignorRelatedParties"/>
			<xs:enumeration value="ConsigneeRelatedParties"/>
			<xs:enumeration value="LocalClientRelatedParties"/>
			<xs:enumeration value="PickupAgent"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ShipmentStatusList">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="ALL"/>
			<xs:enumeration value="Delivered"/>
			<xs:enumeration value="Undelivered"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ShipmentLocationFieldsList">
		<xs:restriction base="xs:NMTOKEN">
			<xs:enumeration value="ALL"/>
			<xs:enumeration value="ShipmentOriginDestination"/>
			<xs:enumeration value="ConsolLoadDischarge"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
