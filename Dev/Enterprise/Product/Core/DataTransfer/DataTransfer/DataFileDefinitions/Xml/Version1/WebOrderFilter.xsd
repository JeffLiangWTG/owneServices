<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.edi.com.au/EnterpriseService/" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:include schemaLocation="Elements.xsd" />
  <xs:element name="WebOrderFilter">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Number" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="NumberSearchField" type="OrderNumberFieldsList" default="ALL" />
              <xs:element name="NumberValue" type="xs:NMTOKEN" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Date" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="DateSearchField" type="OrderDateFieldsList" default="ALL" />
              <xs:element name="FromDate" type="xs:date" />
              <xs:element name="ToDate" type="xs:date" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Organisation" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="OrganisationSearchField" type="OrderOrganisationFieldsList" default="ALL" />
              <xs:element name="Organisation1" type="xs:NMTOKEN" />
              <xs:element name="Organisation2" type="xs:NMTOKEN" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Location" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="LocationSearchField" type="OrderLocationFieldsList" default="ALL" />
              <xs:element name="Location1" type="UNLOCO" />
              <xs:element name="Location2" type="UNLOCO" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="VoyageFlight" type="xs:NMTOKEN" minOccurs="0" />
        <xs:element name="Vessel" type="xs:normalizedString" minOccurs="0" />
        <xs:element name="OrderStatus" type="StatusCode" minOccurs="0" default="ALL" />
      </xs:sequence>
      <xs:attribute name="Version" type="Version" use="optional" />
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="OrderNumberFieldsList">
    <xs:restriction base="xs:NMTOKEN">
      <xs:enumeration value="ALL" />
      <xs:enumeration value="Common" />
      <xs:enumeration value="OrderNumber" />
      <xs:enumeration value="ConfirmNumber" />
      <xs:enumeration value="InvoiceNumber" />
      <xs:enumeration value="MasterBillNumber" />
      <xs:enumeration value="HouseBill" />
      <xs:enumeration value="ProductNumber" />
      <xs:enumeration value="ShipmentNumber" />
      <xs:enumeration value="ContainerNumber" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OrderDateFieldsList">
    <xs:restriction base="xs:NMTOKEN">
      <xs:enumeration value="ALL" />
      <xs:enumeration value="Common" />
      <xs:enumeration value="ReqInStore" />
      <xs:enumeration value="ReqExWorks" />
      <xs:enumeration value="OrderDate" />
      <xs:enumeration value="ConfirmedDate" />
      <xs:enumeration value="ShipmentWindowStart" />
      <xs:enumeration value="ShipmentWindowEnd" />
      <xs:enumeration value="ETA" />
      <xs:enumeration value="ETD" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OrderOrganisationFieldsList">
    <xs:restriction base="xs:NMTOKEN">
      <xs:enumeration value="ALL" />
      <xs:enumeration value="SendingReceivingAgent" />
      <xs:enumeration value="BuyerSupplier" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OrderLocationFieldsList">
    <xs:restriction base="xs:NMTOKEN">
      <xs:enumeration value="ALL" />
      <xs:enumeration value="ShipmentOriginDestination" />
      <xs:enumeration value="ConsolLoadDischarge" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
