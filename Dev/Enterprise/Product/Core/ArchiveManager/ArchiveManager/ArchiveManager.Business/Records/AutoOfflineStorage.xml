<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="OfflineStorage"
>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx
	-->
	<DateTimeColumn>
		<Name>ArchiveDateTo</Name>
	</DateTimeColumn>  
	<StringColumn>
		<Name>OfflineLocation</Name>
		<MaxLength>255</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>ConfirmationLabel</Name>
		<MaxLength>800</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>
	<IntColumn>
		<Name>StorageCapacityRequiredInMB</Name>
		<GenerateValidation>false</GenerateValidation>
	</IntColumn>
	<IntColumn>
		<Name>StorageMainRecordsForArchiving</Name>
	</IntColumn>
	<IntColumn>
		<Name>FreeSpaceInMB</Name>
	</IntColumn>
</NonPersistentBusinessObject>