<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <ApplicationIcon>Fax.ico</ApplicationIcon>
    <AssemblyName>Enterprise.FaxRouter</AssemblyName>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Enterprise.FaxRouter</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationManifest>..\..\..\..\..\main.manifest</ApplicationManifest>
    <PostBuildEvent>xcopy /y "$(MSBuildProjectDirectory)\Fax.ico" $(TargetDir)</PostBuildEvent>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="Enterprise.Initialisation" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Manager\Manager.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
    <Content Include="Fax.ico" />
  </ItemGroup>
</Project>