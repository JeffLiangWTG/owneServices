<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AssemblyName>Enterprise.DbBackupAndRestore</AssemblyName>
    <OutputType>Exe</OutputType>
    <RootNamespace>Enterprise.DataTools.DbBackupAndRestore</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationManifest>..\..\..\..\..\..\main.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="System.CommandLine" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
    <None Include="..\..\..\..\Main\Enterprise.Main\App.config">
      <Link>App.config</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DbBackupAndRestore.GUI\DbBackupAndRestore.GUI.csproj" />
    <ProjectReference Include="..\DbBackupAndRestore.Business\DbBackupAndRestore.Business.csproj" />
  </ItemGroup>
</Project>