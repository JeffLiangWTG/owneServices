<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.UniversalDataBuss.Integration</RootNamespace>
    <AssemblyName>Enterprise.UniversalDataBuss.Integration</AssemblyName>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.Messaging.Integration" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Resources" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DataObjects\ServiceCodesList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ServiceCodesList.xml</DependentUpon>
    </Compile>
    <Compile Update="EDIMessage\EDIMessageContentPrimaryDataSource.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EDIMessageContentPrimaryDataSource.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="DataObjects\ServiceCodesList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ServiceCodesList.cs</LastGenOutput>
    </None>
    <None Update="EDIMessage\EDIMessageContentPrimaryDataSource.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>EDIMessageContentPrimaryDataSource.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.UniversalDataBuss.Integration</CustomToolNamespace>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>