<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.EventReference" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.IO" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Tools.Telephony" />
    <Reference Include="CargoWise.Windows.UI" />
    <Reference Include="Enterprise.Billing.Integration" />
    <Reference Include="Enterprise.DocumentEngine" />
    <Reference Include="Enterprise.DocumentEngineCore" />
    <Reference Include="Enterprise.DocumentEngineIntegration" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Faxing.Integration" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterData.Common" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.PrintProcessing" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="Enterprise.Scheduler.Business" />
    <Reference Include="Enterprise.ServiceManager.Shared" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="Enterprise.ZArchitecture.GUI" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Microsoft.Practices.EnterpriseLibrary.TransientFaultHandling" />
    <Reference Include="RemotePrinting.Engine" />
    <Reference Include="Resources" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="ServiceManager.Integration.Abstractions" />
    <Reference Include="ServiceManager.Integration.ServiceTasks.CW" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="FtpJobConfig\AutoFtpJobConfig.cs">
      <DependentUpon>AutoFtpJobConfig.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="FaxConfigObj\AutoFaxConfigObj.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoFaxConfigObj.xml</DependentUpon>
    </Compile>
    <Compile Update="FaxConfigObj\AutoFaxPortConfigObj.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoFaxPortConfigObj.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="FaxConfigObj\AutoFaxConfigObj.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoFaxConfigObj.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Tasks.PrintJobProcessor</CustomToolNamespace>
    </None>
    <None Update="FaxConfigObj\AutoFaxPortConfigObj.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <CustomToolNamespace>Enterprise.ServiceManager.Tasks.PrintJobProcessor</CustomToolNamespace>
      <LastGenOutput>AutoFaxPortConfigObj.cs</LastGenOutput>
    </None>
    <None Update="FtpJobConfig\AutoFtpJobConfig.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoFtpJobConfig.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Tasks.PrintJobProcessor</CustomToolNamespace>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>