<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CWNetCoreTargetFramework);net48</TargetFrameworks>
    <RootNamespace>Enterprise.ServiceManager.Runner</RootNamespace>
    <AssemblyName>ServiceManager.Runner.CW</AssemblyName>
    <TargetName>ServiceManager.Runner.CW</TargetName>
    <ApplicationManifest>$(WTGBranchRoot)main.manifest</ApplicationManifest>
    <ApplicationIcon>..\ServiceManager.Runner\Runner.ico</ApplicationIcon>
    <StartupObject>Enterprise.ServiceManager.Runner.Program</StartupObject>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
