      <Link>App.config</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\..\Product\Main\Enterprise.Main\CargoWiseOneProjects\applog.json" LogicalName="WTG.ApplicationLogging.applog.json" />
