<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CWNetCoreTargetFramework);net48</TargetFrameworks>
    <RootNamespace>Enterprise.ServiceManager.Business</RootNamespace>
    <AssemblyName>Enterprise.ServiceManager.Business</AssemblyName>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Async" />
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="ServiceManager.Integration.NudgingClient.Abstractions" />
    <Reference Include="ServiceManager.Integration.NudgingClient" />
    <Reference Include="ServiceManager.Integration.ServiceHostClient.Abstractions" />
    <Reference Include="ServiceManager.Integration.ServiceHostClient" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Elasticsearch.Net" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Scheduler.Business" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Nest" />
    <Reference Include="Resources" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="ServiceTask\AutoStmServiceTaskAdapter.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AutoStmServiceTaskAdapter.xml</DependentUpon>
    </Compile>
    <Compile Update="StmServiceHost\StmServiceHostStatusTypes.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>StmServiceHostStatusTypes.xml</DependentUpon>
      <CustomToolNamespace />
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="ServiceInstall\AutoServiceInstallInfo.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoServiceInstallInfo.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Business</CustomToolNamespace>
    </None>
    <None Update="ServiceTaskLogViewer\AutoEventRecord.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoEventRecord.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Business</CustomToolNamespace>
    </None>
    <None Update="ServiceTaskLogViewer\AutoLogFileRecord.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoLogFileRecord.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Business</CustomToolNamespace>
    </None>
    <None Update="ServiceTaskLogViewer\AutoSendToAddress.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoSendToAddress.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Business</CustomToolNamespace>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceManager.Integration.CW\ServiceManager.Integration.CW.csproj" />
    <ProjectReference Include="..\ServiceManager.Logging.Abstractions\ServiceManager.Logging.Abstractions.csproj" />
    <ProjectReference Include="..\ServiceManager.Logging.CW\ServiceManager.Logging.CW.csproj" />
    <ProjectReference Include="..\ServiceManager.Shared.CW\ServiceManager.Shared.CW.csproj" />
    <ProjectReference Include="..\ServiceManager.Shared\ServiceManager.Shared.csproj" />
    <ProjectReference Include="..\ServiceManager.Shared.Abstractions\ServiceManager.Shared.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ServiceTask\AutoStmServiceTaskAdapter.xml">
      <CustomToolNamespace>Enterprise.ServiceManager.Business</CustomToolNamespace>
      <LastGenOutput>AutoStmServiceTaskAdapter.cs</LastGenOutput>
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
    </None>
    <None Update="StmServiceHost\StmServiceHostStatusTypes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>StmServiceHostStatusTypes.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.ServiceManager.Business</CustomToolNamespace>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>