<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</RootNamespace>
    <AssemblyName>Enterprise.BufferManagement.NetworkVisualisation.Business</AssemblyName>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Definitions"/>
    <Reference Include="CargoWise.NetworkVisualisation.Business" />
    <Reference Include="CargoWise.NetworkVisualisation.Integration" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="CargoWise.Async" />
    <Reference Include="CargoWise.CalendarArithmetic" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.PAVE.Common.Implementation" />
    <Reference Include="CargoWise.PAVE.Common.Interfaces" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="CargoWise.UniversalCopy" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="QuikGraph" />
    <Reference Include="Resources" />
    <Reference Include="WeakEventListener" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Attachment\AttachmentTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AttachmentTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="LevelingRule\LevelingRuleTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LevelingRuleTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="Network\Scale\ScaleUnitList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ScaleUnitList.xml</DependentUpon>
    </Compile>
    <Compile Update="Shape\ScrollPositionList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ScrollPositionList.xml</DependentUpon>
    </Compile>
    <Compile Update="Shape\ShapeStatusList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ShapeStatusList.xml</DependentUpon>
    </Compile>
    <Compile Update="Shape\ApprovedDiagramTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ApprovedDiagramTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="Shape\ShapeDerivatives\BufferTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>BufferTypeList.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Main\Business\BufferManagement.Business.csproj" />
    <ProjectReference Include="..\..\Main\Integration\BufferManagement.Integration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shape\BMNCNShapeResourceStrings.xml" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Attachment\BMNCNAttachmentResourceStrings.xml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Attachment\AttachmentTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>AttachmentTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
    </None>
    <EmbeddedResource Include="Schedule\BMNCNScheduleResourceStrings.xml" />
    <EmbeddedResource Include="LevelingRule\BMNCNLevelingRuleResourceStrings.xml" />
    <EmbeddedResource Include="LevelingRuleChannelLink\BMNCNLevelingRuleChannelLinkResourceStrings.xml" />
    <None Update="LevelingRule\LevelingRuleTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>LevelingRuleTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
    </None>
    <None Update="Network\Scale\ScaleUnitList.xml">
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ScaleUnitList.cs</LastGenOutput>
    </None>
    <None Update="Shape\ApprovedDiagramTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ApprovedDiagramTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
    </None>
    <None Update="Shape\ScrollPositionList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ScrollPositionList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
    </None>
    <None Update="Shape\ShapeDerivatives\BufferTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>BufferTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
    </None>
    <None Update="Shape\ShapeStatusList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Business</CustomToolNamespace>
      <LastGenOutput>ShapeStatusList.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ServiceManager.Integration.ServiceTasks.CW" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
</Project>