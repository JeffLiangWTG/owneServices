<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.BufferManagement.NetworkVisualisation.Module</RootNamespace>
    <AssemblyName>Enterprise.BufferManagement.NetworkVisualisation.Module</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Compile Update="NetworkDiagram\NetworkDiagramStatusFilterList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NetworkDiagramStatusFilterList.xml</DependentUpon>
    </Compile>
    <Compile Update="NetworkDiagram\NetworkDiagramScaledFilterOptions.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NetworkDiagramScaledFilterOptions.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="NetworkDiagram\NetworkDiagramScaledFilterOptions.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>NetworkDiagramScaledFilterOptions.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Module</CustomToolNamespace>
    </None>
    <None Update="NetworkDiagram\NetworkDiagramStatusFilterList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>NetworkDiagramStatusFilterList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.NetworkVisualisation.Module</CustomToolNamespace>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Main\Module\BufferManagement.Module.csproj" />
    <ProjectReference Include="..\NCN.GUI\BufferManagement.NetworkVisualisation.GUI.csproj" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>