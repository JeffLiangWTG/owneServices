<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CWNetCoreTargetFramework);net48</TargetFrameworks>
    <RootNamespace>Enterprise.TimeEngineScheduler.Integration</RootNamespace>
    <AssemblyName>Enterprise.TimeEngineScheduler.Integration</AssemblyName>

    <!-- TODO: figure out why xml serialization generation is not happy in net8. See: WI00874705 - Investigate Xml Serialization failing in net core -->
    <CWGenerateXmlSerializationAssemblies Condition="$(TargetFramework.StartsWith('net4'))">true</CWGenerateXmlSerializationAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Definitions"/>
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Integration" />
  </ItemGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
</Project>