<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.BufferManagement.Module</RootNamespace>
    <AssemblyName>Enterprise.BufferManagement.Module</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Design" />
    <Reference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BMBoard\GlobalStatusList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>GlobalStatusList.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessHeader\Filters\DeadlineTypeFilterTypeList.cs">
      <DependentUpon>DeadlineTypeFilterTypeList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="ProcessHeader\Filters\QualityIterationFilterTypeList.cs">
      <DependentUpon>QualityIterationFilterTypeList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="JobOrWorkflow.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>JobOrWorkflow.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessHeader\Filters\TaskAssignmentTypeFilterList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TaskAssignmentTypeFilterList.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessHeader\Filters\LeadTimeRangeTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LeadTimeRangeTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessHeader\Filters\ScopeRangeList.cs">
      <DependentUpon>ScopeRangeList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="ProcessHeader\Filters\TaskAssignedOrdinalityFilterList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TaskAssignedOrdinalityFilterList.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessHeader\Filters\TaskStatusAggregatorList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TaskStatusAggregatorList.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\VisualBoards\VisualBoards.GUI\VisualBoards.GUI.csproj" />
    <ProjectReference Include="..\GUI\BufferManagement.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Enterprise.CustomerService.Business" />
  </ItemGroup>
  <ItemGroup>
    <None Update="BMBoard\GlobalStatusList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>GlobalStatusList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="JobOrWorkflow.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>JobOrWorkflow.cs</LastGenOutput>
    </None>
    <None Update="ProcessHeader\Filters\DeadlineTypeFilterTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>DeadlineTypeFilterTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessHeader\Filters\QualityIterationFilterTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>QualityIterationFilterTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessHeader\Filters\LeadTimeRangeTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>LeadTimeRangeTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessHeader\Filters\ScopeRangeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ScopeRangeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessHeader\Filters\TaskStatusAggregatorList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TaskStatusAggregatorList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessHeader\Filters\TaskAssignedOrdinalityFilterList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TaskAssignedOrdinalityFilterList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessHeader\Filters\TaskAssignmentTypeFilterList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TaskAssignmentTypeFilterList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Module</CustomToolNamespace>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>