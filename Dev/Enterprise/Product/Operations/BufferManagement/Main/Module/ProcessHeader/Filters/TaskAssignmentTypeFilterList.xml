<?xml version="1.0" encoding="utf-8" ?>
<CodeDescriptionPairList
	xmlns="http://www.edi.com.au/CodeDescriptionPairList.xsd"
	xmlns:cdpl="http://www.edi.com.au/CodeDescriptionPairList.xsd"
	cdpl:Sort="true">
	
	<Item>
		<Identifier>Either</Identifier>
		<Code>EIT</Code>
		<Description>Match tasks assigned to either resources or capabilities.</Description>
	</Item>

	<Item>
		<Identifier>Both</Identifier>
		<Code>BOT</Code>
		<Description>Match tasks assigned to both resources and capabilities.</Description>
	</Item>

	<Item>
		<Identifier>Resources</Identifier>
		<Code>RES</Code>
		<Description>Match tasks assigned to resources.</Description>
	</Item>

	<Item>
		<Identifier>Capabilities</Identifier>
		<Code>CAP</Code>
		<Description>Match tasks assigned to capabilities.</Description>
	</Item>

	<Item>
		<Identifier>Unassigned</Identifier>
		<Code>UNA</Code>
		<Description>Match unassigned tasks.</Description>
	</Item>

</CodeDescriptionPairList>