<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.BufferManagement.Integration</RootNamespace>
    <AssemblyName>Enterprise.BufferManagement.Integration</AssemblyName>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.NetworkVisualisation.Integration" />
    <Reference Include="CargoWise.PAVE.Common.Interfaces" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="Enterprise.Security.Core" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="Resources" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Network\ShapeTypeList.cs">
      <DependentUpon>ShapeTypeList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="SystemSchematic\BMComponentTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>BMComponentTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="ChannelTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ChannelTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="Workflow\ProcessHeaderLink\ProcessHeaderLinkTypeList.cs">
      <DependentUpon>ProcessHeaderLinkTypeList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Network\ShapeTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ShapeTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Integration</CustomToolNamespace>
    </None>
    <None Update="Workflow\ProcessHeaderLink\ProcessHeaderLinkTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ProcessHeaderLinkTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BufferManagement.Integration</CustomToolNamespace>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="SystemSchematic\BMComponentTypeList.xml">
      <CustomToolNamespace>Enterprise.BufferManagement.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>BMComponentTypeList.cs</LastGenOutput>
    </None>
    <None Update="ChannelTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <CustomToolNamespace>Enterprise.BufferManagement.Integration</CustomToolNamespace>
      <LastGenOutput>ChannelTypeList.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>