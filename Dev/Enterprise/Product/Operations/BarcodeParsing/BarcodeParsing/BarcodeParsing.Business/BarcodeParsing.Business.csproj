<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.BarcodeParsing.Business</RootNamespace>
    <AssemblyName>Enterprise.BarcodeParsing.Business</AssemblyName>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.BarcodeParsingEngine" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="Resources" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="BarcodeRule\BarcodeRuleResourceStrings.xml" />
    <EmbeddedResource Include="BarcodeValidationRule\BarcodeValidationRuleResourceStrings.xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Lists\DiagnosticsTypes.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DiagnosticsTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\LengthTypes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LengthTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\OtherDataFormatTypes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>OtherDataFormatTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\GS1DataFormatTypes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>GS1DataFormatTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\TerminatorTypes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TerminatorTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\BarcodeModuleTypes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>BarcodeModuleTypes.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="BarcodeRuleComponent\BarcodeRuleComponentResourceStrings.xml" />
    <None Update="Lists\DiagnosticsTypes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>DiagnosticsTypes.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BarcodeParsing.Business</CustomToolNamespace>
    </None>
    <None Update="Lists\LengthTypes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>LengthTypes.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.BarcodeParsing.Business</CustomToolNamespace>
    </None>
    <None Update="Lists\OtherDataFormatTypes.xml">
      <CustomToolNamespace>Enterprise.BarcodeParsing.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>OtherDataFormatTypes.cs</LastGenOutput>
    </None>
    <None Update="Lists\GS1DataFormatTypes.xml">
      <CustomToolNamespace>Enterprise.BarcodeParsing.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>GS1DataFormatTypes.cs</LastGenOutput>
    </None>
    <None Update="Lists\TerminatorTypes.xml">
      <CustomToolNamespace>Enterprise.BarcodeParsing.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TerminatorTypes.cs</LastGenOutput>
    </None>
    <None Update="Lists\BarcodeModuleTypes.xml">
      <CustomToolNamespace>Enterprise.BarcodeParsing.Business</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>BarcodeModuleTypes.cs</LastGenOutput>
    </None>
    <EmbeddedResource Include="BarcodeRuleSet\BarcodeRuleSetResourceStrings.xml" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>