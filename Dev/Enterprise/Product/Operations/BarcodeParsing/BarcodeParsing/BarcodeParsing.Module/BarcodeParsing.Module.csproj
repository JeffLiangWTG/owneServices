<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.BarcodeParsing.Module</RootNamespace>
    <AssemblyName>Enterprise.BarcodeParsing.Module</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <ProjectReference Include="..\BarcodeParsing.GUI\BarcodeParsing.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="IsPartialStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>IsPartialStatuses.xml</DependentUpon>
    </Compile>
    <Compile Update="IsSystemStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>IsSystemStatuses.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="IsSystemStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <CustomToolNamespace>Enterprise.BarcodeParsing.Module</CustomToolNamespace>
      <LastGenOutput>IsSystemStatuses.cs</LastGenOutput>
    </None>
    <None Update="IsPartialStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <CustomToolNamespace>Enterprise.BarcodeParsing.Module</CustomToolNamespace>
      <LastGenOutput>IsPartialStatuses.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>