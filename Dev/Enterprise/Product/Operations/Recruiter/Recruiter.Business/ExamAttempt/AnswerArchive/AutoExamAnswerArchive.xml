<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ExamAnswerArchive"
	>

	<!--
	For instructions see:
	http://sharepoint.corporate.cargowise.com/Wiki/Wiki%20Pages/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<GuidColumn>
		<Name>QuestionPK</Name>
	</GuidColumn>

	<IntColumn>
		<Name>QuestionActualNumber</Name>
	</IntColumn>
	
	<StringColumn>
		<Name>QuestionAsString</Name>
		<MaxLength>2147483647</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<StringColumn>
		<Name>AnswerAsString</Name>
		<MaxLength>1000</MaxLength>
	</StringColumn>

	<BoolColumn>
		<Name>IsAnsweredCorrectly</Name>
	</BoolColumn>

	<Serialisation>
		<Template>
			<QuestionPK>{value:QuestionPK}</QuestionPK>
			<QuestionNumber>{method:QuestionNumber}</QuestionNumber>
			<QuestionActualNumber>{value?:QuestionActualNumber}</QuestionActualNumber>
			<Question>{value?:QuestionAsString}</Question>
			<Answer>{value:AnswerAsString}</Answer>
			<IsCorrect>{value:IsAnsweredCorrectly}</IsCorrect>
			<SelectedQuestions>{method:SelectedQuestions}</SelectedQuestions>
			<OrderedOptions>{method:OrderedOptions}</OrderedOptions>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>