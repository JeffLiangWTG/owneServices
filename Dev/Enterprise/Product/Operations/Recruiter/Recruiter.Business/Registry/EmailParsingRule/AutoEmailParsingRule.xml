<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="EmailParsingRule">

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->
	
	<StringColumn>
		<Name>ReferringPartyCode</Name>
		<Caption>Referring Party Code</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

  <BoolColumn>
    <Name>AllowParseAttachments</Name>
    <Caption>Parse Email Attachments</Caption>
  </BoolColumn>

  <BoolColumn>
    <Name>AllowFallbackToEmailBody</Name>
    <Caption>Fallback to Email Body</Caption>
  </BoolColumn>

  <Serialisation>
		<Template>
      <ReferringPartyCode>{value:ReferringPartyCode}</ReferringPartyCode>
      <AllowParseAttachments>{value:AllowParseAttachments}</AllowParseAttachments>
      <AllowFallbackToEmailBody>{value:AllowFallbackToEmailBody}</AllowFallbackToEmailBody>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>