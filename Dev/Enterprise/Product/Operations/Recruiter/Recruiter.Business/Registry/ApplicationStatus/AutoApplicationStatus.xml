<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="ApplicationStatus">

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->
	
	<StringColumn>
		<Name>Code</Name>
		<Caption>Code</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

  <StringColumn>
    <Name>Description</Name>
    <Caption>Description</Caption>
    <AllowUnicode>true</AllowUnicode>
    <MaxLength>100</MaxLength>
  </StringColumn>    

	<Serialisation>
		<Template>
      <Code>{value:Code}</Code>
      <Description>{value:Description}</Description>
      <EmailTemplate>{method:EmailTemplate}</EmailTemplate>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>