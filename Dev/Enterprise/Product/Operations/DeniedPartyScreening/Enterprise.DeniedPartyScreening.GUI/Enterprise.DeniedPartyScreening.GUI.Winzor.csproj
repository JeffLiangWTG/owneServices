<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Enterprise.DeniedPartyScreening.GUI</AssemblyName>
    <RootNamespace>Enterprise.DeniedPartyScreening.GUI</RootNamespace>
    <UseLegacyRsa>false</UseLegacyRsa>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Formats.Asn1" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="WinzorFramework" />

    <!--
      this reference is only needed when Winzor is pointing at the net48 version of Enterprise.DeniedPratyScreening.Business.
      Not required when using the net8 version
    -->
    <Reference Include="System.ServiceModel" Condition="'$(CanNetCoreLibBeReferencedFromWinzor)' != 'true'">
      <HintPath>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.ServiceModel.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>