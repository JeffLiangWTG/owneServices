<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Enterprise.DeniedPartyScreening.GUI.Test</AssemblyName>
    <RootNamespace>Enterprise.DeniedPartyScreening.GUI.Test</RootNamespace>
    <EnableWinzorTests>true</EnableWinzorTests>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Enterprise.DeniedPartyScreening.Business.Test\Enterprise.DeniedPartyScreening.Business.Test.csproj" />
    <ProjectReference Include="..\Enterprise.DeniedPartyScreening.GUI\Enterprise.DeniedPartyScreening.GUI.Winzor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="WinzorFramework" />

    <!--
      this reference is only needed when Winzor is pointing at the net48 version of Enterprise.DeniedPratyScreening.Business.
      Not required when using the net8 version
    -->
    <Reference Include="System.ServiceModel" Condition="'$(CanNetCoreLibBeReferencedFromWinzor)' != 'true'">
      <HintPath>$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.ServiceModel.dll</HintPath>
      <Aliases>ServiceModelNet48</Aliases>
    </Reference>
  </ItemGroup>
</Project>