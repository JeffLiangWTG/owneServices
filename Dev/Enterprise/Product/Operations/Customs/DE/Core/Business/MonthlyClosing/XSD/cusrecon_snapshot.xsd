<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="CusReconSnapshot">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="MessageRole">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:minLength value="1"/>
							<xs:maxLength value="2"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DeclarationKind">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="1"/>
							<xs:enumeration value="Y"/>
							<xs:enumeration value="Z"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ReferenceNumber" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="21"/>
							<xs:pattern value="AT[A-Z][0-9]{2}[0-9]{6}(0[1-9]|1[0-2])20[0-9]{2}[0-9]{4}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="LocalReferenceNumber" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="StartAccountingPeriodDate" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:date"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="EndAccountingPeriodDate" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:date"/>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DeclarantIsConsigneeFlag" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="1"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CustomsAuthorisation" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
							<xs:pattern value="[A-Z]{2}[0-9]{4}[A-Z][A-Z0-9][0-9]{1,4}"/>
							<xs:pattern value="[A-Z]{2}.{1,4}.{1,29}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="EndUseAuthoristion" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
							<xs:pattern value="[A-Z]{2}[0-9]{4}[A-Z][A-Z0-9][0-9]{1,4}"/>
							<xs:pattern value="[A-Z]{2}.{1,4}.{1,29}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="InputTaxDeductionFlag" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="1"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CurrencyCode" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="3"/>
							<xs:enumeration value="EUR"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TaxOffice" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="4"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TaxNumber" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:minLength value="1"/>
							<xs:maxLength value="14"/>
							<xs:pattern value="[A-Z]{2}.{1,12}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="RepresentativeRelationshipFlag" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="1"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="MandateReference" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:length value="10"/>
							<xs:pattern value="[0-9]{10}"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="DeclarationPlace" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:token">
							<xs:minLength value="1"/>
							<xs:maxLength value="35"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Declarant" type="Participant" minOccurs="0" maxOccurs="1"/>
				<xs:element name="Representative" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="IdentificationReferenceNumber">
								<xs:simpleType>
									<xs:restriction base="xs:token">
										<xs:minLength value="1"/>
										<xs:maxLength value="17"/>
										<xs:pattern value="[A-Z]{2}[&#x21;-&#x7E;]{1,15}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="IdentificationSubsidiaryNumber" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:token">
										<xs:length value="4"/>
										<xs:pattern value="[0-9]{4}"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Principal" type="Participant" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="Participant">
		<xs:sequence>
			<xs:element name="IdentificationReferenceNumber" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="17"/>
						<xs:pattern value="[A-Z]{2}[&#x21;-&#x7E;]{1,15}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="IdentificationSubsidiaryNumber" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:length value="4"/>
						<xs:pattern value="[0-9]{4}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Name" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="120"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AddressLine" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="35"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AddressCountry" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:length value="2"/>
						<xs:pattern value="[A-Z]{2}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AddressPostcode" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="9"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AddressCity" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="35"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="AddressDistrict" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:token">
						<xs:minLength value="1"/>
						<xs:maxLength value="35"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
