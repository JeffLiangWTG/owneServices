      <LastGenOutput>G3MessageTypes.cs</LastGenOutput>
    </None>
    <None Update="CodeDescriptionPairLists\ESManifestTypes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ESManifestTypes.cs</LastGenOutput>
