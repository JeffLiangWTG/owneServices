<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- Customs ES H7-->
  <object id="ESH7.IAsycudaManifestHeader" type="Enterprise.Customs.ES.Manifest.H7.Business.AsycudaManifestHeader, Enterprise.Customs.ES.Manifest.H7.Business" singleton="false" />
  <object id="ESH7.ICusGoodsLocation" type="Enterprise.Customs.ES.Manifest.H7.Business.CusGoodsLocation, Enterprise.Customs.ES.Manifest.H7.Business" singleton="false" />
  <object id="IESG3MessageProcessorsProvider" type="Enterprise.Customs.ES.Manifest.H7.Business.G3MessageProcessorsProvider, Enterprise.Customs.ES.Manifest.H7.Business" singleton="false" />
  <object id="IESH7MessageProcessorsProvider" type="Enterprise.Customs.ES.Manifest.H7.Business.H7MessageProcessorsProvider, Enterprise.Customs.ES.Manifest.H7.Business" singleton="false" />
  <object id="ESH7BillFilterBusinessObject" type="Enterprise.Customs.ES.Manifest.H7.Module.ESH7BillFilterBusinessObject, Enterprise.Customs.ES.Manifest.H7.Module" singleton="false" />
  <object id="ESSendH7ToCustomsApplicator" type="Enterprise.Customs.ES.Manifest.H7.GUI.ESSendH7ToCustomsApplicator, Enterprise.Customs.ES.Manifest.H7.GUI" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" enableParallelInit="true" isSubSet="true">
      <list>
        <ref object="ES.Manifest.H7.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="ES.Manifest.H7.ApplicationBusinessProvider" type="Enterprise.Customs.ES.Manifest.H7.Business.H7ApplicationBusinessProvider, Enterprise.Customs.ES.Manifest.H7.Business" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="ES.Manifest.H7.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="ES.Manifest.H7.ApplicationGUIProvider" type="Enterprise.Customs.ES.Manifest.H7.GUI.H7ApplicationGUIProvider, Enterprise.Customs.ES.Manifest.H7.GUI" singleton="false" />

  <!-- EU GoodsLocation layout provider -->
  <object id="GoodsLocationFormLayoutProviders" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>ESH7D</value>
          </key>
          <value>ESH7D.GoodsLocationFormLayoutProvider</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="ESH7D.GoodsLocationFormLayoutProvider" type="Enterprise.Customs.ES.Manifest.H7.GUI.GoodsLocationFormLayoutProvider, Enterprise.Customs.ES.Manifest.H7.GUI" singleton="false" />
</objects>
