<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="CalCalculationMethodRegistry">
  <StringColumn>
    <Name>CalculationMethodName</Name>
    <MaxLength>3</MaxLength>
    <Caption>Calculation Method</Caption>
    <EditableState>ReadOnly</EditableState>
    <GenerateValidation>false</GenerateValidation>
  </StringColumn>
  <StringColumn>
    <Name>CalculationMethodDescription</Name>
    <Caption>Description</Caption>
    <EditableState>GetterOnly</EditableState>
    <GenerateValidation>false</GenerateValidation>
  </StringColumn>
  <DecimalColumn>
    <Name>CalculationMethodValue</Name>
    <Precision>16</Precision>
    <Scale>2</Scale>
    <MaxLength>10</MaxLength>
    <Caption>Value</Caption>
    <EditableState>Conditional</EditableState>
    <GenerateValidation>true</GenerateValidation>
  </DecimalColumn>
  <BoolColumn>
    <Name>CalculationMethodDefault</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Default</Caption>
  </BoolColumn>
</RegistryBusinessObjectTemplate>