<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->

  <!-- Customs MXManifest Manifest -->
  <object id="MXManifest.IAsycudaManifestHeader" type="Enterprise.Customs.MX.Manifest.Business.AsycudaManifestHeader, Enterprise.Customs.MX.Manifest.Business" singleton="false" />
  <object id="MXManifest.IAsycudaBill" type="Enterprise.Customs.MX.Manifest.Business.AsycudaBill, Enterprise.Customs.MX.Manifest.Business" singleton="false" />
  <object id="MXManifest.IAsycudaContainer" type="Enterprise.Customs.MX.Manifest.Business.AsycudaContainer, Enterprise.Customs.MX.Manifest.Business" singleton="false" />
  <object id="MXManifest.IAsycudaPack" type="Enterprise.Customs.MX.Manifest.Business.AsycudaPack, Enterprise.Customs.MX.Manifest.Business" singleton="false" />

  <!-- Customs MX -->
  <object id="MX.IMXMessage" type="Enterprise.Customs.MX.Manifest.Business.MXMessage, Enterprise.Customs.MX.Manifest.Business" singleton="false" />
  <object id="MX.IMXCustomsDataRegistry" type="Enterprise.Customs.MX.Manifest.Business.MXCustomsDataRegistry, Enterprise.Customs.MX.Manifest.Business" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="MXManifest.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="MXManifest.ApplicationBusinessProvider" type="Enterprise.Customs.MX.Manifest.Business.ApplicationBusinessProvider, Enterprise.Customs.MX.Manifest.Business" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="MXManifest.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="MXManifest.ApplicationGUIProvider" type="Enterprise.Customs.MX.Manifest.GUI.ApplicationGUIProvider, Enterprise.Customs.MX.Manifest.GUI" singleton="false" />

  <!-- GlbCompanyWrappers -->
  <object id="GlbCompanyWrappers" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>MX</value>
          </key>
          <value>IMXGlbCompanyWrapper</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="IMXGlbCompanyWrapper" type="Enterprise.Customs.MX.Manifest.Business.GlbCompanyWrapper, Enterprise.Customs.MX.Manifest.Business" singleton="false" />

  <!-- GlbCompanyWrapperProviders -->
  <object id="GlbCompanyWrapperProviders" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>MX</value>
          </key>
          <value>IMXGlbCompanyWrapperProvider</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="IMXGlbCompanyWrapperProvider" type="Enterprise.Customs.MX.Manifest.GUI.GlbCompanyWrapperProvider, Enterprise.Customs.MX.Manifest.GUI" singleton="false" />

  <!-- GlbExternalPassword provider -->
  <object id="GlbExternalPasswordProviders" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>MXB</value>
          </key>
          <value>MX.IGlbExternalPassword</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="MX.IGlbExternalPassword" type="Enterprise.Customs.MX.Manifest.Business.GlbCompanyCredential, Enterprise.Customs.MX.Manifest.Business" singleton="false" />

  <!-- IRefContainerMapProvider -->
  <object id="IRefContainerMapProvider" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>MX</value>
          </key>
          <value>MXRefContainerMapProvider</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="MXRefContainerMapProvider" type="Enterprise.Customs.MX.Manifest.Business.RefContainerMapProvider, Enterprise.Customs.MX.Manifest.Business" singleton="false" />
</objects>
