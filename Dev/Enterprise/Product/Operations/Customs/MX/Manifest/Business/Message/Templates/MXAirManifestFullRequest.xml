<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ser="http://www.service.ws.recepcion.aereos.privados.www.ventanillaunica.gob.mx">
<soapenv:Header>
  <wsse:Security xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">
  <wsse:UsernameToken>
    <wsse:Username>{Username}</wsse:Username>
    <wsse:Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">{Password}</wsse:Password>
  </wsse:UsernameToken>
  </wsse:Security>
  <ser:pais>MX</ser:pais>
  <ser:url>{URL}</ser:url>
</soapenv:Header>
<soapenv:Body>
  <ser:recibirMensajeWs>
    <mensaje>{BodyText}</mensaje>
  </ser:recibirMensajeWs>
</soapenv:Body>
</soapenv:Envelope>