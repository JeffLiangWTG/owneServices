<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  
  <ItemGroup Condition="'$(EnableDataProviderGenerator)' == 'true'">
    <Analyzer Include="$(WTGPaketPackagesRoot)$(WTGPaketBuildItemsGroupName)\Customs.DataProvider.CSharp.CodeGenerator\analyzers\dotnet\cs\Customs.DataProvider.CSharp.CodeGenerator.dll" />
    <Analyzer Include="$(WTGPaketPackagesRoot)$(WTGPaketBuildItemsGroupName)\Customs.DataProvider.CSharp.CodeGenerator\analyzers\dotnet\cs\Customs.MessageBuilder.Generator.Common.dll" />
  </ItemGroup>
  
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' AND '$(EnableDataProviderGenerator)' == 'true'">
    <DebugType>full</DebugType>
    <CompilerGeneratedFilesOutputPath>obj\$(Configuration)\generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
