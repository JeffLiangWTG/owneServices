<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(CWNetCoreTargetFramework);net48</TargetFrameworks>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <AssemblyName>Enterprise.Customs.CH.DeclarationActivation.Business</AssemblyName>
    <!-- this is used by CargoWiseOne.ResourceStrings MsBuildTest.TestPerformance() -->
    <!--GenerateSgen Condition="'$(CWGenerateSgen)' == ''">true</GenerateSgen-->
    <!--CWGenerateXmlSerializationAssemblies>true</CWGenerateXmlSerializationAssemblies-->
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <!-- this is used by CargoWiseOne.ResourceStrings MsBuildTest.TestPerformance() -->
  <ItemGroup Condition="'$(UseLegacyRsa)' == 'true'">
    <Using Include="CargoWise.ResourceStrings" />
    <Using Include="Enterprise.ZArchitecture.Core" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.Odyssey.Schema" />
