<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="EdecBordereauConfig">
  <BoolColumn>
    <Name>IsEnabled</Name>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Enable Automatic Bordereau download</Caption>
    <EditableState>ReadWrite</EditableState>
  </BoolColumn>
  <IntColumn>
    <Name>NumberOfDays</Name>
    <GenerateValidation>true</GenerateValidation>
    <Caption>Maximum Number of Days</Caption>
    <EditableState>ReadWrite</EditableState>
  </IntColumn>
</RegistryBusinessObjectTemplate>