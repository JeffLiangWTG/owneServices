<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="MessageSendingDeclaration"
	>

	<StringColumn>
		<Name>JE_DeclarationLanguage</Name>
		<Caption>Language</Caption>
		<MaxLength>2</MaxLength>
		<GenerateValidation>true</GenerateValidation>
	</StringColumn>

	<StringColumn>
		<Name>JE_LocationOfGoods</Name>
		<Caption>Goods Location</Caption>
		<MaxLength>100</MaxLength>
		<GenerateValidation>true</GenerateValidation>
	</StringColumn>

  <StringColumn>
    <Name>JE_TransportMode</Name>
    <Caption>Transport Mode</Caption>
    <MaxLength>3</MaxLength>
    <GenerateValidation>true</GenerateValidation>
  </StringColumn>

  <StringColumn>
    <Name>JE_MasterBill</Name>
    <Caption>Master Bill</Caption>
    <MaxLength>35</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>JE_VoyageFlightNo</Name>
    <Caption>Voyage</Caption>
    <MaxLength>10</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>JE_RN_NKTransportNationality</Name>
    <Caption>Nationality</Caption>
    <MaxLength>2</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>JE_TransportMeans</Name>
    <Caption>Type of ID</Caption>
    <MaxLength>2</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>JE_VesselName</Name>
    <Caption>Transport ID</Caption>
    <MaxLength>35</MaxLength>
  </StringColumn>

</NonPersistentBusinessObject>
