<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="CustomArrivalCustomerReferenceFormat"
  baseClass="Enterprise.Registry.Business.RegistryBusinessObjectTemplate"
	>
  <StringColumn>
    <Name>AuthorizationLocationCode</Name>
    <Caption>Authorization Location Code</Caption>
    <ShortCaption>Auth. Location Code</ShortCaption>
    <MaxLength>35</MaxLength>
  </StringColumn>
  <StringColumn>
    <Name>Prefix</Name>
    <Caption>Prefix</Caption>
    <MaxLength>10</MaxLength>
  </StringColumn>
  <StringColumn>
    <Name>Suffix</Name>
    <Caption>Suffix</Caption>
    <MaxLength>10</MaxLength>
  </StringColumn>
  <StringColumn>
    <Name>YearOption</Name>
    <Caption>Include Year</Caption>
    <MaxLength>1</MaxLength>
  </StringColumn>
  <ByteColumn>
    <Name>SequenceNumberLength</Name>
    <Caption>Sequence Number Digits</Caption>
    <MaxLength>1</MaxLength>
  </ByteColumn>
  <BoolColumn>
    <Name>IsRemoveLeadingZeros</Name>
    <Caption>Remove Leading Zeros</Caption>
  </BoolColumn>
  <BoolColumn>
    <Name>IsRestartOnNewYear</Name>
    <Caption>Restart on New Year</Caption>
  </BoolColumn>
</NonPersistentBusinessObject>
