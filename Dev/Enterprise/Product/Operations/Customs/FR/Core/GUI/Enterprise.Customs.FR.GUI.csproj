<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Schema" />
    <Reference Include="Enterprise.Messaging.Integration" />
    <Reference Include="Enterprise.Warehouse.Integration" />
    <Reference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="NCTS\NctsGoodsItemContainersUserControl.Designer.cs">
      <DependentUpon>NctsGoodsItemContainersUserControl.cs</DependentUpon>
    </Compile>
    <Compile Update="NCTS\NctsGoodsItems\NctsTaxOrFeeUserControl.Designer.cs">
      <DependentUpon>NctsTaxOrFeeUserControl.cs</DependentUpon>
    </Compile>
    <Compile Update="NCTS\NctsMovementForm.Designer.cs">
      <DependentUpon>NctsMovementForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>