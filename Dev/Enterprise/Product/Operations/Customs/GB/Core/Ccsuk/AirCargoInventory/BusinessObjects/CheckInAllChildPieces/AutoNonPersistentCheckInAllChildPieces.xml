<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="NonPersistentCheckInAllChildPieces" validationStyle="ValidationClass">

  <!--
	For instructions see:
  https://devops.wisetechglobal.com/wtg/CargoWise/_wiki/wikis/CargoWise.wiki/3307/Using-the-Generator
  -->

  <StringColumn>
    <Name>PackagesUnits</Name>
    <Caption>Packages Units</Caption>
    <ShortCaption>Pack Units</ShortCaption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <DateTimeColumn>
    <Name>ReceivedDate</Name>
    <Caption>Received Date</Caption>
  </DateTimeColumn>

  <StringColumn>
    <Name>MarksAndNumbers</Name>
    <Caption>Marks and Numbers</Caption>
    <MaxLength>315</MaxLength>
  </StringColumn>

  <GuidColumn>
    <Name>ShedStorageLocationId</Name>
    <Caption>Shed Storage Location</Caption>
    <ShortCaption>SSL</ShortCaption>
