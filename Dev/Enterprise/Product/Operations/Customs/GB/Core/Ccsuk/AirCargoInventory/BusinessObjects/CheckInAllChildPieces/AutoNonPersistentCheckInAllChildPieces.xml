  <BoolColumn>
    <Name>IsBeingReleasedNow</Name>
    <Caption>Is Being Released Now?</Caption>
    <ShortCaption>Release Now?</ShortCaption>
  </BoolColumn>

  <StringColumn>
    <Name>GoodsDescription</Name>
    <Caption>Goods Description</Caption>
    <ShortCaption>Description</ShortCaption>
    <MaxLength>2560</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>ContainerNumber</Name>
    <Caption>Container Number</Caption>
    <ShortCaption>Container</ShortCaption>
    <MaxLength>20</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>ContainerSeal</Name>
    <Caption>Container Seal</Caption>
    <ShortCaption>Seal</ShortCaption>
    <MaxLength>20</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>IsDamaged</Name>
    <Caption>Is Damaged?</Caption>
    <ShortCaption>Damaged?</ShortCaption>
  </BoolColumn>

</NonPersistentBusinessObject>