<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="CNScargoStatus">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="MessageHeader">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="HeaderID" type="xs:string"   />
              <xs:element name="MessageType">
                <xs:simpleType>                
                  <xs:restriction base="xs:string">
                    <xs:enumeration value = "CLEARED"/>
                    <xs:enumeration value = "HOLDADD"/>
                    <xs:enumeration value = "HOLDREMOVE"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="MessageDetail">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Site" type="xs:string" />
              <xs:element name="Container" type="xs:string" />
              <xs:element name="UCN" type="xs:string" />
              <xs:element name="Clearance" type="xs:string" />
              <xs:element name="BillOfLading" type="xs:string" />
              <xs:element name="Packages" type="xs:unsignedShort" />
              <xs:element name="Weight" type="xs:decimal" />
              <xs:element name="Hold" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element> 
</xs:schema>