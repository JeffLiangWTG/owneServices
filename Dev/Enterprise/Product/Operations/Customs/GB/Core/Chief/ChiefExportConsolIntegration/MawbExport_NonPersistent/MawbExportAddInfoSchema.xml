<?xml version="1.0" encoding="utf-8" ?>
<NewDataSet>
	<Table Name="MawbExportAddInfo">

		<Field Name="ME_PK" DataType="Guid" />

		<!-- Fields whose name starst ME_Chief are values that are set by chief.  User cannot change. 
		Other fields are for the user to supply data for making EAL/EDL/EAA messages or for putting GB data onto AWBs -->
		<Field Name="ME_ChiefMasterRouteOfEntry" DataType="String" MaxLength="3" />
		<Field Name="ME_ChiefMasterStyleOfEntry" DataType="String" MaxLength="2" />
		<Field Name="ME_ChiefCustomsReturnCode" DataType="String" MaxLength="3" />
		<Field Name="ME_ChiefMovementReference" DataType="String" MaxLength="35" />
		<Field Name="ME_ChiefGoodsLocation" DataType="String" MaxLength="6" />
		<Field Name="ME_ChiefShed" DataType="String" MaxLength="3" />
		<Field Name="ME_ChiefEntryProcessingUnitNumber" DataType="String" MaxLength="35" />
		<Field Name="ME_ChiefEntryProcessingUnitID" DataType="String" MaxLength="35" />
		<Field Name="ME_ChiefGoodsArrivalDateTime" DataType="DateTime"  AllowNull="true" />
    <Field Name="ME_ChiefConsolIsClosed" DataType="Boolean" />
    <Field Name="ME_ChiefCustomsActionCodeFromFsn"  DataType="String" MaxLength="2" />
    <Field Name="ME_ChiefCustomsActionTextFromFsn"  DataType="String" MaxLength="20" />
    <Field Name="ME_ChiefCustomsActionDateFromFsn" DataType="DateTime"  AllowNull="true"   />

    <!-- User data-->
		<Field Name="ME_CustomsStatisticalReference" DataType="String"  MaxLength="1" />
		<Field Name="ME_MovementDate" DataType="DateTime"  AllowNull="true" />
		<Field Name="ME_Profile" DataType="String"  MaxLength="25" /> 
		<Field Name="ME_ExportShed" DataType="String"  MaxLength="3" />
		<Field Name="ME_ExportLocation" DataType="String"  MaxLength="3" />
		<Field Name="ME_TransportID" DataType="String"  MaxLength="27" />
		<Field Name="ME_TransportMode" DataType="String"  MaxLength="3" />
		<Field Name="ME_TransportCountry" DataType="String"  MaxLength="2"  />
		<Field Name="ME_MasterOpt" DataType="String"  MaxLength="1"  />
		<Field Name="ME_CommunityTransitStatus" DataType="String"  MaxLength="5"  />
		<Field Name="ME_PartMovementIndicator" DataType="Boolean"   />
    <Field Name="ME_UseAntiSmugglingTrptid" DataType="Boolean"   />
		<Field Name="ME_MasterUCR" DataType="String" MaxLength="35" />
    
    <!--Calculated data-->
    <Field Name="ME_Queried"  DataType="DateTime"  AllowNull="true"  />

    
  </Table>
</NewDataSet>
