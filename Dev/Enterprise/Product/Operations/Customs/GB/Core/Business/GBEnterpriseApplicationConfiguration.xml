<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->

  <!-- Customs GB ICS -->
  <object id="GBICS.AsycudaManifestHeaderBaseTypeDecider" type="Enterprise.Customs.GB.ICS.AsycudaManifestHeaderBaseTypeDecider, Enterprise.Customs.GB.ICS" singleton="false" />
  <object id="GBICS.IGBICSEDIMessageTypeDecider" type="Enterprise.Customs.GB.ICS.GBICSEDIMessageTypeDecider, Enterprise.Customs.GB.ICS" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" enableParallelInit="true" isSubSet="true">
      <list>
        <ref object="GBICS.ApplicationBusinessProvider" />
        <ref object="GBICS.ApplicationBusinessProviderSS" />
      </list>
    </property>
  </object>
  <object id="GBICS.ApplicationBusinessProvider" type="Enterprise.Customs.GB.ICS.ApplicationBusinessProvider, Enterprise.Customs.GB.ICS" singleton="false" />
  <object id="GBICS.ApplicationBusinessProviderSS" type="Enterprise.Customs.GB.ICS.ApplicationBusinessProviderSS, Enterprise.Customs.GB.ICS" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="GB.ICS.ApplicationGUIProvider" />
        <ref object="GB.ICS.ApplicationGUIProviderSS" />
      </list>
    </property>
  </object>
  <object id="GB.ICS.ApplicationGUIProvider" type="Enterprise.Customs.GB.ICS.GUI.ApplicationGUIProvider, Enterprise.Customs.GB.ICS.GUI" singleton="false" />
  <object id="GB.ICS.ApplicationGUIProviderSS" type="Enterprise.Customs.GB.ICS.GUI.ApplicationGUIProviderSS, Enterprise.Customs.GB.ICS.GUI" singleton="false" />
</objects>
