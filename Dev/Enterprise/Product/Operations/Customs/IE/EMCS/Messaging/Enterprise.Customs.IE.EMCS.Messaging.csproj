<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <AssemblyName>Enterprise.Customs.IE.EMCS.Messaging</AssemblyName>
    <RootNamespace>Enterprise.Customs.IE.EMCS.Messaging</RootNamespace>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Customs.IE.MessageContracts" />
    <Reference Include="CargoWise.Customs.IE.MessageDefinitions" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="Enterprise.Customs.EU.EMCS.Messaging" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Resources" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="CodeDescriptionPairLists\EMCSIncomingMessageTypeList.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EMCSIncomingMessageTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="CodeDescriptionPairLists\EMCSOutgoingMessageTypeList.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EMCSOutgoingMessageTypeList.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="CodeDescriptionPairLists\EMCSIncomingMessageTypeList.xml">
      <CustomToolNamespace>Enterprise.Customs.IE.EMCS.Messaging</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>EMCSIncomingMessageTypeList.cs</LastGenOutput>
    </None>
    <None Update="CodeDescriptionPairLists\EMCSOutgoingMessageTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>EMCSOutgoingMessageTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Customs.IE.EMCS.Messaging</CustomToolNamespace>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>