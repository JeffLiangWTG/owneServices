<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="RF415MessageSendingObject"
  validationStype="ObsoleteValidation"
  baseClass="Enterprise.Customs.Business.BaseMessageSendingObject">
  <StringColumn>
    <Name>MovementReferenceNumber</Name>
    <ShortCaption>MRN</ShortCaption>
    <Caption>Movement Reference Number</Caption>
    <MaxLength>35</MaxLength>
    <EditableState>GetterOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>BillNumber</Name>
    <Caption>Bill Number</Caption>
    <MaxLength>35</MaxLength>
    <EditableState>GetterOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>RefundType</Name>
    <Caption>Type</Caption>
    <MaxLength>3</MaxLength>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>OfficeOfDebt</Name>
    <Caption>Office of Debt</Caption>
    <MaxLength>35</MaxLength>
    <FullDescription>Customs office where the debt was notified.</FullDescription>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>OfficeOfResponsibility</Name>
    <Caption>Office of Responsibility</Caption>
    <MaxLength>35</MaxLength>
    <FullDescription>Customs office responsible for the place where the goods are located.</FullDescription>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>LegalBasis</Name>
    <Caption>Legal Basis</Caption>
    <MaxLength>35</MaxLength>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>DescriptionOfGrounds</Name>
    <Caption>Description of Grounds</Caption>
    <MaxLength>512</MaxLength>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>BankDetails</Name>
    <Caption>Bank Details</Caption>
    <MaxLength>512</MaxLength>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
  <DecimalColumn>
    <Name>Amount</Name>
    <Caption>Amount</Caption>
    <Precision>16</Precision>
    <Scale>2</Scale>
    <EditableState>ReadWrite</EditableState>
  </DecimalColumn>
  <StringColumn>
    <Name>AdditionalInformation</Name>
    <Caption>Additional Information</Caption>
    <MaxLength>512</MaxLength>
    <EditableState>ReadWrite</EditableState>
  </StringColumn>
</NonPersistentBusinessObject>