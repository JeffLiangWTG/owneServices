<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- IE H7 Business-->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" enableParallelInit="true" isSubSet="true">
      <list>
        <ref object="IE.H7.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="IE.H7.ApplicationBusinessProvider" type="Enterprise.Customs.IE.H7.Business.H7ApplicationBusinessProvider, Enterprise.Customs.IE.H7.Business" singleton="false" />
  
  <object id="IEH7.IAsycudaManifestHeader" type="Enterprise.Customs.IE.H7.Business.AsycudaManifestHeader, Enterprise.Customs.IE.H7.Business" singleton="false" />
  <object id="IEH7.ICusGoodsLocation" type="Enterprise.Customs.IE.H7.Business.CusGoodsLocation, Enterprise.Customs.IE.H7.Business" singleton="false" />

  <!-- IE H7 GUI -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="IE.H7.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="IE.H7.ApplicationGUIProvider" type="Enterprise.Customs.IE.H7.GUI.H7ApplicationGUIProvider, Enterprise.Customs.IE.H7.GUI" singleton="false" />

  <object id="GoodsLocationFormLayoutProviders" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>IEH7D</value>
          </key>
          <value>IEH7D.GoodsLocationFormLayoutProvider</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="IEH7D.GoodsLocationFormLayoutProvider" type="Enterprise.Customs.IE.H7.GUI.GoodsLocationFormLayoutProvider, Enterprise.Customs.IE.H7.GUI" singleton="false" />

</objects>
