<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="RefundApplicationDocumentSendingObject"
  validationStyle="ValidationClass"
>

  <StringColumn>
    <Name>DocumentType</Name>
    <ShortCaption>Type</ShortCaption>
    <Caption>Document Type</Caption>
    <GenerateValidation>true</GenerateValidation>
	  <MaxLength>4</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>DocumentIdentifier</Name>
    <Caption>Document Identifier</Caption>
    <MediumCaption>Identifier</MediumCaption>
    <ShortCaption>ID</ShortCaption>
    <MaxLength>35</MaxLength>
  </StringColumn>

  <DateTimeColumn>
    <Name>DocumentDate</Name>
    <Caption>Document Date</Caption>
    <ShortCaption>Date</ShortCaption>
    <MaxLength>2</MaxLength>
  </DateTimeColumn>

</NonPersistentBusinessObject>