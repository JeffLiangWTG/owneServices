<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="TransactionNumber">

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<StringColumn>
		<Name>AccountSecurityCode</Name>
		<ShortCaption>Transaction</ShortCaption>
		<Caption>Transaction Number</Caption>
		<MaxLength>5</MaxLength>
	</StringColumn>
	<StringColumn>
		<Name>SequentialNumber</Name>
		<Caption>Importer/Broker assigned sequential number</Caption>
		<MaxLength>8</MaxLength>
	</StringColumn>
	<IntColumn>
		<Name>CheckDigit</Name>
		<EditableState>GetterOnly</EditableState>
		<GenerateValidation>false</GenerateValidation>
	</IntColumn>
</NonPersistentBusinessObject>
