  </ItemGroup>
  <ItemGroup>
    <None Update="XSD\CAD\Inbound\Inbound_1p0.xsd">
      <SubType>Designer</SubType>
      <Generator>XsdClassGenerator</Generator>
      <LastGenOutput>Inbound_1p0.cs</LastGenOutput>
