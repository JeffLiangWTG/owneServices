<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- Customs ACEManifest Manifest-->
  <object id="ACEManifest.IAsycudaManifestHeader" type="Enterprise.Customs.US.ACEManifest.Business.AsycudaManifestHeader, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.IAsycudaBill" type="Enterprise.Customs.US.ACEManifest.Business.AsycudaBill, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.IAsycudaContainer" type="Enterprise.Customs.US.ACEManifest.Business.AsycudaContainer, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.IAsycudaContainerBillOrPackageLink" type="Enterprise.Customs.US.ACEManifest.Business.AsycudaContainerBillOrPackageLink, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.IAsycudaPack" type="Enterprise.Customs.US.ACEManifest.Business.AsycudaPack, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.ICusPerson" type="Enterprise.Customs.US.ACEManifest.Business.CusPerson, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.ICusPersonCountry" type="Enterprise.Customs.US.ACEManifest.Business.CusPersonCountry, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="ACEManifest.IUSAMSImportAirManifestCreator" type="Enterprise.Customs.US.ACEManifest.Business.USAMSImportAirManifestCreator, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />
  <object id="US.IAIMEDIMessageTypeDecider" type="Enterprise.Customs.US.AIM.Messaging.AIMEDIMessageTypeDecider, Enterprise.Customs.US.AIM.Messaging" singleton="false" />
  <object id="US.IAIMEDIInterchange" type="Enterprise.Customs.US.AIM.Messaging.AIMEDIInterchange, Enterprise.Customs.US.AIM.Messaging" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="ACE.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="ACE.ApplicationBusinessProvider" type="Enterprise.Customs.US.ACEManifest.Business.ApplicationBusinessProvider, Enterprise.Customs.US.ACEManifest.Business" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="ACE.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="ACE.ApplicationGUIProvider" type="Enterprise.Customs.US.ACEManifest.GUI.ApplicationGUIProvider, Enterprise.Customs.US.ACEManifest.GUI" singleton="false" />
</objects>
