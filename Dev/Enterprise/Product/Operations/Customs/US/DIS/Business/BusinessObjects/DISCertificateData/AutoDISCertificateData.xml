<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DISCertificateData"
	baseClass="Enterprise.MasterFiles.Business.XmlSerializableNonPersistentBusinessObject"
>

  <!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

  <StringColumn>
    <Name>CertificateNumber</Name>
    <MaxLength>35</MaxLength>
  </StringColumn>
  <StringColumn>
    <Name>CertificateType</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>
  <StringColumn>
    <Name>Statement</Name>
    <MaxLength>500</MaxLength>
  </StringColumn>
  <DateTimeColumn>
    <Name>IssueDate</Name>
  </DateTimeColumn>
  <DateTimeColumn>
    <Name>ExpiryDate</Name>
  </DateTimeColumn>
  <StringColumn>
    <Name>InspectionLocation</Name>
    <MaxLength>10</MaxLength>
  </StringColumn>
  <DecimalColumn>
    <Name>GrossTonnage</Name>
    <Precision>15</Precision>
    <Scale>2</Scale>
  </DecimalColumn>
  <DecimalColumn>
    <Name>NetTonnage</Name>
    <Precision>15</Precision>
    <Scale>2</Scale>
  </DecimalColumn>
</NonPersistentBusinessObject>
