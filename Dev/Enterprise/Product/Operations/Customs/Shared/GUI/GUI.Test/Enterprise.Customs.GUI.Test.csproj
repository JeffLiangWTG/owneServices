  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Resources.Extensions" />
    <Reference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GUI\Enterprise.Customs.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="TestRig\TestRigEDIMessageCreationUserControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
</Project>