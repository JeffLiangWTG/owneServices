<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="NonPersistentSplitPackItem"
>
  <ShortColumn>
    <Name>Sequence</Name>
    <Caption>Seq.</Caption>
    <GenerateValidation>false</GenerateValidation>
  </ShortColumn>
  <StringColumn>
    <Name>GoodsDescription</Name>
    <Caption>Goods Description</Caption>
    <MaxLength>512</MaxLength>
    <AllowUnicode>true</AllowUnicode>
  </StringColumn>
  <DecimalColumn>
    <Name>PackableQuantity</Name>
    <Caption>Packable Quantity</Caption>
    <Precision>9</Precision>
    <Scale>3</Scale>
  </DecimalColumn>
  <StringColumn>
    <Name>PackableUQ</Name>
    <Caption>UQ</Caption>
    <MaxLength>6</MaxLength>
  </StringColumn>
  <DecimalColumn>
    <Name>NetWeight</Name>
    <Caption>Net Weight</Caption>
    <Precision>9</Precision>
    <Scale>3</Scale>
  </DecimalColumn>
  <StringColumn>
    <Name>NetWeightUQ</Name>
    <Caption>UQ</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>
</NonPersistentBusinessObject>
