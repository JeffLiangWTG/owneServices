<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="AllocateWeight"
>
  <StringColumn>
    <Name>SelectedLinesNumbersFormatString</Name>
    <Caption>Selected Lines</Caption>
    <EditableState>GetterOnly</EditableState>
    <GenerateValidation>false</GenerateValidation>
  </StringColumn>

  <DecimalColumn>
    <Name>NetWeight</Name>
    <Caption>Net Weight</Caption>
    <Precision>9</Precision>
    <Scale>3</Scale>
  </DecimalColumn>

  <StringColumn>
    <Name>NetWeightUnit</Name>
    <Caption>Net Weight Unit</Caption>
    <MaxLength>2</MaxLength>
  </StringColumn>

  <DecimalColumn>
    <Name>GrossWeight</Name>
    <Caption>Gross Weight</Caption>
    <Precision>9</Precision>
    <Scale>3</Scale>
  </DecimalColumn>

  <StringColumn>
    <Name>GrossWeightUnit</Name>
    <Caption>Gross Weight Unit</Caption>
    <MaxLength>2</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>AllocateWeightMethod</Name>
    <Caption>Method</Caption>
    <MaxLength>8</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>OverrideExisting</Name>
    <Caption>Override Existing</Caption>
    <GenerateValidation>false</GenerateValidation>
  </BoolColumn>

</NonPersistentBusinessObject>
