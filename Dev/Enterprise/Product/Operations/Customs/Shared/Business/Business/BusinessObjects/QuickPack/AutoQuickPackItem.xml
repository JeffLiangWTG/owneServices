<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="QuickPackItem"
>
	<ShortColumn>
		<Name>Sequence</Name>
		<Caption>Pack Item Sequence</Caption>
		<EditableState>GetterOnly</EditableState>
	</ShortColumn>

	<StringColumn>
		<Name>PackSeq</Name>
		<Caption>Pack Seq.</Caption>
		<MaxLength>2147483647</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Pack</Name>
		<Caption>Pack #</Caption>
		<MaxLength>2147483647</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>InvoiceNumber</Name>
		<Caption>Invoice #</Caption>
		<EditableState>GetterOnly</EditableState>
	</StringColumn>

	<ShortColumn>
		<Name>InvoiceLineNumber</Name>
		<Caption>Invoice Line#</Caption>
		<EditableState>GetterOnly</EditableState>
	</ShortColumn>

	<StringColumn>
		<Name>GoodsDesc</Name>
		<Caption>Goods Desc.</Caption>
		<EditableState>GetterOnly</EditableState>
	</StringColumn>

	<DecimalColumn>
		<Name>NotPackedQty</Name>
		<Caption>Not Packed Qty</Caption>
		<EditableState>GetterOnly</EditableState>
	</DecimalColumn>

	<DecimalColumn>
		<Name>PackedQty</Name>
		<Caption>Packed Qty</Caption>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<StringColumn>
		<Name>PackableUQ</Name>
		<Caption>UQ</Caption>
		<EditableState>GetterOnly</EditableState>
	</StringColumn>

</NonPersistentBusinessObject>
