	<xs:complexType name="ApplicationUnitsOfMeasure">
		<xs:annotation>
			<xs:documentation>
				This type is used to generically describe any unit of measure.

				UOMCode is the code of the unit of measure (e.g. Pallet, Catron etc)
				UOMBase is an optional attribute to describe the unit type (kg, cm etc).
				UOMValue is the actual unit value
				UOMConfirmedValue is used to allow remote systems return a confirmed value for a given UOM.

				The following UnitsOfMeasureTypes are supported by default.  Additional types
				will not be rejected, but wil lneed to be added to the mapping documents.

				DocumentPieces
				DocumentPackages
				DocumentNetWeight
				DocumentGrossWeight
				LinePieces
				LinePackages
				LineNetWeight
				LineGrossWeight
				LineSupplementaryQuantity
				LineQuantity
				DimLength
				DimWidth
				DimHeight
				FreightPortion
				FreightProrate
				WeightProrate

			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="UOMValue" minOccurs="0"/>
			<xs:element ref="UOMConfirmedValue" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="UOMCode" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="DocumentPieces"/>
					<xs:enumeration value="DocumentPackages"/>
					<xs:enumeration value="DocumentNetWeight"/>
					<xs:enumeration value="DocumentGrossWeight"/>
					<xs:enumeration value="LinePieces"/>
					<xs:enumeration value="LinePackages"/>
					<xs:enumeration value="LineNetWeight"/>
					<xs:enumeration value="LineGrossWeight"/>
					<xs:enumeration value="LineSupplementaryQuantity"/>
					<xs:enumeration value="LineQuantity"/>
					<xs:enumeration value="DimLength"/>
					<xs:enumeration value="DimWidth"/>
					<xs:enumeration value="DimHeight"/>
					<xs:enumeration value="FreightPortion"/>
					<xs:enumeration value="FreightProrate"/>
					<xs:enumeration value="WeightProrate"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="UOMBase" type="xs:string"/>
	</xs:complexType>
