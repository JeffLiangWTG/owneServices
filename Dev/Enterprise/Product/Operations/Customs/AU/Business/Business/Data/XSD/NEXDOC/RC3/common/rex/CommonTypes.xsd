<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:rct="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" xmlns:et="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" version="1.1" targetNamespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="../EnumTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="../CommonTypes.xsd" />
  <xsd:complexType name="ExportDetailsType">
    <xsd:annotation>
      <xsd:documentation>This type consists of elements which constitute the export related information for a Rex
                record.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="commodityType" type="ct:CommodityType" />
      <xsd:element name="priority" type="ct:Priority" minOccurs="0" nillable="true" />
      <xsd:element name="departureDate" type="xsd:date" minOccurs="0" />
      <xsd:element name="transportDetails" type="rct:TransportDetailsType" minOccurs="0" />
      <xsd:element name="destinationCity" type="ct:CityType" minOccurs="0" nillable="true" />
      <xsd:element name="dischargePorts" minOccurs="0">
        <xsd:complexType>
          <xsd:choice minOccurs="0">
            <xsd:sequence maxOccurs="3">
              <xsd:element name="dischargePort" type="ct:PortType" />
            </xsd:sequence>
            <xsd:sequence maxOccurs="1">
              <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
            </xsd:sequence>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="destinationCountry" type="ct:CountryType" />
      <xsd:element name="transitCountries" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Wrapper element which contains multiple sets of transit countries. Alternatively
                        allows the deletion of the existing transit countries through an amend service call by applying
                        removeExistingSet with a value of 'true'.
                    </xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:choice minOccurs="0">
            <xsd:sequence maxOccurs="4">
              <xsd:element name="transitCountry" type="ct:CountryType" />
            </xsd:sequence>
            <xsd:sequence maxOccurs="1">
              <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
            </xsd:sequence>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="borderInspectionPort" type="ct:PortType" minOccurs="0" nillable="true" />
      <xsd:element name="loadingPorts" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Wrapper element which contains multiple sets of loading ports. Alternatively
                        allows the deletion of the existing loading ports through an amend service call by applying
                        removeExistingSet with a value of 'true'.
                    </xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:choice minOccurs="0">
            <xsd:sequence maxOccurs="5">
              <xsd:element name="loadingPort" type="ct:PortType" />
            </xsd:sequence>
            <xsd:sequence maxOccurs="1">
              <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
            </xsd:sequence>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="importPermits" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Wrapper element which contains multiple sets of import permits. Alternatively
                        allows the deletion of the existing permits through an amend service call by applying
                        removeExistingSet with a value of 'true'.
                    </xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:choice minOccurs="0">
            <xsd:sequence maxOccurs="99">
              <xsd:element name="importPermit" type="rct:ImportPermitType" />
            </xsd:sequence>
            <xsd:sequence maxOccurs="1">
              <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
            </xsd:sequence>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="sew" type="rct:CustomsDetailsType" minOccurs="0" />
      <xsd:element name="ownerExporterId" type="ct:ExporterNumberType" minOccurs="0" />
      <xsd:element name="exporterDeclaration" minOccurs="0">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="exporterDeclaration" type="ct:ExporterDeclarationType" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>A manual declaration as a string.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:choice minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Wrapper element which contains a set of exporter declaration codes.
                                    Exporter declaration code text is contained within the ECM_DECLARATION codeset.
                                    Declaration text must be displayed to the end user (and they must acknowledge the
                                    declaration) if the code is included in the request. If the removeExistingSet
                                    attribute is passed in with a value of true, then all recorded declarations for the
                                    REX are removed.
                                </xsd:documentation>
              </xsd:annotation>
              <xsd:sequence maxOccurs="99">
                <xsd:element name="exporterDeclarationCode" type="ct:AlphaNumeric6Type" />
              </xsd:sequence>
              <xsd:sequence maxOccurs="1">
                <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
              </xsd:sequence>
            </xsd:choice>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="imaDetailsList" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Wrapper element which allows multiple container elements to be applied against a
                        productLine. Alternatively allows the deletion of the existing containers through an amend
                        service call by applying removeExistingSet with a value of 'true'.
                    </xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:choice minOccurs="0">
            <xsd:sequence maxOccurs="99">
              <xsd:element name="imaDetails" type="rct:ImaDetailsType" />
            </xsd:sequence>
            <xsd:sequence maxOccurs="1">
              <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
            </xsd:sequence>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="exporterReference" type="ct:AlphaNumeric35Type" minOccurs="0" nillable="true" />
      <xsd:element name="consigneeDetails" type="ct:ConsigneeType" minOccurs="0" />
      <xsd:element name="messageAcknowledgements" type="ct:MessageAcknowledgements" minOccurs="0" />
      <xsd:element name="preferredWeightUnit" type="ct:WeightUnitType" minOccurs="0" />
      <xsd:element name="tracesApprovalId" type="ct:AlphaNumeric80Type" minOccurs="0" />
      <xsd:element name="productUseIndicator" type="et:ProductUseType" minOccurs="0" />
      <xsd:element name="importedProductFlag" type="et:YesNoType" default="N" minOccurs="0" />
      <xsd:element name="manufacturedTreatedPackagedLabelledInAustralia" type="et:YesNoType" default="N" minOccurs="0" />
      <xsd:element name="legallyImported" type="et:YesNoType" default="N" minOccurs="0" />
      <xsd:element name="lotNumber" type="ct:AlphaNumeric70Type" minOccurs="0" />
      <xsd:element name="storageEstablishmentNumber" type="ct:AlphaNumeric20Type" minOccurs="0" />
      <xsd:element name="quotaYear" type="ct:AlphaNumeric10Type" minOccurs="0" />
      <xsd:element name="quotaFlag" type="et:YesNoType" default="N" minOccurs="0" />
      <xsd:element name="quotaType" type="ct:AlphaNumeric3Type" minOccurs="0" />
      <xsd:element name="shipStoresFlag" type="et:YesNoType" default="N" minOccurs="0" />
      <xsd:element name="exemptionCode" type="ct:AlphaNumeric50Type" minOccurs="0" />
      <xsd:element name="authorisationFlag" type="et:YesNoType" minOccurs="0" />
      <xsd:element name="authorisationDetails" type="rct:AuthorisationDetailsType" minOccurs="0" />
      <xsd:element name="euContactInformation" type="rct:EUContactInformationType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="RexSubmissionIdentificationType">
    <xsd:complexContent>
      <xsd:extension base="ct:IdentificationType">
        <xsd:sequence>
          <xsd:element name="lastAmendDateTime" type="xsd:dateTime" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="RexResponseDetailsType">
    <xsd:sequence>
      <xsd:element minOccurs="0" name="identification" type="ct:IdentificationType" />
      <xsd:element minOccurs="0" name="complianceStatus" type="et:CompletionStatusType" />
      <xsd:element minOccurs="0" name="lastAmendDateTime" type="xsd:dateTime" />
      <xsd:element minOccurs="0" name="exporterReference" type="ct:AlphaNumeric35Type" />
      <xsd:element minOccurs="0" name="permitNumber" type="ct:AlphaNumeric15Type" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CustomsDetailsType">
    <xsd:sequence>
      <xsd:element name="customsAgentIndicator" type="ct:CustomsAgentType" minOccurs="0" />
      <xsd:element name="edn" type="ct:ExportPermitNumberType" minOccurs="0" />
      <xsd:element name="currency" type="ct:CurrencyUnitType" minOccurs="0" />
      <xsd:element name="consigneeName" type="ct:RestrictedEnglishOnlyAlphaNumericAmpersand35Type" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="RexLineTypeResponse">
    <xsd:sequence>
      <xsd:element name="lineNumber" type="ct:Number2Digits" />
      <xsd:element minOccurs="0" name="healthCertificateDescription" type="xsd:string" />
      <xsd:element minOccurs="0" name="primaryCertificate" type="rct:FormType" />
      <xsd:element minOccurs="0" name="secondaryCertificate" type="rct:FormType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="DefaultLineCertificate">
    <xsd:annotation>
      <xsd:documentation>Any default certificate templates that have been derived for a line item (when a specific
                template has not been requested).
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="lineNumber" type="ct:Number2Digits" minOccurs="1" maxOccurs="1" />
      <xsd:element name="certificateDetails" type="rct:LineCertificateDetailsType" minOccurs="1" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="FormType">
    <xsd:sequence>
      <xsd:element name="templateCode" type="ct:AlphaNumeric6Type" />
      <xsd:element minOccurs="0" name="endorsementNumber" type="ct:CertificateEndorsementType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ImportPermitType">
    <xsd:annotation>
      <xsd:documentation>This type identifies a import permit number, and it's associated date.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="importPermitNumber" type="ct:ImportPermitNumberType" />
      <xsd:element name="importPermitDate" type="xsd:date" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="EstablishmentType">
    <xsd:annotation>
      <xsd:documentation>This type recognises an establishment record by its name, address and a contact number.
                This is not an establishment contained within the establishment register.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="establishmentName" type="ct:AlphaNumeric50Type" />
      <xsd:element name="establishmentAddress" type="ct:AddressType" />
      <xsd:element name="contactPhoneNumber" type="ct:TelephoneNumberType" />
      <xsd:element name="contactName" type="ct:AlphaNumeric100Type" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ContainerType">
    <xsd:annotation>
      <xsd:documentation>Contains the container number and seal numbers associated with a container record.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="containerNumber" type="ct:ContainerNumberType" />
      <xsd:element name="containerSeals" minOccurs="0">
        <xsd:complexType>
          <xsd:sequence maxOccurs="99" minOccurs="0">
            <xsd:element name="containerSeal" type="rct:ContainerSealType" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ContainerSealType">
    <xsd:annotation>
      <xsd:documentation>Specifies the container seal number applied to the container if relevant. Alternatively a
                range of seal numbers can be provided if relevant.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:element name="sealNumber" type="ct:SealNumberType" />
        <xsd:sequence>
          <xsd:element name="sealStartNumber" type="ct:SealNumberType" minOccurs="0" />
          <xsd:element name="sealEndNumber" type="ct:SealNumberType" minOccurs="0" />
        </xsd:sequence>
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="VesselHoldSealType">
    <xsd:annotation>
      <xsd:documentation>Specifies the vessel hold seal number ranges applied to the vessel relevant.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="sealStartNumber" type="ct:AlphaNumeric7Type" minOccurs="0" />
      <xsd:element name="sealEndNumber" type="ct:AlphaNumeric7Type" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ProductionProcessType">
    <xsd:annotation>
      <xsd:documentation>This type specifies the details pertaining to one of the production process relating to
                the enclosing Rex line record.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="processGroup" type="ct:ProcessType" minOccurs="0" />
      <xsd:element name="processingStartDate" type="xsd:date" minOccurs="0" />
      <xsd:element name="processingEndDate" type="xsd:date" minOccurs="0" />
      <xsd:element name="establishmentIndicator" type="ct:ProcessingIndicatorType" />
      <xsd:choice>
        <xsd:element name="processingEstablishmentNumber" type="ct:EstablishmentNumberType" />
        <xsd:element name="processingEstablishment" type="rct:EstablishmentType" />
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="TreatmentType">
    <xsd:annotation>
      <xsd:documentation>Specifies the treatments which have been applied to a particular product.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="treatmentCode" type="ct:TreatmentCodeType" />
      <xsd:element name="treatmentStartDate" type="xsd:date" />
      <xsd:element name="treatmentEndDate" type="xsd:date" minOccurs="0" />
      <xsd:element name="treatmentInformation" type="ct:TreatmentInformationType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ProductDetails">
    <xsd:annotation>
      <xsd:documentation>Specifies the product details which relate to the enclosing Rex Line.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="productType" type="ct:ProductType" />
      <xsd:element name="category" type="ct:ProductCategoryType" minOccurs="0" />
      <xsd:element name="packType" type="ct:PackageType" />
      <xsd:element name="preservationType" type="ct:PreservationType" />
      <xsd:element name="cutType" type="ct:CutType" minOccurs="0" />
      <xsd:element name="suppCode" type="ct:SuppCodeType" minOccurs="0" />
      <xsd:element name="outerProductPackaging" type="rct:OuterProductPackagingType" minOccurs="0" />
      <xsd:element name="intermediateProductPackaging" type="rct:ProductPackagingType" minOccurs="0" />
      <xsd:element name="innerProductPackaging" type="rct:ProductPackagingType" minOccurs="0" />
      <xsd:element name="netMetricWeight" type="ct:WeightType" minOccurs="0" />
      <xsd:element name="netImperialWeight" type="ct:WeightType" minOccurs="0" />
      <xsd:element name="manualCertificateProductDescription" type="ct:RestrictedAlphaNumeric254Type" minOccurs="0" />
      <xsd:element name="additionalDescription" type="ct:RestrictedAlphaNumeric254Type" minOccurs="0" />
      <xsd:element name="farmCode" type="ct:FarmCodeType" minOccurs="0" />
      <xsd:element name="farmType" type="ct:FarmType" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ProductPackagingType">
    <xsd:annotation>
      <xsd:documentation>This type specifies the packaging and optionally the weight of the product related to the
                productLine. This can be either one of inner or intermediate packaging where the unit and amount are
                optional.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="quantity">
        <xsd:complexType>
          <xsd:simpleContent>
            <xsd:extension base="ct:Number6Digits">
              <xsd:attribute name="packageType" type="ct:PackageType" />
            </xsd:extension>
          </xsd:simpleContent>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="unitAmount" type="ct:PackageUnitAmountType" minOccurs="0" />
      <xsd:element name="packageMeasureAccuracy" type="et:PackageMeasureAccuracyType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OuterProductPackagingType">
    <xsd:annotation>
      <xsd:documentation>This type specifies the outer packaging and weight of the product related to the
                productLine. This contains shipping marks applicable to outer packaging only.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="quantity">
        <xsd:complexType>
          <xsd:simpleContent>
            <xsd:extension base="ct:Number6Digits">
              <xsd:attribute name="packageType" type="ct:PackageType" />
            </xsd:extension>
          </xsd:simpleContent>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="unitAmount" type="ct:PackageUnitAmountType" minOccurs="0" />
      <xsd:element name="packageMeasureAccuracy" type="et:PackageMeasureAccuracyType" default="E" minOccurs="0" />
      <xsd:element name="shippingMarks" type="ct:ShippingMarksType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="TransitLocationType">
    <xsd:restriction base="xsd:token">
      <xsd:enumeration value="C">
        <xsd:annotation>
          <xsd:documentation>Custom Warehouse</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="S">
        <xsd:annotation>
          <xsd:documentation>Ship Supplier</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="ProductLinesType">
    <xsd:annotation>
      <xsd:documentation>A wrapper type which encapsulates the product line items. The retainProductLines
                attribute, if passed in and set to "Y" will remove all product lines that are not passed in with this
                request.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="productLine" maxOccurs="500" type="rct:ProductLineType" />
      <xsd:element name="retainProductLines" type="xsd:boolean" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="AdditionalTextsType">
    <xsd:annotation>
      <xsd:documentation>A wrapper type which encapsulates the Additional Text Type</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="additionalText" type="rct:AdditionalTextType" minOccurs="0" maxOccurs="20" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ProductLineType">
    <xsd:annotation>
      <xsd:documentation>The productLine type contains the detailed information for a product relating to a Rex
                record. A given Rex record can contain multiple product line records, where each product line is
                identified by its designated line number, which must be unique for that given Rex record. For an amend
                operation, an existing productLine entry may be removed by quoting the lineNumber in addition to the
                removeEntry element set to 'true'.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:choice>
      <xsd:sequence>
        <xsd:element name="lineNumber" type="ct:Number2Digits" />
        <xsd:choice>
          <xsd:sequence maxOccurs="1">
            <xsd:element name="removeEntry" type="xsd:boolean" default="false" minOccurs="0" />
          </xsd:sequence>
          <xsd:sequence>
            <xsd:element name="productDetails" type="rct:ProductDetails" />
            <xsd:element name="containers" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Wrapper element which allows multiple container elements to be
                                    applied against a productLine. Alternatively allows the deletion of the existing
                                    containers through an amend service call by applying removeExistingSet with a value
                                    of 'true'.
                                </xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:choice minOccurs="0">
                  <xsd:sequence maxOccurs="99">
                    <xsd:element name="container" type="rct:ContainerType" />
                  </xsd:sequence>
                  <xsd:sequence maxOccurs="1">
                    <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
                  </xsd:sequence>
                </xsd:choice>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="treatments" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Wrapper element which allows multiple treatments to be applied
                                    against a productLine. Alternatively allows the deletion of the existing treatments
                                    through an amend service call by applying removeExistingSet with a value of 'true'.
                                </xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:sequence minOccurs="1">
                  <xsd:element name="treatmentType" type="rct:TreatmentType" minOccurs="0" maxOccurs="99" />
                  <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" minOccurs="0" maxOccurs="1" />
                </xsd:sequence>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="productionProcesses" minOccurs="0">
              <xsd:annotation>
                <xsd:documentation>Wrapper element which allows multiple production processes to be
                                    applied against a productLine. Alternatively allows the deletion of the existing
                                    processes through an amend service call by applying removeExistingSet with a value
                                    of 'true'.
                                </xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                <xsd:choice minOccurs="0">
                  <xsd:sequence maxOccurs="99">
                    <xsd:element name="productionProcess" type="rct:ProductionProcessType" />
                  </xsd:sequence>
                  <xsd:sequence maxOccurs="1">
                    <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
                  </xsd:sequence>
                </xsd:choice>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="sew" type="rct:ProductLineCustomsDetailsType" minOccurs="0" />
            <xsd:element name="durabilityStartDate" type="xsd:date" minOccurs="0" />
            <xsd:element name="durabilityEndDate" type="xsd:date" minOccurs="0" />
            <xsd:element name="aheccCode" type="ct:AheccCodeType" minOccurs="0" />
            <xsd:element name="cnCode" type="ct:CNCodeType" minOccurs="0" maxOccurs="1" />
            <xsd:element name="finalConsumerFlag" type="et:YesNoType" default="N" minOccurs="0" />
            <xsd:element name="batchCode" type="ct:AlphaNumeric30Type" maxOccurs="1" minOccurs="0" />
            <xsd:element name="additionalTexts" type="rct:AdditionalTextsType" minOccurs="0" />
            <xsd:element name="productSourceCountries" minOccurs="0">
              <xsd:complexType>
                <xsd:choice minOccurs="0">
                  <xsd:sequence maxOccurs="3">
                    <xsd:element name="productSourceCountry" type="ct:CountryType" />
                  </xsd:sequence>
                  <xsd:sequence maxOccurs="1">
                    <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
                  </xsd:sequence>
                </xsd:choice>
              </xsd:complexType>
            </xsd:element>
            <xsd:element name="attachments" type="ct:AttachmentsType" minOccurs="0" />
            <xsd:element name="importAuthorityCode" type="ct:AlphaNumeric350Type" maxOccurs="1" minOccurs="0" />
          </xsd:sequence>
        </xsd:choice>
        <xsd:element name="natureOfCommodity" type="ct:NatureOfCommodityType" maxOccurs="1" minOccurs="0" />
        <xsd:element name="euTreatmentType" type="ct:AlphaNumeric5Type" minOccurs="0" />
        <xsd:element name="quotaExporter" type="ct:ExporterNumberType" minOccurs="0" />
      </xsd:sequence>
    </xsd:choice>
  </xsd:complexType>
  <xsd:complexType name="ProductLineCustomsDetailsType">
    <xsd:sequence>
      <xsd:element name="netCustomsWeight" type="ct:WeightType" minOccurs="0" />
      <xsd:element name="grossMetricWeight" type="ct:WeightType" minOccurs="0" />
      <xsd:element name="fobAmount" type="ct:CurrencyValueType" minOccurs="0" />
      <xsd:element name="productSourceState" type="ct:ProductSourceStateType" minOccurs="0" />
      <xsd:element name="relatedPermitType" type="ct:AlphaNumeric6Type" minOccurs="0" />
      <xsd:element name="relatedPermitNumber" type="ct:AlphaNumeric20Type" minOccurs="0" />
      <xsd:element name="relatedPermitDate" type="xsd:date" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ManufacturerDetailsType">
    <xsd:annotation>
      <xsd:documentation>Contains the elements which identify certificate request details. This includes the print
                information across the entire Rex record, as well as any specific certificate requests associated with
                the said Rex record.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="manufacturer" maxOccurs="99" type="rct:ManufacturerLineType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ManufacturerLineType">
    <xsd:annotation>
      <xsd:documentation>A certificate request which encapsulates both the certificate request details, as well as
                the productLines applicable to the request.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="lineNumbers">
        <xsd:complexType>
          <xsd:sequence maxOccurs="unbounded">
            <xsd:element name="lineNumber" type="ct:Number2Digits" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="manufacturerDetails" type="rct:LineManufacturerDetailsType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="LineManufacturerDetailsType">
    <xsd:annotation>
      <xsd:documentation>A certificate request which encapsulates both the certificate request details, as well as
                the productLines applicable to the request.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="name" type="ct:AlphaNumeric50Type" />
      <xsd:element name="address" type="ct:AddressType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CertificateDetailsType">
    <xsd:annotation>
      <xsd:documentation>Contains the elements which identify certificate request details. This includes the print
                information across the entire Rex record, as well as any specific certificate requests associated with
                the said Rex record.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="certificatePrintControls" type="rct:CertificatePrintType" minOccurs="0" />
      <xsd:element name="certificates" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Wrapper element which allows multiple certificate elements to be applied against
                        a rex. Alternatively allows the deletion of the existing certificates through an amend service
                        call by applying removeExistingSet with a value of 'true'.
                    </xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:choice minOccurs="0">
            <xsd:sequence>
              <xsd:element name="certificate" maxOccurs="99" type="rct:CertificateLineType" minOccurs="0" />
            </xsd:sequence>
            <xsd:sequence maxOccurs="1">
              <xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
            </xsd:sequence>
            <xsd:sequence>
              <xsd:element name="primaryCertificate" maxOccurs="99" type="rct:CertificateLineType" minOccurs="0" />
              <xsd:element name="extraCertificate" maxOccurs="99" type="rct:ExtraCertificateLineType" minOccurs="0" />
            </xsd:sequence>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CertificatePrintType">
    <xsd:annotation>
      <xsd:documentation>Provides the common certificate print information which relates to a Rex submission.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="certificatePrintIndicator" type="et:CertificatePrintIndicatorType" minOccurs="0" />
      <xsd:choice minOccurs="0">
        <xsd:element name="certificatePrintRegion" type="ct:AlphaNumeric9Type" />
        <xsd:element name="certificateRequiredClientGroup" type="ct:PartyExternalIdType" />
      </xsd:choice>
      <xsd:element name="separateBy" type="et:CertificateSeparatorType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="LineCertificatePrintType">
    <xsd:annotation>
      <xsd:documentation>Provides the common certificate print information which relates to a Rex submission.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:element name="certificatePrintRegion" type="ct:AlphaNumeric9Type" />
        <xsd:element name="certificateRequiredClientGroup" type="ct:PartyExternalIdType" />
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CertificateLineType">
    <xsd:annotation>
      <xsd:documentation>A certificate request which encapsulates both the certificate request details, as well as
                the productLines applicable to the request.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:element name="removeEntry" type="xsd:boolean" />
        <xsd:element name="lineNumbers">
          <xsd:complexType>
            <xsd:sequence maxOccurs="unbounded">
              <xsd:element name="lineNumber" type="ct:Number2Digits" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="certificateDetails" type="rct:LineCertificateDetailsType" />
      <xsd:element name="certificatePrintDetails" type="rct:LineCertificatePrintType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ExtraCertificateLineType">
    <xsd:annotation>
      <xsd:documentation>An request for a an extra certificate which encapsulates both the certificate request
                details, as well as the productLines applicable to the request.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:element name="removeEntry" type="xsd:boolean" />
        <xsd:element name="lineNumbers">
          <xsd:complexType>
            <xsd:sequence maxOccurs="unbounded">
              <xsd:element name="lineNumber" type="ct:Number2Digits" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="certificateDetails" type="rct:LineExtraCertificateDetailsType" />
      <xsd:element name="certificatePrintDetails" type="rct:LineCertificatePrintType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="LineCertificateDetailsType">
    <xsd:annotation>
      <xsd:documentation>Optional certificate print details which can override the respective details provided at
                the REX level.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="certificateTemplate" type="ct:CertificateTemplateType" />
      <xsd:element name="certificateEndorsement" type="ct:CertificateEndorsementType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="LineExtraCertificateDetailsType">
    <xsd:annotation>
      <xsd:documentation>Optional certificate print details which can override the respective details provided at
                the REX level.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="certificateTemplate" type="ct:CertificateTemplateType" />
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="RexLinesResponseType">
    <xsd:sequence>
      <xsd:element name="rexLine" maxOccurs="99" type="rct:RexLineTypeResponse">
        <xsd:unique name="lineNumberUnique">
          <xsd:selector xpath="rexLine" />
          <xsd:field xpath="lineNumber" />
        </xsd:unique>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="TransportDetailsType">
