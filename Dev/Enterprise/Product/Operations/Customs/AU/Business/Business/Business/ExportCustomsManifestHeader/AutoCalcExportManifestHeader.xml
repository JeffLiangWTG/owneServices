<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="CalcExportManifestHeader"
  validationStyle="ObsoleteValidation">

  <StringColumn>
    <Name>Departure</Name>
    <Caption>Departure</Caption>
    <MaxLength>5</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>DischargeCountry</Name>
    <Caption>Discharge Country/Region</Caption>
    <ShortCaption>Discharge Ctry/Rgn.</ShortCaption>
    <MaxLength>2</MaxLength>
  </StringColumn>

  <DateTimeColumn>
    <Name>DepartureDate</Name>
    <Caption>Departure Date</Caption>
  </DateTimeColumn>

  <StringColumn>
    <Name>VesselName</Name>
    <Caption>Vessel Name</Caption>
    <MaxLength>35</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>LloydsIMO</Name>
    <Caption>Lloyds/IMO No</Caption>
    <MaxLength>7</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>VoyageNumber</Name>
    <Caption>Voyage Number</Caption>
    <MaxLength>10</MaxLength>
  </StringColumn>

  <IntColumn>
    <Name>ContainerCount</Name>
    <Caption>Container Count</Caption>
  </IntColumn>

  <IntColumn>
    <Name>EmptyContainerCount</Name>
    <Caption>Empty Container Count</Caption>
  </IntColumn>

  <IntColumn>
    <Name>PackageCount</Name>
    <Caption>Package Count</Caption>
  </IntColumn>

</NonPersistentBusinessObject>