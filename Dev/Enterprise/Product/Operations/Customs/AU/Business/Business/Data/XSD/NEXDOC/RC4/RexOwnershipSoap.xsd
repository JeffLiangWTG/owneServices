<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://agriculture.gov.au/nexdoc/RexOwnershipSoap_1.0"
	elementFormDefault="qualified" xmlns:tns="http://agriculture.gov.au/nexdoc/RexOwnershipSoap_1.0" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0"
	xmlns:et="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0">

	<xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
	<xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="common/EnumTypes.xsd" />

	<!-- SOAP root payload -->
	<xsd:element name="RexForwardOwnership">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="identification" type="ct:IdentificationType" maxOccurs="1" minOccurs="1" />

				<xsd:element name="clientGroup" type="ct:PartyExternalIdType" />
				<xsd:element name="requiresAcceptance" type="xsd:boolean" default="false" />
				<xsd:element name="holdUntilStatus" type="et:ForwardCompletionStatusType" minOccurs="0" />

			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexTransferOwnership">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="identification" type="ct:IdentificationType" maxOccurs="1" minOccurs="1" />

				<xsd:element name="clientGroup" type="ct:PartyExternalIdType" />
				<xsd:element name="exporter" type="ct:ExporterNumberType" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexWithdrawOwnership">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="identification" type="ct:IdentificationType" maxOccurs="1" minOccurs="1" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexWithdrawOwnershipResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="outcome" type="et:RexOwnershipOutcomeType" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexForwardOwnershipResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="outcome" type="et:RexOwnershipOutcomeType" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexTransferOwnershipResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="outcome" type="et:RexOwnershipOutcomeType" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexAcknowledgeOwnership">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="identification" type="ct:IdentificationType" maxOccurs="1" minOccurs="1" />
				<xsd:element name="isAccepted" type="xsd:boolean" maxOccurs="1" minOccurs="1" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

	<xsd:element name="RexAcknowledgeOwnershipResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="outcome" type="et:RexOwnershipOutcomeType" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>

</xsd:schema>
