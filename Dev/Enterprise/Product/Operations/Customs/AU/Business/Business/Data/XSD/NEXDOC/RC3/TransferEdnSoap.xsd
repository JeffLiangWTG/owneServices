<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:this="http://agriculture.gov.au/nexdoc/TransferEdnSoap_1.0" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" xmlns:cw="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" targetNamespace="http://agriculture.gov.au/nexdoc/TransferEdnSoap_1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" schemaLocation="common/rex/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="common/EnumTypes.xsd" />
  <xsd:element name="TransferEdn">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="transferEdnFrom" type="cw:RexSubmissionIdentificationType" maxOccurs="1" minOccurs="1" />
        <xsd:element name="transferEdnTo" type="cw:RexSubmissionIdentificationType" maxOccurs="1" minOccurs="1" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="TransferEdnResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="transferEdnResponse" type="this:TransferEdnMessageResponse" maxOccurs="1" minOccurs="1" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:complexType name="TransferEdnMessageResponse">
    <xsd:sequence>
      <xsd:element name="rexResponseDetails" type="cw:RexResponseDetailsType" minOccurs="0" />
      <xsd:element name="validationNotices" type="ct:ValidationNoticesType" minOccurs="0" />
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>