<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" targetNamespace="http://www.agriculture.gov.au/nexdoc/party/v1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
  <xsd:element name="NotifyExporterUpdate">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="partyId" type="ct:PartyInternalIdType" />
        <xsd:element name="shippingMarkPrefix" type="xsd:string" minOccurs="0" nillable="true" />
        <xsd:element name="dairyAustraliaApproval" type="xsd:boolean" minOccurs="0" nillable="true" />
        <xsd:element name="requestNewAuthorityNumber" type="xsd:boolean" minOccurs="0" />
        <xsd:element name="updateAuthorityNumber" type="xsd:boolean" minOccurs="0" />
        <xsd:element name="startDate" type="xsd:date" minOccurs="0" nillable="true" />
        <xsd:element name="endDate" type="xsd:date" minOccurs="0" nillable="true" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyExporterUpdateResponseType">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="updateDateTime" type="xsd:dateTime" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyExporterCancel">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="partyId" type="ct:PartyInternalIdType" />
        <xsd:element name="reason" type="xsd:string" minOccurs="0" nillable="true" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyExporterCancelResponseType">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="updateDateTime" type="xsd:dateTime" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyClientGroupUpdate">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="partyId" type="ct:PartyInternalIdType" />
        <xsd:element name="remotePrintCommodityTypesList" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="commodityType" type="ct:CommodityType" minOccurs="0" maxOccurs="unbounded" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="registeredCommodityTypesList" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="commodityType" type="ct:CommodityType" minOccurs="0" maxOccurs="unbounded" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="dairyAustraliaApproval" type="xsd:boolean" minOccurs="0" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyClientGroupUpdateResponseType">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="updateDateTime" type="xsd:dateTime" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyNewClientGroupRemotePrintCommodityType">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="partyId" type="ct:PartyInternalIdType" />
        <xsd:element name="commodityType" type="ct:CommodityType" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="NotifyNewClientGroupRemotePrintCommodityTypeResponseType">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="updateDateTime" type="xsd:dateTime" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>