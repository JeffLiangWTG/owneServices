<?xml version="1.0" encoding="Windows-1252"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:rct="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" xmlns:et="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" targetNamespace="http://agriculture.gov.au/nexdoc/AmendRexSoap_1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" schemaLocation="common/rex/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="common/EnumTypes.xsd" />
  <xsd:element name="AmendRex">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="identification" type="rct:RexSubmissionIdentificationType" />
        <xsd:element name="exportDetails" type="rct:ExportDetailsType" minOccurs="0" />
        <xsd:element name="certificateDetails" type="rct:CertificateDetailsType" minOccurs="0" />
        <xsd:element name="productLines" type="rct:ProductLinesType" minOccurs="0" />
        <xsd:element name="manufacturers" type="rct:ManufacturerDetailsType" minOccurs="0" />
        <xsd:element name="attachments" type="ct:AttachmentsType" minOccurs="0" />
        <xsd:element name="additionalTexts" type="rct:AdditionalTextsType" minOccurs="0" />
        <xsd:element name="euTransit" type="rct:EUTransitType" minOccurs="0" />
        <xsd:element name="submitAmendmentRequest" type="xsd:boolean" minOccurs="0" />
        <xsd:element name="amendmentReason" type="xsd:string" minOccurs="0" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="AmendRexResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="rexResponseDetails" type="rct:RexResponseDetailsType" minOccurs="0" />
        <xsd:element name="validationNotices" type="ct:ValidationNoticesType" minOccurs="0" />
        <xsd:element name="rexLinesResponse" type="rct:RexLinesResponseType" minOccurs="0" />
        <xsd:element name="rexResponseType" type="et:RexResponseType" minOccurs="0" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>