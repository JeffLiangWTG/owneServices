<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="CalcExportManifestLine"
  validationStyle="ObsoleteValidation">

  <StringColumn>
    <Name>Departure</Name>
    <Caption>Departure</Caption>
    <MaxLength>5</MaxLength>
  </StringColumn>

  <DateTimeColumn>
    <Name>DepartureDate</Name>
    <Caption>Departure Date</Caption>
  </DateTimeColumn>

  <StringColumn>
    <Name>DischargeCountry</Name>
    <Caption>Discharge Country/Region</Caption>
