  </StringColumn>

  <StringColumn>
    <Name>EntryNumber</Name>
    <Caption>Entry Number</Caption>
    <MaxLength>35</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>GoodsDescription</Name>
    <Caption>Goods Description</Caption>
    <MaxLength>35</MaxLength>
  </StringColumn>

  <IntColumn>
    <Name>ContainerCount</Name>
    <Caption>Container Count</Caption>
  </IntColumn>

  <IntColumn>
    <Name>PackageCount</Name>
    <Caption>Package Count</Caption>
  </IntColumn>

  <GuidColumn>
    <Name>OH_Owner</Name>
    <Caption>Owner</Caption>
  </GuidColumn>

  <StringColumn>
    <Name>GoodsOwner</Name>
    <Caption>Goods Owner</Caption>
    <MaxLength>35</MaxLength>
  </StringColumn>

</NonPersistentBusinessObject>