<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://agriculture.gov.au/nexdoc/CustomsSoap_1.0"
            elementFormDefault="qualified"
            xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0"
            xmlns:cw="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0">

    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0"
                schemaLocation="common/CommonTypes.xsd"/>
    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0"
                schemaLocation="common/rex/CommonTypes.xsd"/>
    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0"
                schemaLocation="common/EnumTypes.xsd"/>

    <xsd:element name="ReadRexEDN">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="identification" type="ct:IdentificationType"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="ReadRexEDNResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="edn" type="ct:ExportPermitNumberType" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="CancelRexEDN">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="identification" type="cw:RexSubmissionIdentificationType"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="CancelRexEDNResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:sequence>
                    <xsd:element name="validationNotices" type="ct:ValidationNoticesType" minOccurs="0"/>
                </xsd:sequence>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="TransferRexEDN">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="transferEDNFrom" type="cw:RexSubmissionIdentificationType"/>
                <xsd:element name="transferEDNTo" type="cw:RexSubmissionIdentificationType"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="TransferRexEDNResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="validationNotices" type="ct:ValidationNoticesType" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
