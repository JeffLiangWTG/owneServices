	xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
	<xs:element name="NewDataSet" msdata:IsDataSet="true" msdata:Locale="en-AU" msdata:EnforceConstraints="False">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="TableMappings">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CustomsTableName" type="xs:string" minOccurs="0" />
							<xs:element name="ReferenceFileTableName" type="xs:string" minOccurs="0" />
							<xs:element name="ReferenceFilePrefix" type="xs:string" minOccurs="0" />
							<xs:element name="CustomsFileName" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>