<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://agriculture.gov.au/nexdoc/CopyRexSoap_1.0" elementFormDefault="qualified"
            xmlns:cw="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0">

    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd"/>
    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" schemaLocation="common/rex/CommonTypes.xsd"/>

    <!-- SOAP root payload -->
    <xsd:element name="CopyRex">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="identification" type="cw:RexSubmissionIdentificationType" maxOccurs="1" minOccurs="1"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="CopyRexResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="copyRexResponse" type="cw:CopyRexMessageResponse" maxOccurs="1"
                             minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
