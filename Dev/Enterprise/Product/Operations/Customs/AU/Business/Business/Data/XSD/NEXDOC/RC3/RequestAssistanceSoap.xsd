<?xml version="1.0" encoding="Windows-1252"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" targetNamespace="http://agriculture.gov.au/nexdoc/RequestAssistanceSoap_1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="common/EnumTypes.xsd" />
  <xsd:element name="RequestAssistance">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="rex" type="ct:IdentificationType" />
        <xsd:element name="description" type="ct:AlphaNumeric254Type" />
        <xsd:element name="document" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="name" type="ct:AlphaNumeric200Type" />
              <xsd:element name="mimeType" type="ct:AlphaNumeric100Type" />
              <xsd:element name="data" type="xsd:base64Binary" />
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="RequestAssistanceResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="serviceRequestIdentifier" type="xsd:string" minOccurs="0" />
        <xsd:element name="serviceRequestStatus" type="xsd:string" minOccurs="0" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>