<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:rc="http://agriculture.gov.au/nexdoc/RexCertificateSoap_1.0" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" xmlns:rct="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" targetNamespace="http://agriculture.gov.au/nexdoc/RexCertificateSoap_1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" schemaLocation="common/rex/CommonTypes.xsd" />
  <xsd:element name="ReissueCertificate">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="certificateNumber" type="ct:CertificateNumberType" maxOccurs="1" minOccurs="1" />
        <xsd:element name="reason" type="ct:AlphaNumeric500Type" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="ReissueCertificateResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="reissueCertificateResponse" type="rct:ReissueCertificateMessageResponse" maxOccurs="1" minOccurs="0" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="ReplaceCertificate" type="rc:ReplaceCertificateType" />
  <xsd:complexType name="ReplaceCertificateType">
    <xsd:sequence>
      <xsd:element name="reason" type="xsd:string" />
      <xsd:element name="rexDetails">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="identification" type="rct:RexSubmissionIdentificationType" />
            <xsd:element name="exportDetails" type="rct:ExportDetailsType" minOccurs="0" />
            <xsd:element name="certificateDetails" type="rct:CertificateDetailsType" minOccurs="0" />
            <xsd:element name="productLines" type="rct:ProductLinesType" minOccurs="0" />
            <xsd:element name="manufacturers" type="rct:ManufacturerDetailsType" minOccurs="0" />
            <xsd:element name="attachments" type="ct:AttachmentsType" minOccurs="0" />
            <xsd:element name="additionalTexts" type="rct:AdditionalTextsType" minOccurs="0" />
            <xsd:element name="newProductLinesOnly" type="xsd:boolean" minOccurs="0" />
            <xsd:element name="euTransit" type="rct:EUTransitType" minOccurs="0" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="ReplaceCertificateResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="validationNotices" type="ct:ValidationNoticesType" minOccurs="0" />
        <xsd:element name="serviceRequestId" type="ct:AlphaNumeric20Type" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>