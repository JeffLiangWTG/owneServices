<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema targetNamespace="http://agriculture.gov.au/nexdoc/common/rex/SkinsAndHidesTypes_1.0" elementFormDefault="qualified" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0"  schemaLocation="../CommonTypes.xsd"/>
  <xsd:complexType name="SkinsAndHidesExportDetails">
    <xsd:annotation>
      <xsd:documentation>This type specifies the additional details that can be specified for a SkinsAndHides rex (export details).
      </xsd:documentation>
    </xsd:annotation>
      <xsd:sequence>
        <xsd:element name="loadingDate" type="xsd:date" minOccurs="0"/>
        <xsd:element name="loadingEstablishment" type="xsd:string" minOccurs="0"/>
        <xsd:element name="packDate" type="xsd:date" minOccurs="0"/>
      </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="SkinsAndHidesProductLineDetails">
    <xsd:annotation>
      <xsd:documentation>This type specifies the additional product line details that can be specified for a SkinsAndHides rex.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:sequence>
        <xsd:element name="saltingDate" type="xsd:date" minOccurs="0"/>
      </xsd:sequence>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>