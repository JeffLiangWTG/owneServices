<?xml version="1.0" encoding="Windows-1252"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:rc="http://agriculture.gov.au/nexdoc/ReadCertificateSoap_1.0" xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" targetNamespace="http://agriculture.gov.au/nexdoc/ReadCertificateSoap_1.0" elementFormDefault="qualified">
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd" />
  <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="common/EnumTypes.xsd" />
  <xsd:element name="ReadCertificate">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="identification" type="ct:IdentificationType" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="ReadCertificateResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="superCertificates" maxOccurs="unbounded" type="rc:SuperCertificateType" minOccurs="0" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:complexType name="SuperCertificateType">
    <xsd:annotation>
      <xsd:documentation>Contains the generated certificates, and related information relating to a Rex
                submission.
            </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="consignee" type="ct:ConsigneeType" />
      <xsd:element name="departureDate" type="xsd:date" />
      <xsd:element name="certificates" minOccurs="0">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="certificate" type="rc:CertificateType" maxOccurs="99" minOccurs="0" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CertificateType">
    <xsd:sequence>
      <xsd:element name="certificateNumber" type="xsd:string" minOccurs="0" />
      <xsd:element name="certificatePayloads" minOccurs="0">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="certificatePayload" type="rc:CertificateOutputType" minOccurs="0" maxOccurs="unbounded" />
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CertificateOutputType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:base64Binary">
        <xsd:attribute name="outputType" type="xsd:string" />
        <xsd:attribute name="copyType" type="xsd:string" />
        <xsd:attribute name="paperType" type="xsd:string" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
</xsd:schema>