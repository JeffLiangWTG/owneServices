<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://agriculture.gov.au/nexdoc/ReadRexSoap_1.0" elementFormDefault="qualified"
            xmlns:ct="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0"
            xmlns:rct="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0">
    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0" schemaLocation="common/CommonTypes.xsd"/>
    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/rex/CommonTypes_1.0" schemaLocation="common/rex/CommonTypes.xsd"/>
    <xsd:import namespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" schemaLocation="common/EnumTypes.xsd"/>
    <!-- SOAP root payload -->
    <xsd:element name="ReadRex">
        <xsd:complexType>
            <xsd:sequence>
            	<xsd:element name="identification" type="ct:IdentificationType" />
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="ReadRexResponse">
        <xsd:complexType>
            <xsd:sequence>
				<xsd:element name="rexResponseDetails" type="rct:RexResponseDetailsType" minOccurs="0"/>            
                <xsd:element name="exportDetails" type="rct:ExportDetailsType"/>
                <xsd:element name="productLines" type="rct:ProductLinesType"/>
                <xsd:element name="manufacturers" type="rct:ManufacturerDetailsType" minOccurs="0"/>                
                <xsd:element name="certificateDetails" type="rct:CertificateDetailsType" minOccurs="0"/>
                <xsd:element name="attachments" type="ct:AttachmentsType" minOccurs="0" />                
                <xsd:element name="additionalTexts" type="rct:AdditionalTextsType" minOccurs="0" />
                <xsd:element name="euTransit" type="rct:EUTransitType" minOccurs="0" />
                <xsd:element name="defaultLineCertificates" type="rct:DefaultLineCertificate" minOccurs="0" maxOccurs="unbounded" />
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="ReadRexEDN">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="identification" type="ct:IdentificationType" />
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="ReadRexEDNResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="edn" type="ct:ExportPermitNumberType" minOccurs="0" />
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
