<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="AdditionalInfoSendingObject"
  validationStyle="ValidationClass"
>

  <StringColumn>
    <Name>DocumentType</Name>
    <Caption>Document Type</Caption>
    <ShortCaption>Type</ShortCaption>
    <GenerateValidation>true</GenerateValidation>
    <MaxLength>512</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>DocumentInformation</Name>
    <Caption>Document Information</Caption>
    <ShortCaption>Info.</ShortCaption>
    <GenerateValidation>true</GenerateValidation>
    <MaxLength>512</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>ReferenceNumber</Name>
    <Caption>Reference Number</Caption>
    <ShortCaption>Ref.</ShortCaption>
    <GenerateValidation>true</GenerateValidation>
    <MaxLength>512</MaxLength>
  </StringColumn>

</NonPersistentBusinessObject>