<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="CalculateLiabilityNonPersistentBizObj">
  <DecimalColumn>
    <Name>TotalValue</Name>
    <Precision>19</Precision>
    <Scale>4</Scale>
    <GenerateValidation>true</GenerateValidation>
    <EditableState>ReadWrite</EditableState>
    <Caption>Total Value</Caption>
  </DecimalColumn>
  <StringColumn>
    <Name>Currency</Name>
    <AllowUnicode>false</AllowUnicode>
    <EditableState>CachedGetterOnly</EditableState>
    <MaxLength>3</MaxLength>
    <VariableMaxLength>3</VariableMaxLength>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Currency</Caption>
  </StringColumn>
  <IntColumn>
    <Name>LiabilityPercentage</Name>
    <GenerateValidation>true</GenerateValidation>
    <Caption>Percentage Rate (%)</Caption>
  </IntColumn>
  <DecimalColumn>
    <Name>LiabilityAmount</Name>
    <Precision>19</Precision>
    <Scale>4</Scale>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Liability Amount</Caption>
  </DecimalColumn>
  <BoolColumn>
    <Name>UseDutiesAndTaxes</Name>
    <Caption>Duties + Taxes</Caption>
  </BoolColumn>
  <BoolColumn>
    <Name>UseMonetaryValue</Name>
    <Caption>Monetary Value</Caption>
  </BoolColumn>

</NonPersistentBusinessObject>