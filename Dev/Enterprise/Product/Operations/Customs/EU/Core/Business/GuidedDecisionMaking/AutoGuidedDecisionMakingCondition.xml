<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
        xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
        name="GuidedDecisionMakingCondition">
  <StringColumn>
    <Name>ConditionType</Name>
    <MaxLength>6</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>ConditionTypeDescription</Name>
    <MaxLength>500</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>ConditionSatisfactionType</Name>
    <MaxLength>4000</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <BoolColumn>
    <Name>IsSatisfied</Name>
    <EditableState>GetterOnly</EditableState>
  </BoolColumn>
  <BoolColumn>
    <Name>IsInformationCondition</Name>
    <EditableState>GetterOnly</EditableState>
  </BoolColumn>
  <StringColumn>
    <Name>InformationValue</Name>
    <MaxLength>500</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>IsSatisfiedTextForBinding</Name>
    <MaxLength>15</MaxLength>
    <EditableState>GetterOnly</EditableState>
  </StringColumn>
</NonPersistentBusinessObject>
