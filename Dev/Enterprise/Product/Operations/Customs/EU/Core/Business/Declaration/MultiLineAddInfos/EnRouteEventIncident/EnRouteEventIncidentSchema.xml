<?xml version="1.0" encoding="utf-8" ?>
<NewDataSet>
	<Table Name="EnRouteEventIncident">
		<Field Name="G9_PK" DataType="Guid" />

    <!-- common -->
    <Field Name="G9_EventPlace" DataType="String" MaxLength="35" />
    <Field Name="G9_EventCountryCode" DataType="String" MaxLength="2" />
    <Field Name="G9_ControlAlreadyInNcts" DataType="Boolean"  />
    <Field Name="G9_IncidentFlag" DataType="Boolean"  /> 
    <Field Name="G9_IncidentEndorsementDate" DataType="DateTime"  AllowNull ="Y" />
    <Field Name="G9_IncidentEndorsementAuthority" DataType="String"  MaxLength="35"  />
    <Field Name="G9_IncidentEndorsementPlace" DataType="String"  MaxLength="35"  />
    <Field Name="G9_IncidentEndorsementCountry" DataType="String"  MaxLength="2"  />

    
    <!-- transhipment -->
    <Field Name="G9_NewTransportID" DataType="String" MaxLength="27"   />
    <Field Name="G9_NewTransportCountry" DataType="String" MaxLength="2"   />

    <!-- Incident -->
    <Field Name="G9_IncidentInformation" DataType="String" MaxLength="350"   />
    
    
    
  </Table>
</NewDataSet>
