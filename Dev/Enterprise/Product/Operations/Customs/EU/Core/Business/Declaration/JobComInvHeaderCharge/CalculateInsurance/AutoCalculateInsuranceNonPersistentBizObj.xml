<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="CalculateInsuranceNonPersistentBizObj">
  <DecimalColumn>
    <Name>InvoiceAmount</Name>
    <Precision>19</Precision>
    <Scale>2</Scale>
    <GenerateValidation>false</GenerateValidation>
    <EditableState>CachedGetterOnly</EditableState>
    <Caption>Invoice Amount</Caption>
  </DecimalColumn>
  <DecimalColumn>
    <Name>InsurancePercentage</Name>
    <Precision>7</Precision>
    <Scale>5</Scale>
    <GenerateValidation>true</GenerateValidation>
    <Caption>% Insurance</Caption>
  </DecimalColumn>
  <DecimalColumn>
    <Name>DutiablePercent</Name>
    <Precision>3</Precision>
    <Scale>0</Scale>
    <GenerateValidation>true</GenerateValidation>
    <Caption>% before EU Border</Caption>
  </DecimalColumn>
  <DecimalColumn>
    <Name>InsuranceAmount</Name>
    <EditableState>CachedGetterOnly</EditableState>
    <Precision>19</Precision>
    <Scale>2</Scale>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Insurance Amount</Caption>
  </DecimalColumn>
  <StringColumn>
    <Name>Currency</Name>
    <AllowUnicode>false</AllowUnicode>
    <EditableState>CachedGetterOnly</EditableState>
    <MaxLength>3</MaxLength>
    <VariableMaxLength>3</VariableMaxLength>
    <GenerateValidation>false</GenerateValidation>
    <Caption>Currency</Caption>
  </StringColumn>
  <BoolColumn>
    <Name>IsInsuranceIncludedInLines</Name>
    <Caption>Include value in Invoice Lines</Caption>
    <GenerateValidation>false</GenerateValidation>
  </BoolColumn>
</NonPersistentBusinessObject>