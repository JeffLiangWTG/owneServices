<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="SingleLineEntry">
  <StringColumn>
    <Name>TariffNumber</Name>
    <MaxLength>13</MaxLength>
  </StringColumn>
  <StringColumn>
    <Name>CPCCode</Name>
    <MaxLength>7</MaxLength>
    <Caption>CPC Code</Caption>
    <FullDescription>Customs Procedure Code.</FullDescription>
  </StringColumn>
  <StringColumn>
    <Name>InvoiceNumber</Name>
    <MaxLength>35</MaxLength>
    <Caption>Invoice Number</Caption>
  </StringColumn>
  <StringColumn>
    <Name>AdditionalInfoCode</Name>
    <MaxLength>5</MaxLength>
  </StringColumn>
  <DecimalColumn>
    <Name>Price</Name>
    <Precision>12</Precision>
    <Scale>2</Scale>
    <Caption>Price</Caption>
    <FullDescription>Line Price.</FullDescription>
  </DecimalColumn>
  <GuidColumn>
    <Name>Currency</Name>
  </GuidColumn>
  <DecimalColumn>
    <Name>NetWeight</Name>
    <Precision>12</Precision>
    <Scale>3</Scale>
    <Caption>Net Weight</Caption>
    <FullDescription>The net weight of the item.</FullDescription>
  </DecimalColumn>
  <BoolColumn>
    <Name>CreateLIC99</Name>
    <Caption>Add LIC99 statement?</Caption>
  </BoolColumn>
</NonPersistentBusinessObject>