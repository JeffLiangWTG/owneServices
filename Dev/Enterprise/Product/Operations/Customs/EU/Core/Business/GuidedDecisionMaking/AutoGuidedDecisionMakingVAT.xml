<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
        xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
        name="GuidedDecisionMakingVAT">
  <StringColumn>
    <Name>VATCode</Name>
    <MaxLength>4</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>Description</Name>
    <MaxLength>500</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>AdditionalCode</Name>
    <MaxLength>15</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <StringColumn>
    <Name>AdditionalCodeDescription</Name>
    <MaxLength>500</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <DecimalColumn>
    <Name>VATRateValue</Name>
    <Precision>9</Precision>
    <Scale>3</Scale>
  </DecimalColumn>
  <StringColumn>
    <Name>Category</Name>
    <MaxLength>4</MaxLength>
    <EditableState>ReadOnly</EditableState>
  </StringColumn>
  <BoolColumn>
    <Name>IsTicked</Name>
  </BoolColumn>
</NonPersistentBusinessObject>
