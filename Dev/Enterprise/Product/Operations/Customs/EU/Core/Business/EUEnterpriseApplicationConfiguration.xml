<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- Customs EU H7 -->
  <object id="EUH7.IAsycudaManifestHeader" type="Enterprise.Customs.EU.H7.Business.AsycudaManifestHeader, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.IAsycudaBill" type="Enterprise.Customs.EU.H7.Business.AsycudaBill, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.IAsycudaPack" type="Enterprise.Customs.EU.H7.Business.AsycudaPack, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.IAsycudaManifestHeaderProcessTask" type="Enterprise.Customs.EU.H7.Business.EUH7AsycudaManifestHeaderProcessTask, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.IAsycudaManifestHeaderTypeDecider" type="Enterprise.Customs.EU.H7.Business.AsycudaManifestHeaderTypeDecider, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.ICusGoodsLocation" type="Enterprise.Customs.EU.H7.Business.CusGoodsLocation, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.IEUH7ManifestTypes" type="Enterprise.Customs.EU.H7.Business.EUH7ManifestTypes, Enterprise.Customs.EU.H7.Business" singleton="false" />
  <object id="EUH7.IH7FeatureControlProvider" type="Enterprise.Customs.EU.H7.Module.H7FeatureControlProvider, Enterprise.Customs.EU.H7.Module" singleton="false" />
  <object id="EUH7BillFilterBusinessObject" type="Enterprise.Customs.EU.H7.Module.EUH7BillFilterBusinessObject, Enterprise.Customs.EU.H7.Module" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="EU.H7.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="EU.H7.ApplicationGUIProvider" type="Enterprise.Customs.EU.H7.GUI.H7ApplicationGUIProvider, Enterprise.Customs.EU.H7.GUI" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" enableParallelInit="true" isSubSet="true">
      <list>
        <ref object="EU.H7.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="EU.H7.ApplicationBusinessProvider" type="Enterprise.Customs.EU.H7.Business.H7ApplicationBusinessProvider, Enterprise.Customs.EU.H7.Business" singleton="false" />

  <!-- EU GoodsLocation layout provider -->
  <object id="GoodsLocationFormLayoutProviders" type="CargoWise.Application.KeyObjectHandleDictionaryObject, CargoWise.ApplicationContext">
    <property name="SourceDictionary" isSubSet="true">
      <dictionary>
        <entry>
          <key>
            <value>EUH7D</value>
          </key>
          <value>EUH7D.GoodsLocationFormLayoutProvider</value>
        </entry>
      </dictionary>
    </property>
  </object>
  <object id="EUH7D.GoodsLocationFormLayoutProvider" type="Enterprise.Customs.EU.H7.GUI.GoodsLocationFormLayoutProvider, Enterprise.Customs.EU.H7.GUI" singleton="false" />
</objects>
