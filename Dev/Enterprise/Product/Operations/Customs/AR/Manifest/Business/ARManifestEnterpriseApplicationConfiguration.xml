<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- Customs AR Manifest -->
  <object id="IARGlbCompanyWrapper" type="Enterprise.Customs.AR.Manifest.Business.GlbCompanyWrapper, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="IARGlbCompanyWrapperProvider" type="Enterprise.Customs.AR.Manifest.GUI.GlbCompanyWrapperProvider, Enterprise.Customs.AR.Manifest.GUI" singleton="false" />
  <object id="IGlbExternalPassword_AR" type="Enterprise.Customs.AR.Manifest.Business.GlbCompanyCredential, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="AR.IARMessage" type="Enterprise.Customs.AR.Manifest.Business.ARMessage, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="AR.IGlbExternalPassword" type="Enterprise.Customs.AR.Manifest.Business.GlbCompanyCredential, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="ARManifest.IAsycudaManifestHeader" type="Enterprise.Customs.AR.Manifest.Business.AsycudaManifestHeader, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="ARManifest.IAsycudaBill" type="Enterprise.Customs.AR.Manifest.Business.AsycudaBill, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="AR.IARCustomsDataRegistry" type="Enterprise.Customs.AR.Manifest.Business.ARCustomsDataRegistry, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="ARManifest.IAsycudaContainer" type="Enterprise.Customs.AR.Manifest.Business.AsycudaContainer, Enterprise.Customs.AR.Manifest.Business" singleton="false" />
  <object id="ARManifest.IAsycudaPack" type="Enterprise.Customs.AR.Manifest.Business.AsycudaPack, Enterprise.Customs.AR.Manifest.Business" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="ARManifest.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="ARManifest.ApplicationBusinessProvider" type="Enterprise.Customs.AR.Manifest.Business.ApplicationBusinessProvider, Enterprise.Customs.AR.Manifest.Business" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="ARManifest.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="ARManifest.ApplicationGUIProvider" type="Enterprise.Customs.AR.Manifest.GUI.ApplicationGUIProvider, Enterprise.Customs.AR.Manifest.GUI" singleton="false" />
</objects>
