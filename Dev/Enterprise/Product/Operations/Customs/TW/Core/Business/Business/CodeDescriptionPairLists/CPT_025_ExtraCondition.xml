<?xml version="1.0" encoding="utf-8"?>
<CodeDescriptionPairList xmlns="http://www.edi.com.au/CodeDescriptionPairList.xsd" xmlns:a="http://www.edi.com.au/CodeDescriptionPairList.xsd" a:Localizable="false" a:Sort="false">
  <Item>
    <Identifier>Unconditional</Identifier>
    <Code>0</Code>
    <Description>無附帶條件</Description>
  </Item>
  <Item>
    <Identifier>Escort</Identifier>
    <Code>1</Code>
    <Description>押運</Description>
  </Item>
  <Item>
    <Identifier>PickUpWithCompetentAuthority</Identifier>
    <Code>2</Code>
    <Description>會同主管機關提領</Description>
  </Item>
  <Item>
    <Identifier>PartNotReleased</Identifier>
    <Code>3</Code>
    <Description>部分不得放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaseWithSignature</Identifier>
    <Code>4</Code>
    <Description>驗放案件，憑海關驗貨員簽章始准放行</Description>
  </Item>
  <Item>
    <Identifier>Seal</Identifier>
    <Code>5</Code>
    <Description>加封</Description>
  </Item>
  <Item>
    <Identifier>ShallTakeDelivery</Identifier>
    <Code>6</Code>
    <Description>船邊免驗提貨</Description>
  </Item>
  <Item>
    <Identifier>ReleaseWithEntryInstructions</Identifier>
    <Code>7</Code>
    <Description>驗憑報單批示放行</Description>
  </Item>
  <Item>
    <Identifier>FreeTradeSpecialTransport</Identifier>
    <Code>8</Code>
    <Description>由貿易港區專用運貨工具運送（專用車隊或專用貨箱）</Description>
  </Item>
  <Item>
    <Identifier>PickupWithCombineCabinetDeclaration</Identifier>
    <Code>9</Code>
    <Description>合併櫃報單，應俟全數報單放行，始可提櫃</Description>
  </Item>
  <Item>
    <Identifier>ReleaselWithEquipmentInspectionNoAbnorma</Identifier>
    <Code>A</Code>
    <Description>儀器查驗無異狀後，憑海關儀檢關員簽章或N5116電腦訊息始准放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaselWithSealed</Identifier>
    <Code>B</Code>
    <Description>報單階段須加封海關電子封條，完成加封後始准放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaselWithInstrumentedInspectionAndSealed</Identifier>
    <Code>C</Code>
    <Description>報單階段須儀器查驗並加封海關電子封條，完成儀檢及加封後始准放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaselWithInstrumentedInspectionAndEscort</Identifier>
    <Code>D</Code>
    <Description>報單階段須儀器查驗及押運後始准放行</Description>
  </Item>
  <Item>
    <Identifier>PartReleaseWithElectronicSeal</Identifier>
    <Code>E</Code>
    <Description>報單階段部分放行及加封海關電子封條後始准放行</Description>
  </Item>
  <Item>
    <Identifier>MonitorLoadingOrEscort</Identifier>
    <Code>F</Code>
    <Description>應由關員監視裝櫃（打盤）裝船（機），跨管制區運送時並應押運，惟不同貨主之倂裝貨櫃得採加封電子封條方式辦理</Description>
  </Item>
  <Item>
    <Identifier>ReleaseWithPaperSealed</Identifier>
    <Code>G</Code>
    <Description>報單階段須加封海關電子紙封條，完成加封後始准放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaseAfterSnifferDogDetected</Identifier>
    <Code>H</Code>
    <Description>自由貿易港區貨物以海運郵遞出口案件，須經海關緝毒犬嗅聞後始准放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaseWithElectronicSealed</Identifier>
    <Code>I</Code>
    <Description>轉運/轉口須加封海關電子紙封條，完成加封後始准放行</Description>
  </Item>
  <Item>
    <Identifier>ReleaseWithElectronicSealAndPaperSeal</Identifier>
    <Code>J</Code>
    <Description>轉運/轉口須加封海關電子封條與電子紙封條，完成加封後始准放行行</Description>
  </Item>
  <Item>
    <Identifier>ReleaseWithSealAndInstrumentedInspection</Identifier>
    <Code>K</Code>
    <Description>轉運/轉口須加封海關電子封條與電子紙封條並經儀器檢查，完成後始准放行</Description>
  </Item>
</CodeDescriptionPairList>
