<?xml version="1.0" encoding="utf-8"?>
<!-- Shared inferred.... CREATED BY DANIEL CLARKE from the Vanuatu and PNG schemas.  Contains only what is COMMON to those two -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:element name="Asycuda_Manifest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Identification_segment">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Voyage_number" type="VoyageNumber"/>
              <xsd:element name="Date_of_departure" type="DepartureDate"/>
              <xsd:element name="Customs_office_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="OfficeCode"/>
                    <xsd:element name="Name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="General_segment">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Master_information" type="AN105"/>
              <xsd:element name="Totals_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Total_number_of_bols" type="TotalNoBols"/>
                    <xsd:element name="Total_numer_of_packages" type="xsd:anySimpleType"/>  <!-- DJC - Here is a difference-->
                    <xsd:element name="Total_number_of_containers" type="N5"/>
                    <xsd:element name="Total_gross_mass" type="xsd:anySimpleType"/>          <!-- DJC - Here is a difference-->
                    <xsd:element name="Total_tonnage_gross" type="GrossTonnage"/>
                    <xsd:element name="Total_tonnage_net" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Arrival_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Date_of_arrival" type="ArrivalDate"/>
                    <xsd:element name="Time_of_arrival" type="ArrivalTime"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Registration_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Registration_year" type="Prohibited"/>
                    <xsd:element name="Registration_serial_number" type="Prohibited"/>
                    <xsd:element name="Date_of_registration" type="Prohibited"/>
                    <xsd:element name="Time_of_registration" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Departure_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Place_of_departure_code" type="LocationCode"/>
                    <xsd:element name="Place_of_departure_name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Destination_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Place_of_destination_code" type="LocationCode"/>
                    <xsd:element name="Place_of_destination_name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Carrier_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Carrier_code" type="CarrierCode"/>
                    <xsd:element name="Carrier_name" type="AN35"/>
                    <xsd:element name="Carrier_address" type="AN140"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Transporter_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Name_of_transporter" type="AN27"/>
                    <xsd:element name="Place_of_transporter" type="AN35"/>
                    <xsd:element name="Mode_of_transport_segment">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Code" type="TransportMode"/>
                          <xsd:element name="Name" type="Prohibited"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Nationality_of_transport_segment">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Code" type="TransporterCountry"/>
                          <xsd:element name="Name" type="Prohibited"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Transporter_registration_segment">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Registration_number" type="AN35"/>
                          <xsd:element name="Registration_date" type="AN10"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="Bol_specific_segment" minOccurs="1" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Bol_reference" type="BolReference"/>
              <xsd:element name="Line_number" type="N5"/>
              <xsd:element name="Sub_line_number" type="N5"/>
              <xsd:element name="Status" type="BolStatus"/>
              <xsd:element name="Previous_document_reference" type="Prohibited"/>
              <xsd:element name="Bol_Nature" type="BolNature"/>
              <xsd:element name="Unique_carrier_reference" type="AN35"/>
              <xsd:element name="Total_number_of_containers" type="N8"/>
              <xsd:element name="Total_gross_mass_manifested" type="GrossMass"/>
              <xsd:element name="Volume_in_cubic_meters" type="TotalVolume"/>
              <xsd:element name="Number_of_sub_bols" type="NoSubBols"/>
              <xsd:element name="Bol_type_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="BolType"/>
                    <xsd:element name="Name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Exporter_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="Prohibited"/>
                    <xsd:element name="Name" type="ExporterName"/>
                    <xsd:element name="Address" type="AN140"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Consignee_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="AN17"/>
                    <xsd:element name="Name" type="AN35"/>
                    <xsd:element name="Address" type="AN140"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Notify_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="AN17"/>
                    <xsd:element name="Name" type="AN35"/>
                    <xsd:element name="Address" type="AN140"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Place_of_loading_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="LocationCode"/>
                    <xsd:element name="Name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Place_of_unloading_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Code" type="LocationCode"/>
                    <xsd:element name="Name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Packages_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Package_type_code" type="PackageType"/>
                    <xsd:element name="Package_type_name" type="Prohibited"/>
                    <xsd:element name="Number_of_packages" type="PackagesInBol"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Shipping_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Shipping_marks" type="AN350"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Goods_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Goods_description" type="AN175"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Freight_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Value" type="N15_Value"/>
                    <xsd:element name="Currency" type="CurrencyCode"/>
                    <xsd:element name="Indicator_segment">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Code" type="AN3"/>
                          <xsd:element name="Name" type="Prohibited"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Customs_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Value" type="N15_Value"/>
                    <xsd:element name="Currency" type="CurrencyCode"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Transport_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Value" type="N15_Value"/>
                    <xsd:element name="Currency" type="CurrencyCode"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Insurance_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Value" type="N15_Value"/>
                    <xsd:element name="Currency" type="CurrencyCode"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Seals_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Number_of_seals" type="NoOfSeals"/>
                    <xsd:element name="Marks_of_seals" type="AN20"/>
                    <xsd:element name="Sealing_party_code" type="SealPartyCode"/>
                    <xsd:element name="Sealing_party_name" type="Prohibited"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Information_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Information_part_a" type="AN70"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Operations_segment">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Packages_remaining" type="PackagesInBol"/>
                    <xsd:element name="Gross_mass_remaining" type="GrossMass"/>
                    <xsd:element name="Location_segment">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Code" type="ShedCode"/>
                          <xsd:element name="Name" type="AN35"/>
                          <xsd:element name="Information" type="AN35"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="Onward_transport_segment">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Transit_segment">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="Customs_office_code" type="Prohibited"/>
                                <xsd:element name="Customs_office_name" type="Prohibited"/>
                                <xsd:element name="Document_reference" type="Prohibited"/>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                          <xsd:element name="Transhipment_segment">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="Transhipment_location_code" type="Prohibited"/>
                                <xsd:element name="Transhipment_location_name" type="Prohibited"/>
                                <xsd:element name="Document_reference" type="Prohibited"/>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                          <xsd:element name="Onward_carrier_segment">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="Code" type="Prohibited"/>
                                <xsd:element name="Name" type="Prohibited"/>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Containers_segment" minOccurs="1" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="Container_Code" type="AN17"/>
                    <xsd:element name="Container_Type" type="ContainerType"/>
                    <xsd:element name="Container_Efi" type="ContainerEfi"/>
                    <xsd:element name="Container_Seal1" type="AN10"/>
                    <xsd:element name="Container_Seal2" type="AN10"/>
                    <xsd:element name="Container_Seal3" type="AN10"/>
                    <xsd:element name="Container_Seal_Party" type="SealPartyCode"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:simpleType name="VoyageNumber">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="17"/>
      <xsd:minLength value="1"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="DepartureDate">
    <xsd:restriction base="xsd:date"/>
  </xsd:simpleType>
  <xsd:simpleType name="OfficeCode">    <!-- DJC - here is a difference-->
    <xsd:restriction base="xsd:string">
      <!-- vanuatu-->
      <xsd:enumeration value="VSEA"/>
      <xsd:enumeration value="VAIR"/>
      <xsd:enumeration value="SSEA"/>
      <xsd:enumeration value="SAIR"/>
      <xsd:enumeration value="SPOST"/>
      <xsd:enumeration value="VPOST"/>
      <!-- PNG-->
      <xsd:enumeration value="ALO"/>
      <xsd:enumeration value="BPU"/>
      <xsd:enumeration value="DAU"/>
      <xsd:enumeration value="HGU"/>
      <xsd:enumeration value="JAS"/>
      <xsd:enumeration value="JAX"/>
      <xsd:enumeration value="KMB"/>
      <xsd:enumeration value="KVG"/>
      <xsd:enumeration value="LAE"/>
      <xsd:enumeration value="LNV"/>
      <xsd:enumeration value="LOR"/>
      <xsd:enumeration value="LPO"/>
      <xsd:enumeration value="MAG"/>
      <xsd:enumeration value="MIS"/>
      <xsd:enumeration value="PNP"/>
      <xsd:enumeration value="POM"/>
      <xsd:enumeration value="RAB"/>
      <xsd:enumeration value="SMR"/>
      <xsd:enumeration value="TBL"/>
      <xsd:enumeration value="UNG"/>
      <xsd:enumeration value="VAI"/>
      <xsd:enumeration value="WTG"/>
      <xsd:enumeration value="WWK"/>
      <xsd:maxLength value="5"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ArrivalDate">
    <xsd:union memberTypes="xsd:date">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value=""/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="ArrivalTime">
    <xsd:union memberTypes="xsd:time">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value=""/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="LocationCode">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="5"/>
      <xsd:minLength value="5"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="CarrierCode">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="17"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TransportMode">
    <xsd:restriction base="xsd:nonNegativeInteger">
      <xsd:enumeration value="1"/>
      <xsd:enumeration value="3"/>
      <xsd:enumeration value="4"/>
      <xsd:enumeration value="5"/>
      <xsd:totalDigits value="1"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TransporterCountry">
    <xsd:restriction base="xsd:string">
      <xsd:whiteSpace value="collapse"/>
      <xsd:maxLength value="2"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BolReference">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="17"/>
      <xsd:minLength value="1"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BolNature">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="22"/>
      <xsd:enumeration value="23"/>
      <xsd:enumeration value="24"/>
      <xsd:enumeration value="28"/>
      <xsd:maxLength value="2"/>
      <xsd:minLength value="2"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BolType">    <!-- DJC - here is a difference-->
    <xsd:restriction base="xsd:string">
      <!-- vanuatu-->
      <xsd:enumeration value="AWB"/>
      <xsd:enumeration value="BOL"/>
      <xsd:enumeration value="MAB"/>
      <xsd:enumeration value="MBL"/>
      <!--PNG-->      
      <xsd:enumeration value="HBL"/>
      <xsd:maxLength value="3"/>
      <xsd:minLength value="3"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="PackageType">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="17"/>
      <xsd:minLength value="2"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="CurrencyCode">
    <xsd:restriction base="xsd:string">
      <xsd:whiteSpace value="collapse"/>
      <xsd:maxLength value="3"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ShedCode">
    <xsd:restriction base="xsd:string">
      <xsd:whiteSpace value="collapse"/>
      <xsd:maxLength value="17"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SealPartyCode">    <!-- DJC - here is a difference-->
    <xsd:restriction base="xsd:string">
      <xsd:whiteSpace value="collapse"/>
      <!-- vanuatu-->
      <xsd:enumeration value="101"/>
      <xsd:enumeration value="CAR"/>
      <xsd:enumeration value="CON"/>
      <xsd:enumeration value="CUT"/>
      <xsd:enumeration value="FWD"/>
      <xsd:enumeration value="SOT"/>      
      <!--png-->
      <xsd:enumeration value="AGT"/>
      <xsd:enumeration value="CUS"/>
      <xsd:enumeration value="EXP"/>
      <xsd:enumeration value="HBB"/>
      <xsd:enumeration value="IMP"/>
      <xsd:enumeration value=""/>
      <xsd:maxLength value="3"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ContainerType"> <!-- DJC - here is a difference-->
    <xsd:restriction base="xsd:string">
      <!-- vanuatu-->
      <xsd:enumeration value="1B"/>
      <xsd:enumeration value="1O"/>
      <xsd:enumeration value="2B"/>
      <xsd:enumeration value="2O"/>
      <xsd:enumeration value="4B"/>
      <xsd:enumeration value="4O"/>
      <xsd:enumeration value="AT"/>
      <xsd:enumeration value="CN"/>
      <!--png-->
      <xsd:enumeration value="10FT"/>
      <xsd:enumeration value="20FT"/>
      <xsd:enumeration value="40FT"/>
      <xsd:enumeration value="OPNF"/>
      <xsd:enumeration value="ULD3"/>
      <xsd:enumeration value="ULD7"/>
      <xsd:enumeration value="ULD8"/>
      <xsd:enumeration value="ULD9"/>
      <xsd:enumeration value="VEHI"/>
      <xsd:enumeration value=""/>
      <xsd:maxLength value="4"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ContainerEfi">    <!-- DJC - Here is a difference-->
    <xsd:restriction base="xsd:string">
      <!-- vanuatu -->
      <xsd:enumeration value="FM"/>
      <xsd:enumeration value="FS"/>
      <xsd:enumeration value="MT"/>
      <!--png-->
      <xsd:enumeration value="EMT"/>
      <xsd:enumeration value="FUL"/>
      <xsd:enumeration value="PTL"/>
      <xsd:enumeration value=""/>
      <xsd:maxLength value="3"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BolStatus">
    <xsd:restriction base="xsd:integer">
      <xsd:pattern value="[0-4]{1}"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN3">
    <xsd:restriction base="xsd:string">
      <xsd:whiteSpace value="collapse"/>
      <xsd:maxLength value="3"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN5">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="5"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN10">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="10"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN17">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="17"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN20">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="20"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN27">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="27"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN35">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="35"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN70">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="70"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN105">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="105"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN140">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="140"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN175">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="175"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AN350">
    <xsd:restriction base="xsd:string">
      <xsd:maxLength value="350"/>
      <xsd:minLength value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="N5">
    <xsd:restriction base="xsd:nonNegativeInteger">
      <xsd:totalDigits value="5"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="N6">    <!-- DJC - Here is a difference-->
    <xsd:restriction base="xsd:nonNegativeInteger">
      <xsd:totalDigits value="6"/>
      <xsd:minExclusive value="0"/> <!-- This is for Vanuatu only and seems to mean they want >0 - affects NetTonnage and GrossTonnage only-->
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="N8">
    <xsd:restriction base="xsd:nonNegativeInteger">
      <xsd:totalDigits value="8"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="N15">
    <xsd:restriction base="xsd:nonNegativeInteger">
      <xsd:totalDigits value="15"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TotalNoBols">
    <xsd:restriction base="xsd:nonNegativeInteger">
      <xsd:totalDigits value="5"/>
      <xsd:minExclusive value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TotalNoPackages">
    <xsd:union memberTypes="N5">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value=""/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="TotalGrossMass">
    <xsd:union memberTypes="GrossMass">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value=""/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="GrossMass">
    <xsd:restriction base="xsd:decimal">
