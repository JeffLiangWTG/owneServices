				<!--가산세 합계-->
				<kcs:TotalTaxAmount>999</kcs:TotalTaxAmount>
				<wco:Payment>
					<!--납기내 세액-->
					<wco:PaymentAmount>999</wco:PaymentAmount>
					<!--수정신고 전자납부번호-->
