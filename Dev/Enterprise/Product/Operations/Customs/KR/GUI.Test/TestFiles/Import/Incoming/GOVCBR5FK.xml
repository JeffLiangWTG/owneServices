                <wco:TaxAssessedAmount>999</wco:TaxAssessedAmount>
            </wco:Payment>
        </wco:DutyTaxFee>
        
        <wco:DutyTaxFee>
            <!--세종부호세종을 표시 (CUD:관세,IND:개소세,ENV:교통세 ACT:주세,5AB:교육세,CAP: 농특세 VAT:부가세,5AC:신고지연가산세, 5AK:가산금, 5AY:미신고가산세 코드중 선택)-->
