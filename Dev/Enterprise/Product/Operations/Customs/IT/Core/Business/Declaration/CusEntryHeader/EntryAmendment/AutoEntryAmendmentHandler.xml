<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="EntryAmendmentHandler">
  <StringColumn>
    <Name>MovementReferenceNumber</Name>
    <AllowUnicode>false</AllowUnicode>
    <MaxLength>18</MaxLength>
    <Caption>MRN Number to amend</Caption>
  </StringColumn>
  <IntColumn>
    <Name>TotalEntryLines</Name>
    <Caption>Total Entry Lines in Original Declaration</Caption>
  </IntColumn>
  <BoolColumn>
    <Name>ShowTotalEntryLines</Name>
    <EditableState>GetterOnly</EditableState>
    <Caption>Show Total Entry Lines</Caption>
  </BoolColumn>
</NonPersistentBusinessObject>