<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cargowise="http://www.cargowise.com/2008/spring-extensions" xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd" default-lazy-init="true">
  <!-- Avoid using use singleton=true as this causes Spring to cache the object without the developer understanding the effects of this -->
  <!-- The xmlns:cargowise namespace works in conjunction with LazyConfiguredApplicationContext to prevent types being loaded unnecessarily on startup -->
  <!-- Customs IT H7-->
  <object id="ITH7.IAsycudaManifestHeader" type="Enterprise.Customs.IT.H7.Business.AsycudaManifestHeader, Enterprise.Customs.IT.H7.Business" singleton="false" />
  <object id="ITH7.ICusGoodsLocation" type="Enterprise.Customs.IT.H7.Business.CusGoodsLocation, Enterprise.Customs.IT.H7.Business" singleton="false" />

  <!-- GlobalManifestApplicationGuiProvider -->
  <object id="GlobalManifestApplicationGuiProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" isSubSet="true">
      <list>
        <ref object="IT.H7.ApplicationGUIProvider" />
      </list>
    </property>
  </object>
  <object id="IT.H7.ApplicationGUIProvider" type="Enterprise.Customs.IT.H7.GUI.H7ApplicationGUIProvider, Enterprise.Customs.IT.H7.GUI" singleton="false" />

  <!-- GlobalManifestApplicationBusinessProvider -->
  <object id="GlobalManifestApplicationBusinessProvider" type="CargoWise.Application.ListObject, CargoWise.ApplicationContext">
    <property name="SourceList" enableParallelInit="true" isSubSet="true">
      <list>
        <ref object="IT.H7.ApplicationBusinessProvider" />
      </list>
    </property>
  </object>
  <object id="IT.H7.ApplicationBusinessProvider" type="Enterprise.Customs.IT.H7.Business.H7ApplicationBusinessProvider, Enterprise.Customs.IT.H7.Business" singleton="false" />
</objects>  