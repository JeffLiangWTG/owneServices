<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="TransportBookingDocumentOptions"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<StringColumn>
		<Name>Template</Name>
		<Caption>Template</Caption>
		<EditableState>ReadWrite</EditableState>
		<GenerateValidation>true</GenerateValidation>
		<MaxLength>4</MaxLength>
	</StringColumn>

	<BoolColumn>
		<Name>ShowTemplateSelection</Name>
		<Editable>ReadWrite</Editable>
		<GenerateValidation>false</GenerateValidation>
	</BoolColumn>

	<BoolColumn>
		<Name>ShowAutoDelivery</Name>
		<Editable>ReadWrite</Editable>
		<GenerateValidation>false</GenerateValidation>
	</BoolColumn>

  <BoolColumn>
    <Name>ShowCommencedError</Name>
    <Editable>ReadWrite</Editable>
    <GenerateValidation>false</GenerateValidation>
  </BoolColumn>
	
</NonPersistentBusinessObject>