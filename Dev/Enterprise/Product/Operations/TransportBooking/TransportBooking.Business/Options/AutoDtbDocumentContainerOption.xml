<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DtbDocumentContainerOption"
	>

  <!--
	For instructions see:container num, seal, type, mode
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

  <StringColumn>
    <Name>ContainerNumber</Name>
    <Caption>Container #</Caption>
    <EditableState>ReadOnly</EditableState>
    <MaxLength>30</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>Seal</Name>
    <Caption>Seal #</Caption>
    <EditableState>ReadOnly</EditableState>
    <MaxLength>30</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>ContainerType</Name>
    <Caption>Container Type</Caption>
    <EditableState>ReadOnly</EditableState>
    <MaxLength>10</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>DeliverContainer</Name>
    <Caption>Deliver?</Caption>
    <EditableState>ReadWrite</EditableState>
  </BoolColumn>

  <IntColumn>
    <Name>Link</Name>
    <Caption>Link #</Caption>
    <EditableState>ReadOnly</EditableState>
  </IntColumn>

  <StringColumn>
    <Name>ReleaseNumber</Name>
    <Caption>Release #</Caption>
    <EditableState>ReadOnly</EditableState>
    <MaxLength>30</MaxLength>
  </StringColumn>

</NonPersistentBusinessObject>
