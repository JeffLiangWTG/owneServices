<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="StorageFeeInvoicePayment">
  
  <StringColumn>
    <Name>ContainerNumber</Name>
    <Caption>Container</Caption>
    <EditableState>GetterOnly</EditableState>
    <MaxLength>20</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>PortCode</Name>
    <Caption>Port Code</Caption>
    <EditableState>ReadOnly</EditableState>
    <MaxLength>20</MaxLength>
  </StringColumn>
  
  <DateTimeColumn>
    <Name>PickupDate</Name>
    <Caption>Pickup Date</Caption>
  </DateTimeColumn>
  
  <DecimalColumn>
    <Name>StorageCharges</Name>
    <Caption>Total Storage</Caption>
    <EditableState>ReadOnly</EditableState>
    <Precision>19</Precision>
    <Scale>4</Scale>
  </DecimalColumn>
  
  <StringColumn>
    <Name>ApportionmentMethod</Name>
    <Caption>Cost Allocation Method</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>
  
  <GuidColumn>    
    <Name>ChargeCode</Name>    
    <Caption>Charge Code</Caption>
  </GuidColumn>
  
  <StringColumn>
    <Name>LocalCurrency</Name>
    <EditableState>GetterOnly</EditableState>
		<MaxLength>3</MaxLength>
