{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "PaymentRequest",
	"type": "object",
	"properties": {
		"dealInternalReference": {
			"type": "string"
		},
		"quoteProviderReference": {
			"type": "string"
		},
		"bankAccountCode": {
			"type": "string"
		},
		"minFundAmount": {
			"type": "number",
			"description": "Minimum local amount"
		},
		"maxFundAmount": {
			"type": "number",
			"description": "Maximum local amount"
		},
		"fundCurrency": {
			"type": "string",
			"description": "Local currency"
		},
		"payAmount": {
			"type": "number",
			"description": "OS amount"
		},
		"payCurrency": {
			"type": "string",
			"description": "OS currency"
		},
		"paymentItems": {
			"type": "array",
			"items": [
				{
					"type": "object",
					"properties": {
						"payeeId": {
							"type": "string"
						},
						"amount": {
							"type": "number"
						},
						"payReason": {
							"type": "string"
						},
						"payReference": {
							"type": "string"
						}
					}
				}
			]
		}
	}
}
