<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="DataExportPaidTransaction">

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

  <StringColumn>
    <Name>AH_TransactionNum</Name>
    <Caption>Transaction Number</Caption>
    <MaxLength>100</MaxLength>
  </StringColumn>

  <DateTimeColumn>
    <Name>AH_InvoiceDate</Name>
    <Caption>Invoice Date</Caption>
  </DateTimeColumn>
  
  <DateTimeColumn>
    <Name>AH_PostDate</Name>
    <Caption>Post Date</Caption>
  </DateTimeColumn>
  
  <DateTimeColumn>
    <Name>AH_DueDate</Name>
    <Caption>Due Date</Caption>
  </DateTimeColumn>

  <GuidColumn>
    <Name>AH_OH</Name>
    <Caption>Organization</Caption>
  </GuidColumn>

  <StringColumn>
    <Name>AH_RX_NKTransactionCurrency</Name>
    <Caption>Currency</Caption>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>AH_Desc</Name>
    <Caption>Description</Caption>
    <MaxLength>1000</MaxLength>
  </StringColumn>

  <DecimalColumn>
    <Name>AH_OSExTaxAmount</Name>
    <Caption>Transaction Ex Tax Amount</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>
  
  <DecimalColumn>
    <Name>AH_OSTaxAmount</Name>
    <Caption>Transaction Tax Amount</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <DecimalColumn>
    <Name>AH_OSTotalAmount</Name>
    <Caption>Transaction Total Amount</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <DecimalColumn>
    <Name>AH_ExchangeRate</Name>
    <Caption>Exchange Rate</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <DecimalColumn>
    <Name>LocalMatchedAmount</Name>
    <Caption>Matched Amount in Local Currency</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <DecimalColumn>
    <Name>OSMatchedAmount</Name>
    <Caption>Matched Amount in Transaction Currency</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <DecimalColumn>
    <Name>LocalAmountInPaymentCurrency</Name>
    <Caption>Matched Amount in Payment Currency</Caption>
    <Precision>18</Precision>
    <Scale>4</Scale>
  </DecimalColumn>
 
  <StringColumn>
    <Name>InvoiceRemittanceReference</Name>
    <Caption>Invoice Remittance Reference</Caption>
    <MaxLength>120</MaxLength>
  </StringColumn>

</NonPersistentBusinessObject>
