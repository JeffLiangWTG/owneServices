<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Enterprise.Accounting.GUI</AssemblyName>
    <RootNamespace>Enterprise.Accounting.GUI</RootNamespace>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
    <UseLegacyRsa>false</UseLegacyRsa>
    <CWUsesSqlClient>true</CWUsesSqlClient>
    <CWUsesDesignRef>true</CWUsesDesignRef>
    <!-- Need to change safeguard file which contains System.Windows.Forms.Design instead of System.Design -->
    <CWAccountingSafeguardFilename Condition="'$(CanNetCoreLibBeReferencedFromWinzor)' == 'true'">$(WTGBranchRoot)NetCore\Temp_TransitionToNet8\Enterprise.Accounting.GUI.Winzor.net8.0-windows.BaselineReferences.txt</CWAccountingSafeguardFilename>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Formats.Asn1" />
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Accounting.TaxFramework\GUI\Accounting.TaxFramework.GUI.Winzor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Accounting.eInvoicing.Egypt" />
    <Reference Include="CargoWise.IO" />
    <Reference Include="Enterprise.Accounting.Integration.Testing" />
    <Reference Include="Enterprise.Rating.Rateable" />
    <Reference Include="WinzorFramework" />
  </ItemGroup>
</Project>