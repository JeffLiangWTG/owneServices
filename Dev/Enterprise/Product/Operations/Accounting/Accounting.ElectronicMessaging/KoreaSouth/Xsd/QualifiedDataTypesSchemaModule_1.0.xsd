	<!-- ===== Type Definition: ExchangedIssueDateTimeType ===== -->
	<!-- ================================================================== -->
	<xsd:simpleType name="ExchangedIssueDateTimeSimpleType">
		<xsd:restriction base="xsd:decimal">
			<xsd:totalDigits value="14"/>
			<xsd:pattern value="\d{4}\d{2}\d{2}\d{2}\d{2}\d{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="ExchangedIssueDateTimeType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">
				<ccts:UniqueID>NTS2009001</ccts:UniqueID>
				<ccts:Acronym>DT</ccts:Acronym>
				<ccts:DictionaryEntryName>Exchanged Issue_ Date Time. Type</ccts:DictionaryEntryName>
				<ccts:Version>1.0</ccts:Version>
				<ccts:Definition>
		  A particular point in the progression of time defined by a mandatory date and an optional
		  time component.
		</ccts:Definition>
				<ccts:PrimaryRepresentationTerm>Date Time</ccts:PrimaryRepresentationTerm>
				<ccts:PrimitiveType>String</ccts:PrimitiveType>
				<ccts:DataTypeQualifierTerm>Date Mandatory</ccts:DataTypeQualifierTerm>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:union memberTypes="ExchangedIssueDateTimeSimpleType"/>
	</xsd:simpleType>
