<xsd:schema
	xmlns:qdt="urn:kr:or:kec:standard:Tax:QualifiedDataTypesSchemaModule:1:0"
	xmlns="urn:kr:or:kec:standard:Tax:ReusableAggregateBusinessInformationEntitySchemaModule:1:0"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:kr:or:kec:standard:Tax:ReusableAggregateBusinessInformationEntitySchemaModule:1:0" elementFormDefault="qualified"
attributeFormDefault="unqualified">
	<xsd:import namespace="urn:kr:or:kec:standard:Tax:QualifiedDataTypesSchemaModule:1:0" schemaLocation="QualifiedDataTypesSchemaModule_1.0.xsd"/>
	<!-- ===== ExchangedDocument. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="ExchangedDocumentType">
		<xsd:sequence>
			<xsd:element name="ID" type="qdt:TaxInvoiceIDType" minOccurs="0"/>
			<xsd:element name="IssueDateTime" type="qdt:ExchangedIssueDateTimeType"/>
			<xsd:element name="ReferencedDocument" type="ReferencedDocumentType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== ReferenceID. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="ReferencedDocumentType">
		<xsd:sequence>
			<xsd:element name="ID" type="qdt:TaxInvoiceReferencedDocumentIDSimpleType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== TaxInvoiceDocument. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="TaxInvoiceDocumentType">
		<xsd:sequence>
			<xsd:element name="IssueID" type="qdt:TaxInvoiceIssueIDType"/>
			<xsd:element name="TypeCode" type="qdt:TaxInvoiceTypeCodeType"/>
			<xsd:element name="DescriptionText" type="qdt:TaxInvoiceFreeTextType" minOccurs="0" maxOccurs="3"/>
			<xsd:element name="IssueDateTime" type="qdt:TaxInvoiceDateType"/>
			<xsd:element name="AmendmentStatusCode" type="qdt:TaxInvoiceAmendmentStatusCodeType" minOccurs="0"/>
			<xsd:element name="PurposeCode" type="qdt:TaxInvoicePurposeCodeType" minOccurs="0"/>
			<xsd:element name="OriginalIssueID" type="qdt:TaxInvoiceIssueIDType" minOccurs="0"/>
			<xsd:element name="ReferencedImportDocument" type="ReferencedImportDocumentType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== ImportDocument. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="ReferencedImportDocumentType">
		<xsd:sequence>
			<xsd:element name="ID" type="qdt:TaxInvoiceReferenceImportIDType" minOccurs="0"/>
			<xsd:element name="ItemQuantity" type="qdt:TaxInvoiceReferenceImportQuantityType" minOccurs="0"/>
			<xsd:element name="AcceptablePeriod" type="TaxInvoicePeriodType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== TaxInvoicePeriodType. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="TaxInvoicePeriodType">
		<xsd:sequence>
			<xsd:element name="StartDateTime" type="qdt:TaxInvoiceDateType" minOccurs="0"/>
			<xsd:element name="EndDateTime" type="qdt:TaxInvoiceDateType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== TaxInvoiceTradeSettlement. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="TaxInvoiceTradeSettlementType">
		<xsd:sequence>
			<xsd:element name="InvoicerParty" type="InvoicerPartyType"/>
			<xsd:element name="InvoiceeParty" type="InvoiceePartyType"/>
			<xsd:element name="BrokerParty" type="BrokerPartyType" minOccurs="0"/>
			<xsd:element name="SpecifiedPaymentMeans" type="SpecifiedPaymentMeansType" minOccurs="0" maxOccurs="4"/>
			<xsd:element name="SpecifiedMonetarySummation" type="SpecifiedMonetarySummationType"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== InvoicerParty. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="InvoicerPartyType">
		<xsd:sequence>
			<xsd:element name="ID" type="qdt:TaxInvoicePartyIDType"/>
			<xsd:element name="TypeCode" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="NameText" type="qdt:TaxInvoicePartyNameTextType"/>
			<xsd:element name="ClassificationCode" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="SpecifiedOrganization" type="SpecifiedOrganizationType" minOccurs="0"/>
			<xsd:element name="SpecifiedPerson" type="SpecifiedPersonType"/>
			<xsd:element name="DefinedContact" type="DefinedContactType" minOccurs="0"/>
			<xsd:element name="SpecifiedAddress" type="SpecifiedAddressType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== InvoiceeParty. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="InvoiceePartyType">
		<xsd:sequence>
			<xsd:element name="ID" type="qdt:TaxInvoicePartyIDType"/>
			<xsd:element name="TypeCode" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="NameText" type="qdt:TaxInvoicePartyNameTextType"/>
			<xsd:element name="ClassificationCode" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="SpecifiedOrganization" type="InvoiceeSpecifiedOrganizationType"/>
			<xsd:element name="SpecifiedPerson" type="SpecifiedPersonType"/>
			<xsd:element name="PrimaryDefinedContact" type="DefinedContactType" minOccurs="0"/>
			<xsd:element name="SecondaryDefinedContact" type="DefinedContactType" minOccurs="0"/>
			<xsd:element name="SpecifiedAddress" type="SpecifiedAddressType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== BrokerParty. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="BrokerPartyType">
		<xsd:sequence>
			<xsd:element name="ID" type="qdt:TaxInvoicePartyIDType"/>
			<xsd:element name="TypeCode" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="NameText" type="qdt:TaxInvoicePartyNameTextType"/>
			<xsd:element name="ClassificationCode" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="SpecifiedOrganization" type="SpecifiedOrganizationType" minOccurs="0"/>
			<xsd:element name="SpecifiedPerson" type="SpecifiedPersonType"/>
			<xsd:element name="DefinedContact" type="DefinedContactType" minOccurs="0"/>
			<xsd:element name="SpecifiedAddress" type="SpecifiedAddressType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== SpecifiedOrganization. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="SpecifiedOrganizationType">
		<xsd:sequence>
			<xsd:element name="TaxRegistrationID" type="qdt:TaxInvoicePartyTaxIDType"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== SpecifiedOrganization. Type for Invoicee ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="InvoiceeSpecifiedOrganizationType">
		<xsd:sequence>
			<xsd:element name="TaxRegistrationID" type="qdt:TaxInvoicePartyTaxIDType" minOccurs="0"/>
			<xsd:element name="BusinessTypeCode" type="qdt:TaxInvoiceBusinessTypeCodeType"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== SpecifiedPerson. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="SpecifiedPersonType">
		<xsd:sequence>
			<xsd:element name="NameText" type="qdt:TaxInvoicePersonNameTextType"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== DefinedContact. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="DefinedContactType">
		<xsd:sequence>
			<xsd:element name="DepartmentNameText" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
			<xsd:element name="PersonNameText" type="qdt:TaxInvoicePersonNameTextType" minOccurs="0"/>
			<xsd:element name="TelephoneCommunication" type="qdt:TaxInvoiceCallTextType" minOccurs="0"/>
			<xsd:element name="URICommunication" type="qdt:TaxInvoicePartyTextType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== SpecifiedAddress. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="SpecifiedAddressType">
		<xsd:sequence>
			<xsd:element name="LineOneText" type="qdt:TaxInvoiceFreeTextType"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== PaymentMeans. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="SpecifiedPaymentMeansType">
		<xsd:sequence>
			<xsd:element name="TypeCode" type="qdt:TaxInvoicePaymentMeansCodeType" minOccurs="0"/>
			<xsd:element name="PaidAmount" type="qdt:TaxInvoicePaidAmountType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== MonetarySummation. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="SpecifiedMonetarySummationType">
		<xsd:sequence>
			<xsd:element name="ChargeTotalAmount" type="qdt:TaxInvoiceAmountNoFracType"/>
			<xsd:element name="TaxTotalAmount" type="qdt:TaxInvoiceAmountNoFracType" minOccurs="0"/>
			<xsd:element name="GrandTotalAmount" type="qdt:TaxInvoiceAmountNoFracType"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== TaxInvoiceTradeLineItem. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="TaxInvoiceTradeLineItemType">
		<xsd:sequence>
			<xsd:element name="SequenceNumeric" type="qdt:TaxInvoiceLineItemNumericType" minOccurs="1"/>
			<xsd:element name="DescriptionText" type="qdt:TaxInvoiceLineItemTextType" minOccurs="0"/>
			<xsd:element name="InvoiceAmount" type="qdt:TaxInvoiceAmountNoFracType" minOccurs="0"/>
			<xsd:element name="ChargeableUnitQuantity" type="qdt:TaxInvoiceUnitQuantityType" minOccurs="0"/>
			<xsd:element name="InformationText" type="qdt:TaxInvoiceLineItemInformationTextType" minOccurs="0"/>
			<xsd:element name="NameText" type="qdt:TaxInvoiceLineItemTextType" minOccurs="0"/>
			<xsd:element name="PurchaseExpiryDateTime" type="qdt:TaxInvoiceDateType" minOccurs="0"/>
			<xsd:element name="TotalTax" type="TotalTaxType" minOccurs="0"/>
			<xsd:element name="UnitPrice" type="UnitPriceType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== TotalTax. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="TotalTaxType">
		<xsd:sequence>
			<xsd:element name="CalculatedAmount" type="qdt:TaxInvoiceAmountNoFracType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== UnitPrice. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="UnitPriceType">
		<xsd:sequence>
			<xsd:element name="UnitAmount" type="qdt:TaxInvoiceAmountType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== ResultDocument. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="ResultDocumentType">
		<xsd:sequence>
			<xsd:element name="RefSubmitID" type="qdt:TaxInvoiceSubmitIDType"/>
			<xsd:element name="ReceiptID" type="qdt:TaxInvoiceReceiptIDType"/>
			<xsd:element name="TypeCode" type="qdt:TaxInvoiceResultTypeCodeType"/>
			<xsd:element name="ResponseDateTime" type="qdt:ExchangedIssueDateTimeType"/>
			<xsd:element name="ProcessStatusCode" type="qdt:TaxInvoiceProcessStatusCodeType" minOccurs="0"/>
			<xsd:element name="FailReasonStatusCode" type="qdt:TaxInvoiceFailStatusCodeType" minOccurs="0"/>
			<xsd:element name="TotalCountQuantity" type="qdt:TaxInvoiceCountQuantityType" minOccurs="0"/>
			<xsd:element name="SuccessCountQuantity" type="qdt:TaxInvoiceCountQuantityType" minOccurs="0"/>
			<xsd:element name="FailCountQuantity" type="qdt:TaxInvoiceCountQuantityType" minOccurs="0"/>
			<xsd:element name="ValidationDocument" type="ValidationDocumentType" minOccurs="0" maxOccurs="100"/>
			<xsd:element name="DescriptionText" type="qdt:TaxInvoiceFreeTextType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- ===== ValidationDocument. Type ===== -->
	<!-- =================================================================== -->
	<xsd:complexType name="ValidationDocumentType">
		<xsd:sequence>
			<xsd:element name="IssueID" type="qdt:TaxInvoiceIssueIDType"/>
			<xsd:element name="ResultStatusCode" type="qdt:TaxInvoiceResultStatusCodeType" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
