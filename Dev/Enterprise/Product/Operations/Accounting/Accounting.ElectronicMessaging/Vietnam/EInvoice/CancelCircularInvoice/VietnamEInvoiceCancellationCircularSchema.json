{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "title": "Vietnam EInvoice Cancellation Schema(Circular 78)",
  "description": "JSON Schema for Vietnam E-Invoice JSON file format. Our NewtonSoft JSON Schema Validator library supports only 'draft-03' schema version",
  "type": "object",
	"properties": {
		"lang": {
			"description": "Language of the error message returned",
			"type": "string"
		},
		"user": {
			"description": "user",
			"type": "object",
			"properties": {
				"username": {
					"description": "User name = {TaxCode}.{UserName}",
					"type": "string",
					"required": false
				},
				"password": {
					"description": "Access Password",
					"type": "string",
					"required": false
				}
			}
		},
		"wrongnotice": {
			"description": "wrongnotice",
			"type": "object",
			"properties": {
				"stax": {
					"description": "Login branch proxy organization VN VAT number",
					"type": "string",
					"required": true
				},
				"noti_taxtype": {
					"description": "The cancellation is requested by the tax payer or GDT",
					"type": "string",
					"required": true
				},
				"noti_taxnum": {
					"description": "This notification number will be given by GDT",
					"type": "string",
					"required": false
				},
				"noti_taxdt": {
					"description": "Referring to the date of GDT's notification",
					"type": "string",
					"required": false
				},
				"budget_relationid": {
					"description": "Budget relation unit code",
					"type": "string",
					"required": false
				},
				"place": {
					"description": "Seller's city name",
					"type": "string",
					"required": true
				},
				"items": {
					"description": "items",
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"properties": {
							"form": {
								"description": "Original invoice form number",
								"type": "string",
								"required": true
							},
							"serial": {
								"description": "Original invoice's series prefix",
								"type": "string",
								"required": true
							},
							"seq": {
								"description": "Original invoice's sequence number",
								"type": "string",
								"required": true
							},
							"idt": {
								"description": "Issued date with format 'yyyy-mm-dd hh:mm'",
								"type": "string",
								"required": true
							},
							"type_ref": {
								"description": "Type Reference",
								"type": "number",
								"required": true
							},
							"noti_type": {
								"description": "Type",
								"type": "string",
								"required": true
							},
							"rea": {
								"description": "Reason for the cancellation",
								"type": "string",
								"required": false
							}
						}
					}
				}
			}
		}
	}
}
