{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "title": "Vietnam EInvoice Cancellation Schema",
  "description": "JSON Schema for Vietnam E-Invoice JSON file format. Our NewtonSoft JSON Schema Validator library supports only 'draft-03' schema version",
  "type": "object",
  "properties": {
	"lang": {
			"description": "Language of the error message returned",
			"type": "string"
	},
	"user": {
	  "description": "user",
	  "type": "object",
	  "properties": {
		"username": {
		  "description": "User name = {TaxCode}.{UserName}",
		  "type": "string",
		  "required": false
		},
		"password": {
		  "description": "Access Password",
		  "type": "string",
		  "required": false
		}
	  }
	},
	"inv": {
	  "description": "inv",
	  "type": "object",
	  "properties": {
		"seq": {
		  "description": "Invoice number with full format: {Form.No}-{SerialNo.}-{Invoice No.} need to be cancelled",
		  "type": "string",
		  "required": true
		},
		"adj": {
		  "description": "adj",
		  "type": "object",
		  "properties": {
			"rdt": {
			  "description": "Agreement minute",
			  "type": "string",
			  "required": true
			},
			"rea": {
			  "description": "Reason for cancellation",
			  "type": "string",
			  "required": false
			},
			"ref": {
			  "description": "Number of agreement minute",
			  "type": "string",
			  "required": true
			}
		  }
		}
	  }
	}
  }
}
