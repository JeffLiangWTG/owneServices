{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "title": "Vietnam EInvoice Schema",
  "description": "JSON Schema for Vietnam E-Invoice JSON file format. Our NewtonSoft JSON Schema Validator library supports only 'draft-03' schema version",
  "type": "object",
  "properties": {
	"user": {
	  "description": "user",
	  "type": "object",
	  "properties": {
		"username": {
		  "description": "User name = {TaxCode}.{UserName}",
		  "type": "string",
		  "required": false
		},
		"password": {
		  "description": "Access Password",
		  "type": "string",
		  "required": false
		}
	  }
	},
	"lang": {
	  "description": "Language of the error message returned",
	  "type": "string"
	},
	"adj": {
	  "description": "Adjustment",
	  "type": "object",
	  "properties": {
		"rdt": {
		  "description": "Date of agreement minute",
		  "type": "string",
		  "required": true
		},
		"rea": {
		  "description": "Reason for adjustment",
		  "type": "string",
		  "required": false
		},
		"ref": {
		  "description": "Number of agreent nimute",
		  "type": "string",
		  "required": true
		},
		"seq": {
		  "description": "Information of origin invoice with full format: {Form No.}-{Serial No.}-{Invoice No.}",
		  "type": "string",
		  "required": true
		}
	  }
	},
	"inv": {
	  "description": "Invoice",
	  "type": "object",
	  "properties": {
		"aun": {
		  "description": "",
		  "type": "integer"
		},
		"sid": {
		  "description": "ReferenceID. It is a unique number of the record of enterprise",
		  "type": "string",
		  "required": true
		},
		"idt": {
		  "description": "Issued date with format 'yyyy-mm-dd hh:mm'",
		  "type": "string",
		  "required": true
		},
		"type": {
		  "description": "Invoice type",
		  "type": "string",
		  "maxLength": 10,
		  "required": true
		},
		"form": {
		  "description": "Form No. {Form is invoice form no. that have been registered(Not Fixed)}",
		  "type": "string",
		  "maxLength": 11
		},
		"serial": {
		  "description": "Serial No. {Serial is invoice serial no. that have been registered(Not Fixed)}",
		  "type": "string",
		  "maxLength": 6
		},
		"ud": {
		  "description": "Identify the adjustment to increase or reduce. 0: Reduce, 1: Increase",
		  "type": "number"
		},
		"seq": {
		  "description": "Invoice No",
		  "type": "string",
		  "maxLength": 8
		},
		"bname": {
		  "description": "Buyer's company",
		  "type": "string",
		  "maxLength": 255,
		  "required": true
		},
		"buyer": {
		  "description": "Buyer name",
		  "type": "string",
		  "maxLength": 100
		},
		"btax": {
		  "description": "Buyer's tax code",
		  "type": "string",
		  "maxLength": 14
		},
		"baddr": {
		  "description": "Buyer's address",
		  "type": "string",
		  "maxLength": 255,
		  "required": true
		},
		"btel": {
		  "description": "Buyer's telephone",
		  "type": "string",
		  "maxLength": 100
		},
		"bmail": {
			"description": "Buyer's email",
			"type": "string",
			"maxLength": 255
		},
		"paym": {
		  "description": "Payment method",
		  "type": "string",
		  "maxLength": 10,
		  "required": true
		},
		"curr": {
		  "description": "Currency",
		  "type": "string",
		  "maxLength": 3,
		  "required": true
		},
		"exrt": {
		  "description": "Exchange rate",
		  "type": "number",
		  "required": true
		},
		"bacc": {
		  "description": "Buyer's account",
		  "type": "string",
		  "maxLength": 100
		},
		"bbank": {
		  "description": "Buyer's bank",
		  "type": "string",
		  "maxLength": 100
		},
		"note": {
		  "description": "Note",
		  "type": "string",
		  "maxLength": 255
		},
		"sumv": {
		  "description": "Total amount in VND(no tax)",
		  "type": "number",
		  "required": true
		},
		"sum": {
		  "description": "Total amount(no tax)",
		  "type": "number",
		  "required": true
		},
		"vatx": {
		  "description": "Total VAT amount in VND",
		  "type": "number"
		},
		"vat": {
		  "description": "Total VAT amount",
		  "type": "number",
		  "required": true
		},
		"word": {
		  "description": "Total payment amount in word",
		  "type": "string",
		  "required": true
		},
		"totalv": {
		  "description": "Total payment amount in VND include VAT",
		  "type": "number",
		  "required": true
		},
		"discount": {
		  "description": "",
		  "type": "string"
		},
		"total": {
		  "description": "Total payment amount",
		  "type": "number",
		  "required": true
		},
		"type_ref": {
		  "description": "Type Reference",
		  "type": "number",
		  "required": false
		},
		"sendtype": {
		  "description": "Send Type",
		  "type": "number",
		  "required": false
		}
		},
	  "items": {
		"description": "Invoice Lines",
		"type": "array",
		"minItems": 1,
		"items": {
		  "type": "object",
		  "properties": {
			"type": {
			  "description": "",
			  "type": "string"
			},
			"vrt": {
			  "description": "Tax rate",
			  "type": "string"
			},
			"line": {
			  "description": "Line",
			  "type": "number"
			},
			"name": {
			  "description": "Goods's name",
			  "type": "string",
			  "required": true
			},
			"unit": {
			  "description": "Unit",
			  "type": "string"
			},
			"amount": {
			  "description": "Amount",
			  "type": "number",
			  "required": true
			},
			"price": {
			  "description": "Price",
			  "type": "number"
			},
			"quantity": {
			  "description": "Quantity",
			  "type": "number"
			},
			"vat": {
			  "description": "os tax amount",
			  "type": "number"
			},
			"total": {
			  "description": "os total amount",
			  "type": "number"
			},
			"status": {
				"description": "Identify adjustments to increase or reduce of tiem that want to adjust. 0: Reduce, 1: Increase",
				"type": "number"
			},
			"c0": {
			  "description": "local tax amount",
			  "type": "string"
			},
			"c1": {
			  "description": "total local amount",
			  "type": "string"
			},
			"c2": {
			  "description": "local total amount excluding tax",
			  "type": "string"
			},
			"c3": {
			  "description": "house billing number",
			  "type": "string"
			}
			}
		}
	  },
	  "c0": {
		"description": "Due Date with format 'yyyy-mm-dd'",
		"type": "string"
	  },
	  "c1": {
		"description": "Consignor Name",
		"type": "string"
	  },
	  "c2": {
		"description": "Reference",
		"type": "string"
	  },
	  "c3": {
		"description": "Consignee Name",
		"type": "string"
	  },
	  "c4": {
		"description": "ETD with format 'yyyy-mm-dd'",
		"type": "string"
	  },
	  "c5": {
		"description": "Flight Number or Journey Reference",
		"type": "string"
	  },
	  "c6": {
		"description": "ETA with format 'yyyy-mm-dd'",
		"type": "string"
	  },
	  "c7": {
		"description": "Master Bill",
		"type": "string"
	  },
	  "c8": {
		"description": "House Bill",
		"type": "string"
	  },
	  "c9": {
		"description": "AdditionalInfo",
		"type": "string"
	  }
	}
  }
}
