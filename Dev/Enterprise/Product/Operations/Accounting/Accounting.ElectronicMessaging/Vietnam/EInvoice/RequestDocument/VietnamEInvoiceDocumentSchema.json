{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "title": "Vietnam EInvoice document Schema",
  "description": "JSON Schema for Vietnam E-Invoice JSON file format. Our NewtonSoft JSON Schema Validator library supports only 'draft-03' schema version",
  "type": "object",
  "properties": {
	"user": {
	  "description": "user",
	  "type": "object",
	  "properties": {
		"username": {
		  "description": "User name = {TaxCode}.{UserName}",
		  "type": "string",
		  "required": false
		},
		"password": {
		  "description": "Access Password",
		  "type": "string",
		  "required": false
		}
	  }
	},
	"inv": {
	  "description": "Invoice",
	  "type": "object",
	  "properties": {
		"stax": {
		  "description": "Seller's tax code",
		  "type": "string",
		  "maxLength": 14,
		  "required": true
		},
		"type": {
		  "description": "Type of respond data",
		  "type": "string",
		  "required": true,
		  "enum": [
			"json",
			"xml",
			"pdf",
			"cvt"
		  ]
		},
		"sid": {
		  "description": "ReferenceID. It is a unique number of the record of enterprise",
		  "type": "string",
		  "required": true
		}
	  }
	}
  }
}
