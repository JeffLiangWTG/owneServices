{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "China EInvoice Schema",
	"type": "object",
	"properties": {
		"reqType": {
			"type": "string",
			"maxLength": 3
		},
		"taxNo": {
			"type": "string",
			"maxLength": 20
		},
		"clientNo": {
			"type": "string",
			"maxLength": 50
		},
		"data": {
			"type": "object",
			"properties": {
				"serialNumber": {
					"type": "string",
					"maxLength": 100
				},
				"invType": {
					"type": "string",
					"maxLength": 2
				},
				"version": {
					"type": "string",
					"maxLength": 4
				},
				"drawer": {
					"type": "string",
					"maxLength": 8
				},
				"payee": {
					"type": "string",
					"maxLength": 8
				},
				"reviewer": {
					"type": "string",
					"maxLength": 8
				},
				"seller": {
					"type": "object",
					"properties": {
						"identifier": {
							"type": "string",
							"maxLength": 20
						},
						"name": {
							"type": "string",
							"maxLength": 100
						},
						"address": {
							"type": "string",
							"maxLength": 100
						},
						"telephoneNo": {
							"type": "string",
							"maxLength": 20
						},
						"bank": {
							"type": "string",
							"maxLength": 100
						},
						"bankAcc": {
							"type": "string",
							"maxLength": 30
						}
					}
				},
				"order": {
					"type": "object",
					"properties": {
						"orderNo": {
							"type": "string",
							"maxLength": 20
						},
						"invoiceList": {
							"type": "string",
							"maxLength": 1
						},
						"invoiceSplit": {
							"type": "string",
							"maxLength": 1
						},
						"invoiceSfdy": {
							"type": "string",
							"maxLength": 1
						},
						"orderDate": {
							"type": "string",
							"maxLength": 100
						},
						"chargeTaxWay": {
							"type": "string",
							"maxLength": 30
						},
						"totalAmount": {
							"type": "string"
						},
						"taxMark": {
							"type": "string",
							"maxLength": 1
						},
						"totalDiscount": {
							"type": "string"
						},
						"remark": {
							"type": "string",
							"maxLength": 400
						},
						"extractedCode": {
							"type": "string",
							"maxLength": 100
						},
						"buyer": {
							"type": "object",
							"properties": {
								"customerType": {
									"type": "string",
									"maxLength": 1
								},
								"identifier": {
									"type": "string",
									"maxLength": 20
								},
								"name": {
									"type": "string",
									"maxLength": 100
								},
								"address": {
									"type": "string"
								},
								"telephoneNo": {
									"type": "string"
								},
								"bank": {
									"type": "string",
									"maxLength": 100
								},
								"bankAcc": {
									"type": "string",
									"maxLength": 30
								},
								"email": {
									"type": "string",
									"maxLength": 50
								},
								"memberId": {
									"type": "string",
									"maxLength": 30
								},
								"isSend": {
									"type": "string",
									"maxLength": 1
								},
								"recipient": {
									"type": "string",
									"maxLength": 50
								},
								"reciAddress": {
									"type": "string",
									"maxLength": 200
								},
								"zip": {
									"type": "string",
									"maxLength": 6
								}
							},
							"required": [
								"customerType",
								"identifier",
								"name",
								"address",
								"telephoneNo",
								"bank",
								"bankAcc"
							]
						},
						"orderDetails": {
							"type": "array",
							"minItems": 1,
							"orderDetail": [
								{
									"type": "object",
									"properties": {
										"venderOwnCode": {
											"type": "string",
											"maxLength": 20
										},
										"productCode": {
											"type": "string",
											"maxLength": 19
										},
										"productName": {
											"type": "string",
											"maxLength": 30
										},
										"rowType": {
											"type": "string",
											"maxLength": 1
										},
										"spec": {
											"type": "string",
											"maxLength": 20
										},
										"unit": {
											"type": "string",
											"maxLength": 20
										},
										"quantity": {
											"type": "string"
										},
										"unitPrice": {
											"type": "string"
										},
										"amount": {
											"type": "string"
										},
										"deductAmount": {
											"type": "string"
										},
										"taxRate": {
											"type": "string"
										},
										"taxAmount": {
											"type": "string"
										},
										"mxTotalAmount": {
											"type": "string"
										},
										"taxRateMark": {
											"type": "string",
											"maxLength": 1
										},
										"policyMark": {
											"type": "string",
											"maxLength": 1
										},
										"policyName": {
											"type": "string",
											"maxLength": 100
										}
									},
									"required": [
										"productName",
										"rowType",
										"amount",
										"taxRate",
										"mxTotalAmount"
									]
								}
							]
						}
					},
					"required": [
						"orderNo",
						"invoiceSfdy",
						"orderDate",
						"chargeTaxWay",
						"totalAmount",
						"taxMark",
						"buyer",
						"orderDetails"
					]
				}
			},
			"required": [
				"serialNumber",
				"invType",
				"order"
			]
		}
	},
	"required": [
		"reqType",
		"taxNo",
		"clientNo",
		"data"
	]
}
