{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "China Search EInvoice Schema",
	"type": "object",
	"properties": {
		"reqType": {
			"type": "string",
			"maxLength": 3
		},
		"data": {
			"type": "object",
			"properties": {
				"serialNumber": {
					"type": "string",
					"maxLength": 100
				}
			},
			"required": [
				"serialNumber"
			]
		}
	},
	"required": [
		"reqType",
		"data"
	]
}
