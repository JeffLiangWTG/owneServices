<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="RefExchangeRateCalculator"
	validationStyle="ValidationClass">

	<StringColumn>
		<Name>QuoteCurrency</Name>
		<AllowUnicode>false</AllowUnicode>
		<MaxLength>3</MaxLength>
		<VariableMaxLength>3</VariableMaxLength>
		<GenerateValidation>false</GenerateValidation>
	</StringColumn>
	<DecimalColumn>
		<Name>QuoteCurrencyValue</Name>
		<Caption>Quote Currency Value</Caption>
		<Precision>18</Precision>
		<Scale>2</Scale>
		<GenerateValidation>true</GenerateValidation>
	</DecimalColumn>
	<StringColumn>
		<Name>BaseCurrency</Name>
		<AllowUnicode>false</AllowUnicode>
		<MaxLength>3</MaxLength>
		<VariableMaxLength>3</VariableMaxLength>
		<GenerateValidation>false</GenerateValidation>
	</StringColumn>
	<DecimalColumn>
		<Name>BaseCurrencyValue</Name>
		<Caption>Base Currency Value</Caption>
		<Precision>18</Precision>
		<Scale>6</Scale>
		<GenerateValidation>true</GenerateValidation>
	</DecimalColumn>

</NonPersistentBusinessObject>