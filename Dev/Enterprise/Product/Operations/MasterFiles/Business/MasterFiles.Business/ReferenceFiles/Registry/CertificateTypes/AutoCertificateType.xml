<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="CertificateType"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<StringColumn>
		<Name>Code</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Description</Name>
		<MaxLength>35</MaxLength>
	</StringColumn>

	<BoolColumn>
		<Name>IsSystem</Name>
	</BoolColumn>

	<BoolColumn>
		<Name>IsMandatory</Name>
	</BoolColumn>

	<BoolColumn>
		<Name>IsUnique</Name>
	</BoolColumn>

  <StringColumn>
    <Name>AlertType</Name>
    <MaxLength>35</MaxLength>
  </StringColumn>
  
	<Serialisation>
		<Template>
			<Code>{value:Code}</Code>
			<Description>{value:Description}</Description>
			<IsSystem>{value:IsSystem}</IsSystem>
			<IsMandatory>{value:IsMandatory}</IsMandatory>
      <IsUnique>{value:IsUnique}</IsUnique>
      <AlertType>{value:AlertType}</AlertType>
		</Template>
	</Serialisation>
</RegistryBusinessObjectTemplate>
