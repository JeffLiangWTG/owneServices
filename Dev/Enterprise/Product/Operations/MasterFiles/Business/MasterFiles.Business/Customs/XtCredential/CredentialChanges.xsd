<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="http://cargowise.com/xhub/credentials"
		   xmlns:xs="http://www.w3.org/2001/XMLSchema"
		   xmlns:xc ="http://cargowise.com/xhub/credentials">
	<xs:element name="CredentialChanges">
		<xs:complexType>
			<xs:sequence minOccurs="1">
				<xs:element name="CredentialChange">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ChangeType" type="xc:ChangeTypeType">
								<xs:annotation>
									<xs:documentation>
										<description value="Change Type, Allows: New, Update, Delete"/>
										<format value="n..16,6"/>
										<optionality value="O"/>
									</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="ChangeDateTime" type="xs:dateTime"></xs:element>
							<xs:element name="EnterpriseCode" type="xs:string"></xs:element>
							<xs:element name="DatabaseCode" type="xs:string"></xs:element>
							<xs:element name="DatabaseNumber" type="xs:string"></xs:element>
							<xs:element name="LicenceType" type="xc:LicenceTypeType"></xs:element>
							<xs:element name="Password" type="xs:string"></xs:element>
							<xs:element name="OldPassword" type="xs:string"></xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		
	</xs:element>

	<xs:simpleType name="ChangeTypeType" >
		<xs:restriction base="xs:string">
			<xs:pattern value = "^Add|Update|Delete$"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="LicenceTypeType" >
		<xs:restriction base="xs:string">
			<xs:pattern value = "^TST|TRD|TRN$"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
