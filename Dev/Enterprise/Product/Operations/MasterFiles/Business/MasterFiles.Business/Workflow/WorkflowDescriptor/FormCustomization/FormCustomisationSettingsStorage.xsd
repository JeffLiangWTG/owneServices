<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.edi.com.au/EnterpriseService/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.edi.com.au/EnterpriseService/" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="FormCustomisationSettingsStorage">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Tab" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Name" type="xs:string"/>
							<xs:element name="Description" type="xs:string"/>
							<xs:element name="Visible" type="xs:boolean"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Field" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Name" type="xs:string"/>
							<xs:element name="Description" type="xs:string"/>
							<xs:element name="Group" type="xs:string" minOccurs="0"/>
							<xs:element name="Visible" type="xs:boolean"/>
							<xs:element name="TabName" type="xs:string" minOccurs="0"/>
							<xs:element name="Placement" type="xs:string" minOccurs="0"/>
							<xs:element name="Position" type="xs:int"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
