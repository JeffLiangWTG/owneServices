<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="FormCustomisableElement"
	>

	<!--
	For instructions see:
	http://sharepoint.corporate.cargowise.com/Wiki/Wiki%20Pages/NonPersistentBusinessObjectGenerator.aspx.
	-->
	
	<StringColumn>
		<Name>ElementName</Name>
		<MaxLength>100</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>ElementDescription</Name>
		<MaxLength>100</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<StringColumn>
		<Name>ElementGroup</Name>
		<MaxLength>100</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<BoolColumn>
		<Name>Visible</Name>
	</BoolColumn>

	<StringColumn>
		<Name>Placement</Name>
		<MaxLength>100</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>DisplayTab</Name>
		<MaxLength>100</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<IntColumn>
		<Name>RowNumber</Name>
	</IntColumn>

</NonPersistentBusinessObject>