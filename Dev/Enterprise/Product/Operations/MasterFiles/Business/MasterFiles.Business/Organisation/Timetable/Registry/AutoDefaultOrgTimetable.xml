<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DefaultOrgTimetable"
	>

  <!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

  <StringColumn>
    <Name>Type</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>
  <DateTimeColumn>
    <Name>From</Name>
  </DateTimeColumn>
  <DateTimeColumn>
    <Name>To</Name>
  </DateTimeColumn>
  <StringColumn>
    <Name>Day</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>
  <DateTimeColumn>
    <Name>CutOffTime</Name>
  </DateTimeColumn>
  <IntColumn>
    <Name>ProcessingTime</Name>
  </IntColumn>

  <Serialisation>
    <Template>
      <Type>{value:Type}</Type>
      <From>{value:From}</From>
      <To>{value:To}</To>
      <Day>{value:Day}</Day>
      <CutOffTime>{value:CutOffTime}</CutOffTime>
      <ProcessingTime>{value:ProcessingTime}</ProcessingTime>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>