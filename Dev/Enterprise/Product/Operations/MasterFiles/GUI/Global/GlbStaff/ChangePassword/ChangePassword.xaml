<Window x:Class="Enterprise.MasterFiles.GUI.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
        mc:Ignorable="d"
        Title="ChangePassword"
        Width="400"
        Height="auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="./Resource/Resource.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Border BorderBrush="Transparent" Background="Transparent" BorderThickness="4" CornerRadius="8">
		<Border CornerRadius="8" BorderThickness="1" Padding="16" BorderBrush="{StaticResource BorderColor}" Background="{StaticResource NeutralColor}">
			<Border.Effect>
				<DropShadowEffect BlurRadius="5" Direction="-50" RenderingBias="Quality" ShadowDepth="2" Color="#1b1b1a29"/>
			</Border.Effect>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"></RowDefinition>
					<RowDefinition Height="Auto"></RowDefinition>
					<RowDefinition Height="Auto"></RowDefinition>
					<RowDefinition Height="Auto"></RowDefinition>
					<RowDefinition Height="Auto"></RowDefinition>
					<RowDefinition Height="Auto"></RowDefinition>
					<RowDefinition Height="1*" MinHeight="20"></RowDefinition>
				</Grid.RowDefinitions>
				<ui:MultilingualTextLabel Style="{StaticResource TitleLabel}" MultilingualText="{Binding Title}" Content="{Binding Title}" />
				<StackPanel Grid.Row="1" Style="{StaticResource InputGroup}">
					<ui:MultilingualTextLabel Style="{StaticResource BaseLabel}" MultilingualText="{Binding UserNameLabel}" Content="{Binding UserNameLabel}" />
					<TextBox x:Name="UserNameTextBox" Style="{StaticResource DisabledTextBox}" Text="{Binding UserName, Mode=OneWay}" IsReadOnly="True" IsEnabled="False" />
				</StackPanel>
				<StackPanel Grid.Row="2" Style="{StaticResource InputGroup}" Visibility="{Binding RequireOldPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
					<ui:MultilingualTextLabel Style="{StaticResource BaseLabel}" MultilingualText="{Binding OldPasswordLabel}" Content="{Binding OldPasswordLabel}" />
					<PasswordBox
						x:Name="OldPasswordInput"
						Style="{StaticResource PasswordBoxInput}"
						PasswordChanged="OldPassword_PasswordChanged"
						GotFocus="OldPasswordInput_GotFocus"
						IsEnabled="{Binding RequireOldPassword}" />
				</StackPanel>
				<StackPanel Grid.Row="3" Style="{StaticResource InputGroup}">
					<ui:MultilingualTextLabel Style="{StaticResource BaseLabel}" MultilingualText="{Binding NewPasswordLabel}" Content="{Binding NewPasswordLabel}" />
					<PasswordBox x:Name="NewPasswordInput" Style="{StaticResource PasswordBoxInput}" PasswordChanged="NewPassword_PasswordChanged" GotFocus="NewPasswordInput_GotFocus"/>
				</StackPanel>
				<StackPanel Grid.Row="4" Style="{StaticResource InputGroup}">
					<ui:MultilingualTextLabel Style="{StaticResource BaseLabel}" MultilingualText="{Binding NewPasswordConfirmLabel}" Content="{Binding NewPasswordConfirmLabel}" />
					<PasswordBox x:Name="NewPasswordConfirmInput" Style="{StaticResource PasswordBoxInput}" PasswordChanged="NewPasswordConfirm_PasswordChanged" GotFocus="NewPasswordConfirmInput_GotFocus"/>
				</StackPanel>
				<Border Grid.Row="5"
						Margin="0,12,0,0"
						Style="{StaticResource ErrorCallout}"
						Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal">
						<Image Margin="0,0,8,0">
							<Image.Source>
								<DrawingImage>
									<DrawingImage.Drawing>
										<DrawingGroup ClipGeometry="M0,0 V20 H20 V0 H0 Z">
