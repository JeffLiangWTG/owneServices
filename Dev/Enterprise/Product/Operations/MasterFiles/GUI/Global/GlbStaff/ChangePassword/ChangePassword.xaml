											</DrawingGroup>
										</DrawingGroup>
									</DrawingImage.Drawing>
								</DrawingImage>
							</Image.Source>
						</Image>
						<ui:MultilingualTextLabel IsTranslatable="False" Style="{StaticResource CalloutLabel}">
							<TextBlock x:Name="ErrorTextBlock" Width="320" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
						</ui:MultilingualTextLabel>
					</StackPanel>
				</Border>
				<StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
					<ui:MultilingualTextLabel MultilingualText="{Binding ApplyCaption}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="4,0,4,0">
						<Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="{Binding ApplyCaption}" Click="ApplyButton_Click" />
					</ui:MultilingualTextLabel>
					<ui:MultilingualTextLabel MultilingualText="{Binding CancelCaption}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="4,0,0,0">
						<Button x:Name="CancelButton" Style="{StaticResource NeutralButton}" Content="{Binding CancelCaption}" Click="CancelButton_Click" IsCancel="true"/>
					</ui:MultilingualTextLabel>
				</StackPanel>
			</Grid>
		</Border>
	</Border>
</Window>
