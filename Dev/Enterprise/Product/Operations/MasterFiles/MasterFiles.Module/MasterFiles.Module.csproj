<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AssemblyName>Enterprise.MasterFiles.Module</AssemblyName>
    <RootNamespace>Enterprise.MasterFiles.Module</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Organisation\OrgImport\Autos\AutoOrgFlattened.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoOrgFlattened.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessManagement\ModuleFilters\TasksStaffCanDoModuleFilterModes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TasksStaffCanDoModuleFilterModes.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessManagement\ProcessTaskTemplate\PartialTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>PartialTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessManagement\ProcessTaskTemplate\UniversalTemplateTypeList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>UniversalTemplateTypeList.xml</DependentUpon>
    </Compile>
    <Compile Update="ProcessManagement\Workflow\TemplateFilterOptions.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TemplateFilterOptions.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Organisation\OrgImport\Autos\AutoOrgFlattened.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoOrgFlattened.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.MasterFiles.Module.Organisation.OrgImport</CustomToolNamespace>
    </None>
    <None Update="ProcessManagement\ModuleFilters\TasksStaffCanDoModuleFilterModes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TasksStaffCanDoModuleFilterModes.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.MasterFiles.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessManagement\ProcessTaskTemplate\PartialTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>PartialTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.MasterFiles.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessManagement\ProcessTaskTemplate\UniversalTemplateTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>UniversalTemplateTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.MasterFiles.Module</CustomToolNamespace>
    </None>
    <None Update="ProcessManagement\Workflow\TemplateFilterOptions.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TemplateFilterOptions.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.MasterFiles.Module</CustomToolNamespace>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GUI\MasterFiles.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="OrgSupplierPart\ImporterSupplier Filter Strip\ImporterSupplierFilterStrip.resx" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>