<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Rating.Testing</RootNamespace>
    <AssemblyName>Enterprise.Rating.Testing</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.FeatureControl.Abstractions" />
    <Reference Include="CargoWise.Main.Navigation" />
    <Reference Include="CargoWise.Main.Navigation.Test" />
    <Reference Include="Moq" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GUI\Rating.GUI.csproj" />
    <ProjectReference Include="..\Rating.Module\Rating.Module.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BusinessTests\ForwardingRatingIntegration\ForwardingRatingIntegrationAddressAndPostcodeTest.cs">
      <DependentUpon>ForwardingRatingIntegrationTest.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>