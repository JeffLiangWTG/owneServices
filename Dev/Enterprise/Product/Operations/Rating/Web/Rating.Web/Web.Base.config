<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
  <appSettings>
    <add key="owin:appStartup" value="Enterprise.Rating.Web.Configuration.RatingAPIsStartup, Enterprise.Rating.Web"/>
  </appSettings>
  <location inheritInChildApplications="false">
    <system.web>
      <customErrors mode="RemoteOnly" redirectMode="ResponseRewrite">
        <error statusCode="400" redirect="~/CustomError.aspx?statusCode=400&amp;message=400+Bad+Request"/>
        <error statusCode="401" redirect="~/CustomError.aspx?statusCode=401&amp;message=401+Unauthorized"/>
        <error statusCode="403" redirect="~/CustomError.aspx?statusCode=403&amp;message=403+Forbidden"/>
        <error statusCode="404" redirect="~/CustomError.aspx?statusCode=404&amp;message=404+Not+Found"/>
        <error statusCode="405" redirect="~/CustomError.aspx?statusCode=405&amp;message=405+Method+Not+Allowed"/>
        <error statusCode="406" redirect="~/CustomError.aspx?statusCode=406&amp;message=406+Not+Acceptable"/>
        <error statusCode="412" redirect="~/CustomError.aspx?statusCode=412&amp;message=412+Precondition+Failed"/>
        <error statusCode="500" redirect="~/CustomError.aspx?statusCode=500&amp;message=500+Internal+Server+Error"/>
        <error statusCode="501" redirect="~/CustomError.aspx?statusCode=501&amp;message=501+Not+Implemented"/>
        <error statusCode="502" redirect="~/CustomError.aspx?statusCode=502&amp;message=502+Bad+Gateway"/>
      </customErrors>
      <compilation debug="true" targetFramework="4.8">
        <assemblies>
          <!-- Avoid loading all assemblies in the bin folder, most of which we don't need -->
          <remove assembly="*" />
          <!-- Bootstrap the OWIN host -->
          <add assembly="Microsoft.Owin.Host.SystemWeb"/>
          <!-- Bootstrap Global.asax -->
          <add assembly="Enterprise.Rating.Web"/>
        </assemblies>
      </compilation>
      <httpRuntime targetFramework="4.8" enableVersionHeader="false"/>
      <hostingEnvironment shadowCopyBinAssemblies="false"/>
    </system.web>
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <runtime>
