meta {
  name: Call endpoint using both RateOrigin and RateDestination
  type: http
  seq: 21
}

post {
  url: {{BaseApplicationURL}}/api/rating/companytariffs/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetRateQueryWithMandatoryFieldsForProvidedVariables(false);
   query.RateOrigin = 
       {
           Type: bru.getEnvVar("RateOriginType"),
           Value: bru.getEnvVar("RateOriginValue")
       };
   query.RateDestination =
       {
           Type: bru.getEnvVar("RateDestinationType"),
           Value: bru.getEnvVar("RateDestinationValue")
       };
   req.setBody(query);
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
}
