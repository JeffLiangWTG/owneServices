meta {
  name: Commodities is provided for JobCharges Endpoint
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.Commodities = [{ Type: "CW", Value: "HAZD" }];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Commodities is not applicable for job charges calculation endpoint. JobContainer.Commodity or JobPackLine.Commodity should be used.", function() {
    expect(res.body.ModelState['Commodities'][0]).to.equal("Commodities is not applicable for job charges calculation endpoint. JobContainer.Commodity or JobPackLine.Commodity should be used.");
  });
}
