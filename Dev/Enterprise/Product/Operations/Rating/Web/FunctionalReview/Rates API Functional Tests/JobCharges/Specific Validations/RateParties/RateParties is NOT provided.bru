meta {
  name: RateParties is NOT provided
  type: http
  seq: 2
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   delete query.RateParties;
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: RateParties cannot be null or empty.", function() {
    expect(res.body.ModelState['RateParties'][0]).to.equal("RateParties cannot be null or empty.");
  });
}
