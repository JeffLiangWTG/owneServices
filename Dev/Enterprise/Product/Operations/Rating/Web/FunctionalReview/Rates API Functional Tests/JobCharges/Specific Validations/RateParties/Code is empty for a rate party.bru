meta {
  name: Code is empty for a rate party
  type: http
  seq: 6
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.RateParties = [
       {Code: "", Role: "SAG"},
       {Code: "EFGH", Role: "RAG"},
   ];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Code is Mandatory.", function() {
    expect(res.body.ModelState['RateParties[0].Code'][0]).to.equal("Code is Mandatory.");
  });
}
