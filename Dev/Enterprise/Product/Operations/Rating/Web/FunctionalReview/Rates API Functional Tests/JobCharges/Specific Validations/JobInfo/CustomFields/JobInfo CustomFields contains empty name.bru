meta {
  name: JobInfo CustomFields contains empty name
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.JobInfo = RatesAPIsHelper.GetJobInfo();
   query.JobInfo.CustomFields = RatesAPIsHelper.GetValidCustomFields();
   query.JobInfo.CustomFields[0].Name = "";
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided JobServices is not valid. It shouldn't contain null elements.", function() {
    expect(res.body.ModelState['JobInfo.JobServices'][0]).to.equal("Provided JobServices is not valid. It shouldn't contain null elements.");
  });
}
