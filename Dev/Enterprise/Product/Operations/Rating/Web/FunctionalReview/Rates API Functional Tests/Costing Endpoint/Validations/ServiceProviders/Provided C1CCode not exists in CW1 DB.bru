meta {
  name: Provided C1CCode not exists in CW1 DB
  type: http
  seq: 15
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.ServiceProviders = [ {C1CCode : "ABCD" }];
   req.setBody(query);
   
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Logs should contain: Provided Service Provider with C1C Code 'ABCD' does not exists in CargoWise.", function() {
    expect(res.body.Warnings).to.include("Provided Service Provider with C1C Code 'ABCD' does not exists in CargoWise.");
  });
  
  
}
