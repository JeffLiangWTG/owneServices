meta {
  name: GatewayServiceLevels contains elements with more than 3 characters
  type: http
  seq: 7
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.GatewayServiceLevels = ["ABCD", "EFG"];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided GatewayServiceLevels ('ABCD') is not valid. It can be a string of maximum 3 characters.", function() {
    expect(res.body.ModelState['GatewayServiceLevels[0]'][0]).to.equal("Provided GatewayServiceLevels ('ABCD') is not valid. It can be a string of maximum 3 characters.");
  });
  
  
}
