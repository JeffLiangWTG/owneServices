meta {
  name: Call endpoint using Commodities with Universal Commodity Group Code
  type: http
  seq: 16
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetRateQueryWithMandatoryFieldsForProvidedVariables();
   query.Commodities = RatesAPIsHelper.GetCommoditiesWithUniversalCommodityGroupCodes();
   
   req.setBody(query);
}

tests {
  
}
