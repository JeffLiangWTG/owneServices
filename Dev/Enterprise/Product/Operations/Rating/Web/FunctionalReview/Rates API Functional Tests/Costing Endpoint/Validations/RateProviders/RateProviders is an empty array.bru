meta {
  name: RateProviders is an empty array
  type: http
  seq: 3
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.RateProviders = [];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: RateProviders is Mandatory.", function() {
    expect(res.body.ModelState['RateProviders'][0]).to.equal("RateProviders is Mandatory.");
  });
}
