meta {
  name: Call endpoint using CarrierServiceLevels with Universal Code
  type: http
  seq: 9
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetRateQueryWithMandatoryFieldsForProvidedVariables();
   query.CarrierServiceLevels = RatesAPIsHelper.GetCarrierServiceLevelssWithUniversalCodes();
   
   req.setBody(query);
}

tests {
  
}
