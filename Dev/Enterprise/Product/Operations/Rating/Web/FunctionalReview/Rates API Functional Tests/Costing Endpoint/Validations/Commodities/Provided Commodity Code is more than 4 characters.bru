meta {
  name: Provided Commodity Code is more than 4 characters
  type: http
  seq: 9
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.Commodities = [{ Type: "CW", Value: "ABCDE" }];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided commodity code ('ABCDE') is not valid. It can be a string of maximum 4 characters.", function() {
    expect(res.body.ModelState['Commodities[0].Value'][0]).to.equal("Provided commodity code ('ABCDE') is not valid. It can be a string of maximum 4 characters.");
  });
}
