meta {
  name: Provided CW1 Value is more than 3 characters
  type: http
  seq: 9
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.CarrierServiceLevels = [{ Type: "CW", Value: "STDE" }];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided Value as CargoWise code ('STDE') is not valid. It can be a string of maximum 3 characters.", function() {
    expect(res.body.ModelState['CarrierServiceLevels[0].Value'][0]).to.equal("Provided Value as CargoWise code ('STDE') is not valid. It can be a string of maximum 3 characters.");
  });
}
