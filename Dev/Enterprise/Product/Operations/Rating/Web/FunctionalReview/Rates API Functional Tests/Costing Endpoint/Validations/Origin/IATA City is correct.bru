meta {
  name: IATA City is correct
  type: http
  seq: 11
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.Origin = { Type: "IATACITY", Value: "SYD" };
   query.TransportMode = "AIR";
   query.ContainerMode = "LSE";
   req.setBody(query);
   
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
}
