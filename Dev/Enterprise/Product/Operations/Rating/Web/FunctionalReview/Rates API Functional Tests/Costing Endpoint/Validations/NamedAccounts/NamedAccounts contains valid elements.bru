meta {
  name: NamedAccounts contains valid elements
  type: http
  seq: 7
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.NamedAccounts = [ {Type: "CW" , Value:"ORG001"}, { Type: "NAC", Value:"NAC0093843" }];
   req.setBody(query);
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
  
  
}
