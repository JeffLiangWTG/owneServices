meta {
  name: CalculationScope is provided for NON jobcharges endpoint
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.CalculationScope = "A";
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: CalculationScope is only applicable for job charges calculation endpoint.", function() {
    expect(res.body.ModelState['CalculationScope'][0]).to.equal("CalculationScope is only applicable for job charges calculation endpoint.");
  });
}
