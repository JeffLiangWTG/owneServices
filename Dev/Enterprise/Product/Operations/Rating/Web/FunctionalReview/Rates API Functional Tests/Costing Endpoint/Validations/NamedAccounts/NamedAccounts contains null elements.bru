meta {
  name: NamedAccounts contains null elements
  type: http
  seq: 4
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.NamedAccounts = [null];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided NamedAccounts is not valid. It shouldn't contain null elements.", function() {
    expect(res.body.ModelState['NamedAccounts'][0]).to.equal("Provided NamedAccounts is not valid. It shouldn't contain null elements.");
  });
  
  
}
