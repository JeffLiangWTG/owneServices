meta {
  name: CarrierContracts is provided for intercompanytariffs request
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/intercompanytariffs/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForIntercompanyTariffs();
   query.CarrierContracts = ["ABC", "DEF", "GHIJKLMNO", "P", "28374293779237"];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Carrier Contract numbers are only accepted when querying Costings or calculating charges.", function() {
    expect(res.body.ModelState['CarrierContracts'][0]).to.equal("Carrier Contract numbers are only accepted when querying Costings or calculating charges.");
  });
}
