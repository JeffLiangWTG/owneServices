meta {
  name: CarrierContracts contains null element
  type: http
  seq: 4
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.CarrierContracts = ["ABC", null];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Shound Return : CarrierContracts cannot contain null elements.", function() {
    expect(res.body.ModelState['CarrierContracts'][0]).to.equal("CarrierContracts cannot contain null elements.");
  });
}
