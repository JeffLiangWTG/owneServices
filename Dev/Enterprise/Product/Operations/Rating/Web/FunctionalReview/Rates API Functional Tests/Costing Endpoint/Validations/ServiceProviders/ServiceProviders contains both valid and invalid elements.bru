meta {
  name: ServiceProviders contains both valid and invalid elements
  type: http
  seq: 7
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.ServiceProviders = [ {CWCode : "CH01" }, { Prop1: "ABCD", Prop2: "", Prop3: null }];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: One and only one of the following properties must be specified for a service provider: 'CWCode', 'SCAC', 'IATACode' or 'C1CCode'.", function() {
    expect(res.body.ModelState['ServiceProviders[1]'][0]).to.equal("One and only one of the following properties must be specified for a service provider: 'CWCode', 'SCAC', 'IATACode' or 'C1CCode'.");
  });
  
  
}
