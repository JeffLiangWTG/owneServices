meta {
  name: CarrierPayTerm is not correct
  type: http
  seq: 5
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.CarrierPayTerm = "XXX";
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided CarrierPayTerm ('XXX') is not valid. It can only be one of these values: 'PPD', 'CCX'.", function() {
    expect(res.body.ModelState['CarrierPayTerm'][0]).to.equal("Provided CarrierPayTerm ('XXX') is not valid. It can only be one of these values: 'PPD', 'CCX'.");
  });
}
