meta {
  name: RateOrigin can not be provided when querying Costing
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.RateOrigin = {};
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: RateOrigin can not be provided when querying Costing.", function() {
    expect(res.body.ModelState['RateOrigin'][0]).to.equal("RateOrigin can not be provided when querying Costing.");
  });
  
}
