meta {
  name: Call endpoint using only PlannedDischarge
  type: http
  seq: 25
}

post {
  url: {{BaseApplicationURL}}/api/rating/clientrates/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();
  
   var query = RatesAPIsHelper.GetClientRateQueryWithMandatoryFieldsForProvidedVariables();
   query.PlannedDischarge =
       {
           Type: bru.getEnvVar("PlannedDischargeType"),
           Value: bru.getEnvVar("PlannedDischargeValue")
       };
   req.setBody(query);
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
}
