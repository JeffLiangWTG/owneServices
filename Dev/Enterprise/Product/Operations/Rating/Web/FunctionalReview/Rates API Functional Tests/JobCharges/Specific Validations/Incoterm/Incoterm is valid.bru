meta {
  name: Incoterm is valid
  type: http
  seq: 6
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.Incoterm = "EXW";
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
}
