meta {
  name: References contains null elements
  type: http
  seq: 11
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   
   query.TransportMode = "AIR";
   query.ContainerMode = "LSE";
   
   
   query.CGFilter = { References: [null] }
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided References is not valid. It shouldn't contain null or empty elements.", function() {
    expect(res.body.ModelState['CGFilter.References'][0]).to.equal("Provided References is not valid. It shouldn't contain null or empty elements.");
  });
  
  
}
