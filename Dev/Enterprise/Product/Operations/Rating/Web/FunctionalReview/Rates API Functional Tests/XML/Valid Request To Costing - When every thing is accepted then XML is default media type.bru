meta {
  name: Valid Request To Costing - When every thing is accepted then XML is default media type
  type: http
  seq: 3
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

headers {
  Accept: */*
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   req.setBody(query);
   
   
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Should return json content", function() {
    expect(res.getHeader('content-type')).to.equal('application/xml; charset=utf-8');
  });
}
