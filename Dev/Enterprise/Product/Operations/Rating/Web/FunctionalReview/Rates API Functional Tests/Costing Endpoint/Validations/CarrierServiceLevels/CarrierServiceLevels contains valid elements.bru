meta {
  name: CarrierServiceLevels contains valid elements
  type: http
  seq: 7
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.CarrierServiceLevels = [ {Type: "CW" , Value:"STD"}, { Type: "UC", Value:"DIR" }];
   req.setBody(query);
   
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
  
  
}
