meta {
  name: There is  a null element between RateParties
  type: http
  seq: 5
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.RateParties = [
       {Code: "ABCD", Role: "SAG"},
       null,
       {Code: "EFGH", Role: "RAG"},
   ];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: RateParties cannot contain null elements.", function() {
    expect(res.body.ModelState['RateParties'][0]).to.equal("RateParties cannot contain null elements.");
  });
}
