meta {
  name: Provided Type is not valid
  type: http
  seq: 8
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.CarrierServiceLevels = [{ Type: "ABCD", Value: "STD" }];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided Type ('ABCD') is not valid. It can only be one of these values: 'CW', 'UC'.", function() {
    expect(res.body.ModelState['CarrierServiceLevels[0].Type'][0]).to.equal("Provided Type ('ABCD') is not valid. It can only be one of these values: 'CW', 'UC'.");
  });
}
