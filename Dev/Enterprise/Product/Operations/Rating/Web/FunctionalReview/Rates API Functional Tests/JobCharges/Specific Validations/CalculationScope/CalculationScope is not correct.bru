meta {
  name: CalculationScope is not correct
  type: http
  seq: 5
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.CalculationScope = "XXX";
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided CalculationScope ('XXX') is not valid. It can only be one of these values: 'C', 'R', 'A'.", function() {
    expect(res.body.ModelState['CalculationScope'][0]).to.equal("Provided CalculationScope ('XXX') is not valid. It can only be one of these values: 'C', 'R', 'A'.");
  });
}
