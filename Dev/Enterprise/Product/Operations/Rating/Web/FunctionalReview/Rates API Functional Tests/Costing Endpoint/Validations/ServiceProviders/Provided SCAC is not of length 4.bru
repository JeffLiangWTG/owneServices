meta {
  name: Provided SCAC is not of length 4
  type: http
  seq: 11
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.ServiceProviders = [ {SCAC : "ABCDE"}, {SCAC: "ABC"} ];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided SCAC code ('ABCDE') is not valid. SCAC code length must be 4.", function() {
    expect(res.body.ModelState['ServiceProviders[0].SCAC'][0]).to.equal("Provided SCAC code ('ABCDE') is not valid. SCAC code length must be 4.");
  });
  
  test("Should return: Provided SCAC code ('ABC') is not valid. SCAC code length must be 4.", function() {
    expect(res.body.ModelState['ServiceProviders[1].SCAC'][0]).to.equal("Provided SCAC code ('ABC') is not valid. SCAC code length must be 4.");
  });
  
  
}
