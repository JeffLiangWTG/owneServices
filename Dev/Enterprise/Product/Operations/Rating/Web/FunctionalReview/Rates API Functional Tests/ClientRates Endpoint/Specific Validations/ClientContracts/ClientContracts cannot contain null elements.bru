meta {
  name: ClientContracts cannot contain null elements
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/clientrates/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForClientRates();
   query.Client = "ABC";
   query.ClientContracts = ["ABC", null, "GHIJKLMNO", "P", "28374293779237"];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: ClientContracts cannot contain null elements.", function() {
    expect(res.body.ModelState['ClientContracts'][0]).to.equal("ClientContracts cannot contain null elements.");
  });
  
}
