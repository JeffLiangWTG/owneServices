meta {
  name: Call endpoint using Service Providers with C1CCode
  type: http
  seq: 5
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetRateQueryWithMandatoryFieldsForProvidedVariables();
   query.ServiceProviders = RatesAPIsHelper.GetServiceProvidersWithCICCodes();
   
   req.setBody(query);
}

tests {
  
}
