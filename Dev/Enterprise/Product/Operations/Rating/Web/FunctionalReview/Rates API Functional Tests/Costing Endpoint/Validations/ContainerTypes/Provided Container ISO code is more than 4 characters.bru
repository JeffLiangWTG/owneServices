meta {
  name: Provided Container ISO code is more than 4 characters
  type: http
  seq: 11
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.ContainerTypes = [{ Type: "ISO", Value: "ABCDE" }];
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided ISO code ('ABCDE') is not valid. It can be a string of maximum 4 characters.", function() {
    expect(res.body.ModelState['ContainerTypes[0].Value'][0]).to.equal("Provided ISO code ('ABCDE') is not valid. It can be a string of maximum 4 characters.");
  });
}
