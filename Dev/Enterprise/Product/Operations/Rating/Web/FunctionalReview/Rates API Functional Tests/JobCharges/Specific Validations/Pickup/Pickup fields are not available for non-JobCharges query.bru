meta {
  name: Pickup fields are not available for non-JobCharges query
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.PickupOrg = "ORG";
   query.PickupAddrCode = "ADDR";
   query.PickupCity = "CITY";
   query.PickupPostcode = "POSTCODE";
   
   req.setBody(query);
}
