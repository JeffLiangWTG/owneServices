meta {
  name: Call endpoint using All Provided Variables Usable For Company Tariffs
  type: http
  seq: 23
}

post {
  url: {{BaseApplicationURL}}/api/rating/companytariffs/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetRateQueryWithMandatoryFieldsForProvidedVariables(false);
   
   query.ServiceProviders = RatesAPIsHelper.GetAllServiceProviders();
   query.Carriers = RatesAPIsHelper.GetAllCarriers();
   query.CarrierServiceLevels = RatesAPIsHelper.GetCarrierServiceLevelssWithCW1Codes();
   query.ServiceLevels = RatesAPIsHelper.GetServiceLevels();
   query.ContainerTypes = RatesAPIsHelper.GetAllContainerTypes();
   query.Commodities = RatesAPIsHelper.GetCommoditiesWithCW1Codes();
   query.NamedAccounts = RatesAPIsHelper.GetNamedAccountsWithCW1Codes();
   query.PlannedLoad = 
       {
           Type: bru.getEnvVar("PlannedLoadType"),
           Value: bru.getEnvVar("PlannedLoadValue")
       };
   query.PlannedDischarge =
       {
           Type: bru.getEnvVar("PlannedDischargeType"),
           Value: bru.getEnvVar("PlannedDischargeValue")
       };
   query.RateOrigin = 
       {
           Type: bru.getEnvVar("RateOriginType"),
           Value: bru.getEnvVar("RateOriginValue")
       };
   query.RateDestination =
       {
           Type: bru.getEnvVar("RateDestinationType"),
           Value: bru.getEnvVar("RateDestinationValue")
       };
   query.Via = RatesAPIsHelper.GetVia();
   req.setBody(query);
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
}
