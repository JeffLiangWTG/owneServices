meta {
  name: CTLevelOverride - Level does not exist
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.JobInfo = RatesAPIsHelper.GetJobInfo();
   query.JobInfo.CTLevelOverride = 10;
   req.setBody(query);
   
}

tests {
  test("Response would be 200.", function() {
    expect(res.status).to.equal(200);
  });
  
  test("A Warning should be returned with message : Provided RateQuery.JobInfo.CTLevelOverride. (10) is not a valid Company Tariff Level in CW1.", function() {
  
  
    expect(res.body.Warnings).to.include("Provided RateQuery.JobInfo.CTLevelOverride. (10) is not a valid Company Tariff Level in CW1.");
  });
}
