meta {
  name: Provided IATACode is not of length 2 to 4
  type: http
  seq: 14
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.ServiceProviders = [ {IATACode : "ABCDE" }, {IATACode : "A" } ];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Provided IATACode ('ABCDE') is not valid. IATACode length must be from 2 to 4.", function() {
    expect(res.body.ModelState['ServiceProviders[0].IATACode'][0]).to.equal("Provided IATACode ('ABCDE') is not valid. IATACode length must be from 2 to 4.");
  });
  
  test("Provided IATACode ('A') is not valid. IATACode length must be from 2 to 4.", function() {
    expect(res.body.ModelState['ServiceProviders[1].IATACode'][0]).to.equal("Provided IATACode ('A') is not valid. IATACode length must be from 2 to 4.");
  });
}
