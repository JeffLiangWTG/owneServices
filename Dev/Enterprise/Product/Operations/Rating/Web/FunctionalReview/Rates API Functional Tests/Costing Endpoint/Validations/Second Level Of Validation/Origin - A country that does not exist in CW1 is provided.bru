meta {
  name: Origin - A country that does not exist in CW1 is provided
  type: http
  seq: 2
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.Origin = { Type: "COUNTRY", Value: "X7" };
   req.setBody(query);
   
}

tests {
  test("Response would be 200.", function() {
    expect(res.status).to.equal(200);
  });
  
  test("A Warning should be returned with message : Provided RateQuery.Origin.Value (X7) is not a valid Location in CW1.", function() {
  
  
    expect(res.body.Warnings).to.include("Provided RateQuery.Origin.Value (X7) is not a valid Location in CW1.");
  });
  
}
