meta {
  name: ContainerTypeCWCode is NOT provided when job is containerized
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.TransportMode = "SEA";
   query.ContainerMode = "FCL";
   
   query.JobInfo = {
       Containers: [
           {
               ContainerTypeCWCode : null,
               Number : "2983743874",
               Unit: 2,
               Commodity: "GEN",
               Ownership: "CAR",
               Packlines: [
                   {
                       PackageType : "PLT",
                       Unit: 2,
                       Commodity: null, 
                       Weight: 3400,
                       WeightUnit: "KG",
                       Volume: 4.32,
                       VolumeUnit: "M3"
                   },
               ]
           },
       ]
   };
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: When job is containerized, ContainerTypeCWCode is Mandatory.", function() {
    expect(res.body.ModelState['JobInfo.Containers[0].ContainerTypeCWCode'][0]).to.equal("When job is containerized, ContainerTypeCWCode is Mandatory.");
  });
}
