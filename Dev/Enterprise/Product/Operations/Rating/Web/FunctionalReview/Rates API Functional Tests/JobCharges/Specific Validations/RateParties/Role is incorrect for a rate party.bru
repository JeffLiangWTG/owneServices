meta {
  name: Role is incorrect for a rate party
  type: http
  seq: 11
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.RateParties = [
       {Code: "ABCD", Role: "XX" },
       {Code: "EFGH", Role: "RAG"},
   ];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided Role ('XX') is not valid. It can only be one of these values: 'LC', 'AG', 'CNE', 'CNR', 'SAG', 'RAG', 'CCUS', 'IB', 'EB', 'DA', 'PA', 'DTC', 'PTC', 'ICFS', 'ECFS', 'CA', 'CCR', 'COR', 'CAR', 'DCTO', 'DCTR', 'DCFS', 'DCFT', 'ACTO', 'ACTR', 'ACFS', 'ACFT'.", function() {
    expect(res.body.ModelState['RateParties[0].Role'][0]).to.equal("Provided Role ('XX') is not valid. It can only be one of these values: 'LC', 'AG', 'CNE', 'CNR', 'SAG', 'RAG', 'CCUS', 'IB', 'EB', 'DA', 'PA', 'DTC', 'PTC', 'ICFS', 'ECFS', 'CA', 'CCR', 'COR', 'CAR', 'DCTO', 'DCTR', 'DCFS', 'DCFT', 'ACTO', 'ACTR', 'ACFS', 'ACFT'.");
  });
}
