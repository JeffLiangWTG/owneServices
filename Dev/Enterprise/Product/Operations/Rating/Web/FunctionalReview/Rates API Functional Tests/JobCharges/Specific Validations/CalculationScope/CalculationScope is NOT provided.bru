meta {
  name: CalculationScope is NOT provided
  type: http
  seq: 2
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   delete query.CalculationScope;
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: CalculationScope is Mandatory.", function() {
    expect(res.body.ModelState['CalculationScope'][0]).to.equal("CalculationScope is Mandatory.");
  });
}
