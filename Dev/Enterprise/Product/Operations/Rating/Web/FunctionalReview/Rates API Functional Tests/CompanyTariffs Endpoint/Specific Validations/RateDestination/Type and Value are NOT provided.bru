meta {
  name: Type and Value are NOT provided
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/companytariffs/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForCompanyTariffs();
   query.RateDestination = {};
   req.setBody(query);
}

tests {
  test("Should return status code 200", function() {
    expect(res.status).to.equal(200);
  });
}
