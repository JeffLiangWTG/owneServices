meta {
  name: Country is less than 2 characters
  type: http
  seq: 7
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.Origin = { Type: "COUNTRY", Value: "A" };
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided Country ('A') is not valid. It should be a string of 2 characters.", function() {
    expect(res.body.ModelState['Origin.Value'][0]).to.equal("Provided Country ('A') is not valid. It should be a string of 2 characters.");
  });
  
  
  
}
