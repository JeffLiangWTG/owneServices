meta {
  name: JobInfo Insurance Value Currency Not Provided
  type: http
  seq: 6
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
           query.JobInfo = {
               InsuranceValue: 1230, 
               InsuranceValueCurrency: null, 
               Containers: [
                   {
                       ContainerTypeCWCode : "20GP",
                       Number : "2983743874",
                       Unit: 2,
                       Commodity: "GEN",
                       Ownership: "CAR",
                       Packlines: [
                           {
                               PackageType : "PLT",
                               Unit: 2,
                               Commodity: null, 
                               Weight: 3400,
                               WeightUnit: "KG",
                               Volume: 4.32,
                               VolumeUnit: "M3"
                           },
                       ]
                   },
               ]
           };
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: InsuranceValueCurrency is Mandatory when InsuranceValue is specified.", function() {
    expect(res.body.ModelState['JobInfo.InsuranceValueCurrency'][0]).to.equal("InsuranceValueCurrency is Mandatory when InsuranceValue is specified.");
  });
}
