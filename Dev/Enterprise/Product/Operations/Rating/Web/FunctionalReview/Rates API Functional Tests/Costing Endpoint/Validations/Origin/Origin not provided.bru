meta {
  name: Origin not provided
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   delete query.Origin;
   req.setBody(query);
   
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Origin is Mandatory.", function() {
    expect(res.body.ModelState['Origin'][0]).to.equal("Origin is Mandatory.");
  });
}
