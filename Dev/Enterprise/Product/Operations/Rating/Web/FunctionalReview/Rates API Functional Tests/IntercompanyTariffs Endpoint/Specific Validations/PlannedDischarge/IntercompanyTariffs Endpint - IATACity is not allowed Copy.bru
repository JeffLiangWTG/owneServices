meta {
  name: IntercompanyTariffs Endpint - IATACity is not allowed Copy
  type: http
  seq: 6
}

post {
  url: {{BaseApplicationURL}}/api/rating/intercompanytariffs/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForIntercompanyTariffs();
   query.PlannedDischarge = { Type: "IATACITY", Value: "SYD" };
   req.setBody(query);
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided Type ('IATACITY') is not valid. It can only be one of these values: 'COUNTRY', 'UNLOCO', 'ZONE'.", function() {
    expect(res.body.ModelState['PlannedDischarge.Type'][0]).to.equal("Provided Type ('IATACITY') is not valid. It can only be one of these values: 'COUNTRY', 'UNLOCO', 'ZONE'.");
  });
  
  
  
}
