meta {
  name: Valid Request To Costing - Asking For Something not supported
  type: http
  seq: 4
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

headers {
  Accept: text/xml
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   req.setBody(query);
   
   
}

tests {
  test("Should return status code 406", function() {
    expect(res.status).to.equal(406);
  });
  
  test("Should return reason: Acceptable media types are: application/xml, application/json", function() {
    expect(res.statusText).to.equal('Acceptable media types are: application/xml, application/json');
  });
}
