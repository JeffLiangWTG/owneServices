meta {
  name: Destination - A City that does not exists in CW1 is provided
  type: http
  seq: 6
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.Destination = { Type: "CITY", Value: "XYZ" };
   req.setBody(query);
   
}

tests {
  test("Response would be 200.", function() {
    expect(res.status).to.equal(200);
  });
  
  test("A Warning should be returned with message : Provided RateQuery.Destination.Value (XYZ) is not a valid Location in CW1.", function() {
  
  
    expect(res.body.Warnings).to.include("Provided RateQuery.Destination.Value (XYZ) is not a valid Location in CW1.");
  });
}
