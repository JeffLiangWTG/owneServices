meta {
  name: RateProviders contains empty elements
  type: http
  seq: 5
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQuery();
   query.RateProviders = ["CW", ""];
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: Provided RateProviders is not valid. It shouldn't contain null or empty elements.", function() {
    expect(res.body.ModelState['RateProviders'][0]).to.equal("Provided RateProviders is not valid. It shouldn't contain null or empty elements.");
  });
}
