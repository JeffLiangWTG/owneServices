meta {
  name: Call endpoint using ContainerTypes with ISO Code
  type: http
  seq: 13
}

post {
  url: {{BaseApplicationURL}}/api/rating/costing/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetRateQueryWithMandatoryFieldsForProvidedVariables();
   query.ContainerTypes = RatesAPIsHelper.GetContainerTypesWithISOCodes();
   
   req.setBody(query);
}

tests {
  
}
