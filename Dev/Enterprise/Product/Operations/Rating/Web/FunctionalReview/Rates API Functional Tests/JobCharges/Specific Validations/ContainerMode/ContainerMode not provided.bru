meta {
  name: ContainerMode not provided
  type: http
  seq: 1
}

post {
  url: {{BaseApplicationURL}}/api/rating/jobcharges/{{BranchCode}}/{{DepartmentCode}}
  body: json
  auth: none
}

script:pre-request {
   await RatesAPIsHelper.SetAuthorizationForRequests();

   var query = RatesAPIsHelper.GetAValidRateQueryForJobCharges();
   query.ContainerMode = null;
   
   req.setBody(query);
   
}

tests {
  test("Should return status code 400", function() {
    expect(res.status).to.equal(400);
  });
  
  test("Should return: ContainerMode is Mandatory.", function() {
    expect(res.body.ModelState['ContainerMode'][0]).to.equal("ContainerMode is Mandatory.");
  });
}
