  <system.webServer>
    <modules>
      <remove name="SecureWebPage"/>
      <remove name="SecureCookieModule"/>
      <remove name="ScriptModule"/>
      <remove name="UploadHttpModule"/>
      <remove name="XFrameOptionModule"/>
      <add name="SecureWebPage" type="Enterprise.ZArchitecture.Web.Security.SecureWebPageModule, Enterprise.ZArchitecture.Web.GUI" preCondition="managedHandler"/>
      <add name="SecureCookieModule" type="Enterprise.ZArchitecture.Web.Security.SecureCookieModule, Enterprise.ZArchitecture.Web.GUI" preCondition="managedHandler"/>
      <add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" preCondition="managedHandler"/>
      <add name="UploadHttpModule" type="Brettle.Web.NeatUpload.UploadHttpModule, Brettle.Web.NeatUpload" preCondition="managedHandler"/>
      <add name="XFrameOptionModule" type="Enterprise.ZArchitecture.Web.Security.ClickJackingProtectionModule, Enterprise.ZArchitecture.Web.GUI" preCondition="managedHandler"/>
    </modules>
    <handlers>
      <remove name="ClientSpecificCssHandler"/>
      <remove name="ClientSpecificImageHandler"/>
      <remove name="eDocsRequestHandler.axd_GET"/>
      <remove name="QuoteRequestHandler.axd_GET"/>
      <remove name="QuoteClientReplyRequestHandler.axd_GET"/>
      <remove name="InvoiceRequestHandler.axd_GET"/>
      <remove name="StatementRequestHandler.axd_GET"/>
      <remove name="AutoLoginRequestHandler.axd_GET"/>
      <remove name="FreightLabelRequestHandler.axd_GET"/>
      <remove name="HouseBillRequestHandler.axd_GET"/>
      <remove name="ReportRequestHandler.axd_GET"/>
      <remove name="DocumentRequestHandler.axd_GET"/>
      <remove name="ScriptResource.axd_GET,HEAD"/>
      <remove name="AutoCompleteTextBoxRequestHandler.ashx_POST"/>
      <remove name="ResourceStringUsageData.axd_GET"/>
      <remove name="ModulePreloadRequestHandler.axd_GET"/>
      <remove name="*.asmx_*"/>
      <add name="ClientSpecificCssHandler" path="*.css" verb="GET" type="Enterprise.Tracking.Web.ClientSpecificCssHandler" resourceType="Unspecified"/>
      <add name="ClientSpecificImageHandler" path="Images/*" verb="GET" type="Enterprise.Tracking.Web.ClientSpecificImageHandler" resourceType="Unspecified"/>
      <add name="eDocsRequestHandler.axd_GET" path="eDocsRequestHandler.axd" verb="GET" type="Enterprise.DocumentScanning.Web.eDocsRequestHandler,Enterprise.DocumentScanning.Web"/>
      <add name="QuoteRequestHandler.axd_GET" path="QuoteRequestHandler.axd" verb="GET" type="Enterprise.Tracking.Web.QuoteRequestHandler,Enterprise.Tracking.Web"/>
      <add name="QuoteClientReplyRequestHandler.axd_GET" path="QuoteClientReplyRequestHandler.axd" verb="GET" type="Enterprise.Tracking.Web.QuoteClientReplyRequestHandler,Enterprise.Tracking.Web" />
      <add name="InvoiceRequestHandler.axd_GET" path="InvoiceRequestHandler.axd" verb="GET" type="Enterprise.Tracking.Web.InvoiceRequestHandler,Enterprise.Tracking.Web"/>
