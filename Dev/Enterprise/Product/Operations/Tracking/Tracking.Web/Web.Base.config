        <behavior name="Enterprise.Tracking.Web.Location.PortLoadHelperBehavior">
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service behaviorConfiguration="Enterprise.Tracking.Web.Location.PortLoadHelperBehavior" name="Enterprise.Tracking.Web.Location.PortLoadHelper">
        <endpoint address="" binding="webHttpBinding" contract="Enterprise.Tracking.Web.Location.IPortLoadHelper" bindingConfiguration="">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
