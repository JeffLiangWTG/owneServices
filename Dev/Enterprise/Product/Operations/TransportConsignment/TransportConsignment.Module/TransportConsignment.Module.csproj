<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.TransportConsignment.Module</RootNamespace>
    <AssemblyName>Enterprise.TransportConsignment.Module</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Compile Update="List\HasDeliveryStatuses.cs">
      <DependentUpon>HasDeliveryStatuses.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="List\ServicesExistStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ServicesExistStatuses.xml</DependentUpon>
    </Compile>
    <Compile Update="List\SpecialInstructionsExistStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>SpecialInstructionsExistStatuses.xml</DependentUpon>
    </Compile>
    <Compile Update="List\IsActiveStatuses.cs">
      <DependentUpon>IsActiveStatuses.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="List\IsHazardousStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>IsHazardousStatuses.xml</DependentUpon>
    </Compile>
    <Compile Update="List\IsRefrigeratedStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>IsRefrigeratedStatuses.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TransportConsignment.GUI\TransportConsignment.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="List\HasDeliveryStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>HasDeliveryStatuses.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportConsignment.Module</CustomToolNamespace>
    </None>
    <None Update="List\IsActiveStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>IsActiveStatuses.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportConsignment.Module</CustomToolNamespace>
    </None>
    <None Update="List\IsHazardousStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>IsHazardousStatuses.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportConsignment.Module</CustomToolNamespace>
    </None>
    <None Update="List\IsRefrigeratedStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>IsRefrigeratedStatuses.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportConsignment.Module</CustomToolNamespace>
    </None>
    <None Update="List\ServicesExistStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <CustomToolNamespace>Enterprise.TransportConsignment.Module</CustomToolNamespace>
      <LastGenOutput>ServicesExistStatuses.cs</LastGenOutput>
    </None>
    <None Update="List\SpecialInstructionsExistStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>SpecialInstructionsExistStatuses.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportConsignment.Module</CustomToolNamespace>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>