<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="RoutingRequestConsolGenerator">

	<ShortColumn>
		<Name>ConsolsPerFlight</Name>
	</ShortColumn>

  <IntColumn>
    <Name>TotalConsols</Name>
    <EditableState>GetterOnly</EditableState>
  </IntColumn>

  <ShortColumn>
		<Name>Shipments</Name>
		<Precision>9</Precision>
	</ShortColumn>

	<DecimalColumn>
		<Name>Weight</Name>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<StringColumn>
		<Name>WeightUnit</Name>
		<MaxLength>2</MaxLength>
	</StringColumn>

	<DecimalColumn>
		<Name>Volume</Name>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<StringColumn>
		<Name>VolumeUnit</Name>
		<MaxLength>2</MaxLength>
	</StringColumn>

	<DecimalColumn>
		<Name>Chargeable</Name>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<StringColumn>
		<Name>AirlinePrefix</Name>
		<MaxLength>2</MaxLength>
	</StringColumn>

	<BoolColumn>
		<Name>AllocateNeutralMaster</Name>
	</BoolColumn>

	<DateTimeColumn>
		<Name>CTOCutOff</Name>
		<Caption>CTO Cut Off</Caption>
	</DateTimeColumn>

	<DateTimeColumn>
		<Name>CFSCutOff</Name>
		<Caption>CFS Cut Off</Caption>
	</DateTimeColumn>

	<StringColumn>
		<Name>ServiceLevel</Name>
		<Caption>Service Level</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

</NonPersistentBusinessObject>
