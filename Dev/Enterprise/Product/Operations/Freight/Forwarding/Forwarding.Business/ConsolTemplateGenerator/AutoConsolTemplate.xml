<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ConsolTemplate">

  <StringColumn>
    <Name>ConsolTemplateName</Name>
    <MaxLength>80</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>ConsolTemplateReferenceId</Name>
    <MaxLength>20</MaxLength>
