<UniversalShipment xmlns="http://www.cargowise.com/Schemas/Universal/2011/11" version="1.1">
  <Shipment>
    <DataContext>
      <Company>
        <Code>DAU</Code>
        <Country>
          <Code>AU</Code>
        </Country>
      </Company>
      <DataProvider>UP3TRNUUS</DataProvider>
      <EnterpriseID>UP3</EnterpriseID>
      <ServerID>TRN</ServerID>
      <DataTargetCollection>
        <DataTarget>
          <Type>ForwardingConsol</Type>
        </DataTarget>
      </DataTargetCollection>
    </DataContext>
    <AWBServiceLevel>
      <Code>STD</Code>
    </AWBServiceLevel>
    <Branch>
      <Code>STL</Code>
    </Branch>
    <ContainerMode>
      <Code>ULD</Code>
    </ContainerMode>
    <IsNeutralMaster CreateAndAllocateNeutralStock="true">true</IsNeutralMaster>
    <PlaceOfDelivery>
      <Code>{loadPort}</Code>
    </PlaceOfDelivery>
    <PlaceOfReceipt>
      <Code>USBDL</Code>
    </PlaceOfReceipt>
    <PortOfDischarge>
      <Code>USBDL</Code>
    </PortOfDischarge>
    <PortOfLoading>
      <Code>{loadPort}</Code>
    </PortOfLoading>
    <TransportMode>
      <Code>{transport}</Code>
    </TransportMode>
    <VoyageFlightNo>5X1284</VoyageFlightNo>
    <WayBillNumber>{mawbNum}</WayBillNumber>
    <WayBillType>
      <Code>MWB</Code>
    </WayBillType>
    <OrganizationAddressCollection>
      <OrganizationAddress>
        <AddressType>SendingForwarderAddress</AddressType>
        <OrganizationCode>UPSHWP</OrganizationCode>
        <Port>
          <Code>USLUI</Code>
        </Port>
      </OrganizationAddress>
      <OrganizationAddress>
        <AddressType>ReceivingForwarderAddress</AddressType>
        <OrganizationCode>UPSABQ</OrganizationCode>
        <Port>
          <Code>USABQ</Code>
        </Port>
      </OrganizationAddress>
    </OrganizationAddressCollection>
  </Shipment>
</UniversalShipment>