<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="DelayAlertDeliveryRule">

	<StringColumn>
		<Name>TransportMode</Name>
		<ShortCaption>Mode</ShortCaption>
		<Caption>Transport Mode</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Module</Name>
		<Caption>Module</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Direction</Name>
		<Caption>Direction</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<Serialisation>
		<Template>
			<TransportMode>{value:TransportMode}</TransportMode>
			<Module>{value:Module}</Module>
			<Direction>{value:Direction}</Direction>
			<Deliver />
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>
