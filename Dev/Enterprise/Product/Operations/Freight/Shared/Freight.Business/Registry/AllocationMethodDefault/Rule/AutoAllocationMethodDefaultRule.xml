<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="AllocationMethodDefaultRule">

	<StringColumn>
		<Name>CountryCode</Name>
		<Caption>Country</Caption>
		<MaxLength>2</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>AllocationMethod</Name>
		<ShortCaption>Method</ShortCaption>
		<Caption>Allocation Method</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<Serialisation>
		<Template>
			<Country>{value:CountryCode}</Country>
			<AllocationMethod>{value:AllocationMethod}</AllocationMethod>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>