<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ActualEvent">

	<StringColumn>
		<Name>EventCode</Name>
		<MaxLength>3</MaxLength>
		<EditableState>ReadOnly</EditableState>
	</StringColumn>

	<StringColumn>
		<Name>LoadPort</Name>
		<MaxLength>5</MaxLength>
		<EditableState>ReadOnly</EditableState>
	</StringColumn>

	<StringColumn>
		<Name>DischargePort</Name>
		<MaxLength>5</MaxLength>
		<EditableState>ReadOnly</EditableState>
	</StringColumn>

	<StringColumn>
		<Name>VoyageFlight</Name>
		<MaxLength>10</MaxLength>
		<EditableState>ReadOnly</EditableState>
	</StringColumn>

	<IntColumn>
		<Name>ShippedPieces</Name>
		<EditableState>ReadOnly</EditableState>
	</IntColumn>
	
	<DateTimeColumn>
		<Name>ScheduleDate</Name>
		<EditableState>ReadOnly</EditableState>
	</DateTimeColumn>
	
	<DateTimeColumn>
		<Name>DepartedTime</Name>
		<EditableState>ReadOnly</EditableState>
	</DateTimeColumn>

	<IntColumn>
		<Name>ArrivedPieces</Name>
		<EditableState>ReadOnly</EditableState>
	</IntColumn>

	<IntColumn>
		<Name>UnloadedPieces</Name>
		<EditableState>ReadOnly</EditableState>
	</IntColumn>
	
	<DateTimeColumn>
		<Name>ArrivedTime</Name>
		<EditableState>ReadOnly</EditableState>
	</DateTimeColumn>

	<BoolColumn>
		<Name>IsPartial</Name>
		<EditableState>ReadOnly</EditableState>
	</BoolColumn>
  
</NonPersistentBusinessObject>
