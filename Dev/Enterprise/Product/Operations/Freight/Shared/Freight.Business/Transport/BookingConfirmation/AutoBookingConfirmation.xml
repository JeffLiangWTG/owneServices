<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="BookingConfirmation">

	<StringColumn>
		<Name>EventCode</Name>
		<MaxLength>3</MaxLength>
		<EditableState>ReadOnly</EditableState>
	</StringColumn>

  <BoolColumn>
    <Name>EventIsEstimate</Name>
    <EditableState>ReadOnly</EditableState>
  </BoolColumn>

  <StringColumn>
		<Name>LoadPort</Name>
		<MaxLength>5</MaxLength>
    <EditableState>ReadOnly</EditableState>
	</StringColumn>

	<StringColumn>
		<Name>DischargePort</Name>
		<MaxLength>5</MaxLength>
    <EditableState>ReadOnly</EditableState>
	</StringColumn>
  
	<StringColumn>
		<Name>VoyageFlight</Name>
		<MaxLength>10</MaxLength>
    <EditableState>ReadOnly</EditableState>
	</StringColumn>  

	<IntColumn>
		<Name>BookedPieces</Name>
    <EditableState>ReadOnly</EditableState>
	</IntColumn>

	<DateTimeColumn>
		<Name>ScheduleDate</Name>
		<EditableState>ReadOnly</EditableState>
	</DateTimeColumn>

	<DateTimeColumn>
		<Name>DepartureTime</Name>
		<EditableState>ReadOnly</EditableState>
	</DateTimeColumn>

	<DateTimeColumn>
		<Name>ArrivalTime</Name>
		<EditableState>ReadOnly</EditableState>
	</DateTimeColumn>

</NonPersistentBusinessObject>
