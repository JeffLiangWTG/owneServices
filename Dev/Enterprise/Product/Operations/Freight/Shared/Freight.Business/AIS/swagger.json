            "name": "timeTo",
            "in": "query",
            "description": "Latest date and time in UTC format or local date and time with an offset",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "carrierCode",
            "in": "query",
            "description": "Carrier SCAC",
            "schema": {
              "type": "string"
            },
            "example": "CMDU"
          },
          {
            "name": "voyageNumber",
            "in": "query",
            "description": "Voyage Number",
