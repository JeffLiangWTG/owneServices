              "type": "string"
            },
            "example": "0NG02W1MA"
          },
          {
            "name": "departurePortUnloco",
            "in": "query",
            "description": "All port calls before departure port will be filtered out",
            "schema": {
              "type": "string"
            },
            "example": "AUSYD"
