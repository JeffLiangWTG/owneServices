{
  "openapi": "3.0.1",
  "info": {
    "title": "AIS API",
    "version": "v1"
  },
  "paths": {
    "/errors": {
      "post": {
        "tags": [
          "Errors"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReportErrorRequest"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReportErrorRequest"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReportErrorRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/v1/vessels/{vesselImo}/portCalls": {
      "get": {
        "tags": [
          "PortCalls"
        ],
        "summary": "Get port calls of a particular vessel within a date range",
        "parameters": [
          {
            "name": "vesselImo",
            "in": "path",
            "description": "Vessel IMO number",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "9748291"
          },
          {
            "name": "pageIndex",
            "in": "query",
            "description": "Page index, starting from 1",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Page size",
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 25
            },
            "example": 25
          },
          {
            "name": "timeFrom",
            "in": "query",
            "description": "Earliest date and time in UTC format or local date and time with an offset",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeTo",
            "in": "query",
            "description": "Latest date and time in UTC format or local date and time with an offset",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "carrierCode",
            "in": "query",
            "description": "Carrier SCAC",
            "schema": {
              "type": "string"
            },
            "example": "CMDU"
          },
          {
            "name": "voyageNumber",
            "in": "query",
            "description": "Voyage Number",
            "schema": {
              "type": "string"
            },
            "example": "0NG02W1MA"
          },
          {
            "name": "departurePortUnloco",
            "in": "query",
            "description": "All port calls before departure port will be filtered out",
            "schema": {
              "type": "string"
            },
            "example": "AUSYD"
          },
          {
            "name": "arrivalPortUnloco",
            "in": "query",
            "description": "All port calls after arrival port will be filtered out",
            "schema": {
              "type": "string"
            },
            "example": "NZAKL"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortCallPage"
                },
                "example": {"totalItems":1,"totalPages":1,"items":[{"port":{"id":"PO271700T000000B000000","name":"Tekirdag","unloco":"TRTEK","geoCoordinates":{"latitude":40.9644667,"longitude":27.5085667},"timeZone":"+03:00"},"ata":"2020-06-01T08:53:08+03:00"}]}
              }
            }
          },
          "400": {
            "description": "Invalid filter or paging parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {"title":"One or more validation errors occurred.","status":400,"errors":{"Imo":["Invalid IMO value '11'. Valid format: 1234567"]}}
              }
            }
          },
          "401": {
            "description": "Unauthorized request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {"title":"NoAuthorizationFound","status":401,"detail":"Unauthorized. Authorization header not found."}
              }
            }
          }
        }
      }
    },
