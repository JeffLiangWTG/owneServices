          {
            "name": "arrivalPortUnloco",
            "in": "query",
            "description": "All port calls after arrival port will be filtered out",
            "schema": {
              "type": "string"
            },
            "example": "NZAKL"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortCallsAndVesselMovements"
                },
                "example": {"portCalls":{"totalItems":1,"totalPages":1,"items":[{"port":{"id":"PO271700T000000B000000","name":"Tekirdag","unloco":"TRTEK","geoCoordinates":{"latitude":40.9644667,"longitude":27.5085667},"timeZone":"+03:00"},"ata":"2020-06-01T08:53:08+03:00"}]},"movements":{"totalItems":1,"totalPages":1,"items":[{"time":"2020-05-02T03:50:25+03:00","draught":8.8,"destinationDescription":"TR IZT","eta":"2020-05-02T03:00:00","heading":98,"speed":15.6,"navigationStatus":"UWE","geoCoordinates":{"latitude":40.72966,"longitude":28.678717}}]}}
              }
            }
          },
          "400": {
            "description": "Invalid filter or paging parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {"title":"One or more validation errors occurred.","status":400,"errors":{"Imo":["Invalid IMO value '11'. Valid format: 1234567"]}}
              }
            }
          },
          "401": {
            "description": "Unauthorized request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {"title":"NoAuthorizationFound","status":401,"detail":"Unauthorized. Authorization header not found."}
              }
            }
          }
        }
      }
    },
