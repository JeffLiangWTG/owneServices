    "/v1/vessels/{vesselImo}": {
      "get": {
        "tags": [
          "Vessels"
        ],
        "summary": "Get information about a particular vessel by IMO.",
        "parameters": [
          {
            "name": "vesselImo",
            "in": "path",
            "description": "Vessel IMO number",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "9748291"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vessel"
                },
                "example": {"imoNumber":"9748291","mmsi":"636017870","callSign":"D5NC3","name":"DONINGTON","typeDescription":"Cargo","length":199.6,"breadth":38.3}
              }
            }
          },
          "400": {
            "description": "Invalid vesselImo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                },
                "example": {"title":"One or more validation errors occurred.","status":400,"errors":{"Imo":["Invalid IMO value '11'. Valid format: 1234567"]}}
              }
            }
          },
          "401": {
            "description": "Unauthorized request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {"title":"NoAuthorizationFound","status":401,"detail":"Unauthorized. Authorization header not found."}
              }
            }
          },
          "404": {
            "description": "No results are found for the given input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "example": {"title":"Vessel not found.","status":404}
              }
            }
          }
        }
      }
    }
