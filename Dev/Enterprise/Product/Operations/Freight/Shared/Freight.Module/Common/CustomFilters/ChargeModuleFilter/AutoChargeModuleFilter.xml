<?xml version="1.0" encoding="utf-8" ?>
<ModuleFilter
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ChargeModuleFilter"
	>

  <StringColumn>
    <Name>ChargeGroup</Name>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>UseLowerBound</Name>
  </BoolColumn>

  <DecimalColumn>
    <Name>LowerBound</Name>
    <EditableState>Conditional</EditableState>
    <Precision>19</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <BoolColumn>
    <Name>UseUpperBound</Name>
  </BoolColumn>

  <DecimalColumn>
    <Name>UpperBound</Name>
    <EditableState>Conditional</EditableState>
    <Precision>19</Precision>
    <Scale>4</Scale>
  </DecimalColumn>

  <Serialisation>
    <Template>
      <ChargeGroup>{value:ChargeGroup}</ChargeGroup>
      <UseLowerBound>{value?:UseLowerBound}</UseLowerBound>
      <LowerBound>{value:LowerBound}</LowerBound>
      <UseUpperBound>{value?:UseUpperBound}</UseUpperBound>
      <UpperBound>{value:UpperBound}</UpperBound>
    </Template>
  </Serialisation>
</ModuleFilter>
