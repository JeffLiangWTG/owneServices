<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <Configurations>Debug;DEBUGFAST</Configurations>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
    <CWDisableNetCoreTestDiscovery>true</CWDisableNetCoreTestDiscovery>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <ProjectReference Include="..\Freight.ApiClient\Enterprise.Freight.ApiClient.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Enterprise.Freight.Integration" />
    <Reference Include="Moq" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="nunit.framework" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>
</Project>