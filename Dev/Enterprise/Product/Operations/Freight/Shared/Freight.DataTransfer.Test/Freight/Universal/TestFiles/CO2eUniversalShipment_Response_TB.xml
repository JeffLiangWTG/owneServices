<UniversalInterchange xmlns="http://www.cargowise.com/Schemas/Universal/2011/11">
  <Header>
    <SenderID>EMISSION_CALCULATOR</SenderID>
    <RecipientID>EDIEDIDAT</RecipientID>
  </Header>
  <Body>
    <UniversalShipment xmlns="http://www.cargowise.com/Schemas/Universal/2012/11">
      <Shipment>
        <DataContext>
          <DataSource>
            <DataProvider>WTG Greenhouse Gas Emission</DataProvider>
          </DataSource>
        </DataContext>
        <GreenhouseGasEmission>
          <CO2e>1000</CO2e>
          <CO2eUnit>KG</CO2eUnit>
          <CO2eDistanceInKm>1500</CO2eDistanceInKm>
        </GreenhouseGasEmission>
      </Shipment>
    </UniversalShipment>
  </Body>
</UniversalInterchange>