<?xml version="1.0" encoding="utf-8" ?>
<CodeDescriptionPairList
  xmlns="http://www.edi.com.au/CodeDescriptionPairList.xsd"
  xmlns:cdpl="http://www.edi.com.au/CodeDescriptionPairList.xsd"
	cdpl:Sort="true">
  <Item>
    <Identifier>NotCalculated</Identifier>
    <Code>NON</Code>
    <Description>Not Calculated: CO2e value has not been calculated on the job</Description>
  </Item>
  <Item>
    <Identifier>Current</Identifier>
    <Code>CUR</Code>
    <Description>Current: CO2e value has been calculated for current values on the job</Description>
  </Item>
  <Item>
    <Identifier>Pending</Identifier>
    <Code>PEN</Code>
    <Description>Pending: CO2e calculation request has been sent</Description>
  </Item>
  <Item>
    <Identifier>NotCurrent</Identifier>
    <Code>NCU</Code>
    <Description>Not Current: previous calculated CO2e value on the job is outdated</Description>
  </Item>
  <Item>
    <Identifier>Rejected</Identifier>
    <Code>REJ</Code>
    <Description>Rejected: CO2e calculation request has been rejected</Description>
  </Item>
</CodeDescriptionPairList>