    <Reference Include="WTG.SecurityRights" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LocalCartage.GUI\Enterprise.Freight.LocalCartage.GUI.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
