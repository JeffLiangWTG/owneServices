<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="LooseBookedMoveSplit"
	>

	<IntColumn>
		<Name>Packs</Name>
		<EditableState>ReadWrite</EditableState>
	</IntColumn>

	<StringColumn>
		<Name>PackType</Name>
		<EditableState>GetterOnly</EditableState>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<DecimalColumn>
		<Name>Weight</Name>
		<EditableState>ReadWrite</EditableState>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<StringColumn>
		<Name>WeightUnit</Name>
		<EditableState>GetterOnly</EditableState>
		<MaxLength>2</MaxLength>
	</StringColumn>

	<DecimalColumn>
		<Name>Volume</Name>
		<EditableState>ReadWrite</EditableState>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<StringColumn>
		<Name>VolumeUnit</Name>
		<EditableState>GetterOnly</EditableState>
		<MaxLength>2</MaxLength>
	</StringColumn>

</NonPersistentBusinessObject>