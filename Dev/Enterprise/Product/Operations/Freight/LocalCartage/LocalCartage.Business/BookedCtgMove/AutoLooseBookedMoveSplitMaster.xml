		<Scale>3</Scale>
	</DecimalColumn>

	<DecimalColumn>
		<Name>RemainingVolume</Name>
		<EditableState>GetterOnly</EditableState>
		<Precision>9</Precision>
		<Scale>3</Scale>
	</DecimalColumn>

	<BoolColumn>
		<Name>AllowDiscrepancy</Name>
		<EditableState>ReadWrite</EditableState>
	</BoolColumn>
	
</NonPersistentBusinessObject>