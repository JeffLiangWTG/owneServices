<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DetentionAdviceDelivery"
	>

  <StringColumn>
    <Name>Mode</Name>
    <MaxLength>10</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>SendToNotificationGroup</Name>
    <EditableState>Conditional</EditableState>
  </BoolColumn>
  
	<GuidColumn>
		<Name>Printer</Name>
    <EditableState>Conditional</EditableState>
	</GuidColumn>

  <GuidColumn>
    <Name>NotificationGroup</Name>
    <EditableState>Conditional</EditableState>
  </GuidColumn>
    
	<Serialisation>
		<Template>
      <Mode>{value:Mode}</Mode>
      <SendToNotificationGroup>{value:SendToNotificationGroup}</SendToNotificationGroup>
      <Printer>{value:Printer}</Printer>
      <NotificationGroup>{value:NotificationGroup}</NotificationGroup>
    </Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>