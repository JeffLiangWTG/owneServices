<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="ContainerTranshipmentIndicator">
	
	<StringColumn>
		<Name>Key</Name>
		<Caption>Key</Caption>
		<EditableState>ReadOnly</EditableState>
		<MaxLength>35</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Direct</Name>
		<Caption>Direct</Caption>
		<MaxLength>1</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Tranship</Name>
		<Caption>Tranship.</Caption>
		<MaxLength>1</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Domestic</Name>
		<Caption>Domestic</Caption>
		<MaxLength>1</MaxLength>
	</StringColumn>

	<Serialisation>
		<Template>
			<Key>{value:Key}</Key>
			<Direct>{value:Direct}</Direct>
			<Tranship>{value:Tranship}</Tranship>
			<Domestic>{value:Domestic}</Domestic>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>