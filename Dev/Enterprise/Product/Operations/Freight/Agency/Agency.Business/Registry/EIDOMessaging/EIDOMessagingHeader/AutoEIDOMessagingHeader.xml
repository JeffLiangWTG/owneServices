<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="EIDOMessagingHeader">

	<BoolColumn>
		<Name>Testing</Name>
		<EditableState>Conditional</EditableState>
	</BoolColumn>
	
	<StringColumn>
		<Name>Email</Name>
		<Caption>Email Address</Caption>
		<EditableState>Conditional</EditableState>
		<MaxLength>40</MaxLength>
	</StringColumn>

	<Serialisation>
		<Template>
			<Testing>{value:Testing}</Testing>
			<Email>{value:Email}</Email>
			<Identities>{method:Identities}</Identities>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>