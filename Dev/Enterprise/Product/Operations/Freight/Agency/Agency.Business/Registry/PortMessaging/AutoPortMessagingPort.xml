<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="PortMessagingPort">

	<StringColumn>
		<Name>Port</Name>
		<Caption>Port</Caption>
		<FullDescription>UNLOCO of the port.</FullDescription>
		<MaxLength>5</MaxLength>
	</StringColumn>

	<BoolColumn>
		<Name>Enabled</Name>
		<Caption>Enabled</Caption>
		<FullDescription>Integration is enabled or disabled.</FullDescription>
		<EditableState>Conditional</EditableState>
	</BoolColumn>

	<StringColumn>
		<Name>SenderID</Name>
		<Caption>Sender ID</Caption>
		<FullDescription>Code of the receiver to show in the message.</FullDescription>
		<EditableState>Conditional</EditableState>
		<MaxLength>35</MaxLength>
	</StringColumn>

    <GuidColumn>
        <Name>PrincipalPK</Name>
        <Caption>Principal</Caption>
    </GuidColumn>

	<Serialisation>
		<Template>
			<Port>{value:Port}</Port>
            <PrincipalPK>{value?:PrincipalPK}</PrincipalPK>
			<Enabled>{value:Enabled}</Enabled>
			<SenderID>{value:SenderID}</SenderID>
		</Template>
	</Serialisation>
	
</RegistryBusinessObjectTemplate>