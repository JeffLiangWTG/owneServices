<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="EIDOMessagingIdentity">

	<GuidColumn>
		<Name>PrincipalPK</Name>
		<Caption>Principal</Caption>
	</GuidColumn>

	<StringColumn>
		<Name>SenderID</Name>
		<Caption>Sender ID</Caption>
		<MaxLength>35</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>RecipientID</Name>
		<Caption>Recipient ID</Caption>
		<MaxLength>35</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Password</Name>
		<Caption>Password</Caption>
		<MaxLength>35</MaxLength>
	</StringColumn>

	<Serialisation>
		<Template>
			<Principal>{value:PrincipalPK}</Principal>
			<Password>{value:Password}</Password>
			<SenderID>{value:SenderID}</SenderID>
			<RecipientID>{value:RecipientID}</RecipientID>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>