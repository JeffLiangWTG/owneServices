<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="PortManifestPort">

  <StringColumn>
    <Name>Port</Name>
    <Caption>Port</Caption>
    <FullDescription>The port to which these settings apply.</FullDescription>
    <MaxLength>5</MaxLength>
    <EditableState>Conditional</EditableState>
  </StringColumn>

  <GuidColumn>
    <Name>PrincipalPK</Name>
    <Caption>Principal</Caption>
    <FullDescription>The principal to use for this message.</FullDescription>
    <EditableState>Conditional</EditableState>
  </GuidColumn>

  <StringColumn>
    <Name>SenderID</Name>
    <Caption>Sender ID</Caption>
    <FullDescription>Code of the sender to show in the message.</FullDescription>
    <MaxLength>35</MaxLength>
    <EditableState>Conditional</EditableState>
  </StringColumn>

  <BoolColumn>
    <Name>Enabled</Name>
    <Caption>Enabled</Caption>
    <FullDescription>Integration is enabled or disabled.</FullDescription>
  </BoolColumn>

  <Serialisation>
    <Template>
      <Port>{value:Port}</Port>
      <PrincipalPK>{value:PrincipalPK}</PrincipalPK>
      <SenderID>{value:SenderID}</SenderID>
      <Enabled>{value:Enabled}</Enabled>
    </Template>
  </Serialisation>
</RegistryBusinessObjectTemplate>