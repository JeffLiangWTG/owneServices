<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="BillOfLadingImage"
	>

  <GuidColumn>
    <Name>PrincipalPK</Name>
    <Caption>Principal Org.</Caption>
  </GuidColumn>

  <StringColumn>
    <Name>Description</Name>
    <Caption>Description</Caption>
    <MaxLength>50</MaxLength>
  </StringColumn>

  <BoolColumn>
    <Name>Enabled</Name>
    <Caption>Enabled</Caption>
  </BoolColumn>

  <ImageColumn>
    <Name>Image</Name>
  </ImageColumn>

  <Serialisation>
    <Template>
      <PrincipalPK>{value:PrincipalPK}</PrincipalPK>
      <Description>{value:Description}</Description>
      <Enabled>{value:Enabled}</Enabled>
      <Image>{value:Image}</Image>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>