<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="BulkDetentionChild">

	<StringColumn>
		<Name>DetentionType</Name>
		<Caption>Direction</Caption>
		<FullDescription>The type of detention.</FullDescription>
		<EditableState>ReadOnly</EditableState>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<GuidColumn>
		<Name>ClientPK</Name>
		<Caption>Client</Caption>
		<FullDescription>Create this detention job.</FullDescription>
		<EditableState>ReadOnly</EditableState>
	</GuidColumn>

	<GuidColumn>
		<Name>PrincipalPK</Name>
		<Caption>Principal</Caption>
		<FullDescription>The principal of this detention job.</FullDescription>
		<EditableState>ReadOnly</EditableState>
	</GuidColumn>

	<StringColumn>
		<Name>CountryCode</Name>
		<Caption>Country</Caption>
		<FullDescription>The country where the containers of this detention job were in detention.</FullDescription>
		<EditableState>ReadOnly</EditableState>
		<MaxLength>2</MaxLength>
	</StringColumn>

	<IntColumn>
		<Name>ContainerCount</Name>
		<ShortCaption>Count</ShortCaption>
		<Caption>Container Count</Caption>
		<FullDescription>The number of containers covered by this detention job.</FullDescription>
		<EditableState>GetterOnly</EditableState>
	</IntColumn>

	<StringColumn>
		<Name>JobNumber</Name>
		<Caption>Job Number</Caption>
		<FullDescription>The detention job number.</FullDescription>
		<EditableState>ReadOnly</EditableState>
		<MaxLength>20</MaxLength>
	</StringColumn>

	<GuidColumn>
		<Name>DetentionPK</Name>
		<EditableState>ReadOnly</EditableState>
	</GuidColumn>

	<BoolColumn>
		<Name>IsSelected</Name>
		<Caption>Select</Caption>
		<FullDescription>Create this detention job.</FullDescription>
	</BoolColumn>

	<BoolColumn>
		<Name>IsLocked</Name>
		<EditableState>ReadOnly</EditableState>
	</BoolColumn>

</NonPersistentBusinessObject>
