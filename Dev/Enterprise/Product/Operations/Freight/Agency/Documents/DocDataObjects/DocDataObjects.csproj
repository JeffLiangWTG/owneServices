  <ItemGroup>
    <Compile Update="Shared\AdditionalService.Create.cs">
      <DependentUpon>AdditionalService.cs</DependentUpon>
    </Compile>
    <Compile Update="Shared\Milestone.Create.cs">
      <DependentUpon>Milestone.cs</DependentUpon>
    </Compile>
    <Compile Update="Shared\ReferenceNumber.Create.cs">
      <DependentUpon>ReferenceNumber.cs</DependentUpon>
    </Compile>
    <Compile Update="Shared\Transport.Create.cs">
      <DependentUpon>Transport.cs</DependentUpon>
    </Compile>
