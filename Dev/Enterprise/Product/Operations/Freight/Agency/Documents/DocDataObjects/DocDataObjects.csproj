      <DependentUpon>Transports.cs</DependentUpon>
    </Compile>
    <Compile Update="Shared\Vessel.Create.cs">
      <DependentUpon>Vessel.cs</DependentUpon>
    </Compile>
    <Compile Update="Shared\Constants\TransportTypes.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TransportTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Shared\TransportTypes.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TransportTypes.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Shared\Constants\TransportTypes.xml">
      <CustomToolNamespace>Enterprise.Freight.Agency.Documents.DocDataObjects</CustomToolNamespace>
      <LastGenOutput>TransportTypes.cs</LastGenOutput>
      <Generator>CodeDescriptionPairListGenerator</Generator>
    </None>
    <None Update="Shared\TransportTypes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TransportTypes.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Freight.Agency.Documents.DocDataObjects</CustomToolNamespace>
    </None>
