<?xml version="1.0" encoding="utf-8"?>
<RegistryBusinessObjectTemplate
  xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
  name="MobilityDocumentType">
  <!--
	For instructions see:
  https://devops.wisetechglobal.com/wtg/CargoWise/_wiki/wikis/CargoWise.wiki/3307/Using-the-Generator
	-->
  <GuidColumn>
    <Name>RT_PK</Name>
    <Caption>Ref Doc Type PK</Caption>
  </GuidColumn>
  <StringColumn>
    <Name>RT_DocType</Name>
    <Caption>Ref Doc Type Code</Caption>
    <MaxLength>4</MaxLength>
  </StringColumn>

  <Serialisation>
    <Template>
      <RT_PK>{value:RT_PK}</RT_PK>
      <RT_DocType>{value:RT_DocType}</RT_DocType>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>