<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.TransportCommon.Registry</RootNamespace>
    <AssemblyName>Enterprise.TransportCommon.Registry</AssemblyName>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <CWGenerateXmlSerializationAssemblies>true</CWGenerateXmlSerializationAssemblies>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="Resources" />
    <Reference Include="WTG.RTUS.Interface" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TransportCommon.Integration\TransportCommon.Integration.csproj" />
    <ProjectReference Include="..\TransportCommon.Shared\TransportCommon.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Business\Lists\ProofOfDeliveryPickupDestinations.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ProofOfDeliveryPickupDestinations.xml</DependentUpon>
    </Compile>
    <Compile Update="Business\MobilityDocumentTypes\AutoMobilityDocumentType.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AutoMobilityDocumentType.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Business\Lists\ProofOfDeliveryPickupDestinations.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ProofOfDeliveryPickupDestinations.cs</LastGenOutput>
    </None>
    <None Update="Business\MobilityDocumentTypes\AutoMobilityDocumentType.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoMobilityDocumentType.cs</LastGenOutput>
    </None>
  </ItemGroup>
	<Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>