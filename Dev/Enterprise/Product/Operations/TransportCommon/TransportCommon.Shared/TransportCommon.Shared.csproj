<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.TransportCommon.Shared</RootNamespace>
    <AssemblyName>Enterprise.TransportCommon.Shared</AssemblyName>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.EventReference" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.DocumentEngineCore" />
    <Reference Include="Enterprise.MasterFiles.Business" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.UniversalDataBuss.Integration" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Resources" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Lists\ConsignmentStatuses.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ConsignmentStatuses.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportCommon.Shared</CustomToolNamespace>
    </None>
    <None Update="Lists\PackageCategories.xml">
      <CustomToolNamespace>Enterprise.TransportCommon.Shared</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>PackageCategories.cs</LastGenOutput>
    </None>
    <None Update="Lists\TransportConsolidationJobTypes.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TransportConsolidationJobTypes.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportCommon.Shared</CustomToolNamespace>
    </None>
    <None Update="Lists\TransportStatuses.xml">
      <CustomToolNamespace>Enterprise.TransportCommon.Shared</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>TransportStatuses.cs</LastGenOutput>
    </None>
    <None Update="Lists\BookingViews.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>BookingViews.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.TransportCommon.Shared</CustomToolNamespace>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Lists\BookingViews.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>BookingViews.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\ConsignmentStatuses.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ConsignmentStatuses.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\PackageCategories.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>PackageCategories.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\TransportConsolidationJobTypes.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TransportConsolidationJobTypes.xml</DependentUpon>
    </Compile>
    <Compile Update="Lists\TransportStatuses.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>TransportStatuses.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>