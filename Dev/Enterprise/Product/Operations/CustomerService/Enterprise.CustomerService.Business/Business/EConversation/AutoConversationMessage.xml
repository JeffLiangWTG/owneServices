<?xml version="1.0" encoding="utf-8" ?>
<NonPersistentBusinessObject
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="ConversationMessage"
	validationStyle="ObsoleteValidation"
	>

	<DateTimeColumn>
		<Name>SentTimeInUtc</Name>
	</DateTimeColumn>

	<StringColumn>
		<Name>UserCode</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>UserName</Name>
		<MaxLength>50</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<StringColumn>
		<Name>MessageType</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>MessageSubType</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<StringColumn>
		<Name>Body</Name>
		<MaxLength>32000</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<StringColumn>
		<Name>AdditionalNote</Name>
		<MaxLength>32000</MaxLength>
		<AllowUnicode>true</AllowUnicode>
	</StringColumn>

	<GuidColumn>
		<Name>Id</Name>
	</GuidColumn>

	<Serialisation>
		<Template>
			<SentTimeInUtc>{value:SentTimeInUtc}</SentTimeInUtc>
			<UserCode>{value:UserCode}</UserCode>
			<UserName>{value:UserName}</UserName>
      <MessageType>{value:MessageType}</MessageType>
			<MessageSubType>{value?:MessageSubType}</MessageSubType>
			<Body>{value:Body}</Body>
			<AdditionalNote>{value?:AdditionalNote}</AdditionalNote>
			<Id>{value?:Id}</Id>
		</Template>
	</Serialisation>

</NonPersistentBusinessObject>
