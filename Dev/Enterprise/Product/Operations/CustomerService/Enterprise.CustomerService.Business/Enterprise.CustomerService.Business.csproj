  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="System.ServiceModel.Primitives" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Business\Cr8ModuleList.cs">
      <DependentUpon>Cr8ModuleList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Business\Cr9ModuleList.cs">
      <DependentUpon>Cr9ModuleList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Business\EConversation\AutoConversationMessage.cs">
      <DependentUpon>AutoConversationMessage.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Web References\MyAccountLogin\Reference.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Reference.map</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Business\Cr8ModuleList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>Cr8ModuleList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.CustomerService.Business</CustomToolNamespace>
    </None>
    <None Update="Business\Cr9ModuleList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>Cr9ModuleList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.CustomerService.Business</CustomToolNamespace>
    </None>
    <None Update="Business\EConversation\AutoConversationMessage.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoConversationMessage.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.CustomerService.Business</CustomToolNamespace>
    </None>
    <EmbeddedResource Include="Business\IncidentRequest\IncidentRequestResourceStrings.xml" />
    <EmbeddedResource Include="Business\IncidentApproval\WhatToDoWithSpamFilterFull.html" />
    <EmbeddedResource Include="Business\IncidentApproval\WhatToDoWithSpamFilter.html" />
    <EmbeddedResource Include="Business\IncidentApproval\IncidentApprovalResourceStrings.xml" />
  </ItemGroup>
  <ItemGroup>
    <WebReferences Include="Web References\" />
  </ItemGroup>
  <ItemGroup>
    <WebReferenceUrl Include="http://localhost/myaccount/Login/LoginService.asmx">
      <UrlBehavior>Static</UrlBehavior>
      <RelPath>Web References\MyAccountLogin\</RelPath>
      <UpdateFromURL>http://localhost/myaccount/Login/LoginService.asmx</UpdateFromURL>
      <ServiceLocationURL></ServiceLocationURL>
      <CachedDynamicPropName></CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>Enterprise_CustomerService_MyAccountLogin_LoginService</CachedSettingsPropName>
    </WebReferenceUrl>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>