<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Warehouse.Transactions.GUI.Testing</RootNamespace>
    <AssemblyName>Enterprise.Warehouse.Transactions.GUI.Testing</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <Configurations>Debug;Release;DEBUGFAST</Configurations>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="Moq" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <Reference Include="WinForms.DataVisualization" />
    <Reference Include="WinForms.DataVisualization.Utilities" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Warehouse.Transactions.GUI\Warehouse.Transactions.GUI.csproj" />
  </ItemGroup>
</Project>