<?xml version="1.0" encoding="utf-8"?>
<xs:schema
	xmlns="http://www.edi.com.au/EnterpriseService/"
	attributeFormDefault="unqualified"
	elementFormDefault="qualified"
	targetNamespace="http://www.edi.com.au/EnterpriseService/"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
>

	<xs:include schemaLocation="..\..\..\..\..\..\Core\DataTransfer\DataTransfer\DataFileDefinitions\Xml\Version1\Elements.xsd" />

	<!--Top Level Collection-->

	<xs:complexType name="SystemMergeWarehouses">
		<xs:sequence>
			<xs:element maxOccurs="unbounded" name="Warehouse" type="SystemMergeWarehouse" />
		</xs:sequence>
	</xs:complexType>

	<!--Top Level Entity-->

	<xs:complexType name="SystemMergeWarehouse">
		<xs:sequence>
			<xs:element minOccurs="0" name="PK" type="Guid" />
			<xs:element minOccurs="0" name="WarehouseAddressPK" type="Guid" />

			<xs:element minOccurs="0" name="RelatedCompanyBranchCode" type="xs:string" />
			<xs:element minOccurs="0" name="WarehouseCode" type="xs:string" />
			<xs:element minOccurs="0" name="WarehouseName" type="xs:string" />
			<xs:element minOccurs="0" name="PackingSlipTitle" type="xs:string" />
			<xs:element minOccurs="0" name="LocationComponentDelimiter" type="xs:string" />
			<xs:element minOccurs="0" name="DefaultLocationType" type="xs:string" />

			<xs:element minOccurs="0" name="IsActive" type="xs:boolean" />
			<xs:element minOccurs="0" name="IsVirtualWarehouse" type="xs:boolean" />
			<xs:element minOccurs="0" name="IsBondedWarehouse" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocationColumnsAlpha" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocationLevelsAlpha" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocaitonTraysAlpha" type="xs:boolean" />
			<xs:element minOccurs="0" name="AutoPrintPickingSlip" type="xs:boolean" />
			<xs:element minOccurs="0" name="AutoPrintPackingSlip" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocationsHaveLeadingZeros" type="xs:boolean" />
			<xs:element minOccurs="0" name="UseArrivalDateForInwardsFinalisedDate" type="xs:boolean" />
			<xs:element minOccurs="0" name="UseRequiredDateForOutwardsFinalisedDate" type="xs:boolean" />
			<xs:element minOccurs="0" name="AutoPrintPickingShortfallItems" type="xs:boolean" />
			<xs:element minOccurs="0" name="AutoPrintPickingNonPickedItems" type="xs:boolean" />
			<xs:element minOccurs="0" name="AutoPrintOrderSummaryOnPick" type="xs:boolean" />
			<xs:element minOccurs="0" name="AutoPrintOrderCopyForMOPOnPick" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocationColumnsZeroBased" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocationLevelsZeroBased" type="xs:boolean" />
			<xs:element minOccurs="0" name="LocationTraysZeroBased" type="xs:boolean" />
			<xs:element minOccurs="0" name="DefaultInboundDockDoorPK" type="Guid" />
			<xs:element minOccurs="0" name="DefaultOutboundDockDoorPK" type="Guid" />
			<xs:element minOccurs="0" name="LocationColumnsFixedWidth" type="xs:unsignedByte"/>
			<xs:element minOccurs="0" name="LocationLevelsFixedWidth" type="xs:unsignedByte"/>
			<xs:element minOccurs="0" name="LocationTraysFixedWidth" type="xs:unsignedByte"/>

      <!-- Dependent Collections-->

			<xs:element minOccurs ="0" name="Rows">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="Row" type="SystemMergeRow" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>

			<xs:element minOccurs ="0" name ="Areas">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="Area" type="SystemMergeArea" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>

		</xs:sequence>
	</xs:complexType>

	<xs:complexType name ="SystemMergeRow">
		<xs:sequence>
			<xs:element minOccurs="0" name="PK" type="Guid" />

			<xs:element minOccurs="0" name="Name" type="xs:string" />

			<xs:element minOccurs="0" name="Columns" type="xs:short" />
			<xs:element minOccurs="0" name="Levels" type="xs:short" />
			<xs:element minOccurs="0" name="Trays" type="xs:short" />

			<xs:element minOccurs ="0" name ="Locations">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="Location" type="SystemMergeLocation" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>

		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="SystemMergeLocation">
		<xs:sequence>
			<xs:element minOccurs="0" name="PK" type="Guid" />
      <xs:element minOccurs="0" name="PickingAreaPK" type="Guid" />
      <xs:element minOccurs="0" name="PutawayAreaPK" type="Guid" /> 

			<xs:element minOccurs="0" name="Column" type="xs:short" />
			<xs:element minOccurs="0" name="Level" type="xs:short" />
			<xs:element minOccurs="0" name="Tray" type="xs:short" />

			<xs:element minOccurs="0" name="ApprovedKnownLocation" type="xs:string" />
			<xs:element minOccurs="0" name="LocationType" type="xs:string" />
			<xs:element minOccurs="0" name="LocationStatus" type="xs:string" />
			<xs:element minOccurs="0" name="MaxWeightUQ" type="xs:string" />
			<xs:element minOccurs="0" name="MaxVolumeUQ" type="xs:string" />
			<xs:element minOccurs="0" name="PickMethod" type="xs:string" />

			<xs:element minOccurs="0" name="PalletFloorSpaces" type="xs:unsignedByte" />
			<xs:element minOccurs="0" name="PalletStackHeight" type="xs:unsignedByte" />
			
			<xs:element minOccurs="0" name="MaxWeight" type="xs:decimal" />
			<xs:element minOccurs="0" name="MaxVolume" type="xs:decimal" />
			<xs:element minOccurs="0" name="MaxWidth" type="xs:decimal" />
			<xs:element minOccurs="0" name="MaxHeight" type="xs:decimal" />
			<xs:element minOccurs="0" name="MaxDepth" type="xs:decimal" />
			<xs:element minOccurs="0" name="MaxDimensionUQ" type="xs:string" />
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="SystemMergeArea">
		<xs:sequence>
			<xs:element minOccurs="0" name="PK" type="Guid" />
			<xs:element minOccurs="0" name="Name" type="xs:string" />
			<xs:element minOccurs="0" name="AreaType" type="xs:string" />

			<xs:element minOccurs="0" name="ClientParametersByWarehouse">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" name="ClientParameterByWarehouse" type="SystemMergeClientParameterByWarehouse" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="SystemMergeClientParameterByWarehouse">
		<xs:sequence>
			<xs:element minOccurs="0" name="PK" type="Guid" />
			<xs:element minOccurs="0" name="ClientPK" type="Guid" />
		</xs:sequence>
	</xs:complexType>

</xs:schema>
