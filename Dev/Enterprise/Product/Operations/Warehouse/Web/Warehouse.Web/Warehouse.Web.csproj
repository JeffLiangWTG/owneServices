  <Target Name="CopyCabinetFilesFromNuGet" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <CabinetFiles Include="$(PkgNETCompactFramework_Installers)\content\*.cab" />
    </ItemGroup>

    <Copy SourceFiles="@(CabinetFiles)" DestinationFolder="$(ProjectDir)WebService\Downloads\" SkipUnchangedFiles="true" />

    <ItemGroup>
      <Content Include="WebService\Downloads\NETCFv35.Messages.EN.cab" />
      <Content Include="WebService\Downloads\NETCFv35.Messages.EN.wm.cab" />
      <Content Include="WebService\Downloads\NETCFv35.wce.armv4.cab" />
      <Content Include="WebService\Downloads\NETCFv35.wm.armv4i.cab" />
    </ItemGroup>

    <Message Text="Copied cabinet files from NuGet package to Downloads folder" />
