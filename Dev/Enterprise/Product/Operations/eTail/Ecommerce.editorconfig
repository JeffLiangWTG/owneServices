[*.cs]

### IDE Analyzer Rules
dotnet_diagnostic.CS8019.severity = error
dotnet_diagnostic.IDE0002.severity = error
dotnet_diagnostic.IDE0003.severity = error
dotnet_diagnostic.IDE0007.severity = error
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0018.severity = error
dotnet_diagnostic.IDE0019.severity = error
dotnet_diagnostic.IDE0020.severity = error
dotnet_diagnostic.IDE0029.severity = error
dotnet_diagnostic.IDE0030.severity = error
dotnet_diagnostic.IDE0031.severity = warning
dotnet_diagnostic.IDE0033.severity = error
dotnet_diagnostic.IDE0034.severity = error
dotnet_diagnostic.IDE0036.severity = error
dotnet_diagnostic.IDE0038.severity = error
dotnet_diagnostic.IDE0049.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.IDE0055.severity = error
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = error
dotnet_diagnostic.IDE0062.severity = suggestion
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0100.severity = error
dotnet_diagnostic.IDE0110.severity = error
dotnet_diagnostic.IDE2002.severity = error
dotnet_diagnostic.IDE2003.severity = error

### StyleCop Analyzers
dotnet_diagnostic.SA1513.severity = error
dotnet_diagnostic.SA1649.severity = error

### WTG Analyzers
# UseVarWherePossible
dotnet_diagnostic.WTG1002.severity = error
# DoNotLeaveWhitespaceOnTheEndOfTheLine
dotnet_diagnostic.WTG1003.severity = error
# UseConsistentLineEndings
dotnet_diagnostic.WTG1005.severity = error
# UsingDirectivesMustBeOrderedByKind
dotnet_diagnostic.WTG1009.severity = error
# UseOutVarWherePossible
dotnet_diagnostic.WTG1010.severity = error
# DeconstructWithVar
dotnet_diagnostic.WTG1012.severity = error
# AvoidTupleTypesInPublicInterfaces
dotnet_diagnostic.WTG1013.severity = warning
# RemovedOrphanedSuppressions
dotnet_diagnostic.WTG3001.severity = warning
# RemovePointlessOverrides
dotnet_diagnostic.WTG3007.severity = error
# DontEquateValueTypesWithNull
dotnet_diagnostic.WTG3008.severity = error
