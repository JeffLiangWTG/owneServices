<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="CommissionLineGrouping">

	<GuidColumn>
		<Name>CompanyPk</Name>
		<Caption>Transaction Company</Caption>
		<ShortCaption>Company</ShortCaption>
	</GuidColumn>

	<GuidColumn>
		<Name>SourceId</Name>
	</GuidColumn>

	<StringColumn>
		<Name>SourceTableCode</Name>
		<MaxLength>3</MaxLength>
	</StringColumn>

  <StringColumn>
    <Name>SourceUniqueId</Name>
    <MaxLength>72</MaxLength>
  </StringColumn>
  
	<StringColumn>
		<Name>JobNumber</Name>
		<MaxLength>35</MaxLength>
	</StringColumn>
	
	<StringColumn>
    <Name>StaffCode</Name>
		<MaxLength>3</MaxLength>
		<Caption>Staff</Caption>
  </StringColumn>

	<GuidColumn>
		<Name>PartyPk</Name>
		<Caption>Organization</Caption>
	</GuidColumn>

	<StringColumn>
		<Name>TransactionCurrencyCode</Name>
		<MaxLength>3</MaxLength>
		<Caption>Transaction Currency</Caption>
		<ShortCaption>Trans CUR</ShortCaption>
	</StringColumn>
	
	<StringColumn>
		<Name>LocalCurrencyCode</Name>
		<MaxLength>3</MaxLength>
		<Caption>Local Currency</Caption>
		<ShortCaption>Local CUR</ShortCaption>
	</StringColumn>

	<GuidColumn>
		<Name>PreferredPaymentCompanyPk</Name>
		<Caption>Preferred Company</Caption>
		<ShortCaption>Pref. Company</ShortCaption>
	</GuidColumn>
	
	<StringColumn>
		<Name>PreferredCurrencyCode</Name>
		<MaxLength>3</MaxLength>
		<Caption>Preferred Currency</Caption>
		<ShortCaption>Pref CUR</ShortCaption>
	</StringColumn>
	
	<DecimalColumn>
		<Name>LocalToPreferredExchangeRate</Name>
		<Precision>18</Precision>
		<Scale>9</Scale>
		<Caption>Local to Preferred Exchange Rate</Caption>
		<ShortCaption>Pref Ex Rate</ShortCaption>
	</DecimalColumn>

	<StringColumn>
		<Name>CommissionStatus</Name>
		<Caption>Status</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<BoolColumn>
		<Name>IsCanceled</Name>
		<Caption>Canceled</Caption>
	</BoolColumn>
	
</NonPersistentBusinessObject>