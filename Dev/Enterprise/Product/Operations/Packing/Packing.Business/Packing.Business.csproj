      <LastGenOutput>PkgPackageScreeningResults.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Packing.Business</CustomToolNamespace>
    </None>
    <None Update="PkgPalletTransaction\PalletTransactionStatusList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>PalletTransactionStatusList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Packing.Business</CustomToolNamespace>
