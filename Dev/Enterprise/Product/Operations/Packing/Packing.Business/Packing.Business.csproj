      <CustomToolNamespace>Enterprise.Packing.Business</CustomToolNamespace>
    </None>
    <None Update="PkgPalletTransaction\PalletTransactionTypeList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>PalletTransactionTypeList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.Packing.Business</CustomToolNamespace>
    </None>
    <EmbeddedResource Include="PkgPalletTransaction\Auto\PkgPalletTransactionResourceStrings.xml" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
