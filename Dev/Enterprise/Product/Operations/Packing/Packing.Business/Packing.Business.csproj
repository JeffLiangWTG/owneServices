      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>PkgPackageScreeningResults.xml</DependentUpon>
    </Compile>
    <Compile Update="PkgPalletTransaction\PalletTransactionStatusList.cs">
      <DependentUpon>PalletTransactionStatusList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="PkgPalletTransaction\PalletExchangeTypeList.cs">
