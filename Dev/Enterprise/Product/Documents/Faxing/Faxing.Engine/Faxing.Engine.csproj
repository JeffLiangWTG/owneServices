<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Faxing.Engine</RootNamespace>
    <AssemblyName>Enterprise.Faxing.Engine</AssemblyName>
    <PostBuildEvent>xcopy "$(MSBuildProjectDirectory)\BlackIceRedistributables\*.*" "$(MSBuildProjectDirectory)\..\..\..\..\..\bin\" /R /Y</PostBuildEvent>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Shared.40" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="BlackIceRedistributables\Tiff32.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Faxing.Integration\Faxing.Integration.csproj" />
  </ItemGroup>
</Project>