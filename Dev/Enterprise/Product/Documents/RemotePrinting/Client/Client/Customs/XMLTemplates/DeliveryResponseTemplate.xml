<UniversalInterchange xmlns="http://www.cargowise.com/Schemas/Universal/2011/11">
	<Header>
		<SenderID>{senderId}</SenderID>
		<RecipientID>{recipientId}</RecipientID>
	</Header>
	<Body>
		<UniversalEvent xmlns="http://www.cargowise.com/Schemas/Universal/2012/11" version="1.1">
			<Event>
				<EventTime>{notificationTime}</EventTime>
				<EventType>IRJ</EventType>
				<EventParameters>
					<MessageType>XER</MessageType>
					<Type>{errorType}</Type>
					<Reason>{errorDescription}</Reason>
				</EventParameters>
			</Event>
		</UniversalEvent>
	</Body>
</UniversalInterchange>
