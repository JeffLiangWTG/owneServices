<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeting reverted as Reference.cs uses bunch of System.Web.Services -->
    <TargetFrameworks>net48</TargetFrameworks>
    <RootNamespace>Enterprise.RemotePrinting.Client</RootNamespace>
    <AssemblyName>RemotePrinting.Client</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <SuppressObsoleteWarnings>SYSLIB0014;SYSLIB0051</SuppressObsoleteWarnings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <EmbeddedResource Include="..\Setup\Setup.version">
      <Link>Properties\Setup.version</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="Customs\XMLTemplates\DeliveryResponseTemplate.xml" />
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="Web References\RemotePrintServer\TWNCATKClientSetting.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.eHub.Common" />
    <Reference Include="CargoWise.PdfiumWrapper" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.Messaging.Integration" />
    <Reference Include="Enterprise.xTMessaging.Shared" />
    <Reference Include="Enterprise.ZArchitecture.GUI" />
    <Reference Include="Grpc.Core.Api" />
    <Reference Include="Google.Protobuf" />
    <Reference Include="MailKit" />
    <Reference Include="Microsoft.AspNet.SignalR.Client" />
    <Reference Include="MimeKit" />
    <Reference Include="NLog" />
    <Reference Include="RemotePrinting.Engine" />
    <Reference Include="RemotePrinting.Types" />
    <Reference Include="WTG.ErrorReporting" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="Xware.Xt.Grpc.Application" />
    <Reference Include="Xware.Xt.Grpc.Config" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Services" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <PackageReference Include="System.ServiceModel.Primitives" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="Web References\RemotePrintServer\Reference.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Reference.map</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <WebReferences Include="Web References\" />
  </ItemGroup>
  <ItemGroup>
    <WebReferenceUrl Include="http://localhost/WebPrint/RemotePrintingService.asmx">
      <UrlBehavior>Dynamic</UrlBehavior>
      <RelPath>Web References\RemotePrintServer\</RelPath>
      <UpdateFromURL>http://localhost/WebPrint/RemotePrintingService.asmx</UpdateFromURL>
      <ServiceLocationURL></ServiceLocationURL>
      <CachedDynamicPropName></CachedDynamicPropName>
      <CachedAppSettingsObjectName>Settings</CachedAppSettingsObjectName>
      <CachedSettingsPropName>RemotePrinting_Client_RemotePrintServer_RemotePrintingService</CachedSettingsPropName>
    </WebReferenceUrl>
  </ItemGroup>
  <ItemGroup>
    <None Update="Web References\RemotePrintServer\ClientUpdate.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
    <None Update="Web References\RemotePrintServer\CNSWClientSetting.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
    <None Update="Web References\RemotePrintServer\Reference.map">
      <Generator>MSDiscoCodeGenerator</Generator>
      <LastGenOutput>Reference.cs</LastGenOutput>
    </None>
    <None Update="Web References\RemotePrintServer\ServerPrintJob.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
    <None Update="Web References\RemotePrintServer\ServerPrintJobEx.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
    <None Update="Web References\RemotePrintServer\ServerPrintQueue.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
    <None Update="Web References\RemotePrintServer\ServerWatermark.datasource">
      <DependentUpon>Reference.map</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Resources.Extensions">
      <HintPath>..\..\..\..\..\..\bin\System.Resources.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>