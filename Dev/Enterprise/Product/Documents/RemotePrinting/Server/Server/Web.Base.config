<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>
  <appSettings>
    <add key="DatabaseName" value="Odyssey"/>
    <add key="ServerName" value="dbserver"/>
    <add key="WebUser" value="CWWeb"/>
    <add key="DBAdminEmail" value="TrackErr@cargowise.com"/>
    <add key="Branch" value="SYD"/>
    <add key="CompanyName" value="WiseTech Global"/>
    <add key="HomePageURL" value="http://www.wisetechglobal.com/"/>
    <add key="ClientInstallationFile" value="CargoWiseOneWebPrintClientSetup"/>
    <add key="ClientIntermediateInstallationFile" value="CargoWiseOneWebPrintClientIntSetup"/>
    <add key="ClientInstallationFolder" value="Client"/>
    <add key="ClientRequirementOS" value=""/>
    <add key="ClientRequirementDotnet" value="4.8"/>

    <add key="owin:appStartup" value="Enterprise.RemotePrinting.Server.Startup, RemotePrinting.Server"/>
  </appSettings>
  <system.web>
    <httpRuntime targetFramework="4.8" maxUrlLength="4096" maxQueryStringLength="4096"/>
    <hostingEnvironment shadowCopyBinAssemblies="false"/>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <remove assembly ="*"/>
        <add assembly="System.Windows.Forms, Version=2.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Design, Version=2.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Management, Version=2.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="Microsoft.Owin"/>
        <add assembly="Microsoft.Owin.Host.SystemWeb"/>
        <add assembly="CargoWise.ComponentModel"/>
        <add assembly="Enterprise.ZArchitecture.Business"/>
        <add assembly="RemotePrinting.Server"/>
      </assemblies>
    </compilation>
    <authentication mode="None"/>
    <authorization>
      <deny users="?"/>
    </authorization>
    <customErrors mode="Off"/>
    <webServices>
      <soapExtensionTypes>
        <add type="Enterprise.RemotePrinting.Server.ExceptionHandlingExtension, RemotePrinting.Server" priority="10" group="High"/>
      </soapExtensionTypes>
      <protocols>
        <add name="HttpPost"/>
      </protocols>
    </webServices>
  </system.web>
  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="wtg/status">
    <system.web>
      <authorization>
        <allow users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="wtg/ready">
    <system.web>
      <authorization>
        <allow users="?"/>
      </authorization>
    </system.web>
  </location>
  <location path="Support">
    <system.web>
      <authorization>
        <!-- The Support/Diagnostics.aspx page will deny all users except those with the "support" role -->
        <allow roles="support" />
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <modules>
      <add name="DigestModule" type="Enterprise.RemotePrinting.Server.DigestModule, RemotePrinting.Server"/>
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST,PUT,DELETE,OPTIONS" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <runtime>
