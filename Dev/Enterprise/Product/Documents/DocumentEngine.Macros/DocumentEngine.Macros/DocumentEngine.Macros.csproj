<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\..\..\packages\Antlr4.CodeGenerator\build\Antlr4.CodeGenerator.props" Condition="Exists('..\..\..\..\..\packages\Antlr4.CodeGenerator\build\Antlr4.CodeGenerator.props')" />
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.DocumentEngine.Macros</RootNamespace>
    <AssemblyName>Enterprise.DocumentEngine.Macros</AssemblyName>
    <NoWarn>$(NoWarn);CS2002</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineConstants>KeepTempFiles</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Antlr4 Update="LegacyMacroLexer.g4">
      <Generator>MSBuild:Compile</Generator>
      <CustomToolNamespace>Enterprise.DocumentEngine.Macros</CustomToolNamespace>
    </Antlr4>
    <Antlr4 Update="LegacyMacroParser.g4">
      <Generator>MSBuild:Compile</Generator>
      <Listener>False</Listener>
      <CustomToolNamespace>Enterprise.DocumentEngine.Macros</CustomToolNamespace>
    </Antlr4>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Antlr4.Runtime" />
    <Reference Include="CargoWise.Macros" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
  </ItemGroup>
  <Import Project="..\..\..\..\..\packages\Antlr4.CodeGenerator\build\Antlr4.CodeGenerator.targets" Condition="Exists('..\..\..\..\..\packages\Antlr4.CodeGenerator\build\Antlr4.CodeGenerator.targets')" />
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
</Project>