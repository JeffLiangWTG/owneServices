<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <AssemblyName>Enterprise.DocumentEngine.GUI.Test</AssemblyName>
    <RootNamespace>Enterprise.DocumentEngine.GUI.Test</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <SuppressObsoleteWarnings>SYSLIB0024</SuppressObsoleteWarnings>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Compile Remove="Winzor\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\DocumentEngine.Gui\Testing\DocumentsSaveAsTif.tif">
      <logicalName>Enterprise.DocumentEngine.GUI.Testing.DocumentsSaveAsTif.tif</logicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DocumentEngine.Gui\Testing\TooLongFormulaForXls.xlsx">
      <LogicalName>Enterprise.DocumentEngine.GUI.Testing.TooLongFormulaForXls.xlsx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DocumentEngine.Gui\Testing\TooManyRowsForXls.xlsx">
      <LogicalName>Enterprise.DocumentEngine.GUI.Testing.TooManyRowsForXls.xlsx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\DocumentEngine\Testing\ReportTestFiles\UDF with defaults.xls">
      <LogicalName>Enterprise.DocumentEngine.Testing.ReportTestFiles.UDF with defaults.xls</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\DocumentEngine\Testing\ReportTestFiles\UDF with defaults.xlsx">
      <LogicalName>Enterprise.DocumentEngine.Testing.ReportTestFiles.UDF with defaults.xlsx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\DocumentEngine\Testing\DocumentTestFiles\DummyBusinessObjectAsDataSource.xls">
      <LogicalName>Enterprise.DocumentEngine.Testing.DocumentTestFiles.DummyBusinessObjectAsDataSource.xls</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\DocumentEngine\Testing\DocumentTestFiles\CustomisableSectionTest.xls">
      <LogicalName>Enterprise.DocumentEngine.Testing.DocumentTestFiles.CustomisableSectionTest.xls</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DocumentEngine.Gui\Testing\TestReadOnlyTemplate.xls">
      <LogicalName>Enterprise.DocumentEngine.GUI.Testing.TestReadOnlyTemplate.xls</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\DocumentEngine.Gui\Testing\TestReadWriteTemplate.xls">
      <LogicalName>Enterprise.DocumentEngine.GUI.Testing.TestReadWriteTemplate.xls</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Enterprise.DocumentScanning.GUI" />
    <Reference Include="Enterprise.RemoteDesktopServices.Testing" />
    <Reference Include="Enterprise.RemoteDesktopServices.Server" />
    <Reference Include="Excel" />
    <Reference Include="FlexCelWinforms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocumentEngine.GUI\DocumentEngine.GUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="DocBuilder\Preview.xls" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.DirectoryServices" />
    <Reference Include="System.Memory" />
  </ItemGroup>
</Project>