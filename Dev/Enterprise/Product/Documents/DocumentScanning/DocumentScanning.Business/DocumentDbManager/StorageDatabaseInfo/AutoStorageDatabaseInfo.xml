<?xml version="1.0" encoding="utf-8"?>
<NonPersistentBusinessObject xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd" name="StorageDatabaseInfo">

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

	<IntColumn>
		<Name>DatabaseNumber</Name>
		<Caption>#</Caption>
		<EditableState>ReadOnly</EditableState>
	</IntColumn>

	<StringColumn>
		<Name>DatabaseName</Name>
		<Caption>Database</Caption>
		<EditableState>ReadOnly</EditableState>
		<MaxLength>128</MaxLength>
	</StringColumn>

	<IntColumn>
		<Name>SizeInMb</Name>
		<Caption>Size (MB)</Caption>
		<EditableState>ReadOnly</EditableState>
	</IntColumn>

	<BoolColumn>
		<Name>OriginalReadOnly</Name>
		<EditableState>ReadOnly</EditableState>
	</BoolColumn>

	<BoolColumn>
		<Name>NewReadOnly</Name>
		<Caption>Read-Only</Caption>
	</BoolColumn>

</NonPersistentBusinessObject>
