<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DocumentSigningServicePartnerCredentials"
	>

	<!--
	For instructions see:
	https://wisetechglobal.sharepoint.com/Development/Development%20Wiki/NonPersistentBusinessObjectGenerator.aspx.
	-->

  <StringColumn>
    <Name>PartnerID</Name>
    <Caption>Partner ID</Caption>
    <MaxLength>200</MaxLength>
    <GenerateValidation>true</GenerateValidation>
  </StringColumn>

  <StringColumn>
    <Name>PartnerAccessKey</Name>
    <Caption>Partner Access Key</Caption>
    <MaxLength>200</MaxLength>
    <GenerateValidation>true</GenerateValidation>
  </StringColumn>

  <Serialisation>
    <Template>
      <PartnerID>{value:PartnerID}</PartnerID>
      <PartnerAccessKey>{value:PartnerAccessKey}</PartnerAccessKey>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>
