<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="DeliveryOrder"
	>

	<GuidColumn>
		<Name>PrincipalPK</Name>
		<Caption>Principal</Caption>
	</GuidColumn>
	
	<StringColumn>
		<Name>PrintParameter</Name>
		<Caption>Print Parameter</Caption>
		<MaxLength>3</MaxLength>
	</StringColumn>

	<ImageColumn>
		<Name>Image</Name>
	</ImageColumn>
	
	<Serialisation>
		<Template>
			<PrincipalPK>{value:PrincipalPK}</PrincipalPK>
			<PrintParameter>{value:PrintParameter}</PrintParameter>
			<Image>{value:Image}</Image>
		</Template>
	</Serialisation>

</RegistryBusinessObjectTemplate>