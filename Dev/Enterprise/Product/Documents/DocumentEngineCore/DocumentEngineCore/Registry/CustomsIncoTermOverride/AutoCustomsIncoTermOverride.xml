<?xml version="1.0" encoding="utf-8" ?>
<RegistryBusinessObjectTemplate
	xmlns="http://www.edi.com.au/NonPersistentBusinessObject.xsd"
	name="CustomsIncoTermOverride" >

  <StringColumn>
    <Name>CustomsCode</Name>
    <Caption>Customs Code</Caption>
    <GenerateValidation>true</GenerateValidation>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <StringColumn>
    <Name>InternationalCode</Name>
    <Caption>International Code</Caption>
    <GenerateValidation>true</GenerateValidation>
    <MaxLength>3</MaxLength>
  </StringColumn>

  <Serialisation>
    <Template>
      <CustomsCode>{value:CustomsCode}</CustomsCode>
      <InternationalCode>{value:InternationalCode}</InternationalCode>
    </Template>
  </Serialisation>

</RegistryBusinessObjectTemplate>