<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.DocumentEngineCore</RootNamespace>
    <AssemblyName>Enterprise.DocumentEngineCore</AssemblyName>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
    <CWGenerateXmlSerializationAssemblies>true</CWGenerateXmlSerializationAssemblies>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Integration" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.DocumentEngine.Macros" />
    <Reference Include="Enterprise.DocumentEngineIntegration" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Integration" />
    <Reference Include="Enterprise.MasterFiles.Integration" />
    <Reference Include="Enterprise.Registry.Business" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Core.Encryption" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="Resources" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Registry\AddressFormatting\AddressPositionList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AddressPositionList.xml</DependentUpon>
    </Compile>
    <Compile Update="Registry\DocumentSigningService\AutoDocumentSigningServicePartnerCredentials.cs">
      <DependentUpon>AutoDocumentSigningServicePartnerCredentials.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Registry\ExcelFileFormatOptionList.cs">
      <DependentUpon>ExcelFileFormatOptionList.xml</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Registry\DeliverEDocsOptionList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>DeliverEDocsOptionList.xml</DependentUpon>
    </Compile>
    <Compile Update="Registry\DeliveryMethodOptionList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>DeliveryMethodOptionList.xml</DependentUpon>
    </Compile>
    <Compile Update="Registry\DocBuilderDataSource\AutoDocBuilderDataSource.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>AutoDocBuilderDataSource.xml</DependentUpon>
    </Compile>
    <Compile Update="Registry\DocBuilderTheme\DocBuilderThemeItemList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>DocBuilderThemeItemList.xml</DependentUpon>
    </Compile>
    <Compile Update="Registry\RedirectedDocumentAddressFormattingOptionList.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>RedirectedDocumentAddressFormattingOptionList.xml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Registry\AddressFormatting\AddressPositionList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>AddressPositionList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.DocumentEngineCore.Registry</CustomToolNamespace>
    </None>
    <None Update="Registry\DocumentSigningService\AutoDocumentSigningServicePartnerCredentials.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoDocumentSigningServicePartnerCredentials.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.DocumentEngineCore.Registry</CustomToolNamespace>
    </None>
    <None Update="Registry\ExcelFileFormatOptionList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>ExcelFileFormatOptionList.cs</LastGenOutput>
    </None>
    <None Update="Registry\DeliverEDocsOptionList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>DeliverEDocsOptionList.cs</LastGenOutput>
    </None>
    <None Update="Registry\DeliveryMethodOptionList.xml">
      <CustomToolNamespace>Enterprise.DocumentEngineCore.Registry</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>DeliveryMethodOptionList.cs</LastGenOutput>
    </None>
    <None Update="Registry\DocBuilderDataSource\AutoDocBuilderDataSource.xml">
      <Generator>NonPersistentBusinessObjectGenerator</Generator>
      <LastGenOutput>AutoDocBuilderDataSource.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.DocumentEngineCore.Registry</CustomToolNamespace>
    </None>
    <None Update="Registry\DocBuilderTheme\DocBuilderThemeItemList.xml">
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>DocBuilderThemeItemList.cs</LastGenOutput>
      <CustomToolNamespace>Enterprise.DocumentEngineCore.Registry</CustomToolNamespace>
    </None>
    <EmbeddedResource Include="Registry\DocBuilderTheme\SystemDocBuilderThemes.xml" />
    <None Update="Registry\RedirectedDocumentAddressFormattingOptionList.xml">
      <CustomToolNamespace>Enterprise.DocumentEngineCore.Registry</CustomToolNamespace>
      <Generator>CodeDescriptionPairListGenerator</Generator>
      <LastGenOutput>RedirectedDocumentAddressFormattingOptionList.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <WCFMetadata Include="Service References\" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>