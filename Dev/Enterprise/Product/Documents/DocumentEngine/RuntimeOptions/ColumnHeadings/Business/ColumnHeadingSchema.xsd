<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" id="XMLSchema1">
	<xs:complexType name="ReportColumnSettings">
		<xs:sequence>
			<xs:element name="Worksheets">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Worksheet" type="Worksheet" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Version" type="xs:int"/>
			<xs:element name="Filters" type="xs:base64Binary"/>
			<xs:element name="SelectedSortOrderName" type="xs:string"/>
			<xs:element name="SelectedGroupByName" type="xs:string"/>
      <xs:element name="SelectedOrientation" type="xs:string"/>
			<xs:element name="SelectedLanguage" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Worksheet">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="Title" type="xs:string"/>
			<xs:element name="ColumnHeadings">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ColumnHeading" type="ColumnHeading" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ColumnHeading">
		<xs:sequence>
			<xs:element name="DisplayLabel" type="xs:string"/>
			<xs:element name="OriginalColumnNumber" type="xs:int"/>
			<xs:element name="Description" type="xs:string"/>
			<xs:element name="HeadingText" type="xs:string"/>
      <xs:element name="TagName" type="xs:string"/>
			<xs:element name="Hidden" type="xs:boolean"/>
			<xs:element name="WidthInPixels" type="xs:int"/>
			<xs:element name="CurrentPosition" type="xs:int"/>
      <xs:element name="HideIfDescriptionEmpty" type="xs:boolean"/>
    </xs:sequence>
	</xs:complexType>
</xs:schema>
