<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(CWNetCoreWindowsTargetFramework)</TargetFramework>
    <!-- The assembly name must end with `.TestAdapter` or vstest.console.exe will not recognize your test adapter -->
    <AssemblyName>CWNetCoreTest.TestAdapter</AssemblyName>
    <RootNamespace>CWNetCoreTest.TestAdapter</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />

  <ItemGroup>
    <Content Include="CWNetCoreTestAdapterResources\Explicit*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      These packages include msbuild actions, rather than only compile-time assemblies. They cannot be added via paket+build.xml copy task
    -->
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />

    <!-- Needed to resolve depending assemblies link to our version of this lib -->
    <PackageReference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.Main" />
    <Reference Include="CWNUnit.TestAdapter" />
    <Reference Include="Dat.Integration" />
    <Reference Include="Enterprise.Dat.Adapter" />
    <Reference Include="Enterprise.Dat.Adapter.Strong" />
    <Reference Include="Enterprise.Environment" />
    <Reference Include="Enterprise.Initialisation" />
    <Reference Include="Enterprise.ZArchitecture.Business" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Core.Test" />
    <Reference Include="Enterprise.ZArchitecture.GUI" />
    <Reference Include="NUnitCore" />
  </ItemGroup>
</Project>