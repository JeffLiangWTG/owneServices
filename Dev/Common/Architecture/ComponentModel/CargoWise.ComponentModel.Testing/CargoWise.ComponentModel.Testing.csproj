<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <ProjectReference Include="..\CargoWise.ComponentModel\CargoWise.ComponentModel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.Common.Testing" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Moq" />
    <Reference Include="NUnitCore" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Design" />
    <Reference Include="System.Memory" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <Reference Include="System.CodeDom" />
    <Reference Include="System.Windows.Forms.Design" />
    <PackageReference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>