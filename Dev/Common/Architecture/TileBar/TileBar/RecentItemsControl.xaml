<UserControl
	x:Class="CargoWise.GUI.TileBar.RecentItemsControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:UI="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="TileBarResources.xaml" />
    </UserControl.Resources>

    <Border
		Margin="0"
		BorderThickness="1"
		Background="{StaticResource RecentPanelBackgroundColor}"
		BorderBrush="{StaticResource RecentPanelBorderColor}">
        <Grid>
            <ScrollViewer
				VerticalScrollBarVisibility="Auto">
                <ItemsControl
					Name="ItemsControl"
					Width="{Binding Width, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
					Padding="2"
					ItemTemplate="{StaticResource StandaloneRecentItem}"
					ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <UI:MultilingualTextLabel HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                <TextBlock
				Text="No recent items for current module."
				Style="{StaticResource RecentItemsNoRecords}">
                </TextBlock>
            </UI:MultilingualTextLabel>
        </Grid>
    </Border>
</UserControl>
