<UserControl
	x:Class="CargoWise.GUI.TileBar.TileBarControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:CargoWise.GUI.TileBar"
	xmlns:nav="clr-namespace:CargoWise.Main.Navigation;assembly=CargoWise.Main.Navigation"
	xmlns:UI="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
	UseLayoutRounding="True">

	<UserControl.Resources>
		<ResourceDictionary Source="TileBarResources.xaml" />
	</UserControl.Resources>

	<Grid>
		<DockPanel>
			<ListBox
				MouseLeftButtonUp="SelectedMode_MouseLeftButtonUp"
				TextSearch.TextPath="Name"
				DockPanel.Dock="Top"
				Margin="0"
				Style="{StaticResource TileBarListBox}"
				ItemContainerStyle="{StaticResource CategoryListBoxItem}"
				Background="Transparent"
				ItemsSource="{Binding Categories}"
				SelectedItem="{Binding SelectedCategory}"
				ItemTemplate="{StaticResource CategoryTemplate}"
				x:Name="SelectedMode">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
			</ListBox>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ScrollViewer
					x:Name="CategoryDetail"
					Grid.ColumnSpan="2"
					VerticalScrollBarVisibility="{Binding Path=SelectedItem, ElementName=SelectedMode, Converter={StaticResource ScrollBarVisibilityConverter}}"
					HorizontalScrollBarVisibility="Disabled"
					Visibility="{Binding IsInSearchMode, Converter={StaticResource InvertVisibilityConverter}}">
					<ListBox
						TextSearch.TextPath="Letter"
						DataContext="{Binding SelectedCategory}"
						UI:ListBoxExtension.HoveredItem="{Binding HoveredItem, IsAsync=True, Mode=TwoWay}"
						Style="{StaticResource TileBarListBox}"
						SelectedItem="{Binding SelectedItem}"
						ItemsSource="{Binding Buttons}"
						ItemTemplateSelector="{StaticResource MenuTemplateSelector}">
					</ListBox>
				</ScrollViewer>
				<DockPanel
					x:Name="SearchPanel"
					Grid.ColumnSpan="2"
					Margin="0 0 0 22"
					VerticalAlignment="Stretch"
					Visibility="{Binding IsInSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}"
					Background="{StaticResource DetailsBackgroundColor}">
					<StackPanel
						DockPanel.Dock="Top"
						Margin="4 4 5 8">
						<Grid>
							<TextBox
								BorderThickness="1"
								BorderBrush="{StaticResource DetailsBorderColor}"
								Height="20"
								Margin="0 1 36 2"
								x:Name="QuickSearch"
								VerticalContentAlignment="Center"
								Text="{Binding SearchViewModel.SearchValue, UpdateSourceTrigger=PropertyChanged, Delay=500}">
								<TextBox.InputBindings>
									<KeyBinding Key="Enter" Command="{Binding RunFirstSearchResult}" />
									<KeyBinding Key="Escape" Command="{Binding ClearSearch}" />
								</TextBox.InputBindings>
							</TextBox>
							<Grid.Style>
								<Style>
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsInSearchMode, IsAsync=True}" Value="True">
											<Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=QuickSearch}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>
						</Grid>
						<UI:MultilingualTextLabel Opacity="0.5" MultilingualText="{Binding SearchHeaderHint}" Content="{Binding SearchHeaderHint}" />
					</StackPanel>
					<ScrollViewer
						CanContentScroll="True"
						HorizontalScrollBarVisibility="Hidden"
						VerticalScrollBarVisibility="Auto"
						Margin="2"
						Focusable="False">
						<ItemsControl
							Focusable="False"
							ItemTemplate="{StaticResource SearchResultSection}"
							ItemsSource="{Binding SearchViewModel.SearchResults, IsAsync=True}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
				<Border
					Visibility="{Binding SelectedItem.ShowSearch, ElementName=SelectedMode, Converter={StaticResource BooleanToVisibilityConverter}}"
					Grid.Column="1"
					VerticalAlignment="Top"
					Margin="0 3 17 0">
					<Button
						ToolTip="{Binding SearchHint}"
						Style="{StaticResource ImageButton}"
						Click="Search_Click" >
						<Grid>
							<Image
								Style="{StaticResource ImageForButton}"
								Visibility="{Binding IsInSearchMode, IsAsync=True, Converter={StaticResource NotBooleanToVisibilityConverter}, FallbackValue=Collapsed}"
								Source="Images/search.png">
							</Image>
							<Image
								Style="{StaticResource ImageForButton}"
								Visibility="{Binding IsInSearchMode, IsAsync=True, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
								Source="Images/close.png">
							</Image>
						</Grid>
					</Button>
				</Border>
			</Grid>
		</DockPanel>
	</Grid>
</UserControl>
