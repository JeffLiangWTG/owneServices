<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <TransformXamlResourceStrings>true</TransformXamlResourceStrings>
  </PropertyGroup>
  <!-- This PropertyGroup with false condition is to make TransformXamlResourceStrings work -->
  <PropertyGroup Condition="'true' == 'false'">
    <OutputPath>..\..\..\..\bin\</OutputPath>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.EntityFramework" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="CargoWise.Main.Navigation" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Favorites" />
    <Reference Include="Enterprise.ZArchitecture.Modules" />
    <Reference Include="Moq" />
    <Reference Include="Microsoft.Xaml.Behaviors" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\favorite-unselected.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\favorite-selected.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\search.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\close.png" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>