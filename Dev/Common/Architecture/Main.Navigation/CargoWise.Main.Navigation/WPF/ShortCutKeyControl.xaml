<UserControl x:Class="CargoWise.Main.Navigation.WPF.ShortcutKeyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CargoWise.Main.Navigation.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
	<UserControl.Resources>
		<Style TargetType="TextBlock" x:Key="DefaultShortCutKeyStyle">
			<Setter Property="Padding" Value="3 0" />
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Foreground" Value="#FF8D8C88" />
			<Setter Property="Background" Value="#FFF7F7F4" />
		</Style>
	</UserControl.Resources>
	<Grid>
		<ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:ShortcutKeyControl}, Path=Keys}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel IsItemsHost="True" Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Margin="0 0 5 0" Padding="1" BorderThickness="1" CornerRadius="2" Background="{Binding RelativeSource={RelativeSource AncestorType=local:ShortcutKeyControl}, Path=TextBorderBrush}">
						<local:MultilingualTextLabel IsTranslatable="False" HorizontalAlignment="Right">
							<TextBlock Text="{Binding}" Style="{Binding RelativeSource={RelativeSource AncestorType=local:ShortcutKeyControl}, Path=ShortCutKeyStyle}"/>
						</local:MultilingualTextLabel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</UserControl>
