@using CargoWiseNext.Blazor.Components
@namespace CargoWise.Main.Navigation.Pages

<div tabindex="0" class="cwn-headnav" @ref="ElementReference">
    <CwnButtonGroup Variant="@Variant.Text">
        @if (Service?.MainMenuCategories is not null)
        {
            @foreach (var category in Service.MainMenuCategories)
            {
                <CwnButton data-tooltip="@GetButtonShortcut(category)"
                           Class="@GetClassName(category)"
                           OnMouseDown="() => HandleCategoryButtonMouseDown(category)">@category.DisplayName</CwnButton>
            }
        }
    </CwnButtonGroup>
	<MainNav IsVisible="@isMainNavVisible" OnBlur="HandleFocusOut" OnVisibleCallback="SetMainNavVisible"/>
</div>
