@using CargoWiseNext.Blazor.Components

@namespace CargoWise.Main.Navigation.Pages

<div class="cwn-home__login-details">
    @if(MainPageModelService?.SessionContextViewModel?.UserImage is not null)
    {
        <CwnAvatar Size="Size.Medium">
            <CwnImage Src="@UserImageBase64String()" ObjectFit="ObjectFit.Cover" Height="20" />
        </CwnAvatar>
    }
    <CwnText Typo="ElementType.subtitle1">@MainPageModelService?.SessionContextViewModel?.UserName</CwnText>
    <CwnDivider Vertical="true" />
    <CwnText Typo="ElementType.subtitle1">
        <strong>Branch</strong> @MainPageModelService?.SessionContextViewModel?.Branch
    </CwnText>
    <CwnDivider Vertical="true" />
    <CwnText Typo="ElementType.subtitle1">
        <strong>Company</strong> @MainPageModelService?.SessionContextViewModel?.Company
    </CwnText>
    <CwnDivider Vertical="true" />
    <CwnText Typo="ElementType.subtitle1">
        <strong>Department</strong> @MainPageModelService?.SessionContextViewModel?.Department
    </CwnText>
</div>
