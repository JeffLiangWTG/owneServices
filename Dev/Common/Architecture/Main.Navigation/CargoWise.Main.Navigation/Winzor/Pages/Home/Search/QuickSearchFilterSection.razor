@using CargoWise.Main.Navigation.ViewModels;

@namespace CargoWise.Main.Navigation.Pages

@code {
    [Parameter]
    public SearchViewModel SearchViewModel { get; set; } = new SearchViewModel();
}

<section class="cwn-quick-search-filter__button-container">
    @foreach (var filter in SearchViewModel.Filters)
    {
        <QuickSearchFilterButton SearchFilter="@filter" />
    }
</section>

