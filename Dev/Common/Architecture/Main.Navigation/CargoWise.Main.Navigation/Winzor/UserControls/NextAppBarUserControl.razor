@using CargoWise.Main.Navigation.Pages
@using CargoWiseNext.Blazor.Components

@inherits BaseUserControl;
@namespace CargoWise.Main.Navigation
<CascadingValue Value="this" Name="MainPageInvokeService">
<CascadingValue Value="QuickSearchService">
	<CascadingValue Value="NavBarToolStripService">
		<CascadingValue Value="MainMenuService">
			<CascadingValue Value="KeyboardService">
				<CwnLayout Theme="@Theme" Class="cwn-layout--nobg">
					<CwnNavBar Class="cwn-navbar">
						<NextAppBar NavigationViewModel="this.NavigationViewModel" />
					</CwnNavBar>
				</CwnLayout>
			</CascadingValue>
		</CascadingValue>
	</CascadingValue>
</CascadingValue>
</CascadingValue>
