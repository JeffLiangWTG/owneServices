<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Enterprise.Dat.Adapter.Strong</AssemblyName>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Dat.Implementation</RootNamespace>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationManager.Common" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Dat.Integration" />
    <Reference Include="Enterprise.DbUpgrader.Startup" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="Microsoft.Management.Infrastructure" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
</Project>