<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Dat.Implementation</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <SuppressObsoleteWarnings>SYSLIB0014</SuppressObsoleteWarnings>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <ProjectReference Include="..\Enterprise.Dat.Adapter.Strong\Enterprise.Dat.Adapter.Strong.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BuildTools" />
    <Reference Include="CargoWise.ApplicationManager.Common" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Data.Shared" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.DataProtection" />
    <Reference Include="CargoWise.DataProtection.TestFramework" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.Main" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.Windows.UI" />
    <Reference Include="CargoWise.WindowsDesktop">
      <HintPath>..\..\..\..\Bin\CargoWise.WindowsDesktop.exe</HintPath>
    </Reference>
    <Reference Include="Dat.Integration" />
    <Reference Include="Enterprise.Initialisation" />
    <Reference Include="Enterprise.Main.DiagnosticsAndTesting" />
    <Reference Include="Enterprise.ResourceStrings.Business" />
    <Reference Include="Enterprise.ResourceStrings.Maintenance.Test" />
    <Reference Include="Enterprise.Upgrades" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.Core.Test" />
    <Reference Include="Microsoft.AnalysisServices" />
    <Reference Include="Microsoft.AnalysisServices.Core" />
    <Reference Include="NUnitCore" />
    <Reference Include="System.Reflection.MetadataLoadContext" />
    <Reference Include="WTG.DevTools.Definitions" />
    <Reference Include="WTG.DevTools.Common" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Design" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.Http.WebRequest" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
</Project>