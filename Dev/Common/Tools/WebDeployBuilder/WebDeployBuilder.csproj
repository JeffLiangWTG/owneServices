<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(CWNetCoreTargetFramework)</TargetFramework>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <OutputType>Exe</OutputType>
    <OutputPath>..\..\..\Bin\</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="Enterprise.ZArchitecture.Core">
      <HintPath>..\..\..\Bin\Enterprise.ZArchitecture.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="App.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\Enterprise\Product\Main\Enterprise.Main\App.config">
      <Link>App.config</Link>
    </None>
  </ItemGroup>
</Project>