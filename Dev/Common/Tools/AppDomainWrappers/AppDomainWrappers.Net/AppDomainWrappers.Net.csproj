<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>AppDomainWrappers.Net</RootNamespace>
    <AssemblyName>AppDomainWrappers.Net</AssemblyName>
    <OutputPath>..\..\..\..\Bin\</OutputPath>
    <NoWarn>$(NoWarn);SA1000;CW1078;CW1157</NoWarn>
    <SuppressObsoleteWarnings>SYSLIB0024;SYSLIB0051;SYSLIB0023</SuppressObsoleteWarnings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Text.Json">
      <HintPath>..\..\..\..\bin\System.Text.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>