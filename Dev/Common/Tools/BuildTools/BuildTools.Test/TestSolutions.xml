<Build>
  <!-- Add solutions in the order in which they are to be built -->
  <Solutions>
    <Solution Sniff="false" Filename="NUnit\NUnit.sln" BuildEngine="VSAutomation" />
    <Solution Filename="BuildTools\BuildTools.sln" BuildEngine="DevEnv">
      <Bin DeployToClients="false">BuildTools.dll</Bin>
      <Bin UnitTest="false">DummyNoTest.dll</Bin>
    </Solution>
    <Solution Filename="Resources\Resources_FromSolutionsXml.sln" BuildEngine="MSBuild">
      <Bin>Resources.dll</Bin>
    </Solution>
    <Solution Filename="VirtualChannels\VirtualChannels.sln">
      <!-- The client DLLs are deployed as part of the thin-client setup, not part of Enterprise. -->
      <Bin DeployToClients="false" SignWithAuthenticode="true">Enterprise.VirtualChannels.CitrixClient.dll</Bin>
      <Bin DeployToClients="false" CanExistInGAC="true">Enterprise.VirtualChannels.Client.dll</Bin>
      <Bin>Enterprise.VirtualChannels.Server.dll</Bin>
    </Solution>
    <Solution Filename="RemotePrinting\Engine\RemotePrinting.Engine.sln">
      <Bin CanExistInGAC="true">RemotePrinting.Engine.dll</Bin>
      <Bin SignWithAuthenticode="false">RemotePrinting.Types.dll</Bin>
    </Solution>
    <Solution Filename="DbUpgrader\Resource\DbUpgrader.Resource.sln">
      <Bin>Enterprise.DbUpgrader.Resource.dll</Bin>
      <Bin>Enterprise.DbUpgrader.Resource.Version.dll</Bin>
    </Solution>
    <Solution Filename="BuildTools\MyCheckOuts\MyCheckOuts.sln" Sniff="false">
      <Bin UnitTest="false">MyCheckOuts.exe</Bin>
    </Solution>
    <Solution Filename="BusinessObjectGenerator\BusinessObjectGenerator.sln" Sniff="false">
      <Bin DeployToClients="false">BusinessObjectGenerator.dll</Bin>
    </Solution>
    <Solution Filename="Clients\WOW\ZClientWOW\ZClientWOW.sln">
      <Bin>ZClientWOW.dll</Bin>
    </Solution>
    <Solution Filename="Clients\ROH\ZClientROH\ZClientROH.sln" BuildWithVSAutomation="true">
      <Bin>ZClientROH.dll</Bin>
    </Solution>
    <Solution Filename="Clients\EDI\ZClientWebEDI\ZClientWebEDI.sln">
      <Bin>ZClientWebEDI.dll</Bin>
    </Solution>
    <Solution Filename="Tracking\Tracking.sln">
      <Bin>Enterprise.Tracking.Business.dll</Bin>
      <Bin>Enterprise.Tracking.Web.dll</Bin>
      <Bin>Enterprise.Tracking.Module.dll</Bin>
    </Solution>
  </Solutions>
</Build>