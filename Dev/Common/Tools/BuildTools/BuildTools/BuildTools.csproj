<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>CargoWise.BuildTools</RootNamespace>
    <CodeContractsAssemblyMode>1</CodeContractsAssemblyMode>
    <CodeContractsEnableRuntimeChecking>False</CodeContractsEnableRuntimeChecking>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
    <ApplicationManifest>$(WTGBranchRoot)main.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="LibGit2Sharp" />
    <Reference Include="Microsoft.Build.Locator" />
    <Reference Include="Microsoft.Practices.EnterpriseLibrary.TransientFaultHandling" />
    <Reference Include="Mono.Cecil" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="WTG.DevTools.Definitions" />
    <Reference Include="WTG.DevTools.SourceControl" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="WTG.TestHelpers" Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CurrentDatDbBackupPrefix.txt" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\Accounting\Data\Properties\AssemblyInfo.cs" />
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject1\AssemblyInfo.cs" />
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject1\Form1.cs" />
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject2\AssemblyInfo.cs" />
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject2\Form2.cs" />
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject2\TestFile2.cs" />
    <Compile Remove="SourceControl\Testing\MockSourceControlFiles\DataTools\DataPurge\DataPurge\ScriptRepository.cs" />
    <EmbeddedResource Remove="SourceControl\Testing\MockSourceControlFiles\Builder\Scripts\Scripts\AutoGenerated\Schema.resx" />
    <EmbeddedResource Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject1\Form1.resx" />
    <EmbeddedResource Remove="SourceControl\Testing\MockSourceControlFiles\BuildTools\SourceSafeTestSolution\SourceSafeTestProject2\Form2.resx" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\main.manifest" Link="main.manifest" />
  </ItemGroup>
</Project>