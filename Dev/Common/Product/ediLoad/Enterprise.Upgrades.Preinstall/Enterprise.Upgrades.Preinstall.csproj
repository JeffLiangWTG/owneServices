<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <RootNamespace>Enterprise.Upgrades.Preinstall</RootNamespace>
    <AssemblyName>Enterprise.Upgrades.Preinstall</AssemblyName>
    <ApplicationManifest>..\..\..\..\main.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <PropertyGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
    <None Include="..\Enterprise.Upgrades.Postinstall\app.config" Link="app.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CargoWise.Loader.Client\CargoWise.Loader.Client.csproj" />
    <ProjectReference Include="..\CargoWise.Loader.Common\CargoWise.Loader.Common.csproj" />
  </ItemGroup>
</Project>