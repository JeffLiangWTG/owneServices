<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CargoWise.NGenInstallerProgram</RootNamespace>
    <ApplicationManifest>..\..\..\..\main.manifest</ApplicationManifest>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <PropertyGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Enterprise.Upgrades" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" />
    <Reference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <Reference Include="WTG.ApplicationLogging.Abstractions" />
    <Reference Include="WTG.ApplicationLogging" />
    <Reference Include="System.Text.Json" />
    <Reference Include="System.Buffers" />
    <Reference Include="System.Diagnostics.DiagnosticSource" />
    <Reference Include="System.Numerics.Vectors" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
    <None Include="..\..\..\..\Enterprise\Product\Main\Enterprise.Main\CargoWiseOneProjects\applog.json">
      <Link>applog.json</Link>
    </None>
  </ItemGroup>
</Project>