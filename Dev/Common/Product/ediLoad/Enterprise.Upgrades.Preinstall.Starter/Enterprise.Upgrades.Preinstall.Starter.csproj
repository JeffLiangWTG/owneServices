<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <RootNamespace>Enterprise.Upgrades.Preinstall.Starter</RootNamespace>
    <AssemblyName>Enterprise.Upgrades.Preinstall4.0</AssemblyName>
    <BranchDisableCodeContractsOverride>True</BranchDisableCodeContractsOverride>
    <ApplicationManifest>..\..\..\..\main.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <None Include="..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="Enterprise.Upgrades" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
</Project>