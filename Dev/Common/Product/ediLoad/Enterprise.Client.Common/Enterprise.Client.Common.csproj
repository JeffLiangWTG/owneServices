<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <IsSelfContainedWithILMergeAndReferencesAreCurated>true</IsSelfContainedWithILMergeAndReferencesAreCurated>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ActiveDirectory" />
    <Reference Include="CargoWise.ApplicationManager.Common" />
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Enterprise.Upgrades" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CargoWise.Loader.Common\CargoWise.Loader.Common.csproj" />
  </ItemGroup>
</Project>