<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>CargoWise.Loader.Common.Testing</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AppDomainWrappers.Net" />
    <Reference Include="CargoWise.ActiveDirectory" />
    <Reference Include="CargoWise.ApplicationManager.Common" />
    <Reference Include="CargoWise.BrandManager" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Enterprise.URLHandler.Integration" />
    <Reference Include="WTG.Authenticode" />
    <Reference Include="Moq" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="NUnitCore" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <ProjectReference Include="..\CargoWise.Loader.Common\CargoWise.Loader.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\Bin\Enterprise.URLHandler.Integration.dll">
      <Link>Resources\Enterprise.URLHandler.Integration.dll</Link>
      <LogicalName>CargoWise.Loader.Common.Resources.Enterprise.URLHandler.Integration.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreWindowsTargetFramework)' == 'true'">
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
</Project>