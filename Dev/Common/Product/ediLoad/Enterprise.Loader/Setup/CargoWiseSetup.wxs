<?xml version="1.0" encoding="utf-8" ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="457C9E9F-A54B-445A-88FE-CB0E8505D0D0"
					 Language="1033"
					 Manufacturer="WiseTech Global"
					 Name="CargoWise Client"
					 UpgradeCode="88593FA5-7427-4991-99A6-2696DC73605C"
					 Version="14.0.0">
		<Package Compressed="yes" InstallerVersion="300" Platform="x64" />
		<Media Id="1" Cabinet="CargoWiseSetup.cab" EmbedCab="yes" />

		<Property Id="ALLUSERS" Value="1" />

		<Property Id="ARPPRODUCTICON" Value="ApplicationIcon.ico" />
		<Icon Id="ApplicationIcon.ico" SourceFile="..\..\..\..\..\Resources\ApplicationIcon.ico"/>

		<PropertyRef Id="NETFRAMEWORK45" />
		<Condition Message="This application requires .NET Framework 4.5.1. Please install the .NET Framework then run this installer again.">
			NETFRAMEWORK45 >= "#378675"
		</Condition>
		<Condition Message="You must be an administrator on this computer to install or uninstall [ProductName].">Privileged</Condition>

		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFiles64Folder">
				<Directory Id="CompanyProgramFilesFolder" Name="WiseTech Global">
					<Directory Id="ProductProgramFilesFolder" Name="CargoWise">
						<Component Id="CargoWiseStartComponent" Guid="9369E76D-643E-4DCF-8B29-279587DD7D7B" NeverOverwrite="yes" Win64="yes" >
							<File Id="CargoWiseStartFile" KeyPath="yes" Name="CargoWise.Start.exe" Source="..\..\..\..\..\Bin\CargoWise.Start.exe" ProcessorArchitecture="x64" />
							<File Id="CargoWiseStartConfigFile" Name="CargoWise.Start.exe.config" Source="..\..\..\..\..\Bin\CargoWise.Start.exe.config" ProcessorArchitecture="x64" />
							<File Id="ApplicationLoggingConfigFile" Name="applog.json" Source="..\..\..\..\..\Enterprise\Product\Main\Enterprise.Main\CargoWiseOneProjects\applog.json" ProcessorArchitecture="x64" />
						</Component>
						<Component Id="ClientInstalledRegistry" Win64="yes" >
							<RegistryValue Id="InstalledRegistryValue"
									 Key="SOFTWARE\WiseTech Global\CargoWise"
									 Name="ClientInstalled"
									 Root="HKLM"
									 Type="integer"
									 Value="1" />
						</Component>
					</Directory>
				</Directory>
			</Directory>
		</Directory>

		<Feature Id="ProductFeature" Level="1">
			<ComponentRef Id="CargoWiseStartComponent" />
			<ComponentRef Id="ClientInstalledRegistry" />
		</Feature>

		<CustomAction Id="RunCargoWiseStart" Directory="ProductProgramFilesFolder" ExeCommand="[ProductProgramFilesFolder]\CargoWise.Start.exe -install" Execute="deferred" Impersonate="no" Return="ignore" />
		<CustomAction Id="UnsintallCargoWise" Directory="ProductProgramFilesFolder" ExeCommand="[ProductProgramFilesFolder]\CargoWise.Start.exe -uninstall" Execute="deferred" Impersonate="no" />

		<InstallExecuteSequence>
			<Custom Action="RunCargoWiseStart" Before="InstallFinalize">(Not Installed OR REINSTALL) AND (INSTALLUILEVEL > INSTALLUILEVEL_NONE)</Custom>
			<Custom Action="UnsintallCargoWise" After="InstallInitialize">REMOVE~="ALL"</Custom>
		</InstallExecuteSequence>
	</Product>
</Wix>
