<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:CargoWise.NetworkVisualisation.GUI">

	<ResourceDictionary.MergedDictionaries>
		<!--  Merge in the resource dictionary that is shared between the main window and the overview window.  -->
		<ResourceDictionary Source="../../SharedVisualTemplates.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<DataTemplate x:Key="leafNodeDataTemplate">
		<!--  Display of leaf nodes  -->
		<Grid VerticalAlignment="Stretch">

			<Grid.RowDefinitions>
				<RowDefinition Height="auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="auto" />
			</Grid.ColumnDefinitions>
			
			<Border
				Grid.Row="0"
				Grid.Column="0"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="1,1,0,0"
				SnapsToDevicePixels="True"
				Visibility="{Binding Path=ShowJobBar,
							 Converter={StaticResource booleanToVisibilityConverter}}">
			
				<Label
					Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
					Grid.Row="0"
					Grid.Column="0"
					Content="{Binding Path=JobNumberReadableText}"
					ToolTip="{Binding JobNumberTooltip}" />
			</Border>

			<Border
				Grid.Row="0"
				Grid.Column="1"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="1,1,1,0"
				SnapsToDevicePixels="True"
				Visibility="{Binding Path=ShowJobBarAffinities,
							 Converter={StaticResource booleanToVisibilityConverter}}">
				<Label
					Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
					Grid.Row="0"
					Grid.Column="1"
					Content="{Binding AppliedAttributesReadableText}"
					ToolTip="{Binding AppliedAttributesTooltip}" />
			</Border>

			<Border
				Grid.Row="0"
				Grid.Column="2"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="0,1,1,0"
				SnapsToDevicePixels="True"
				Visibility="{Binding Path=ShowJobBar,
							 Converter={StaticResource booleanToVisibilityConverter}}">
				<Label
					Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
					Grid.Row="0"
					Grid.Column="2"
					Content="{Binding Path=DurationReadableText}"
					ToolTip="{Binding Path=DurationTooltip}" />
			</Border>

			<Border
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="1,1,1,1"
				SnapsToDevicePixels="True">
				<StackPanel
					Grid.Row="0"
					Grid.Column="0">
					<local:EntityDetails
						Grid.Row="1"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						HeadingFontSize="14"
						HeadingFontWeight="{Binding StatusTextWeight}"
						ShowJobDetails="{Binding Path=HasLinkedEntity}"
						TextAlignment="{Binding Path=TextAlignment}" />

					<!--  The description of the node.  -->
					<TextBlock
						Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
						MinWidth="100"
						Margin="6 0 6 0"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Background="Transparent"
						FontSize="13"
						Text="{Binding Description}"
						TextAlignment="Center" />

					<local:TextBoxWithPlaceholder
						Grid.Column="1"
						MinWidth="100"
						FontSize="{Binding NotesFontSize,
									RelativeSource={RelativeSource Mode=FindAncestor,
									AncestorType={x:Type UserControl}}}"
						PlaceholderText="{Binding NotesPlaceholder}"
						Margin="0 0 0 0"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						AcceptsReturn="True"
						Background="Transparent"
						BorderThickness="0"
						Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
						Padding="10 0 10 10"
						Text="{Binding Notes}"
						TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<Border
				Grid.Row="2"
				Grid.Column="0"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="1,0,0,1"
				SnapsToDevicePixels="True"
				Visibility="{Binding ShowScheduleDetails,
										 Converter={StaticResource booleanToVisibilityConverter}}">
				<Label
					Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
					Grid.Row="2"
					Grid.Column="0"
					Content="{Binding Path=StartDateReadableText}"
					ToolTip="{Binding Path=StartDateToolTip}" />
			</Border>

			<Border
				Grid.Row="2"
				Grid.Column="1"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="1,0,0,1"
				SnapsToDevicePixels="True"
				Visibility="{Binding ShowScheduleDetails,
										 Converter={StaticResource booleanToVisibilityConverter}}">
				<Label
					Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
					Grid.Row="2"
					Grid.Column="1"
					Content="{Binding Path=RemainingDurationReadableText}"
					ToolTip="{Binding Path=RemainingDurationToolTip}" />
			</Border>

			<Border
				Grid.Row="2"
				Grid.Column="2"
				Background="Transparent"
				BorderBrush="Black"
				BorderThickness="1,0,1,1"
				SnapsToDevicePixels="True"
				Visibility="{Binding ShowScheduleDetails,
										 Converter={StaticResource booleanToVisibilityConverter}}">
				<Label
					Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
					Grid.Row="2"
					Grid.Column="2"
					Content="{Binding Path=FinishDateReadableText}"
					ToolTip="{Binding Path=FinishDateToolTip}" />
			</Border>
		</Grid>
	</DataTemplate>

</ResourceDictionary>
