<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:CargoWise.NetworkVisualisation.GUI">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../../SharedVisualTemplates.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<DataTemplate x:Key="annotationNodeDataTemplate">
		<StackPanel
			Grid.Row="0"
			Grid.RowSpan="4"
			Grid.Column="1"
			Grid.ColumnSpan="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Orientation="Vertical">

			<local:EntityDetails
				HeadingFontSize="14"
				HeadingFontWeight="{Binding StatusTextWeight}"
				ShowJobDetails="{Binding Path=Entity.CanHaveChildren}"
				TextAlignment="{Binding Path=TextAlignment}" />

			<local:TextBoxWithPlaceholder
				Grid.Column="1"
				MinWidth="100"
				FontSize="{Binding NotesFontSize,
							RelativeSource={RelativeSource Mode=FindAncestor,
							AncestorType={x:Type UserControl}}}"
				PlaceholderText="{Binding NotesPlaceholder}"
				Margin="0 0 0 0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				AcceptsReturn="True"
				Background="Transparent"
				BorderThickness="0"
				Foreground="{Binding ForegroundColor, Converter={StaticResource colorToBrushConverter}}"
				Padding="10 0 10 10"
				Text="{Binding Notes}"
				TextWrapping="Wrap" />

		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
