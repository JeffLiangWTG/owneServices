<UserControl
	x:Class="CargoWise.NetworkVisualisation.GUI.DiagramAreaUserControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:networkModel="clr-namespace:CargoWise.NetworkVisualisation.Business;assembly=CargoWise.NetworkVisualisation.Business"
	xmlns:local="clr-namespace:CargoWise.NetworkVisualisation.GUI"
	Width="Auto"
	Height="Auto"
	MinWidth="300"
	MinHeight="150"
	FocusManager.FocusedElement="{Binding ElementName=NetworkControl}"
	ContextMenuOpening="OpenRootMenu_Executed"
	ContextMenuClosing="CloseMenu_Executed"
	Tag="{Binding DataContext,
                           RelativeSource={RelativeSource Mode=Self}}">

	<!--
		Including this in binding statements for diagnostics:
		diagnostics:PresentationTraceSources.TraceLevel=High
	-->

	<UserControl.Resources>

		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!--  Merge in the resource dictionary that is shared between the main window and the overview window.  -->
				<!--  <ResourceDictionary Source="SharedVisualTemplates.xaml"	/>  -->
				<ResourceDictionary Source="../DataTemplates/EntityDataTemplates.xaml" />
				<ResourceDictionary Source="/CargoWise.Main.Navigation;component/WPF/MultilingualTextLabelResources.xaml" />

			</ResourceDictionary.MergedDictionaries>

			<!--  UI commands.  -->

			<RoutedUICommand x:Key="Commands.DeleteSelectedNodes" />
			<RoutedUICommand x:Key="Commands.DefaultDeleteOperation" />
			<RoutedUICommand x:Key="Commands.DeleteConnection" />
            <RoutedUICommand x:Key="Commands.HideConnection" />
            <RoutedUICommand x:Key="Commands.PerformGenericAction" />

			<local:ColorToBrushConverter x:Key="ColorToBrushConverter" />

            <local:NodeSourceConverter x:Key="NodeSourceConverter" />

            <local:CanResizeVisibilityConverter x:Key="CanResizeVisibilityConverter" />

			<local:ArrowAppearanceToDashesConverter x:Key="ArrowAppearanceToDashesConverter" />

			<local:LocationToPointConverter x:Key="LocationToPointConverter" />

			<local:LocationsToPointCollectionConverter x:Key="LocationsToPointCollectionConverter" />

			<local:EntityTemplateSelector
				x:Key="EntityTemplateSelector"
				LinkedEntityTemplate="{StaticResource LinkedEntityDataTemplate}"
				NonLinkedEntityTemplate="{StaticResource NonLinkedEntityDataTemplate}" />

			<!--  This graphic is used to indicate that a connection cannot be made between two particular connectors.  -->
			<DataTemplate DataType="{x:Type local:ConnectionBadIndicator}">
				<Grid Width="80">
					<Image
						Width="32"
						Height="32"
						HorizontalAlignment="Right"
						Source="../Resources/block_16.png" />
				</Grid>
			</DataTemplate>

			<!--  This graphic is used to indicate that a connection can be made between two particular connectors.  -->
			<DataTemplate DataType="{x:Type local:ConnectionOkIndicator}">
				<Grid Width="80">
					<Image
						Width="32"
						Height="32"
						HorizontalAlignment="Right"
						Source="../Resources/tick_16.png" />
				</Grid>
			</DataTemplate>

			<!--  Define the visual style for a 'ConnectorItem'.  -->
			<Style TargetType="{x:Type local:ConnectorItem}">
				<!--
					Data-binding for the connector hotspot.
					ConnectorItem automatically computes its center points and assings this value
					to the 'Hotspot' property.  This data-binding then 'pushes' the value into the application
					view-model.
				-->
				<Setter Property="Hotspot" Value="{Binding Hotspot, Mode=OneWayToSource, Converter={StaticResource LocationToPointConverter}}" />

				<!--  The visual template.  -->
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type local:ConnectorItem}">
							<!--  The visual for the connector.  -->
							<Ellipse
								Fill="{StaticResource connectorBackgroundBrush}"
								Stroke="{StaticResource nodeBorderBrush}" />
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--  Template used to insert a separator into a menu item tree.  -->
			<ControlTemplate x:Key="MenuSeparatorTemplate">
				<Separator />
			</ControlTemplate>

			<!--  The style for Network Actions menu items of entities  -->
			<Style
				x:Key="ActionsMenuItem"
				TargetType="{x:Type MenuItem}">
				<Setter Property="Header" Value ="{Binding Path=Name, Mode=OneWay}" />
				<Setter Property="ToolTip" Value ="{Binding Path=Tooltip, Mode=OneWay}" />
				<Setter Property="ToolTipService.ShowOnDisabled" Value = "true" />
				<Setter Property="IsEnabled" Value ="{Binding Path=Enabled, Mode=OneWay}" />
				<Setter Property="IsCheckable" Value ="{Binding Path=Ticked, Mode=OneWay}" />
				<Setter Property="IsChecked" Value ="{Binding Path=Ticked, Mode=OneWay}" />
				<Setter Property="Command" Value="{StaticResource Commands.PerformGenericAction}" />
				<Setter Property="CommandParameter" Value="{Binding}"/>
				<Setter Property="ItemsSource" Value ="{Binding Path=Items, Mode=OneWay}" />
				<Setter Property="ItemContainerStyle" Value="{DynamicResource ActionsMenuItem}" />
				<Style.Triggers>
					<DataTrigger
						Binding="{Binding }"
						Value="{x:Null}">
						<Setter Property="Template" Value="{StaticResource MenuSeparatorTemplate}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!--
				Template for the button that is used to delete nodes and connections in the graph.
				This button is displayed in an adorner when the user hovers the mouse over a node or connection.
			-->
			<ControlTemplate
				x:Key="deleteButtonTemplate"
				TargetType="{x:Type Button}">
				<Grid x:Name="grid">
					<Grid.RenderTransform>
						<ScaleTransform
							CenterX="10"
							CenterY="10"
							ScaleX="1"
							ScaleY="1" />
					</Grid.RenderTransform>
					<Ellipse
						x:Name="shadow"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Fill="Gray">
						<Ellipse.RenderTransform>
							<TranslateTransform X="1.5" Y="1.5" />
						</Ellipse.RenderTransform>
					</Ellipse>
					<Ellipse
						x:Name="ellipse"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Fill="White"
						Stroke="Black" />
					<Image
						Margin="2"
						Source="{Binding Path=DeleteImageSource}" 
						ToolTip="{Binding Path=DeleteTooltip}" />
				</Grid>
				<ControlTemplate.Triggers>
					<EventTrigger RoutedEvent="Mouse.MouseEnter">
						<!--
							Make the 'delete connection button' larger when the mouse
							cursor is hovered over it.
						-->
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Duration="0:0:0.25"
									Storyboard.TargetName="grid"
									Storyboard.TargetProperty="RenderTransform.ScaleX"
									To="1.3" />
								<DoubleAnimation
									Duration="0:0:0.25"
									Storyboard.TargetName="grid"
									Storyboard.TargetProperty="RenderTransform.ScaleY"
									To="1.3" />
							</Storyboard>
						</BeginStoryboard>
					</EventTrigger>

					<EventTrigger RoutedEvent="Mouse.MouseLeave">
						<!--
							Return the 'delete connection button' to normal size when the mouse
							cursor is moved away.
						-->
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimation
									Duration="0:0:0.05"
									Storyboard.TargetName="grid"
									Storyboard.TargetProperty="RenderTransform.ScaleX"
									To="1" />
								<DoubleAnimation
									Duration="0:0:0.05"
									Storyboard.TargetName="grid"
									Storyboard.TargetProperty="RenderTransform.ScaleY"
									To="1" />
							</Storyboard>
						</BeginStoryboard>
					</EventTrigger>
				</ControlTemplate.Triggers>

			</ControlTemplate>

            <ControlTemplate
				x:Key="ResizeDecoratorTemplateLeftTop"
				TargetType="Control">

                <local:ResizeThumb
					Width="7"
					Height="7"
					Margin="-6 -6 0 0"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					Cursor="SizeNWSE"
					PreviewMouseDown="ResizeThumb_MouseDown"
					PreviewMouseUp="ResizeThumb_MouseUp"
                    Visibility="{Binding Path=IsSelected, Converter={StaticResource booleanToVisibilityConverter}}"/>
            </ControlTemplate>

            <ControlTemplate
				x:Key="ResizeDecoratorTemplateRightTop"
				TargetType="Control">

                <local:ResizeThumb
					Width="7"
					Height="7"
					Margin="0 -6 -6 0"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Cursor="SizeNESW"
					PreviewMouseDown="ResizeThumb_MouseDown"
					PreviewMouseUp="ResizeThumb_MouseUp"
                    Visibility="{Binding Path=IsSelected, Converter={StaticResource booleanToVisibilityConverter}}"/>
            </ControlTemplate>

            <ControlTemplate
				x:Key="ResizeDecoratorTemplateLeftBottom"
				TargetType="Control">

                <local:ResizeThumb
					Width="7"
					Height="7"
					Margin="-6 0 0 -6"
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Cursor="SizeNESW"
					PreviewMouseDown="ResizeThumb_MouseDown"
					PreviewMouseUp="ResizeThumb_MouseUp"
                    Visibility="{Binding Path=IsSelected, Converter={StaticResource booleanToVisibilityConverter}}"/>
            </ControlTemplate>

            <ControlTemplate
				x:Key="ResizeDecoratorTemplateRightBottom"
				TargetType="Control">

                <local:ResizeThumb
					Width="7"
					Height="7"
					Margin="0 0 -6 -6"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Cursor="SizeNWSE"
					PreviewMouseDown="ResizeThumb_MouseDown"
					PreviewMouseUp="ResizeThumb_MouseUp"/>
            </ControlTemplate>

            <!--
				Data-template for ConectionViewModel.
				
				Note that the 'Start' and 'End' of the arrow are bound to 'SourceConnectorHotspot' and 'DestConnectorHotspot' in
				the view-model.
				
				In this sample a curved arrow represents connections between nodes.
			-->
			<DataTemplate DataType="{x:Type networkModel:ConnectionViewModel}">

				<!--
					An adorned control is used, to represent the connection.
					When the user hovers the mouse cursor over the connection, the
					'delete connection' adorner pops up and allows them to delete the connection.
				-->
				<local:AdornedControl
					Width="{Binding Path=Width}"
					Height="{Binding Path=Height}"
					HorizontalAdornerPlacement="Mouse"
					IsMouseOverShowEnabled="{Binding ElementName=NetworkControl, Path=IsNotDragging}"
					VerticalAdornerPlacement="Mouse"
					Visibility="{Binding Path=IsVisible, Converter={StaticResource booleanToVisibilityConverter}}">

					<!--  The connection is represented by a curved arrow.  -->
					<local:CurvedArrow
						Fill="{Binding Path=Relationship.BackColor,
					                                  FallbackValue=Black}"
						Points="{Binding Points, Converter={StaticResource LocationsToPointCollectionConverter}}"
						Stroke="{Binding Path=Relationship.BackColor,
					                                    FallbackValue=Black}"
						StrokeDashArray="{Binding Relationship.Appearance,
					                                             Converter={StaticResource ArrowAppearanceToDashesConverter}}"
						StrokeThickness="2"
						ToolTip="{Binding Path=Relationship.DisplayText}">
						<local:CurvedArrow.ContextMenu>
							<ContextMenu Visibility="{Binding Path=CanHide, Converter={StaticResource booleanToVisibilityConverter}}">
								<MenuItem
									Command="{StaticResource Commands.HideConnection}"
									CommandParameter="{Binding}"
									Header="Remove from Diagram"
									ToolTip="Removes this dependency from the diagram."
									Visibility="{Binding Path=CanHide, Converter={StaticResource booleanToVisibilityConverter}}" />
							</ContextMenu>
						</local:CurvedArrow.ContextMenu>
					</local:CurvedArrow>

					<local:AdornedControl.AdornerContent>

						<!--
							This is the adorner that pops up when the user hovers the mouse over the connection.
							It displays a button that the user can click to delete the connection.
						-->
						<Canvas
							x:Name="connectionAdornerCanvas"
							Width="30"
							Height="30"
							HorizontalAlignment="Right"
							VerticalAlignment="Top">
							<Line
								Stroke="Black"
								StrokeThickness="1"
								X1="0"
								X2="15"
								Y1="30"
								Y2="15" />
							<Button
								x:Name="deleteConnectionButton"
								Canvas.Left="10"
								Canvas.Top="0"
								Width="20"
								Height="20"
								Command="{StaticResource Commands.DeleteConnection}"
								CommandParameter="{Binding}"
								Cursor="Hand"
								Focusable="False"
								Template="{StaticResource deleteButtonTemplate}" />
						</Canvas>
					</local:AdornedControl.AdornerContent>
				</local:AdornedControl>
			</DataTemplate>

			<!--  Define a data-template for the 'NodeViewModel' class.  -->
			<DataTemplate DataType="{x:Type networkModel:NodeViewModel}">

				<!--
					An adorned control is used, to represent the node.
					When the user hovers the mouse cursor over the node, the
					'delete node' adorner pops up and allows them to delete the node.
				-->
				<local:AdornedControl
					Width="{Binding Path=Width}"
					Height="{Binding Path=Height}"
					MinWidth="{x:Static local:AdornedControl.MinAllowedNodeWidth}"
					MinHeight="{x:Static local:AdornedControl.MinAllowedNodeHeight}"
					AdornerOffsetX="-12"
					AdornerOffsetY="8"
					HorizontalAlignment ="Stretch"
					VerticalAlignment ="Stretch"
					HorizontalAdornerPlacement="Outside"
					IsMouseOverShowEnabled="{Binding ElementName=NetworkControl,
				                                                       Path=IsNotDragging}"
					VerticalAdornerPlacement="Outside"
					ContextMenuOpening="OpenMenu_Executed"
					ContextMenuClosing="CloseMenu_Executed"
				>

					<local:AdornedControl.ContextMenu>
						<ContextMenu
							ItemContainerStyle="{StaticResource ActionsMenuItem}"
							ItemsSource="{Binding MenuItems, Mode=OneWay}"
							Visibility="{Binding SupportsGenericActions,
							                              Converter={StaticResource booleanToVisibilityConverter}}"	
						>

						</ContextMenu>
					</local:AdornedControl.ContextMenu>

					<!--  The margin has been selected so that the selection rect nicely covers the entire node.  -->

					<Grid
						Margin="10,6,10,6"
						Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
						ToolTipOpening="ToolTip_RefreshBinding"
						ToolTip="{Binding Path=ToolTip, Mode=OneWay}">

                        <Control
							Template="{StaticResource ResizeDecoratorTemplateLeftTop}"
							Visibility="{Binding Path=Entity.EntityState,
						                              Converter={StaticResource CanResizeVisibilityConverter}}" />

                        <Control
							Template="{StaticResource ResizeDecoratorTemplateRightTop}"
							Visibility="{Binding Path=Entity.EntityState,
						                              Converter={StaticResource CanResizeVisibilityConverter}}" />

                        <Control
							Template="{StaticResource ResizeDecoratorTemplateLeftBottom}"
							Visibility="{Binding Path=Entity.EntityState,
						                              Converter={StaticResource CanResizeVisibilityConverter}}" />

                        <Control
							Template="{StaticResource ResizeDecoratorTemplateRightBottom}"
							Visibility="{Binding Path=Entity.EntityState,
						                              Converter={StaticResource CanResizeVisibilityConverter}}" />

                        <ContentControl
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch"
							Content="{Binding}"
							ContentTemplateSelector="{StaticResource EntityTemplateSelector}" />

					</Grid>

					<local:AdornedControl.AdornerContent>

						<!--
							This is the adorner that pops up when the user hovers the mouse over the node.
							It displays a button that the user can click to delete the node.
						-->
						<Canvas
							x:Name="nodeAdornerCanvas"
							Width="30"
							Height="30"
							HorizontalAlignment="Right"
							VerticalAlignment="Top">
							<Line
								Stroke="Black"
								StrokeThickness="1"
								X1="0"
								X2="15"
								Y1="30"
								Y2="15" />
							<Button
								x:Name="deleteNodeButton"
								Canvas.Left="10"
								Canvas.Top="0"
								Width="20"
								Height="20"
								Command="{StaticResource Commands.DefaultDeleteOperation}"
								CommandParameter="{Binding}"
								Cursor="Hand"
								Focusable="False"
								Template="{StaticResource deleteButtonTemplate}" />
						</Canvas>
					</local:AdornedControl.AdornerContent>
				</local:AdornedControl>
			</DataTemplate>
		</ResourceDictionary>

	</UserControl.Resources>

	<UserControl.InputBindings>

		<!--  Bind input to commands.  -->

        <KeyBinding
			Key="Delete"
			Command="{StaticResource Commands.DeleteSelectedNodes}" />

    </UserControl.InputBindings>

	<UserControl.CommandBindings>

		<!--  Bind commands to event handlers.  -->

		<CommandBinding
			Command="{StaticResource Commands.DeleteSelectedNodes}"
			Executed="DeleteSelectedNodes_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.DefaultDeleteOperation}"
			Executed="DefaultDeleteOperation_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.DeleteConnection}"
			Executed="DeleteConnection_Executed" />
        <CommandBinding
			Command="{StaticResource Commands.HideConnection}"
			Executed="HideConnection_Executed" />
        <CommandBinding
			Command="{StaticResource Commands.PerformGenericAction}"
			Executed="PerformGenericAction_Executed" />
		<CommandBinding
			Command="ApplicationCommands.Paste"
			Executed="PasteExecuted" />

	</UserControl.CommandBindings>

	<UserControl.ContextMenu>
		<ContextMenu
			ItemContainerStyle="{StaticResource ActionsMenuItem}"
			ItemsSource="{Binding NetworkControlViewModel.MenuItems, Mode=OneWay}" >
		</ContextMenu>
	</UserControl.ContextMenu>

	<UserControl.DataContext>
        <local:DiagramAreaUserControlViewModel />
	</UserControl.DataContext>

	<DockPanel KeyDown="DockPanel_KeyDown">

		<!--
			The ScrollViewer displays scrollbars when the content is too big to fit in the viewport.
			Focusable is set to False because it is only that NetworkView that I want to be focusable.
			
			This is the main designer surface area.
		-->
		<ScrollViewer
			x:Name="ScrollViewer"
			Width="Auto"
			Height="Auto"
			CanContentScroll="True"
			Focusable="False"
			HorizontalScrollBarVisibility="Visible"
			VerticalScrollBarVisibility="Visible">

			<!--
				The ZoomAndPanControl displays the NetworkView as its content.
				We can use the mouse to zoom and pan about the NetworkView.
			-->
			<local:ZoomAndPanControl
				x:Name="ZoomAndPanControl"
				Background="White"
				ContentOffsetX="{Binding ContentOffsetX, Mode=TwoWay}"
				ContentOffsetY="{Binding NetworkControlViewModel.ContentOffsetY, Mode=TwoWay}"
				ContentScale="{Binding NetworkControlViewModel.ContentScale, Mode=TwoWay}"
				ContentViewportHeight="{Binding ContentViewportHeight, Mode=OneWayToSource}"
				ContentViewportWidth="{Binding ContentViewportWidth, Mode=OneWayToSource}"
				Focusable="False"
				IsEnabled="{Binding NetworkControlViewModel.NetworkModel.IsReadOnly, Converter={StaticResource booleanInverterConverter}}"
				MouseDown="NetworkControl_MouseDown"
				MouseDoubleClick="NetworkControl_MouseDoubleClick"
				MouseMove="NetworkControl_MouseMove"
				MouseUp="NetworkControl_MouseUp"
				MouseWheel="NetworkControl_MouseWheel">
				<!--
					We need to nest our NetworkView in an AdornerDecorator so that adorners work correct when
					we zoom in and out using the ZoomAndPanControl
				-->
				<AdornerDecorator>
					<!--
						This grid specifies the size of the ZoomAndPanControl's content.
						It wraps up both the NetworkView and drag-zooming Canvas.
					-->
					<Grid
						Width="{Binding ContentWidth}"
						Height="{Binding ContentHeight}"
						Margin="5">

						<Rectangle
							Fill="{Binding NetworkControlViewModel.DiagramBackgroundColor,
						                          Converter={StaticResource ColorToBrushConverter}}"
							RadiusX="20"
							RadiusY="20"
							Stroke="Black"
							StrokeThickness="2"
						    Width="{Binding ContentWidth}"
						    Height="{Binding ContentHeight}"
							Visibility="{Binding NetworkControlViewModel.SupportsDiagramVisualStyles,
						                                Converter={StaticResource booleanToVisibilityConverter}}" />

						<StackPanel Orientation="Vertical">

						    <local:EntityDetails
						        Margin="20 10 0 10"
						        DataContext="{Binding NetworkControlViewModel.DiagramEntityViewModel}"
						        SizeChanged="EntityDetails_SizeChanged"
						        IsNonScheduled="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:DiagramAreaUserControl}}, Path=IsNonScheduled}"
						        Visibility="{Binding SupportsDiagramVisualStyles,
																		  Converter={StaticResource booleanToVisibilityConverter}}" />

						    <Line
						        Name="HeaderLine"
						        Stroke="Black" 
						        StrokeThickness="2" 
						        X1="0" 
						        X2="1" 
						        Stretch="Fill"
						        Visibility="{Binding NetworkControlViewModel.SupportsDiagramVisualStyles,
																		  Converter={StaticResource booleanToVisibilityConverter}}" />

                            <Grid>

								<local:DynamicGrid
									x:Name="ScaleGrid"
									Width="{Binding ContentWidth}"
									Height="{Binding ContentHeight}"
									Margin="1"
									ScaleDescriptor="{Binding NetworkControlViewModel.ScaleDescriptor}"
									Visibility="{Binding NetworkControlViewModel.DiagramEntity.IsDiagramScaled,
																	Converter={StaticResource booleanToVisibilityConverter}}"
                                    />

								<StackPanel
									Name="ContentStackPanel">

									<Canvas
										x:Name="FillerCanvas"
										Margin="40 20 0 0"
										Visibility="{Binding NetworkControlViewModel.RequiresProp,
																		  Converter={StaticResource booleanToVisibilityConverter}}" />

									<!--  In this sample the NetworkView is the content displayed by the ZoomAndPanControl.  -->

                                    <local:NetworkView
										x:Name="NetworkControl"
										ConnectionDragCompleted="NetworkControl_ConnectionDragCompleted"
										ConnectionDragStarted="NetworkControl_ConnectionDragStarted"
										ConnectionDragging="NetworkControl_ConnectionDragging"
										NodeDragCompleted="NetworkControl_NodeDragCompleted"
										NodeDragStarted="NetworkControl_NodeDragStarted"
										NodeResizeCompleted="NetworkControl_NodeResizeCompleted"
										QueryConnectionFeedback="NetworkControl_QueryConnectionFeedback" >

                                        <local:NetworkView.NodesSource>
                                            <MultiBinding Converter="{StaticResource NodeSourceConverter}">
                                                <Binding Path="NetworkViewModel.ScheduledNodes" />
                                                <Binding Path="NetworkViewModel.NonScheduledNodes" />
                                                <Binding Path="IsNonScheduled" />
                                            </MultiBinding>
                                        </local:NetworkView.NodesSource>
                                        <local:NetworkView.ConnectionsSource>
                                            <MultiBinding Converter="{StaticResource NodeSourceConverter}">
                                                <Binding Path="NetworkViewModel.ScheduledConnections" />
                                                <Binding Path="NetworkViewModel.NonScheduledConnections" />
                                                <Binding Path="IsNonScheduled" />
                                            </MultiBinding>
                                        </local:NetworkView.ConnectionsSource>

                                    </local:NetworkView>

                                    <!--
									This Canvas and Border are used as a very simple way to render a drag rectangle that the user
									uses to specify an area to select shapes.
								-->
									<Canvas
										x:Name="DragSelection"
										Visibility="Collapsed">
										<Border
											x:Name="DragSelectionBorder"
											Background="LightBlue"
											BorderBrush="Blue"
											BorderThickness="0.5"
											CornerRadius="2"
											Opacity="0.5" />
									</Canvas>
									<!--
									This Canvas and Border are used as a very simple way to render a drag rectangle that the user
									uses to specify an area to zoom in on.
								-->
									<Canvas
										x:Name="DragZoomCanvas"
										Visibility="Collapsed">
										<Border
											x:Name="DragZoomBorder"
											Background="Silver"
											BorderBrush="Black"
											BorderThickness="1"
											CornerRadius="1"
											Opacity="0" />
									</Canvas>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Grid>
				</AdornerDecorator>
			</local:ZoomAndPanControl>
		</ScrollViewer>
	</DockPanel>
</UserControl>
