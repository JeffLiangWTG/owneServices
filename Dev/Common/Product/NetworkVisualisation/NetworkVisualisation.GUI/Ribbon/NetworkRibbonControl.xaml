<UserControl x:Class="CargoWise.NetworkVisualisation.GUI.NetworkRibbonControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:CargoWise.NetworkVisualisation.GUI"
			 xmlns:integration="clr-namespace:CargoWise.NetworkVisualisation.Integration;assembly=CargoWise.NetworkVisualisation.Integration"
			 xmlns:UI="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
			 mc:Ignorable="d" 
			 d:DesignHeight="300" d:DesignWidth="600" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <local:DrawingToImageSourceConverter x:Key="DrawingToImageSourceConverter"/>

        <Style TargetType="RibbonTab">
            <Setter Property="Header" Value="{Binding Path=Header}"/>
        </Style>

        <Style TargetType="RibbonTabHeaderItemsControl">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- needed for F2+click support (label editing) -->
                        <!-- the bound object is MultilingualString (Header.Value) -->
                        <UI:MultilingualTextLabel MultilingualText="{Binding}">
                            <TextBlock Text="{Binding}"/>
                        </UI:MultilingualTextLabel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RibbonGroup">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <RibbonContextMenu/>
                </Setter.Value>
            </Setter>
            <Setter Property="Header" Value="{Binding Path=Header}"/>
            <Setter Property="SmallImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>
            <Setter Property="LargeImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>
        </Style>

        <Style TargetType="RibbonButton">
            <EventSetter Event="Click" Handler="RibbonButton_Click"/>

            <Setter Property="ContextMenu">
                <Setter.Value>
                    <RibbonContextMenu/>
                </Setter.Value>
            </Setter>
            <Setter Property="Label" Value="{Binding Path=Label}"/>
            <Setter Property="ToolTip" Value="{Binding Path=Tooltip}"/>
            <Setter Property="IsEnabled" Value="{Binding Path=IsEnabled}"/>
            <Setter Property="SmallImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageLayout}" Value="BothLargeAndSmallImages">
                    <Setter Property="LargeImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RibbonMenuButton">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <RibbonContextMenu/>
                </Setter.Value>
            </Setter>
            <Setter Property="Label" Value="{Binding Path=Label}"/>
            <Setter Property="ToolTip" Value="{Binding Path=Tooltip}"/>
            <Setter Property="IsEnabled" Value="{Binding Path=IsEnabled}"/>
            <Setter Property="SmallImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>
            <Setter Property="ItemsSource" Value="{Binding Path=ChildButtons}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageLayout}" Value="BothLargeAndSmallImages">
                    <Setter Property="LargeImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

		<Style TargetType="RibbonToggleButton">
			<EventSetter Event="Click" Handler="RibbonButton_Click"/>

            <Setter Property="ContextMenu">
                <Setter.Value>
                    <RibbonContextMenu/>
                </Setter.Value>
            </Setter>
            <Setter Property="Label" Value="{Binding Path=Label}"/>
            <Setter Property="ToolTip" Value="{Binding Path=Tooltip}"/>
            <Setter Property="IsEnabled" Value="{Binding Path=IsEnabled}"/>
            <Setter Property="IsChecked" Value="{Binding Path=IsChecked}"/>
            <Setter Property="SmallImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ImageLayout}" Value="BothLargeAndSmallImages">
                    <Setter Property="LargeImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RibbonMenuItem">
            <EventSetter Event="Click" Handler="RibbonButton_Click"/>

            <Setter Property="ContextMenu">
                <Setter.Value>
                    <RibbonContextMenu/>
                </Setter.Value>
            </Setter>
            <Setter Property="Header" Value="{Binding Path=Label}" />
            <Setter Property="ToolTip" Value="{Binding Path=Tooltip}"/>
            <Setter Property="IsChecked" Value="{Binding Path=IsChecked}"/>
            <Setter Property="ImageSource" Value="{Binding Path=Image, Converter={StaticResource DrawingToImageSourceConverter}}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ribbon x:Name="Ribbon"
					Grid.ColumnSpan="2"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Top"
					Height="Auto"
					Background="Bisque"
                    ContextMenuOpening="Ribbon_ContextMenuOpening">

            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Visibility="Collapsed"/>
            </Ribbon.ApplicationMenu>
        </Ribbon>
        <TextBox x:Name="SearchBox" Width="150" Height="18" Margin="0 26 1 0" VerticalAlignment="Top" HorizontalAlignment="Right" 
                 Initialized="SearchBox_Initialized"
                 GotFocus="SearchBox_GotFocus"
                 LostFocus="SearchBox_LostFocus"
                 KeyDown="SearchBox_KeyDown"
                 TextChanged="SearchBox_TextChanged"/>
    </Grid>
</UserControl>
