<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(Temp_CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>CargoWise.NetworkVisualisation.GUI</RootNamespace>
    <AssemblyName>CargoWise.NetworkVisualisation.GUI</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <TransformXamlResourceStrings>true</TransformXamlResourceStrings>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.ApplicationContext" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.ComponentModel" />
    <Reference Include="CargoWise.PAVE.Common.Interfaces" />
    <Reference Include="CargoWise.ResourceStrings.Cache" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="CargoWise.ResourceStrings" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="CargoWise.Windows.UI" />
    <Reference Include="CargoWise.Main.Navigation" />
    <Reference Include="Enterprise.ZArchitecture.Core" />
    <Reference Include="Enterprise.ZArchitecture.GUI" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetworkVisualisation.Business\NetworkVisualisation.Business.csproj" />
    <ProjectReference Include="..\NetworkVisualisation.Integration\NetworkVisualisation.Integration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\asterisk.bmp" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\block_16.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\pause.bmp" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\play.bmp" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\scissors.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\tick_16.png" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\trashcan.png" />
  </ItemGroup>
  <ItemGroup>
    <WCFMetadata Include="Service References\" />
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
</Project>