<UserControl
	x:Class="CargoWise.NetworkVisualisation.GUI.NetworkUserControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:CargoWise.NetworkVisualisation.GUI"
	xmlns:ui="clr-namespace:CargoWise.Main.Navigation.WPF;assembly=CargoWise.Main.Navigation"
	x:Name="MainWindow"
	Width="Auto"
	Height="Auto"
	MinWidth="400"
	MinHeight="150"
	Tag="{Binding DataContext, RelativeSource={RelativeSource Mode=Self}}">

	<!--
		Including this in binding statements for diagnostics:
		diagnostics:PresentationTraceSources.TraceLevel=High
	-->

	<UserControl.Resources>

		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!--  Merge in the resource dictionary that is shared between the main window and the overview window.  -->
				<!--  <ResourceDictionary Source="SharedVisualTemplates.xaml"	/>  -->
				<ResourceDictionary Source="DataTemplates/EntityDataTemplates.xaml" />
				<ResourceDictionary Source="DataTemplates/ShapeInspector/ShapeInspectorTemplates.xaml" />
				<ResourceDictionary Source="/CargoWise.Main.Navigation;component/WPF/MultilingualTextLabelResources.xaml" />

			</ResourceDictionary.MergedDictionaries>

			<!--  UI commands.  -->

			<RoutedUICommand x:Key="Commands.Refresh" />
			<RoutedUICommand x:Key="Commands.PopOut" />
			<RoutedUICommand x:Key="Commands.ZoomOut" />
			<RoutedUICommand x:Key="Commands.ZoomIn" />
			<RoutedUICommand x:Key="Commands.JumpBackToPrevZoom" />
			<RoutedUICommand x:Key="Commands.FitContent" />
			<RoutedUICommand x:Key="Commands.Fill" />
			<RoutedUICommand x:Key="Commands.OneHundredPercent" />

			<!--
				This converts from a scale value to a percentage value.
				It is used to convert the value of 'ContentScale' to the percentage zoom level that is displayed in the UI.
			-->
			<local:ScaleToPercentConverter x:Key="scaleToPercentConverter" />

			<local:ShapeInspectorTemplateSelector
				x:Key="ShapeInspectorTemplateSelector"
				ShapeInspectorDefaultMessageTemplate="{StaticResource ShapeInspectorDefaultMessageTemplate}"
				ShapeInspectorAnnotationTemplate="{StaticResource NonLinkedEntityDataTemplate}"
				ShapeInspectorShapeTemplate="{StaticResource LinkedEntityDataTemplate}" />

		</ResourceDictionary>

	</UserControl.Resources>

	<UserControl.InputBindings>

		<!--  Bind input to commands.  -->

		<KeyBinding
			Key="Subtract"
			Modifiers="Ctrl"
			Command="{StaticResource Commands.ZoomOut}" />
		<KeyBinding
			Key="OemMinus"
			Modifiers="Ctrl"
			Command="{StaticResource Commands.ZoomOut}" />
		<KeyBinding
			Key="Add"
			Modifiers="Ctrl"
			Command="{StaticResource Commands.ZoomIn}" />
		<KeyBinding
			Key="OemPlus"
			Modifiers="Ctrl"
			Command="{StaticResource Commands.ZoomIn}" />
		<KeyBinding
			Key="Back"
			Command="{StaticResource Commands.JumpBackToPrevZoom}" />
		<KeyBinding
			Key="Space"
			Command="{StaticResource Commands.FitContent}" />

	</UserControl.InputBindings>

	<UserControl.CommandBindings>

		<!--  Bind commands to event handlers.  -->

		<CommandBinding
			Command="{StaticResource Commands.ZoomOut}"
			Executed="ZoomOut_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.ZoomIn}"
			Executed="ZoomIn_Executed" />
		<CommandBinding
			CanExecute="JumpBackToPrevZoom_CanExecuted"
			Command="{StaticResource Commands.JumpBackToPrevZoom}"
			Executed="JumpBackToPrevZoom_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.FitContent}"
			Executed="FitContent_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.PopOut}"
			Executed="PopOut_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.Refresh}"
			Executed="Refresh_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.Fill}"
			Executed="Fill_Executed" />
		<CommandBinding
			Command="{StaticResource Commands.OneHundredPercent}"
			Executed="OneHundredPercent_Executed" />
		<CommandBinding
			Command="ApplicationCommands.Paste"
			Executed="PasteExecuted" />

	</UserControl.CommandBindings>

	<UserControl.DataContext>
		<local:NetworkUserControlViewModel />
	</UserControl.DataContext>

	<DockPanel>

		<!--  Grid placed below the zoom and pan control that contains the zoom slider, zoom label and some buttons.  -->

		<Grid
			Margin="5,5,5,5"
			DockPanel.Dock="Bottom">
			<Grid.ColumnDefinitions>

				<!--  empty space  -->
				<ColumnDefinition Width="*" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the pop out button  -->
				<ColumnDefinition Width="55" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the pop out button  -->
				<ColumnDefinition Width="55" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the fit content button  -->
				<ColumnDefinition Width="40" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the fill button  -->
				<ColumnDefinition Width="40" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the 100% button  -->
				<ColumnDefinition Width="40" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the zoom percentage label  -->
				<ColumnDefinition Width="25" />

				<!--  the % symbol  -->
				<ColumnDefinition Width="15" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the zoom out button  -->
				<ColumnDefinition Width="20" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the zoom slider  -->
				<ColumnDefinition Width="120" />

				<!--  spacer  -->
				<ColumnDefinition Width="5" />

				<!--  the zoom in button  -->
				<ColumnDefinition Width="20" />

			</Grid.ColumnDefinitions>

			<!--  The status message text area.  -->
			<ui:MultilingualTextLabel Grid.Column="0" IsTranslatable="False" VerticalContentAlignment="Center" HorizontalContentAlignment="Left">
				<TextBlock
				VerticalAlignment="Center"
				FontSize="13"
				Text="{Binding Path=StatusMessage}"
				TextAlignment="Right"
				ToolTip="{Binding Path=StatusTooltip}" />
			</ui:MultilingualTextLabel>

			<!--  The 'refresh' button.  Redraws the diagram.  -->
			<ui:MultilingualTextLabel Grid.Column="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button 
				Command="{StaticResource Commands.Refresh}"
				ToolTip="Refreshes the diagram">
					Refresh
				</Button>
			</ui:MultilingualTextLabel>

			<!--  The 'pop out' button.  Causes the control to be shown in its own form.  -->
			<ui:MultilingualTextLabel Grid.Column="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button
					Command="{StaticResource Commands.PopOut}"
					ToolTip="Pop out the entire diagram into a new window">
					Pop Out
				</Button>
			</ui:MultilingualTextLabel>

			<!--  The 'fit content' button.  Causes the content to be scaled so that all the graph nodes fit in the viewport.  -->
			<ui:MultilingualTextLabel Grid.Column="6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button
				Name="FitButton"
				Command="{StaticResource Commands.FitContent}"
				ToolTip="Fit all nodes to the view-port">
					Fit
				</Button>
			</ui:MultilingualTextLabel>

			<!--  The fill button.  Causes the content to be scaled so that it fits in the viewport.  -->
			<ui:MultilingualTextLabel Grid.Column="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button
				Command="{StaticResource Commands.Fill}"
				ToolTip="Fit the entire content area to the view-port">
					Fill
				</Button>
			</ui:MultilingualTextLabel>

			<!--  The 100% button.  Causes the content to be scaled to 100 percent.  -->
			<ui:MultilingualTextLabel Grid.Column="10" IsTranslatable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button
				Command="{StaticResource Commands.OneHundredPercent}"
				ToolTip="Scale the content to 100%">
					100%
				</Button>
			</ui:MultilingualTextLabel>

			<!--
				This is the label that shows what the current zoom level
				is while zooming in and out.
			-->
			<ui:MultilingualTextLabel Grid.Column="12" IsTranslatable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<TextBlock
				Name="ContentScaleTextBlock"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Text="{Binding Path=ContentScale,
								 Mode=TwoWay,
								 Converter={StaticResource scaleToPercentConverter}}" />
			</ui:MultilingualTextLabel>

			<ui:MultilingualTextLabel IsTranslatable="False" Grid.Column="13" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<TextBlock
				VerticalAlignment="Center"
				Text="%" />
			</ui:MultilingualTextLabel>

			<!--  Button to zoom out.  -->
			<ui:MultilingualTextLabel Grid.Column="15" IsTranslatable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button
				Name="ZoomOutButton"
				Command="{StaticResource Commands.ZoomOut}"
				IsEnabled="{Binding ZoomOutEnabled}"
				ToolTip="Zoom out from the content (Ctrl+-)">
					-
				</Button>
			</ui:MultilingualTextLabel>

			<!--  Slider to change the current zoom level.  -->
			<Slider
				Grid.Column="17"
				LargeChange="20"
				Maximum="200"
				Minimum="10"
				SmallChange="10"
				TickFrequency="10"
				TickPlacement="TopLeft"
				ToolTip="Change the zoom level of the content"
				Value="{Binding Path=ContentScale,
								Mode=TwoWay,
								Converter={StaticResource scaleToPercentConverter}}" />

			<!--  Button to zoom in.  -->
			<ui:MultilingualTextLabel Grid.Column="19" IsTranslatable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Button
				Name="ZoomInButton"
				Command="{StaticResource Commands.ZoomIn}"
				ToolTip="Zoom in on the content (Ctrl++)">
					+
				</Button>
			</ui:MultilingualTextLabel>

		</Grid>

		<local:NetworkRibbonControl
			x:Name="RibbonControl"
			DockPanel.Dock="Top"
			DataContext="{Binding RibbonViewModel}"
			HorizontalAlignment="Stretch"/>

		<Grid
			x:Name="DiagramAreaControlsGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="0" />
				<ColumnDefinition Width="0" />
			</Grid.ColumnDefinitions>

			<ContentControl 
				Grid.Column="0" 
				x:Name="MainDiagramAreaUserControl"
				Content="{Binding MainDiagramControl, RelativeSource={RelativeSource AncestorType={x:Type local:NetworkUserControl}}}" />

			<GridSplitter
				Name="GridSplitter" 
				Grid.Column="1" 
				VerticalAlignment="Stretch" 
				HorizontalAlignment="Center" 
				Width="8">
				<GridSplitter.Template>
					<ControlTemplate TargetType="{x:Type GridSplitter}">
						<Grid>
							<!-- This text button and rectangle are just to give the splitter a visual appearance. There's no text and the button does nothing. -->
							<Button Name="GridSplitterNonFunctionalButton" Content="⁞" />
							<Rectangle Fill="Transparent" />
						</Grid>
					</ControlTemplate>
				</GridSplitter.Template>
			</GridSplitter>

			<ContentControl
				x:Name="NonScheduledDiagramContentControl"
				Grid.Column="2" 
				Content="{Binding NonScheduledDiagramControl, RelativeSource={RelativeSource AncestorType={x:Type local:NetworkUserControl}}}" />
		</Grid>

		<Canvas Name="ShapeInspector" Visibility="{Binding Path=ShapeInspectorVisible, Converter={StaticResource booleanToVisibilityConverter}}">
			<DockPanel Canvas.Right="30" Canvas.Bottom="30" Background="White" Width="320" Height="220" >
				<ui:MultilingualTextLabel DockPanel.Dock="Top" IsTranslatable="True" HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" Margin="5">
					<TextBlock Text="Shape Inspector" />
				</ui:MultilingualTextLabel>
				<ContentControl DockPanel.Dock="Top"
								HorizontalContentAlignment="Stretch"
								VerticalContentAlignment="Stretch"
								Margin="20 0 20 20"
								Content="{Binding ShapeInspectorNodeViewModel}"
								ContentTemplateSelector="{StaticResource ShapeInspectorTemplateSelector}" />
			</DockPanel>
		</Canvas>

	</DockPanel>
</UserControl>
