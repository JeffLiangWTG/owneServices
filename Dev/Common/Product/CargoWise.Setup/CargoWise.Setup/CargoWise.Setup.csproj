<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CWNetCoreTargetFramework)</TargetFramework>
    <ApplicationManifest>$(WTGBranchRoot)main.manifest</ApplicationManifest>
  </PropertyGroup>

  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <!-- Override value from NetCoreCommon.props -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Threading.AccessControl" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Enterprise.Upgrades">
      <HintPath>..\..\..\..\Bin\net8.0\Enterprise.Upgrades.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
