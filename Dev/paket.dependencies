	nuget Microsoft.Extensions.Hosting 8.0.0
	nuget Microsoft.Extensions.Logging 8.0.0
	nuget Microsoft.Extensions.Logging.Console 8.0.0
	nuget Microsoft.VisualStudio.Threading.Analyzers 17.8.14
	nuget NUnit.Analyzers 3.10.0
