# ------------------------------------------------------------------
#
# These next groups are for Check-In Policies only.
# They must reference the version of Visual Studio that they are installed in.
# We use the lowest matching version so that they can be installed in any
# matching version, not just Update 1 or higher / Update 2 or higher / etc.

group VisualStudio2019
	source https://proget.wtg.zone/nuget/Gallery/v3/index.json
	framework: net472
	lowest_matching: true

	nuget Microsoft.TeamFoundationServer.ExtendedClient >= 16.0
	nuget Microsoft.TestPlatform.ObjectModel >= 15.9.0

# This concludes the Paket groups for check-in policies.
# You can add more unrelated groups below.
#
# ------------------------------------------------------------------


# ------------------------------------------------------------------
#
# As of May fifth, 2023, the Dev/Bin folder contains .NET Framework compatible
# binaries in it's root. There are exceptions, but it's a good rule of thumb.
#
# Many of these libraries are netstandard.  Usually that is not a problem, but
# take System.MetaData.Reflection, for example.  Package version 7.0.1
# contains a net462 version and an ns2 version.  Either binary can be
# referenced by .NET Framework 4.8 but the net462 version is a better match.
# That is why if you set a package reference in a Visual Studio net48 project,
# it will take the net462 version, not the ns2.
#
# So the net462 version makes more sense in the root of Dev/Bin.  But an ns2
# version already occupies that spot. Swapping that out would upset all of the
# related transient dependencies.
#
# To prevent this situation, Visual Studio appends the TFM to the output path.
# Developers have already moved in that direction by creating Dev/Bin/Net5.0
# and Dev/Bin/Net6.0.
#
# The following groups and their corresponding Bin subfolders (defined in
# build.xml) continue along that line of thinking.  Developers suffering
# from dll version conflicts can consider moving their binaries here.
#
# Workitem WI00601657 exists for migrating existing projects to use this
# approach.
#
# ------------------------------------------------------------------

group net48
	source https://proget.wtg.zone/nuget/Gallery/v3/index.json
	framework: net462
	nuget System.Reflection.Metadata ~> 7.0.1


group netstandard2.0
	source https://proget.wtg.zone/nuget/Gallery/v3/index.json
	framework: netstandard2.0
	nuget Microsoft.CodeAnalysis.CSharp ~> 4.2.0

group NetCore
	source https://proget.wtg.zone/nuget/Gallery/v3/index.json
	source https://proget.wtg.zone/nuget/WTG-Internal/v3/index.json
