	nuget MessagePackAnalyzer 2.5.140
	nuget Microsoft.AspNet.WebApi.Client 6.0.0
	nuget Microsoft.AspNetCore.Http 2.3.0
	nuget Microsoft.CodeAnalysis.NetAnalyzers 8.0.0
	nuget Microsoft.Data.SqlClient 6.0.1
	nuget Microsoft.Extensions.Caching.Abstractions 8.0.0
	nuget Microsoft.Extensions.Configuration.CommandLine 8.0.0
