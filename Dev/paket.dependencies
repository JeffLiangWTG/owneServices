# Most packages come from the public NuGet Gallery, or our mirror thereof.
source https://proget.wtg.zone/nuget/Gallery/v3/index.json

# Some packages are built internally, and are not
# available from the Gallery.
source https://proget.wtg.zone/nuget/WTG-Internal/v3/index.json

# old third party code still used in CW
source https://proget.wtg.zone/nuget/DoNotUse-Old-CargoWise-ThirdParty/v3/index.json

# This filters out extra supporting libraries from .NET Core / .NET Standard that
# we don't care about (yet).
framework: net48

# This is our list of packages.
# If you know what you're doing, manually add an entry.
# If you don't, use "dotnet paket add <package> --no-install".
# Use "dotnet paket update --no-install" to update paket.lock or "dotnet paket update <packageid> --no-install" for updating a specific package.
# Use "dotnet paket restore" to download and restore the new/updated packages.
#
# DO NOT UPDATE paket.lock BY HAND!
#
# Any pinned versions in this file MUST be annotated with a comment indicating why.
# Also include supporting info like a WI# or a url.
#

