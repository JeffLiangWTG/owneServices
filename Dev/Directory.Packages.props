  <!--
    Debug-only testing packages for .net core (including Winzor)

    Test projects are not built in release config.
  -->
  <ItemGroup Condition="('$(IsWinzorProject)' == 'true' or '$(IsNetCoreTargetFramework)' == 'true') and '$(IsDebugBuild)' == 'true'">
    <!--
      FluentAssertions pinned. Do not change it. v8+ has an incompatible license. FluentAssertions are being removed from the code base.
      See: WI00855980 - Create FluentAssertions project safeguard and pin version
    -->
    <PackageVersion Include="FluentAssertions" Version="[6.12.2]" />
    <PackageVersion Include="bunit" Version="1.36.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.49.0" />
    <PackageVersion Include="Microsoft.TestPlatform" Version="17.11.1" />
    <PackageVersion Include="Microsoft.TestPlatform.ObjectModel" Version="17.11.1" />
    <PackageVersion Include="Moq" Version="4.20.70" JanitorIgnoreUntil="10000.0.0.0" />
    <PackageVersion Include="NUnit" Version="4.1.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="WTG.PlaywrightTesting" Version="1.250116.2" />
    <PackageVersion Include="Lib.Harmony" Version="2.3.5" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true' and '$(IsWinzorProject)' != 'true'">
    <PackageVersion Include="System.Windows.Forms" Version="0.0.14-dev.final" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsWinzorProject)' == 'true'">
    <PackageVersion Include="Polly.Core" Version="8.4.1" />
    <PackageVersion Include="Polly.Extensions" Version="8.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>
</Project>