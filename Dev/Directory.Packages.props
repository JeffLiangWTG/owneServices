<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Packages for .net48

    This list should be very small (an exception only) as net48 uses Paket for package
    management. Most packages should be <Reference> to the paket assembly that
    has been copied to the Bin folder.

    The only packages that should be added to this list are those that perform some build action.
    These packages typically import a .props file into the project. The way we use Paket
    in Dev means these actions would not be run.

    If you are adding a new package to this list that does not perform a build action, please
    add it using Paket instead and add a <Reference> in your .csproj file.
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageVersion Include="CargoWiseOneWebPrintClient.Content" Version="1.0.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.57.0" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.1" />
    <PackageVersion Include="NETCompactFramework.Installers" Version="1.0.1" />
  </ItemGroup>
  <!--
    Debug-only packages for net48
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4')) and '$(IsDebugBuild)' == 'true'">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.7.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.2" />
  </ItemGroup>
  <!--
    Common packages for all .net versions
  -->
  <ItemGroup>
    <PackageVersion Include="CargoWise.XmlSerializer.Generator" Version="1.0.5" />
    <PackageVersion Include="WTG.AppDomainWrappers.Core" Version="2.0.5" />
    <PackageVersion Include="WTG.AppDomainWrappers.Runner" Version="2.0.5" />
    <PackageVersion Include="WTG.BuildConfiguration.Analysis.SYSLIB" Version="8.0.0" />
  </ItemGroup>
  <!--
    Used by AppDomainWrappers, which is a separate executable in Bin\AppDW
    Common\Tools\AppDomainWrappers\AppDomainWrappers.Net6\AppDomainWrappers.Net6.csproj

    When this project is upgraded to .net8 it will eventually be brought into the folder
    and this special case will no longer be needed.
  -->
  <ItemGroup Condition="$(TargetFramework) == 'net6.0'">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.7.0" />
    <PackageVersion Include="System.Text.Json" Version="8.0.1" />
    <PackageVersion Include="System.Memory" Version="4.5.5" />
  </ItemGroup>
  <!--
    Packages for .net core (including Winzor)
  -->
  <ItemGroup Condition="'$(IsWinzorProject)' == 'true' or '$(IsNetCoreTargetFramework)' == 'true'">
