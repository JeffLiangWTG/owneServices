<?xml version="1.0" encoding="Windows-1252"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Client/Logistics</TargetReportFolder>
    <TargetDatasetFolder>Client/Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Client/Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Client/Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/ReportServer</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>Client/Logistics</TargetReportFolder>
    <TargetDatasetFolder>Client/Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Client/Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Client/Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/ReportServer</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>WTL/UBI_UATBusinessIntelligence/Logistics</TargetReportFolder>
    <TargetDatasetFolder>WTL/UBI_UATBusinessIntelligence/Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>WTL/UBI_UATBusinessIntelligence/Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>WTL/UBI_UATBusinessIntelligence/Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/ReportServer</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSet Include="Colour_Code_DataSet.rsd" />
    <DataSet Include="Column_Layout_DataSet.rsd" />
    <DataSet Include="Company_Branch_DataSet.rsd" />
    <DataSet Include="Container_Mode_DataSet.rsd" />
    <DataSet Include="dax_Job_Profit_Summary_DataSet.rsd" />
    <DataSet Include="dax_Job_Profit_Top_Country_DataSet.rsd" />
    <DataSet Include="dax_Job_Profit_Year_Stats_DataSet.rsd" />
    <DataSet Include="dax_Job_Profit_Year_Stats_Metric_DataSet.rsd" />
    <DataSet Include="dax_Shipment_Summary_Year_DataSet.rsd" />
    <DataSet Include="dax_Shipment_Year_Stats_DataSet.rsd" />
    <DataSet Include="Department_DataSet.rsd" />
    <DataSet Include="Destination_Country_DataSet.rsd" />
    <DataSet Include="ID_Key_Conversion_DataSet.rsd" />
    <DataSet Include="Inco_Term_DataSet.rsd" />
    <DataSet Include="Job_Profit_12Month_Range_DataSet.rsd" />
    <DataSet Include="Job_Profit_By_Branch_Summary_DataSet.rsd" />
    <DataSet Include="Job_Profit_By_Container_Mode_DataSet.rsd" />
    <DataSet Include="Job_Profit_By_Department_Summary_DataSet.rsd" />
    <DataSet Include="Job_Profit_By_Transport_Mode_DataSet.rsd" />
    <DataSet Include="Job_Profit_ChargeCode_DataSet.rsd" />
    <DataSet Include="Job_Profit_LocalAgent_DataSet.rsd" />
    <DataSet Include="Job_Profit_TopVal_Branch_DataSet.rsd" />
    <DataSet Include="Job_Profit_TopVal_Container_Mode_DataSet.rsd" />
    <DataSet Include="Job_Profit_TopVal_Department_DataSet.rsd" />
    <DataSet Include="Job_Profit_TopVal_Transport_Mode_DataSet.rsd" />
    <DataSet Include="Job_Profit_Top_Desitination_Country_DataSet.rsd" />
    <DataSet Include="Job_Profit_Top_Origin_Country_DataSet.rsd" />
    <DataSet Include="Last_Data_Refresh_UTC_DataSet.rsd" />
    <DataSet Include="Line_Type_DataSet.rsd" />
    <DataSet Include="Origin_Country_DataSet.rsd" />
    <DataSet Include="Receiving_Agent_DataSet.rsd" />
    <DataSet Include="Sending_Agent_DataSet.rsd" />
    <DataSet Include="Staff_DataSet.rsd" />
    <DataSet Include="Transport_Mode_DataSet.rsd" />
  </ItemGroup>
  <ItemGroup>
    <DataSource Include="EDW.rds" />
    <DataSource Include="LogisticsModel.rds" />
    <DataSource Include="NoFileXMLDataSource.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="Job Profit Dashboard.rdl" />
    <Report Include="Job Profit Details.rdl" />
    <Report Include="Job Profit Extract.rdl" />
    <Report Include="Job Profit Parameter.rdl" />
    <Report Include="Job Profit Summary.rdl" />
    <Report Include="Shipment Dashboard.rdl" />
    <Report Include="Shipment Details.rdl" />
    <Report Include="Shipment Parameter.rdl" />
    <Report Include="Shipment Summary.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>