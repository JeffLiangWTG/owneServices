      <CommandText>EVALUATE
SUMMARIZECOLUMNS (
    'Company Branch'[Company Key],
    'Company Branch'[Company],
    FILTER (
        'Company Branch',
        'Company Branch'[Company ID] = @CompanyID
    )
)</CommandText>
