    <ReportParameter Name="DataSet_Query">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>EVALUATE
SELECTCOLUMNS (
    FILTER (
        SUMMARIZECOLUMNS (
            //GROUP_COLUMNS_START
            'Company Branch'[Company],
            'Company Branch'[Branch],
            'Department'[Department],
            'Transaction Company Branch'[Transaction Company],
            'Transaction Company Branch'[Transaction Branch],
            'Transaction Department'[Transaction Department],
            'GL Transaction'[Line Type],
            'GL Transaction'[Post Date],
            'GL Transaction'[Job Header No.],
            'Shipment'[Transport Mode],
            'Shipment'[Container Mode],
            'Port Of Destination'[Port Of Destination Country],
            'Port Of Origin'[Port Of Origin Country],
            'Local Agent'[Local Agent],
            //GROUP_COLUMNS_END
            FILTER (
                'Company Branch',
                (
                    PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Company Branch',
                (
                    PATHCONTAINS (
                        @Branch_Key,
                        'Transaction Company Branch'[Transaction Branch Key]
                    )
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                'Department',
                (
                    PATHCONTAINS ( @Department_Key, 'Department'[Department Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                ) || @Department_Key = "-1"
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Department',
                (
                    PATHCONTAINS (
                        @Department_Key,
                        'Transaction Department'[Transaction Department Key]
                    ) || @Department_Key = "-1"
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                VALUES ( 'Shipment'[Transport Mode] ),
                PATHCONTAINS ( @Transport_Mode, 'Shipment'[Transport Mode] )
                    || ISBLANK ( @Transport_Mode )
                    || LEN ( @Transport_Mode ) = 0
            ),
            FILTER (
                VALUES ( 'Shipment'[Container Mode] ),
                PATHCONTAINS ( @Container_Mode, 'Shipment'[Container Mode] )
                    || ISBLANK ( @Container_Mode )
                    || LEN ( @Container_Mode ) = 0
            ),
            FILTER (
                VALUES ( 'Port Of Destination'[Port Of Destination Country Code] ),
                PATHCONTAINS (
                    @Destination_Country_Code,
                    'Port Of Destination'[Port Of Destination Country Code]
                )
                    || ISBLANK ( @Destination_Country_Code )
                    || LEN ( @Destination_Country_Code ) = 0
                    || @Destination_Country_Code = "-1"
            ),
            FILTER (
                VALUES ( 'Port Of Origin'[Port Of Origin Country Code] ),
                PATHCONTAINS (
                    @Origin_Country_Code,
                    'Port Of Origin'[Port Of Origin Country Code]
                )
                    || ISBLANK ( @Origin_Country_Code )
                    || LEN ( @Origin_Country_Code ) = 0
                    || @Origin_Country_Code = "-1"
            ),
            FILTER (
                VALUES ( 'Local Agent'[Local Agent] ),
                PATHCONTAINS ( @Local_Agent, 'Local Agent'[Local Agent] )
                    || ISBLANK ( @Local_Agent )
                    || LEN ( @Local_Agent ) = 0
            ),
            FILTER (
                VALUES ( 'Charge Code'[Charge Code] ),
                PATHCONTAINS ( @Charge_Code, 'Charge Code'[Charge Code] )
                    || ISBLANK ( @Charge_Code )
                    || LEN ( @Charge_Code ) = 0
            ),
            FILTER (
                VALUES ( 'GL Transaction'[Line Type] ),
                PATHCONTAINS ( @LineType, 'GL Transaction'[Line Type] ) || ISBLANK ( @LineType )
                    || LEN ( @LineType ) = 0
            ),
            FILTER (
                VALUES ( 'Recognition Date'[Month Date] ),
                'Recognition Date'[Month Date] = VALUE ( @Report_Month )
                    || @Date_Type &lt;&gt; "Recognition"
            ),
            FILTER (
                VALUES ( 'Post Date'[Month Date] ),
                'Post Date'[Month Date] = VALUE ( @Report_Month )
                    || @Date_Type &lt;&gt; "Post"
            ),
            FILTER (
                VALUES ( 'Shipment'[__Is Shipping] ),
                NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
            ),
            // filter only shipments
            "Recognition Dates", CONCATENATEX (
                VALUES ( 'Revenue Recognition'[Recognition Date] ),
                FORMAT ( 'Revenue Recognition'[Recognition Date], "YYYY-MMM-DD" ),
                " | "
            ),
            "Local Amount", SUM ( 'GL Transaction'[__Local Amount] )
        ),
        NOT ( ISBLANK ( [Recognition Dates] ) ) || NOT ( ISBLANK ( [Local Amount] ) )
    ),
    //DISPLAY_COLUMNS_START
    "Job Company", 'Company Branch'[Company],
    "Job Branch", 'Company Branch'[Branch],
    "Job Department", 'Department'[Department],
    "Transaction Company", 'Transaction Company Branch'[Transaction Company],
    "Transaction Branch", 'Transaction Company Branch'[Transaction Branch],
    "Transaction Department", 'Transaction Department'[Transaction Department],
    "Line Type", 'GL Transaction'[Line Type],
    "Post Date", 'GL Transaction'[Post Date],
    "Job Header No.", 'GL Transaction'[Job Header No.],
    "Transport Mode", 'Shipment'[Transport Mode],
    "Container Mode", 'Shipment'[Container Mode],
    "Port Of Destination Country", 'Port Of Destination'[Port Of Destination Country],
    "Port Of Origin Country", 'Port Of Origin'[Port Of Origin Country],
    "Local Agent", 'Local Agent'[Local Agent],
    "Recognition Dates", [Recognition Dates],
    "Local Amount", [Local Amount]
    //DISPLAY_COLUMNS_END
)</Value>
        </Values>
      </DefaultValue>
      <Prompt>DataSet_Query</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
