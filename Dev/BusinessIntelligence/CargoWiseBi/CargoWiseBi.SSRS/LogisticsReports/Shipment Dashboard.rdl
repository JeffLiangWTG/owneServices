            <Top>26.5cm</Top>
            <Left>1cm</Left>
            <Height>0cm</Height>
            <Width>32cm</Width>
            <ZIndex>1</ZIndex>
            <Style>
              <Border>
                <Style>Solid</Style>
              </Border>
            </Style>
          </Line>
          <Chart Name="Chart_Profit_TransportMode_Year_Stats2">
            <ChartCategoryHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="Chart_Profit_TransportMode_Year_Stats_CategoryGroup2">
                    <GroupExpressions>
                      <GroupExpression>=Left(MonthName(Month(Fields!Month_Date.Value)),3)</GroupExpression>
                    </GroupExpressions>
                    <Variables>
                      <Variable Name="MthVal">
                        <Value>=Sum(Fields!Ranked_Value.Value)</Value>
                      </Variable>
                    </Variables>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!Order.Value</Value>
                      <Direction>Descending</Direction>
                    </SortExpression>
                  </SortExpressions>
                  <ChartMembers>
                    <ChartMember>
                      <Group Name="Chart_Profit_TransportMode_Year_Stats_CategoryGroup1">
                        <GroupExpressions>
                          <GroupExpression>=Fields!Series.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!Series.Value</Value>
                          <Direction>Descending</Direction>
                        </SortExpression>
                      </SortExpressions>
                      <Label>=iif(Fields!Series.Value &lt;= 2, "'"+Format(Fields!Month_Date.Value, "yy"), " ")</Label>
                    </ChartMember>
                  </ChartMembers>
                  <Label>="         " + Left(MonthName(Month(Fields!Month_Date.Value)), 3)</Label>
                </ChartMember>
              </ChartMembers>
            </ChartCategoryHierarchy>
            <ChartSeriesHierarchy>
              <ChartMembers>
                <ChartMember>
                  <Group Name="Chart_Profit_TransportMode_Year_Stats_SeriesGroup2">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Dimension.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!Dimension_Rank.Value</Value>
                    </SortExpression>
                  </SortExpressions>
                  <Label>=Fields!Dimension.Value</Label>
                </ChartMember>
              </ChartMembers>
            </ChartSeriesHierarchy>
            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="Ranked_Value">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!Ranked_Value.Value)</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style />
                      </ChartDataLabel>
                      <ToolTip>= Format(Fields!Month_Date.Value, "MMM-yyyy") &amp; CHR(13) &amp; Fields!Dimension.Value &amp; CHR(13) 
&amp; Parameters!Metric.Value &amp; " = " &amp; Code.NumberFormat(SUM(Fields!Ranked_Value.Value)) &amp; CHR(13)
&amp; IIF(Parameters!Metric.Value = "Job Profit","", "Job Profit = " &amp; Code.NumberFormat(SUM(Fields!Job_Profit.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Revenue","", "Revenue = " &amp; Code.NumberFormat(SUM(Fields!Revenue.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Cost","", "Cost = " &amp; Code.NumberFormat(SUM(Fields!Cost.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Accrual","", "Accrual = " &amp; Code.NumberFormat(SUM(Fields!Accrual.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Work In Progress","", "Work In Progress = " &amp; Code.NumberFormat(SUM(Fields!Work_In_Progress.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Container Count","", "Container Count = " &amp; Code.NumberFormat(SUM(Fields!Container_Count.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Container TEU","", "Container TEU = " &amp; Code.NumberFormat(SUM(Fields!Container_TEU.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Shipment Count","", "Shipment Count = " &amp; Code.NumberFormat(SUM(Fields!Shipment_Count.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Shipment Outer Packs","", "Shipment Outer Packs = " &amp; Code.NumberFormat(SUM(Fields!Shipment_Outer_Packs.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Shipment Volume","", "Shipment Volume = " &amp; Code.NumberFormat(SUM(Fields!Shipment_Volume.Value)) &amp; CHR(13))
&amp; IIF(Parameters!Metric.Value = "Shipment Weight","", "Shipment Weight = " &amp; Code.NumberFormat(SUM(Fields!Shipment_Weight.Value)) &amp; CHR(13))</ToolTip>
                      <ActionInfo>
                        <Actions>
                          <Action>
                            <Drillthrough>
                              <ReportName>Shipment Summary</ReportName>
                              <Parameters>
                                <Parameter Name="StaffID">
                                  <Value>=Parameters!StaffID.Value</Value>
                                </Parameter>
