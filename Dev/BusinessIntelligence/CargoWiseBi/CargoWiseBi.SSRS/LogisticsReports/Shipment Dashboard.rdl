                                  <Value>=Parameters!Dim_Type2.Value</Value>
                                </Parameter>
                                <Parameter Name="Origin_Country">
                                  <Value>=iif(Parameters!Dim_Type1.Value = "Origin"
,Split(Fields!Dimension_Code.Value,"|"),
Parameters!Origin_Country.Value)</Value>
                                </Parameter>
                                <Parameter Name="Destination_Country">
                                  <Value>=iif(Parameters!Dim_Type1.Value = "Destination"
,Split(Fields!Dimension_Code.Value,"|"),
Parameters!Destination_Country.Value)</Value>
                                </Parameter>
                                <Parameter Name="Sending_Agent">
                                  <Value>=iif(Parameters!Dim_Type1.Value = "Sending Agent"
,Split(Fields!Dimension_Code.Value,"|"),
