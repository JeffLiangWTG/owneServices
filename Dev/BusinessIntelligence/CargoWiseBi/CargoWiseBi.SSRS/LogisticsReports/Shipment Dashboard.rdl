                              <TextRuns>
                                <TextRun>
                                  <Value>=CDec(
iif(isnothing(Sum(IIF(CDate(Fields!Month_Date.Value)=DateAdd(DateInterval.Month,-1,Parameters!Report_Month.Value),Fields!Ranked_Value.Value,0)))
or Sum(IIF(CDate(Fields!Month_Date.Value)=DateAdd(DateInterval.Month,-1,Parameters!Report_Month.Value),Fields!Ranked_Value.Value,0)) = 0 ,
iif(Sum(IIF(CDate(Fields!Month_Date.Value)=Parameters!Report_Month.Value,Fields!Ranked_Value.Value,0))=0,0,
iif(Sum(IIF(CDate(Fields!Month_Date.Value)=Parameters!Report_Month.Value,Fields!Ranked_Value.Value,0))&gt;0,100,-100)),
REPLACE((Sum(IIF(CDate(Fields!Month_Date.Value)=Parameters!Report_Month.Value,Fields!Ranked_Value.Value,0)) - Sum(IIF(CDate(Fields!Month_Date.Value)=DateAdd(DateInterval.Month,-1,Parameters!Report_Month.Value),Fields!Ranked_Value.Value,0)))/
Sum(IIF(CDate(Fields!Month_Date.Value)=DateAdd(DateInterval.Month,-1,Parameters!Report_Month.Value),Fields!Ranked_Value.Value,0))
,"NaN",0)))</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Format>0.0%</Format>
                                    <Color>=Iif(Me.Value &lt; 0, "Red", "Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
