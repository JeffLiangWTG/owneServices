  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Line Name="Line_Divide12MonthStatsAndBranch2">
            <Top>24.4cm</Top>
            <Left>0.97764cm</Left>
            <Height>0cm</Height>
            <Width>32cm</Width>
            <Style>
              <Border>
                <Style>Solid</Style>
                <Width>0.5pt</Width>
