                                </Parameter>
                                <Parameter Name="PPD_CCX_Term">
                                  <Value>=iif(Parameters!Dim_Type1.Value = "PPD/CCX"
,Fields!Dimension.Value,
Parameters!PPD_CCX_Term.Value)</Value>
                                </Parameter>
                                <Parameter Name="Dim_Type1">
                                  <Value>=Parameters!Dim_Type1.Value</Value>
                                </Parameter>
                                <Parameter Name="Container_Mode">
                                  <Value>=iif(Parameters!Dim_Type1.Value = "Container Mode"
,Fields!Dimension.Value,
Parameters!Container_Mode.Value)</Value>
                                </Parameter>
                                <Parameter Name="Transport_Mode">
                                  <Value>=iif(Parameters!Dim_Type1.Value = "Transport Mode"
,Fields!Dimension.Value,
Parameters!Transport_Mode.Value)</Value>
                                </Parameter>
