<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <CommandText>EVALUATE
UNION (
    SELECTCOLUMNS (
        ALLNOBLANKROW ( 'Sending Agent' ),
        "Sending Agent Key", 'Sending Agent'[Sending Agent Key],
        "Sending Agent", 'Sending Agent'[Sending Agent]
    ),
    ROW ( "Sending Agent Key", -1 , "Sending Agent", "All agents" )
)
ORDER BY [Sending Agent]</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
          <CommandType>DMX</CommandType>
          <Type>Query</Type>
          <QuerySpecification xsi:type="DMXQuerySpecification">
            <Select>
              <Items>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[Sending Agent Key]</ColumnName>
                  </ID>
                  <ItemCaption>[Sending Agent Key]</ItemCaption>
                </Item>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[Sending Agent]</ColumnName>
                  </ID>
                  <ItemCaption>[Sending Agent]</ItemCaption>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <Data>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;DataminingQueryBuilderState xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
  &lt;SelectTablesControlState&gt;
    &lt;Tables /&gt;
  &lt;/SelectTablesControlState&gt;
  &lt;IsSingletonQuery&gt;false&lt;/IsSingletonQuery&gt;
  &lt;View&gt;Text&lt;/View&gt;
  &lt;QueryText&gt;EVALUATE
UNION (
    SELECTCOLUMNS (
        ALLNOBLANKROW ( 'Sending Agent' ),
        "Sending Agent Key", 'Sending Agent'[Sending Agent Key],
        "Sending Agent", 'Sending Agent'[Sending Agent]
    ),
    ROW ( "Sending Agent Key", -1 , "Sending Agent", "All agents" )
)
ORDER BY [Sending Agent]&lt;/QueryText&gt;
  &lt;DatabaseId /&gt;
  &lt;MiningStructureId /&gt;
  &lt;MiningModelId /&gt;
  &lt;ColumnMappings /&gt;
  &lt;GridRows /&gt;
&lt;/DataminingQueryBuilderState&gt;</Data>
          </QuerySpecification>
          <Query>
            <Statement>EVALUATE
UNION (
    SELECTCOLUMNS (
        ALLNOBLANKROW ( 'Sending Agent' ),
        "Sending Agent Key", 'Sending Agent'[Sending Agent Key],
        "Sending Agent", 'Sending Agent'[Sending Agent]
    ),
    ROW ( "Sending Agent Key", -1 , "Sending Agent", "All agents" )
)
ORDER BY [Sending Agent]</Statement>
            <ParameterDefinitions />
          </Query>
        </QueryDefinition>
      </rd:DesignerState>
    </Query>
    <Fields>
      <Field Name="Sending_Agent_Key">
        <DataField>[Sending Agent Key]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Sending_Agent">
        <DataField>[Sending Agent]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>