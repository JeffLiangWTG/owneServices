            <Select>
              <Items>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[StartDate]</ColumnName>
                  </ID>
                  <ItemCaption>[StartDate]</ItemCaption>
                </Item>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[EndDate]</ColumnName>
                  </ID>
                  <ItemCaption>[EndDate]</ItemCaption>
                </Item>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[Start24Date]</ColumnName>
                  </ID>
                  <ItemCaption>[Start24Date]</ItemCaption>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <Data>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;DataminingQueryBuilderState xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
