                    &amp;lt;= EDATE ( [Minus6Month], - DATEDIFF ( [MaxEdDt], [Plus5Month], MONTH ) ),
                EDATE ( [Minus6Month], - DATEDIFF ( [MaxEdDt], [Plus5Month], MONTH ) ),
                [MinStDt]
