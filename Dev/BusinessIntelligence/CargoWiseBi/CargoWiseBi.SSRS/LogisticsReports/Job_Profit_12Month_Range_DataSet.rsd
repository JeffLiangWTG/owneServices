<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="Report_Month">
          <DefaultValue>DATE( 2015, 10, 1)</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>true</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Date_Type">
          <DefaultValue>Date_Type</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Branch_Key">
          <DefaultValue>0</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Int32</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Analyse_Type">
          <DefaultValue>Analyse_Type</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Department_Key">
          <DefaultValue>0</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Int32</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>DEFINE
    VAR MaxEdDt =
        ADDCOLUMNS (
            GROUPBY (
                SELECTCOLUMNS (
                    FILTER (
                        SUMMARIZECOLUMNS (
                            'Recognition Date'[Month Date],
                            'Post Date'[Month Date],
                            FILTER (
                                VALUES ( 'Recognition Date'[Month Date] ),
                                (
                                    'Recognition Date'[Month Date] &lt;= EDATE ( VALUE ( @Report_Month ), 11 )
                                        &amp;&amp; 'Recognition Date'[Month Date] &gt;= EDATE ( VALUE ( @Report_Month ), -24 )
                                        &amp;&amp; @Date_Type = "Recognition"
                                )
                                    || @Date_Type = "Post"
                            ),
                            FILTER (
                                VALUES ( 'Post Date'[Month Date] ),
                                (
                                    'Post Date'[Month Date] &lt;= EDATE ( VALUE ( @Report_Month ), 11 )
                                        &amp;&amp; 'Post Date'[Month Date] &gt;= EDATE ( VALUE ( @Report_Month ), -24 )
                                        &amp;&amp; @Date_Type = "Post"
                                )
                                    || @Date_Type = "Recognition"
                            ),
                            FILTER (
                                'Company Branch',
                                (
                                    PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
                                        &amp;&amp; @Analyse_Type = "Job"
                                )
                                    || @Analyse_Type = "Transaction"
                            ),
                            FILTER (
                                'Transaction Company Branch',
                                (
                                    PATHCONTAINS (
                                        @Branch_Key,
                                        'Transaction Company Branch'[Transaction Branch Key]
                                    )
                                        &amp;&amp; @Analyse_Type = "Transaction"
                                )
                                    || @Analyse_Type = "Job"
                            ),
                            FILTER (
                                'Department',
                                (
                                    PATHCONTAINS ( @Department_Key, 'Department'[Department Key] )
                                        &amp;&amp; @Analyse_Type = "Job"
                                )
                                    || @Analyse_Type = "Transaction"
                            ),
                            FILTER (
                                'Transaction Department',
                                (
                                    PATHCONTAINS (
                                        @Department_Key,
                                        'Transaction Department'[Transaction Department Key]
                                    )
                                        &amp;&amp; @Analyse_Type = "Transaction"
                                )
                                    || @Analyse_Type = "Job"
                            ),
                            FILTER (
                                VALUES ( 'Shipment'[__Is Shipping] ),
                                NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
                            ),
                            // filter only shipments
                            "CountRS", COUNTROWS ( 'Shipment' )
                        ),
                        [CountRS] &gt; 0
                    ),
                    "MonthDate", SWITCH (
                        @Date_Type,
                        "Recognition", 'Recognition Date'[Month Date],
                        "Post", 'Post Date'[Month Date]
                    )
                ),
                "MinStDt", MINX ( CURRENTGROUP (), [MonthDate] ),
                "MaxEdDt", MAXX ( CURRENTGROUP (), [MonthDate] )
            ),
            "ReportMonth", EDATE ( VALUE ( @Report_Month ), 0 ),
            "Minus6Month", EDATE ( VALUE ( @Report_Month ), -6 ),
            "Plus5Month", EDATE ( VALUE ( @Report_Month ), 5 ),
            "Minus18Month", EDATE ( VALUE ( @Report_Month ), -18 )
        )
EVALUATE
UNION (
   ROW (
    "StartDate", EDATE ( VALUE ( @Report_Month ), -6 ),
    "EndDate", EDATE ( VALUE ( @Report_Month ), 5 ),
    "Start24Date", EDATE ( VALUE ( @Report_Month ), -18 )
	)
,
    SELECTCOLUMNS (
        MaxEdDt,
        "StartDate", IF (
            [MaxEdDt] &gt;= [Plus5Month]
                &amp;&amp; [MinStDt] &lt;= [Minus6Month],
            [Minus6Month],
            IF (
                [MaxEdDt] &lt; [Plus5Month],
                IF (
                    [MinStDt]
                        &lt;= EDATE ( [Minus6Month], - DATEDIFF ( [MaxEdDt], [Plus5Month], MONTH ) ),
                    EDATE ( [Minus6Month], - DATEDIFF ( [MaxEdDt], [Plus5Month], MONTH ) ),
                    [MinStDt]
                ),
                IF ( [MinStDt] &gt; [Minus6Month], [MinStDt] )
            )
        ),
        "EndDate", IF (
            [MaxEdDt] &gt;= [Plus5Month]
                &amp;&amp; [MinStDt] &lt;= [Minus6Month],
            [Plus5Month],
            IF (
                [MaxEdDt] &lt; [Plus5Month],
                [MaxEdDt],
                IF (
                    [MinStDt] &gt; [Minus6Month],
                    IF (
                        [MaxEdDt]
                            &gt;= EDATE ( [Plus5Month], DATEDIFF ( [Minus6Month], [MinStDt], MONTH ) ),
                        EDATE ( [Plus5Month], DATEDIFF ( [Minus6Month], [MinStDt], MONTH ) ),
                        [MaxEdDt]
                    )
                )
            )
        ),
        "Start24Date", IF (
            [MaxEdDt] &gt;= [Plus5Month]
                &amp;&amp; [MinStDt] &lt;= [Minus18Month],
            [Minus18Month],
            IF (
                [MaxEdDt] &lt; [Plus5Month],
                IF (
                    [MinStDt]
                        &lt;= EDATE ( [Minus18Month], - DATEDIFF ( [MaxEdDt], [Plus5Month], MONTH ) ),
                    EDATE ( [Minus18Month], - DATEDIFF ( [MaxEdDt], [Plus5Month], MONTH ) ),
                    [MinStDt]
                ),
                IF ( [MinStDt] &gt; [Minus18Month], [MinStDt] )
            )
        )
    )
)</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
