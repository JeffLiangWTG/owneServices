                                (
                                    'Post Date'[Month Date] &amp;lt;= EDATE ( VALUE ( @Report_Month ), 11 )
                                        &amp;amp;&amp;amp; 'Post Date'[Month Date] &amp;gt;= EDATE ( VALUE ( @Report_Month ), -24 )
                                        &amp;amp;&amp;amp; @Date_Type = "Post"
                                )
                                    || @Date_Type = "Recognition"
                            ),
                            FILTER (
