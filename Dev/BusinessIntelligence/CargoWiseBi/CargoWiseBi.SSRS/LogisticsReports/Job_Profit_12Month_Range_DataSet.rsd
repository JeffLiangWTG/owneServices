                                NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
                            ),
                            // filter only shipments
                            "CountRS", COUNTROWS ( 'Shipment' )
                        ),
                        [CountRS] &amp;gt; 0
                    ),
                    "MonthDate", SWITCH (
                        @Date_Type,
