  &lt;QueryText&gt;DEFINE
    VAR MaxEdDt =
        ADDCOLUMNS (
            GROUPBY (
                SELECTCOLUMNS (
                    FILTER (
                        SUMMARIZECOLUMNS (
                            'Recognition Date'[Month Date],
                            'Post Date'[Month Date],
                            FILTER (
                                VALUES ( 'Recognition Date'[Month Date] ),
                                (
                                    'Recognition Date'[Month Date] &amp;lt;= EDATE ( VALUE ( @Report_Month ), 11 )
                                        &amp;amp;&amp;amp; 'Recognition Date'[Month Date] &amp;gt;= EDATE ( VALUE ( @Report_Month ), -24 )
                                        &amp;amp;&amp;amp; @Date_Type = "Recognition"
                                )
