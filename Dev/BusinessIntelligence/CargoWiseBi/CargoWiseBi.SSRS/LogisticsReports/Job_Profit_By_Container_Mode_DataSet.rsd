<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description />
  <DataSet Name="Job_Profit_By_Container_Mode_DataSet">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="Branch_Key">
          <DefaultValue>0</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Int32</rd:DbType>
          <rd:IsMultiValued>true</rd:IsMultiValued>
        </DataSetParameter>
        <DataSetParameter Name="Department_Key">
          <DefaultValue>0</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Int32</rd:DbType>
          <rd:IsMultiValued>true</rd:IsMultiValued>
        </DataSetParameter>
        <DataSetParameter Name="Report_Month">
          <DefaultValue>DATE(2015,10,1)</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="MinJobProfitPc">
          <DefaultValue>15</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Int32</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Date_Type">
          <DefaultValue>Date_Type</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Analyse_Type">
          <DefaultValue>Analyse_Type</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>DEFINE
    VAR JpLimit =
        SUMMARIZECOLUMNS (
            FILTER (
                'Company Branch',
                (
                    PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Company Branch',
                (
                    PATHCONTAINS (
                        @Branch_Key,
                        'Transaction Company Branch'[Transaction Branch Key]
                    )
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                'Department',
                (
                    PATHCONTAINS ( @Department_Key, 'Department'[Department Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Department',
                (
                    PATHCONTAINS (
                        @Department_Key,
                        'Transaction Department'[Transaction Department Key]
                    )
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                VALUES ( 'Recognition Date'[Month Date] ),
                (
                    'Recognition Date'[Month Date] = VALUE ( @Report_Month )
                        &amp;&amp; @Date_Type = "Recognition"
                )
                    || @Date_Type = "Post"
            ),
            FILTER (
                VALUES ( 'Post Date'[Month Date] ),
                (
                    'Post Date'[Month Date] = VALUE ( @Report_Month )
                        &amp;&amp; @Date_Type = "Post"
                )
                    || @Date_Type = "Recognition"
            ),
            FILTER (
                VALUES ( 'Shipment'[__Is Shipping] ),
                NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
            ),
            // filter only shipments 
            "Job Profit", 'GL Transaction'[Job Profit]
        )
            * @MinJobProfitPc
            / 100.0
    VAR AggTable1 =
        SUMMARIZECOLUMNS (
            'Shipment'[Container Mode],
            FILTER (
                'Company Branch',
                (
                    PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Company Branch',
                (
                    PATHCONTAINS (
                        @Branch_Key,
                        'Transaction Company Branch'[Transaction Branch Key]
                    )
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                'Department',
                (
                    PATHCONTAINS ( @Department_Key, 'Department'[Department Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Department',
                (
                    PATHCONTAINS (
                        @Department_Key,
                        'Transaction Department'[Transaction Department Key]
                    )
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                VALUES ( 'Recognition Date'[Month Date] ),
                (
                    'Recognition Date'[Month Date] = VALUE ( @Report_Month )
                        &amp;&amp; @Date_Type = "Recognition"
                )
                    || @Date_Type = "Post"
            ),
            FILTER (
                VALUES ( 'Post Date'[Month Date] ),
                (
                    'Post Date'[Month Date] = VALUE ( @Report_Month )
                        &amp;&amp; @Date_Type = "Post"
                )
                    || @Date_Type = "Recognition"
            ),
            FILTER (
                VALUES ( 'Shipment'[__Is Shipping] ),
                NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
            ),
            // filter only shipments            
            "Work In Progress", 'GL Transaction'[Work In Progress],
            "Accrual", 'GL Transaction'[Accrual],
            "Cost", 'GL Transaction'[Cost],
            "Revenue", 'GL Transaction'[Revenue],
            "Job Profit", 'GL Transaction'[Job Profit]
        )
    VAR ConX =
        CONCATENATEX (
            FILTER ( AggTable1, [Job Profit] &lt; JpLimit ),
            [Container Mode],
            "|"
        )
EVALUATE
UNION (
    SELECTCOLUMNS (
        FILTER ( AggTable1, [Job Profit] &gt;= JpLimit ),
        "Work In Progress", [Work In Progress],
        "Accrual", [Accrual],
        "Cost", [Cost],
        "Revenue", [Revenue],
        "Job Profit", [Job Profit],
        "Container Mode", 'Shipment'[Container Mode],
        "Container Mode Val", 'Shipment'[Container Mode]
    ),
    ADDCOLUMNS (
        GROUPBY (
            FILTER ( AggTable1, [Job Profit] &lt; JpLimit ),
            "Work In Progress", SUMX ( CURRENTGROUP (), [Work In Progress] ),
            "Accrual", SUMX ( CURRENTGROUP (), [Accrual] ),
            "Cost", SUMX ( CURRENTGROUP (), [Cost] ),
            "Revenue", SUMX ( CURRENTGROUP (), [Revenue] ),
            "Job Profit", SUMX ( CURRENTGROUP (), [Job Profit] )
        ),
        "Container Mode", "OTH",
        "Container Mode Val", ConX
    )
)</CommandText>
