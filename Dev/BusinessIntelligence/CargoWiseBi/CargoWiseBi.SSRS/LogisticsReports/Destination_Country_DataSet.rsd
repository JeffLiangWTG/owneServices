  &lt;/SelectTablesControlState&gt;
  &lt;IsSingletonQuery&gt;false&lt;/IsSingletonQuery&gt;
  &lt;View&gt;Text&lt;/View&gt;
  &lt;QueryText&gt;EVALUATE
UNION (
    DISTINCT (
        SELECTCOLUMNS (
            ALLNOBLANKROW ( 'Port Of Destination' ),
            "Port Of Destination Country", CONCATENATE (
                CONCATENATE (
                    CONCATENATE ( "(", 'Port Of Destination'[Port Of Destination Country Code] ),
                    ")"
                ),
                'Port Of Destination'[Port Of Destination Country]
            ),
            "Port Of Destination Country Code", 'Port Of Destination'[Port Of Destination Country Code]
        )
    ),
    ROW ( "Port Of Destination Country", "All countries",
    "Port Of Destination Country Code", "-1" )
)
ORDER BY [Port Of Destination Country]&lt;/QueryText&gt;
  &lt;DatabaseId /&gt;
  &lt;MiningStructureId /&gt;
  &lt;MiningModelId /&gt;
  &lt;ColumnMappings /&gt;
  &lt;GridRows /&gt;
&lt;/DataminingQueryBuilderState&gt;</Data>
          </QuerySpecification>
          <Query>
            <Statement>EVALUATE
UNION (
    DISTINCT (
        SELECTCOLUMNS (
            ALLNOBLANKROW ( 'Port Of Destination' ),
            "Port Of Destination Country", CONCATENATE (
                CONCATENATE (
                    CONCATENATE ( "(", 'Port Of Destination'[Port Of Destination Country Code] ),
                    ")"
                ),
                'Port Of Destination'[Port Of Destination Country]
            ),
            "Port Of Destination Country Code", 'Port Of Destination'[Port Of Destination Country Code]
        )
    ),
    ROW ( "Port Of Destination Country", "All countries",
    "Port Of Destination Country Code", "-1" )
)
ORDER BY [Port Of Destination Country]</Statement>
