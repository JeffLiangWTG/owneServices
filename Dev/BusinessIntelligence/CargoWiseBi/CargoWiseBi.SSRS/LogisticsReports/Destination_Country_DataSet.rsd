<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <CommandText>EVALUATE
UNION (
    DISTINCT (
        SELECTCOLUMNS (
            ALLNOBLANKROW ( '__Geography' ),
            "Port Of Destination Country", CONCATENATE (
                CONCATENATE (
                    CONCATENATE ( "(", '__Geography'[Country Code] ),
                    ")"
                ),
                '__Geography'[Country]
            ),
            "Port Of Destination Country Code", '__Geography'[Country Code]
        )
    ),
    ROW ( "Port Of Destination Country", "All countries",
    "Port Of Destination Country Code", "-1" )
)
ORDER BY [Port Of Destination Country]</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
