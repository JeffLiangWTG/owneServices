    FILTER (
        VALUES ( 'Shipment'[Shipment Inco Term] ),
        LEN ( 'Shipment'[Shipment Inco Term] ) &amp;gt; 0
    )
)
ORDER BY 'Shipment'[Shipment Inco Term]&lt;/QueryText&gt;
  &lt;DatabaseId /&gt;
  &lt;MiningStructureId /&gt;
  &lt;MiningModelId /&gt;
  &lt;ColumnMappings /&gt;
  &lt;GridRows /&gt;
&lt;/DataminingQueryBuilderState&gt;</Data>
          </QuerySpecification>
          <Query>
            <Statement>EVALUATE
SUMMARIZECOLUMNS (
    'Shipment'[Shipment Inco Term],
