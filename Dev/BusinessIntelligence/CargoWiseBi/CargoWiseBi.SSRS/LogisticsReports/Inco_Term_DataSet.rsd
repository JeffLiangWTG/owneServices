                    <ColumnName>Shipment[Shipment Inco Term]</ColumnName>
                  </ID>
                  <ItemCaption>Shipment[Shipment Inco Term]</ItemCaption>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <Data>&lt;?xml version="1.0" encoding="utf-16"?&gt;
