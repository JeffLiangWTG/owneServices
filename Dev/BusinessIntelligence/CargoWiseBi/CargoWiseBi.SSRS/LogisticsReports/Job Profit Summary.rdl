    <DataSet Name="Origin_Country_DataSet">
      <Query>
        <DataSourceName>LogisticsModel</DataSourceName>
        <CommandText>EVALUATE
UNION (
    DISTINCT (
        SELECTCOLUMNS (
            ALLNOBLANKROW ( '__Geography' ),
            "Port Of Origin Country", CONCATENATE (
                CONCATENATE (
                    CONCATENATE ( "(", '__Geography'[Country Code] ),
                    ")"
                ),
                '__Geography'[Country]
            ),
            "Port Of Origin Country Code", '__Geography'[Country Code]
        )
    ),
    ROW ( "Port Of Origin Country", "All countries",
    "Port Of Origin Country Code", "-1" )
)
ORDER BY [Port Of Origin Country]</CommandText>
      </Query>
      <Fields>
        <Field Name="Port_Of_Origin_Country">
          <DataField>[Port Of Origin Country]</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
        <Field Name="Port_Of_Origin_Country_Code">
          <DataField>[Port Of Origin Country Code]</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
