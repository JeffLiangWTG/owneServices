  <Code>Public Shared Function NumberFormat(ByVal Value As Decimal) As String
	Dim strFormat As String
	Dim AbsVal As Decimal
	AbsVal = Math.Abs(Value)
	strFormat = If(AbsVal &gt; 1000000000, "#,0,,,.0'B';(#,0,,,.0'B')", If(AbsVal &gt; 1000000, "#,0,,.0'M';(#,0,,.0'M')", If(AbsVal &gt; 1000, "#,0,.0'K';(#,0,.0'K')", "#,0;(#,0)")))
	Return Format(Value, strFormat)
End Function
</Code>
