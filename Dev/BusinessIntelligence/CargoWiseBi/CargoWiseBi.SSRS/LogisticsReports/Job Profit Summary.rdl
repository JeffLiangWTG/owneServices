                      </ChartDataLabel>
                      <ToolTip>= Fields!Charge_Code_Actual.Value &amp; CHR(13) &amp;
"Job Profit = " &amp; Code.NumberFormat(iif(isNothing(Fields!Job_Profit.Value), 0, Fields!Job_Profit.Value))
&amp; CHR(13) 
&amp; "Revenue = " &amp; Code.NumberFormat(iif(isNothing(Fields!Revenue_WIP.Value), 0, Fields!Revenue_WIP.Value)) 
&amp; CHR(13) 
&amp; "Cost = " &amp; Code.NumberFormat(iif(isNothing(Fields!Cost_Accrual.Value), 0, Fields!Cost_Accrual.Value))
&amp; CHR(13) 
&amp; "Margin = " &amp; Format(iif(Fields!Revenue_WIP.Value &lt;&gt; 0 , (Fields!Job_Profit.Value) / (Fields!Revenue_WIP.Value) * 100 , 0),"#.00") &amp; "%"</ToolTip>
                      <ActionInfo>
                        <Actions>
                          <Action>
