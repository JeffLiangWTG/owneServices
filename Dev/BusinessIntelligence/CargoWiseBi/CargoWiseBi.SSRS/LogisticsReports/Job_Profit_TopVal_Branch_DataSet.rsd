                    <ColumnName>[Branch]</ColumnName>
                  </ID>
                  <ItemCaption>[Branch]</ItemCaption>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <Data>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;DataminingQueryBuilderState xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
  &lt;SelectTablesControlState&gt;
    &lt;Tables /&gt;
  &lt;/SelectTablesControlState&gt;
  &lt;IsSingletonQuery&gt;false&lt;/IsSingletonQuery&gt;
  &lt;View&gt;Text&lt;/View&gt;
  &lt;QueryText&gt;EVALUATE
SELECTCOLUMNS (
    TOPN (
        2,
        FILTER (
            GROUPBY (
                SELECTCOLUMNS (
                    SUMMARIZECOLUMNS (
                        'Company Branch'[Branch Key],
                        'Company Branch'[Branch],
                        'Transaction Company Branch'[Transaction Branch Key],
                        'Transaction Company Branch'[Transaction Branch],
                        FILTER (
                            'Company Branch',
                            (
                                PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
                                    &amp;amp;&amp;amp; @Analyse_Type = "Job"
                            )
                                || @Analyse_Type = "Transaction"
                        ),
                        FILTER (
                            'Transaction Company Branch',
                            (
                                PATHCONTAINS (
                                    @Branch_Key,
                                    'Transaction Company Branch'[Transaction Branch Key]
                                )
                                    &amp;amp;&amp;amp; @Analyse_Type = "Transaction"
                            )
                                || @Analyse_Type = "Job"
                        ),
                        FILTER (
                            'Department',
                            (
                                PATHCONTAINS ( @Department_Key, 'Department'[Department Key] )
                                    &amp;amp;&amp;amp; @Analyse_Type = "Job"
                            )
                                || @Analyse_Type = "Transaction"
                        ),
                        FILTER (
                            'Transaction Department',
                            (
                                PATHCONTAINS (
                                    @Department_Key,
                                    'Transaction Department'[Transaction Department Key]
                                )
                                    &amp;amp;&amp;amp; @Analyse_Type = "Transaction"
                            )
                                || @Analyse_Type = "Job"
                        ),
                        FILTER (
                            VALUES ( 'Recognition Date'[Month Date] ),
                            (
                                'Recognition Date'[Month Date] = VALUE ( @Report_Month )
                                    &amp;amp;&amp;amp; @Date_Type = "Recognition"
                            )
                                || @Date_Type = "Post"
                        ),
                        FILTER (
                            VALUES ( 'Post Date'[Month Date] ),
                            (
                                'Post Date'[Month Date] = VALUE ( @Report_Month )
                                    &amp;amp;&amp;amp; @Date_Type = "Post"
                            )
                                || @Date_Type = "Recognition"
                        ),
                        FILTER (
                            VALUES ( 'Shipment'[__Is Shipping] ),
                            NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
                        ),
                        // filter only shipments
                        "Job Profit", 'GL Transaction'[Job Profit]
                    ),
                    "Branch Key", SWITCH (
                        @Analyse_Type,
                        "Job", 'Company Branch'[Branch Key],
                        "Transaction", 'Transaction Company Branch'[Transaction Branch Key]
                    ),
                    "Branch", SWITCH (
                        @Analyse_Type,
                        "Job", 'Company Branch'[Branch],
                        "Transaction", 'Transaction Company Branch'[Transaction Branch]
                    ),
                    "Job Profit", [Job Profit]
                ),
                [Branch Key],
                [Branch],
                "Job Profit", SUMX ( CURRENTGROUP (), [Job Profit] )
            ),
            NOT ( ISBLANK ( [Job Profit] ) )
        ),
        ROUND ( [Job Profit], 0 )
            + 1 / [Branch Key], DESC
    ),
    "Branch Key", [Branch Key],
    "Branch", [Branch]
)&lt;/QueryText&gt;
  &lt;DatabaseId /&gt;
  &lt;MiningStructureId /&gt;
  &lt;MiningModelId /&gt;
  &lt;ColumnMappings /&gt;
  &lt;GridRows /&gt;
&lt;/DataminingQueryBuilderState&gt;</Data>
