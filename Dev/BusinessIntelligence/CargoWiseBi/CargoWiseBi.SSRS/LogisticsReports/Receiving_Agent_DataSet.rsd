<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <CommandText>EVALUATE
UNION (
    SELECTCOLUMNS (
        ALLNOBLANKROW ( 'Receiving Agent' ),
        "Receiving Agent Key", 'Receiving Agent'[Receiving Agent Key],
        "Receiving Agent", 'Receiving Agent'[Receiving Agent]
    ),
    ROW ( "Receiving Agent Key", -1 , "Receiving Agent", "All agents" )
)
ORDER BY [Receiving Agent]</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
          <CommandType>DMX</CommandType>
          <Type>Query</Type>
          <QuerySpecification xsi:type="DMXQuerySpecification">
            <Select>
              <Items>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[Receiving Agent Key]</ColumnName>
                  </ID>
                  <ItemCaption>[Receiving Agent Key]</ItemCaption>
                </Item>
                <Item>
                  <ID xsi:type="Column">
                    <ColumnName>[Receiving Agent]</ColumnName>
                  </ID>
                  <ItemCaption>[Receiving Agent]</ItemCaption>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <Data>&lt;?xml version="1.0" encoding="utf-16"?&gt;
&lt;DataminingQueryBuilderState xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"&gt;
  &lt;SelectTablesControlState&gt;
    &lt;Tables /&gt;
  &lt;/SelectTablesControlState&gt;
  &lt;IsSingletonQuery&gt;false&lt;/IsSingletonQuery&gt;
  &lt;View&gt;Text&lt;/View&gt;
  &lt;QueryText&gt;EVALUATE
UNION (
    SELECTCOLUMNS (
        ALLNOBLANKROW ( 'Receiving Agent' ),
        "Receiving Agent Key", 'Receiving Agent'[Receiving Agent Key],
        "Receiving Agent", 'Receiving Agent'[Receiving Agent]
    ),
    ROW ( "Receiving Agent Key", -1 , "Receiving Agent", "All agents" )
)
ORDER BY [Receiving Agent]&lt;/QueryText&gt;
  &lt;DatabaseId /&gt;
  &lt;MiningStructureId /&gt;
  &lt;MiningModelId /&gt;
  &lt;ColumnMappings /&gt;
  &lt;GridRows /&gt;
&lt;/DataminingQueryBuilderState&gt;</Data>
          </QuerySpecification>
          <Query>
            <Statement>EVALUATE
UNION (
    SELECTCOLUMNS (
        ALLNOBLANKROW ( 'Receiving Agent' ),
        "Receiving Agent Key", 'Receiving Agent'[Receiving Agent Key],
        "Receiving Agent", 'Receiving Agent'[Receiving Agent]
    ),
    ROW ( "Receiving Agent Key", -1 , "Receiving Agent", "All agents" )
)
ORDER BY [Receiving Agent]</Statement>
            <ParameterDefinitions />
          </Query>
        </QueryDefinition>
      </rd:DesignerState>
    </Query>
    <Fields>
      <Field Name="Receiving_Agent_Key">
        <DataField>[Receiving Agent Key]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Receiving_Agent">
        <DataField>[Receiving Agent]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>