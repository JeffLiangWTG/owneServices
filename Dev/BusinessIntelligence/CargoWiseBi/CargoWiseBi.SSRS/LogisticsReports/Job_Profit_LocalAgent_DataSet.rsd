<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description />
  <DataSet Name="Job_Profit_LocalAgent_DataSet">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="Branch_Key">
          <DefaultValue>Branch_Key</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Department_Key">
          <DefaultValue>Department_Key</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Report_Month">
          <DefaultValue>DATE(2015,10,1)</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Transport_Mode">
          <DefaultValue>=Nothing</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>true</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Container_Mode">
          <DefaultValue>=Nothing</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>true</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Destination_Country_Code">
          <DefaultValue>=Nothing</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>true</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Origin_Country_Code">
          <DefaultValue>=Nothing</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>true</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Date_Type">
          <DefaultValue>Date_Type</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="Analyse_Type">
          <DefaultValue>Analyse_Type</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>DEFINE
    VAR LocalAgentAgg =
        SUMMARIZECOLUMNS (
            'Local Agent'[Local Agent],
            FILTER (
                'Company Branch',
                (
                    PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Company Branch',
                (
                    PATHCONTAINS (
                        @Branch_Key,
                        'Transaction Company Branch'[Transaction Branch Key]
                    )
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                'Department',
                (
                    PATHCONTAINS ( @Department_Key, 'Department'[Department Key] ) || @Department_Key = "-1"
                        &amp;&amp; @Analyse_Type = "Job"
                )
                    || @Analyse_Type = "Transaction"
            ),
            FILTER (
                'Transaction Department',
                (
                    PATHCONTAINS (
                        @Department_Key,
                        'Transaction Department'[Transaction Department Key]
                    ) || @Department_Key = "-1"
                        &amp;&amp; @Analyse_Type = "Transaction"
                )
                    || @Analyse_Type = "Job"
            ),
            FILTER (
                VALUES ( 'Shipment'[Transport Mode] ),
                PATHCONTAINS ( @Transport_Mode, 'Shipment'[Transport Mode] )
                    || ISBLANK ( @Transport_Mode )
                    || LEN ( @Transport_Mode ) = 0
            ),
            FILTER (
                VALUES ( 'Shipment'[Container Mode] ),
                PATHCONTAINS ( @Container_Mode, 'Shipment'[Container Mode] )
                    || ISBLANK ( @Container_Mode )
                    || LEN ( @Container_Mode ) = 0
            ),
            FILTER (
                VALUES ( 'Port Of Destination'[Port Of Destination Country Code] ),
                PATHCONTAINS (
                    @Destination_Country_Code,
                    'Port Of Destination'[Port Of Destination Country Code]
                )
                    || ISBLANK ( @Destination_Country_Code )
                    || LEN ( @Destination_Country_Code ) = 0
                    || @Destination_Country_Code = "-1"
            ),
            FILTER (
                VALUES ( 'Port Of Origin'[Port Of Origin Country Code] ),
                PATHCONTAINS (
                    @Origin_Country_Code,
                    'Port Of Origin'[Port Of Origin Country Code]
                )
                    || ISBLANK ( @Origin_Country_Code )
                    || LEN ( @Origin_Country_Code ) = 0
                    || @Origin_Country_Code = "-1"
            ),
	        FILTER (
	            VALUES ( 'Recognition Date'[Month Date] ),
	            ('Recognition Date'[Month Date] = VALUE ( @Report_Month )  &amp;&amp; @Date_Type = "Recognition")
	                || @Date_Type = "Post"
	        ),
	        FILTER (
	            VALUES ( 'Post Date'[Month Date] ),
	            ('Post Date'[Month Date] = VALUE ( @Report_Month ) &amp;&amp; @Date_Type = "Post")
	                || @Date_Type = "Recognition"
	        ),
            FILTER (
                VALUES ( 'Shipment'[__Is Shipping] ),
                NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
            ),
            // filter only shipments            
            "Job Profit", [Job Profit],
            "Revenue&amp;WIP", [Revenue] + [Work In Progress],
            "Cost&amp;Accrual", - ( [Cost] + [Accrual] ),
            "JHCount", COUNTAX ( 'Job Header', 'Job Header'[Job Header Key] )
        )
EVALUATE
SELECTCOLUMNS (
    UNION (
        ////////////////Profitable Local Agents///////////////////////////////////
        TOPN (
            20,
            FILTER ( LocalAgentAgg, [Job Profit] &gt; 0 ),
            [Job Profit], 0
        ),
        ////////////////Loss Local Agents///////////////////////////////////   
        TOPN (
            5,
            FILTER ( LocalAgentAgg, [Job Profit] &lt;= 0 ),
            - [Job Profit], 0
        )
    ),
    "Local Agent", IF (
        LEN ( 'Local Agent'[Local Agent] ) &gt; 30,
        LEFT ( 'Local Agent'[Local Agent], 28 ) &amp; "...",
        'Local Agent'[Local Agent]
    ),
    "Local Agent Actual", 'Local Agent'[Local Agent],
    "Job Profit", IF ( ISBLANK ( [Job Profit] ), 0, [Job Profit] ),
    "Revenue&amp;WIP", IF ( ISBLANK ( [Revenue&amp;WIP] ), 0, [Revenue&amp;WIP] ),
    "Cost&amp;Accrual", IF ( ISBLANK ( [Cost&amp;Accrual] ), 0, [Cost&amp;Accrual] ),
    "Job Profit Avg", IF ( ISBLANK ( [Job Profit] ), 0, [Job Profit] / [JHCount] ),
    "Revenue Avg", IF ( ISBLANK ( [Revenue&amp;WIP] ), 0, [Revenue&amp;WIP] / [JHCount] ),
    "Cost Avg", IF ( ISBLANK ( [Cost&amp;Accrual] ), 0, [Cost&amp;Accrual] / [JHCount] ),
    "Colour_Code", RANKX ( ALLSELECTED ( 'Local Agent'[Local Agent] ), 'Local Agent'[Local Agent] )
)</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
