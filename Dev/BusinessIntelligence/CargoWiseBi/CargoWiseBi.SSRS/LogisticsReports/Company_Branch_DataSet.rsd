<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description />
  <DataSet Name="Company_Branch_DataSet">
    <Query>
      <DataSourceReference>LogisticsModel</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="Company_Key">
          <DefaultValue>"0"</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>EVALUATE
SUMMARIZE (
    FILTER ( '__Company Branch', '__Company Branch'[Company Key] = VALUE(@Company_Key) ),
    '__Company Branch'[Branch Key],
    '__Company Branch'[Branch]
)
ORDER BY '__Company Branch'[Branch]</CommandText>
