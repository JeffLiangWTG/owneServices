    <ReportParameter Name="DataSet_Query">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>DEFINE
    VAR vCountry_Code =
        SELECTCOLUMNS (
            FILTER (
                'Company Branch',
                PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
            ),
            "Country Code", [Country Code]
        )
EVALUATE
SELECTCOLUMNS (
    SUMMARIZECOLUMNS (
        //GROUP_COLUMNS_START
        'Company Branch'[Branch],
        'Department'[Department],
        'Shipment'[Way Bill Number],
        'Shipment'[Container Mode],
        'Shipment'[Goods Description],
        'Shipment'[Screening Status],
        'Shipment'[Transport Mode],
        'Shipment'[Release Type],
        'Port Of Origin'[Port Of Origin Country],
        'Port Of Destination'[Port Of Destination Country],
        'Port Of Destination'[Port Of Destination Location],
        'AWB Service Level'[AWB Service Level],
        'Shipment'[Additional Terms],
        'Shipment'[Is Booking],
        'Shipment'[Booking Confirmation Reference],
        'Shipment'[Shipment Create Date],
        'Shipment'[Booking Confirmed Date],
        'Shipment'[Bill Issued Date],
        'Shipment'[Is Cancelled],
        'Shipment'[Cartage Waybill Number],
        'Shipment'[CFS Reference],
        'Shipment'[Is CFS Registered],
        'Shipment'[Departure Date],
        'Shipment'[Is Direct Booking],
        'Shipment'[Interim Receipt Number],
        'GL Transaction'[Job Header No.],
        //GROUP_COLUMNS_END
        FILTER (
            VALUES ( 'Main Consol Shipment'[CountryCode] ),
            'Main Consol Shipment'[CountryCode] = vCountry_Code
        ),
        FILTER (
            VALUES ( Shipment[__Is Forward Registered] ),
            Shipment[__Is Forward Registered]
        ),
        FILTER (
            VALUES ( 'Shipment Create Date'[Month Date] ),
            ( 'Shipment Create Date'[Month Date] = VALUE ( @Report_Month ) )
                || @Date_Type &lt;&gt; "Registered"
        ),
        FILTER (
            VALUES ( 'Recognition Date'[Month Date] ),
            ( 'Recognition Date'[Month Date] = VALUE ( @Report_Month ) )
                || @Date_Type &lt;&gt; "Recognition"
        ),
        FILTER (
            VALUES ( 'Billing Job Open Date'[Month Date] ),
            ( 'Billing Job Open Date'[Month Date] = VALUE ( @Report_Month ) )
                || @Date_Type &lt;&gt; "Billing"
        ),
        FILTER (
            VALUES ( 'Arrival Date'[Month Date] ),
            ( 'Arrival Date'[Month Date] = VALUE ( @Report_Month ) )
                || @Date_Type &lt;&gt; "ETA"
        ),
        FILTER (
            VALUES ( 'Departure Date'[Month Date] ),
            ( 'Departure Date'[Month Date] = VALUE ( @Report_Month ) )
                || @Date_Type &lt;&gt; "ETD"
        ),
        FILTER (
            VALUES ( 'Shipment'[Transport Mode] ),
            PATHCONTAINS ( @Transport_Mode, 'Shipment'[Transport Mode] )
        ),
        FILTER (
            VALUES ( 'Shipment'[Container Mode] ),
            PATHCONTAINS ( @Container_Mode, 'Shipment'[Container Mode] )
        ),
        FILTER (
            VALUES ( 'Shipment'[Shipment Inco Term] ),
            PATHCONTAINS ( @Inco_Terms, 'Shipment'[Shipment Inco Term] )
        ),
        FILTER (
            VALUES ( 'Port Of Origin'[Port Of Origin Country Code] ),
            PATHCONTAINS ( @Origin_Country, 'Port Of Origin'[Port Of Origin Country Code] )
                || PATHCONTAINS ( @Origin_Country, "-1" )
        ),
        FILTER (
            VALUES ( 'Port Of Destination'[Port Of Destination Country Code] ),
            PATHCONTAINS (
                @Destination_Country,
                'Port Of Destination'[Port Of Destination Country Code]
            )
                || PATHCONTAINS ( @Destination_Country, "-1" )
        ),
        FILTER (
            VALUES ( 'Sending Agent'[Sending Agent Key] ),
            PATHCONTAINS ( @Sending_Agent, 'Sending Agent'[Sending Agent Key] )
                || PATHCONTAINS ( @Sending_Agent , "-1")
        ),
        FILTER (
            VALUES ( 'Receiving Agent'[Receiving Agent Key] ),
            PATHCONTAINS ( @Receiving_Agent, 'Receiving Agent'[Receiving Agent Key] )
                || PATHCONTAINS ( @Receiving_Agent, "-1" )
        ),
        FILTER (
		            'Company Branch',
            PATHCONTAINS ( @Branch_Key, 'Company Branch'[Branch Key] )
        ),
        FILTER (
            'Department',
            PATHCONTAINS ( @Department_Key, 'Department'[Department Key] )
			|| @Department_Key = "-1"
        ),
        "Actual Chargeable", [Actual Chargeable],
        "Goods Value", [Goods Value],
        "Manifested Volume", [Manifested Volume],
        "Manifested Weight", [Manifested Weight],
        "No. Original Bills", [No. Original Bills],
        "No. Copy Bills", [No. Copy Bills],
        "Outer Packs", [Shipment Outer Packs],
        "Total No. Of Packs", [Total No. Of Packs]
    ),
    //DISPLAY_COLUMNS_START	
    "Branch", 'Company Branch'[Branch],
    "Department", 'Department'[Department],
    "Way Bill Number", [Way Bill Number],
    "Container Mode", [Container Mode],
    "Goods Description", [Goods Description],
    "Screening Status", [Screening Status],
    "Actual Chargeable", [Actual Chargeable],
    "Manifested Weight", [Manifested Weight],
    "Manifested Volume", [Manifested Volume],
    "Goods Value", [Goods Value],
    "No. Original Bills", [No. Original Bills],
    "No. Copy Bills", [No. Copy Bills],
    "Outer Packs", [Outer Packs],
    "Total No. Of Packs", [Total No. Of Packs],
    "Transport Mode", [Transport Mode],
    "Release Type", [Release Type],
    "Port Of Origin Country", [Port Of Origin Country],
    "Port Of Destination Country", [Port Of Destination Country],
    "Port Of Destination Location", [Port Of Destination Location],
    "AWB Service Level", [AWB Service Level],
    "Additional Terms", [Additional Terms],
    "Is Booking", [Is Booking],
    "Booking Confirmation Reference", [Booking Confirmation Reference],
    "Shipment Create Date", [Shipment Create Date],
    "Booking Confirmed Date", [Booking Confirmed Date],
    "Bill Issued Date", [Bill Issued Date],
    "Is Cancelled", [Is Cancelled],
    "Cartage Waybill Number", [Cartage Waybill Number],
    "CFS Reference", [CFS Reference],
    "Is CFS Registered", [Is CFS Registered],
    "Departure Date", [Departure Date],
    "Is Direct Booking", [Is Direct Booking],
    "Interim Receipt Number", [Interim Receipt Number],
    "Job Header No.", 'GL Transaction'[Job Header No.]
    //DISPLAY_COLUMNS_END
)</Value>
        </Values>
      </DefaultValue>
      <Prompt>DataSet Query</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
