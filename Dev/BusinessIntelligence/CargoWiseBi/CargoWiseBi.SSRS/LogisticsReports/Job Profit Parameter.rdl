  <Code>Function OnlyDimCode (dimvals As String) As String
 Dim str As String() = Split(dimvals,",") 
 Dim rtn As String
  
For Each s As String in str 
rtn = rtn + Mid(s,2,3) + ","
 Next
  
 Return rtn.Trim(",")
End Function</Code>
