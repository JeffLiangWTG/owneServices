                                              </Parameter>
                                              <Parameter Name="Container_Mode">
                                                <Value>=iif(Parameters!Dim_Type1.Value = "Container Mode", Split(Fields!Dimension_1_Code.Value,"|"),
 iif(Parameters!Dim_Type2.Value = "Container Mode", Split(Fields!Dimension_2_Code.Value,"|"),Parameters!Container_Mode.Value))</Value>
                                              </Parameter>
                                              <Parameter Name="Transport_Mode">
                                                <Value>=iif(Parameters!Dim_Type1.Value = "Transport Mode", Split(Fields!Dimension_1_Code.Value,"|"),
 iif(Parameters!Dim_Type2.Value = "Transport Mode", Split(Fields!Dimension_2_Code.Value,"|"),Parameters!Transport_Mode.Value))</Value>
                                              </Parameter>
                                              <Parameter Name="Inco_Terms">
