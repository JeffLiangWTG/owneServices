                      <CellContents>
                        <Chart Name="Chart_Tablix_JobProfit">
                          <ChartCategoryHierarchy>
                            <ChartMembers>
                              <ChartMember>
                                <Group Name="Chart_Tablix_JobProfit_CategoryGroup3">
                                  <GroupExpressions>
                                    <GroupExpression>=Fields!Month_Date.Value</GroupExpression>
                                  </GroupExpressions>
                                </Group>
                                <SortExpressions>
                                  <SortExpression>
                                    <Value>=Fields!Month_Date.Value</Value>
                                    <Direction>Descending</Direction>
                                  </SortExpression>
                                </SortExpressions>
                                <Label>=Left(Format(Fields!Month_Date.Value, "MMM"), 1)</Label>
                              </ChartMember>
                            </ChartMembers>
                          </ChartCategoryHierarchy>
                          <ChartSeriesHierarchy>
                            <ChartMembers>
                              <ChartMember>
                                <Group Name="Chart_Tablix_JobProfit_SeriesGroup">
                                  <GroupExpressions>
                                    <GroupExpression>=Fields!Dimension_2.Value</GroupExpression>
                                  </GroupExpressions>
                                </Group>
                                <SortExpressions>
                                  <SortExpression>
                                    <Value>=Fields!DimensionRank_2.Value</Value>
                                  </SortExpression>
                                </SortExpressions>
                                <Label>=Fields!Dimension_2.Value</Label>
                              </ChartMember>
                            </ChartMembers>
                          </ChartSeriesHierarchy>
                          <ChartData>
                            <ChartSeriesCollection>
                              <ChartSeries Name="Job_Profit">
                                <ChartDataPoints>
                                  <ChartDataPoint>
                                    <ChartDataPointValues>
                                      <Y>=Sum(Fields!Job_Profit.Value)</Y>
                                    </ChartDataPointValues>
                                    <ChartDataLabel>
                                      <Style />
                                    </ChartDataLabel>
                                    <ToolTip>= Format(Fields!Month_Date.Value, "MMM-yyyy") &amp; CHR(13) 
&amp; Parameters!Dim_Type1.Value &amp;" - "&amp; Fields!Dimension_1.Value &amp; CHR(13) 
&amp; Parameters!Dim_Type2.Value &amp;" - "&amp; Fields!Dimension_2.Value &amp; CHR(13) 
&amp; "Shipment Count = " &amp; Code.NumberFormat(SUM(Fields!Shipment_Count.Value)) &amp; CHR(13)
&amp; "Job Profit = " &amp; Code.NumberFormat(SUM(Fields!Job_Profit.Value)) &amp; CHR(13)
&amp; IIF(Parameters!Metric.Value = "Job Profit" or Parameters!Metric.Value = "Shipment Count","Container TEU = ",Parameters!Metric.Value+" = " ) &amp; Code.NumberFormat(SUM(Fields!Container_TEUOrMetric.Value)) &amp; CHR(13)</ToolTip>
                                    <ActionInfo>
                                      <Actions>
                                        <Action>
                                          <Drillthrough>
                                            <ReportName>Shipment Details</ReportName>
                                            <Parameters>
                                              <Parameter Name="StaffID">
                                                <Value>=Parameters!StaffID.Value</Value>
                                              </Parameter>
