 iif(Parameters!Dim_Type2.Value = "Inco", Split(Fields!Dimension_2_Code.Value,"|"),Parameters!Inco_Terms.Value))</Value>
                                              </Parameter>
                                              <Parameter Name="Sending_Agent">
