  <Code>    Public Shared Function ColorDWB(ByVal Value As Decimal, ByVal MaxPositive As Decimal, ByVal MinPositive As Decimal) As String
        Dim MaxColStr As String = "#00A0DC"
        Dim MinColStr As String = "#CCECF8"
        Dim ColMaxR As Integer
        Dim ColMaxG As Integer
        Dim ColMaxB As Integer 'Split the #RGB color to R, G, and B components
        ColMaxR = Convert.ToInt32(Left(Right(MaxColStr, 6), 2), 16)
        ColMaxG = Convert.ToInt32(Left(Right(MaxColStr, 4), 2), 16)
        ColMaxB = Convert.ToInt32(Right(MaxColStr, 2), 16) 'Find Largest Range
        Dim decPosRange As Decimal = Math.Abs((MaxPositive+1) - MinPositive) 'Find appropriate color shade
        'Dim Shd As Decimal = 255

        Dim ShdR As Decimal = Convert.ToInt32(Left(Right(MinColStr, 6), 2), 16) - ColMaxR
        Dim ShdG As Decimal = Convert.ToInt32(Left(Right(MinColStr, 4), 2), 16) - ColMaxG
        Dim ShdB As Decimal = Convert.ToInt32(Right(MinColStr, 2), 16) - ColMaxB


        Dim iColor1 As Integer
        Dim iColor2 As Integer
        Dim iColor3 As Integer
        Dim strColor As String 'Reduce a shade for each of the R,G,B components
        iColor1 = ColMaxR + CInt(Math.Round((MaxPositive - Value) * (ShdR / decPosRange)))
        iColor2 = ColMaxG + CInt(Math.Round((MaxPositive - Value) * (ShdG / decPosRange)))
        iColor3 = ColMaxB + CInt(Math.Round((MaxPositive - Value) * (ShdB / decPosRange))) 'Return the new color
        strColor = "#" &amp; iColor1.ToString("X2") &amp; iColor2.ToString("X2") &amp; iColor3.ToString("X2")
        Return strColor
    End Function

Public Shared Function NumberFormat(ByVal Value As Decimal) As String
	Dim strFormat As String
	Dim AbsVal As Decimal
	AbsVal = Math.Abs(Value)
	strFormat = If(AbsVal &gt; 100000000, "#,0,,,.0'B';(#,0,,,.0'B')", If(AbsVal &gt; 100000, "#,0,,.0'M';(#,0,,.0'M')", If(AbsVal &gt; 1000, "#,0,.0'K';(#,0,.0'K')", "#,0.0;(#,0.0)")))
	Return Format(Value, strFormat)
End Function


