        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR DateName = \"Service Occurred\"",
                "VAR ShiftedMonths = 6",
                "RETURN",
                "    ADDCOLUMNS (",
                "        ADDCOLUMNS (",
                "            ADDCOLUMNS (",
                "                SELECTCOLUMNS (",
                "                    CALENDAR (",
                "                        MIN ( 'Billing Transactions'[Date Service Occurred] ),",
                "                        MAX ( 'Billing Transactions'[Date Service Occurred] )",
                "                    ),",
                "                    \"Service Occurred Date\", [Date]",
                "                ),",
                "                \"Year Date\", DATE ( YEAR ( [Service Occurred Date] ), 1, 1 ),",
                "                \"Service Occurred Year\", FORMAT ( [Service Occurred Date], \"YYYY\" ) & \" \"",
                "                    & DateName,",
                "                \"Fiscal Year Date\", DATE ( IF (",
                "                    MONTH ( [Service Occurred Date] ) > ShiftedMonths,",
                "                    YEAR ( EDATE ( [Service Occurred Date], 6 ) ),",
                "                    YEAR ( [Service Occurred Date] )",
                "                ), 1, 1 )",
                "            ),",
                "            \"Service Occurred Fiscal Year\", \"FY\" & FORMAT ( [Fiscal Year Date], \"YYYY\" )",
                "                & \" \"",
                "                & DateName",
                "        ),",
                "        \"Fiscal Quarter Date\", DATE ( YEAR ( [Service Occurred Date] ), (",
                "            ( FORMAT ( [Service Occurred Date], \"Q\" ) - 1 )",
                "                * 3",
                "        )",
                "            + 1, 1 ),",
                "        \"Service Occurred Fiscal Quarter\", \"Q\" & FORMAT ( EDATE ( [Service Occurred Date], ShiftedMonths ), \"Q\" )",
                "            & \" \"",
                "            & [Service Occurred Fiscal Year],",
                "        \"Fiscal Month Date\", DATE ( YEAR ( [Service Occurred Date] ), MONTH ( [Service Occurred Date] ), 1 ),",
                "        \"Service Occurred Fiscal Month\", FORMAT ( [Service Occurred Date], \"MMM\" ) & \" \"",
                "            & [Service Occurred Fiscal Year],",
                "        \"Quarter Date\", DATE ( YEAR ( [Service Occurred Date] ), (",
                "            ( FORMAT ( [Service Occurred Date], \"Q\" ) - 1 )",
                "                * 3",
                "        )",
                "            + 1, 1 ),",
                "        \"Service Occurred Quarter\", \"Q\" & FORMAT ( [Service Occurred Date], \"Q\" )",
                "            & \" \"",
                "            & [Service Occurred Year],",
                "        \"Month Date\", DATE ( YEAR ( [Service Occurred Date] ), MONTH ( [Service Occurred Date] ), 1 ),",
                "        \"Service Occurred Month\", FORMAT ( [Service Occurred Date], \"MMM\" ) & \" \"",
                "            & [Service Occurred Year]",
                "    )"
              ]
            }
          }
        ],
