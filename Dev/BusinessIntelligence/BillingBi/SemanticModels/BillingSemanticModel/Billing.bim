        "partitions": [
          {
            "name": "Billing Transactions - Old",
            "source": {
              "query": [
                "SELECT [Date Service Occurred],[Price Item Key],[Reporting Source],[Category],[Price Item Code],[Licence Client Key],[Database Number],[Client Company PK],[Client Staff Code],[Reference1],[Reference2],[Reference3],[Reference4],[Billable Count Value],[System Create UTC] FROM [analysis].[Billing Transactions]",
                "",
                "WHERE 1=0--[System Create UTC] < '2017-02-01'"
              ],
              "dataSource": "Billing"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT [Date Service Occurred],[Price Item Key],[Reporting Source],[Category],[Price Item Code],[Licence Client Key],[Database Number],[Client Company PK],[Client Staff Code],[Reference1],[Reference2],[Reference3],[Reference4],[Billable Count Value],[System Create UTC] FROM [analysis].[Billing Transactions]",
                  "",
                  "WHERE 1=0--[System Create UTC] < '2017-02-01'</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          },
          {
            "name": "Billing Transactions - Current",
            "mode": "import",
            "source": {
              "query": [
                "SELECT TOP 1000 [Date Service Occurred],[Price Item Key],[Reporting Source],[Category],[Price Item Code],[Licence Client Key],[Database Number],[Client Company PK],[Client Staff Code],[Reference1],[Reference2],[Reference3],[Reference4],[Billable Count Value],[System Create UTC] FROM [analysis].[Billing Transactions]",
                "",
                "WHERE 1=1--[System Create UTC] >= '2017-02-01'"
              ],
              "dataSource": "Billing"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>SELECT TOP 1000 [Date Service Occurred],[Price Item Key],[Reporting Source],[Category],[Price Item Code],[Licence Client Key],[Database Number],[Client Company PK],[Client Staff Code],[Reference1],[Reference2],[Reference3],[Reference4],[Billable Count Value],[System Create UTC] FROM [analysis].[Billing Transactions]",
                  "",
                  "WHERE 1=1--[System Create UTC] >= '2017-02-01'</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Active Staff",
            "expression": [
              "IF (",
              "    ISBLANK (",
              "        SUM ( 'Billing Transactions'[Billable Count Value] )",
              "    ),",
              "    BLANK (),",
              "    CALCULATE (",
              "        'Billing Transactions'[Billable Count],",
              "        FILTER (",
              "            ALL ( 'Price Item' ),",
              "            'Price Item'[Code & Feature] = \"[USR] User Count\"",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "General Forwarding Engine / Active Staff",
            "expression": [
              "IF (",
              "    ISFILTERED ( 'Price Item'[Code & Feature] )",
              "        && NOT ISBLANK ( 'Billing Transactions'[Billable Count] ),",
              "    DIVIDE (",
              "        CALCULATE (",
              "            'Billing Transactions'[Billable Count],",
              "            FILTER (",
              "                ALL ( 'Price Item' ),",
              "                'Price Item'[Function] = \"General Forwarding Engine\"",
              "            )",
              "        ),",
              "        CALCULATE (",
              "            'Billing Transactions'[Billable Count],",
              "            FILTER (",
              "                ALL ( 'Price Item' ),",
              "                'Price Item'[Function] = \"Active Staff\"",
              "            )",
              "        ),",
              "        \"No Active Staff\"",
              "    ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "Billable Count",
            "expression": [
              "IF (",
              "    CALCULATE ( ISCROSSFILTERED ( 'Price Item'[Code & Feature] ) )",
              "        && (",
              "            CALCULATE ( HASONEVALUE ( 'Service Occurred Date'[Service Occurred Date] ) )",
              "                || CALCULATE ( HASONEVALUE ( 'Service Occurred Date'[Service Occurred Month] ) )",
              "                || CALCULATE ( HASONEVALUE ( 'Service Occurred Date'[Service Occurred Fiscal Month] ) )",
              "        ),",
              "    CALCULATE ( SUM ( 'Billing Transactions'[Billable Count Value] ) ),",
              "    BLANK ()",
              ")"
            ],
            "formatString": "#,0"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_DbSchemaName",
            "value": "analysis"
          },
          {
            "name": "_TM_ExtProp_DbTableName",
