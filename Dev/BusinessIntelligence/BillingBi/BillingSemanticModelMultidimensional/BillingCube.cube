          <Name>PriceItemCode</Name>
          <Value>UrlEscapeFragment([Price Item].[Price Item Code].CurrentMember.Properties("Key"))</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>Category</Name>
          <Value>UrlEscapeFragment([Price Item].[Category].CurrentMember.Properties("Key"))</Value>
        </ReportParameter>
        <ReportParameter>
