  <MdxScripts>
    <MdxScript dwd:design-time-name="fe68f434-e448-406f-b428-8be968017353">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[General Forwarding Engine / Active Staff]
 AS IIF(IsEmpty([Measures].[Active Staff]), NULL, [Measures].[General Forwarding Engine] / [Measures].[Active Staff]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Billing Transactions'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Actions>
    <Action xsi:type="ReportAction" dwd:design-time-name="0a15bd41-6058-4fc9-baee-5796399968d5">
      <ID>Report Action</ID>
      <Name>Report - Chargeable Details</Name>
      <TargetType>Cells</TargetType>
      <Target></Target>
      <Condition>([Billing Period].[Calendar].CurrentMember.Level IS [Billing Period].[Calendar].[Month]
OR
[Billing Period].[Fiscal].CurrentMember.Level IS [Billing Period].[Fiscal].[Fiscal Month]
OR
[Billing ISO Week].[ISO Week By Year].CurrentMember.Level IS [Billing ISO Week].[ISO Week By Year].[Iso Week])
AND
(
    [Price Item].[Price Item Hierarchy].CurrentMember.Level IS [Price Item].[Price Item Hierarchy].[Code Feature]
OR
    ([Price Item].[Category].CurrentMember.Level IS [Price Item].[Category].[Category]
    AND
    [Price Item].[Price Item Code].CurrentMember.Level IS [Price Item].[Price Item Code].[Price Item Code])
)
AND 
(
[Client].[By Client System].CurrentMember.Level IS [Client].[By Client System].[Client System]
OR
[Client].[By Client System].CurrentMember.Level IS [Client].[By Client System].[Company]
OR
[Client].[By Home Country].CurrentMember.Level IS [Client].[By Home Country].[Company]
OR
[Client].[By Hosted Location].CurrentMember.Level IS [Client].[By Hosted Location].[Company]
)</Condition>
      <Type>Report</Type>
      <ReportServer>http://sydbilling.bi.wtg.zone/ReportServer/</ReportServer>
      <Path>Pages/ReportViewer.aspx?%2fBilling%2fChargeable+Details</Path>
      <ReportParameters>
        <ReportParameter>
          <Name>BillingPeriod</Name>
          <Value>UrlEscapeFragment(
IIF(
[Billing Period].[Calendar].CurrentMember.Level IS [Billing Period].[Calendar].[Month],
[Billing Period].[Calendar].CurrentMember.Properties("Key"),
[Billing Period].[Fiscal].CurrentMember.Properties("Key")
)
)</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>CodeFeature</Name>
          <Value>UrlEscapeFragment([Price Item].[Price Item Hierarchy].CurrentMember.Properties("Key"))</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>PriceItemCode</Name>
          <Value>UrlEscapeFragment([Price Item].[Price Item Code].CurrentMember.Properties("Key"))</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>Category</Name>
          <Value>UrlEscapeFragment([Price Item].[Category].CurrentMember.Properties("Key"))</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>DatabaseNumber</Name>
          <Value>UrlEscapeFragment(
IIF(
[Client].[By Client System].CurrentMember.Level IS [Client].[By Client System].[Client System],
[Client].[By Client System].CurrentMember.Properties("Key1"),
"0"
)
)</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>ClientCompanyPK</Name>
          <Value>UrlEscapeFragment(
IIF(
[Client].[By Hosted Location].CurrentMember.Level IS [Client].[By Hosted Location].[Company],
[Client].[By Hosted Location].CurrentMember.Properties("Key"),
  IIF(
  [Client].[By Home Country].CurrentMember.Level IS [Client].[By Home Country].[Company],
  [Client].[By Home Country].CurrentMember.Properties("Key"),
    IIF(
    [Client].[By Client System].CurrentMember.Level IS [Client].[By Client System].[Company],
    [Client].[By Client System].CurrentMember.Properties("Key"),
    "0")
   )
)
)</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>IsoWeek</Name>
          <Value>UrlEscapeFragment([Billing ISO Week].[ISO Week By Year].CurrentMember.Properties("Key"))</Value>
        </ReportParameter>
      </ReportParameters>
      <ReportFormatParameters>
        <ReportFormatParameter>
          <Name>rs:Command</Name>
          <Value>Render</Value>
        </ReportFormatParameter>
        <ReportFormatParameter>
          <Name>rs:Renderer</Name>
          <Value>HTML5</Value>
        </ReportFormatParameter>
      </ReportFormatParameters>
    </Action>
    <Action xsi:type="ReportAction" dwd:design-time-name="da6d42a4-ab42-49fe-b788-9ec48c15bdff">
      <ID>Report Action 1</ID>
