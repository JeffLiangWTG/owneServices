          <Value>UrlEscapeFragment(
IIF(
[Client].[By Client System].CurrentMember.Level IS [Client].[By Client System].[Client System],
[Client].[By Client System].CurrentMember.Properties("Key1"),
"0"
)
)</Value>
        </ReportParameter>
        <ReportParameter>
          <Name>ClientCompanyPK</Name>
          <Value>UrlEscapeFragment(
IIF(
[Client].[By Hosted Location].CurrentMember.Level IS [Client].[By Hosted Location].[Company],
[Client].[By Hosted Location].CurrentMember.Properties("Key"),
  IIF(
  [Client].[By Home Country].CurrentMember.Level IS [Client].[By Home Country].[Company],
  [Client].[By Home Country].CurrentMember.Properties("Key"),
    IIF(
    [Client].[By Client System].CurrentMember.Level IS [Client].[By Client System].[Company],
