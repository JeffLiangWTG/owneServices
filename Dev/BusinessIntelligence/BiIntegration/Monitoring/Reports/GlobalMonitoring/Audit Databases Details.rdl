<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="WiseGridReporting">
      <DataSourceReference>WiseGridReporting</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b6af40b6-efb6-4428-9246-e004f6443fd7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="OverallAuditDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MetricId">
            <Value>=Parameters!MetricId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SupValue1Int">
            <Value>=Parameters!SupValue1Int.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SupValue2String">
            <Value>=Parameters!SupValue2String.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @MainDbMaxIncID int, @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])
set @MainDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

declare @MinLatencyValue int, @MaxLatencyValue int
declare @MinLastLoadDuration int, @MaxLastLoadDuration int
declare @MinIndexReorganizeDuration int, @MaxIndexReorganizeDuration int
declare @MinIndexReorganizeLatency int, @MaxIndexReorganizeLatency int

SET @MinLatencyValue = CASE 
					WHEN @MetricId = 501 THEN -2147483648 
					WHEN @MetricId = 502 THEN 6
					WHEN @MetricId = 503 THEN 16
					WHEN @MetricId = 504 THEN 61
					WHEN @MetricId = 505 THEN 24 * 60 + 1
				END
					
SET @MaxLatencyValue = CASE 
					WHEN @MetricId = 501 THEN 5 
					WHEN @MetricId = 502 THEN 15
					WHEN @MetricId = 503 THEN 60
					WHEN @MetricId = 504 THEN 24 * 60
					WHEN @MetricId = 505 THEN 2147483647
				END

SET @MinLastLoadDuration = CASE 
					WHEN @MetricId = 601 THEN 0 
					WHEN @MetricId = 602 THEN 1
					WHEN @MetricId = 603 THEN 2
					WHEN @MetricId = 604 THEN 6
					WHEN @MetricId = 605 THEN 31
					WHEN @MetricId = 606 THEN 61
					WHEN @MetricId = 607 THEN 60*5 + 1
				END

SET @MaxLastLoadDuration = CASE 
					WHEN @MetricId = 601 THEN 0 
					WHEN @MetricId = 602 THEN 1
					WHEN @MetricId = 603 THEN 5
					WHEN @MetricId = 604 THEN 30
					WHEN @MetricId = 605 THEN 60
					WHEN @MetricId = 606 THEN 60 *5
					WHEN @MetricId = 607 THEN 2147483647
				END

SET @MinIndexReorganizeDuration = CASE 
					WHEN @MetricId = 701 THEN 0 
					WHEN @MetricId = 702 THEN 1
					WHEN @MetricId = 703 THEN 2
					WHEN @MetricId = 704 THEN 6
					WHEN @MetricId = 705 THEN 31
					WHEN @MetricId = 706 THEN 61
					WHEN @MetricId = 707 THEN 60*5 + 1
				END

SET @MaxIndexReorganizeDuration = CASE 
					WHEN @MetricId = 701 THEN 0 
					WHEN @MetricId = 702 THEN 1
					WHEN @MetricId = 703 THEN 5
					WHEN @MetricId = 704 THEN 30
					WHEN @MetricId = 705 THEN 60
					WHEN @MetricId = 706 THEN 60 *5
					WHEN @MetricId = 707 THEN 2147483647
				END

SET @MinIndexReorganizeLatency = CASE 
					WHEN @MetricId = 801 THEN -1 
					WHEN @MetricId = 802 THEN 0
					WHEN @MetricId = 803 THEN 2
					WHEN @MetricId = 804 THEN 3
					WHEN @MetricId = 805 THEN 8
				END

SET @MaxIndexReorganizeLatency = CASE 
					WHEN @MetricId = 801 THEN -1 
					WHEN @MetricId = 802 THEN 1
					WHEN @MetricId = 803 THEN 2
					WHEN @MetricId = 804 THEN 7
					WHEN @MetricId = 805 THEN 2147483647					
				END

SELECT 
	a.[FQDN],
	a.[InstanceName],
    a.[ProductBuild],
	a.SqlServerVersion,
	a.SqlServerProductVersion,
    a.[AuditDbName],
	a.[DataSizeReservedGb] AS AuditDataSizeReservedGb,
	a.[LogSizeReservedGb] AS AuditLogSizeReservedGb,
	a.[DataSizeUsedGb] AS AuditDataSizeUsedGb,
	a.[LogSizeUsedGb] AS AuditLogSizeUsedGb,
	m.[DataSizeReservedGb] AS MainDbDataSizeReservedGb,
	m.[DataSizeUsedGb] AS MainDbDataSizeUsedGb,
	CAST(a.[DataSizeUsedGb] / NULLIF(m.[DataSizeUsedGb], 0) * 100.0 AS NUMERIC(9,2)) AS AuditToMainDBDataUsedRatio,
	CAST(a.DataSizeReservedGb / NULLIF(m.DataSizeReservedGb, 0) * 100.0 AS NUMERIC(9,2)) AS AuditToMainDBDataReservedRatio,
	a.[IsEmpty],
	a.[MainDbSchemaVersion],
	m.[DbVersion],
	a.[MinTranEndTimeUtc],
	a.[MaxTranEndTimeUtc],
	a.[LastMaxLsnProcessed],
	a.[LtmMaxLsn],
	a.[LastPartitioningDateUtc],
	a.[LastIndexRebuildDateUtc],
	a.[DataLossDetected],
	a.[PartitionCount],
	a.[MinPartitionRangeValue],
	a.[MaxPartitionRangeValue],
	a.[NonPartitionedTableCount],
	a.[IndexReorganizeDuration],
	a.[LastLoadDuration],
	a.[LastLoadRowCount],
	a.IPAddress as AuditServerIP--, m.*
FROM [dbo].[Rpt_BI_AuditDB] a
	LEFT JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID
WHERE a.IncrementId = @AuditDbMaxIncID
	AND
	(
	(@MetricId = 301 AND (a.FQDN + '\' + a.InstanceName = m.FQDN + '\' + m.InstanceName OR m.MainDbName IS NULL) AND a.AuditDbName LIKE 'Odyssey______[_]Audit') OR
	(@MetricId = 302 AND a.FQDN + '\' + a.InstanceName &lt;&gt; m.FQDN + '\' + m.InstanceName AND NOT m.MainDbName IS NULL AND a.AuditDbName LIKE 'Odyssey______[_]Audit') OR
	(@MetricId = 303 AND m.IncrementId IS NULL AND a.AuditDbName LIKE 'Odyssey______[_]Audit')	OR
	(@MetricId = 304 AND m.IsCdcEnabled = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit') OR
	(@MetricId = 305 AND a.IsEmpty = 1 AND a.AuditDbName LIKE 'Odyssey______[_]Audit') OR
	(@MetricId = 306 AND a.DataLossDetected = 1 AND a.AuditDbName LIKE 'Odyssey______[_]Audit') OR
	(@MetricId = 307 AND a.AuditDbName NOT LIKE 'Odyssey______[_]Audit') OR
	(@MetricId = 400 AND a.IsEmpty = 0 AND DATEDIFF(mm, a.MinTranEndTimeUtc, GETUTCDATE()) - ISNULL(m.AuditRetentionPeriod, 12) BETWEEN @SupValue1Int AND @SupValue1Int) OR
	(@MetricId = 400 AND @SupValue2String = a.SqlServerVersion) OR
	(@MetricId = 400 AND @SupValue2String IS NULL AND @SupValue1Int IS NULL) OR
	(@MetricId IN (501, 502, 503, 504, 505) AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit' AND 
											((ISNULL(@SupValue1Int,0) = 0 AND DATEDIFF(mi, a.MaxTranEndTimeUtc, a.RecordedTime) BETWEEN @MinLatencyValue AND @MaxLatencyValue) OR
											(@SupValue1Int = 1 AND DateDiff(mi, a.MaxTranEndTimeUtc, m.[LatestCapturedLsnUtcDateTime]) BETWEEN @MinLatencyValue AND @MaxLatencyValue))) OR
	(@MetricId BETWEEN 601 AND 607 AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit' AND 
		CAST(CASE 
					WHEN a.LastLoadDuration &gt; 0 AND a.LastLoadDuration &lt;= 1 THEN 1 
					WHEN a.LastLoadDuration &gt; 1 AND a.LastLoadDuration &lt; 2 THEN 2 
					ELSE FLOOR(a.LastLoadDuration) 
				END AS INT) BETWEEN @MinLastLoadDuration AND @MaxLastLoadDuration) OR
	(@MetricId BETWEEN 701 AND 707 AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit' AND 
		CAST(CASE 
					WHEN a.IndexReorganizeDuration IS NULL THEN 0
					WHEN a.IndexReorganizeDuration &gt; 0 AND a.IndexReorganizeDuration &lt;= 1 THEN 1 
					WHEN a.IndexReorganizeDuration &gt; 1 AND a.IndexReorganizeDuration &lt; 2 THEN 2 
					ELSE FLOOR(a.IndexReorganizeDuration) 
				END AS INT) BETWEEN @MinIndexReorganizeDuration AND @MaxIndexReorganizeDuration) OR
	(@MetricId BETWEEN 801 AND 805 AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit' AND ISNULL(DATEDIFF(DAY, a.LastIndexRebuildDateUtc, a.RecordedTime), -1) BETWEEN @MinIndexReorganizeLatency AND @MaxIndexReorganizeLatency)
	)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FQDN">
          <DataField>FQDN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstanceName">
          <DataField>InstanceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductBuild">
          <DataField>ProductBuild</DataField>
          <rd:TypeName>System.Object</rd:TypeName>
        </Field>
        <Field Name="SqlServerVersion">
          <DataField>SqlServerVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AuditDbName">
          <DataField>AuditDbName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SqlServerProductVersion">
          <DataField>SqlServerProductVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AuditDataSizeReservedGb">
          <DataField>AuditDataSizeReservedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AuditLogSizeReservedGb">
          <DataField>AuditLogSizeReservedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AuditDataSizeUsedGb">
          <DataField>AuditDataSizeUsedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AuditLogSizeUsedGb">
          <DataField>AuditLogSizeUsedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MainDbDataSizeReservedGb">
          <DataField>MainDbDataSizeReservedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MainDbDataSizeUsedGb">
          <DataField>MainDbDataSizeUsedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AuditToMainDBDataUsedRatio">
          <DataField>AuditToMainDBDataUsedRatio</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="AuditToMainDBDataReservedRatio">
          <DataField>AuditToMainDBDataReservedRatio</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="IsEmpty">
          <DataField>IsEmpty</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="MainDbSchemaVersion">
          <DataField>MainDbSchemaVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DbVersion">
          <DataField>DbVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MinTranEndTimeUtc">
          <DataField>MinTranEndTimeUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="MaxTranEndTimeUtc">
          <DataField>MaxTranEndTimeUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LastMaxLsnProcessed">
          <DataField>LastMaxLsnProcessed</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LtmMaxLsn">
          <DataField>LtmMaxLsn</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastPartitioningDateUtc">
          <DataField>LastPartitioningDateUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LastIndexRebuildDateUtc">
          <DataField>LastIndexRebuildDateUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DataLossDetected">
          <DataField>DataLossDetected</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="PartitionCount">
          <DataField>PartitionCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MinPartitionRangeValue">
          <DataField>MinPartitionRangeValue</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MaxPartitionRangeValue">
          <DataField>MaxPartitionRangeValue</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NonPartitionedTableCount">
          <DataField>NonPartitionedTableCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="IndexReorganizeDuration">
          <DataField>IndexReorganizeDuration</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LastLoadDuration">
          <DataField>LastLoadDuration</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="LastLoadRowCount">
          <DataField>LastLoadRowCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AuditServerIP">
          <DataField>AuditServerIP</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="MetricDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>SELECT [Label], [Value]
FROM (VALUES

('All Audit Databases, single server config', 301),
('All Audit Databases, multiple servers config', 302),
('Orphaned Audit Databases', 303),
('Audit Databases with disabled CDC', 304),
('Empty Audit Databases', 305),
('Audit Databases with detected Data Loss', 306),
('Audit Databases with nonstandard DB name', 307),
('All Audit Databases', 400),
('ETL Latency (&lt;= 5 min)', 501),
('ETL Latency (6-15 min)', 502),
('ETL Latency (16-60 min)', 503),
('ETL Latency (1-24 h)', 504),
('ETL Latency (1+ days)', 505),
('AET Load Time (Idle)', 601),
('AET Load Time (&lt; 1s)', 602),
('AET Load Time (1-5 s)', 603),
('AET Load Time (6-30 s)', 604),
('AET Load Time (31-60 s)', 605),
('AET Load Time (1-5 min)', 606),
('AET Load Time (5+ min)', 607),
('ADM Index Reorganize Time (Idle)', 701),
('ADM Index Reorganize Time (&lt; 1s)', 702),
('ADM Index Reorganize Time (1-5 s)', 703),
('ADM Index Reorganize Time (6-30 s)', 704),
('ADM Index Reorganize Time (31-60 s)', 705),
('ADM Index Reorganize Time (1-5 min)', 706),
('ADM Index Reorganize Time (5+ min)', 707),
('ADM Index Reorganize Latency (Idle)', 801),
('ADM Index Reorganize Latency (&lt;= 1 day)', 802),
('ADM Index Reorganize Latency (2 days)', 803),
('ADM Index Reorganize Latency (3-7 days)', 804),
('ADM Index Reorganize Latency (&gt; 1 week)', 805)
) AS ValTable (Label, [Value])
ORDER BY [Value]</CommandText>
      </Query>
      <Fields>
        <Field Name="Label">
          <DataField>Label</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Value">
          <DataField>Value</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
