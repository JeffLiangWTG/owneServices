<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="WiseGridReporting">
      <DataSourceReference>WiseGridReporting</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2332c99a-730f-46f1-898c-5fb68563a30f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="OLTPDetailsDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MetricId">
            <Value>=Parameters!MetricId.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SupValue1String">
            <Value>=Parameters!SupValue1String.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SupValue2Int">
            <Value>=Parameters!SupValue2Int.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>set nocount on

declare @MaxIncID int
set @MaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

declare @MaxWeekEndIncID int
DECLARE @TimeOffset INT = -DATEDIFF(hh, GETDATE(), GETUTCDATE())

set @MaxWeekEndIncID = 
	(select max(IncrementId) 
	from [dbo].[Rpt_BI_MainDB]
	where DATEPART(DW, DATEADD(hh, @TimeOffset, RecordedTime)) = 1 OR DATEPART(DW, DATEADD(hh, @TimeOffset, RecordedTime)) = 7
	)

IF OBJECT_ID('tempdb..#XML_DATA', 'U') IS NOT NULL
 DROP TABLE #XML_DATA; 

IF OBJECT_ID('tempdb..#ServiceTaskData', 'U') IS NOT NULL
 DROP TABLE #ServiceTaskData; 

CREATE TABLE #XML_DATA (MainDbName VARCHAR(128) PRIMARY KEY, ServiceTaskData XML)

INSERT INTO #XML_DATA (MainDbName, ServiceTaskData)
SELECT [MainDbName], ServiceTaskData
FROM
	(SELECT [MainDbName], CAST(ServiceTaskData AS XML) AS ServiceTaskData, ROW_NUMBER() OVER (PARTITION BY MainDbName ORDER BY ProductBuild DESC) AS RN
	FROM [dbo].[Rpt_BI_MainDB]
	WHERE IncrementId = @MaxIncID) Q
WHERE Q.RN = 1

CREATE TABLE #ServiceTaskData (MainDbName VARCHAR(128), ServiceTaskCode VARCHAR(10), [Status] VARCHAR(20))

INSERT INTO #ServiceTaskData (MainDbName, ServiceTaskCode, Status)
SELECT 
	r.MainDbName,
	ServiceTask.x.value('@ServiceTaskName', 'nvarchar(max)') as ServiceTaskName,
	CASE ISNULL(ServiceTask.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS Status
FROM [dbo].[Rpt_BI_MainDB] r
	LEFT JOIN #XML_DATA xd ON xd.MainDbName = r.MainDbName	
	OUTER APPLY xd.ServiceTaskData.nodes('ServiceTask') AS ServiceTask(x)
WHERE r.IncrementId = @MaxIncID

CREATE INDEX IX_ServiceTaskData ON #ServiceTaskData (MainDbName, ServiceTaskCode) INCLUDE(Status)

;WITH cte_main AS

(
SELECT r.[FQDN]
      ,r.[InstanceName]
      ,r.[ProductBuild]
      ,r.[MainDbName]
      ,r.[IsCdcEnabled]
      ,r.[DataSizeReservedGb]
      ,r.[LogSizeReservedGb]
      ,r.[DataSizeUsedGb]
      ,r.[LogSizeUsedGb]
      ,r.[DwServerName]
	  ,CASE 
		WHEN CAST(CAST(SUBSTRING(r.[DbVersion], 1, CASE CHARINDEX('.', r.[DbVersion]) WHEN 0 THEN LEN(r.[DbVersion]) ELSE CHARINDEX('.', r.[DbVersion]) - 1 END) AS BIGINT) AS INT) &lt; 3864 THEN r.[DwServerName] 
		ELSE r.[AuditServerName] 
	   END AS AuditServerName
      ,r.[CdcEnabledUtcDate]
      ,r.[EarliestCapturedLsnUtcDateTime]
      ,r.[LatestCapturedLsnUtcDateTime]
      ,r.[DbVersion]
      ,r.[AppVersion]  
      ,r.[PackageBuiltDate]
      ,r.[AuditRetentionPeriod]
      ,r.[IPAddress]
	  ,r.SqlServerVersion
	  ,r.SqlServerProductVersion
	  ,r.ServiceTaskData
	  ,r.RecordedTime
	  ,pt.CDC AS CdcStatus
	  ,pt.CDN AS CdnStatus
	  ,ISNULL(pt.asp, 'N/A') AS AspStatus
	  ,ISNULL(pt.aet, 'N/A') AS AetStatus
	  ,ISNULL(pt.EET, 'N/A') AS EetStatus
	  ,ISNULL(pt.BID, 'N/A') AS BidStatus
	  ,ISNULL(pt.BIM, 'N/A') AS BimStatus
	  ,ISNULL(pt.ADM, 'N/A') AS AdmStatus
FROM [dbo].[Rpt_BI_MainDB] r
	LEFT JOIN #XML_DATA xd ON xd.MainDbName = r.MainDbName	
	LEFT JOIN
	(
	select *
	from
	(
		select MainDbName, ServiceTaskCode, [Status]
		from #ServiceTaskData
	) AS st PIVOT(MAX([Status]) FOR ServiceTaskCode IN (CDC, CDN, AET, ADM, ASP, EET, BIM, BID)) AS st
	) PT ON PT.MainDbName = r.MainDbName
WHERE r.IncrementId = @MaxIncID
)

SELECT
	  r.[FQDN]
      ,r.[InstanceName]
      ,r.[ProductBuild]
      ,r.[MainDbName]
      ,r.[IsCdcEnabled]
      ,r.[DataSizeReservedGb]
      ,r.[LogSizeReservedGb]
      ,r.[DataSizeUsedGb]
      ,r.[LogSizeUsedGb]
      ,r.[DwServerName]
      ,r.[AuditServerName]
      ,CASE
	WHEN [BiResetChangeDataCapture] = 'True' THEN 'Y'
	WHEN [BiResetChangeDataCapture] = 'False' THEN 'N'
	ELSE 'N/A'
      END AS CdcReset
      ,r.[CdcEnabledUtcDate]
      ,r.[EarliestCapturedLsnUtcDateTime]
      ,r.[LatestCapturedLsnUtcDateTime]
      ,r.[DbVersion]
      ,r.[AppVersion]  
      ,r.[PackageBuiltDate]
      ,r.[AuditRetentionPeriod]
      ,r.[IPAddress]
	  ,rs.EdwEnabledDataSizeUsedGb
	  ,CAST(100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb AS NUMERIC(11,2)) AS EdwEnabledVsAllTablesRatio
	  ,rs.EdwEnabledDataSizeUsedGb * 2.25 AS EstEdwDbSizeGb
	  ,rs.EdwEnabledDataSizeUsedGb * 0.065 AS EstSsasModelSizeGb
	  ,rs.EdwEnabledDataSizeUsedGb * 0.25 AS EstSsasMemoryRequirementGb
	  ,r.SqlServerVersion
	  ,r.SqlServerProductVersion
	  ,r.CdcStatus AS CdcStatus
	  ,r.CdnStatus AS CdnStatus
	  ,r.AdmStatus AS AdmStatus
	  ,r.AetStatus AS AetStatus
	  ,r.AspStatus AS AspStatus
	  ,r.BidStatus AS BidStatus
	  ,r.BimStatus AS BimStatus
	  ,r.EetStatus AS EetStatus
FROM cte_main r
	LEFT JOIN [dbo].[Rpt_BI_MainDB] rs ON rs.MainDbName = r.MainDbName AND rs.IncrementId = @MaxWeekEndIncID
WHERE 
	(
		(@MetricId = 1 AND (@SupValue1String IS NULL OR (r.SqlServerVersion = @SupValue1String))) OR
		(@MetricId = 2 AND r.IsCdcEnabled = 1 AND (@SupValue1String IS NULL OR 
				(@SupValue2Int = 401 AND r.CdcStatus = @SupValue1String) OR
				(@SupValue2Int = 402 AND r.AetStatus = @SupValue1String) OR
				(@SupValue2Int = 403 AND r.BidStatus = @SupValue1String) OR
				(@SupValue2Int = 404 AND r.CdnStatus = @SupValue1String) OR
				(@SupValue2Int = 405 AND r.EetStatus = @SupValue1String) OR
				(@SupValue2Int = 406 AND r.AspStatus = @SupValue1String) OR
				(@SupValue2Int = 407 AND r.BimStatus = @SupValue1String) OR
				(@SupValue2Int = 408 AND r.AdmStatus = @SupValue1String) 
				)) OR
		(@MetricId = 3 AND r.AuditServerName IS NOT NULL) OR
		(@MetricId = 4 AND r.DwServerName IS NOT NULL) OR
		(@MetricId = 5 AND (r.DwServerName IS NOT NULL OR r.AuditServerName IS NOT NULL) AND r.IsCdcEnabled = 0) OR
		(@MetricId = 6 AND r.AuditServerName IS NULL AND r.IsCdcEnabled = 1) OR
		(@MetricId = 101 AND r.IsCdcEnabled = 1 AND DateDiff(dd, r.EarliestCapturedLsnUtcDateTime, r.RecordedTime) &lt;= 3) OR
		(@MetricId = 102 AND r.IsCdcEnabled = 1 AND DateDiff(dd, r.EarliestCapturedLsnUtcDateTime, r.RecordedTime) BETWEEN 4 AND 7) OR
		(@MetricId = 103 AND r.IsCdcEnabled = 1 AND DateDiff(dd, r.EarliestCapturedLsnUtcDateTime, r.RecordedTime) BETWEEN 8 AND 14) OR
		(@MetricId = 104 AND r.IsCdcEnabled = 1 AND DateDiff(dd, r.EarliestCapturedLsnUtcDateTime, r.RecordedTime) &gt; 14) OR
		(@MetricId = 201 AND r.IsCdcEnabled = 1 AND DateDiff(mi, r.[LatestCapturedLsnUtcDateTime], r.RecordedTime) &lt;= 5) OR
		(@MetricId = 202 AND r.IsCdcEnabled = 1 AND DateDiff(mi, r.[LatestCapturedLsnUtcDateTime], r.RecordedTime) BETWEEN 6 AND 15) OR
		(@MetricId = 203 AND r.IsCdcEnabled = 1 AND DateDiff(mi, r.[LatestCapturedLsnUtcDateTime], r.RecordedTime) BETWEEN 16 AND 60) OR
		(@MetricId = 204 AND r.IsCdcEnabled = 1 AND DateDiff(mi, r.[LatestCapturedLsnUtcDateTime], r.RecordedTime) BETWEEN 61 AND 60*24) OR
		(@MetricId = 205 AND r.IsCdcEnabled = 1 AND DateDiff(mi, r.[LatestCapturedLsnUtcDateTime], r.RecordedTime) &gt; 60*24) OR
		(@MetricId = 301 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 5) OR
		(@MetricId = 302 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 5 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 10 ) OR
		(@MetricId = 303 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 10 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 15 ) OR
		(@MetricId = 304 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 15 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 20 ) OR
		(@MetricId = 305 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 20 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 25 ) OR
		(@MetricId = 306 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 25 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 30 ) OR
		(@MetricId = 307 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 30 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &lt;= 35 ) OR
		(@MetricId = 308 AND 100.0 * rs.EdwEnabledDataSizeUsedGb / rs.DataSizeUsedGb &gt; 35)
	)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FQDN">
          <DataField>FQDN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InstanceName">
          <DataField>InstanceName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
