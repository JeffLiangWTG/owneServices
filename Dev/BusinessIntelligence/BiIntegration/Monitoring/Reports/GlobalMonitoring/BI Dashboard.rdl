          <Textbox Name="RecordedTimeUtc">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!MinRecordedTimeUtc.Value, "RecordedTimeMainDb"), "yyyy-MM-dd HH:mm:ss") + " --- " + Format(First(Fields!MaxRecordedTimeUtc.Value, "RecordedTimeMainDb"), "yyyy-MM-dd HH:mm:ss")</Value>
                    <Style>
                      <FontFamily>Segoe UI Light</FontFamily>
                      <FontSize>9pt</FontSize>
