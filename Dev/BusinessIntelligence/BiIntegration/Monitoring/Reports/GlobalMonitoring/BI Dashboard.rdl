    <DataSet Name="SqlVersionMainDbDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>SET NOCOUNT ON
DECLARE @MaxIncID INT
SET @MaxIncID = (SELECT MAX(IncrementId) FROM [dbo].[Rpt_BI_MainDB])

SELECT  
	r.SqlServerVersion,
	COUNT(r.Id) AS Number_of_DBs,
	1 AS MetricID
FROM [dbo].[Rpt_BI_MainDB] r 
WHERE r.IncrementId = @MaxIncID
GROUP BY r.SqlServerVersion</CommandText>
      </Query>
      <Fields>
        <Field Name="SqlServerVersion">
          <DataField>SqlServerVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
