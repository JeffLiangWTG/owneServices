<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="WiseGridReporting">
      <DataSourceReference>WiseGridReporting</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>ea738a60-637d-4885-9147-404ccb6b0d11</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="OverallMainDbDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>declare @MaxIncID int
set @MaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

SELECT 
	ROW_NUMBER() OVER(ORDER BY (SELECT NULL) ASC) AS MetricId, 
	Category, 
	NumberOfDatabases as [Number of DBs]
FROM   
   (select 
		count(*) as [Total #], 
		count(case when IsCdcEnabled = 1 then IncrementId else null end) as [# of DBs with CDC],
		count(case when DwServerName is not null then IncrementId else null end) as [# of DBs with DW string],
		count(case when CASE 
							WHEN CAST(CAST(SUBSTRING([DbVersion], 1, CASE CHARINDEX('.', [DbVersion]) WHEN 0 THEN LEN([DbVersion]) ELSE CHARINDEX('.', [DbVersion]) - 1 END) AS BIGINT) AS INT) &lt; 3864 THEN [DwServerName] 
							ELSE [AuditServerName] 
						END is not null then IncrementId else null end) as [# of DBs with Audit string],
		count(case when (DwServerName is not null OR CASE 
														WHEN CAST(CAST(SUBSTRING([DbVersion], 1, CASE CHARINDEX('.', [DbVersion]) WHEN 0 THEN LEN([DbVersion]) ELSE CHARINDEX('.', [DbVersion]) - 1 END) AS BIGINT) AS INT) &lt; 3864 THEN [DwServerName] 
														ELSE [AuditServerName] 
													END is not null) and IsCdcEnabled = 0 then IncrementId else null end) as [# of DBs (DW/Audit string is set, disabled CDC)],
		count(case when CASE 
							WHEN CAST(CAST(SUBSTRING([DbVersion], 1, CASE CHARINDEX('.', [DbVersion]) WHEN 0 THEN LEN([DbVersion]) ELSE CHARINDEX('.', [DbVersion]) - 1 END) AS BIGINT) AS INT) &lt; 3864 THEN [DwServerName] 
							ELSE [AuditServerName] 
						END is null and IsCdcEnabled = 1 then IncrementId else null end) as [# of DBs (No Audit string, enabled CDC)]
	from [dbo].[Rpt_BI_MainDB] 
	where IncrementId = @MaxIncID) p  
UNPIVOT  
   (NumberOfDatabases FOR Category IN   
      ([Total #], [# of DBs with CDC], [# of DBs with Audit string], [# of DBs with DW string], [# of DBs (DW/Audit string is set, disabled CDC)], [# of DBs (No Audit string, enabled CDC)])  
)AS unpvt; 
</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="MetricId">
          <DataField>MetricId</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number of DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RetentionPeriodDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on
declare @MaxIncID int
set @MaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

declare @Bands table (MetricID INT, MetricName VARCHAR(200), MinValue INT, MaxValue INT)
insert into @Bands (MetricID, MetricName, MinValue, MaxValue)
values 
(101, '&lt;= 3 days', 0, 3), 
(102, '[4-7] days', 4, 7),
(103, '[8-14] days', 8, 14),
(104, '&gt; 14 days', 15, 2147483647)


select  
	b.MetricID,
	b.MetricName,
	COUNT(r.Id) As Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_MainDB] r on DateDiff(dd, EarliestCapturedLsnUtcDateTime, RecordedTime) BETWEEN b.MinValue AND b.MaxValue 
		AND r.IncrementId = @MaxIncID AND r.isCdcEnabled = 1
GROUP BY 
	b.MetricID,
	b.MetricName</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricId">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CdcCaptureLatencyDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on
declare @MaxIncID int
set @MaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

declare @Bands table (MetricID INT, MetricName VARCHAR(200), MinValue INT, MaxValue INT)
insert into @Bands (MetricID, MetricName, MinValue, MaxValue)
values 
(201, '&lt;= 5 min', 0, 5), 
(202, '[6-15] min', 6, 15),
(203, '[16-60] min', 16, 60),
(204, '[1-24] h', 61, 60*24),
(205, '1+ days', 60*24 + 1, 2147483647)


select  
	b.MetricID,
	b.MetricName,
	COUNT(r.Id) As Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_MainDB] r on DateDiff(mi, r.[LatestCapturedLsnUtcDateTime], r.RecordedTime) BETWEEN b.MinValue AND b.MaxValue 
		AND r.IncrementId = @MaxIncID AND r.isCdcEnabled = 1
GROUP BY 
	b.MetricID,
	b.MetricName
</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricId">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RecordedTimeMainDb">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>declare @MaxIncID int
set @MaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

SELECT MIN(RecordedTime) as MinRecordedTimeUtc, MAX(RecordedTime) as MaxRecordedTimeUtc
FROM [dbo].[Rpt_BI_MainDB]
WHERE IncrementId = @MaxIncID</CommandText>
      </Query>
      <Fields>
        <Field Name="MinRecordedTimeUtc">
          <DataField>MinRecordedTimeUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="MaxRecordedTimeUtc">
          <DataField>MaxRecordedTimeUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
