    <DataSet Name="OverallAuditDbDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>declare @MainDbMaxIncID int, @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])
set @MainDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

SELECT 
	301 AS MetricId, 
	'Total #, single server config' AS Category, 
	count(DISTINCT a.AuditDbName) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB]  a
	LEFT JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID   
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND (a.FQDN + '\' + a.InstanceName = m.FQDN + '\' + m.InstanceName OR m.MainDbName IS NULL)
	AND a.AuditDbName LIKE 'Odyssey______[_]Audit'
   
UNION ALL 

SELECT 
	302 AS MetricId, 
	'Total #, multiple servers config' AS Category,
	count(DISTINCT a.AuditDbName) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB]  a
	LEFT JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID   
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND a.FQDN + '\' + a.InstanceName &lt;&gt; m.FQDN + '\' + m.InstanceName
	AND a.AuditDbName LIKE 'Odyssey______[_]Audit'

UNION ALL 

SELECT 
	303 AS MetricId, 
	'# of Orphaned Audit DBs' AS Category,
	count(*) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB] a
	LEFT JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID   
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND m.id IS NULL
	AND a.AuditDbName LIKE 'Odyssey______[_]Audit'

UNION ALL 

SELECT 
	304 AS MetricId, 
	'# of Audit DBs with disabled CDC' AS Category,
	count(*) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB] a
	JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID AND m.IsCdcEnabled = 0
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND a.AuditDbName LIKE 'Odyssey______[_]Audit'

UNION ALL 

SELECT 
	305 AS MetricId, 
	'# of empty Audit DBs' AS Category,
	count(*) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB] a
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND a.IsEmpty = 1
	AND a.AuditDbName LIKE 'Odyssey______[_]Audit'

UNION ALL 

SELECT 
	306 AS MetricId, 
	'# of Audit DBs with detected Data Loss' AS Category,
	count(*) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB] a
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND a.IsEmpty = 0
	AND a.DataLossDetected = 1
	AND a.AuditDbName LIKE 'Odyssey______[_]Audit'

UNION ALL 

SELECT 
	307 AS MetricId, 
	'# of Audit DBs with nonstandard DB name' AS Category,
	count(*) as [Number of DBs]
FROM [dbo].[Rpt_BI_AuditDB] a
WHERE a.IncrementId = @AuditDbMaxIncID   
	AND a.AuditDbName NOT LIKE 'Odyssey______[_]Audit'</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricId">
          <DataField>MetricId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number of DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ActualAuditRetentionPeriodDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>declare @MainDbMaxIncID int, @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])
set @MainDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

SELECT 
	DATEDIFF(mm, a.MinTranEndTimeUtc, GETUTCDATE()) - ISNULL(m.AuditRetentionPeriod, 12) AS AuditRetentionActualMinusPlanned,
	COUNT(a.IncrementId) AS NumberOfDatabases
FROM [dbo].[Rpt_BI_AuditDB] a
	INNER JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID
WHERE a.IncrementId = @AuditDbMaxIncID 
	AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit'
GROUP BY DATEDIFF(mm, a.MinTranEndTimeUtc, GETUTCDATE()) - ISNULL(m.AuditRetentionPeriod, 12)</CommandText>
      </Query>
      <Fields>
        <Field Name="AuditRetentionActualMinusPlanned">
          <DataField>AuditRetentionActualMinusPlanned</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>NumberOfDatabases</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AuditEtlLatencyDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on

declare @MainDbMaxIncID int, @AuditDbMaxIncID int, @EtlToRecordTimeSystemID int, @EtlToCdcTimeSystemID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])
set @MainDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])
set @EtlToRecordTimeSystemID = 0
set @EtlToCdcTimeSystemID = 1

declare @Bands table (MetricID INT, MetricName VARCHAR(200), SystemID INT, MinValue INT, MaxValue INT)
insert into @Bands (MetricID, MetricName, SystemID, MinValue, MaxValue)
values 
(501, '&lt;= 5 min', @EtlToRecordTimeSystemID, -2147483648, 5), 
(502, '[6-15] min', @EtlToRecordTimeSystemID, 6, 15),
(503, '[16-60] min', @EtlToRecordTimeSystemID, 16, 60),
(504, '[1-24] h', @EtlToRecordTimeSystemID, 61, 60*24),
(505, '1+ days', @EtlToRecordTimeSystemID, 60*24 + 1, 2147483647)

insert into @Bands (MetricID, MetricName, SystemID, MinValue, MaxValue)
select MetricID, MetricName, @EtlToCdcTimeSystemID, case when MetricID = 501 then -999999 else MinValue end, MaxValue
from @Bands
order by MetricID

select  
	b.MetricID,
	b.MetricName,
	case when b.SystemID = @EtlToRecordTimeSystemID then 'Data Collection Time' else 'CDC Capture Time' end as SystemName,
	b.SystemID,
	COUNT(a.Id) As Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_AuditDB] a on a.IncrementId = @AuditDbMaxIncID AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit' 
		AND DateDiff(mi, a.MaxTranEndTimeUtc, a.RecordedTime) BETWEEN b.MinValue AND b.MaxValue 
WHERE b.SystemID = @EtlToRecordTimeSystemID
GROUP BY 
	b.MetricID,
	b.MetricName,
	case when b.SystemID = @EtlToRecordTimeSystemID then 'Recorded Time' else 'CDC Capture Time' end,
	b.SystemID

UNION ALL

select  
	b.MetricID,
	b.MetricName,
	case when b.SystemID = @EtlToRecordTimeSystemID then 'Data Collection Time' else 'CDC Capture Time' end,
	b.SystemID,
	COUNT(m.Id) As Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_AuditDB] a on a.IncrementId = @AuditDbMaxIncID AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit'		
	LEFT JOIN [dbo].[Rpt_BI_MainDB] m on DateDiff(mi, a.MaxTranEndTimeUtc, m.[LatestCapturedLsnUtcDateTime]) BETWEEN b.MinValue AND b.MaxValue 
		AND m.IncrementId = @MainDbMaxIncID AND m.isCdcEnabled = 1
		AND m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6)
WHERE b.SystemID = @EtlToCdcTimeSystemID
GROUP BY 
	b.MetricID,
	b.MetricName,
	case when b.SystemID = @EtlToRecordTimeSystemID then 'Data Collection Time' else 'CDC Capture Time' end,
	b.SystemID</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SystemName">
          <DataField>SystemName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SystemID">
          <DataField>SystemID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AuditSpaceUsedRatioDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>declare @MainDbMaxIncID int, @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])
set @MainDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

SELECT 
	CAST(100.0 * ISNULL(m.AuditRetentionPeriod, 12) / DATEDIFF(mm, a.MinTranEndTimeUtc, a.MaxTranEndTimeUtc) * a.DataSizeUsedGb / m.DataSizeUsedGb / 5 AS INT) * 5 + 5 AS BandRatio,
	COUNT(a.IncrementId) AS Number_of_DBs
FROM [dbo].[Rpt_BI_AuditDB] a
	INNER JOIN [dbo].[Rpt_BI_MainDB] m ON m.MainDbName = LEFT(a.AuditDbName, LEN(a.AuditDbName) - 6) AND m.IncrementId = @MainDbMaxIncID
WHERE a.IncrementId = @AuditDbMaxIncID 
	AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit'
	AND DATEDIFF(mm, a.MinTranEndTimeUtc, a.MaxTranEndTimeUtc) &lt;&gt; 0
GROUP BY CAST(100.0 * ISNULL(m.AuditRetentionPeriod, 12) / DATEDIFF(mm, a.MinTranEndTimeUtc, a.MaxTranEndTimeUtc) * a.DataSizeUsedGb / m.DataSizeUsedGb / 5 AS INT)
ORDER BY 1</CommandText>
      </Query>
      <Fields>
        <Field Name="BandRatio">
          <DataField>BandRatio</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AuditEtlLastLoadDurationDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on
declare @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])

declare @Bands table (MetricID INT, MetricName VARCHAR(200), MinValue INT, MaxValue INT)
insert into @Bands (MetricID, MetricName, MinValue, MaxValue)
values 
(601, 'Idle (0s)', 0, 0), 
(602, '&lt; 1s', 1, 1),
(603, '[1-5] s', 2, 5),
(604, '[6-30] s', 6, 30),
(605, '[31-60] s', 31, 60),
(606, '[1-5] m', 61, 60*5),
(607, '5+ m', 60*5 + 1, 2147483647)

SELECT 	
	b.MetricID, 
	b.MetricName,
	COUNT(a.IncrementId) AS Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_AuditDB] a ON a.IncrementId = @AuditDbMaxIncID AND a.IsEmpty = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit'
		AND CAST(CASE 
					WHEN a.LastLoadDuration &gt; 0 AND a.LastLoadDuration &lt;= 1 THEN 1 
					WHEN a.LastLoadDuration &gt; 1 AND a.LastLoadDuration &lt; 2 THEN 2 
					ELSE FLOOR(a.LastLoadDuration) 
				END AS INT) BETWEEN b.MinValue AND b.MaxValue
GROUP BY b.MetricID, b.MetricName
ORDER BY b.MetricID DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AdmIndexReorganizeDurationDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on
declare @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])

declare @Bands table (MetricID INT, MetricName VARCHAR(200), MinValue INT, MaxValue INT)
insert into @Bands (MetricID, MetricName, MinValue, MaxValue)
values 
(701, 'Idle (0s)', 0, 0), 
(702, '&lt; 1s', 1, 1),
(703, '[1-5] s', 2, 5),
(704, '[6-30] s', 6, 30),
(705, '[31-60] s', 31, 60),
(706, '[1-5] m', 61, 60*5),
(707, '5+ m', 60*5 + 1, 2147483647)

SELECT 	
	b.MetricID, 
	b.MetricName,
	COUNT(a.IncrementId) AS Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_AuditDB] a ON a.IncrementId = @AuditDbMaxIncID AND a.IsEmpty = 0 AND a.IsIndexReorganizeDurationMissing = 0 AND a.AuditDbName LIKE 'Odyssey______[_]Audit'
		AND CAST(CASE 
					WHEN ISNULL(a.IndexReorganizeDuration, 0) &gt; 0 AND ISNULL(a.IndexReorganizeDuration, 0) &lt;= 1 THEN 1 
					WHEN ISNULL(a.IndexReorganizeDuration, 0) &gt; 1 AND ISNULL(a.IndexReorganizeDuration, 0) &lt; 2 THEN 2 
					ELSE FLOOR(ISNULL(a.IndexReorganizeDuration, 0)) 
				END AS INT) BETWEEN b.MinValue AND b.MaxValue
GROUP BY b.MetricID, b.MetricName
ORDER BY b.MetricID DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AdmIndexReorganizeLatencyDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on
declare @AuditDbMaxIncID int
set @AuditDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_AuditDB])

declare @Bands table (MetricID INT, MetricName VARCHAR(200), MinValue INT, MaxValue INT)
insert into @Bands (MetricID, MetricName, MinValue, MaxValue)
values 
(801, 'Idle', -1, -1), 
(802, '&lt;= 1 day', 0, 1), 
(803, '2 days', 2, 2),
(804, '3-7 days', 3, 7),
(805, '&gt; 1 week', 8, 2147483647)

SELECT 	
	b.MetricID, 
	b.MetricName,
	COUNT(a.IncrementId) AS Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_AuditDB] a ON a.IncrementId = @AuditDbMaxIncID AND a.IsEmpty = 0 AND a.IsIndexReorganizeDurationMissing = 0
		AND ISNULL(DATEDIFF(DAY, LastIndexRebuildDateUtc, RecordedTime), -1) BETWEEN b.MinValue AND b.MaxValue AND a.AuditDbName LIKE 'Odyssey______[_]Audit'
GROUP BY b.MetricID, b.MetricName
ORDER BY b.MetricID DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SizeOfEdwEnabledTablesDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on
declare @MainDbMaxIncID int
DECLARE @TimeOffset INT = -DATEDIFF(hh, GETDATE(), GETUTCDATE())

set @MainDbMaxIncID = 
	(select max(IncrementId) 
	from [dbo].[Rpt_BI_MainDB]
	where DATEPART(DW, DATEADD(hh, @TimeOffset, RecordedTime)) = 1 OR DATEPART(DW, DATEADD(hh, @TimeOffset, RecordedTime)) = 7
	)

declare @Bands table (MetricID INT, MetricName VARCHAR(200), MinValue NUMERIC(12, 2), MaxValue NUMERIC(12, 2))
insert into @Bands (MetricID, MetricName, MinValue, MaxValue)
values 
(301, '&lt;= 5%', 0, 5), 
(302, '5-10 %', 5, 10),
(303, '10-15 %', 10, 15),
(304, '15-20 %', 15, 20),
(305, '20-25 %', 20, 25),
(306, '25-30 %', 25, 30),
(307, '30-35 %', 30, 35),
(308, '&gt; 35%', 35, 2147483647)


SELECT 
	b.MetricID, 
	b.MetricName,
	COUNT(m.IncrementId) AS Number_of_DBs
FROM @Bands b
	LEFT JOIN [dbo].[Rpt_BI_MainDB] m ON m.IncrementId = @MainDbMaxIncID AND 100.0 * m.EdwEnabledDataSizeUsedGb / m.DataSizeUsedGb &gt; b.MinValue AND 100.0 * m.EdwEnabledDataSizeUsedGb / m.DataSizeUsedGb &lt;= b.MaxValue
GROUP BY b.MetricID, b.MetricName
ORDER BY b.MetricID DESC
</CommandText>
      </Query>
      <Fields>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MetricName">
          <DataField>MetricName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Number_of_DBs">
          <DataField>Number_of_DBs</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="BiStorageMemoryRequirementsDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on

DECLARE @TimeOffset INT = -DATEDIFF(hh, GETDATE(), GETUTCDATE())
DECLARE @MaxWeekEndIncID INT

set @MaxWeekEndIncID = 
	(select max(IncrementId) 
	from [dbo].[Rpt_BI_MainDB]
	where DATEPART(DW, DATEADD(hh, @TimeOffset, RecordedTime)) = 1 OR DATEPART(DW, DATEADD(hh, @TimeOffset, RecordedTime)) = 7
	)

declare @MainDbMaxIncID int
set @MainDbMaxIncID = (select max(IncrementId) from [dbo].[Rpt_BI_MainDB])

;WITH CTE_DbSize AS (

select 
	SUM(m.DataSizeUsedGb) AS DataSizeUsedGb,
	SUM(m.EdwEnabledDataSizeUsedGb) AS EdwEnabledDataSizeUsedGb
FROM [dbo].[Rpt_BI_MainDB] m
WHERE m.IncrementId = @MaxWeekEndIncID
),

CTE_DbVersion AS (

select 
	CAST(SUBSTRING(dbVersion, 1, CASE CHARINDEX('.', dbVersion) WHEN 0 THEN LEN(dbVersion) ELSE CHARINDEX('.', dbVersion) - 1 END) AS BIGINT) AS FirstPartDbVersion,
	CAST(SUBSTRING(dbVersion, CASE CHARINDEX('.', dbVersion) WHEN 0 THEN LEN(dbVersion) + 1 ELSE CHARINDEX('.', dbVersion) + 1 END, 1000) AS BIGINT) AS SecondPartDbVersion
FROM [dbo].[Rpt_BI_MainDB] m
WHERE m.IncrementId = @MainDbMaxIncID
),

CTE_DbVersionAgg AS (

select 
	CAST(MAX(v.FirstPartDbVersion * 10000000 + v.SecondPartDbVersion) / 10000000 AS VARCHAR(10)) + '.' + CAST(MAX(v.FirstPartDbVersion * 10000000 + v.SecondPartDbVersion) % 10000000 AS VARCHAR(10)) AS MaxDbVersion,
	CAST(MIN(v.FirstPartDbVersion * 10000000 + v.SecondPartDbVersion) / 10000000 AS VARCHAR(10)) + '.' + CAST(MIN(v.FirstPartDbVersion * 10000000 + v.SecondPartDbVersion) % 10000000 AS VARCHAR(10)) AS MinDbVersion
FROM CTE_DbVersion v
)

select 
	s.DataSizeUsedGb AS TotalDataSizeUsedGb,
	s.EdwEnabledDataSizeUsedGb AS TotalEdwEnabledDataSizeUsedGb,
	1.0 * s.EdwEnabledDataSizeUsedGb / s.DataSizeUsedGb AS TotalEdwEnabledVsAllTablesRatio,
	s.EdwEnabledDataSizeUsedGb * 2.25 AS EstEdwDbSizeGb,
	s.EdwEnabledDataSizeUsedGb * 0.065 AS EstSsasModelSizeGb,
	s.EdwEnabledDataSizeUsedGb * 0.25 AS EstSsasMemoryRequirementGb,
	v.MaxDbVersion,
	v.MinDbVersion
FROM CTE_DbSize s, CTE_DbVersionAgg v
</CommandText>
      </Query>
      <Fields>
        <Field Name="TotalDataSizeUsedGb">
          <DataField>TotalDataSizeUsedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalEdwEnabledDataSizeUsedGb">
          <DataField>TotalEdwEnabledDataSizeUsedGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalEdwEnabledVsAllTablesRatio">
          <DataField>TotalEdwEnabledVsAllTablesRatio</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EstEdwDbSizeGb">
          <DataField>EstEdwDbSizeGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EstSsasModelSizeGb">
          <DataField>EstSsasModelSizeGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EstSsasMemoryRequirementGb">
          <DataField>EstSsasMemoryRequirementGb</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MaxDbVersion">
          <DataField>MaxDbVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MinDbVersion">
          <DataField>MinDbVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="BiServiceTaskDataSet">
      <Query>
        <DataSourceName>WiseGridReporting</DataSourceName>
        <CommandText>set nocount on

DECLARE @MaxIncID INT
SET @MaxIncID = (SELECT MAX(IncrementId) FROM [dbo].[Rpt_BI_MainDB])

;WITH cte AS
(
	SELECT MainDbName, CAST(ServiceTaskData AS XML) as ServiceTaskData
	FROM dbo.[Rpt_BI_MainDB]
	WHERE incrementId = @MaxIncID
		and IsCdcEnabled = 1
) 

SELECT 
	t.MainDbName,
	401 AS MetricID,
	'CDC' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="CDC"]') AS N(x)

UNION ALL

SELECT 
	t.MainDbName,
	402 AS MetricID,
	'AET' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="AET"]') AS N(x)
  
UNION ALL

SELECT 
	t.MainDbName,
	403 AS MetricID,
	'BID' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="BID"]') AS N(x)  

UNION ALL

SELECT 
	t.MainDbName,
	404 AS MetricID,
	'CDN' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="CDN"]') AS N(x)  

UNION ALL

SELECT 
	t.MainDbName,
	405 AS MetricID,
	'EET' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="EET"]') AS N(x)  

UNION ALL

SELECT 
	t.MainDbName,
	406 AS MetricID,
	'ASP' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="ASP"]') AS N(x)  

UNION ALL

SELECT 
	t.MainDbName,
	407 AS MetricID,
	'BIM' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="BIM"]') AS N(x) 

UNION ALL

SELECT 
	t.MainDbName,
	408 AS MetricID,
	'ADM' AS ServiceTask,
	CASE ISNULL(N.x.value('(S5_IsActive/text())[1]', 'nvarchar(max)'), '2') WHEN '1' THEN 'Active' WHEN '0' THEN 'Inactive' ELSE 'N/A' END AS IsActive
FROM
  cte AS t
  OUTER APPLY t.ServiceTaskData.nodes('ServiceTask[@ServiceTaskName="ADM"]') AS N(x) </CommandText>
      </Query>
      <Fields>
        <Field Name="MainDbName">
          <DataField>MainDbName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MetricID">
          <DataField>MetricID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ServiceTask">
          <DataField>ServiceTask</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IsActive">
          <DataField>IsActive</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
