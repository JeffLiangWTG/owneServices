<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>CargoWise.Bi.Development.SsasBuilder</RootNamespace>
    <AssemblyName>CargoWise.Bi.Development.SsasBuilder</AssemblyName>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <None Remove="Templates\ModelTestClassTemplate.txt" />
    <None Remove="Templates\ProcedureTestClassTemplate.txt" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates\ModelTestClassTemplate.txt" />
    <EmbeddedResource Include="Templates\ProcedureTestClassTemplate.txt" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BuildTools" />
    <Reference Include="CargoWise.Bi.BusinessIntelligence.Testing" />
    <Reference Include="CargoWise.Bi.Common" />
    <Reference Include="CargoWise.Bi.Configuration" />
    <Reference Include="CargoWise.Bi.Deployment.AnalysisServices" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Microsoft.AnalysisServices" />
    <Reference Include="Microsoft.AnalysisServices.Core" />
    <Reference Include="Microsoft.AnalysisServices.Tabular" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates\ProcedureClassTemplate.txt" />
    <EmbeddedResource Include="Templates\ViewClassTemplate.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\SchemaSync\SchemaSync.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
</Project>