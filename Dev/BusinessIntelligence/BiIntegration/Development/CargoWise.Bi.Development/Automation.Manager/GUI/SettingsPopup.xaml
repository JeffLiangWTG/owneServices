<Window x:Class="CargoWise.Bi.Development.Automation.Manager.SettingsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CargoWise.Bi.Development.Automation.Manager"
        mc:Ignorable="d"
        Title="Add New Column" Height="150" Width="350" MinHeight="150" MinWidth="350" MaxHeight="150" MaxWidth="350" 		WindowStyle="None"
		WindowStartupLocation="CenterScreen"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="192"/>
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>
        </Grid.Resources>
        <Grid Grid.Row="1" Grid.Column="0">
            <Label HorizontalAlignment="Left" Width="91">Main Server</Label>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <TextBox Name="mainServer" Text="" HorizontalAlignment="Right" Width="179" Margin="0,5,4,0"/>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="0">
            <Label HorizontalAlignment="Left" Width="95" Margin="0,5,-4,0">Analysis Server</Label>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <TextBox Name="analysisServer" Text="" HorizontalAlignment="Right" Width="179" Margin="0,5,4,0"/>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="0">
            <Label HorizontalAlignment="Center" Width="140" Margin="0,4,0,0">CargoWise/Shared Path</Label>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="1">
            <TextBox Name="CWSharedPath" Text="" HorizontalAlignment="Right" Width="179" Margin="0,5,4,0"/>
        </Grid>
        <Grid Grid.Row="4" Grid.Column="1" Margin="4,0,0,-1">
            <StackPanel Margin="6,10,14.333,0" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="0,0,10,0"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="ActionButton" HorizontalAlignment="Right" VerticalAlignment="Top" Click="SaveButton_Click"  Width="50" Content="Save" Margin="0,0,10,0"/>
                <Button HorizontalAlignment="left" Click="CancelButtion_Click" Width="50" Content="Cancel" Margin="0,0,10,2"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
