<Window x:Class="CargoWise.Bi.Development.Automation.Manager.NewColumnPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CargoWise.Bi.Development.Automation.Manager"
        mc:Ignorable="d"
        Title="Add New Column" Height="118" Width="300" MinHeight="118" MinWidth="300" MaxHeight="118" MaxWidth="300" 		WindowStyle="None"
		WindowStartupLocation="CenterScreen"
>
    <Grid>
			<Grid.RowDefinitions>
			<RowDefinition Height="5"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="30"/>
				<RowDefinition Height="30"/>
			</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="90"/>
			<ColumnDefinition Width="190"/>
		</Grid.ColumnDefinitions>
		<Grid.Resources>
			<Style TargetType="{x:Type TextBox}">
				<Setter Property="Margin" Value="0,5,0,0"/>
			</Style>
			<Style TargetType="{x:Type ComboBox}">
				<Setter Property="Margin" Value="0,5,0,0"/>
			</Style>
			<Style TargetType="{x:Type Label}">
				<Setter Property="Margin" Value="0,5,0,0"/>
			</Style>
		</Grid.Resources>
		<Grid Grid.Row="1" Grid.Column="0">
				<Label HorizontalAlignment="Left">Column Name</Label>
			</Grid>
			<Grid Grid.Row="1" Grid.Column="1">
				<TextBox Name="columnName" Text="" HorizontalAlignment="Right" Width="185"/>
			</Grid>
			<Grid Grid.Row="2" Grid.Column="0">
				<Label HorizontalAlignment="Left">Column Type</Label>
			</Grid>
			<Grid Grid.Row="2" Grid.Column="1">
				<ComboBox Name="columnType" Text="Column Type" HorizontalAlignment="Right" Width="185">
				<ComboBoxItem>String</ComboBoxItem>
				<ComboBoxItem>Long</ComboBoxItem>
				<ComboBoxItem>Double</ComboBoxItem>
				<ComboBoxItem>DateTime</ComboBoxItem>
				<ComboBoxItem>Boolean</ComboBoxItem>
			</ComboBox>
			</Grid>
			<Grid Grid.Row="3" Grid.Column="1" Height="30">
			<StackPanel Margin="6,10,14.333,0" Orientation="Horizontal">
				<StackPanel.Resources>
					<Style TargetType="{x:Type Button}">
						<Setter Property="Margin" Value="0,0,10,0"/>
					</Style>
				</StackPanel.Resources>
				<Button Name="ActionButton" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddButton_Click"  Width="50" Height="20">Add</Button>
				<Button HorizontalAlignment="left" Click="CancelButtion_Click" Width="50" Height="20">Cancel</Button>
			</StackPanel>
			</Grid>
	</Grid>
</Window>
