DEFINE
    MEASURE 'Consolidation Transport'[First Vessel] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'Consolidation Transport'[Vessel], 1 ) )
    MEASURE 'Consolidation Transport'[First Voyage Flight] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK (
                'Consolidation Transport'[Voyage Flight],
                1
            )
        )
    MEASURE 'Consolidation'[ETA Discharge] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'Main Transport'[ETA], TRUE () ) )
    MEASURE 'Consolidation'[ETD Load] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'Main Transport'[ETD], TRUE () ) )
    MEASURE 'Consolidation'[ETA Last Discharge] =
        (
            /* USER DAX BEGIN */
            CALCULATE (
                FIRSTNONBLANK ( 'Consolidation Transport'[ETA], TRUE () ),
                TOPN (
                    1,
                    'Consolidation Transport',
                    'Consolidation Transport'[Leg Order], DESC
                )
            )
        )
    MEASURE 'Consolidation'[ETD First Load] =
        (
            /* USER DAX BEGIN */
            CALCULATE (
                FIRSTNONBLANK ( 'Consolidation Transport'[Load Port Code], TRUE () ),
                TOPN ( 1, 'Consolidation Transport', 'Consolidation Transport'[Leg Order], ASC )
            )
        )
    MEASURE 'Consolidation'[First Load] =
        (
            /* USER DAX BEGIN */
            CALCULATE (
                FIRSTNONBLANK ( 'Load Port'[Load Port Code], TRUE () ),
                TOPN ( 1, 'Consolidation Transport', 'Consolidation Transport'[Leg Order], ASC )
            )
        )
    MEASURE 'Consolidation'[Last Discharge] =
        (
            /* USER DAX BEGIN */
            CALCULATE (
                FIRSTNONBLANK ( 'Consolidation Transport'[Discharge Port Code], TRUE () ),
                TOPN (
                    1,
                    'Consolidation Transport',
                    'Consolidation Transport'[Leg Order], DESC
                )
            )
        )
    MEASURE 'Consolidation'[Console ATA] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'Main Transport'[ATA], TRUE () ) )
    MEASURE 'Consolidation'[Console ATD] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'Main Transport'[ATD], TRUE () ) )
    MEASURE 'Consolidation'[Contract Number] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( Consolidation[Contract No], TRUE () ) )
    MEASURE 'Shipment'[Shipment Customs Info] =
        (
            /* USER DAX BEGIN */
            CONCATENATEX (
                DISTINCT ( 'Shipment Customs Info' ),
                'Shipment Customs Info'[Customs Info],
                ","
            )
        )
    MEASURE 'Shipment'[GL Branch] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'GL Transaction'[Branch], TRUE () ) )
    MEASURE 'Shipment'[GL Department] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'GL Transaction'[Department], TRUE () ) )
    MEASURE 'Shipment'[GL Local Agent] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'GL Transaction'[Local Agent], TRUE () ) )
    MEASURE 'Shipment'[GL Representative Operator] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK (
                'GL Transaction'[Representative Operator],
                TRUE ()
            )
        )
    MEASURE 'Shipment'[GL Overseas Agent Code] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK (
                'GL Transaction'[Overseas Agent Code],
                TRUE ()
            )
        )
    MEASURE 'Shipment'[GL Overseas Agent Name] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK (
                'GL Transaction'[Overseas Agent Name],
                TRUE ()
            )
        )
    MEASURE 'Shipment'[GL Representative Sales] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK (
                'GL Transaction'[Representative Sales],
                TRUE ()
            )
        )
    MEASURE 'Shipment'[GL Status] =
        ( /* USER DAX BEGIN */
        FIRSTNONBLANK ( 'GL Transaction'[Status], TRUE () ) )
    MEASURE 'Shipment'[GL Create Date] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK (
                'GL Transaction'[Job Header Create Date Utc],
                TRUE ()
            )
        )
    MEASURE 'Shipment'[GL Revenue Recognition Date] =
        (
            /* USER DAX BEGIN */
            IF (
                COUNTROWS ( 'GL Transaction' ) > 0,
                FIRSTNONBLANK ( 'Revenue Recognition'[Recognition Date], TRUE () )
            )
        )
    MEASURE 'Local Agent AR Settlement'[Local Client AR Settlement Group] =
        (
            /* USER DAX BEGIN */
            IF (
                COUNTROWS ( 'GL Transaction' ) > 0,
                FIRSTNONBLANK (
                    'Local Agent AR Settlement'[Local Agent AR Settlement Related Party],
                    TRUE ()
                )
            )
        )
    MEASURE 'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Group] =
        (
            /* USER DAX BEGIN */
            IF (
                COUNTROWS ( 'GL Transaction' ) > 0,
                FIRSTNONBLANK (
                    'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Related Party],
                    TRUE ()
                )
            )
        )
    MEASURE 'Main Consol Shipment'[Freight Direction] =
        (
            /* USER DAX BEGIN */
            FIRSTNONBLANK ( 'Main Consol Shipment'[Direction], TRUE () )
        )
    VAR minDate =
        CALCULATE (
            VALUES ( 'Shipment'[Shipment Create Date] ),
            KEEPFILTERS (
                FILTER ( ALL ( 'Shipment'[Job Number] ), 'Shipment'[Job Number] = "S00001000" )
            )
        )
    VAR maxDate =
        CALCULATE ( DATE ( YEAR ( minDate ) + 2, MONTH ( minDate ), DAY ( minDate ) ) )
    VAR __DS0FilterTable =
        CALCULATETABLE (
            VALUES ( 'Shipment'[Shipment Create Date] ),
            KEEPFILTERS (
                FILTER (
                    ALL ( 'Shipment'[Shipment Create Date] ),
                    'Shipment'[Shipment Create Date] >= minDate
                        && 'Shipment'[Shipment Create Date] <= maxDate
                )
            )
        )
    VAR __DS0FilterTable2 =
        FILTER (
            KEEPFILTERS ( VALUES ( 'Shipment Coload Type'[Coload Type] ) ),
            'Shipment Coload Type'[Coload Type] = "All Shipments"
        )
    VAR __DS0FilterTable3 =
        FILTER (
            KEEPFILTERS ( VALUES ( 'Shipment'[Is Active] ) ),
            'Shipment'[Is Active] = TRUE
        )
    VAR __DS0FilterTable4 =
        FILTER (
            KEEPFILTERS ( VALUES ( 'Company Branch'[Company Code] ) ),
            'Company Branch'[Company Code] = "EDI"
        )
    VAR __DS0FilterTable5 =
        FILTER (
            KEEPFILTERS ( VALUES ( 'Company Branch Helper'[Company Code] ) ),
            'Company Branch Helper'[Company Code] = "EDI"
        )
    VAR __DS0FilterTable6 =
        FILTER (
            KEEPFILTERS ( VALUES ( 'Shipment'[Job Number] ) ),
            ISONORAFTER ( 'Shipment'[Job Number], "S00001000", ASC )
        )
    VAR __DS0FilterTable7 =
        FILTER (
            KEEPFILTERS ( VALUES ( 'Company Country'[Country Code] ) ),
            'Company Country'[Country Code] = "AU"
        )
EVALUATE
TOPN (
    500,
    SUMMARIZECOLUMNS (
        'Shipment'[Job Number],
        'Shipment'[Transport Mode],
        'Shipment'[Container Mode],
        'Port Of Origin'[Port Of Origin Code],
        'Port Of Origin'[Port Of Origin Country Code],
        'Port Of Destination'[Port Of Destination Code],
        'Port Of Destination'[Port Of Destination Country Code],
        'Shipment'[Way Bill Number],
        'Shipment'[Shipment Inco Term],
        'Shipment'[Additional Terms],
        'Shipment'[Shipment PPD CCX Term],
        'Shipment'[Goods Description],
        'Shipment'[Weight Unit],
        'Shipment'[Volume Unit],
        'Shipment'[Total No Of Packs Package Type],
        'Shipment'[Outer Packs Package Type],
        'Shipment'[Shipment Create Date],
        'Import Broker'[Import Broker],
        'Export Broker'[Export Broker],
        'Shipment'[Shipment Status],
        'Consolidation'[Job No.],
        'Consolidation'[Master Bill No.],
        'Service Level'[Service Level],
        'Shipment'[Interim Receipt Number],
        'Shipment'[Booking Confirmation Reference],
        'Shipment'[House Bill Type],
        'Shipment'[Is Transport Job],
        'Shipment'[Estimated Pickup],
