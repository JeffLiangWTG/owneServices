        'Shipment'[Container 40F],
        'Shipment'[Container 40H],
        'Shipment'[Container 40R],
        'Shipment'[Container 45F],
        'Shipment'[Container GEN],
        'Shipment'[Container Other],
        'Discharge Port'[Discharge Port Code],
        'Load Port'[Load Port Code],
        'Shipment'[Is Active],
        'Consolidation'[Coload],
        'Consignor Address'[Consignor City],
        'Consignor Address'[Consignor State],
        'Consignor Address'[Consignor Post Code],
        'Consignee Address'[Consignee City],
        'Consignee Address'[Consignee State],
        'Consignee Address'[Consignee Post Code],
        'Shipment'[Received Date],
        'Shipment'[Delivery Cartage Advised],
        'Shipment'[Loading Meters],
        'Consignor Address'[Consignor],
        'Consignee Address'[Consignee],
        'Controlling Customer Address'[Controlling Customer],
        'Controlling Agent Address'[Controlling Agent],
        'Shipment'[Arrival Date],
        'Shipment'[Departure Date],
        'Sending Agent Address'[Sending Agent],
        'Receiving Agent Address'[Receiving Agent],
        'Carrier Address'[Carrier],
        'Shipment'[Container TEU],
        'Shipment'[Container Count],
        __DS0FilterTable,
        __DS0FilterTable2,
        __DS0FilterTable3,
        __DS0FilterTable4,
        __DS0FilterTable5,
        __DS0FilterTable6,
        __DS0FilterTable7,
        "Shipment_Weight", 'Shipment'[Shipment Weight],
        "Shipment_Volume", 'Shipment'[Shipment Volume],
        "Actual_Chargeable", 'Shipment'[Actual Chargeable],
        "Total_No__Of_Packs", 'Shipment'[Total No. Of Packs],
        "Shipment_Outer_Packs", 'Shipment'[Shipment Outer Packs],
        "First Vessel", 'Consolidation Transport'[First Vessel],
        "First Voyage Flight", 'Consolidation Transport'[First Voyage Flight],
        "ETA Discharge", 'Consolidation'[ETA Discharge],
        "ETD Load", 'Consolidation'[ETD Load],
        "ETA Last Discharge", 'Consolidation'[ETA Last Discharge],
        "ETD First Load", 'Consolidation'[ETD First Load],
        "First Load", 'Consolidation'[First Load],
        "Last Discharge", 'Consolidation'[Last Discharge],
        "Console ATA", 'Consolidation'[Console ATA],
        "Console ATD", 'Consolidation'[Console ATD],
        "Shipment Customs Info", 'Shipment'[Shipment Customs Info],
        "Local Client AR Settlement Group", 'Local Agent AR Settlement'[Local Client AR Settlement Group],
        "Overseas Agent AR Settlement Group", 'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Group],
        "Contract Number", 'Consolidation'[Contract Number],
        "Freight Direction", 'Main Consol Shipment'[Freight Direction],
        "GL Branch", 'Shipment'[GL Branch],
        "GL Department", 'Shipment'[GL Department],
        "GL Local Agent", 'Shipment'[GL Local Agent],
        "GL Representative Operator", 'Shipment'[GL Representative Operator],
        "GL Overseas Agent Code", 'Shipment'[GL Overseas Agent Code],
        "GL Overseas Agent Name", 'Shipment'[GL Overseas Agent Name],
        "GL Representative Sales", 'Shipment'[GL Representative Sales],
        "Sum_of_Revenue", 'GL Transaction'[Sum of Revenue],
