  <ReportParameters>
    <ReportParameter Name="Column_Layout">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>&lt;ColumnLayout&gt;	&lt;Column&gt;		&lt;Order&gt;1&lt;/Order&gt;		&lt;Name&gt;'Company Branch'[Company]&lt;/Name&gt;		&lt;Label&gt;Company&lt;/Label&gt;		&lt;Width&gt;3.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;	&lt;/Column&gt;	&lt;Column&gt;		&lt;Order&gt;2&lt;/Order&gt;		&lt;Name&gt;'Company Branch'[Branch]&lt;/Name&gt;		&lt;Label&gt;Branch&lt;/Label&gt;		&lt;Width&gt;3.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;	&lt;/Column&gt;	&lt;Column&gt;		&lt;Order&gt;3&lt;/Order&gt;		&lt;Name&gt;'Department'[Department]&lt;/Name&gt;		&lt;Label&gt;Department&lt;/Label&gt;		&lt;Width&gt;3.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;	&lt;/Column&gt;		&lt;Column&gt;		&lt;Order&gt;4&lt;/Order&gt;		&lt;Name&gt;'GL Transaction'[Line Type]&lt;/Name&gt;		&lt;Label&gt;Line Type&lt;/Label&gt;		&lt;Width&gt;3.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;	&lt;/Column&gt;	&lt;Column&gt;		&lt;Order&gt;5&lt;/Order&gt;		&lt;Name&gt;'GL Transaction'[Post Date]&lt;/Name&gt;		&lt;Label&gt;Post Date&lt;/Label&gt;		&lt;Width&gt;5.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;			&lt;/Column&gt;	&lt;Column&gt;		&lt;Order&gt;6&lt;/Order&gt;		&lt;Name&gt;'GL Transaction'[Job Header]&lt;/Name&gt;		&lt;Label&gt;Job Header&lt;/Label&gt;		&lt;Width&gt;5.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;			&lt;/Column&gt;		&lt;Column&gt;		&lt;Order&gt;7&lt;/Order&gt;		&lt;Name&gt;[Local Amount]&lt;/Name&gt;		&lt;Label&gt;Local Amount&lt;/Label&gt;		&lt;Width&gt;3.0cm&lt;/Width&gt;		&lt;FormatString&gt;&lt;/FormatString&gt;	&lt;/Column&gt;&lt;/ColumnLayout&gt;</Value>
        </Values>
      </DefaultValue>
      <Prompt>Column Layout</Prompt>
    </ReportParameter>
    <ReportParameter Name="DataSet_Query">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>--Default Order

DEFINE
VAR var_Branch_Key = "15|20|32|44|49"
VAR var_Department_Key = "21|53|42"
//VAR var_Report_Month = "2015-01-01"
VAR var_LineType = "Cost|Accrual|Revenue|Work In Progress"
VAR var_Transport_Mode = "SEA|AIR"
VAR var_Origin_Country_Code = BLANK ()
VAR var_Destination_Country_Code = BLANK ()
VAR var_Container_Mode = "LSE|LCL"
VAR var_Charge_Code = BLANK ()
VAR var_Local_Agent = BLANK ()


EVALUATE
topn(3,
SELECTCOLUMNS(
SUMMARIZECOLUMNS (
	//GROUP_COLUMNS_START
    'Company Branch'[Company],
    'Company Branch'[Branch],
    'Department'[Department],
    'GL Transaction'[Line Type],
    'GL Transaction'[Post Date],
    'GL Transaction'[Job Header],
	//GROUP_COLUMNS_END
    FILTER (
        'Company Branch',
        PATHCONTAINS ( var_Branch_Key, 'Company Branch'[Branch Key] )
    ),
    FILTER (
        'Department',
        PATHCONTAINS ( var_Department_Key, 'Department'[Department Key] )
    ),
    FILTER (
        VALUES ( 'Shipment'[Transport Mode] ),
        PATHCONTAINS ( var_Transport_Mode, 'Shipment'[Transport Mode] )
            || ISBLANK ( var_Transport_Mode )
            || LEN ( var_Transport_Mode ) = 0
    ),
    FILTER (
        VALUES ( 'Shipment'[Container Mode] ),
        PATHCONTAINS ( var_Container_Mode, 'Shipment'[Container Mode] )
            || ISBLANK ( var_Container_Mode )
            || LEN ( var_Container_Mode ) = 0
    ),
    FILTER (
        VALUES ( 'Port Of Destination'[Port Of Destination Country Code] ),
        PATHCONTAINS (
            var_Destination_Country_Code,
            'Port Of Destination'[Port Of Destination Country Code]
        )
            || ISBLANK ( var_Destination_Country_Code )
            || LEN ( var_Destination_Country_Code ) = 0
    ),
    FILTER (
        VALUES ( 'Port Of Origin'[Port Of Origin Country Code] ),
        PATHCONTAINS (
            var_Origin_Country_Code,
            'Port Of Origin'[Port Of Origin Country Code]
        )
            || ISBLANK ( var_Origin_Country_Code )
            || LEN ( var_Origin_Country_Code ) = 0
    ),
    FILTER (
        VALUES ( 'Local Agent'[Local Agent] ),
        PATHCONTAINS ( var_Local_Agent, 'Local Agent'[Local Agent] )
            || ISBLANK ( var_Local_Agent )
            || LEN ( var_Local_Agent ) = 0
    ),
    FILTER (
        VALUES ( 'Charge Code'[Charge Code] ),
        PATHCONTAINS ( var_Charge_Code, 'Charge Code'[Charge Code] )
            || ISBLANK ( var_Charge_Code )
            || LEN ( var_Charge_Code ) = 0
    ),
    FILTER (
        VALUES ( 'GL Transaction'[Line Type] ),
        PATHCONTAINS ( var_LineType, 'GL Transaction'[Line Type] ) || ISBLANK ( var_LineType )
            || LEN ( var_LineType ) = 0
    ),
//    FILTER (
//        'Recognition Date',
//        'Recognition Date'[Month Date] = VALUE ( var_Report_Month )
//    ),
    FILTER (
        VALUES ( 'Shipment'[__Is Shipping] ),
        NOT ( ISBLANK ( 'Shipment'[__Is Shipping] ) )
    ),
    // filter only shipments
    "Local Amount", SUM ( 'GL Transaction'[__Local Amount] ),
    "Job Profit", [Job Profit],
    "Revenue", [Revenue],
    "Cost", [Cost],
    "Work In Progress", [Work In Progress],
    "Accrual", [Accrual]
),
	//DISPLAY_COLUMNS_START
    "Company", 'Company Branch'[Company],
    "Branch", 'Company Branch'[Branch],
    "Department", 'Department'[Department],
    "Line Type", 'GL Transaction'[Line Type],
    "Post Date", 'GL Transaction'[Post Date],
    "Job Header", 'GL Transaction'[Job Header],
    "Local Amount", [Local Amount],
    "Job Profit", [Job Profit],
    "Revenue", [Revenue],
    "Cost", [Cost],
    "Work In Progress", [Work In Progress],
    "Accrual", [Accrual]
	//DISPLAY_COLUMNS_END
   )
  )</Value>
        </Values>
      </DefaultValue>
      <Prompt>DataSet_Query</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
  </ReportParameters>
