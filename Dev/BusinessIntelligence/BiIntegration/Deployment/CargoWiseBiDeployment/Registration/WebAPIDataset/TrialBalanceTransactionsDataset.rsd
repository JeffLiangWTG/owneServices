          </Query>
        </QueryDefinition>
      </rd:DesignerState>
    </Query>
    <Fields>
      <Field Name="Period">
        <DataField>Period[Period]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Ledger">
        <DataField>GLTransaction[Ledger]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Transaction_Number">
        <DataField>GLTransaction[Transaction Number]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Transaction_Type">
        <DataField>GLTransaction[Transaction Type]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Transaction_Reference">
        <DataField>GLTransaction[Transaction Reference]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Branch_Code">
        <DataField>Branch[Branch Code]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Department_Name">
        <DataField>Department[Department Name]</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
