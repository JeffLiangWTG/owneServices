                </Item>
                <Item>
                  <ID xsi:type="Level">
                    <DimensionName>GLTransaction</DimensionName>
                    <HierarchyName>SubType</HierarchyName>
                    <HierarchyUniqueName>[GLTransaction].[SubType]</HierarchyUniqueName>
                    <LevelName>SubType</LevelName>
                    <UniqueName>[GLTransaction].[SubType].[SubType]</UniqueName>
                  </ID>
                  <ItemCaption>SubType</ItemCaption>
                </Item>
                <Item>
                  <ID xsi:type="Level">
                    <DimensionName>Organization</DimensionName>
                    <HierarchyName>Organization Name</HierarchyName>
