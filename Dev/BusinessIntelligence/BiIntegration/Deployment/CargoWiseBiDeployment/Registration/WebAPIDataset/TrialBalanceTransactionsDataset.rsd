<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="TrialBalanceTransactionsDataset">
    <Query>
      <DataSourceReference>FinanceModel</DataSourceReference>
		<DataSetParameters>
			<DataSetParameter Name="Company">
				<DefaultValue>[ZBI] ANOTHER BI TESTING COMPANY</DefaultValue>
				<ReadOnly>false</ReadOnly>
				<Nullable>false</Nullable>
				<OmitFromQuery>false</OmitFromQuery>
				<rd:UserDefined>true</rd:UserDefined>
				<rd:DbType>String</rd:DbType>
			</DataSetParameter>
			<DataSetParameter Name="ShowZeroBalance">
				<DefaultValue>No</DefaultValue>
				<ReadOnly>false</ReadOnly>
				<Nullable>false</Nullable>
				<OmitFromQuery>false</OmitFromQuery>
				<rd:UserDefined>true</rd:UserDefined>
				<rd:DbType>String</rd:DbType>
			</DataSetParameter>
			<DataSetParameter Name="PresentationJournal">
				<DefaultValue>None</DefaultValue>
				<ReadOnly>false</ReadOnly>
				<Nullable>false</Nullable>
				<OmitFromQuery>false</OmitFromQuery>
				<rd:UserDefined>true</rd:UserDefined>
				<rd:DbType>String</rd:DbType>
			</DataSetParameter>
			<DataSetParameter Name="Language">
				<DefaultValue>English</DefaultValue>
				<ReadOnly>false</ReadOnly>
				<Nullable>false</Nullable>
				<OmitFromQuery>false</OmitFromQuery>
				<rd:UserDefined>true</rd:UserDefined>
				<rd:DbType>String</rd:DbType>
			</DataSetParameter>
			<DataSetParameter Name="StartPeriod">
				<DefaultValue>200101</DefaultValue>
				<ReadOnly>false</ReadOnly>
				<Nullable>false</Nullable>
				<OmitFromQuery>false</OmitFromQuery>
				<rd:UserDefined>true</rd:UserDefined>
				<rd:DbType>String</rd:DbType>
			</DataSetParameter>
			<DataSetParameter Name="EndPeriod">
				<DefaultValue>202308</DefaultValue>
				<ReadOnly>false</ReadOnly>
				<Nullable>false</Nullable>
				<OmitFromQuery>false</OmitFromQuery>
				<rd:UserDefined>true</rd:UserDefined>
				<rd:DbType>String</rd:DbType>
			</DataSetParameter>
		</DataSetParameters>		
      <CommandText>// DAX Query
DEFINE
  MEASURE 'Report Measures'[__PresentationJournalFilter] = 
    (/* USER DAX BEGIN */

IF (
    CALCULATE ( COUNTROWS ( 'GLTransaction' ) ) &gt; 0,
    SWITCH (
        TRUE (),
        NOT ISFILTERED ( 'Presentation Journal'[Code] ), "visible",
         (
             			(((
                FIRSTNONBLANK ( GLTransaction[Transaction Type], 1 ) = "AJL"
                            || FIRSTNONBLANK ( GLTransaction[Transaction Type], 1 ) = "RJL"
                            || FIRSTNONBLANK ( GLTransaction[Transaction Type], 1 ) = "GJL"
                    )
             &amp;&amp; ((SEARCH(FIRSTNONBLANK(GLTransaction[Transaction Category],1), FIRSTNONBLANK ('Presentation Journal'[Code],1),,0) &gt; 0) ||
						FIRSTNONBLANK ( GLTransaction[Transaction Category], 1 ) = ""))
            || (FIRSTNONBLANK ( GLTransaction[Transaction Type], 1 ) &lt;&gt; "AJL"
                &amp;&amp; FIRSTNONBLANK ( GLTransaction[Transaction Type], 1 ) &lt;&gt; "RJL"
                &amp;&amp; FIRSTNONBLANK ( GLTransaction[Transaction Type], 1 ) &lt;&gt; "GJL"))	
    ),"visible",
    BLANK ()
)
)
/* USER DAX END */)

  MEASURE 'Report Measures'[__IsCFXAccountLineForCurrentCompany] = 
    (/* USER DAX BEGIN */

   If( COUNTROWS (
        FILTER (
            'ControllingAccount ReportSubCode Mapping',
            'ControllingAccount ReportSubCode Mapping'[Report SubCode] &lt;&gt; "*JC*JNL*CFX*" || ('ControllingAccount ReportSubCode Mapping'[Report SubCode] = "*JC*JNL*CFX*"
                &amp;&amp; 'ControllingAccount ReportSubCode Mapping'[Controlling Account Key] =  [__Acckey]
                &amp;&amp; (  ISBLANK('ControllingAccount ReportSubCode Mapping'[Company Key]) ||  'ControllingAccount ReportSubCode Mapping'[Company Key]
                    = FIRSTNONBLANK ( VALUES ( 'Company Branch'[Company Key] ), 1 )))
        )
    )&gt;0 ,1,BLANK())

 

/* USER DAX END */)

  MEASURE 'Report Measures'[__Acckey] = 
    (/* USER DAX BEGIN */

    SWITCH (
        TRUE (),
        ISFILTERED ( GLAccount[Level 1] ) &amp;&amp; ISFILTERED ( GLAccount[Level 2] )
            &amp;&amp; ISFILTERED ( GLAccount[Level 3] ), VALUES ( GLAccount[Account Key] ),
        ISFILTERED ( GLAccount[Level 1] ) &amp;&amp; ISFILTERED ( GLAccount[Level 2] ),
            CALCULATE (
                FIRSTNONBLANK ( GLAccount[Account Key], TRUE () ),
                FILTER ( GLAccount, GLAccount[Account No.] = GLAccount[Level 2] )
            ),
        CALCULATE (
            FIRSTNONBLANK ( GLAccount[Account Key], TRUE () ),
            FILTER ( GLAccount, GLAccount[Account No.] = GLAccount[Level 1] )
        )
    )


/* USER DAX END */)

  MEASURE 'Report Measures'[Account No] = 
    (/* USER DAX BEGIN */
var accKey  =FIRSTNONBLANK(GLTransaction[Mapped  GLAccount Key],TRUE()) return 
IF (COUNTROWS(VALUES(GLTransaction[Mapped  GLAccount Key]))=1,if(accKey=-1,FIRSTNONBLANK(GLAccount[Account No.],TRUE()),CALCULATE(FIRSTNONBLANK(GLAccount[Account No.],TRUE()),Filter(GLAccount,GLAccount[Account Key]=accKey))))
/* USER DAX END */)

  VAR __DS0FilterTable = 
    FILTER(
      KEEPFILTERS(VALUES('GLAccount'[Level 1])),
      AND(
        AND(NOT(ISBLANK('GLAccount'[Level 1])), 'GLAccount'[Level 1] = "1010.00.00"),
        NOT(ISBLANK('GLAccount'[Level 1]))
      )
    )

  VAR __DS0FilterTable2 = 
    FILTER(
      KEEPFILTERS(VALUES('Period'[Period])),
      AND(
        AND(
          AND('Period'[Period] &gt;= VALUE(@StartPeriod), 'Period'[Period] &lt;= VALUE(@EndPeriod)),
          'Period'[Period] &gt;= VALUE(@StartPeriod)
        ),
        'Period'[Period] &lt;= VALUE(@EndPeriod)
      )
    )

  VAR __DS0FilterTable3 = 
    FILTER(KEEPFILTERS(VALUES('Language'[Description])), 'Language'[Description] = @Language)

  VAR __DS0FilterTable4 = 
    FILTER(
      KEEPFILTERS(VALUES('Presentation Journal'[Code])),
      'Presentation Journal'[Code] = @PresentationJournal
    )

  VAR __DS0FilterTable5 = 
    FILTER(
      KEEPFILTERS(VALUES('Include Zero Balance'[Include Zero Balance])),
      'Include Zero Balance'[Include Zero Balance] = @ShowZeroBalance
    )

  VAR __DS0FilterTable6 = 
    FILTER(
      KEEPFILTERS(VALUES('Company Branch'[Company])),
      'Company Branch'[Company] = @Company
    )

  VAR __ValueFilterDM0 = 
    FILTER(
      KEEPFILTERS(
        SUMMARIZECOLUMNS(
          'Period'[Period],
          'GLTransaction'[Ledger],
          'GLTransaction'[Transaction Number],
          'GLTransaction'[Transaction Type],
          'GLTransaction'[Transaction Reference],
          'Branch'[Branch Code],
          'Department'[Department Name],
          'GLTransaction'[SubType],
          'Organization'[Organization Name],
          'GLTransaction'[Report Post Date],
          'GLTransaction'[GLAmount Debit],
          'GLTransaction'[GLAmount Credit],
          __DS0FilterTable,
          __DS0FilterTable2,
          __DS0FilterTable3,
          __DS0FilterTable4,
          __DS0FilterTable5,
          __DS0FilterTable6,
          "Account No", 'Report Measures'[Account No],
          "__PresentationJournalFilter", IGNORE('Report Measures'[__PresentationJournalFilter]),
          "__IsCFXAccountLineForCurrentCompany", IGNORE('Report Measures'[__IsCFXAccountLineForCurrentCompany])
        )
      ),
      AND(
        NOT(ISBLANK([__PresentationJournalFilter])),
        NOT(ISBLANK([__IsCFXAccountLineForCurrentCompany]))
      )
    )

  VAR __DS0Core = 
    SUMMARIZECOLUMNS(
      'Period'[Period],
      'GLTransaction'[Ledger],
      'GLTransaction'[Transaction Number],
      'GLTransaction'[Transaction Type],
      'GLTransaction'[Transaction Reference],
      'Branch'[Branch Code],
      'Department'[Department Name],
      'GLTransaction'[SubType],
      'Organization'[Organization Name],
      'GLTransaction'[Report Post Date],
      'GLTransaction'[GLAmount Debit],
      'GLTransaction'[GLAmount Credit],
      __DS0FilterTable,
      __DS0FilterTable2,
      __DS0FilterTable3,
      __DS0FilterTable4,
      __DS0FilterTable5,
      __DS0FilterTable6,
      __ValueFilterDM0,
      "Account No", 'Report Measures'[Account No]
    )

  VAR __DS0PrimaryWindowed = 
    TOPN(
      1000000,
      __DS0Core,
      [Account No],
      1,
      'Period'[Period],
      1,
      'GLTransaction'[Ledger],
      1,
      'GLTransaction'[Transaction Number],
      1,
      'GLTransaction'[Transaction Type],
      1,
      'GLTransaction'[Transaction Reference],
      1,
      'Branch'[Branch Code],
      1,
      'Department'[Department Name],
      1,
      'GLTransaction'[SubType],
      1,
      'Organization'[Organization Name],
      1,
      'GLTransaction'[Report Post Date],
      1,
      'GLTransaction'[GLAmount Debit],
      1,
      'GLTransaction'[GLAmount Credit],
      1
    )

EVALUATE
  __DS0PrimaryWindowed

ORDER BY
  [Account No],
  'Period'[Period],
  'GLTransaction'[Ledger],
  'GLTransaction'[Transaction Number],
  'GLTransaction'[Transaction Type],
  'GLTransaction'[Transaction Reference],
  'Branch'[Branch Code],
  'Department'[Department Name],
  'GLTransaction'[SubType],
  'Organization'[Organization Name],
  'GLTransaction'[Report Post Date],
  'GLTransaction'[GLAmount Debit],
  'GLTransaction'[GLAmount Credit]</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
          <CommandType>DAX</CommandType>
          <Type>Query</Type>
          <QuerySpecification xsi:type="MDXQuerySpecification">
            <Select>
              <Items>
                <Item>
                  <ID xsi:type="Level">
                    <DimensionName>Period</DimensionName>
                    <HierarchyName>Period</HierarchyName>
                    <HierarchyUniqueName>[Period].[Period]</HierarchyUniqueName>
