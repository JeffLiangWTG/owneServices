							1,
							'Shipment'[Chargeable Unit],
							1,
							'Shipment'[Is Master / Lead],
							1,
							'Shipment'[Is Brokerage],
							1,
							'Shipment'[Coload Master],
							1,
							'Shipment'[Container 20F],
							1,
							'Shipment'[Container 20H],
							1,
							'Shipment'[Container 20R],
							1,
							'Shipment'[Container 40F],
							1,
							'Shipment'[Container 40H],
							1,
							'Shipment'[Container 40R],
							1,
							'Shipment'[Container 45F],
							1,
							'Shipment'[Container GEN],
							1,
							'Shipment'[Container Other],
							1,
							'Discharge Port'[Discharge Port Code],
							1,
							'Load Port'[Load Port Code],
							1,
							'Shipment'[Is Active],
							1,
							'Consolidation'[Coload],
							1,
							'Shipment'[Received Date],
							1,
							'Shipment'[Delivery Cartage Advised],
							1,
							'Shipment'[Loading Meters],
							1,
							'Shipment'[Arrival Date],
