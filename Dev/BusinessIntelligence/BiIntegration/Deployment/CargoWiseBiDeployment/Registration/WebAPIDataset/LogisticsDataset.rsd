				1,
				'Shipment'[Container 45F],
				1,
				'Shipment'[Container GEN],
				1,
				'Shipment'[Container Other],
				1,
				'Discharge Port'[Discharge Port Code],
				1,
				'Load Port'[Load Port Code],
				1,
				'Shipment'[Is Active],
				1,
				'Consolidation'[Coload],
				1,
				'Shipment'[Received Date],
				1,
				'Shipment'[Delivery Cartage Advised],
				1,
				'Shipment'[Loading Meters],
				1,
				'Shipment'[Arrival Date],
				1,
				'Shipment'[Departure Date],
				1,
				'Shipment'[Container TEU],
				1,
				'Shipment'[Container Count],
				1,
				'Carrier Address'[Carrier Code],
				1,
				'Carrier Address'[Carrier Name],
				1,
				'Receiving Agent Address'[Receiving Agent Code],
				1,
				'Sending Agent Address'[Sending Agent Code],
				1,
				'Consignor Address'[Consignor Code],
				1,
				'Consignee Address'[Consignee Code],
				1,
				'Export Broker'[Export Broker Code],
				1,
				'Export Broker'[Export Broker Name],
				1,
				'Import Broker'[Import Broker Code],
				1,
				'Import Broker'[Import Broker Name],
				1,
				'Receiving Agent Address'[Receiving Agent Name],
				1,
				'Sending Agent Address'[Sending Agent Name],
				1,
				'Consolidation'[First Load],
				1,
				'Consolidation'[Last Discharge],
				1,
				'Consolidation'[ETD First Load],
				1,
				'Consolidation'[ETA Last Discharge],
				1,
				'Consolidation'[First Vessel],
				1,
				'Consolidation'[First Voyage Flight],
				1,
				'Main Consol Shipment'[ETA Discharge],
				1,
				'Main Consol Shipment'[ETD Load],
				1,
				'Consolidation'[Contract No],
				1,
				'Main Consol Shipment'[Consol ATD],
				1,
				'Main Consol Shipment'[Consol ATA],
				1,
				'Main Consol Shipment'[Direction],
				1,
				'Consignor Address'[Consignor Address Name],
				1,
				'Consignor Address'[Consignor Address City],
				1,
				'Consignor Address'[Consignor Address State],
				1,
				'Consignor Address'[Consignor Address Post Code],
				1,
				'Consignee Address'[Consignee Address Name],
				1,
				'Consignee Address'[Consignee Address City],
				1,
				'Consignee Address'[Consignee Address State],
				1,
				'Consignee Address'[Consignee Address Post Code],
				1,
				'Controlling Agent Address'[Controlling Agent Code],
				1,
				'Controlling Agent Address'[Controlling Agent Name],
				1,
				'Controlling Customer Address'[Controlling Customer Code],
				1,
				'Controlling Customer Address'[Controlling Customer Name],
				1
				)

				ORDER BY
				'Shipment'[Job Number],
				'Shipment'[Transport Mode],
				'Shipment'[Container Mode],
				'Port Of Origin'[Port Of Origin Code],
				'Port Of Origin'[Port Of Origin Country Code],
				'Port Of Destination'[Port Of Destination Code],
				'Port Of Destination'[Port Of Destination Country Code],
				'Shipment'[Way Bill Number],
