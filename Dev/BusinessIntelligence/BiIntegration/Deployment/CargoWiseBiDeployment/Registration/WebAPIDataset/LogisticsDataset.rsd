<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
	<DataSet Name="DataSet1">
		<Query>
			<DataSourceReference>LogisticsModel</DataSourceReference>
			<DataSetParameters>
				<DataSetParameter Name="Company">
					<DefaultValue>DAU</DefaultValue>
					<ReadOnly>false</ReadOnly>
					<Nullable>false</Nullable>
					<OmitFromQuery>false</OmitFromQuery>
					<rd:DbType>Object</rd:DbType>
				</DataSetParameter>
				<DataSetParameter Name="Country">
					<DefaultValue>AU</DefaultValue>
					<ReadOnly>false</ReadOnly>
					<Nullable>false</Nullable>
					<OmitFromQuery>false</OmitFromQuery>
					<rd:DbType>Object</rd:DbType>
				</DataSetParameter>
				<DataSetParameter Name="StartDate">
					<DefaultValue>2015/01/01</DefaultValue>
					<ReadOnly>false</ReadOnly>
					<Nullable>false</Nullable>
					<OmitFromQuery>false</OmitFromQuery>
					<rd:DbType>Text</rd:DbType>
				</DataSetParameter>
				<DataSetParameter Name="EndDate">
					<DefaultValue>2021/12/31</DefaultValue>
					<ReadOnly>false</ReadOnly>
					<Nullable>false</Nullable>
					<OmitFromQuery>false</OmitFromQuery>
					<rd:DbType>Text</rd:DbType>
				</DataSetParameter>
			</DataSetParameters>
			<CommandText>
				// DAX Query
				DEFINE
				MEASURE 'Shipment'[Shipment Customs Info] =
				(/* USER DAX BEGIN */
				CONCATENATEX(DISTINCT('Shipment Customs Info'), 'Shipment Customs Info'[Customs Info] ,",")
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Branch] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Branch],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Department] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Department],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Local Agent Name] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Local Agent Name],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Representative Operator] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Representative Operator],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Overseas Agent Code] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Overseas Agent Code],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Overseas Agent Name] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Overseas Agent Name],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Representative Sales] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Representative Sales],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Status] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Status],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Create Date] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Job Header Create Date Utc],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Revenue Recognition Date] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Revenue Recognition Date],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[GL Local Agent Code] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Local Agent Code],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[Job Branch] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Branch Code],TRUE())
				/* USER DAX END */)

				MEASURE 'Shipment'[Job Department] =
				(/* USER DAX BEGIN */
				FIRSTNONBLANK('GL Transaction'[Department Code],TRUE())
				/* USER DAX END */)

				MEASURE 'Local Agent AR Settlement'[Local Client AR Settlement Group Code] =
				(/* USER DAX BEGIN */
				IF (COUNTROWS('GL Transaction') &gt; 0, FIRSTNONBLANK('Local Agent AR Settlement'[Local Agent AR Settlement Related Party Code],TRUE()))
				/* USER DAX END */)

				MEASURE 'Local Agent AR Settlement'[Local Client AR Settlement Group Name] =
				(/* USER DAX BEGIN */
				IF (COUNTROWS('GL Transaction') &gt; 0, FIRSTNONBLANK('Local Agent AR Settlement'[Local Agent AR Settlement Related Party Name],TRUE()))
				/* USER DAX END */)

				MEASURE 'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Group Code] =
				(/* USER DAX BEGIN */
				IF (COUNTROWS('GL Transaction') &gt; 0, FIRSTNONBLANK('Overseas Agent AR Settlement'[Overseas Agent AR Settlement Related Party Code],TRUE()))
				/* USER DAX END */)

				MEASURE 'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Group Name] =
				(/* USER DAX BEGIN */
				IF (COUNTROWS('GL Transaction') &gt; 0, FIRSTNONBLANK('Overseas Agent AR Settlement'[Overseas Agent AR Settlement Related Party Name],TRUE()))
				/* USER DAX END */)

				VAR __DS0FilterTable =
				FILTER(
				KEEPFILTERS(VALUES('Shipment'[Shipment Create Date])),
				AND(
				'Shipment'[Shipment Create Date] &gt;= DATEVALUE(@StartDate),
				'Shipment'[Shipment Create Date] &lt; DATEVALUE(@EndDate)
				)
				)

				VAR __DS0FilterTable2 =
				FILTER(
				KEEPFILTERS(VALUES('Shipment Coload Type'[Coload Type])),
				'Shipment Coload Type'[Coload Type] = "All Shipments"
				)

				VAR __DS0FilterTable3 =
				FILTER(KEEPFILTERS(VALUES('Shipment'[Is Active])), 'Shipment'[Is Active] = TRUE)

				VAR __DS0FilterTable4 =
				FILTER(
				KEEPFILTERS(VALUES('Company Branch'[Company Code])),
				'Company Branch'[Company Code] = @Company
				)

				VAR __DS0FilterTable5 =
				FILTER(
				KEEPFILTERS(VALUES('Company Branch Helper'[Company Code])),
				'Company Branch Helper'[Company Code] = @Company
				)

				VAR __DS0FilterTable6 =
				FILTER(
				KEEPFILTERS(VALUES('Company Country'[Country Code])),
				'Company Country'[Country Code] = @Country
				)

				EVALUATE
				TOPN(
				1000000,
				SUMMARIZECOLUMNS(
				'Shipment'[Job Number],
				'Shipment'[Transport Mode],
				'Shipment'[Container Mode],
				'Port Of Origin'[Port Of Origin Code],
				'Port Of Origin'[Port Of Origin Country Code],
				'Port Of Destination'[Port Of Destination Code],
				'Port Of Destination'[Port Of Destination Country Code],
				'Shipment'[Way Bill Number],
				'Shipment'[Shipment Inco Term],
				'Shipment'[Additional Terms],
				'Shipment'[Shipment PPD CCX Term],
				'Shipment'[Goods Description],
				'Shipment'[Weight Unit],
				'Shipment'[Volume Unit],
				'Shipment'[Total No Of Packs Package Type],
				'Shipment'[Outer Packs Package Type],
				'Shipment'[Shipment Create Date],
				'Shipment'[Shipment Status],
				'Consolidation'[Job No.],
				'Consolidation'[Master Bill No.],
				'Service Level'[Service Level],
				'Shipment'[Interim Receipt Number],
				'Shipment'[Booking Confirmation Reference],
				'Shipment'[House Bill Type],
				'Shipment'[Is Transport Job],
				'Shipment'[Estimated Pickup],
				'Shipment'[Pickup Required By],
				'Shipment'[Delivery Cartage Completed],
				'Shipment'[Delivery Required By],
				'Shipment'[FCL Delivery Equipment Needed],
				'Shipment'[Estimated Delivery],
				'Shipment'[Pickup Cartage Completed],
				'Shipment'[FCL Pickup Equipment Needed],
				'Shipment'[Pickup Cartage Advised],
				'Shipment'[Chargeable Unit],
				'Shipment'[Is Master / Lead],
				'Shipment'[Is Brokerage],
				'Shipment'[Coload Master],
				'Shipment'[Container 20F],
				'Shipment'[Container 20H],
				'Shipment'[Container 20R],
				'Shipment'[Container 40F],
				'Shipment'[Container 40H],
				'Shipment'[Container 40R],
				'Shipment'[Container 45F],
				'Shipment'[Container GEN],
				'Shipment'[Container Other],
				'Discharge Port'[Discharge Port Code],
				'Load Port'[Load Port Code],
				'Shipment'[Is Active],
				'Consolidation'[Coload],
				'Shipment'[Received Date],
				'Shipment'[Delivery Cartage Advised],
				'Shipment'[Loading Meters],
				'Shipment'[Arrival Date],
				'Shipment'[Departure Date],
				'Shipment'[Container TEU],
				'Shipment'[Container Count],
				'Carrier Address'[Carrier Code],
				'Carrier Address'[Carrier Name],
				'Receiving Agent Address'[Receiving Agent Code],
				'Sending Agent Address'[Sending Agent Code],
				'Consignor Address'[Consignor Code],
				'Consignee Address'[Consignee Code],
				'Export Broker'[Export Broker Code],
				'Export Broker'[Export Broker Name],
				'Import Broker'[Import Broker Code],
				'Import Broker'[Import Broker Name],
				'Receiving Agent Address'[Receiving Agent Name],
				'Sending Agent Address'[Sending Agent Name],
				'Consolidation'[First Load],
				'Consolidation'[Last Discharge],
				'Consolidation'[ETD First Load],
				'Consolidation'[ETA Last Discharge],
				'Consolidation'[First Vessel],
				'Consolidation'[First Voyage Flight],
				'Main Consol Shipment'[ETA Discharge],
				'Main Consol Shipment'[ETD Load],
				'Consolidation'[Contract No],
				'Main Consol Shipment'[Consol ATD],
				'Main Consol Shipment'[Consol ATA],
				'Main Consol Shipment'[Direction],
				'Consignor Address'[Consignor Address Name],
				'Consignor Address'[Consignor Address City],
				'Consignor Address'[Consignor Address State],
				'Consignor Address'[Consignor Address Post Code],
				'Consignee Address'[Consignee Address Name],
				'Consignee Address'[Consignee Address City],
				'Consignee Address'[Consignee Address State],
				'Consignee Address'[Consignee Address Post Code],
				'Controlling Agent Address'[Controlling Agent Code],
				'Controlling Agent Address'[Controlling Agent Name],
				'Controlling Customer Address'[Controlling Customer Code],
				'Controlling Customer Address'[Controlling Customer Name],
				__DS0FilterTable,
				__DS0FilterTable2,
				__DS0FilterTable3,
				__DS0FilterTable4,
				__DS0FilterTable5,
				__DS0FilterTable6,
				"Shipment_Weight", 'Shipment'[Shipment Weight],
				"Shipment_Volume", 'Shipment'[Shipment Volume],
				"Actual_Chargeable", 'Shipment'[Actual Chargeable],
				"Total_No__Of_Packs", 'Shipment'[Total No. Of Packs],
				"Shipment_Outer_Packs", 'Shipment'[Shipment Outer Packs],
				"Shipment Customs Info", 'Shipment'[Shipment Customs Info],
				"GL Branch", 'Shipment'[GL Branch],
				"GL Department", 'Shipment'[GL Department],
				"GL Local Agent Name", 'Shipment'[GL Local Agent Name],
				"GL Representative Operator", 'Shipment'[GL Representative Operator],
				"GL Overseas Agent Code", 'Shipment'[GL Overseas Agent Code],
				"GL Overseas Agent Name", 'Shipment'[GL Overseas Agent Name],
				"GL Representative Sales", 'Shipment'[GL Representative Sales],
				"Sum_of_Revenue", 'GL Transaction'[Sum of Revenue],
				"Sum_of_Cost", 'GL Transaction'[Sum of Cost],
				"Sum_of_Job_Profit", 'GL Transaction'[Sum of Job Profit],
				"Sum_of_Accrual", 'GL Transaction'[Sum of Accrual],
				"Sum_of_Unrecognised_Cost", 'GL Transaction'[Sum of Unrecognised Cost],
				"Sum_of_Unrecognised_Revenue", 'GL Transaction'[Sum of Unrecognised Revenue],
				"Sum_Total_of_Cost", 'GL Transaction'[Sum Total of Cost],
				"Sum_of_Recognised_Expense", 'GL Transaction'[Sum of Recognised Expense],
				"Sum_of_Unrecognised_Income", 'GL Transaction'[Sum of Unrecognised Income],
				"Sum_Total_of_Income", 'GL Transaction'[Sum Total of Income],
				"Sum_Total_of_Expense", 'GL Transaction'[Sum Total of Expense],
				"Sum_Total_of_Accrual", 'GL Transaction'[Sum Total of Accrual],
				"Sum_of_Recognised_Income", 'GL Transaction'[Sum of Recognised Income],
				"Sum_of_Unrecognised_Expense", 'GL Transaction'[Sum of Unrecognised Expense],
				"Sum_Total_of_WIP", 'GL Transaction'[Sum Total of WIP],
				"GL Status", 'Shipment'[GL Status],
				"GL Create Date", 'Shipment'[GL Create Date],
				"Sum_Total_of_Revenue", 'GL Transaction'[Sum Total of Revenue],
				"GL Revenue Recognition Date", 'Shipment'[GL Revenue Recognition Date],
				"Sum_of_Unrecognised_WIP", 'GL Transaction'[Sum of Unrecognised WIP],
				"Sum_of_WIP", 'GL Transaction'[Sum of WIP],
				"Sum_of_Unrecognised_Accrual", 'GL Transaction'[Sum of Unrecognised Accrual],
				"Local Client AR Settlement Group Code", 'Local Agent AR Settlement'[Local Client AR Settlement Group Code],
				"Local Client AR Settlement Group Name", 'Local Agent AR Settlement'[Local Client AR Settlement Group Name],
				"Overseas Agent AR Settlement Group Code", 'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Group Code],
				"Overseas Agent AR Settlement Group Name", 'Overseas Agent AR Settlement'[Overseas Agent AR Settlement Group Name],
				"GL Local Agent Code", 'Shipment'[GL Local Agent Code],
				"Job Branch", 'Shipment'[Job Branch],
				"Job Department", 'Shipment'[Job Department]
				),
				'Shipment'[Job Number],
				1,
				'Shipment'[Transport Mode],
				1,
				'Shipment'[Container Mode],
				1,
				'Port Of Origin'[Port Of Origin Code],
				1,
				'Port Of Origin'[Port Of Origin Country Code],
				1,
				'Port Of Destination'[Port Of Destination Code],
				1,
				'Port Of Destination'[Port Of Destination Country Code],
				1,
				'Shipment'[Way Bill Number],
				1,
				'Shipment'[Shipment Inco Term],
				1,
				'Shipment'[Additional Terms],
				1,
				'Shipment'[Shipment PPD CCX Term],
				1,
				'Shipment'[Goods Description],
				1,
				'Shipment'[Weight Unit],
				1,
				'Shipment'[Volume Unit],
				1,
				'Shipment'[Total No Of Packs Package Type],
				1,
				'Shipment'[Outer Packs Package Type],
				1,
				'Shipment'[Shipment Create Date],
				1,
				'Shipment'[Shipment Status],
				1,
				'Consolidation'[Job No.],
				1,
				'Consolidation'[Master Bill No.],
				1,
				'Service Level'[Service Level],
				1,
				'Shipment'[Interim Receipt Number],
				1,
				'Shipment'[Booking Confirmation Reference],
				1,
				'Shipment'[House Bill Type],
				1,
				'Shipment'[Is Transport Job],
				1,
				'Shipment'[Estimated Pickup],
				1,
				'Shipment'[Pickup Required By],
				1,
				'Shipment'[Delivery Cartage Completed],
				1,
				'Shipment'[Delivery Required By],
				1,
				'Shipment'[FCL Delivery Equipment Needed],
				1,
				'Shipment'[Estimated Delivery],
				1,
				'Shipment'[Pickup Cartage Completed],
				1,
				'Shipment'[FCL Pickup Equipment Needed],
				1,
				'Shipment'[Pickup Cartage Advised],
				1,
				'Shipment'[Chargeable Unit],
				1,
				'Shipment'[Is Master / Lead],
				1,
				'Shipment'[Is Brokerage],
				1,
				'Shipment'[Coload Master],
				1,
				'Shipment'[Container 20F],
				1,
				'Shipment'[Container 20H],
				1,
				'Shipment'[Container 20R],
				1,
				'Shipment'[Container 40F],
				1,
