<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreWindowsTargetFramework)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Enterprise.AuditDataServices.UatRunner</RootNamespace>
    <AssemblyName>Enterprise.AuditDataServices.UatRunner</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationManifest>..\..\..\..\..\main.manifest</ApplicationManifest>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Data" />
    <Reference Include="Enterprise.Integration" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\..\main.manifest">
      <Link>main.manifest</Link>
    </None>
  </ItemGroup>
  <Import Project="$(WTGBinRoot)CargoWiseOne.ResourceStrings.Transform.targets" />
  <ItemGroup>
    <ProjectReference Include="..\Notification\Notification.csproj" />
    <ProjectReference Include="..\Subscription\Subscription.csproj" />
    <ProjectReference Include="..\Subscription.Common\Subscription.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ServiceManager.Integration.ServiceTasks.CW" />
  </ItemGroup>
</Project>