            "source": {
              "query": [
                "SELECT LEFT(rs.CC_ID, 3) + RIGHT(rs.CC_ID, 3) AS [Client System Code]",
                "       ,rs.CC_ID AS [Client Licence Code]",
                "       ,rs.CC_FriendlyName AS [Client Licence Name]",
                "       ,rs.CC_PK CC_PK",
                "FROM [eHubTransactions].dbo.eHubClient rs"
              ],
              "dataSource": "eHubArchiveOnline"
            },
            "annotations": [
              {
