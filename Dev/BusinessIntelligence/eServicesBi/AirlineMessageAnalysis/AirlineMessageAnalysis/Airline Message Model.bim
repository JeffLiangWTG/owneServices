            "source": {
              "query": [
                "DECLARE @dt0 DATETIME = '2016-09-06 0:0:0';",
                "DECLARE @dt2 DATETIME = DATEADD(DAY, -30, @dt0);",
                "",
                "SELECT SUBSTRING(MAWBNumber, 4, 8)    [AWB Serial#]",
                "       ,SUBSTRING([MAWBNumber], 1, 3) [AWB Prefix]",
                "       ,CASE ",
                "              WHEN EventType = 'FMA'",
                "                      OR EventType = 'FNA'",
                "                      THEN EventType",
                "              ELSE 'FSU'",
                "              END                     [Type]",
                "       ,CASE ",
                "              WHEN EventType = 'FMA'",
                "                      OR EventType = 'FNA'",
                "                      THEN 'No Sub-Type'",
                "              ELSE EventType",
                "              END                     [Sub-Type]",
                "       ,[Sent UTC]                    [Sent UTC]",
                "\t,AM_CC_SenderOutbox",
                "\t,AM_CC_RecipientOutbox",
                "FROM (",
                "       SELECT m.AM_RecipientMessageXML.value('(/*:UniversalInterchange/*:Body/*:UniversalEvent/*:Event/*:EventType)[1]', 'NVARCHAR(MAX)') AS EventType",
                "       ,REPLACE(m.AM_RecipientMessageXML.value('(/*:UniversalInterchange/*:Body/*:UniversalEvent/*:Event/*:ContextCollection/*:Context/*:Value)[1]', 'NVARCHAR(MAX)'), '-', '') AS [MAWBNumber]",
                "              ,m.AM_ReceivedFromSenderUTC AS [Sent UTC]",
                "\t\t\t  ,m.AM_CC_SenderOutbox AM_CC_SenderOutbox",
                "\t\t\t  ,m.AM_CC_RecipientOutbox AM_CC_RecipientOutbox",
                "       FROM eHubArchiveMessage m WITH (NOLOCK)",
                "       WHERE  m.AM_RecipientMessageUncompressedLength > 100",
                "              AND m.AM_ReceivedFromSenderUTC >= @dt2",
                "              AND m.AM_ReceivedFromSenderUTC < @dt0",
                "       ) MyTable"
              ],
              "dataSource": "eHubArchiveOnline"
            },
