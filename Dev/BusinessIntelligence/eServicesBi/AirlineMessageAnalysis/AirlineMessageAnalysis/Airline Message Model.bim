      {
        "name": "Message Sent Date",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Date]",
            "formatString": "General Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Year Date]",
            "formatString": "General Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Message Sent Year",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Message Sent Year]",
            "sortByColumn": "Year Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Quarter Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Quarter Date]",
            "formatString": "General Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Message Sent Quarter",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Message Sent Quarter]",
            "sortByColumn": "Quarter Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month Date",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Month Date]",
            "formatString": "General Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Message Sent Month",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "isHidden": true,
            "sourceColumn": "[Message Sent Month]",
            "sortByColumn": "Month Date"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "VAR DateName = \"Message Sent\"",
                "RETURN",
                "    ADDCOLUMNS (",
                "        ADDCOLUMNS (",
                "            CALENDAR ( MIN ( 'Message'[Sent UTC] ), MAX ( 'Message'[Sent UTC] ) ),",
                "            \"Year Date\", DATE ( YEAR ( [Date] ), 1, 1 ),",
                "            \"Message Sent Year\", FORMAT ( [Date], \"YYYY\" ) & \" \"",
                "                & DateName",
                "        ),",
                "        \"Quarter Date\", DATE ( YEAR ( [Date] ), ( ( FORMAT ( [Date], \"Q\" ) - 1 ) * 3 ) + 1, 1 ),",
                "        \"Message Sent Quarter\", \"Q\" & FORMAT ( [Date], \"Q\" )",
                "            & \" \"",
                "            & [Message Sent Year],",
                "        \"Month Date\", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),",
                "        \"Message Sent Month\", FORMAT ( [Date], \"MMM\" ) & \" \"",
                "            & [Message Sent Year]",
                "    )"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Message Sent Date",
            "levels": [
              {
                "name": "Message Sent Year",
                "ordinal": 0,
                "column": "Message Sent Year"
              },
              {
                "name": "Message Sent Quarter",
                "ordinal": 1,
                "column": "Message Sent Quarter"
              },
              {
                "name": "Message Sent Month",
                "ordinal": 2,
                "column": "Message Sent Month"
              }
            ]
          }
        ]
      },
      {
        "name": "Sending Message",
        "columns": [
          {
            "name": "AWB Serial #",
            "dataType": "string",
            "sourceColumn": "AWB Serial #",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "AWB Prefix",
            "dataType": "string",
            "sourceColumn": "AWB Prefix",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Airline Code",
            "dataType": "string",
            "sourceColumn": "Airline Code",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Origin City",
            "dataType": "string",
            "sourceColumn": "Origin City",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Origin Country",
            "dataType": "string",
            "sourceColumn": "Origin Country",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Type",
            "dataType": "string",
            "sourceColumn": "Type",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Sub-Type",
            "dataType": "string",
            "sourceColumn": "Sub-Type",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "Sent UTC",
            "dataType": "dateTime",
            "sourceColumn": "Sent UTC",
            "formatString": "General Date",
            "sourceProviderType": "Date"
          },
          {
            "name": "AM_CC_SenderOutbox",
            "dataType": "string",
            "sourceColumn": "AM_CC_SenderOutbox",
            "sourceProviderType": "VarChar"
          },
          {
            "name": "AM_CC_RecipientOutbox",
            "dataType": "string",
            "sourceColumn": "AM_CC_RecipientOutbox",
            "sourceProviderType": "VarChar"
          }
        ],
        "partitions": [
          {
            "name": "Send Message",
            "dataView": "full",
            "source": {
              "query": [
                "DECLARE @dt0 DATETIME = '2016-09-06 0:0:0';",
                "DECLARE @dt1 DATETIME = DATEADD(DAY, - 365, @dt0);",
                "",
                "\tSELECT SUBSTRING([MAWBNumber], 4, 8) [AWB Serial #]",
                "\t\t,SUBSTRING([MAWBNumber], 1, 3) [AWB Prefix]",
                "\t\t,[Airline Code] [Airline Code]",
                "\t\t,SUBSTRING(MessageBody, 21, 3) [Origin City]",
                "\t\t,SUBSTRING(MessageBody, CHARINDEX(CHAR(10), MessageBody, CHARINDEX(CHAR(10), MessageBody, CHARINDEX(CHAR(10), MessageBody, CHARINDEX(CHAR(10) + 'SHP' + CHAR(10), MessageBody, 1) + 5) + 1) + 1) + 2, 2) [Origin Country]",
                "\t\t,'FWB' [Type]",
                "\t\t,'No Sub-Type' [Sub-Type]",
                "\t\t,[Sent UTC] [Sent UTC]",
                "\t\t,AM_CC_SenderOutbox",
                "\t\t,AM_CC_RecipientOutbox",
                "\tFROM (",
                "\t\tSELECT SenderMessage.value('(/*:CargoIMP/*:Carrier)[1]', 'NVARCHAR(MAX)') AS [Airline Code]",
                "\t\t\t,SenderMessage.value('(/*:CargoIMP/*:MAWB)[1]', 'NVARCHAR(MAX)') AS [MAWBNumber]",
                "\t\t\t,SenderMessage.value('(/*:CargoIMP/*:Body)[1]', 'NVARCHAR(MAX)') AS 'MessageBody'",
                "\t\t\t,[Sent UTC]",
                "\t\t\t,AM_CC_SenderOutbox",
                "\t\t\t,AM_CC_RecipientOutbox",
                "\t\tFROM (",
                "\t\t\tSELECT m.AM_ReceivedFromSenderUTC AS [Sent UTC]",
                "\t\t\t\t,CONVERT(XML, [eHubTransactions].dbo.DecodeAndDecompress(m.AM_SenderMessageRaw)) AS [SenderMessage]",
                "\t\t\t\t,m.AM_CC_SenderOutbox AM_CC_SenderOutbox",
                "\t\t\t\t,m.AM_CC_RecipientOutbox AM_CC_RecipientOutbox",
                "\t\t\tFROM eHubArchiveMessage m WITH (NOLOCK)",
                "\t\t\tWHERE m.AM_CC_RecipientInbox = '9819EFF9-9CD8-4622-B58E-32A251115722' -- ri.CC_ID = 'eHubAirService'",
                "\t\t\t\tAND m.AM_DT_RecipientMessageType = '16C507EE-68BE-4D1F-9888-BE865204A388' -- rt.DT_Code = 'http://www.cargowise.com/ehub/clients/edi/2010/06#FWB'",
                "\t\t\t\tAND m.AM_SenderMessageRaw IS NOT NULL",
                "\t\t\t\tAND m.AM_ReceivedFromSenderUTC >= @dt1",
                "\t\t\t\tAND m.AM_ReceivedFromSenderUTC < @dt0",
                "\t\t\t) MyTable1",
                "\t\t) MyTable2"
              ],
              "dataSource": "eHubArchiveOnline"
            },
            "annotations": [
              {
                "name": "QueryEditorSerialization",
                "value": [
                  "<?xml version=\"1.0\" encoding=\"UTF-16\"?><Gemini xmlns=\"QueryEditorSerialization\"><AnnotationContent><![CDATA[<RSQueryCommandText>DECLARE @dt0 DATETIME = '2016-09-06 0:0:0';",
                  "DECLARE @dt1 DATETIME = DATEADD(DAY, - 365, @dt0);",
                  "",
                  "\tSELECT SUBSTRING([MAWBNumber], 4, 8) [AWB Serial #]",
                  "\t\t,SUBSTRING([MAWBNumber], 1, 3) [AWB Prefix]",
                  "\t\t,[Airline Code] [Airline Code]",
                  "\t\t,SUBSTRING(MessageBody, 21, 3) [Origin City]",
                  "\t\t,SUBSTRING(MessageBody, CHARINDEX(CHAR(10), MessageBody, CHARINDEX(CHAR(10), MessageBody, CHARINDEX(CHAR(10), MessageBody, CHARINDEX(CHAR(10) + 'SHP' + CHAR(10), MessageBody, 1) + 5) + 1) + 1) + 2, 2) [Origin Country]",
                  "\t\t,'FWB' [Type]",
                  "\t\t,'No Sub-Type' [Sub-Type]",
                  "\t\t,[Sent UTC] [Sent UTC]",
                  "\t\t,AM_CC_SenderOutbox",
                  "\t\t,AM_CC_RecipientOutbox",
                  "\tFROM (",
                  "\t\tSELECT SenderMessage.value('(/*:CargoIMP/*:Carrier)[1]', 'NVARCHAR(MAX)') AS [Airline Code]",
                  "\t\t\t,SenderMessage.value('(/*:CargoIMP/*:MAWB)[1]', 'NVARCHAR(MAX)') AS [MAWBNumber]",
                  "\t\t\t,SenderMessage.value('(/*:CargoIMP/*:Body)[1]', 'NVARCHAR(MAX)') AS 'MessageBody'",
                  "\t\t\t,[Sent UTC]",
                  "\t\t\t,AM_CC_SenderOutbox",
                  "\t\t\t,AM_CC_RecipientOutbox",
                  "\t\tFROM (",
                  "\t\t\tSELECT m.AM_ReceivedFromSenderUTC AS [Sent UTC]",
                  "\t\t\t\t,CONVERT(XML, [eHubTransactions].dbo.DecodeAndDecompress(m.AM_SenderMessageRaw)) AS [SenderMessage]",
                  "\t\t\t\t,m.AM_CC_SenderOutbox AM_CC_SenderOutbox",
                  "\t\t\t\t,m.AM_CC_RecipientOutbox AM_CC_RecipientOutbox",
                  "\t\t\tFROM eHubArchiveMessage m WITH (NOLOCK)",
                  "\t\t\tWHERE m.AM_CC_RecipientInbox = '9819EFF9-9CD8-4622-B58E-32A251115722' -- ri.CC_ID = 'eHubAirService'",
                  "\t\t\t\tAND m.AM_DT_RecipientMessageType = '16C507EE-68BE-4D1F-9888-BE865204A388' -- rt.DT_Code = 'http://www.cargowise.com/ehub/clients/edi/2010/06#FWB'",
                  "\t\t\t\tAND m.AM_SenderMessageRaw IS NOT NULL",
                  "\t\t\t\tAND m.AM_ReceivedFromSenderUTC >= @dt1",
                  "\t\t\t\tAND m.AM_ReceivedFromSenderUTC < @dt0",
                  "\t\t\t) MyTable1",
                  "\t\t) MyTable2</RSQueryCommandText><RSQueryCommandType>Text</RSQueryCommandType><RSQueryDesignState></RSQueryDesignState>]]></AnnotationContent></Gemini>"
                ]
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": [
              "DECLARE @dt0 DATETIME = '2016-09-06 0:0:0';",
