        "partitions": [
          {
            "name": "Service Provider",
            "dataView": "full",
            "source": {
              "query": [
                "SELECT CASE ",
                "              WHEN CHARINDEX('_', rs.CC_ID) = 0",
                "                      THEN rs.CC_ID",
                "              ELSE LEFT(rs.CC_ID, CHARINDEX('_', rs.CC_ID) - 1)",
                "              END AS [Service Provider]",
                "       ,rs.CC_PK CC_PK",
                "FROM [eHubTransactions].dbo.eHubClient rs"
              ],
              "dataSource": "eHubArchiveOnline"
            },
