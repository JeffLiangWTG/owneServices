<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>CargoWise.Bi.Configuration</RootNamespace>
    <AssemblyName>CargoWise.Bi.Configuration</AssemblyName>
    <SuppressObsoleteWarnings>SYSLIB0051</SuppressObsoleteWarnings>
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
    <CWDisableNetCoreTestDiscovery>true</CWDisableNetCoreTestDiscovery>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Bi.Common" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DataSets\BiAutomationConfigDataSet.cs">
      <DependentUpon>BiAutomationConfigDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="DataSets\BiAutomationConfigDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BiAutomationConfigDataSet.xsd</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="DataSets\BiAutomationConfigDataSet.xsc">
      <DependentUpon>BiAutomationConfigDataSet.xsd</DependentUpon>
    </None>
    <None Update="DataSets\BiAutomationConfigDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>BiAutomationConfigDataSet.Designer.cs</LastGenOutput>
    </None>
    <None Update="DataSets\BiAutomationConfigDataSet.xss">
      <DependentUpon>BiAutomationConfigDataSet.xsd</DependentUpon>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>
</Project>