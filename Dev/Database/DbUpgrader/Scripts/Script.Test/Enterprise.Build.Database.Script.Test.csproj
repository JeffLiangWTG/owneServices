<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.Build.Database.Script.Testing</RootNamespace>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <UseVSHostingProcess>false</UseVSHostingProcess>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetFrameworkTargetFramework)' == 'true'">
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.Bi.Common" />
    <Reference Include="CargoWise.Bi.ConfigLoader" />
    <Reference Include="CargoWise.Bi.Configuration" />
    <Reference Include="CargoWise.CalendarArithmetic" />
    <Reference Include="CargoWise.Common" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.Database.TestFramework" />
    <Reference Include="CargoWise.DbUpgrader.Scripts.Abstractions" />
    <Reference Include="CargoWise.DbUpgrader.Scripts.Definitions" />
    <Reference Include="CargoWise.Definitions" />
    <Reference Include="CargoWise.Schema" />
    <Reference Include="CargoWise.Types" />
    <Reference Include="Enterprise.DbUpgrader.Shared" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Data.Test" />
    <Reference Include="CargoWise.Data.Shared" />
    <Reference Include="CargoWise.Odyssey.Schema" />
    <Reference Include="Enterprise.DbUpgrader.Shared.Testing" />
    <Reference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <Reference Include="Microsoft.SqlServer.Types" />
    <Reference Include="Enterprise.ChangeDataCapture.Common" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="NUnitCore" />
    <Reference Include="System.Collections.Immutable" />
    <Reference Include="System.Memory" />
    <Reference Include="WTG.StaticAnalysis.Annotation" />
    <Reference Include="NUnit.Framework" />
    <Reference Include="WTG.NUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Script.TestFramework\Enterprise.Build.Database.Script.TestFramework.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Internal\DBCreateTriggerScriptBaseline.txt">
      <LogicalName>DBCreateTriggerScriptBaseline.txt</LogicalName>
      <DependentUpon>DBCreateTriggerScriptTest.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Public\BusinessIntelligence\EDW\ReportFunctions\Shipment\" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="Public\BusinessIntelligence\EDW\Model\hrm\**" />
  </ItemGroup>
</Project>