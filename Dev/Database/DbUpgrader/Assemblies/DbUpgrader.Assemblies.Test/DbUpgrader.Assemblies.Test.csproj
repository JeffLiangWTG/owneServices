<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;$(CWNetCoreTargetFramework)</TargetFrameworks>
    <RootNamespace>Enterprise.DbUpgrader.Assemblies.Testing</RootNamespace>
    <AssemblyName>Enterprise.DbUpgrader.Assemblies.Test</AssemblyName>
    <SuppressObsoleteWarnings>SYSLIB0024</SuppressObsoleteWarnings>
    <CWUsesSqlClient>true</CWUsesSqlClient>
  </PropertyGroup>
  <Import Project="$(WTGBranchRoot)NetCore\NetCoreCommon.props" />
  <ItemGroup>
    <Reference Include="CargoWise.Bi.Common" />
    <Reference Include="CargoWise.Data" />
    <Reference Include="CargoWise.Data.Test" />
    <Reference Include="CargoWise.Data.SqlClr.Registration" />
    <Reference Include="CargoWise.Database.Abstractions" />
    <Reference Include="CargoWise.Database.Shared" />
    <Reference Include="CargoWise.DbUpgrader.Foundation" />
    <Reference Include="CargoWise.Shared.40" />
    <Reference Include="Enterprise.DbUpgrader.Shared" />
    <Reference Include="Enterprise.DbUpgrader.Shared.Testing" />
    <Reference Include="Moq" />
    <Reference Include="NUnitCore" />
    <ProjectReference Include="..\DbUpgrader.Assemblies\DbUpgrader.Assemblies.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsNetCoreTargetFramework)' == 'true'">
    <Reference Include="System.CodeDom" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestFiles\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="TestFiles\*.cs" />
  </ItemGroup>
</Project>