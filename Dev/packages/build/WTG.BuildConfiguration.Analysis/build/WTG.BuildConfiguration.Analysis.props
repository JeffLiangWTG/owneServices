<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
	</PropertyGroup>
	<ItemGroup>
  		<GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\buildcomponents\WTGRuleSet.FxCopAnalyzer.editorconfig" />
  		<GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\buildcomponents\WTGRuleSet.StyleCopAnalyzers.editorconfig" />
	</ItemGroup>
	<ItemGroup Condition="'$(WTGIsTestProject)' != 'true'">
  		<GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\buildcomponents\WTGRuleSet.FxCopAnalyzer.Production.editorconfig" />
	</ItemGroup>
	<ItemGroup Condition="'$(WTGIsTestProject)' == 'true'">
  		<GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\buildcomponents\NUnit.editorconfig" />
  		<GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)..\buildcomponents\WTGRuleSet.FxCopAnalyzer.UnitTest.editorconfig" />
	</ItemGroup>
</Project>
