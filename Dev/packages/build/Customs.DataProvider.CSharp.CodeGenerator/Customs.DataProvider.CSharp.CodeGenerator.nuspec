<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Customs.DataProvider.CSharp.CodeGenerator</id>
    <version>2.3.0</version>
    <title>Customs Data Provider Generator Package</title>
    <authors>WiseTech Global</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <readme>README.md</readme>
    <description>Package consists of components required for generating Data Provider from Message Builder's metadata. The package is used in conjuction with Message Builder Generator and Data Provider Contracts Generator.</description>
    <tags>customs message-builder data-provider</tags>
    <repository type="git" url="https://github.com/WiseTechGlobal/CargoWise.Shared" commit="9719b76ce7d4b50292864c719b23e56082e34222" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Customs.MessageBuilder.Generator.Common" version="2.3.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CodeAnalysis.Analyzers" version="[3.3.4]" exclude="Build,Analyzers" />
        <dependency id="Microsoft.CodeAnalysis.CSharp" version="[4.8.0]" exclude="Build,Analyzers" />
        <dependency id="WTG.BuildConfiguration.Signing" version="3.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>