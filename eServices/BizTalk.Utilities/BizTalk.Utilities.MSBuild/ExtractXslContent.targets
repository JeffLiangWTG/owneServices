<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- Declare custom tasks -->
    <UsingTask TaskName="ExtractXslContentTask" AssemblyFile="$(MSBuildThisFileDirectory)\BizTalk.Utilities.MSBuild.dll" />
    
    <Target Name="AfterBuild">

		<Message Text="Start ExtractXslContent task on $(ProjectDir)" Importance="high" />		
        <ExtractXslContentTask BaseDirectory="$(ProjectDir)" />

    </Target>

</Project>