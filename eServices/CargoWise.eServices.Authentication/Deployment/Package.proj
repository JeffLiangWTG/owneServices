<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="CreatePackages">
	<Target Name="bat:package">
		<ItemGroup>
			<PackageProjects Include="..\CargoWise.eServices.Authentication.WindowsService\CargoWise.eServices.Authentication.WindowsService.csproj"/>
			<PackageProjects Include="..\CargoWise.eServices.Authentication.WebService\CargoWise.eServices.Authentication.WebService.csproj"/>
			<PackageProjects Include="..\CargoWise.eServices.Authentication.Database\CargoWise.eServices.Authentication.Database.sqlproj" />
			<PackageProjects Include="..\CargoWise.eServices.Authentication.ServiceClient\CargoWise.eServices.Authentication.ServiceClient.csproj" />
		</ItemGroup>
		
		<MSBuild Projects="@(PackageProjects)"
						 Targets="bat:package"/>
	</Target>
</Project>