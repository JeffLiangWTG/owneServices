<?xml version="1.0" encoding="utf-8" ?>
<package xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<metadata>
		<id xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">ABC</id>
		<version xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">$version$</version>
		<title xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">$title$</title>
		<authors xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">$author$</authors>
		<owners xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">$author$</owners>
		<requireLicenseAcceptance xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">false</requireLicenseAcceptance>
		<description xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">$description$</description>
		<copyright xdt:Transform="SetAttributes"
			 xdt:Locator="Match(name)">$copyright$</copyright>
	</metadata>
</package>