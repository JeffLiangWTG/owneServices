<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_Server></_Server>
		<_DeploymentPropsImported>$true</_DeploymentPropsImported>
		<_SiteName>Default Web Site</_SiteName>
		<_ServiceName>Authentication</_ServiceName>
		<_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
		<_BackupFolder>c:\eServicesTesting\AuthenticationWebService_backup</_BackupFolder>
		<_AnonymousAuthenticationEnabled>true</_AnonymousAuthenticationEnabled>
		<_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
	<ItemGroup>
		<_Binding Include="1">
			<IPAddress>*</IPAddress>
			<Port>443</Port>
			<Protocol>https</Protocol>
			<HostHeader></HostHeader>
		</_Binding>
		<_Binding Include="2">
			<IPAddress>*</IPAddress>
			<Port>8080</Port>
			<Protocol>http</Protocol>
			<HostHeader></HostHeader>
		</_Binding>
	</ItemGroup>
</Project>