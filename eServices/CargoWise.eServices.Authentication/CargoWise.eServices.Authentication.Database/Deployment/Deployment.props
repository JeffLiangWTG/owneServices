<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_Server>localhost</_Server>
    <_DatabaseFilesPath>$(OutputPath)</_DatabaseFilesPath>
    <_DacpacFileName>CargoWise.eServices.Authentication.Database.dacpac</_DacpacFileName>
    <_TargetDatabaseName>AuthenticationWebService</_TargetDatabaseName>
    <_SqlDeploymentConfigFilePath>Deployment\config.sqldeployment.xml</_SqlDeploymentConfigFilePath>
  </PropertyGroup>
</Project>