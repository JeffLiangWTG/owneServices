<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<configSections>
		<sectionGroup name="common">
			<section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
		</sectionGroup>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>

	<common>
		<logging>
			<factoryAdapter type="Common.Logging.Log4Net.Log4NetLoggerFactoryAdapter, Common.Logging.Log4Net1211">
				<arg key="configType" value="FILE" />
				<arg key="configFile" value="~/log4net.config" />
			</factoryAdapter>
		</logging>
	</common>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
	</startup>

	<connectionStrings>
		<add name="AuthenticationDB" connectionString="Server=localhost;Database=AuthenticationWebService;Integrated Security=SSPI;" />
		<add name="ediProdDB" connectionString="Server=localhost;Database=ediProdCache;Integrated Security=SSPI;" />
	</connectionStrings>

	<appSettings>
		<add key="IntervalSeconds" value="300" />
	</appSettings>
</configuration>