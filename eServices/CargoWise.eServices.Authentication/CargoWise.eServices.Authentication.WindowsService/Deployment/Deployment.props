<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_ServiceName>Authentication</_ServiceName>
		<_DeploymentPropsImported>$true</_DeploymentPropsImported>
		<_ServiceDisplayName>Authentication Service - eServices</_ServiceDisplayName>
		<_ServiceDescription>Copy data from ediProd database to Authentication database</_ServiceDescription>
		<_ServiceFilesPath>$(OutputPath)</_ServiceFilesPath>
		<_ServiceExeFileName>CargoWise.eServices.Authentication.WindowsService.exe</_ServiceExeFileName>
		<_DeploymentFolder>c:\eServicesTesting\AuthenticationServices</_DeploymentFolder>
		<_BackupFolder>c:\eServicesTesting\Authentication_backup</_BackupFolder>
		<_LogsFolder>logs</_LogsFolder>
	</PropertyGroup>
</Project>