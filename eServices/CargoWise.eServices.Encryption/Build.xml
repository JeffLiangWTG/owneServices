<?xml version="1.0" encoding="utf-8"?>
<Build xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema" MSBuild="16.0"
  xmlns="http://wisetechglobal.com/DevTools/Build.xsd">
  <Cleanup>
    <Item>packages\NUnit3TestAdapter</Item>
  </Cleanup>
  <PreBuild>
    <Command cacheable="false">cmd.exe /C mkdir Bin\LocalRepo || ver>nul</Command>
  </PreBuild>
  <Solutions>
    <Solution Filename="CargoWise.eServices.Encryption.sln" />
  </Solutions>
  <PostBuild>
    <Command cacheable="false">Bin\Deployment\BAT\post-build.cmd</Command>
  </PostBuild>
  <BuildConfigurations>
    <Configuration BuildOnDat="true" TestOnDat="true">DEBUG</Configuration>
    <Configuration BuildOnDat="true" Publishable="true">RELEASE</Configuration>
  </BuildConfigurations>
  <Dependencies>
    <Dependency Repository="https://devops.wisetechglobal.com/wtg/eServices/_git/eServices" Path="/Deployment">
      <Copy Source="Deployment" Target="Deployment" />
      <Copy Source="XT.REST.Deployment" Target="Deployment\Bin\XT.REST.Deployment" />
    </Dependency>
    <Dependency Repository="https://devops.wisetechglobal.com/wtg/eServices/_git/eServices" Path="/DatImplementation">
      <Copy Source="Dat.Integration.dll" Target="DAT" />
      <Copy Source="eHub.DatImplementation.Deployment.dll" Target="DAT" />
      <Copy Source="Microsoft.Build.dll" Target="DAT" />
      <Copy Source="Microsoft.Build.Framework.dll" Target="DAT" />
      <Copy Source="Microsoft.Build.Tasks.Core.dll" Target="DAT" />
      <Copy Source="Microsoft.Build.Utilities.Core.dll" Target="DAT" />
      <Copy Source="System.Collections.Immutable.dll" Target="DAT" />
      <Copy Source="System.Buffers.dll" Target="DAT" />
      <Copy Source="System.Memory.dll" Target="DAT" />
      <Copy Source="System.Numerics.Vectors.dll" Target="DAT" />
      <Copy Source="System.Runtime.CompilerServices.Unsafe.dll" Target="DAT" />
      <Copy Source="System.Threading.Tasks.Dataflow.dll" Target="DAT" />
    </Dependency>
  </Dependencies>
  <DatSettings BuildDeployerType="eHub.DatImplementation.Deployment.BuildDeployer, eHub.DatImplementation.Deployment" IntegrationAssembliesSubdir="DAT">
    <TestAdapters>
      <TestAdapter Key="VSTest" Type="Dat.Implementation.VSTest.VSTestAdapter, Dat.Implementation.VSTest">
        <Options>
          <Option Name="TestAssemblyReferenceFilter">Microsoft.VisualStudio.QualityTools.UnitTestFramework</Option>
        </Options>
      </TestAdapter>
      <TestAdapter Key="NUnit" Type="Dat.Implementation.NUnit3.NUnit3TestAdapter, Dat.Implementation.NUnit3">
        <Options>
          <Option Name="TestAssemblyAnyItemFilter">nunit</Option>
        </Options>
      </TestAdapter>
    </TestAdapters>
  </DatSettings>
</Build>