<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
  <PropertyGroup>
    <DeploymentProjectsPath>$(MsBuildThisFileDirectory)Bin\Deployment</DeploymentProjectsPath>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MsBuildThisFileDirectory)EDI-Release-private.snk</AssemblyOriginatorKeyFile>
    <Deterministic>true</Deterministic>
    <Authors>WiseTech Global</Authors>
    <Company>WiseTech Global</Company>
    <Copyright>Copyright © 2020-2023 WiseTech Global</Copyright>
    <PackageOutputPath>$(MsBuildThisFileDirectory)Bin\LocalRepo</PackageOutputPath>
  </PropertyGroup>
</Project>