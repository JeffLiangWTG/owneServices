<?xml version="1.0" encoding="utf-8"?>
<DatDeploy xmlns="http://eservices.buildtools/datdeploy">
  <Targets>
    <Target Name="BAT=$(BinPath)\BAT\CargoWise.eServices.Billing.Collector.eHub.WindowsService.zip;p:Profile=Test;t:bat:deploy" Command="%CMD_EHUB_DAT%" Environment="Staging" />
    <Target Name="BAT=$(BinPath)\BAT\CargoWise.eServices.Billing.Collector.eHub.WindowsService.zip;p:Profile=Production;t:bat:deploy" Command="%CMD_EHUB_DAT%" Environment="Production" />
  </Targets>
  <!-- Common Settings
         Default settings that are available in deployments are:
            DAT_DEPLOYMENT_CONFIGURATION  - Value of DeploymentConfiguration in Build.xml.
            DAT_DEPLOYMENT_NAME           - DeploymentConfiguration with special characters removed.
            DAT_SOURCE_PATH               - Path to root of repo source files.
            DAT_BIN_PATH                  - Path to Bin folder.
            TIMESTAMP                     - UTC time at start of build. Format is "yyyyMMdd.HHmmssZ".-->
  <Settings>
    <Add Name="CMD_EHUB_DAT" Value="powershell %DAT_SOURCE_PATH%\Deploy-eHub.ps1 '%DAT_DEPLOYMENT_CONFIGURATION%'" />
    <Add Name="CMD_PUBLISH_PACKAGE">
      <![CDATA[powershell "dir $env:PKG_PATH -Exclude *-rc[0-9]*.nupkg | sort | select -last 1 | %% { dotnet nuget push $_.FullName --source $env:BUILD_TOOLS_PUBLISH_PACKAGE_SOURCE --api-key $env:API_KEY --skip-duplicate }"]]>
    </Add>
    <Add Name="CMD_PUBLISH_PACKAGE_PRERELEASE">
      <![CDATA[powershell "dir $env:PKG_PATH -Include *-rc[0-9]*.nupkg | sort | select -last 1 | %% { dotnet nuget push $_.FullName --source $env:BUILD_TOOLS_PUBLISH_PACKAGE_SOURCE --api-key $env:API_KEY --skip-duplicate }"]]>
    </Add>
    <Add Name="MSDEPLOY" Value="%ProgramFiles%\IIS\Microsoft Web Deploy V3\msdeploy.exe" />
    <Add Name="DEPLOY_STAGING_PATH" Value="C:\eServices.Deploy\%DAT_DEPLOYMENT_CONFIGURATION%\%TIMESTAMP%" />
  </Settings>
