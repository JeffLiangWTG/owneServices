source https://proget.wtg.zone/nuget/Gallery/v3/index.json
source https://proget.wtg.zone/nuget/WTG-Internal/v3/index.json

# This filters out extra supporting libraries from .NET Core that
# we don't care about (yet).
framework: net45

# This is our list of packages.
# If you know what you're doing, manually add an entry.
# If you don't, use "paket.exe add nuget <package> --no-install".
# Use "dotnet tool run paket update --no-install" to update paket.lock.
# Use "dotnet tool run paket restore" to update the package cache above
#
# DO NOT UPDATE paket.lock BY HAND!
#

nuget NUnit 3.13.3
nuget Common.Logging 3.4.1
nuget Common.Logging.Core 3.4.1
nuget Common.Logging.Log4Net208 3.4.1
nuget log4net 2.0.8
nuget EntityFramework 6.1.3
nuget Moq 4.17.2
nuget Microsoft.Extensions.Logging 8.0.0
nuget Microsoft.Extensions.Logging.Log4Net.AspNetCore 3.1.0
nuget Microsoft.Extensions.Options 8.0.0
nuget Microsoft.Extensions.Logging.Abstractions 8.0.0
nuget System.Memory 4.5.5
nuget CargoWise.eServices.Encryption.Server.Decryptor 1.0.1
nuget CargoWise.eServices.Encryption.Client.Encryptor 1.0.1
nuget CargoWise.eServices.Encryption.Server.Encryptor 1.0.1
nuget CargoWise.eServices.Encryption.Client.Decryptor 1.0.1
nuget WTG.ErrorReporting
nuget Castle.Core 4.4.1
nuget Newtonsoft.Json 13.0.3
nuget CsvHelper 12.1.2
nuget NUnit3TestAdapter 4.6.0

group Tools
  source https://proget.wtg.zone/nuget/Gallery/v3/index.json
  framework: net45
  lowest_matching: true

  nuget Microsoft.TeamFoundationServer.ExtendedClient >= 15.0