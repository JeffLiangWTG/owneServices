<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_BinPath>Bin</_BinPath>
    <_ServiceName>eHubBilling</_ServiceName>
    <_ServiceDisplayName>Billing Service - eHub</_ServiceDisplayName>
    <_ServiceDescription>Collects and sends eHub billing information to a server.</_ServiceDescription>
    <_ServiceFilesPath>$(_BinPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eServices.Billing.Collector.eHub.WindowsService.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServices</_DeploymentFolder>
    <_BackupFolder>c:\eServices\Backup\eHubBilling</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>