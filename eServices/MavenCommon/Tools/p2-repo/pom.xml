<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.eservices.p2.repo</groupId>
	<artifactId>p2-repo</artifactId>
	<name>P2 Repo Update Site</name>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices</groupId>
		<artifactId>eservices-repo-pom</artifactId>
		<version>1.0.0</version>
	</parent>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<tomcat_hostname>localhost</tomcat_hostname>
		<tomcat_port>8080</tomcat_port>
		<tomcat_protocol>http</tomcat_protocol>
		<tomcat_username>admin</tomcat_username>
		<tomcat_password>ehubrocks</tomcat_password>
		<tomcat_deployment_path>eServiceP2Repo</tomcat_deployment_path>
	</properties>
	
	<profiles>
		<profile>
			<id>test</id>
			<properties>
				<tomcat_hostname>au2sp-shub-401.sand.wtg.zone</tomcat_hostname>
			</properties>
		</profile>
	</profiles>
		
	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho.extras</groupId>
				<artifactId>tycho-p2-extras-plugin</artifactId>
				<version>1.4.0</version>
				<executions>
					<execution>
						<id>mirror</id>
						<goals>
							<goal>mirror</goal>
						</goals>
						<phase>prepare-package</phase>
					</execution>
				</executions>
				<configuration>
					<source>
						<!-- ************************* Fill the new update-site p2 repo here ************************ -->
						<repository>
							<!-- https://github.com/pmd/pmd-eclipse-plugin/releases -->
							<url>${project.baseUri}/sites/net.sourceforge.pmd.eclipse.p2updatesite-4.10.1.v20200207-1909</url>
							<layout>p2</layout>
						</repository>
						<repository>
							<url>${project.baseUri}/sites/findbugs_3.1.0_preview2_update_site_3.1.0.20160619-68c6293</url>
							<layout>p2</layout>
						</repository>
						<repository>
							<url>${project.baseUri}/sites/net.sf.eclipsecs-updatesite_8.0.0.201707161819</url>
							<layout>p2</layout>
						</repository>
						<repository>
							<url>${project.baseUri}/sites/eclemma-3.0.0</url>
							<layout>p2</layout>
						</repository>
						<repository>
							<url>${project.baseUri}/sites/jd-eclipse-site-1.0.0-RC2</url>
							<layout>p2</layout>
						</repository>
						<repository>
							<!-- https://github.com/Microsoft/team-explorer-everywhere/releases -->
							<url>${project.baseUri}/sites/TFSEclipsePlugin-UpdateSiteArchive-14.134.0</url>
							<layout>p2</layout>
						</repository>
						<repository>
							<!-- https://github.com/Microsoft/team-explorer-everywhere/releases -->
							<url>${project.baseUri}/sites/windowbuilder-1.9.0</url>
							<layout>p2</layout>
						</repository>
			            <repository>
			              <url>${project.baseUri}/sites/scala2.1.2</url>
			              <layout>p2</layout>
			            </repository>
					</source>
					<xzCompress>true</xzCompress>
					<destination>${project.build.directory}/repository</destination>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.0.2</version>
				<executions>
					<execution>
						<id>copy-p2-index</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.basedir}/target/repository</outputDirectory>
							<resources>
								<resource>
									<directory>sites</directory>
									<filtering>false</filtering>
									<includes>
										<include>p2.index</include>
										<include>index.html</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.5.4</version>
				<configuration>
					<descriptor>war.xml</descriptor>
					<finalName>p2-repo</finalName>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>packaging-war</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>tomcat-maven-plugin</artifactId>
				<version>1.1</version>
				<configuration>
					<url>${tomcat_protocol}://${tomcat_hostname}:${tomcat_port}/manager/text</url>
					<username>${tomcat_username}</username>
					<password>${tomcat_password}</password>
					<warFile>${project.build.directory}/p2-repo.war</warFile>
					<path>/${tomcat_deployment_path}</path>
				</configuration>
				<executions>
					<execution>
						<id>deploy-to-tomcat</id>
						<phase>deploy</phase>
						<goals>
							<goal>deploy-only</goal>
						</goals>
						<configuration>
							<ignorePackaging>true</ignorePackaging>
							<update>true</update>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>