<!-- this common pom is used for project's parent pom -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.eservices</groupId>
	<artifactId>eservices-common-parent-pom</artifactId>
	<version>1.0.0</version>
	<name>Common Parent Pom</name>
	<description>Holding common logics and rules of Parent's Maven project for packing usage. Each parent project must
		inherit this Maven pom.
	</description>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices</groupId>
		<artifactId>plugin-versions-pom</artifactId>
		<version>1.0.0</version>
		<relativePath>./plugin-versions-pom.xml</relativePath>
	</parent>

	<properties>
		<bin.directory>../Bin</bin.directory>
	</properties>
	<profiles>
		<profile>
			<id>code-coverage</id>
			<activation>
				<property>
					<name>skip.code.coverage</name>
					<value>false</value>
				</property>
			</activation>
			<properties>
				<jacoco.agent.dir>${project.build.directory}/jacoco.exec</jacoco.agent.dir>
				<teamcity.jacoco.import>jacocoReport dataPath='${project.build.directory}/jacoco.exec' includes='com.cargowise.*' excludes='com.cargowise.*.autogenerated.* com.cargowise.*.jaxws.*' classpath='**/target/classes/**/*.class'</teamcity.jacoco.import>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<executions>
							<execution>
								<id>enforce-teamcity-jacoco-import</id>
								<goals>
									<goal>enforce</goal>
								</goals>
								<configuration>
									<rules>
										<requireProperty>
											<property>teamcity.jacoco.import</property>
											<message>You must set a teamcity.jacoco.import property without newline, tab</message>
											<regex>[^\t\r\n]+</regex>
											<regexMessage>The teamcity.jacoco.import property must be in one line and no tab. The current value is: ${teamcity.jacoco.import}</regexMessage>
										</requireProperty>
									</rules>
									<fail>true</fail>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>merge</id>
								<phase>post-integration-test</phase>
								<goals>
									<goal>merge</goal>
								</goals>
								<configuration>
									<fileSets>
										<!-- Merge jacoco to target/jacoco.exec from mutilple target/coverage-reports/[jacoco-ut.exec|jacoco-it.exec] file -->
										<fileSet implementation="org.apache.maven.shared.model.fileset.FileSet">
											<directory>${basedir}/..</directory>
											<includes>
												<include>**/*.exec</include>
											</includes>
										</fileSet>
									</fileSets>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<phase>verify</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<echo>Import Jacoco in Teamcity: ## teamcity[${teamcity.jacoco.import}]</echo>
										<echo>##teamcity[${teamcity.jacoco.import}]</echo>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>auto-generate-archiver-xml</id>
			<activation>
				<file>
					<missing>${basedir}\archiver.xml</missing>
				</file>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>unpack-archiver-xml</id>
								<phase>validate</phase>
								<goals>
									<goal>unpack</goal>
								</goals>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>com.cargowise.eservices</groupId>
											<artifactId>maven-build-tools</artifactId>
											<version>${maven.build.tools.version}</version>
											<outputDirectory>${basedir}</outputDirectory>
											<includes>archiver.xml</includes>
										</artifactItem>
									</artifactItems>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>eclipse-tpignore-config-installation</id>
			<activation>
				<file>
					<missing>${basedir}\.tpignore</missing>
				</file>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>unpack-eclipse-tpignore</id>
								<phase>validate</phase>
								<goals>
									<goal>unpack</goal>
								</goals>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>com.cargowise.eservices</groupId>
											<artifactId>maven-build-tools</artifactId>
											<version>${maven.build.tools.version}</version>
											<outputDirectory>${basedir}</outputDirectory>
											<includes>.tpignore</includes>
										</artifactItem>
									</artifactItems>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<descriptor>archiver.xml</descriptor> <!-- Please copy MavenCommon/archiver.xml to your inherited project and modify. -->
					<finalName>${project.build.finalName}</finalName>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>packaging-zip</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>package-repo-pom</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.cargowise.eservices</groupId>
									<artifactId>eservices-repo-pom</artifactId>
									<version>1.0.0</version>
									<type>pom</type>
									<destFileName>repo-pom.xml</destFileName>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/deploy</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-resources-deploy-folder</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/deploy</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/deploy</directory>
									<excludes>
										<exclude>target/**</exclude>
									</excludes>
								</resource>
							</resources>
						</configuration>
					</execution>
					<execution>
						<id>copy-to-bin</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${bin.directory}</outputDirectory>
							<resources>
								<resource>
									<directory>${project.build.directory}</directory>
									<includes>
									  <include>*.zip</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
