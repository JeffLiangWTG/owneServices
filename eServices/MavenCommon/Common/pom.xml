<!-- When you need to update C:\eServices\common-pom.xml and repo-pom.xml.
	Run cmd: C:\eService>mvn deploy -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>eservices-common-installation</artifactId>
	<name>eServices Common pom installation</name>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices</groupId>
		<artifactId>eservices-repo-pom</artifactId>
		<version>1.0.0</version>
		<relativePath>./repo-pom.xml</relativePath>
	</parent>

	<modules>
		<module>./MavenEnvironmentInstallation</module>
		<module>./MavenBuildTools</module>
	</modules>
	
	<properties>
		<bin.directory>../Bin</bin.directory>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.0.2</version>
				<executions>
					<execution>
						<id>package-resources</id>
						<phase>package</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${bin.directory}</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}</directory>
									<includes>
										<include>*pom.xml</include>
									</includes>
									<excludes>
										<exclude>pom.xml</exclude>
									</excludes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.4</version>
				<executions>
					<execution>
						<id>install-repo-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>install</phase>
						<configuration>
							<file>repo-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>eservices-repo-pom</artifactId>
							<pomFile>repo-pom.xml</pomFile>
						</configuration>
					</execution>
					<execution>
						<id>install-plugin-versions-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>install</phase>
						<configuration>
							<file>plugin-versions-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>plugin-versions-pom</artifactId>
							<pomFile>plugin-versions-pom.xml</pomFile>
						</configuration>
					</execution>
					<execution>
						<id>install-common-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>install</phase>
						<configuration>
							<file>common-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>eservices-common-pom</artifactId>
							<pomFile>common-pom.xml</pomFile>
						</configuration>
					</execution>
					<execution>
						<id>install-common-parent-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>install</phase>
						<configuration>
							<file>common-parent-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>eservices-common-parent-pom</artifactId>
							<pomFile>common-parent-pom.xml</pomFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<configuration>
					<skip>true</skip>
				</configuration>
				<executions>
					<execution>
						<id>deploy-repo-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>repo-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>eservices-repo-pom</artifactId>
							<pomFile>repo-pom.xml</pomFile>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
					<execution>
						<id>deploy-plugin-versions-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>plugin-versions-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>plugin-versions-pom</artifactId>
							<pomFile>plugin-versions-pom.xml</pomFile>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
					<execution>
						<id>deploy-common-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>common-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>eservices-common-pom</artifactId>
							<pomFile>common-pom.xml</pomFile>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
					<execution>
						<id>deploy-common-parent-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>common-parent-pom.xml</file>
							<groupId>com.cargowise.eservices</groupId>
							<artifactId>eservices-common-parent-pom</artifactId>
							<pomFile>common-parent-pom.xml</pomFile>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
