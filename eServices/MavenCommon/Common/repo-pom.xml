<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.cargowise.eservices</groupId>
  <artifactId>eservices-repo-pom</artifactId>
  <version>1.0.0</version>
  <name>Common Repository Pom</name>
  <description>Defining internal repository to store and retrieve internal artifacts.</description>
  <url></url>
  <packaging>pom</packaging>

  <properties>
    <repoID>wtg</repoID>
    <wtgRepo>https://proget.wtg.zone/maven2/WTG-Maven/</wtgRepo>
    <globalRepo>https://proget.wtg.zone/maven2/Maven/</globalRepo>
    <!-- System properties -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <distributionManagement>
    <repository>
      <id>${repoID}</id>
      <name>Wisetech Global Internal Repository</name>
      <url>${wtgRepo}</url>
    </repository>
  </distributionManagement>
  <!-- Order downloading: Central -> internal -> snapshot -->
  <repositories>
    <repository>
      <id>${repoID}</id>
      <name>Wisetech Global Internal Repository</name>
      <url>${wtgRepo}</url>
    </repository>
    <repository>
      <id>maven</id>
      <name>Wisetech Global Internal Maven Repository</name>
      <url>${globalRepo}</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>${repoID}</id>
      <name>Wisetech Global Internal Repository</name>
      <url>${wtgRepo}</url>
    </pluginRepository>
    <pluginRepository>
      <id>maven</id>
      <name>Wisetech Global Internal Maven Repository</name>
      <url>${globalRepo}</url>
    </pluginRepository>
  </pluginRepositories>
</project>