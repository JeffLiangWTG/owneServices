  <UsingTask TaskName="Listener-IsPortNumberInUse"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <PortNumber Required="true" ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
      <IsInUse Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Listener-IsPortNumberInUse(PortNumber:$PortNumber) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($PortNumber)
    try
    {
        $allQueueManagerNames = dspmq.exe | Out-String | Select-String -Pattern 'QMNAME\((?<Name>.+)\)\s+STATUS\((?<Status>.+)\)' -AllMatches | ForEach-Object { $_.Matches } | Where-Object {$_.Groups["Status"].Value -eq  "Running"} | ForEach-Object { $_.Groups["Name"].Value }
        if ($LASTEXITCODE -ne 0)
        {
            $errorMessage = if ($Error[0]) { $Error[0] | Out-String } else {""}
            throw "Could not display all queue managers. Error code: $LASTEXITCODE. Error Message: $errorMessage"
        }

        foreach ($queueManagerName in $allQueueManagerNames)
        {
            $result = "DISPLAY LISTENER(*)" | runmqsc.exe $queueManagerName
            if ($LASTEXITCODE -ne 0) { throw "Could not display all listeners in queue manager '$queueManagerName'. Error code: $LASTEXITCODE. Error Message: $result" }

            $allListenerNames = $result | Out-String | Select-String -Pattern 'LISTENER\((?<Name>.+)\)' -AllMatches | ForEach-Object { $_.Matches } | ForEach-Object { $_.Groups["Name"].Value }
            foreach ($listenerName in $allListenerNames)
            {
                $result = "DISPLAY LISTENER($listenerName) PORT" | runmqsc.exe $queueManagerName
                if ($LASTEXITCODE -ne 0) { throw "Could not display listener '$listenerName' in queue manager '$queueManagerName'. Error code: $LASTEXITCODE. Error Message: $result" }
                $match = $result | Out-String | Select-String -Pattern "LISTENER\($listenerName\)\s+PORT\($PortNumber\)" | ForEach-Object { $_.Matches }
                if ($match -ne $null)
                {
                    RETURN $true
                }
            }
        }

        $False
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $PortNumber
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -is [Boolean]
if ($Succeeded) { $IsInUse = $Result.ToString() }
else { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed Listener-IsPortNumberInUse. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
