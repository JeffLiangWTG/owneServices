<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CommonPowershellFunctionsFilePath>.\Common.ps1</CommonPowershellFunctionsFilePath>
    <CommonPowershellFunctionsFilePath Condition="!Exists('$(CommonPowershellFunctionsFilePath)')">$(MSBuildThisFileDirectory)\..\CommonScripts\Common.ps1</CommonPowershellFunctionsFilePath>
  </PropertyGroup>

  <UsingTask TaskName="Certificate-AddPersonalType"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <KeyDatabaseFilePath ParameterType="System.String" />
      <KeyDatabasePassword ParameterType="System.String" />
      <CertificateLabel ParameterType="System.String" />
      <CertificateFilePath ParameterType="System.String" />
      <CertificatePassword ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Certificate-AddPersonalType() on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($KeyDatabaseFilePath,$KeyDatabasePassword,$CertificateLabel,$CertificateFilePath,$CertificatePassword)
    try
    {
        $errorMessage = runmqckm -cert -import -file $CertificateFilePath -pw $CertificatePassword -type pkcs12 -target $KeyDatabaseFilePath -target_pw $KeyDatabasePassword -target_type cms -label $CertificateLabel
        if ($LASTEXITCODE -ne 0) { throw "Could not add certificate '$CertificateLabelName'. Error code: $LASTEXITCODE. Error Message: $errorMessage" }
        $errorMessage = runmqckm -cert -setdefault -db $KeyDatabaseFilePath -pw $KeyDatabasePassword -label $CertificateLabel
        if ($LASTEXITCODE -ne 0) { throw "Could not set certificate '$CertificateLabelName' as default. Error code: $LASTEXITCODE. Error Message: $errorMessage" }
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $KeyDatabaseFilePath,$KeyDatabasePassword,$CertificateLabel,$CertificateFilePath,$CertificatePassword
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -eq $null
if (-not($Succeeded)) { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed Certificate-AddPersonalType. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="Certificate-AddSignerType"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <KeyDatabaseFilePath ParameterType="System.String" />
      <KeyDatabasePassword ParameterType="System.String" />
      <CertificateLabel ParameterType="System.String" />
      <CertificateFilePath ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Certificate-AddSignerType() on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($KeyDatabaseFilePath,$KeyDatabasePassword,$CertificateLabel,$CertificateFilePath)
    try
    {
        $errorMessage = runmqckm -cert -add -db $KeyDatabaseFilePath -pw $KeyDatabasePassword -label $CertificateLabel -file $CertificateFilePath
        if ($LASTEXITCODE -ne 0) { throw "Could not add certificate '$CertificateLabel'. Error code: $LASTEXITCODE. Error Message: $errorMessage" }
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $KeyDatabaseFilePath,$KeyDatabasePassword,$CertificateLabel,$CertificateFilePath
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -eq $null
if (-not($Succeeded)) { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed Certificate-AddSignerType. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="Certificate-Rename"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <KeyDatabaseFilePath ParameterType="System.String" />
      <KeyDatabasePassword ParameterType="System.String" />
      <CertificateLabel ParameterType="System.String" />
      <NewCertificateLabel ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Certificate-Rename() on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($KeyDatabaseFilePath,$KeyDatabasePassword,$CertificateLabel,$NewCertificateLabel)
    try
    {
        $errorMessage = runmqckm -cert -rename -db $KeyDatabaseFilePath -pw $KeyDatabasePassword -label $CertificateLabel -new_label $NewCertificateLabel
        if ($LASTEXITCODE -ne 0) { throw "Could not rename certificate '$CertificateLabel'. Error code: $LASTEXITCODE. Error Message: $errorMessage" }
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $KeyDatabaseFilePath,$KeyDatabasePassword,$CertificateLabel,$NewCertificateLabel
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -eq $null
if (-not($Succeeded)) { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed Certificate-Rename. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="Channel-DefineCLNTCONNType"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <ChannelName Required="true" ParameterType="System.String" />
      <MQSC_CONNAME ParameterType="System.String" />
      <MQSC_AFFINITY ParameterType="System.String" />
      <MQSC_CLNTWGHT ParameterType="System.String" />
      <MQSC_COMPHDR ParameterType="System.String" />
      <MQSC_COMPMSG ParameterType="System.String" />
      <MQSC_DEFRECON ParameterType="System.String" />
      <MQSC_DESCR ParameterType="System.String" />
      <MQSC_HBINT ParameterType="System.String" />
      <MQSC_KAINT ParameterType="System.String" />
      <MQSC_LOCLADDR ParameterType="System.String" />
      <MQSC_MAXMSGL ParameterType="System.String" />
      <MQSC_MODENAME ParameterType="System.String" />
      <MQSC_PASSWORD ParameterType="System.String" />
      <MQSC_QMNAME ParameterType="System.String" />
      <MQSC_RCVDATA ParameterType="System.String" />
      <MQSC_RCVEXIT ParameterType="System.String" />
      <MQSC_SCYDATA ParameterType="System.String" />
      <MQSC_SCYEXIT ParameterType="System.String" />
      <MQSC_SENDDATA ParameterType="System.String" />
      <MQSC_SENDEXIT ParameterType="System.String" />
      <MQSC_SHARECNV ParameterType="System.String" />
      <MQSC_SSLCIPH ParameterType="System.String" />
      <MQSC_SSLPEER ParameterType="System.String" />
      <MQSC_TPNAME ParameterType="System.String" />
      <MQSC_TRPTYPE ParameterType="System.String" />
      <MQSC_USERID ParameterType="System.String" />
      <MQSCOPT_REPLACE ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Channel-DefineCLNTCONNType(QueueManagerName:$QueueManagerName,ChannelName:$ChannelName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName,$ChannelName,$MQSC_CONNAME,$MQSC_AFFINITY,$MQSC_CLNTWGHT,$MQSC_COMPHDR,
$MQSC_COMPMSG,$MQSC_DEFRECON,$MQSC_DESCR,$MQSC_HBINT,$MQSC_KAINT,$MQSC_LOCLADDR,
$MQSC_MAXMSGL,$MQSC_MODENAME,$MQSC_PASSWORD,$MQSC_QMNAME,$MQSC_RCVDATA,$MQSC_RCVEXIT,
$MQSC_SCYDATA,$MQSC_SCYEXIT,$MQSC_SENDDATA,$MQSC_SENDEXIT,$MQSC_SHARECNV,$MQSC_SSLCIPH,
$MQSC_SSLPEER,$MQSC_TPNAME,$MQSC_TRPTYPE,$MQSC_USERID,$MQSCOPT_REPLACE)
    try
    {
        $mqscParameterVariables = Get-Variable -name "MQSC_*" -scope "SCRIPT"
        $mqscArguments = ""
        foreach ($mqscParameterVariable in $mqscParameterVariables)
        {
            if($mqscParameterVariable.Value)
            {
                $mqscArguments += " " + $mqscParameterVariable.Name.Replace("MQSC_", '') + "(" + $mqscParameterVariable.Value +")"
            }
        }

        $mqscOptionVariables = Get-Variable -name "MQSCOPT_*" -scope "SCRIPT"
        foreach ($mqscOptionVariable in $mqscOptionVariables)
        {
            if($mqscOptionVariable.Value)
            {
                $mqscArguments += " " + $mqscOptionVariable.Value
            }
        }

        $mqscCommand = "DEFINE CHANNEL($ChannelName) CHLTYPE(CLNTCONN) " + $mqscArguments
        $errorMessage = $mqscCommand | runmqsc.exe $QueueManagerName
        if ($LASTEXITCODE -ne 0) { throw "Could not define channel '$ChannelName' in queue manager '$QueueManagerName'. Error code: $LASTEXITCODE. Error Message: $errorMessage" }
    }
    catch { $_ }
    finally
    {
        Remove-Variable -name "MQSC_*" -scope "SCRIPT"
        Remove-Variable -name "MQSCOPT_*" -scope "SCRIPT"
    }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $QueueManagerName,$ChannelName,$MQSC_CONNAME,$MQSC_AFFINITY,$MQSC_CLNTWGHT,$MQSC_COMPHDR,
$MQSC_COMPMSG,$MQSC_DEFRECON,$MQSC_DESCR,$MQSC_HBINT,$MQSC_KAINT,$MQSC_LOCLADDR,
$MQSC_MAXMSGL,$MQSC_MODENAME,$MQSC_PASSWORD,$MQSC_QMNAME,$MQSC_RCVDATA,$MQSC_RCVEXIT,
$MQSC_SCYDATA,$MQSC_SCYEXIT,$MQSC_SENDDATA,$MQSC_SENDEXIT,$MQSC_SHARECNV,$MQSC_SSLCIPH,
$MQSC_SSLPEER,$MQSC_TPNAME,$MQSC_TRPTYPE,$MQSC_USERID,$MQSCOPT_REPLACE
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -eq $null
if (-not($Succeeded)) { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed Channel-DefineCLNTCONNType. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
