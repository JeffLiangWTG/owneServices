    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <QueueName Required="true" ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
      <IsExisting Output="true" ParameterType="System.Boolean" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Queue-IsExisting(QueueManagerName:$QueueManagerName,QueueName:$QueueName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName,$QueueName)
    try
    {
        $result = "DISPLAY QUEUE(*)" | runmqsc.exe $QueueManagerName
        if ($LASTEXITCODE -ne 0) { throw "Could not display queue manager '$QueueManagerName'. Error code: $LASTEXITCODE. Error Message: $result" }
        $match = $result | Out-String | Select-String -Pattern "QUEUE\($QueueName\)\s+TYPE\((?<Type>.+)\)" | ForEach-Object { $_.Matches }
        $match -ne $null
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $QueueManagerName,$QueueName
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -is [Boolean]
if ($Succeeded) { $IsExisting = $Result.ToString() }
else { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed Queue-IsExisting. $FailureMessage")
}
]]>
    </Task>
