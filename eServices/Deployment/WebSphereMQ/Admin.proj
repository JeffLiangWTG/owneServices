  <UsingTask TaskName="QueueManager-Create"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <MQSC_c ParameterType="System.String" />
      <MQSC_d ParameterType="System.String" />
      <MQSC_h ParameterType="System.String" />
      <MQSC_md ParameterType="System.String" />
      <MQSC_g ParameterType="System.String" />
      <MQSC_t ParameterType="System.String" />
      <MQSC_u ParameterType="System.String" />
      <MQSC_x ParameterType="System.String" />
      <MQSC_lp ParameterType="System.String" />
      <MQSC_ls ParameterType="System.String" />
      <MQSC_lf ParameterType="System.String" />
      <MQSC_ld ParameterType="System.String" />
      <MQSCOPT_z ParameterType="System.String" />
      <MQSCOPT_q ParameterType="System.String" />
      <MQSCOPT_ss ParameterType="System.String" />
      <MQSCOPT_sa ParameterType="System.String" />
      <MQSCOPT_sax ParameterType="System.String" />
      <MQSCOPT_si ParameterType="System.String" />
      <MQSCOPT_lc ParameterType="System.String" />
      <MQSCOPT_ll ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start QueueManager-Create(QueueManagerName:$QueueManagerName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName,$MQSC_c,$MQSC_d,$MQSC_h,$MQSC_md,$MQSC_g,
$MQSC_t,$MQSC_u,$MQSC_x,$MQSC_lp,$MQSC_ls,$MQSC_lf,
$MQSC_ld,$MQSCOPT_z,$MQSCOPT_q,$MQSCOPT_ss,$MQSCOPT_sa,$MQSCOPT_sax,
$MQSCOPT_si,$MQSCOPT_lc,$MQSCOPT_ll)
    try
    {
        $mqscParameterVariables = Get-Variable -name "MQSC_*" -scope "SCRIPT"
        $mqscArguments = ""
        foreach ($mqscParameterVariable in $mqscParameterVariables)
        {
            if($mqscParameterVariable.Value)
            {
                $mqscArguments += " -" + $mqscParameterVariable.Name.Replace("MQSC_", '') + " " + $mqscParameterVariable.Value
            }
        }

        $mqscOptionVariables = Get-Variable -name "MQSCOPT_*" -scope "SCRIPT"
        foreach ($mqscOptionVariable in $mqscOptionVariables)
        {
            if($mqscOptionVariable.Value)
            {
                $mqscArguments += " -" + $mqscOptionVariable.Value
            }
        }

        $mqscArguments += " $QueueManagerName"
        $mqscCommand = "crtmqm.exe $mqscArguments"

        Invoke-Expression $mqscCommand

        if ($LASTEXITCODE -ne 0)
        {
            $errorMessage = if ($Error[0]) { $Error[0] | Out-String } else {""}
            throw "Could not create queue manager '$QueueManagerName'. Error code: $LASTEXITCODE. Error Message: $errorMessage"
        }
    }
    catch { $_ }
    finally
    {
        Remove-Variable -name "MQSC_*" -scope "SCRIPT"
        Remove-Variable -name "MQSCOPT_*" -scope "SCRIPT"
    }
}

$serverCredSSPConfiguration = Invoke-Command -Session $session -ScriptBlock { Get-WSManCredSSP } | Out-String
$wasServerCredSSPEnabled = -not($serverCredSSPConfiguration.Contains("This computer is not configured to receive credentials from a remote client computer."));

$clientCredSSPConfiguration = Get-WSManCredSSP | Out-String
$wasCredSSPClientEnabled = -not($clientCredSSPConfiguration.Contains("The machine is not configured to allow delegating fresh credentials."));

try
{
    if (-not($wasCredSSPClientEnabled)) { Enable-WSManCredSSP -Role Client -DelegateComputer $ComputerName -Force }
    if (-not($wasServerCredSSPEnabled)) { Invoke-Command -Session $session -ScriptBlock { Enable-WSManCredSSP -Role Server –Force } }
}
finally
{
    remove-pssession -session $session
}

$credSSPSession = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword -CredSSP).Session

try
{
	$Result = Invoke-Command -Session $credSSPSession -ScriptBlock $ScriptBlock -ArgumentList $QueueManagerName,$MQSC_c,$MQSC_d,$MQSC_h,$MQSC_md,$MQSC_g,
			$MQSC_t,$MQSC_u,$MQSC_x,$MQSC_lp,$MQSC_ls,$MQSC_lf,
			$MQSC_ld,$MQSCOPT_z,$MQSCOPT_q,$MQSCOPT_ss,$MQSCOPT_sa,$MQSCOPT_sax,
			$MQSCOPT_si,$MQSCOPT_lc,$MQSCOPT_ll
}
finally
{
    if (-not($wasServerCredSSPEnabled)) { Invoke-Command -Session $credSSPSession -ScriptBlock { Disable-WSManCredSSP -Role Server } }
    if (-not($wasCredSSPClientEnabled)) { Disable-WSManCredSSP -Role Client }
    remove-pssession -session $credSSPSession
}

$Succeeded = -not(($Result | Out-String).StartsWith("Could not create queue manager"));
if (-not($Succeeded)) { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed QueueManager-Create. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
