        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueName._QueueManagerName)"
        QueueName="%(_QueueName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </Queue-DeleteRemote>
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queue-isExisting">
    <Queue-IsExisting
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueName._QueueManagerName)"
        QueueName="%(_QueueName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
      <Output TaskParameter="IsExisting" PropertyName="_IsExisting"/>
      <!-- IsExisting will overlaps with QueueManager._IsExisting -->
    </Queue-IsExisting>
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-alter">
    <QueueManager-Alter
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)"
        MQSC_ACCTINT="%(_QueueManagerName._MQSC_ACCTINT)"
        MQSC_ACCTCONO="%(_QueueManagerName._MQSC_ACCTCONO)"
        MQSC_ACCTMQI="%(_QueueManagerName._MQSC_ACCTMQI)"
        MQSC_ACCTQ="%(_QueueManagerName._MQSC_ACCTQ)"
        MQSC_ACTIVREC="%(_QueueManagerName._MQSC_ACTIVREC)"
        MQSC_ACTVCONO="%(_QueueManagerName._MQSC_ACTVCONO)"
        MQSC_ACTVTRC="%(_QueueManagerName._MQSC_ACTVTRC)"
        MQSC_AUTHOREV="%(_QueueManagerName._MQSC_AUTHOREV)"
        MQSC_CCSID="%(_QueueManagerName._MQSC_CCSID)"
        MQSC_CERTVPOL="%(_QueueManagerName._MQSC_CERTVPOL)"
        MQSC_CHAD="%(_QueueManagerName._MQSC_CHAD)"
        MQSC_CHADEV="%(_QueueManagerName._MQSC_CHADEV)"
        MQSC_CHADEXIT="%(_QueueManagerName._MQSC_CHADEXIT)"
        MQSC_CHLAUTH="%(_QueueManagerName._MQSC_CHLAUTH)"
        MQSC_CHLEV="%(_QueueManagerName._MQSC_CHLEV)"
        MQSC_CLWLDATA="%(_QueueManagerName._MQSC_CLWLDATA)"
        MQSC_CLWLEXIT="%(_QueueManagerName._MQSC_CLWLEXIT)"
        MQSC_CLWLLEN="%(_QueueManagerName._MQSC_CLWLLEN)"
        MQSC_CLWLMRUC="%(_QueueManagerName._MQSC_CLWLMRUC)"
        MQSC_CLWLUSEQ="%(_QueueManagerName._MQSC_CLWLUSEQ)"
        MQSC_CMDEV="%(_QueueManagerName._MQSC_CMDEV)"
        MQSC_CONFIGEV="%(_QueueManagerName._MQSC_CONFIGEV)"
        MQSC_CUSTOM="%(_QueueManagerName._MQSC_CUSTOM)"
        MQSC_DEADQ="%(_QueueManagerName._MQSC_DEADQ)"
        MQSC_DEFCLXQ="%(_QueueManagerName._MQSC_DEFCLXQ)"
        MQSC_DEFXMITQ="%(_QueueManagerName._MQSC_DEFXMITQ)"
        MQSC_DESCR="%(_QueueManagerName._MQSC_DESCR)"
        MQSC_INHIBTEV="%(_QueueManagerName._MQSC_INHIBTEV)"
        MQSC_IPADDRV="%(_QueueManagerName._MQSC_IPADDRV)"
        MQSC_LOCALEV="%(_QueueManagerName._MQSC_LOCALEV)"
        MQSC_LOGGEREV="%(_QueueManagerName._MQSC_LOGGEREV)"
        MQSC_MARKINT="%(_QueueManagerName._MQSC_MARKINT)"
        MQSC_MAXHANDS="%(_QueueManagerName._MQSC_MAXHANDS)"
        MQSC_MAXMSGL="%(_QueueManagerName._MQSC_MAXMSGL)"
        MQSC_MAXUMSGS="%(_QueueManagerName._MQSC_MAXUMSGS)"
        MQSC_MAXPROPL="%(_QueueManagerName._MQSC_MAXPROPL)"
        MQSC_MONACLS="%(_QueueManagerName._MQSC_MONACLS)"
        MQSC_MONCHL="%(_QueueManagerName._MQSC_MONCHL)"
        MQSC_MONQ="%(_QueueManagerName._MQSC_MONQ)"
        MQSC_PARENT="%(_QueueManagerName._MQSC_PARENT)"
        MQSC_PERFMEV="%(_QueueManagerName._MQSC_PERFMEV)"
        MQSC_PSCLUS="%(_QueueManagerName._MQSC_PSCLUS)"
        MQSC_PSMODE="%(_QueueManagerName._MQSC_PSMODE)"
        MQSC_PSNPRES="%(_QueueManagerName._MQSC_PSNPRES)"
        MQSC_PSNPMSG="%(_QueueManagerName._MQSC_PSNPMSG)"
        MQSC_PSRTYCNT="%(_QueueManagerName._MQSC_PSRTYCNT)"
        MQSC_PSSYNCPT="%(_QueueManagerName._MQSC_PSSYNCPT)"
        MQSC_REMOTEEV="%(_QueueManagerName._MQSC_REMOTEEV)"
        MQSC_REPOS="%(_QueueManagerName._MQSC_REPOS)"
        MQSC_REPOSNL="%(_QueueManagerName._MQSC_REPOSNL)"
        MQSC_ROUTEREC="%(_QueueManagerName._MQSC_ROUTEREC)"
        MQSC_SCHINIT="%(_QueueManagerName._MQSC_SCHINIT)"
        MQSC_SCMDSERV="%(_QueueManagerName._MQSC_SCMDSERV)"
        MQSC_SSLCRLNL="%(_QueueManagerName._MQSC_SSLCRLNL)"
        MQSC_SSLCRYP="%(_QueueManagerName._MQSC_SSLCRYP)"
        MQSC_SSLFIPS="%(_QueueManagerName._MQSC_SSLFIPS)"
        MQSC_SSLKEYR="%(_QueueManagerName._MQSC_SSLKEYR)"
        MQSC_SSLRKEYC="%(_QueueManagerName._MQSC_SSLRKEYC)"
        MQSC_SSLEV="%(_QueueManagerName._MQSC_SSLEV)"
        MQSC_STATACLS="%(_QueueManagerName._MQSC_STATACLS)"
        MQSC_STATCHL="%(_QueueManagerName._MQSC_STATCHL)"
        MQSC_STATINT="%(_QueueManagerName._MQSC_STATINT)"
        MQSC_STATMQI="%(_QueueManagerName._MQSC_STATMQI)"
        MQSC_STATQ="%(_QueueManagerName._MQSC_STATQ)"
        MQSC_STRSTPEV="%(_QueueManagerName._MQSC_STRSTPEV)"
        MQSC_SUITEB="%(_QueueManagerName._MQSC_SUITEB)"
        MQSC_TREELIFE="%(_QueueManagerName._MQSC_TREELIFE)"
        MQSC_TRIGINT="%(_QueueManagerName._MQSC_TRIGINT)"
        MQSCOPT_FORCE="%(_QueueManagerName._MQSCOPT_FORCE)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </QueueManager-Alter>
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-create" DependsOnTargets="bat:mq-queueManager-isExisting">
    <QueueManager-Create
        Condition="!$(_IsExisting)"
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)"
        MQSC_c="%(_QueueManagerName._MQSC_c)"
        MQSC_d="%(_QueueManagerName._MQSC_d)"
        MQSC_h="%(_QueueManagerName._MQSC_h)"
        MQSC_md="%(_QueueManagerName._MQSC_md)"
        MQSC_g="%(_QueueManagerName._MQSC_g)"
        MQSC_t="%(_QueueManagerName._MQSC_t)"
        MQSC_u="%(_QueueManagerName._MQSC_u)"
        MQSC_x="%(_QueueManagerName._MQSC_x)"
        MQSC_lp="%(_QueueManagerName._MQSC_lp)"
        MQSC_ls="%(_QueueManagerName._MQSC_ls)"
        MQSC_lf="%(_QueueManagerName._MQSC_lf)"
        MQSC_ld="%(_QueueManagerName._MQSC_ld)"
        MQSCOPT_z="%(_QueueManagerName._MQSCOPT_z)"
        MQSCOPT_q="%(_QueueManagerName._MQSCOPT_q)"
        MQSCOPT_ss="%(_QueueManagerName._MQSCOPT_ss)"
        MQSCOPT_sa="%(_QueueManagerName._MQSCOPT_sa)"
        MQSCOPT_sax="%(_QueueManagerName._MQSCOPT_sax)"
        MQSCOPT_si="%(_QueueManagerName._MQSCOPT_si)"
        MQSCOPT_lc="%(_QueueManagerName._MQSCOPT_lc)"
        MQSCOPT_ll="%(_QueueManagerName._MQSCOPT_ll)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </QueueManager-Create>
    <Message Condition="$(_IsExisting)" Importance="normal" Text="%(_QueueManagerName.Identity) exists, skip creating" />
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-delete" DependsOnTargets="bat:mq-queueManager-end">
    <QueueManager-Delete
        Condition="$(_IsExisting)"
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </QueueManager-Delete>
    <Message Condition="!$(_IsExisting)" Importance="normal" Text="%(_QueueManagerName.Identity) is not exists, skip deleting" />
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-end" DependsOnTargets="bat:mq-queueManager-isRunning">
    <QueueManager-End
        Condition="$(_IsRunning)"
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </QueueManager-End>
    <Message Condition="!$(_IsRunning)" Importance="normal" Text="%(_QueueManagerName.Identity) is not exists or stopped, skip ending" />
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-isExisting" DependsOnTargets="bat:mq-preCheck">
    <QueueManager-IsExisting
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
      <Output TaskParameter="IsExisting" PropertyName="_IsExisting"/>
    </QueueManager-IsExisting>
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-isRunning" DependsOnTargets="bat:mq-queueManager-isExisting">
    <QueueManager-IsRunning
        Condition="$(_IsExisting)"
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
      <Output TaskParameter="IsRunning" PropertyName="_IsRunning"/>
    </QueueManager-IsRunning>
    <Message Condition="!$(_IsExisting)" Importance="normal" Text="%(_QueueManagerName.Identity) is not exist, skip checking" />
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-queueManager-start" DependsOnTargets="bat:mq-queueManager-isRunning">
    <QueueManager-Start
        Condition="!$(_IsRunning)"
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)"
        QueueManagerName="%(_QueueManagerName.Identity)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </QueueManager-Start>
    <Message Condition="$(_IsRunning)" Importance="normal" Text="%(_QueueManagerName.Identity) is running, skip starting" />
    <Error Condition="!$(_Succeeded)" Text="$(_FailureMessage)" />
  </Target>
  <Target Name="bat:mq-preCheck">
    <PreCheck
        ComputerName="$(_ComputerName)"
        UserName="$(_UserName)"
        UserPassword="$(_Password)">
      <Output TaskParameter="Succeeded" PropertyName="_Succeeded"/>
      <Output TaskParameter="FailureMessage" PropertyName="_FailureMessage"/>
    </PreCheck>
    <PropertyGroup>
      <_IsRunning>false</_IsRunning>
      <_IsExisting>false</_IsExisting>
    </PropertyGroup>
  </Target>

