    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
      <IsExisting Output="true" ParameterType="System.Boolean" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start QueueManager-IsExisting(QueueManagerName:$QueueManagerName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName)
    try
    {
        $match = dspmq.exe | Out-String | Select-String -Pattern "QMNAME\($QueueManagerName\)\s+STATUS\((?<Status>.+)\)" | ForEach-Object { $_.Matches }
        if ($LASTEXITCODE -ne 0)
        {
            $errorMessage = if ($Error[0]) { $Error[0] | Out-String } else {""}
            throw "Could not display queue manager '$QueueManagerName'. Error code: $LASTEXITCODE. Error Message: $errorMessage"
        }

        $match -ne $null
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $QueueManagerName
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -is [Boolean]
if ($Succeeded) { $IsExisting = $Result.ToString() }
else { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed QueueManager-IsExisting. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="QueueManager-IsRunning"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
      <IsRunning Output="true" ParameterType="System.Boolean" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start QueueManager-IsRunning(QueueManagerName:$QueueManagerName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName)
    try
    {
        $match = dspmq.exe | Out-String | Select-String -Pattern "QMName\($QueueManagerName\)\s+STATUS\((?<Status>.+)\)" | ForEach-Object { $_.Matches }
        if ($LASTEXITCODE -ne 0)
        {
            $errorMessage = if ($Error[0]) { $Error[0] | Out-String } else {""}
            throw "Could not display queue manager. Error code: $LASTEXITCODE. Error Message: $errorMessage"
        }

        if ($match)
        {
            $match.Groups["Status"].Value -eq 'Running'
        }
        else { throw "Could not find queue manager '$QueueManagerName'."}
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $QueueManagerName
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -is [Boolean]
if ($Succeeded) { $IsRunning = $Result.ToString() }
else { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed QueueManager-IsRunning. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="QueueManager-Start"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start QueueManager-Start(QueueManagerName:$QueueManagerName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName)
    try
    {
        strmqm.exe $QueueManagerName
        if ($LASTEXITCODE -ne 0)
        {
            $errorMessage = if ($Error[0]) { $Error[0] | Out-String } else {""}
            throw "Could not start queue manager '$QueueManagerName'. Error code: $LASTEXITCODE. Error Message: $errorMessage"
        }
    }
    catch { $_ }
}

Try
{
	$Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock -ArgumentList $QueueManagerName
}
Finally
{
	remove-pssession -session $session
}

$Succeeded = $Result -eq $null
if (-not($Succeeded)) { $FailureMessage = ($Result | Out-String).ToString() }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed QueueManager-Start. $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="PreCheck"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <Succeeded Output="true" ParameterType="System.Boolean" />
      <FailureMessage Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start PreCheck on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
  Get-Item Env:MQ_FILE_PATH
}

Try
{
  $Result = Invoke-Command -Session $session -ScriptBlock $ScriptBlock
  
  if ($null -ne $error[0])
  {
    Throw $error[0]
  }
}
Finally
{
  remove-pssession -session $session
}

$Succeeded = $null -ne $Result
if (-not($Succeeded)) { $FailureMessage = "Environment variable MQ_FILE_PATH not found" }

if ($FailureMessage)
{
	$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "Failed PreCheck, $FailureMessage")
}
]]>
    </Task>
  </UsingTask>
  <UsingTask TaskName="ImportMQConfig"
      TaskFactory = "PowershellTaskFactory"
      AssemblyFile = "$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll" >
    <ParameterGroup>
      <ComputerName ParameterType="System.String" />
      <UserName ParameterType="System.String" />
      <UserPassword ParameterType="System.String" />
      <QueueManagerName Required="true" ParameterType="System.String" />
      <ConfigFilePath ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start importing MQ config on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$createFolderBlock = {
  New-TemporaryFile

  if ($null -ne $error[0])
  {
    Throw $error[0]
  }
}

$importBlock = {
  param($ConfigFile, $QueueManager)

  $command = "runmqsc $QueueManager < $ConfigFile"
  cmd /c $command

  if ($null -ne $error[0])
  {
    Throw $error[0]
  }
}

Try
{
  $remoteTempFile = Invoke-Command -Session $session -ScriptBlock $createFolderBlock
  $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Created temp file [$remoteTempFile] on Computer($ComputerName)")

  Copy-Item $ConfigFilePath -ToSession $session -Destination $remoteTempFile
  $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Copied config file [$ConfigFilePath] to Computer($ComputerName):$remoteTempFile")
}
Finally
{
  Remove-PSSession -Session $session
}

$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session
Try
{
  $Result = Invoke-Command -Session $session -ScriptBlock $importBlock -ArgumentList $remoteTempFile,$QueueManagerName

  if ($null -eq $Result) 
  {
    Throw "Unexpected empty output";
  }

  $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Finished importing MQ config on Computer($ComputerName)")
  foreach ($line in $Result)
  {
    $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", $line)
  }

  if (-not($Result[$Result.Count - 2].Contains("No commands have a syntax error")))
  {
    Throw "Configure file contains syntax error";
  }
}
Finally
{
  Remove-PSSession -Session $session
}

if ($null -ne $error[0])
{
  Throw $error[0]
}
]]>
    </Task>
  </UsingTask>
  <Target Name="bat:mq-certificate-addPersonalType">
