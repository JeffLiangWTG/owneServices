    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start Channel-DefineCLUSSDRType(QueueManagerName:$QueueManagerName,ChannelName:$ChannelName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName,$ChannelName,$MQSC_CONNAME,$MQSC_BATCHHB,$MQSC_BATCHINT,$MQSC_BATCHLIM,
$MQSC_BATCHSZ,$MQSC_CLUSNL,$MQSC_CLUSTER,$MQSC_CLWLPRTY,$MQSC_CLWLRANK,$MQSC_CLWLWGHT,
$MQSC_COMPHDR,$MQSC_COMPMSG,$MQSC_CONVERT,$MQSC_DESCR,$MQSC_DISCINT,$MQSC_HBINT,
$MQSC_KAINT,$MQSC_LOCLADDR,$MQSC_LONGRTY,$MQSC_LONGTMR,$MQSC_MAXMSGL,$MQSC_MCANAME,
$MQSC_MCATYPE,$MQSC_MCAUSER,$MQSC_MODENAME,$MQSC_MONCHL,$MQSC_MSGDATA,$MQSC_MSGEXIT,
$MQSC_NPMSPEED,$MQSC_PASSWORD,$MQSC_PROPCTL,$MQSC_RCVDATA,$MQSC_RCVEXIT,$MQSC_SCYDATA,
$MQSC_SCYEXIT,$MQSC_SENDDATA,$MQSC_SENDEXIT,$MQSC_SEQWRAP,$MQSC_SHORTRTY,$MQSC_SHORTTMR,
$MQSC_SSLCIPH,$MQSC_SSLPEER,$MQSC_STATCHL,$MQSC_TPNAME,$MQSC_TRPTYPE,$MQSC_USEDLQ,
$MQSC_USERID,$MQSCOPT_REPLACE)
    try
    {
        $mqscParameterVariables = Get-Variable -name "MQSC_*" -scope "SCRIPT"
        $mqscArguments = ""
