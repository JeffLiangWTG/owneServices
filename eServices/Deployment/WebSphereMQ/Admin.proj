    <Task>
      <![CDATA[
$log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "Start QueueManager-Alter(QueueManagerName:$QueueManagerName) on Computer($ComputerName)")

. $(CommonPowershellFunctionsFilePath)
$session = (Connect -MachineName $ComputerName -UserName $UserName -UserPassword $UserPassword).Session

$ScriptBlock = {
	param($QueueManagerName,$MQSC_ACCTINT,$MQSC_ACCTCONO,$MQSC_ACCTMQI,$MQSC_ACCTQ,$MQSC_ACTIVREC,
$MQSC_ACTVCONO,$MQSC_ACTVTRC,$MQSC_AUTHOREV,$MQSC_CCSID,$MQSC_CERTVPOL,$MQSC_CHAD,
$MQSC_CHADEV,$MQSC_CHADEXIT,$MQSC_CHLAUTH,$MQSC_CHLEV,$MQSC_CLWLDATA,$MQSC_CLWLEXIT,
$MQSC_CLWLLEN,$MQSC_CLWLMRUC,$MQSC_CLWLUSEQ,$MQSC_CMDEV,$MQSC_CONFIGEV,$MQSC_CUSTOM,
$MQSC_DEADQ,$MQSC_DEFCLXQ,$MQSC_DEFXMITQ,$MQSC_DESCR,$MQSC_INHIBTEV,$MQSC_IPADDRV,
$MQSC_LOCALEV,$MQSC_LOGGEREV,$MQSC_MARKINT,$MQSC_MAXHANDS,$MQSC_MAXMSGL,$MQSC_MAXUMSGS,
$MQSC_MAXPROPL,$MQSC_MONACLS,$MQSC_MONCHL,$MQSC_MONQ,$MQSC_PARENT,$MQSC_PERFMEV,
$MQSC_PSCLUS,$MQSC_PSMODE,$MQSC_PSNPRES,$MQSC_PSNPMSG,$MQSC_PSRTYCNT,$MQSC_PSSYNCPT,
$MQSC_REMOTEEV,$MQSC_REPOS,$MQSC_REPOSNL,$MQSC_ROUTEREC,$MQSC_SCHINIT,$MQSC_SCMDSERV,
$MQSC_SSLCRLNL,$MQSC_SSLCRYP,$MQSC_SSLFIPS,$MQSC_SSLKEYR,$MQSC_SSLRKEYC,$MQSC_SSLEV,
$MQSC_STATACLS,$MQSC_STATCHL,$MQSC_STATINT,$MQSC_STATMQI,$MQSC_STATQ,$MQSC_STRSTPEV,
$MQSC_SUITEB,$MQSC_TREELIFE,$MQSC_TRIGINT,$MQSCOPT_FORCE)
    try
    {
        $mqscParameterVariables = Get-Variable -name "MQSC_*" -scope "SCRIPT"
        $mqscArguments = ""
        foreach ($mqscParameterVariable in $mqscParameterVariables)
        {
            if($mqscParameterVariable.Value)
            {
                $mqscArguments += " " + $mqscParameterVariable.Name.Replace("MQSC_", '') + "(" + $mqscParameterVariable.Value +")"
            }
        }

        $mqscOptionVariables = Get-Variable -name "MQSCOPT_*" -scope "SCRIPT"
        foreach ($mqscOptionVariable in $mqscOptionVariables)
        {
            if($mqscOptionVariable.Value)
            {
                $mqscArguments += " " + $mqscOptionVariable.Value
            }
        }

        $mqscCommand = "ALTER QMGR " + $mqscArguments
        $errorMessage = $mqscCommand | runmqsc.exe $QueueManagerName
        if ($LASTEXITCODE -ne 0) { throw "Could not alter queue manager '$QueueManagerName'. Error code: $LASTEXITCODE. Error Message: $errorMessage" }
    }
    catch { $_ }
    finally
    {
        Remove-Variable -name "MQSC_*" -scope "SCRIPT"
