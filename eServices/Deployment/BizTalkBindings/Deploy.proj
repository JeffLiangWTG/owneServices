<?xml version="1.0" encoding="utf-8"?>

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <DeploymentRootPath>$(MSBuildThisFileDirectory)..\</DeploymentRootPath>
    <CommonScriptsPath>$(DeploymentRootPath)Common\</CommonScriptsPath>
    <DeployTasks>$(CommonScriptsPath)Deploy.tasks</DeployTasks>
    <MSBuildCommonTasks>$(CommonScriptsPath)MSBuildCommon.tasks</MSBuildCommonTasks>

    <MSBuildCommonTasks Condition="!Exists('$(MSBuildCommonTasks)')">$(MSBuildThisFileDirectory)MSBuildCommon.tasks</MSBuildCommonTasks>
  </PropertyGroup>

  <Import Project="$(MSBuildCommonTasks)" Condition="'$(MSBuildCommonTasksImported)'==''" />
  <Import Project="$(DeployTasks)" Condition="'$(DeployTasksImported)'==''" />

</Project>