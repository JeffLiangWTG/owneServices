<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <XtDeploymentTasksImported>True</XtDeploymentTasksImported>
    <XtDeploymentTasksDllPath Condition="'$(XtApiTasksDllPath)' == ''">$(MSBuildThisFileDirectory)\XT.REST.Deployment.Tasks.dll</XtDeploymentTasksDllPath>
  </PropertyGroup>

  <UsingTask TaskName="Deploy" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="Remove" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="LoadProfiles" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="Build" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="FileExtractor" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="ListHostedApplications" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="PrepareDeployment" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="Sign" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="DockerFileCopyTask" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="DeactivateHostedApplicationsTask" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="DeployOnContainer" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="WaitForHostedAppToStopTask" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
  <UsingTask TaskName="AddRepository" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
</Project>