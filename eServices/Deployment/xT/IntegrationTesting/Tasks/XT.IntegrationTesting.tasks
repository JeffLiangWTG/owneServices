<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<XtDeploymentTasksImported>True</XtDeploymentTasksImported>
		<XtDeploymentTasksDllPath Condition="'$(XtApiTasksDllPath)' == ''">$(MSBuildThisFileDirectory)\XT.IntegrationTesting.Tasks.dll</XtDeploymentTasksDllPath>
	</PropertyGroup>

	<UsingTask TaskName="LoadProfiles" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
	<UsingTask TaskName="Build" AssemblyFile="$(XtDeploymentTasksDllPath)"/>
</Project>