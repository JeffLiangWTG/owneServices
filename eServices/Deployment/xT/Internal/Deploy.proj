<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="bat:deploy">
		<Exec Command="&quot;$(MSBuildBinPath)\amd64\msbuild.exe&quot; ^
			&quot;$(MSBuildThisFileDirectory)\Deploy64.proj&quot; ^
			/t:bat:deploy ^
			/p:Profile=$(Profile) ^
			/p:UserName=$(UserName) ^
			/p:Password=$(Password)"/>
	</Target>

</Project>