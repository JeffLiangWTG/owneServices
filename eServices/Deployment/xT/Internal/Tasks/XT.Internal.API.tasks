<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<PropertyGroup>
		<_XtApiTasksImported>True</_XtApiTasksImported>
		<XtApiTasksDllPath Condition="'$(XtApiTasksDllPath)' == ''">$(MSBuildThisFileDirectory)\XT.Internal.API.Tasks.dll</XtApiTasksDllPath>
	</PropertyGroup>
	
	<UsingTask TaskName="StopService" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="StartService" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="CreateSnapshot" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="RestoreSnapshot" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="DeleteSnapshot" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="ResolveAssemblies" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="CreateXtProxy" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="ImportConfiguration" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="PreAnalysis" AssemblyFile="$(XtApiTasksDllPath)"/>
	<UsingTask TaskName="PostDeploymentCheck" AssemblyFile="$(XtApiTasksDllPath)"/>
	
</Project>