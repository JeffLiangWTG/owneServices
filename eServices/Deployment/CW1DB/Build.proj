<?xml version="1.0" encoding="utf-8"?>

<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CW1DBBuildProjImported>True</CW1DBBuildProjImported>
    <MSBuildCommonTasks>$(MSBuildThisFileDirectory)..\Common\MSBuildCommon.tasks</MSBuildCommonTasks>
    <PackageCommonTasks>$(MSBuildThisFileDirectory)..\package-common.tasks</PackageCommonTasks>
    <DeploymentProjectPath Condition="'$(DeploymentProjectPath)'==''">$(MSBuildThisFileDirectory)\Deploy.proj</DeploymentProjectPath>

    <SqlHelpersProject>$(MSBuildThisFileDirectory)..\Helpers\SqlCmdHelpers.proj</SqlHelpersProject>
    <SqlHelpersProject Condition="!Exists('$(SqlHelpersProject)')">$(MSBuildThisFileDirectory)\SqlCmdHelpers.proj</SqlHelpersProject>
    <CW1LatestBuildUrl><![CDATA[http://datartifactrepository.wtg.zone/latestBuild?branch=$/Dev&configuration=DEBUG&queuedDblCutoff=]]></CW1LatestBuildUrl>
    <CW1LatestBuildArchivePath>\\cw1datfiles.wtg.zone\IBPLatestBuildArchive</CW1LatestBuildArchivePath>
    <ALPFolderPattern>ALP_*</ALPFolderPattern>
    <CW1DBDeployProj>$(MSBuildThisFileDirectory)Deploy.proj</CW1DBDeployProj>
    <LocalBackupFilePath>$(MSBuildThisFileDirectory)alp.bak</LocalBackupFilePath>
  </PropertyGroup>

  <Import Project="$(MSBuildCommonTasks)" Condition="'$(MSBuildCommonTasksImported)'==''"/>
  <Import Project="$(PackageCommonTasks)" Condition="'$(PackageCommonTasksImported)'==''"/>
  <Import Project="$(SqlHelpersProject)" Condition="'$(SqlCmdHelpersImported)'==''"/>
  <Import Project="$(CW1DBDeployProj)" Condition="'$(CW1DBDeployProjImported)'==''"/>

  <!-- init environmental variables -->
  <PropertyGroup>
    <OutputDirectory>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutputPath)'))</OutputDirectory>
    <OutputDirectory>$([System.IO.Path]::GetFullPath('$(OutputDirectory)'))</OutputDirectory>
    <BackupFilePath>$([System.IO.Path]::Combine('$(OutputDirectory)', '$(BackupFileName)'))</BackupFilePath>

    <CW1LatestBuildPath Condition="'$(CW1LatestBuildPath)'==''">$(PROGRAMDATA)\WiseTech Global\CW1\LatestBuild</CW1LatestBuildPath>
    <CW1BinariesDir>$(CW1LatestBuildPath)\Binaries</CW1BinariesDir>
    <CargoWiseOneAnyCpuExePath>$(CW1BinariesDir)\CargoWiseOneAnyCpu.exe</CargoWiseOneAnyCpuExePath>
    <CW1ExeFileInfoPath>$(CW1LatestBuildPath)\CW1ExeFileInfo.txt</CW1ExeFileInfoPath>
    <LockFilePath>$(CW1LatestBuildPath)\download.lock</LockFilePath>

    <WaitMinutesBeforeNextDownload>120</WaitMinutesBeforeNextDownload>
  </PropertyGroup>

  <!-- generate a back up file ready for deploy -->
  <Target Name="AfterBuild" DependsOnTargets="bat:cw1:db_build" />
  <!-- clean up artifacts -->
  <Target Name="AfterClean" DependsOnTargets="bat:clean" />

  <!-- clean up our artifacts from output path -->
  <Target Name="bat:clean">
    <Delete Files="$(BackupFilePath)" Condition="Exists('$(BackupFilePath)')" />
  </Target>

  <Target Name="bat:cw1:acquire_download_lock">
    <ReadLinesFromFile File="$(LockFilePath)" Condition="Exists('$(LockFilePath)')">
      <Output TaskParameter="Lines" PropertyName="RunningPid" />
    </ReadLinesFromFile>
    <IsProcessRunning Id="$(RunningPid)" Condition="'$(RunningPid)'!=''">
      <Output PropertyName="IsRunning" TaskParameter="IsRunning" />
      <Output PropertyName="ProcessName" TaskParameter="ProcessName" />
    </IsProcessRunning>
    <Error Text="Another process $(ProcessName) is downloading latest CW1 build" Condition="'$(IsRunning)'=='True'" />

    <GetCurrentProcessId>
      <Output PropertyName="Id" TaskParameter="Id" />
    </GetCurrentProcessId>
    <WriteLinesToFile
      File="$(LockFilePath)"
      Lines="$(Id)"
      Overwrite="true"
      Encoding="utf-8" />
  </Target>

  <Target Name="bat:cw1:lastDownload_is_expired" Returns="$(DownloadIsExpired)">
    <PropertyGroup>
      <DownloadIsExpired>True</DownloadIsExpired>
    </PropertyGroup>

    <!-- check if a grace window is expired to avoid excessive download -->
    <LastWriteTimeUtc FilePath="$(CW1ExeFileInfoPath)" Condition="Exists('$(CW1ExeFileInfoPath)') and Exists('$(CargoWiseOneAnyCpuExePath)')">
      <Output TaskParameter="LastWriteTimeUtcString" PropertyName="LastWriteTimeUtcString" />
    </LastWriteTimeUtc>
    <Message Text="$(CW1ExeFileInfoPath) LastWriteTimeUtcString: $(LastWriteTimeUtcString)" Condition="'$(LastWriteTimeUtcString)'!=''" />

    <IsWaitTimeExpired
      WaitMinutesString="$(WaitMinutesBeforeNextDownload)"
      SinceTimeUtcString="$(LastWriteTimeUtcString)"
      Condition="Exists('$(CargoWiseOneAnyCpuExePath)') and '$(LastWriteTimeUtcString)'!=''">
      <Output TaskParameter="IsExpired" PropertyName="DownloadIsExpired" />
      <Output TaskParameter="TimeNowUtc" PropertyName="TimeNowUtc" />
    </IsWaitTimeExpired>
    <Message Text="Last download is expired: $(DownloadIsExpired), LastWriteTimeUtc: $(LastWriteTimeUtcString), TimeNowUtc: $(TimeNowUtc)" />
  </Target>

  <!-- check if time elapsed is longer than the defined $(WaitMinutesBeforeNextDownload) -->
  <Target Name="bat:cw1:get_latest_build_if_needed" Returns="$(DownloadLatestBuildWasSuccessful)">
    <MakeDir Directories="$(CW1LatestBuildPath)" Condition="!Exists('$(CW1LatestBuildPath)')" />
    <CallTarget Targets="bat:cw1:acquire_download_lock" />

    <CallTarget Targets="bat:cw1:lastDownload_is_expired">
      <Output TaskParameter="TargetOutputs" PropertyName="DownloadIsExpired" />
    </CallTarget>
    <CallTarget Targets="bat:cw1:download_latestBuild" Condition="'$(DownloadIsExpired)'=='True'">
      <Output TaskParameter="TargetOutputs" PropertyName="DownloadWasSuccessful" />
    </CallTarget>
    <PropertyGroup>
      <DownloadLatestBuildWasSuccessful Condition="Exists('$(CargoWiseOneAnyCpuExePath)')">True</DownloadLatestBuildWasSuccessful>
    </PropertyGroup>

    <GetFileInfo AssemblyFilePath="$(CargoWiseOneAnyCpuExePath)" Condition="Exists('$(CargoWiseOneAnyCpuExePath)')">
      <Output TaskParameter="FileVersion" PropertyName="CargoWiseOneAnyCpuExeFileVersion" />
    </GetFileInfo>
    <Message Text="Latest Build CargoWiseOneAnyCpuExe FileVersion='$(CargoWiseOneAnyCpuExeFileVersion)'" />
    <Message Text="CW1 db backup is based on CW1 version $(CargoWiseOneAnyCpuExeFileVersion)" Importance="High" />

    <!-- overwrite version info file if db BackupFile created -->
    <Message Text="Writing file version $(CargoWiseOneAnyCpuExeFileVersion) to file $(CW1ExeFileInfoPath)" Importance="high" />
    <WriteLinesToFile
      Condition="Exists('$(CargoWiseOneAnyCpuExePath)')"
      File="$(CW1ExeFileInfoPath)"
      Lines="$(CargoWiseOneAnyCpuExeFileVersion)"
      Overwrite="true"
      Encoding="utf-8" />

    <!-- delete our download lock file -->
    <Delete Files="$(LockFilePath)" Condition="Exists('$(LockFilePath)')" />
  </Target>

  <!-- prepare the paths and download CW1 latest build -->
  <!-- build CW1 db back up -->
  <Target Name="bat:cw1:db_build">
    <CallTarget Targets="bat:cw1:get_latest_build_if_needed" />

    <!-- restore alp, perform db upgrader, then backup -->
    <Message Text="Using $(CargoWiseOneAnyCpuExePath)" Condition="Exists('$(CargoWiseOneAnyCpuExePath)')" />
    <CallTarget Targets="bat:cw1:db_backup_upgrade_to_latest" Condition="Exists('$(CargoWiseOneAnyCpuExePath)')" />
  </Target>

  <!-- restore CW1 database from alp.bak and update to the latest, then backup to disk -->
  <Target Name="bat:cw1:db_backup_upgrade_to_latest">
    <Error Text="Please specify a value for FromBackupFilePath so as to pack up for deployment" Condition="'$(FromBackupFilePath)'==''" />

    <PropertyGroup>
      <TempDatabaseName>CW1$([System.DateTime]::Now.ToString(`MMddHHmmssfff`))</TempDatabaseName>
      <TempPath Condition="'$(ToDisk)'==''">$([System.IO.Path]::GetTempPath())</TempPath>
      <NewGuid>$([System.Guid]::NewGuid())</NewGuid>
      <TempBackupPath>$([System.IO.Path]::Combine('$(TempPath)', '$(NewGuid)'))</TempBackupPath>
      <TempBackupFilePath>$([System.IO.Path]::GetTempFileName())</TempBackupFilePath>
      <WorkingBackupFilePath>$([System.IO.Path]::GetTempFileName())</WorkingBackupFilePath>
    </PropertyGroup>

    <!-- use local backup for now until alp backup is completed see WI00279940 -->
    <!--
    <IsAlpLastWriteTimeUtcNewer LocalFilePath="$(LocalBackupFilePath)" AlpFilePath="$(FromBackupFilePath)">
      <Output TaskParameter="IsAlpNewer" PropertyName="IsAlpNewer" />
    </IsAlpLastWriteTimeUtcNewer>
    <Copy SourceFiles="$(FromBackupFilePath)" DestinationFiles="$(WorkingBackupFilePath)" Condition="'$(IsAlpNewer)'=='True'" />
    <Copy SourceFiles="$(LocalBackupFilePath)" DestinationFiles="$(WorkingBackupFilePath)" Condition="'$(IsAlpNewer)'!='True'" />
    -->

    <!-- just use the local backup for now -->
    <Copy SourceFiles="$(LocalBackupFilePath)" DestinationFiles="$(WorkingBackupFilePath)" />

    <!-- restore CW1 database from alpha backup then set recovery mode to simple -->
    <MakeDir Directories="$(TempBackupPath)" Condition="!Exists('$(TempBackupPath)')" />
    <MSBuild
      Projects="$(SqlHelpersProject)"
      Targets="bat:sql:restore_db;bat:sql:set_recovery_mode"
      Properties="DatabaseName=$(TempDatabaseName);FromDisk=$(WorkingBackupFilePath);SqlDataPath=$(TempBackupPath);SqlCmdLogOn=$(SqlCmdLogOn);SqlCmdPassword=$(SqlCmdPassword)" />

    <Message Text="Executing CargoWiseOneAnyCpu.exe to perform console db upgrader on the restored database" />
    <MSBuild
      Projects="$(MSBuildThisFileFullPath)"
      Targets="bat:cw1:db_upgrader"
      Properties="CW1Dir=$(CW1Dir);TargetDatabaseName=$(TempDatabaseName);SqlCmdLogOn=$(SqlCmdLogOn);SqlCmdPassword=$(SqlCmdPassword)"
      Condition="'$(SkipDbUpgrader)'==''" />

    <!-- shrink the prepared db -->
    <MSBuild
      Projects="$(SqlHelpersProject)"
      Targets="bat:sql:shrink_db"
      Properties="DatabaseName=$(TempDatabaseName);SqlCmdLogOn=$(SqlCmdLogOn);SqlCmdPassword=$(SqlCmdPassword)" />

    <!-- backup ready database to a backup file for later deployment job -->
    <MSBuild
      Projects="$(SqlHelpersProject)"
      Targets="bat:sql:backup_db"
      Properties="DatabaseName=$(TempDatabaseName);ToDisk=$(TempBackupFilePath);SqlCmdLogOn=$(SqlCmdLogOn);SqlCmdPassword=$(SqlCmdPassword)" />

    <!-- drop the restored databases and logins -->
    <MSBuild
      Projects="$(CW1DBDeployProj)"
      Targets="bat:remove"
      Properties="TargetDatabaseName=$(TempDatabaseName);SqlCmdLogOn=$(SqlCmdLogOn);SqlCmdPassword=$(SqlCmdPassword)" />

    <!-- this will prepare the backup file to be used for deploy from within csproj file -->
    <Copy SourceFiles="$(TempBackupFilePath)" DestinationFiles="$(BackupFilePath)" Condition="'$(TempBackupFilePath)'!=''" />
    <Copy SourceFiles="$(CW1ExeFileInfoPath)" DestinationFolder="$(OutputDirectory)" />

    <!-- delete the temporary back up file -->
    <Delete Files="$(TempBackupFilePath)" Condition="Exists('$(TempBackupFilePath)')" />
  </Target>

  <!-- Invoke CargoWiseOneAnyCpu.exe to upgrade CW1 database -->
  <Target Name="bat:cw1:db_upgrader">
    <Error Text="Please specify a value for TargetDatabaseName" Condition="'$(TargetDatabaseName)'==''" />
    <Error Text="'$(CargoWiseOneAnyCpuExePath)' can not be found" Condition="!Exists('$(CargoWiseOneAnyCpuExePath)')" />

    <Message Text="MSBuildToolsPath is $(MSBuildToolsPath)" />
    <StartProcess
      Condition="Exists('$(CargoWiseOneAnyCpuExePath)')"
      WorkingDirectory="$(CW1BinariesDir)"
      ExeFilePath="$(CargoWiseOneAnyCpuExePath)"
      Arguments=". $(TargetDatabaseName) -ConsoleDbUpgrader -NoSplash -Client:EDI">
      <Output TaskParameter="ExitCode" PropertyName="ExitCode" />
    </StartProcess>
    <Error Text="Exit Code=$(ExitCode) running &quot;$(CargoWiseOneAnyCpuExePath)&quot; . $(TargetDatabaseName) -ConsoleDbUpgrader -NoSplash -Client:EDI" Condition="'$(ExitCode)'!='0'" />
  </Target>

  <!-- download latest CW1 debug build so as to upgrade restored CW1 database -->
  <Target Name="bat:cw1:download_latestBuild" Returns="$(DownloadWasSuccessful)">
    <PropertyGroup>
      <TempFileName>$([System.IO.Path]::GetTempFileName())</TempFileName>
      <TempPath>$([System.IO.Path]::GetTempPath())</TempPath>
      <NewGuid>$([System.Guid]::NewGuid())</NewGuid>
      <QueuedDblCutoff>$([System.DateTime]::Now.AddDays(-1).ToString(`s`))</QueuedDblCutoff>
    </PropertyGroup>

    <Message Text="Downloading CW1 latest debug build from $(CW1LatestBuildUrl)$(QueuedDblCutoff) to $(TempFileName) ..." />
    <DownloadFile
      Retries="3"
      RetryDelayMilliseconds="5000"
      SourceUrl="$(CW1LatestBuildUrl)$(QueuedDblCutoff)"
      DestinationFolder="$(TempPath)"
      DestinationFileName="$(TempFileName)"
      ContinueOnError="True">
      <Output TaskParameter="DownloadedFile" ItemName="DownloadedFiles" />
    </DownloadFile>
    <PropertyGroup>
      <DownloadWasSuccessful Condition="'@(DownloadedFiles)'!=''">True</DownloadWasSuccessful>
    </PropertyGroup>

    <Message Text="CW1 latest debug build has been successfully downloaded to $(TempFileName)" Condition="'$(DownloadWasSuccessful)'=='True'" />
    <Message Text="Failed to download CW1 latest debug build from $(CW1LatestBuildUrl)" Condition="'$(DownloadWasSuccessful)'!='True'" />

    <Zip
      TaskAction="Extract"
      ExtractPath="$(CW1LatestBuildPath)"
      ZipFileName="$(TempFileName)"
      Condition="'$(DownloadWasSuccessful)'=='True'" />

    <Message Text="CW1 latest debug build has been extracted to path $(CW1LatestBuildPath)" Condition="Exists('$(CW1BinariesDir)')" />
    <Message Text="Deleting downloaded zip file $(TempFileName) if exists" />
    <Delete Files="$(TempFileName)" Condition="Exists('$(TempFileName)')" />
  </Target>

  <UsingTask
    TaskName="IsWaitTimeExpired"
    TaskFactory="CodeTaskFactory"
    AssemblyFile="$(MSBuildTasksToolsFilePath)">
    <ParameterGroup>
      <WaitMinutesString ParameterType="System.String" Required="true" />
      <SinceTimeUtcString ParameterType="System.String" Required="true" />
      <IsExpired ParameterType="System.Boolean" Output="true" Required="false" />
      <TimeNowUtc ParameterType="System.String" Output="true" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Globalization" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
    TimeSpan timeSpanWaitFor = System.TimeSpan.FromMinutes(double.Parse(WaitMinutesString));
    DateTime SinceTimeUtc = DateTime.Parse(SinceTimeUtcString).ToUniversalTime();
    DateTime DateTimeNowUtc = DateTime.UtcNow;
    TimeNowUtc = DateTimeNowUtc.ToString("o", CultureInfo.InvariantCulture);
    TimeSpan timeSpanElapsed = DateTimeNowUtc - SinceTimeUtc;
    IsExpired = timeSpanElapsed > timeSpanWaitFor;
]]>
      </Code>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="GetFileInfo"
    TaskFactory="PowershellTaskFactory"
    AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
    <ParameterGroup>
      <AssemblyFilePath ParameterType="System.String" Required="true" />
      <FileVersion ParameterType="System.String" Output="true" Required="false" />
    </ParameterGroup>
    <Task>
<![CDATA[
    $FileVersion = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($AssemblyFilePath).FileVersion
]]>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="LastWriteTimeUtc"
    TaskFactory="PowershellTaskFactory"
    AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <LastWriteTimeUtcString ParameterType="System.String" Output="true" Required="false" />
    </ParameterGroup>
    <Task>
<![CDATA[
    $LastWriteTimeUtcString = (Get-ItemProperty -Path $FilePath -Name LastWriteTimeutc).LastWriteTimeutc.ToString("o", [cultureinfo]::InvariantCulture)
]]>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="IsAlpLastWriteTimeUtcNewer"
    TaskFactory="PowershellTaskFactory"
    AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
    <ParameterGroup>
      <LocalFilePath ParameterType="System.String" Required="true" />
      <AlpFilePath ParameterType="System.String" Required="true" />
      <IsAlpNewer ParameterType="System.Boolean" Output="true" Required="false" />
    </ParameterGroup>
    <Task>
<![CDATA[
  $LocalFileTime = (Get-ItemProperty -Path $LocalFilePath -Name LastWriteTimeutc).LastWriteTimeUtc
  $AlpFileTime = (Get-ItemProperty -Path $AlpFilePath -Name LastWriteTimeutc).LastWriteTimeUtc
  $IsAlpNewer = ($AlpFileTime -gt $LocalFileTime)
]]>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="GetCurrentProcessId"
    TaskFactory="PowershellTaskFactory"
    AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
    <ParameterGroup>
      <Id ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
<![CDATA[
  $Id = $PID
]]>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="IsProcessRunning"
    TaskFactory="PowershellTaskFactory"
    AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
    <ParameterGroup>
      <Id ParameterType="System.Int32" Required="true" />
      <IsRunning ParameterType="System.Boolean" Output="true" />
      <ProcessName ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
<![CDATA[
  $IsRunning = $false
  try { Get-Process -id $id 2>$1 | % { $ProcessName = $_.ProcessName; $IsRunning = $true; }} catch { echo 'error' }
]]>
    </Task>
  </UsingTask>

  <UsingTask
    TaskName="StartProcess"
    TaskFactory="CodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.v4.0.dll">
    <ParameterGroup>
      <WorkingDirectory ParameterType="System.String" Required="true" />
      <ExeFilePath ParameterType="System.String" Required="true" />
      <Arguments ParameterType="System.String" Required="true" />
      <ExitCode ParameterType="System.Int32" Output="true" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Diagnostics" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
  using (var process = new Process())
  {
    var startInfo = new ProcessStartInfo
    {
      WorkingDirectory = WorkingDirectory,
      CreateNoWindow = true,
      FileName = ExeFilePath,
      RedirectStandardOutput = true,
      Arguments = Arguments,
      UseShellExecute = false,
    };

    process.StartInfo = startInfo;
    process.Start();
    string line = string.Format("{0} {1}", ExeFilePath, Arguments);
    System.Console.WriteLine(line);
    while ((line = process.StandardOutput.ReadLine()) != null)
    {
      System.Console.WriteLine(line);
    }

    process.WaitForExit();
    ExitCode = process.ExitCode;

    process.Close();
  }]]></Code>
    </Task>
  </UsingTask>
</Project>