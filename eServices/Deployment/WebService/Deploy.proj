    <UsingTask TaskName="GetWebConfigurationLock"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <FilterXPath Required="true" ParameterType="System.String" />
            <Locked Output="true" ParameterType="System.Boolean" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($FilterXPath)
                Import-Module WebAdministration
                $lock = Get-WebConfigurationLock -PSPath "IIS:\" -Filter $FilterXPath
                if ($null -eq $lock)
                {
                    New-Object PSObject -property @{
                        Locked = $FALSE
                    }
                }
                else
                {
                    New-Object PSObject -property @{
                        Locked = $TRUE
                    }
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "[$MachineName]: Getting web configuration lock status for [$FilterXPath]")

            Try
            {
                $result = Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $FilterXPath
            }
            Finally
            {
                remove-pssession -session $s
            }

            $Locked = $result.Locked

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "[$MachineName]: Is web configuration locked for [$FilterXPath]: [$Locked]")
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="GetRegistryValue"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Path Required="true" ParameterType="System.String" />
            <Name Required="true" ParameterType="System.String" />
            <Value Output="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Path,$Name)
                $FullPath = "Registry::$Path"
                $result = New-Object PSObject -property @{
                    Value = $null
                }
                if (Test-Path $FullPath)
                {
                    $Key = Get-Item -LiteralPath $FullPath
                    $Value = $Key.GetValue($Name, $null)
                    if ($null -ne $Value)
                    {
                        $result.Value = $Value
                    }
                }
                $result
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "[$MachineName]: Getting registry value of [$Name] at [$Path]")

            Try
            {
                $result = Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Path,$Name
            }
            Finally
            {
                remove-pssession -session $s
            }

            $Value = $result.Value

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "[$MachineName]: Registry value of [$Name] at [$Path]: [$Value]")
      ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="SetAccessRule"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Path Required="true" ParameterType="System.String" />
            <Identity Required="true" ParameterType="System.String" />
            <FileSystemRights Required="true" ParameterType="System.String" />
            <InheritanceFlags Required="true" ParameterType="System.String" />
            <PropagationFlags Required="true" ParameterType="System.String" />
            <AccessControlType Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Path,$Identity,$FileSystemRights,$InheritanceFlags,$PropagationFlags,$AccessControlType)
                Import-Module Microsoft.PowerShell.Security
                $FullPath = [System.Environment]::ExpandEnvironmentVariables($Path)
                New-Item -ItemType directory -Path $FullPath -Force
                $Acl = Get-Acl $FullPath
                $Ar = New-Object system.security.accesscontrol.filesystemaccessrule($Identity,$FileSystemRights,$InheritanceFlags,$PropagationFlags,$AccessControlType)
                $Acl.SetAccessRule($Ar)
                Set-Acl $FullPath $Acl
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"High", "[$MachineName]: Setting '$Identity' access rule '$AccessControlType $FileSystemRights' for '$Path'")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Path,$Identity,$FileSystemRights,$InheritanceFlags,$PropagationFlags,$AccessControlType
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="SetEnabledProtocols"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
