        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <Protocol Required="true" ParameterType="System.String" />
            <IPAddress Required="true" ParameterType="System.String" />
            <Port Required="true" ParameterType="System.String" />
            <HostHeader ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            
            $sb = { param($SiteName,$Protocol,$IPAddress,$Port,$HostHeader)
                Import-Module WebAdministration
                Remove-WebBinding -HostHeader $HostHeader -IPAddress $IPAddress -Name $SiteName -Port $Port -Protocol $Protocol
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }
            
            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }
            
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Removing binding [$Protocol`:$IPAddress`:$Port`:$HostHeader] of website [$SiteName]")
            
            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $SiteName,$Protocol,$IPAddress,$Port,$HostHeader
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="AddWebBindingIfNotExists"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <Protocol Required="true" ParameterType="System.String" />
            <IPAddress ParameterType="System.String" />
            <Port ParameterType="System.String" />
            <BindingInformation ParameterType="System.String" />
            <HostHeader ParameterType="System.String" />
            <SSLThumbprint ParameterType="System.String" />
            <SSLFriendlyName ParameterType="System.String" />
            <SSLCertificate ParameterType="System.String" />
            <SSLSubject ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            
            $sb = { param($MachineName,$SiteName,$Protocol,$IPAddress,$Port,$HostHeader,$SSLThumbprint,$SSLFriendlyName,$SSLCertificate,$SSLSubject,$BindingInformation)
                Import-Module WebAdministration
                if ($BindingInformation -eq $null)
                {
                    $binding = Get-WebBinding -HostHeader $HostHeader -IPAddress $IPAddress -Name $SiteName -Port $Port -Protocol $Protocol
                }
                else
                {
                    Add-Type -Path C:\Windows\System32\inetsrv\Microsoft.Web.Administration.dll
                    $srvmgr = New-Object Microsoft.web.administration.servermanager
                    $binding = $srvmgr.Sites.Bindings | where-object {($_.Protocol -eq $Protocol) -And ($_.BindingInformation -eq $BindingInformation)}
                }
              
                if ($null -eq $binding)
                {
                    Import-Module WebAdministration
                  
                    if ($Protocol -eq "http")
                    {
                        New-WebBinding -HostHeader $HostHeader -IPAddress $IPAddress -Name $SiteName -Port $Port -Protocol $Protocol
                    }
                    elseif ($Protocol -eq "https")
                    {
                        if ($SSLThumbprint)
                        {
                            $propertyname = "Thumbprint"
                            $propertyvalue = $SSLThumbprint
                        }
                        elseif ($SSLFriendlyName)
                        {
                            $propertyname = "FriendlyName"
                            $propertyvalue = $SSLFriendlyName
                        }
                        elseif ($SSLSubject)
                        {
                            $propertyname = "Subject"
                            $propertyvalue = $SSLSubject
                        }
                        else
                        {
                            $certSubject = if($HostHeader -eq "") { $MachineName } else { $HostHeader }
                            $propertyname = "Subject"
                            $propertyvalue = "CN=$certSubject"
                        }
                      
                        $cert = Get-ChildItem Cert:\LocalMachine\My,Cert:\LocalMachine\WebHosting -SSLServerAuthentication |
                        where-object { ($_.$propertyname -eq "$propertyvalue") -Or $_.$propertyname -like "*$propertyvalue*" }
                      
                        if ($null -eq $cert)
                        {
                            Throw "There is no certificate with $propertyname $propertyvalue on $MachineName"
                        }
                        elseif ($cert.Count -gt 1)
                        {
                            Throw "There are multiple certificates with $propertyname $propertyvalue on $MachineName or there is no binding for Https port 443."
                        }
                        else
                        {
                            $cert = $cert | select -First 1
                            if ($HostHeader) { $sslFlags = 1 } else {$sslFlags = 0}
                            New-WebBinding -HostHeader $HostHeader -IPAddress $IPAddress -Name $SiteName -Port $Port -Protocol $Protocol -SslFlags $sslFlags
                            New-Item "IIS:\SslBindings\$IPAddress!$Port!$HostHeader" -Value $cert -SslFlags $sslFlags
                        }
                    }
                    else
                    {
                        New-ItemProperty IIS:\Sites\$SiteName -name bindings -value @{protocol=$Protocol;bindingInformation=$BindingInformation}
                    }
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }
            
            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }
            
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Creating binding [$Protocol`:$IPAddress`:$Port`:$HostHeader] for website [$SiteName]")
            
            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $MachineName,$SiteName,$Protocol,$IPAddress,$Port,$HostHeader,$SSLThumbprint,$SSLFriendlyName,$SSLCertificate,$SSLSubject,$BindingInformation
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

