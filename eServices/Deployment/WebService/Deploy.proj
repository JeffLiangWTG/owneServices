<?xml version="1.0" encoding="utf-8"?>
<!--EXTERNAL_PROPERTIES: Profile;UserName;Password;_Server;_SiteName;_ServiceName;_AppPoolName;_AppPoolUserName;DeployManagedRuntimeVersion;_AppPoolUserPassword;_ServicePackagePath;_BackupRequired;_BackupFolder;_LogsFolder;_PreloadEnabled;_StartMode;_IdleTimeout-->
<!--EXTERNAL_ITEMS (optional): _Binding; Metadata: Protocol, IPAddress, Port, BindingInformation, HostHeader, SSLThumbprint, SSLFriendlyName, SSLSubject -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <MSBuildCommonTasks>$(MSBuildThisFileDirectory)\..\Common\MSBuildCommon.tasks</MSBuildCommonTasks>
        <MSBuildCommonTasks Condition="!Exists('$(MSBuildCommonTasks)')">$(MSBuildThisFileDirectory)\MSBuildCommon.tasks</MSBuildCommonTasks>

        <DatIntegrationAssemblyFilePath>$(MSBuildThisFileDirectory)..\..\DAT\Dat.Integration.dll</DatIntegrationAssemblyFilePath>
        <DatIntegrationAssemblyFilePath Condition="!Exists('$(DatIntegrationAssemblyFilePath)')">$(MSBuildThisFileDirectory)Dat.Integration.dll</DatIntegrationAssemblyFilePath>

        <MicrosoftWebPublishingPath Condition="'$(MicrosoftWebPublishingPath)' == ''">$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v16.0\Web\</MicrosoftWebPublishingPath>
        <MicrosoftWebPublishingTasksDllPath Condition="'$(MicrosoftWebPublishingTasksDllPath)' == ''">$(MicrosoftWebPublishingPath)Microsoft.Web.Publishing.Tasks.dll</MicrosoftWebPublishingTasksDllPath>

        <MSDeployPath Condition="'$(MSDeployPath)' == ''">$(ProgramFiles)\IIS\Microsoft Web Deploy V3</MSDeployPath>
        <DeployManagedRuntimeVersion Condition="'$(DeployManagedRuntimeVersion)' == ''">v4.0</DeployManagedRuntimeVersion>

        <CommonPowershellFunctionsFilePath>.\Common.ps1</CommonPowershellFunctionsFilePath>
        <CommonPowershellFunctionsFilePath Condition="!Exists('$(CommonPowershellFunctionsFilePath)')">$(MSBuildThisFileDirectory)\..\CommonScripts\Common.ps1</CommonPowershellFunctionsFilePath>
    </PropertyGroup>

    <Import Project="$(MSBuildCommonTasks)" Condition="'$(MSBuildCommonTasksImported)'==''"/>

    <Import Project="$(MSBuildProjectDirectory)\Deployment\Deployment.props" Condition="'$(_DeploymentPropsImported)'==''"/>
    <Import Project="$(MSBuildProjectDirectory)\Deployment\Profiles\$(Profile)\Deployment.props" Condition="'$(Profile)' != '' and '$(_ProfilePropsImported)'==''"/>

    <UsingTask TaskName="TransformXml"
               AssemblyFile="$(MicrosoftWebPublishingTasksDllPath)"/>

    <UsingTask TaskName="CreateDir"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Path Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Path)
                New-Item -ItemType directory -Path $Path
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Creating directory [$Path]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Path
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="GetWebsiteInfo"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <Exists Output="true" ParameterType="System.Boolean" />
            <Id Output="true" ParameterType="System.String" />
            <PhysicalPath Output="true" ParameterType="System.String" />
            <ApplicationPool Output="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            <# Log session related info to help diagnose on an error "Could not create a session on local machine:[localhost]" #>
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[Begin GetWebsiteInfo debug logging]")

            $WinRM_service_status = (Get-Service winrm | ft -AutoSize)
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "WinRM service status: $WinRM_service_status")

            $WinRM_config = (Winrm get winrm/config)
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "WinRM config: $WinRM_config")

            $WinRM_config_listener = (winrm e winrm/config/listener)
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "WinRM listener config: $WinRM_config_listener")

            $WinRM_listener = (netsh http show iplisten)
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "WinRM listeners: $WinRM_listener")

            $WinRM_port_stat = (netstat -ano | findstr 5985)
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "WinRM listening port 5985: $WinRM_port_stat")

            $WinRM_identify = (winrm identify)
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "WinRM identify: $WinRM_identify")

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "-MachineName [$MachineName] -UserName [$UserName]")
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[End GetWebsiteInfo debug logging]")

            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($SiteName)
                Import-Module WebAdministration
                <# DO NOT CHANGE: Get-WebSite, Reason: Environment Compatibility Issue, Returns all websites if used directly with -Name parameter #>
                $WebSite = Get-Website | Where {$_.Name -eq $SiteName}
                if ($null -ne $WebSite)
                {
                    New-Object PSObject -property @{
                        Exists = $TRUE
                        Id = $WebSite.Id
                        PhysicalPath = $WebSite.PhysicalPath.ToString()
                        ApplicationPool = $WebSite.ApplicationPool
                    }
                }
                else
                {
                    New-Object PSObject -property @{
                        Exists = $FALSE
                        Id = $null
                        PhysicalPath = $null
                        ApplicationPool = $null
                    }
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Getting parameters of website [$SiteName]")

            Try
            {
                $result = Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $SiteName
            }
            Finally
            {
                remove-pssession -session $s
            }

            $Exists = $result.Exists
            $Id = $result.Id
            $PhysicalPath = $result.PhysicalPath
            $ApplicationPool = $result.ApplicationPool

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Website [$SiteName] exists: [$Exists]")
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Website's ID [$Id]")
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Physical path of website [$SiteName]: [$PhysicalPath]")
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: AppPool of website [$SiteName]: [$ApplicationPool]")
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="GetWebApplicationInfo"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <AppName Required="true" ParameterType="System.String" />
            <Exists Output="true" ParameterType="System.Boolean" />
            <PhysicalPath Output="true" ParameterType="System.String" />
            <ApplicationPool Output="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($AppName,$SiteName)
                Import-Module WebAdministration
                $WebApplication = Get-WebApplication -Name "/$AppName" -Site $SiteName
                if ($null -ne $WebApplication)
                {
                    New-Object PSObject -property @{
                        Exists = $TRUE
                        PhysicalPath = $WebApplication.PhysicalPath.ToString()
                        ApplicationPool = $WebApplication.ApplicationPool
                    }
                }
                else
                {
                    New-Object PSObject -property @{
                        Exists = $FALSE
                        PhysicalPath = $null
                        ApplicationPool = $null
                    }
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Getting parameters of application [$SiteName/$AppName]")

            Try
            {
                $result = Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $AppName,$SiteName
            }
            Finally
            {
                remove-pssession -session $s
            }

            $Exists = $result.Exists
            $PhysicalPath = $result.PhysicalPath
            $ApplicationPool = $result.ApplicationPool

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Application [$SiteName/$AppName] exists: [$Exists]")
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Physical path for application [$SiteName/$AppName]: [$PhysicalPath]")
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: AppPool for application [$SiteName/$AppName]: [$ApplicationPool]")

            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="CreateWebsite"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <ManagedRuntimeVersion Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($SiteName,$ManagedRuntimeVersion)
                Import-Module WebAdministration
                <# DO NOT CHANGE: Get-WebSite, Reason: Environment Compatibility Issue, Returns all websites if used directly with -Name parameter #>
                $WebSite = Get-WebSite | Where { $_.Name -eq $SiteName }
                if ($WebSite -eq $null)
                {
                    $PhysicalPath = $env:SystemDrive + "\inetpub\wwwroot\$SiteName"
                    New-Item $PhysicalPath -ItemType Directory
                    New-WebAppPool -Name $SiteName
                    Set-ItemProperty -Path "IIS:\AppPools\$SiteName" managedRuntimeVersion $ManagedRuntimeVersion
                    New-Website -Name $SiteName -ApplicationPool $SiteName -PhysicalPath $PhysicalPath
                    Get-WebBinding -Name $SiteName | Remove-WebBinding
                    if ($null -ne $error[0])
                    {
                        Throw $error[0]
                    }
                }
                else
                {
                    Throw "Website [$SiteName] already exists."
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Creating website [$SiteName]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $SiteName,$ManagedRuntimeVersion
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="CreateWebApplication"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Name Required="true" ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <AppPoolName Required="true" ParameterType="System.String" />
            <PhysicalPath Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Name,$SiteName,$AppPoolName,$PhysicalPath)
                Import-Module WebAdministration
                $FullPath = [System.Environment]::ExpandEnvironmentVariables($PhysicalPath)
                New-Item $FullPath -ItemType Directory
                New-WebApplication -Site $SiteName -Name $Name -PhysicalPath $PhysicalPath -ApplicationPool $AppPoolName
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Creating web application [$Name] with application pool [$AppPoolName] and physical path [$PhysicalPath] on website [$SiteName]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name,$SiteName,$AppPoolName,$PhysicalPath
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="ApplyWebApplicationSettings"
                TaskFactory="PowershellTaskFactory"
                AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
            <Name Required="true" ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <PreloadEnabled ParameterType="System.String" />
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)

            if ($null -eq $MachineName) 
            {
                $MachineName = $env:COMPUTERNAME
            }
            
            $providedParams = "MachineName: $MachineName, Name: $Name, SiteName: $SiteName, PreloadEnabled: $PreloadEnabled"
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Starting ApplyWebApplicationSettings with parameters: $providedParams")
            
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            
            $sb = { param($Name,$SiteName,$PreloadEnabled)
                Import-Module WebAdministration
                Set-ItemProperty "IIS:\Sites\$SiteName\$Name" -Name preloadEnabled -Value $PreloadEnabled
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }
            
            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name,$SiteName,$PreloadEnabled
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="StopWebsite"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($SiteName)
                Import-Module WebAdministration
                Stop-Website -Name $SiteName
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Stopping website [$SiteName]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $SiteName
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="StartWebsite"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            
            $sb = { param($SiteName)
                Import-Module WebAdministration
                Start-Website -Name $SiteName
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }
            
            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }
            
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Starting website [$SiteName]")
            
            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $SiteName
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="RemoveWebsite"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <SiteName Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            
            $sb = { param($SiteName)
                Import-Module WebAdministration
                Remove-Website -Name $SiteName
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }
            
            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }
            
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Removing website [$SiteName]")
            
            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $SiteName
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="CheckAppPoolExists"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Name Required="true" ParameterType="System.String" />
            <Exists Output="true" ParameterType="System.Boolean" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Name)
                Import-Module WebAdministration
                Try
                {
                    $state = Get-WebAppPoolState -Name $Name
                    New-Object PSObject -property @{
                        Exists = $TRUE
                    }
                }
                Catch
                {
                    New-Object PSObject -property @{
                        Exists = $FALSE
                    }
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Checking whether application pool [$Name] exists")

            Try
            {
                $result = Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name
            }
            Finally
            {
                remove-pssession -session $s
            }

            $Exists = $result.Exists

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Application pool [$Name] exists: [$Exists]")
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="CreateAppPool"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Name Required="true" ParameterType="System.String" />
            <ManagedRuntimeVersion Required="true" ParameterType="System.String" />
            <AppPoolUserName ParameterType="System.String" />
            <AppPoolUserPassword ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Name, $ManagedRuntimeVersion, $UserName, $Password)
                Import-Module WebAdministration
                $appPool = New-WebAppPool -Name $Name
                Set-ItemProperty -Path "IIS:\AppPools\$Name" managedRuntimeVersion $ManagedRuntimeVersion
                if ($null -ne $UserName -and $null -ne $Password)
                {
                    $appPool.processModel.userName = $UserName
                    $appPool.processModel.password = $Password
                    $appPool.processModel.identityType = "SpecificUser"
                    $appPool | Set-Item
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Creating application pool [$Name] with .NET CLR version [$ManagedRuntimeVersion]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name,$ManagedRuntimeVersion,$AppPoolUserName,$AppPoolUserPassword
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="ApplyAppPoolSettings"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
	    <ParameterGroup>
		    <MachineName ParameterType="System.String" />
		    <UserName ParameterType="System.String" />
		    <UserPassword ParameterType="System.String" />
		    <Name Required="true" ParameterType="System.String" />
		    <PortNumber ParameterType="System.Int32"/>
		    <StartMode ParameterType="System.String"/>
		    <IdleTimeout ParameterType="System.String"/>
	    </ParameterGroup>
	    <Task>
		    <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $providedParams = "MachineName: $MachineName, Name: $Name, StartMode: $StartMode, IdleTimeout: $IdleTimeout"
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Applying new settings to application pool with parameters: $providedParams")

            $sb = { param($Name, $StartMode, $IdleTimeout)
                Import-Module WebAdministration
				if ($null -ne $StartMode)
				{
					Set-ItemProperty -Path "IIS:\AppPools\$Name" -name startMode -Value $StartMode
				}
				if ($null -ne $IdleTimeout)
				{
					Set-ItemProperty -Path "IIS:\AppPools\$Name" -name processModel.idleTimeout -Value $IdleTimeout
				}
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name,$StartMode,$IdleTimeout
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
	    </Task>
    </UsingTask>

    <UsingTask TaskName="CreateUserAccountOnWindows"
             TaskFactory="PowershellTaskFactory"
             AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <UserCreatedOnWindows ParameterType="System.String" />
            <PasswordForCreatedUser ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            $decryptedPassword = Decrypt -EncryptedPassword $PasswordForCreatedUser -DatIntegrationAssemblyFilePath $(DatIntegrationAssemblyFilePath) -Logger $log
                
            $sb = { param($MachineName, $UserCreatedOnWindows, $PasswordForCreatedUser)

                $CompObject = [ADSI]"WinNT://$MachineName"
                $NewObj = $CompObject.Create("User",$UserCreatedOnWindows)
                $NewObj.SetPassword($PasswordForCreatedUser)
                $NewObj.SetInfo()
                NET LOCALGROUP "Users" $UserCreatedOnWindows /add

                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Creating User with Username: [$UserCreatedOnWindows]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $MachineName,$UserCreatedOnWindows,$decryptedPassword
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

    <UsingTask TaskName="StopAppPool"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Name Required="true" ParameterType="System.String" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session

            $sb = { param($Name)
                Import-Module WebAdministration
                if ((Get-WebAppPoolState -Name $Name).Value -ne "Stopped")
                {
                    Stop-WebAppPool -Name $Name
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
                do
                {
                    Start-Sleep -Seconds 1
                    $i++
                }
                until((Get-WebAppPoolState -Name $Name).Value -eq "Stopped" -or $i -eq 30)
              
                if((Get-WebAppPoolState -Name $Name).Value -ne "Stopped")
                {
                    Throw "App pool was not stopped successfully."
                }
            }

            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }

            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Stopping application pool [$Name]")

            Try
            {
                Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name
            }
            Finally
            {
                remove-pssession -session $s
            }
            ]]>
        </Task>
    </UsingTask>

