    <UsingTask TaskName="GetApplicationsInAppPoolCount"
               TaskFactory="PowershellTaskFactory"
               AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
        <ParameterGroup>
            <MachineName ParameterType="System.String" />
            <UserName ParameterType="System.String" />
            <UserPassword ParameterType="System.String" />
            <Name Required="true" ParameterType="System.String" />
            <Count Output="true" ParameterType="System.Int32" />
            <PortNumber ParameterType="System.Int32"/>
        </ParameterGroup>
        <Task>
            <![CDATA[
            . $(CommonPowershellFunctionsFilePath)
            $s = (Connect -MachineName $MachineName -UserName $UserName -UserPassword $UserPassword -PortNumber $PortNumber).Session
            
            $sb = { param($Name)
                Import-Module WebAdministration
                New-Object PSObject -property @{
                    Count = @(Get-WebConfigurationProperty "/system.applicationHost/sites/site/application[@applicationPool='$Name']" "machine/webroot/apphost" -name path).Count
                }
                if ($null -ne $error[0])
                {
                    Throw $error[0]
                }
            }
            
            if ($null -eq $MachineName)
            {
                $MachineName = $env:COMPUTERNAME
            }
            
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Getting count of applications in application pool [$Name]")
            
            Try
            {
                $result = Invoke-Command -Session $s -ScriptBlock $sb -ArgumentList $Name
            }
            Finally
            {
                remove-pssession -session $s
            }
            
            $Count = $result.Count
            
            $log.LogMessage([Microsoft.Build.Framework.MessageImportance]"Normal", "[$MachineName]: Number of applications in application pool [$Name]: [$Count]")
            ]]>
        </Task>
