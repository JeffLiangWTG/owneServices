<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <MSBuildCommonTasksImported>True</MSBuildCommonTasksImported>

    <MSBuildExtensionsPackPath>$(MSBuildProgramFiles32)\MSBuild\ExtensionPack\4.0\</MSBuildExtensionsPackPath>
    <MSBuildExtensionsPackPath Condition="!Exists('$(MSBuildExtensionsPackPath)')">$(MSBuildProgramFiles32)\MSBuildExtensionPack\4.0\</MSBuildExtensionsPackPath>
    <MSBuildExtensionsPackPath Condition="!Exists('$(MSBuildExtensionsPackPath)')">$(MSBuildExtensionsPath)\ExtensionPack\4.0\</MSBuildExtensionsPackPath>
    <MSBuildExtensionsPackPath Condition="!Exists('$(MSBuildExtensionsPackPath)')">$(ProgramW6432)\MSBuildExtensionPack\4.0\</MSBuildExtensionsPackPath>
    <ExtensionTasksPath>$(MSBuildExtensionsPackPath)</ExtensionTasksPath>

    <ExtensionPackPowershellFilePath>$(MSBuildExtensionsPackPath)MSBuild.ExtensionPack.TaskFactory.PowerShell.dll</ExtensionPackPowershellFilePath>

    <MSBuildTasksToolsFilePath>$(MSBuildBinPath)\Microsoft.Build.Tasks.Core.dll</MSBuildTasksToolsFilePath>
    <MSBuildTasksToolsFilePath Condition="!Exists('$(MSBuildTasksToolsFilePath)')">$(MSBuildProgramFiles32)\MSBuild\$(MSBuildToolsVersion)\Bin\Microsoft.Build.Tasks.v$(MSBuildUseVersion).dll</MSBuildTasksToolsFilePath>
  </PropertyGroup>

  <Import Project="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.tasks" Condition="'$(MSBuildExtensionsPackImported)'==''"/>

  <PropertyGroup>
    <MSBuildExtensionsPackImported>True</MSBuildExtensionsPackImported>
  </PropertyGroup>
</Project>