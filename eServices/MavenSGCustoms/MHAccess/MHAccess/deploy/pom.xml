<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
	<artifactId>mhaccess-gateway-deployment</artifactId>
	<name>MHAccess Gateway Deployment</name>
	<version>1.0.0</version>
	<packaging>war</packaging>
	<parent>
		<groupId>com.cargowise.eservices</groupId>
		<artifactId>eservices-repo-pom</artifactId>
		<version>1.0.0</version>
		<relativePath>./repo-pom.xml</relativePath>
	</parent>

	<dependencies>
		<dependency>
			<groupId>${groupId}</groupId>
			<artifactId>${artifactId}</artifactId>
			<version>${version}</version>
			<type>war</type>
		</dependency>
	</dependencies>

	<properties>
		<tomcat_hostname>localhost</tomcat_hostname>
		<tomcat_port>8080</tomcat_port>
		<tomcat_protocol>http</tomcat_protocol>
		<tomcat_username>admin</tomcat_username>
		<tomcat_password>ehubrocks</tomcat_password>
		<tomcat_deployment_path>MHAccess</tomcat_deployment_path>

		<!-- Properties for defining offline-webservice-assembly via mvn install:install-file -->
		<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
		<artifactId>mhaccess-gateway-service</artifactId>
		<version>1.0.0-offline</version>
		<file>MHAccessGateway.war</file>
		<packaging>war</packaging>

		<!-- Detail properties -->
		<Built-By>WiseTech Global</Built-By>
		
		<!-- System properties -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>
	<profiles>
		<profile>
			<id>test</id>
			<properties>
				<tomcat_port>8080</tomcat_port>
				<tomcat_hostname>au2wt-smsg-401.test.wisecloud.zone</tomcat_hostname>
				<tomcat_password>SkcA59tMVhXbN+KZfWr/q80A2HcNyGU2qsujTFhW2jUCJ9/sXJdgG8iiR/xwnjVkV6oaLSs4IjWb1xaB4sC5upp/XSsuiBp/vf8LSXlpMJSUTV4GrEKjEUx4FUe9T2zVZQurnQdfv6or2OIpn1ySpWUWwOV5dt4+T5n8CVv//ow=</tomcat_password>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<configuration>
							<webResources>
								<resource>
									<directory>profile/test</directory>
									<targetPath>WEB-INF</targetPath>
								</resource>
							</webResources>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>production1</id>
			<properties>
				<tomcat_port>9080</tomcat_port>
				<tomcat_hostname>au2wp-sews-401a.wisecloud.zone</tomcat_hostname>
				<tomcat_password>nRge4G48c2V0ACZshjdbc0v/d/v9lincl6r77Z6R6PoNwKb05jacTHjeJz2J+8hamvzufxqIOC74FYBsIiA2uhGZsfXnIz83NWpuSly+/QHQwDbjJucMERcMNgRwyLPgjqinf6r4sGcuiSJaBrgcURbBKu41dr5jqg2RjzHJ3b4=</tomcat_password>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<configuration>
							<webResources>
								<resource>
									<directory>profile/prod</directory>
									<targetPath>WEB-INF</targetPath>
								</resource>
							</webResources>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>production2</id>
			<properties>
				<tomcat_port>9080</tomcat_port>
				<tomcat_hostname>au2wp-sews-401b.wisecloud.zone</tomcat_hostname>
				<tomcat_password>nRge4G48c2V0ACZshjdbc0v/d/v9lincl6r77Z6R6PoNwKb05jacTHjeJz2J+8hamvzufxqIOC74FYBsIiA2uhGZsfXnIz83NWpuSly+/QHQwDbjJucMERcMNgRwyLPgjqinf6r4sGcuiSJaBrgcURbBKu41dr5jqg2RjzHJ3b4=</tomcat_password>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<configuration>
							<webResources>
								<resource>
									<directory>profile/prod</directory>
									<targetPath>WEB-INF</targetPath>
								</resource>
							</webResources>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>deploy</id>
			<activation>
				<property>
					<!-- The following profile will be activated when the system property "remove" is not defined,
						or is defined with a value which is not "true". -->
					<name>remove</name>
					<value>!true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- http://tomcat.apache.org/maven-plugin-2.2/tomcat7-maven-plugin/plugin-info.html -->
					<plugin>
						<groupId>org.apache.tomcat.maven</groupId>
						<artifactId>tomcat7-maven-plugin</artifactId>
						<version>2.2</version>
						<configuration>
							<url>${tomcat_protocol}://${tomcat_hostname}:${tomcat_port}/manager/text</url>
							<username>${tomcat_username}</username>
							<password>${tomcat_password}</password>
							<path>/${tomcat_deployment_path}</path>
						</configuration>
						<executions>
							<execution>
								<id>undeploy-existing-tomcat-app</id>
								<phase>deploy</phase>
								<goals>
									<goal>undeploy</goal>
								</goals>
								<configuration>
									<failOnError>false</failOnError>
								</configuration>
							</execution>
							<execution>
								<id>deploy-to-tomcat</id>
								<phase>deploy</phase>
								<goals>
									<goal>deploy</goal>
								</goals>
								<configuration>
									<failOnError>true</failOnError>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>remove</id>
			<activation>
				<property>
					<name>remove</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
					<!-- http://tomcat.apache.org/maven-plugin-2.2/tomcat7-maven-plugin/plugin-info.html -->
					<plugin>
						<groupId>org.apache.tomcat.maven</groupId>
						<artifactId>tomcat7-maven-plugin</artifactId>
						<version>2.2</version>
						<configuration>
							<url>${tomcat_protocol}://${tomcat_hostname}:${tomcat_port}/manager/text</url>
							<username>${tomcat_username}</username>
							<password>${tomcat_password}</password>
							<path>/${tomcat_deployment_path}</path>
						</configuration>
						<executions>
							<execution>
								<id>undeploy-existing-tomcat-app</id>
								<phase>deploy</phase>
								<goals>
									<goal>undeploy</goal>
								</goals>
								<configuration>
									<failOnError>true</failOnError>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<finalName>MHAccessGateway</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-war-plugin</artifactId>
					<version>3.1.0</version>
					<configuration>
						<overlays>
							<overlay>
								<groupId>${groupId}</groupId>
								<artifactId>${artifactId}</artifactId>
							</overlay>
						</overlays>
						<archive>
							<addMavenDescriptor>false</addMavenDescriptor>
							<manifest>
								<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							</manifest>
							<manifestEntries>
								<Built-By>${Built-By}</Built-By>
							</manifestEntries>
						</archive>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
