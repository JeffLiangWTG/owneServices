<!-- this common pom is used for project's parent pom -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
	<artifactId>mhaccess</artifactId>
	<name>MHAccess Parent</name>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices</groupId>
		<artifactId>eservices-common-parent-pom</artifactId>
		<version>1.0.0</version>
	</parent>
	<modules>
		<module>../InstallThirdPartyJars</module>
		<module>../MHAccessBusiness</module>
		<module>../MHAccessGatewayWebService</module>
		<module>../MHAccessGatewayClient</module>
	</modules>

	<properties>
		<bin.directory>../../bin/mhaccess</bin.directory>
	</properties>
	<build>
		<finalName>MHAccessGateway</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>package-gateway-war</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
									<artifactId>mhaccess-gateway-service</artifactId>
									<version>1.0.0</version>
									<type>war</type>
									<destFileName>MHAccessGateway.war</destFileName>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/deploy</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<executions>
					<execution>
						<id>install-parent-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>install</phase>
						<configuration>
							<file>parent-pom.xml</file>
							<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
							<artifactId>mhaccess-parent</artifactId>
							<pomFile>parent-pom.xml</pomFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
				<executions>
					<execution>
						<id>deploy-parent-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>parent-pom.xml</file>
							<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
							<artifactId>mhaccess-parent</artifactId>
							<pomFile>parent-pom.xml</pomFile>
							<repositoryId>${internalRepoID}</repositoryId>
							<url>${deploymentRepo}</url>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
