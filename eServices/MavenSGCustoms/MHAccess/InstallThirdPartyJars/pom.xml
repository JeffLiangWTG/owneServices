<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
	<artifactId>install-third-party-jars</artifactId>
	<name>InstallThirdPartyJars</name>
	<description>Install Third Party Jars</description>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices</groupId>
		<artifactId>eservices-common-parent-pom</artifactId>
		<version>1.0.0</version>
	</parent>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<configuration>
					<skip>true</skip>
				</configuration>
				<executions>
					<execution>
						<id>deploy-mhx-jar</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>${pom.baseDir}\..\..\MHAccessGatewayWebService\src\main\webapp\WEB-INF\MHAccess\snsjar\mhx.jar</file>
							<groupId>com.sns.mhx</groupId>
							<artifactId>mhaccess</artifactId>
							<version>1.0.1</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
					<execution>
						<id>deploy-mhxUtil-jar</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>${pom.baseDir}\..\..\MHAccessGatewayWebService\src\main\webapp\WEB-INF\MHAccess\snsjar\mhxUtil.jar</file>
							<groupId>com.sns.mhx</groupId>
							<artifactId>mhaccess-util</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
					<execution>
						<id>deploy-soapws-client-jar</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>${pom.baseDir}\..\..\MHAccessGatewayWebService\src\main\webapp\WEB-INF\MHAccess\snsjar\soapws-client.jar</file>
							<groupId>com.crimsonlogic.mhb</groupId>
							<artifactId>soapws-client</artifactId>
							<version>1.0.0</version>
							<packaging>jar</packaging>
							<generatePom>true</generatePom>
							<repositoryId>${repoID}</repositoryId>
							<url>${wtgRepo}</url>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>