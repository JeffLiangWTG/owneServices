<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>mhaccess-business</artifactId>
	<name>MHAccess Business</name>
	<description>MHAccess Business library</description>
	<packaging>jar</packaging>
	<parent>
		<groupId>com.cargowise.ehub.products.sgcustoms.mhaccess</groupId>
		<artifactId>mhaccess-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../MHAccess/parent-pom.xml</relativePath>
	</parent>

	<properties>
		<bin.directory>../../bin/mhaccess</bin.directory>
	</properties>

	<build>
		<plugins>
			<!-- Use "mvn jaxb2:xjc" to generate XML object under target/generated/sources/jaxb -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxb2-maven-plugin</artifactId>
				<version>2.3.1</version>
				<configuration>
					<packageName>com.cargowises.ehub.products.sgcustoms.mhaccess.business.schema</packageName>
					<enableIntrospection>true</enableIntrospection>
					<target>2.1</target> <!-- jaxb runtime -->
					<sources>
						<source>src/main/resources/com/cargowises/ehub/products/sgcustoms/mhaccess/business/schema/MHAccessResponse.xsd</source>
					</sources>
					<xjbSources>
						<xjbSource>src/main/resources/com/cargowises/ehub/products/sgcustoms/mhaccess/business/schema/global.xjb</xjbSource>
					</xjbSources>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.6</version>
		</dependency>
		<!-- Logging -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>2.17.1</version>
		</dependency>
		<!-- Strictly speaking Log4j core is only needed at runtime and not at compile time. -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-core</artifactId>
			<version>2.17.1</version>
			<scope>test</scope>
		</dependency>
		<!-- MHAccess -->
		<dependency>
			<groupId>com.sns.mhx</groupId>
			<artifactId>mhaccess</artifactId>
			<version>1.0.1</version>
		</dependency>
		<dependency>
			<groupId>com.sns.mhx</groupId>
			<artifactId>mhaccess-util</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.crimsonlogic.mhb</groupId>
			<artifactId>soapws-client</artifactId>
			<version>1.0.0</version>
		</dependency>
		<!-- MHAccess dependencies -->
		<dependency>
			<groupId>com.sun.xml.fastinfoset</groupId>
			<artifactId>FastInfoset</artifactId>
			<version>1.2.12</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.ws</groupId>
			<artifactId>jaxws-rt</artifactId>
			<version>2.2.7</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.2.4</version>
			<scope>runtime</scope>
		</dependency>
	</dependencies>
</project> 