        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="RegisterSystemsInAuthentication" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.sql.*;
import java.io.*;
import com.microsoft.sqlserver.jdbc.SQLServerStatement;
import org.apache.jmeter.services.FileServer;
import org.apache.commons.io.FileUtils;

Connection con = null;
try {
	var path = FileServer.getFileServer().getBaseDir();
	var sqlPath = path + &quot;\\TestClientsSetupAuthentication.sql&quot;;
	var csvPath = path + &quot;\\TestClients.csv&quot;;
	String content = FileUtils.readFileToString(new File(sqlPath));
	csvPath = csvPath.replace(&quot;\\&quot;, &quot;\\\\&quot;);
	content = content.replaceFirst(&quot;#CSVPath#&quot;, &quot;&apos;&quot;+ csvPath + &quot;&apos;&quot;);
	String connectionUrl = &quot;jdbc:sqlserver://localhost;DatabaseName=AuthenticationWebService;integratedSecurity=true&quot;;
	
	Class.forName(&quot;com.microsoft.sqlserver.jdbc.SQLServerDriver&quot;);
	con = DriverManager.getConnection(connectionUrl);
	PreparedStatement pstmt = con.prepareStatement(content);
	pstmt.executeUpdate();
	pstmt.close();
}
catch(Exception ex){
	log.error(ex.message);
}
finally{
	if (con != null) try { con.close(); } catch(Exception e) {}
}
					</stringProp>
