        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="LoadProperties" enabled="true">
          <stringProp name="BeanShellSampler.query">import org.apache.commons.io.FileUtils;
import org.apache.jmeter.services.FileServer;

try {
	var path = FileServer.getFileServer().getBaseDir();
	path = path + &quot;\\Test.properties&quot;;

	BufferedReader reader = new BufferedReader(new FileReader(path));

	for(String line; (line = reader.readLine()) != null; ) {
	String[] parts = line.split(&quot;=&quot;);
	props.put(parts[0],parts[1]);
	}
} catch (Throwable ex) {
	throw ex;
}
					</stringProp>
