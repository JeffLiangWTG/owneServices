        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="ConstructMessages" enabled="true">
          <stringProp name="BeanShellSampler.query">try {
	String validMessage = vars.get(&quot;ValidMessage&quot;);
	String invalidMessage = vars.get(&quot;InvalidMessage&quot;);
	validMessage = validMessage.replaceFirst(&quot;#SchemaName#&quot;, ${__P(SchemaName)});
	invalidMessage = invalidMessage.replaceFirst(&quot;#SchemaName#&quot;, ${__P(SchemaName)});
	StringBuilder mixSb = new StringBuilder(validMessage);
	for(int i=0;i&lt;500;i++) {
		mixSb.append(validMessage);
		mixSb.append(invalidMessage);
	}
	vars.put(&quot;MixedMessages&quot;, mixSb.toString());
}catch (Exception ex) {
	log.info(&quot;Script execution failed&quot;, ex);
}
					</stringProp>
