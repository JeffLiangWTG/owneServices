        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="UnregisterSystemsAuthentication" enabled="true">
          <stringProp name="BeanShellSampler.query">
import java.sql.*;
import java.io.*;
import com.microsoft.sqlserver.jdbc.SQLServerStatement;
import org.apache.jmeter.services.FileServer;
import org.apache.commons.io.FileUtils;

Connection con = null;
try {
	String connectionUrl = &quot;jdbc:sqlserver://localhost;DatabaseName=AuthenticationWebService;integratedSecurity=true&quot;;
	Class.forName(&quot;com.microsoft.sqlserver.jdbc.SQLServerDriver&quot;);
	con = DriverManager.getConnection(connectionUrl);
	PreparedStatement pstmt = con.prepareStatement(&quot;DELETE FROM Authentication&quot;);
	pstmt.executeQuery();
	pstmt.close();
}
catch(Exception ex){
	log.error(ex.message);
}
finally{
	if (con != null) try { con.close(); } catch(Exception e) {}
}
</stringProp>
