            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="PreProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import java.text.SimpleDateFormat;

SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;);
sdf.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;));
Date now = new Date();
Date expires = new Date(now.getTime() + 300000L);
String wsuCreated = sdf.format(now);
String wsuExpires = sdf.format(expires);
String systemCode = vars.get(&quot;SysCode&quot;) + vars.get(&quot;SysCode&quot;) + vars.get(&quot;SysCode&quot;);
var sampler = ctx.getCurrentSampler();
String data = sampler.getXmlData();
data = data.replaceFirst(&quot;#CREATED#&quot;, wsuCreated);
data = data.replaceFirst(&quot;#EXPIRES#&quot;, wsuExpires);
data = data.replaceFirst(&quot;#SysCode#&quot;, systemCode);
data = data.replaceFirst(&quot;#Password#&quot;, vars.get(&quot;Password&quot;));
data = data.replaceFirst(&quot;#BillingMessages#&quot;, vars.get(&quot;ValidMessages&quot;));
sampler.setXmlData(data);
							</stringProp>
            </BeanShellPreProcessor>
