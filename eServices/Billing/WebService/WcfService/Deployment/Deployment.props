<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_BinPath>Bin</_BinPath>
    <_Server></_Server>
    <_SiteName>Default Web Site</_SiteName>
    <_ServiceName>Billing</_ServiceName>
    <_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
    <_BackupFolder>c:\BillingWebService_backup</_BackupFolder>
    <_AnonymousAuthenticationEnabled>true</_AnonymousAuthenticationEnabled>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
  <ItemGroup>
    <_Binding Include="1">
      <IPAddress>*</IPAddress>
      <Port>443</Port>
      <Protocol>https</Protocol>
      <HostHeader></HostHeader>
    </_Binding>
  </ItemGroup>
</Project>