<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <add name="BillingContext"
         connectionString="data source=au2sp-402l1.sand.wtg.zone;initial catalog=CargoWise.eServices.Billing;persist security info=True;user id=DBDeploymentLogin;password=$BillingDBPassword$;MultipleActiveResultSets=True;Application Name=TestBillingWebService"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(name)"/>
  </connectionStrings>

  <appSettings>
    <add key="BillingKafkaTopic" value="topic-au1-test-billing-test"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="UsageELKKafkaTopic" value="topic-au1-test-ehubgatewaynonbilledusage-test"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="BilledELKKafkaTopic" value="topic-au1-test-ehubgatewaybilledusage-test"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="SendToELKBillingCategories" value="TST,STL,ACC,DOS,WTA,SMF"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="NotSendToELKBillingCodes" value="EAD,EAO"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="HostedServerNames" value="au2sp-siis-402a.sand.wtg.zone,au2sp-siis-402b.sand.wtg.zone,au2wt-siis-401a.test.wisecloud.zone,au2wt-siis-401b.test.wisecloud.zone"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
  </appSettings>

  <billingKafkaClientSettings>
    <add key="bootstrap.servers" value="106-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,107-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,108-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,109-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044,110-cluster-kafka-q0-au2-brokers.kafka.wtg.ws:8044"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="sasl.username" value="topic-au1-test-billing-test"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="sasl.password" value="$BillingKafkaPassword$"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
  </billingKafkaClientSettings>
  <billingKafkaProducerSettings>
    <add key="linger.ms" value="50"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="message.timeout.ms" value="10000"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
  </billingKafkaProducerSettings>
  <billingKafkaConsumerSettings>
    <add key="group.id" value="eServices-billing-transactions-consumer-test"
         xdt:Transform="SetAttributes(value)"
         xdt:Locator="Match(key)"/>
    <add key="auto.offset.reset" value="Earliest"
         xdt:Transform="Replace"
         xdt:Locator="Match(key)" />
    <add key="enable.partition.eof" value="true"
         xdt:Transform="Replace"
         xdt:Locator="Match(key)" />
  </billingKafkaConsumerSettings>

  <system.serviceModel>
    <bindings xdt:Transform="Remove" />
    <bindings xdt:Transform="Insert">
      <basicHttpBinding>
        <binding name="basicHttp" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647">
          <security mode="None" />
          <readerQuotas maxDepth="2000000" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
        </binding>
      </basicHttpBinding>
    </bindings>

    <services>
      <service name="CargoWise.eServices.Billing.WcfService.BillingService"
               xdt:Transform="Replace"
               xdt:Locator="Match(name)">
        <endpoint address=""
                  binding="basicHttpBinding"
                  bindingConfiguration="basicHttp"
                  contract="CargoWise.Billing.Service.IBillingService" />
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" xdt:Transform="SetAttributes" />
          <serviceDebug includeExceptionDetailInFaults="true" xdt:Transform="SetAttributes" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>

  <system.webServer>
    <rewrite xdt:Transform="Insert">
      <rules>
        <rule name="Forward Heartbeat to HealthCheck">
          <match url="^$" />
          <action type="Rewrite" url="wtg/status" />
        </rule>
      </rules>
    </rewrite>

    <directoryBrowse enabled="true" xdt:Transform="SetAttributes" />

    <security>
      <ipSecurity xdt:Transform="Remove"/>
      <ipSecurity allowUnlisted="true" xdt:Transform="Insert"/>
    </security>

    <applicationInitialization skipManagedModules="false" doAppInitAfterRestart="true" xdt:Transform="Insert" />
    <applicationInitialization>
      <add initializationPage="/BillingService.svc" hostName="billing-test.wtg.zone" xdt:Transform="Insert" />
    </applicationInitialization>
  </system.webServer>

</configuration>