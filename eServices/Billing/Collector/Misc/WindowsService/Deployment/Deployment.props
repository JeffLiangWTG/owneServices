<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	  <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_BinPath>Bin</_BinPath>
    <_ServiceName>miscBilling</_ServiceName>
    <_ServiceDisplayName>Billing Service - Miscellaneous</_ServiceDisplayName>
    <_ServiceDescription>Collects and sends miscellaneous billing information to a server.</_ServiceDescription>
    <_ServiceFilesPath>$(_BinPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eServices.Billing.Collector.Misc.WindowsService.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServices</_DeploymentFolder>
    <_BackupFolder>c:\eServices\Backup\miscBilling</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>