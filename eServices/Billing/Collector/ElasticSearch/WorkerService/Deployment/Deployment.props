<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_BinPath>Bin</_BinPath>
    <_ServiceName>ElasticSearchBillingCollectorService</_ServiceName>
    <_ServiceDisplayName>ElasticSearch Billing Collector Service</_ServiceDisplayName>
    <_ServiceDescription>ElasticSearch Billing Collector Service</_ServiceDescription>
    <_ServiceFilesPath>$(_BinPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eServices.Billing.Collector.NET.ElasticSearch.WorkerService.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServices</_DeploymentFolder>
    <_BackupFolder>c:\eServices\Backup\ElasticSearchBillingCollectorService</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>