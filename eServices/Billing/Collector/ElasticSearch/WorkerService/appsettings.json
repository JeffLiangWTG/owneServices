{
	"UsageELKKafkaTopic": "elk-topic",
	"BillingWcfServiceEndpoint": "https://localhost",
	"IssueManagerUri": "https://localhost",
	"BillingKafkaClientConfig": {
		"bootstrap.servers": "localhost:9093",
		"security.protocol": "Ssl",
		"enable.ssl.certificate.verification": "true"
	},
	"BillingKafkaProducerConfig": {
		"linger.ms": "50"
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Debug",
			"Override": {
				"Microsoft": "Information",
				"System": "Warning"
			}
		},
		"Using": [ "Serilog.Sinks.File", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread", "Serilog.Expressions" ],
		"Enrich": [ "WithMachineName", "WithThreadId" ],
		"WriteTo:WorkerService": {
			"Name": "Logger",
			"Args": {
				"configureLogger": {
					"WriteTo": [
						{
							"Name": "File",
							"Args": {
								"path": "Logs\\Service.log",
								"outputTemplate": "{Timestamp:o} [{MachineName}] ({ThreadId:D5}) [{Level:u3}] {SourceContext} {Message}{NewLine}{Exception}",
								"rollOnFileSizeLimit": true,
								"fileSizeLimitBytes": 10485760,
								"retainedFileCountLimit": 10
							}
						}
					],
					"Filter": [
						{
							"Name": "ByIncludingOnly",
							"Args": {
								"expression": "SourceContext = 'CargoWise.eServices.Billing.Collector.NET.BackgroundService.Common.BillingService' or SourceContext = 'CargoWise.Billing.CollectorService.Plugin.PluginsManager'"
							}
						}
					]
				}
			}
		},
		"WriteTo:Test": {
			"Name": "Logger",
			"Args": {
				"configureLogger": {
					"WriteTo": [
						{
							"Name": "File",
							"Args": {
								"path": "Logs\\TestLogs.log",
								"outputTemplate": "{Timestamp:o} [{MachineName}] ({ThreadId:D5}) [{Level:u3}] {SourceContext} {Message}{NewLine}{Exception}",
								"rollOnFileSizeLimit": true,
								"fileSizeLimitBytes": 10485760,
								"retainedFileCountLimit": 10
							}
						}
					],
					"Filter": [
						{
							"Name": "ByIncludingOnly",
							"Args": {
								"expression": "SourceContext = 'CargoWise.eServices.Billing.Collector.NET.ElasticSearch.WorkerService.Plugins.Test.Plugin'"
							}
						}
					]
				}
			}
		},
		"WriteTo:WGR": {
			"Name": "Logger",
			"Args": {
				"configureLogger": {
					"WriteTo": [
						{
							"Name": "File",
							"Args": {
								"path": "Logs\\WGReporting.log",
								"outputTemplate": "{Timestamp:o} [{MachineName}] ({ThreadId:D5}) [{Level:u3}] {SourceContext} {Message}{NewLine}{Exception}",
								"rollOnFileSizeLimit": true,
								"fileSizeLimitBytes": 10485760,
								"retainedFileCountLimit": 10
							}
						}
					],
					"Filter": [
						{
							"Name": "ByIncludingOnly",
							"Args": {
								"expression": "SourceContext = 'CargoWise.eServices.Billing.Collector.NET.ElasticSearch.WorkerService.Plugins.WGReport.Plugin'"
							}
						}
					]
				}
			}
		}
	}
}
