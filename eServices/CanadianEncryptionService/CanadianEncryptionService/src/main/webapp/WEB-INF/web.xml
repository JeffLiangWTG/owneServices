<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	version="3.0">
	
	<context-param>
		<param-name>Password</param-name>
		<param-value>CargoWise2010</param-value>
	</context-param>
	<context-param>
		<param-name>SenderPrivateKey</param-name>
		<param-value>cert/CACertTest.epf</param-value>
	</context-param>
	<context-param>
		<param-name>RecipientPublicKey</param-name>
		<param-value>cert/CACertTest.cer</param-value>
	</context-param>
	
	<display-name>CanadianEncryptionService</display-name>
	<listener>
		<listener-class>com.sun.xml.ws.transport.http.servlet.WSServletContextListener</listener-class>
	</listener>
	<servlet>
		<servlet-name>CanadianEncryptionService</servlet-name>
		<servlet-class>com.sun.xml.ws.transport.http.servlet.WSServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>CanadianEncryptionService</servlet-name>
		<url-pattern>/CanadianEncryptionService</url-pattern>
	</servlet-mapping>
	<session-config>
        <session-timeout>1</session-timeout>
    </session-config>
</web-app>