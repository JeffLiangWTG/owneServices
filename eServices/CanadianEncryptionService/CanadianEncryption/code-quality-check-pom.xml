<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.eservices.canadian.encryption</groupId>
	<artifactId>canadian-encryption-code-quality-check</artifactId>
	<name>Canadian Encryption Code Quality Checks</name>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices.canadian.encryption</groupId>
		<artifactId>canadian-encryption-properties</artifactId>
		<version>1.0.0</version>
		<relativePath>properties-pom.xml</relativePath>
	</parent>

	<dependencies>
		<!-- https://mvnrepository.com/artifact/com.google.guava/guava for annotation -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>22.0</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>2.17</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>7.8.2</version>
					</dependency>
				</dependencies>
				<configuration>
					<propertyExpansion>samedir=quality-check</propertyExpansion>
					<configLocation>quality-check/checkstyle-checker.xml
					</configLocation>
					<suppressionsLocation>quality-check/checkstyle-supressions.xml
					</suppressionsLocation>
					<testSourceDirectories>${basedir}/src/test/java,${basedir}/src/integrationtest/java
					</testSourceDirectories>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<consoleOutput>true</consoleOutput>
					<failOnViolation>false</failOnViolation> <!-- turn this one on if you want to do a live fix code quality problems -->
				</configuration>
				<executions>
					<execution>
						<id>checkstyle</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>findbugs-maven-plugin</artifactId>
				<version>3.0.4</version>
				<configuration>
					<!-- Enables analysis which takes more memory but finds more bugs. If 
						you run out of memory, changes the value of the effort element to 'low'. -->
					<effort>Max</effort>
					<!-- Reports all bugs (other values are medium and max) -->
					<threshold>Low</threshold>
					<xmlOutput>true</xmlOutput>
					<includeTests>true</includeTests>
					<excludeFilterFile>quality-check/findbugs-exclude.xml
					</excludeFilterFile>
					<failOnError>false</failOnError> <!-- turn this one on if you want to do a live fix code quality problems -->
				</configuration>
				<executions>
					<execution>
						<id>findbugs</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>3.8</version>
				<dependencies>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-java</artifactId>
						<version>5.8.1</version>
					</dependency>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-core</artifactId>
						<version>5.8.1</version>
					</dependency>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-javascript</artifactId>
						<version>5.8.1</version>
					</dependency>
					<dependency>
						<groupId>net.sourceforge.pmd</groupId>
						<artifactId>pmd-jsp</artifactId>
						<version>5.8.1</version>
					</dependency>
				</dependencies>
				<configuration>
					<linkXRef>false</linkXRef>
					<failurePriority>5</failurePriority>
					<printFailingErrors>true</printFailingErrors>
					<rulesets>
						<ruleset>${basedir}/../CanadianEncryption/quality-check/pmd-ruleset.xml
						</ruleset>
					</rulesets>
					<failOnViolation>false</failOnViolation> <!-- turn this one on if you want to do a live fix code quality problems -->
				</configuration>
				<executions>
					<execution>
						<id>pmd</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
							<goal>cpd-check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
