<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>canadian-encryption</artifactId>
	<name>Canadian Encryption</name>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cargowise.eservices.canadian.encryption</groupId>
		<artifactId>canadian-encryption-properties</artifactId>
		<version>1.0.0</version>
		<relativePath>properties-pom.xml</relativePath>
	</parent>
	<modules>
		<module>../CanadianEncryptionLibrary</module>
		<module>../CanadianEncryptionService</module>
		<module>../CanadianEncryptionClient</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.0.2</version>
				<executions>
					<execution>
						<id>copy-resources-deploy-folder</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/deploy
							</outputDirectory>
							<resources>
								<resource>
									<directory>${basedir}/deploy</directory>
									<excludes>
										<exclude>target/**</exclude>
									</excludes>
								</resource>
								<resource>
									<directory>${basedir}/</directory>
									<include>safeServiceRestart.bat</include>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.10</version>
				<executions>
					<execution>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.cargowise.eservices.canadian.encryption.service
									</groupId>
									<artifactId>canadian-encryption-service</artifactId>
									<version>1.0.0</version>
									<type>war</type>
									<destFileName>CanadianEncryptionService.war</destFileName>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/deploy</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.4</version>
				<executions>
					<execution>
						<id>install-properties-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>validate</phase>
						<configuration>
							<file>properties-pom.xml</file>
							<artifactId>canadian-encryption-properties</artifactId>
							<pomFile>properties-pom.xml</pomFile>
						</configuration>
					</execution>
					<execution>
						<id>install-code-quality-check-pom</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>install</phase>
						<configuration>
							<file>code-quality-check-pom.xml</file>
							<artifactId>canadian-encryption-code-quality-check</artifactId>
							<pomFile>code-quality-check-pom.xml</pomFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<executions>
					<execution>
						<id>deploy-properties-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>properties-pom.xml</file>
							<artifactId>canadian-encryption-properties</artifactId>
							<pomFile>properties-pom.xml</pomFile>
						</configuration>
					</execution>
					<execution>
						<id>deploy-code-quality-check-pom</id>
						<goals>
							<goal>deploy-file</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<file>code-quality-check-pom.xml</file>
							<artifactId>canadian-encryption-code-quality-check</artifactId>
							<pomFile>code-quality-check-pom.xml</pomFile>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.5.4</version>
				<configuration>
					<descriptor>zip.xml</descriptor>
					<finalName>CanadianEncryptionService-${project.version}-deploy
					</finalName>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>packaging-zip</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
