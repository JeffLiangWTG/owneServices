<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.cargowise.eservices.canadian.encryption.service.deployment
	</groupId>
	<artifactId>canadian-encryption-service-deployment</artifactId>
	<name>Canadian Encryption Service Deployment</name>
	<version>1.0.0</version>
	<packaging>war</packaging>

	<dependencies>
		<dependency>
			<groupId>com.cargowise.eservices.canadian.encryption.service
			</groupId>
			<artifactId>canadian-encryption-service</artifactId>
			<version>1.0.0-offline</version>
			<type>war</type>
		</dependency>
	</dependencies>

	<properties>
		<tomcat_hostname>localhost</tomcat_hostname>
		<tomcat_port>8080</tomcat_port>
		<tomcat_protocol>http</tomcat_protocol>
		<tomcat_username>admin</tomcat_username>
		<tomcat_password>admin</tomcat_password>
		<tomcat_deployment_path>CACustoms</tomcat_deployment_path>
		<tomcat_windows_service_name>Tomcat8</tomcat_windows_service_name>
		<!-- Properties for defining offline-webservice-assembly via mvn install:install-file -->
		<groupId>com.cargowise.eservices.canadian.encryption.service</groupId>
		<artifactId>canadian-encryption-service</artifactId>
		<version>1.0.0-offline</version>
		<file>CanadianEncryptionService.war</file>
		<packaging>war</packaging>
		<!-- Property to connect remote repo -->
		<managementRepo>http://sydsp-wddb-1.sand.wtg.zone:8080/repository/internal/</managementRepo>
	</properties>
	<profiles>
		<profile>
			<id>test</id>
			<properties>
				<!-- define later when I have the info about the server -->
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<version>2.6</version>
						<configuration>
							<overlays>
								<overlay>
									<groupId>com.cargowise.eservices.canadian.encryption.service
									</groupId>
									<artifactId>canadian-encryption-service</artifactId>
									<excludes>
										<exclude>WEB-INF/cert/**</exclude>
									</excludes>
								</overlay>
							</overlays>
							<webXml>profile/test/web.xml</webXml>
							<webResources>
								<resource>
									<directory>profile/test/cert</directory>
									<targetPath>WEB-INF/cert</targetPath>
								</resource>
							</webResources>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>production</id>
			<properties>
				<!-- define later when I have the info about the server -->
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<version>3.1.0</version>
						<configuration>
							<overlays>
								<overlay>
									<groupId>com.cargowise.eservices.canadian.encryption.service
									</groupId>
									<artifactId>canadian-encryption-service</artifactId>
									<excludes>
										<exclude>WEB-INF/cert/**</exclude>
									</excludes>
								</overlay>
							</overlays>
							<webXml>profile/prod/web.xml</webXml>
							<webResources>
								<resource>
									<directory>profile/prod/cert</directory>
									<targetPath>WEB-INF/cert</targetPath>
								</resource>
							</webResources>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<finalName>CanadianEncryptionService</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>2.4</version>
				<configuration>
					<skip>true</skip>
				</configuration>
				<executions>
					<execution>
						<id>install-service</id>
						<goals>
							<goal>install-file</goal>
						</goals>
						<phase>clean</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<overlays>
						<overlay>
							<groupId>com.cargowise.eservices.canadian.encryption.service
							</groupId>
							<artifactId>canadian-encryption-service</artifactId>
						</overlay>
					</overlays>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
						<manifest>
							<addDefaultImplementationEntries>true
							</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Built-By>${Built-By}</Built-By>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>2.8.2</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.6.0</version>
				<executions>
					<execution>
						<id>restart-tomcat</id>
						<phase>deploy</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>safeServiceRestart.bat</executable>
							<!-- optional -->
							<workingDirectory>${basedir}</workingDirectory>
							<arguments>
								<argument>${tomcat_hostname}</argument>
								<argument>${tomcat_windows_service_name}</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- http://tomcat.apache.org/maven-plugin-2.2/tomcat7-maven-plugin/plugin-info.html. 
				Please use tomcat:{goal} instead of tomcat7:{goal} -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>tomcat-maven-plugin</artifactId>
				<version>1.1</version>
				<configuration>
					<url>${tomcat_protocol}://${tomcat_hostname}:${tomcat_port}/manager/text
					</url>
					<username>${tomcat_username}</username>
					<password>${tomcat_password}</password>
					<path>/${tomcat_deployment_path}</path>
				</configuration>
				<executions>
					<execution>
						<id>deploy-to-tomcat</id>
						<phase>deploy</phase>
						<goals>
							<goal>redeploy</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	
	<repositories>
		<repository>
			<id>internal</id>
			<name>Archiva Managed Internal Repository</name>
			<url>${managementRepo}</url>
		</repository>
	</repositories>
	<pluginRepositories>
		<pluginRepository>
			<id>internal</id>
			<name>Archiva Managed Internal Repository</name>
			<url>${managementRepo}</url>
		</pluginRepository>
	</pluginRepositories>
</project>
