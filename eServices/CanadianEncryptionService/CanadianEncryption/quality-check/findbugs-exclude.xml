<?xml version="1.0"?>
<!DOCTYPE FindBugsFilter>

<FindBugsFilter>
	<Match>
		<Class name="~.*\.*Tests?.*" />
		<Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON, RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT" />
	</Match>
	<Match>
        <!-- Ignore auto-generated package -->
        <Class name="~com\.cargowise\.eservices\.canadian\.encryption\.client\.((?!Tests?).)*"/>
    </Match>
</FindBugsFilter>