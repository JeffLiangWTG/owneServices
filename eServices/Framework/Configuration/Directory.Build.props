<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
  <PropertyGroup>
    <Company>WiseTech Global Pty Ltd</Company>
    <Product>eHub</Product>
    <Copyright>© Copyright WiseTech Global</Copyright>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <AssemblyFileVersion>3.0.0.0</AssemblyFileVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MsBuildThisFileDirectory)..\..\EDI-Release-private.snk</AssemblyOriginatorKeyFile>
    <Deterministic>true</Deterministic>
    <BaseOutputPath>$(MsBuildThisFileDirectory)Bin\Build\$(MSBuildProjectName)</BaseOutputPath>
    <PackageOutputPath>$(MsBuildThisFileDirectory)Bin\Pack\$(MSBuildProjectName)</PackageOutputPath>
  </PropertyGroup>
</Project>