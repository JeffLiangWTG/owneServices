<?xml version="1.0" encoding="utf-8"?>
<DatDeploy xmlns="http://eservices.buildtools/datdeploy">
  <Targets>
    <Target Name="TestDeploy-Production"
            Command="%CMD_DEPLOY%"
            Environment="Production"
            Settings="SECRET_KEY=$(Secrets:SECRET)"/>
  </Targets>
  <Settings>
    <Add Name="CMD_DEPLOY">DEPLOY COMMAND</Add>
  </Settings>
  <Secrets>
    <Add Name="SECRET" Value="SECRET DATA" />
  </Secrets>
</DatDeploy>
