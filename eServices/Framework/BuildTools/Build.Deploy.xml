<?xml version="1.0" encoding="utf-8"?>
<DatDeploy xmlns="http://eservices.buildtools/datdeploy">
  <Targets>
    <Target Name="eServices.BuildTools.DatTool" Command="%CMD_PUBLISH_PACKAGE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.DatTool\*.nupkg" />
    <Target Name="eServices.BuildTools.DatTool-Prerelease" Command="%CMD_PUBLISH_PACKAGE_PRERELEASE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.DatTool\*.nupkg" />
    <Target Name="eServices.BuildTools.SqlAgentTool" Command="%CMD_PUBLISH_PACKAGE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.SqlAgentTool\*.nupkg" />
    <Target Name="eServices.BuildTools.SqlAgentTool-Prerelease" Command="%CMD_PUBLISH_PACKAGE_PRERELEASE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.SqlAgentTool\*.nupkg" />
    <Target Name="eServices.BuildTools.PackTool" Command="%CMD_PUBLISH_PACKAGE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.PackTool\*.nupkg" />
    <Target Name="eServices.BuildTools.PackTool-Prerelease" Command="%CMD_PUBLISH_PACKAGE_PRERELEASE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.PackTool\*.nupkg" />
    <Target Name="eServices.BuildTools.SqlDeploy" Command="%CMD_PUBLISH_PACKAGE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.SqlDeploy\*.nupkg" />
    <Target Name="eServices.BuildTools.SqlDeploy-Prerelease" Command="%CMD_PUBLISH_PACKAGE_PRERELEASE%" Settings="PKG_PATH=%DAT_BIN_PATH%\Pack\eServices.BuildTools.SqlDeploy\*.nupkg" />
  </Targets>
  <Settings>
    <Add Name="CMD_PUBLISH_PACKAGE">
      <![CDATA[powershell "dir $env:PKG_PATH -Exclude *-rc[.0-9]*.nupkg | sort | select -last 1 | %% { dotnet nuget push $_.FullName --source https://proget.wtg.zone/nuget/WTG-Internal/ --api-key $(Secrets:PROGET_API_KEY) --skip-duplicate }"]]>
    </Add>
    <Add Name="CMD_PUBLISH_PACKAGE_PRERELEASE">
      <![CDATA[powershell "dir $env:PKG_PATH -Include *-rc[.0-9]*.nupkg | sort | select -last 1 | %% { dotnet nuget push $_.FullName --source https://proget.wtg.zone/nuget/WTG-Internal/ --api-key $(Secrets:PROGET_API_KEY) --skip-duplicate }"]]>
    </Add>
  </Settings>
