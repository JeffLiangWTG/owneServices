<?xml version="1.0" encoding="utf-8"?>

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="test">

  <PropertyGroup>
    <MSBuildExtensionsPackPath Condition="'$(MSBuildExtensionsPackPath)' == ''">$(ProgramFiles)\MSBuild\ExtensionPack\4.0\</MSBuildExtensionsPackPath>
    <MSBuildExtensionsPackPath Condition="!Exists('$(MSBuildExtensionsPackPath)')">$(ProgramFiles)\MSBuildExtensionPack\4.0\</MSBuildExtensionsPackPath>

    <BinPath>$(MSBuildThisFileDirectory)..\..\Bin</BinPath>
    <DatIntegrationAssemblyFilePath>$(BinPath)\DAT\Dat.Integration.dll</DatIntegrationAssemblyFilePath>
    <DatIntegrationAssemblyFilePath>$([System.IO.Path]::GetFullPath('$(DatIntegrationAssemblyFilePath)'))</DatIntegrationAssemblyFilePath>
    <OutputFilePath>$([System.IO.Path]::GetRandomFileName())</OutputFilePath>
  </PropertyGroup>

  <Import Project="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.tasks" Condition="'$(BuildPath)'==''"/>

  <Target Name="test">
    <ItemGroup>
      <Passwords Include="1234" />
      <Passwords Include="pa$$w0rd" />
      <Passwords Include="3hubRock$" />
    </ItemGroup>

    <Encrypt Passwords="@(Passwords)">
      <Output TaskParameter="Encrypted" ItemName="Encrypted" />
    </Encrypt>

    <Message Text="%(Encrypted.Identity)" />
    <WriteLinesToFile
        File="$(OutputFilePath)"
        Lines="@(Encrypted)"
        Overwrite="true"
        Encoding="utf-8" />

    <Exec Command="cmd /c notepad.exe $(OutputFilePath)" />
  </Target>

  <UsingTask
    TaskName="Encrypt"
    TaskFactory="PowershellTaskFactory"
    AssemblyFile="$(MSBuildExtensionsPackPath)\MSBuild.ExtensionPack.TaskFactory.PowerShell.dll">
    <ParameterGroup>
      <Passwords ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <MetadataName ParameterType="System.String" Required="false" />
      <Encrypted ParameterType="System.String[]" Output="true" />
    </ParameterGroup>

    <Task>
      <![CDATA[
          Add-Type -Path $(DatIntegrationAssemblyFilePath)
          $encryptor = New-Object Dat.Integration.SecureStorage

          if ([string]::IsNullOrEmpty($MetadataName)) { $MetadataName = [String] "Identity" }

          $Encrypted = @()
          $Encrypted += "{"
          $Passwords | % {
            $count = $Encrypted.Count
            if ($count -gt 1) { $Encrypted[$count - 1] += "," }

            $Encrypted += ("  ""{0}"": ""{1}""" -f $_, $encryptor.Encrypt($_.GetMetadata($MetadataName)))
          }
          $Encrypted += "}"
      ]]>
    </Task>

  </UsingTask>

</Project>