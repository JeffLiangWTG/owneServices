<?xml version="1.0" encoding="utf-8"?>

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ReceiveLocationReplaceWithFILEImported>true</ReceiveLocationReplaceWithFILEImported>
  </PropertyGroup>

  <ItemGroup>
    <MSBuildNamespaces Include="MSBuildNamespace">
      <Prefix>x</Prefix>
      <Uri>http://schemas.microsoft.com/developer/msbuild/2003</Uri>
    </MSBuildNamespaces>
  </ItemGroup>

  <!-- validation rules on the target xml file this xdt transformation can be applied -->
  <ItemGroup>
    <Validations Remove="@(Validations)" />

    <Validations Include="Not-IsTwoWay">
      <!-- not two ways -->
      <XPath><![CDATA[/ReceivePort[@IsTwoWay="false"]/@IsTwoWay]]></XPath>
    </Validations>
    <Validations Include="Selective-TransportTypes">
      <!-- not WCF not FILE nor HTTP -->
      <XPath><![CDATA[/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveLocationTransportType[not(starts-with(@Name, "WCF")) and @Name!="FILE" and @Name!="HTTP"]/@Name]]></XPath>
    </Validations>
  </ItemGroup>

 <!-- ReceivePort_ReceiveLocation /ReceivePort[@IsTwoWay="false"] -->
  <ItemGroup>
    <Xdt Include="TransportType.Name.UpdateAttribute">
      <XPath>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveLocationTransportType</XPath>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>UpdateAttribute</TaskAction>
      <Key>Name</Key>
      <Value>FILE</Value>
    </Xdt>

    <Xdt Include="TransportType.Capabilities.UpdateAttribute">
      <XPath>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveLocationTransportType</XPath>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>UpdateAttribute</TaskAction>
      <Key>Capabilities</Key>
      <Value>11</Value>
    </Xdt>

    <Xdt Include="TransportType.ConfigurationClsid.UpdateAttribute">
      <XPath>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveLocationTransportType</XPath>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>UpdateAttribute</TaskAction>
      <Key>ConfigurationClsid</Key>
      <Value>5e49e3a6.b4fc.4077.b44c.22f34a242fdb</Value>
    </Xdt>

    <Xdt Include="CustomProps.RemoveElement">
      <ParentElement>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveLocationTransportTypeData</ParentElement>
      <Element>CustomProps</Element>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>RemoveElement</TaskAction>
    </Xdt>

    <Xdt Include="CustomProps.AddElement">
      <ParentElement>/ReceivePort/ReceiveLocations/ReceiveLocation</ParentElement>
      <Element>ReceiveLocationTransportTypeData</Element>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>AddElement</TaskAction>
      <InnerXml><![CDATA[
<CustomProps>
  <RenameReceivedFiles vt="11">${ReceivePort_ReceiveLocation_TransportType_RenameReceivedFiles}</RenameReceivedFiles>
  <RemoveReceivedFileDelay vt="19">${ReceivePort_ReceiveLocation_TransportType_RemoveReceivedFileDelay}</RemoveReceivedFileDelay>
  <RemoveReceivedFileMaxInterval vt="19">${ReceivePort_ReceiveLocation_TransportType_RemoveReceivedFileMaxInterval}</RemoveReceivedFileMaxInterval>
  <FileMask vt="8">${ReceivePort_ReceiveLocation_TransportType_FileMask}</FileMask>
  <FileNetFailRetryInt vt="19">${ReceivePort_ReceiveLocation_TransportType_FileNetFailRetryInt}</FileNetFailRetryInt>
  <RemoveReceivedFileRetryCount vt="19">${ReceivePort_ReceiveLocation_TransportType_RemoveReceivedFileRetryCount}</RemoveReceivedFileRetryCount>
  <BatchSizeInBytes vt="19">${ReceivePort_ReceiveLocation_TransportType_BatchSizeInBytes}</BatchSizeInBytes>
  <PollingInterval vt="19">${ReceivePort_ReceiveLocation_TransportType_PollingInterval}</PollingInterval>
  <FileNetFailRetryCount vt="19">${ReceivePort_ReceiveLocation_TransportType_FileNetFailRetryCount}</FileNetFailRetryCount>
  <BatchSize vt="19">${ReceivePort_ReceiveLocation_TransportType_BatchSize}</BatchSize>
</CustomProps>]]>
      </InnerXml>
    </Xdt>

    <Xdt Include="TransportType.RemoveElement">
      <ParentElement>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveHandler</ParentElement>
      <Element>TransportType</Element>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>RemoveElement</TaskAction>
    </Xdt>

    <Xdt Include="TransportType.AddElement">
      <ParentElement>/ReceivePort/ReceiveLocations/ReceiveLocation</ParentElement>
      <Element>ReceiveHandler</Element>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>AddElement</TaskAction>
      <InnerXml><![CDATA[<TransportType Name="FILE" Capabilities="11" ConfigurationClsid="5e49e3a6.b4fc.4077.b44c.22f34a242fdb" />]]>
      </InnerXml>
    </Xdt>

    <Xdt Include="ReceiveHandler.Name.UpdateAttribute">
      <XPath>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveHandler</XPath>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>UpdateAttribute</TaskAction>
      <Key>Name</Key>
      <Value>ReceiveHost_FILE</Value>
    </Xdt>

    <Xdt Include="ReceiveHandler.HostTrusted.UpdateAttribute">
      <XPath>/ReceivePort/ReceiveLocations/ReceiveLocation/ReceiveHandler</XPath>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>UpdateAttribute</TaskAction>
      <Key>HostTrusted</Key>
      <Value>${ReceivePort_ReceiveHandler_HostTrusted}</Value>
    </Xdt>

    <Xdt Include="ReceiveLocation.Address.UpdateElement">
      <XPath>/ReceivePort/ReceiveLocations/ReceiveLocation/Address</XPath>
      <Namespaces>@(MSBuildNamespaces)</Namespaces>
      <TaskAction>UpdateElement</TaskAction>
      <InnerText>${ReceivePort_ReceiveLocation_Address}</InnerText>
    </Xdt>

  </ItemGroup>

  <!-- import the xdt transform tasks -->
  <PropertyGroup>
    <XdtTransformsTasksPath Condition="'$(XdtTransformsTasksPath)'==''">$(MSBuildThisFileDirectory)</XdtTransformsTasksPath>
    <XdtTransformsTasks Condition="'$(XdtTransformsTasks)'==''">$(XdtTransformsTasksPath)XdtTransforms.tasks</XdtTransformsTasks>
  </PropertyGroup>

  <Import Project="$(XdtTransformsTasks)" Condition="'$(XdtTransformsTasksImported)'==''" />

</Project>