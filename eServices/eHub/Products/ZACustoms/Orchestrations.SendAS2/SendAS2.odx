col=required,pkcs7-signature; signed-receipt-micalg=required,sha256&#xD;&#xA;Message-ID: &lt;{0}_{1}&gt;&#xD;&#xA;AS2-To: {2}&#xD;&#xA;AS2-From: {3}&quot;,&#xD;&#xA;    OutboxMsg(BTS.SourceParty),&#xD;&#xA;    msgTrackingID,&#xD;&#xA;    sarsCode,&#xD;&#xA;    agentid&#xD;&#xA;);&#xD;&#xA;" />
