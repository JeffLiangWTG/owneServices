                        logger.Log.Debug("SARS ID: " + sarsid);
                        
                        senderID = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries("ZACustoms", "ZACustoms", "ZACustoms Configuration", "Agent Profile", "SenderID", agentid, null, null, null, null, logger.Log);
                        senderSubID = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries("ZACustoms", "ZACustoms", "ZACustoms Configuration", "Agent Profile", "SenderSubID", agentid, null, null, null, null, logger.Log);
