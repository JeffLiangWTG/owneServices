                        logger.Log.Info("SendError [MessageTrackingID: " + OutboxMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID) + "]");
                        logger.Log.Error("Error sending change of status request to database with tracking ID '" + OutboxMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID) + "'\r\n" + sqlException.Message);
