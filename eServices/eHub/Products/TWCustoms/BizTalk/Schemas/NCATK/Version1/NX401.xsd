                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID130</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Tariff. Quantity</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity of the goods in the unit as required by Customs for tariff, statistical or fiscal purposes.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Tariff</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Quantity</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>數量</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..15,4</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:GoodsMeasureTariffQuantityType">
                                                                    <xsd:pattern value="[0-9]{0,11}(\.[0-9]{1,4}){0,1}"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="tw_UnitCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW026</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Unit. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity unit of the goods.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Unit</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>數量單位</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..3</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:GoodsMeasureUnitCodeType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="3"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="Origin">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>92A</ccts:UniqueID>
                                                    <ccts:Definition>Details about the origin of the goods.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Origin</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="CountryCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID063</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Origin. Country. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>To identify the country in which the goods have been produced or manufactured, according to criteria laid down for the application of the Customs tariff or quantitative restrictions, or any measure related to trade.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Origin</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Country</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>生產國別代碼</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>a2</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:OriginCountryCodeType">
                                                                    <xsd:length value="2"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Packaging">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>93A</ccts:UniqueID>
                                                    <ccts:Definition>Details related to packaging.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Packaging</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="QuantityQuantity">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID144</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Packaging. Quantity. Quantity</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Number of individual items packaged in such a way that they cannot be divided without first undoing the packing.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Packaging</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Quantity</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Quantity</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>件數</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..8</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:PackagingQuantityQuantityType">
                                                                    <xsd:minInclusive value="0"/>
                                                                    <xsd:maxInclusive value="99999999"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="TypeCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID141</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Packaging. Type. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Code specifying the type of package of an item.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Packaging</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Type</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>件數單位</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..3</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:PackagingTypeCodeType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="3"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="tw_GoodsStatisticalMeasure">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW20A</ccts:UniqueID>
                                                    <ccts:Definition>Details indicating the statisticatl goods about the goods weight, quantities, and amounts.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Goods Statistical Measure</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element minOccurs="0" name="tw_StatisticalUnitCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW027</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Statistical Measure. Statistical Unit. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Indication of the unit of measurement in which weight (mass), capacity, length, area, volume or other quantity is expressed, for tariff statistical purposes.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Statistical Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Statistical Unit</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>統計數量單位</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..3</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:GoodsStatisticalMeasureStatisticalUnitCodeType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="3"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_TariffQuantity">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>130*</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Statistical Measure. Tariff. Quantity</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity of the goods in the unit as required by Customs for tariff, statistical or fiscal purposes.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Statistical Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Tariff</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Quantity</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>統計數量</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..15,4</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:GoodsStatisticalMeasureTariffQuantityType">
                                                                    <xsd:pattern value="[0-9]{0,11}(\.[0-9]{1,4}){0,1}"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element minOccurs="0" name="Seller">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>09B</ccts:UniqueID>
                                        <ccts:Definition>Party selling merchandise to a buyer.</ccts:Definition>
                                        <ccts:Cardinality>0..1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="Name">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDR050</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Name [and address] of a party selling merchandise or services to a buyer.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(或賣方)英文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..80</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:SellerNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="80"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="tw_ChineseName">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW008</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Chinese Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Chinese name of party selling merchandise to a buyer.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Chinese Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(或賣方)中文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..70</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="twds:SellerChineseNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="70"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Address">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>04A</ccts:UniqueID>
                                                    <ccts:Definition>Details relating to an address.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element minOccurs="0" name="CountryCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID242</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Country. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Identification of the name of the country or other geographical entity as specified in ISO 3166 and UN/ECE Rec 3.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Country</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(或賣方)國家代碼</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>a2</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AddressCountryCodeType">
                                                                    <xsd:length value="2"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="Line">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID239</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Line. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Specification of the postal delivery point such as street and number or post office box.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Line</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(或賣方)英文地址</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..120</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AddressLineTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="120"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_ChineseLine">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW002</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Chinese Line. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Specification of the postal delivery point in Chinese such as street and number or post office box.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Chinese Line</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(或賣方)中文地址</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..100</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:AddressChineseLineTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="100"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element minOccurs="0" name="Importer">
                    <xsd:annotation>
                        <xsd:documentation xml:lang="en">
                            <ccts:UniqueID>74A</ccts:UniqueID>
                            <ccts:Definition>Party who makes -or on whose behalf a Customs clearing agent or other authorized person makes - an import declaration.</ccts:Definition>
                            <ccts:Cardinality>0..1</ccts:Cardinality>
                            <ccts:ObjectClassTerm>Importer</ccts:ObjectClassTerm>
                            <tsw:Remark/>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="ID">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>WCOIDR038</ccts:UniqueID>
                                        <ccts:DictionaryEntryName>Importer. Identification. Identifier</ccts:DictionaryEntryName>
                                        <ccts:Definition>Identifier of party who makes - or on whose behalf a Customs clearing agent or other authorised person makes - an import declaration. This may include a person who has possession of the goods or to whom the goods are consigned.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Importer</ccts:ObjectClassTerm>
                                        <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                        <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                        <tsw:ChineseName>進口人(納稅義務人)統一編號</tsw:ChineseName>
                                        <tsw:Remark/>
                                        <tsw:Format>an..14</tsw:Format>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:restriction base="ds:ImporterIdentificationIDType">
                                            <xsd:minLength value="0"/>
                                            <xsd:maxLength value="14"/>
                                        </xsd:restriction>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="Name">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>WCOIDR037</ccts:UniqueID>
                                        <ccts:DictionaryEntryName>Importer. Name. Text</ccts:DictionaryEntryName>
                                        <ccts:Definition>Name [and address] of party who makes-or on whose behalf a Customs clearing agent or other authorized person makes- an import declaration. This may include a person who has possession of the goods or to whom the goods are consigned.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Importer</ccts:ObjectClassTerm>
                                        <ccts:PropertyTerm>Name</ccts:PropertyTerm>
                                        <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                        <tsw:ChineseName>進口人(納稅義務人)英文名稱</tsw:ChineseName>
                                        <tsw:Remark/>
                                        <tsw:Format>an..80</tsw:Format>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:restriction base="ds:ImporterNameTextType">
                                            <xsd:minLength value="0"/>
                                            <xsd:maxLength value="80"/>
                                        </xsd:restriction>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="tw_ChineseName">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>TW001</ccts:UniqueID>
                                        <ccts:DictionaryEntryName>Importer. Chinese Name. Text</ccts:DictionaryEntryName>
                                        <ccts:Definition>Name  of the importer  ( duty payer) in Chinese.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Importer</ccts:ObjectClassTerm>
                                        <ccts:PropertyTerm>Chinese Name</ccts:PropertyTerm>
                                        <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                        <tsw:ChineseName>進口人(納稅義務人)中文名稱</tsw:ChineseName>
                                        <tsw:Remark/>
                                        <tsw:Format>an..70</tsw:Format>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:restriction base="twds:ImporterChineseNameTextType">
                                            <xsd:minLength value="0"/>
                                            <xsd:maxLength value="70"/>
                                        </xsd:restriction>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="tw_TypeCode">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>TW104</ccts:UniqueID>
                                        <ccts:DictionaryEntryName>Importer. Type. Code</ccts:DictionaryEntryName>
                                        <ccts:Definition>Code giving specific meaning to a party type, example passport number,identification number,BAN ID.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Importer</ccts:ObjectClassTerm>
                                        <ccts:PropertyTerm>Type</ccts:PropertyTerm>
                                        <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                        <tsw:ChineseName>身分識別代碼</tsw:ChineseName>
                                        <tsw:Remark/>
                                        <tsw:Format>an..3</tsw:Format>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:restriction base="twds:ImporterTypeCodeType">
                                            <xsd:minLength value="0"/>
                                            <xsd:maxLength value="3"/>
                                        </xsd:restriction>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="Address">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>04A</ccts:UniqueID>
