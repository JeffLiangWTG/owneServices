                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_UsedCapacityCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW030</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Transport Equipment. Used Capacity. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Indication whether containers and other similar unit load devices are empty or carry one or more consignments.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Transport Equipment</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Used Capacity</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>貨櫃裝運方式</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an1</tsw:Format>
