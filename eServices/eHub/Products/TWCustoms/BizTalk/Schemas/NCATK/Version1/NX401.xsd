                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:DepartureTransportMeansTypeCodeType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="4"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
