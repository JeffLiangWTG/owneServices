                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:TransportEquipmentUsedCapacityCodeType">
                                                                    <xsd:length value="1"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element maxOccurs="10" minOccurs="0" name="tw_Seal">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW24A</ccts:UniqueID>
                                                                <ccts:Definition>A device used to secure an object and protect from unauthorized entry or tampering such as a seal affixed to a piece of transport equipment.</ccts:Definition>
                                                                <ccts:Cardinality>0..10</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Seal</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="tw_SealID">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>165*</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Seal. Seal. Identifier</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>The identification number of a seal affixed to a piece of transport equipment.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Seal</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Seal</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>封條號碼</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..17</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="twds:SealSealIDType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="17"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="UnloadingLocation">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>38B</ccts:UniqueID>
                                                    <ccts:Definition>Place at which the goods (consignment) are unloaded from the active means of transport having been used for their carriage.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Unloading Location</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="ID">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOIDL013</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Unloading Location. Identification. Identifier</ccts:DictionaryEntryName>
                                                                <ccts:Definition>To identify a seaport, airport, freight terminal, rail station or other place at which goods are unloaded from the means of transport having been used for their carriage.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Unloading Location</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>目的地代碼</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an5</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:UnloadingLocationIdentificationIDType">
                                                                    <xsd:length value="5"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element minOccurs="0" name="Exporter">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>57A</ccts:UniqueID>
                                        <ccts:Definition>Person who makes or on whose behalf an export declaration is made.</ccts:Definition>
                                        <ccts:Cardinality>0..1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Exporter</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="ID">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDR032</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Exporter. Identification. Identifier</ccts:DictionaryEntryName>
                                                    <ccts:Definition>To identify the name and address of party who makes, or on whose behalf the export declaration is made, and who is the owner of the goods or has similar rights of disposal over them at the time when the declaration is accepted.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Exporter</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(貨物輸出人)統一編號</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..14</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:ExporterIdentificationIDType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="14"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Name">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDR031</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Exporter. Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Name [and address] of party who makes - or on whose behalf - the export declaration - is made - and who is the owner of the goods or has similar right of disposal over them at the time when the declaration is accepted.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Exporter</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(貨物輸出人)英文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..80</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:ExporterNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="80"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="tw_ChineseName">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW039</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Exporter. Chinese Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Name  of the  exporter in Chinese.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Exporter</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Chinese Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(貨物輸出人)中文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..70</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="twds:ExporterChineseNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="70"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="tw_TypeCode">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW104</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Exporter. Type. Code</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Code giving specific meaning to a party type, example passport number,identification number,BAN ID.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Exporter</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Type</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>身分識別代碼</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..3</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="twds:ExporterTypeCodeType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="3"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Address">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>04A</ccts:UniqueID>
                                                    <ccts:Definition>Details relating to an address.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="Line">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID239</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Line. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Specification of the postal delivery point such as street and number or post office box.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Line</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(貨物輸出人)英文地址</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..120</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AddressLineTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="120"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_ChineseLine">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW002</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Chinese Line. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Specification of the postal delivery point in Chinese such as street and number or post office box.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Chinese Line</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(貨物輸出人)中文地址</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..100</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:AddressChineseLineTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="100"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element maxOccurs="9999" name="GovernmentAgencyGoodsItem">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>68A</ccts:UniqueID>
                                        <ccts:Definition>Goods item as declared to Government Agency.</ccts:Definition>
                                        <ccts:Cardinality>1..9999</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Government Agency Goods Item</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="SequenceNumeric">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOID006</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Government Agency Goods Item. Sequence. Numeric</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Number indicating the position in a sequence.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Government Agency Goods Item</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Sequence</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Numeric</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>項次</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>n..4</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:simpleType>
                                                <xsd:restriction base="ds:GovernmentAgencyGoodsItemSequenceNumericType">
                                                    <xsd:minInclusive value="0"/>
                                                    <xsd:maxInclusive value="9999"/>
                                                </xsd:restriction>
                                            </xsd:simpleType>
                                        </xsd:element>
                                        <xsd:element name="AdditionalDocument">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>02A</ccts:UniqueID>
                                                    <ccts:Definition>Details related to additional documents supplied as part of a declaration or sought as part of a response.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Additional Document</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="tw_SequenceNumeric">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>006*</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Additional Document. Sequence. Numeric</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Number indicating the position in a sequence.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Additional Document</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Sequence</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Numeric</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>輸出入許可文件項次</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..4</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:simpleType>
                                                            <xsd:restriction base="twds:AdditionalDocumentSequenceNumericType">
                                                                <xsd:minInclusive value="0"/>
                                                                <xsd:maxInclusive value="9999"/>
                                                            </xsd:restriction>
                                                        </xsd:simpleType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element maxOccurs="10" minOccurs="0" name="AdditionalInformation">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>03A</ccts:UniqueID>
                                                    <ccts:Definition>Special request to government from Declarant to take or not to take action.</ccts:Definition>
                                                    <ccts:Cardinality>0..10</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Additional Information</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="StatementCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID226</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Additional Information. Statement. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Coded form of an additional statement.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Additional Information</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Statement</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>*備註類別代碼</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an1</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AdditionalInformationStatementCodeType">
                                                                    <xsd:length value="1"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="StatementDescription">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID225</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Additional Information. Statement Description. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Description of an additional statement.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Additional Information</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Statement Description</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>備用欄位</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..35</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AdditionalInformationStatementDescriptionTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="35"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Commodity">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>23A</ccts:UniqueID>
                                                    <ccts:Definition>Details about the properties of the goods.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Commodity</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="Description">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
