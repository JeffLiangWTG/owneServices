<xsd:schema targetNamespace="urn:BOFT:FundamentalTypes:1.0" xmlns:ft="urn:BOFT:FundamentalTypes:1.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<!-- ===== FT: FundamentalCodeType (FT0010)===== 
		FT: CodeType (FT0011)
		FT: DoubleCodeType (FT0012)
