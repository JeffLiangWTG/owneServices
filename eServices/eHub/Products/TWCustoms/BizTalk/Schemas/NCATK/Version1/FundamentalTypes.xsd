	<!-- ===== FT: FundamentalCodeType (FT0010)===== 
	===== ===== ===== ===== ===== ===== ===== =====-->
	<xsd:simpleType name="FundamentalCodeType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: CodeType (FT0011)===== -->
	<xsd:simpleType name="CodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:maxLength value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: DoubleCodeType (FT0012)===== -->
	<xsd:simpleType name="DoubleCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:maxLength value="4"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: ApplicationTypeCodeType (FT0013)===== -->
	<xsd:simpleType name="ApplicationTypeCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:maxLength value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: DocumentTypeCodeType (FT0014)===== -->
	<xsd:simpleType name="DocumentTypeCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:maxLength value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: GlobalCountryCodeType (FT0015)===== -->
	<xsd:simpleType name="GlobalCountryCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:length value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: GlobalCurrencyCodeType (FT0016)===== -->
	<xsd:simpleType name="GlobalCurrencyCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:length value="3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: GlobalLocationCodeType (FT0017)===== -->
	<xsd:simpleType name="GlobalLocationCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:length value="5"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: GlobalUnitCodeType (FT0018)===== -->
	<xsd:simpleType name="GlobalUnitCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:length value="3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: ResponseCodeType (FT0019)===== -->
	<xsd:simpleType name="ResponseCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:maxLength value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: cccCodeType (FT0100)===== -->
	<xsd:simpleType name="cccCodeType">
		<xsd:restriction base="xsd:integer"/>
	</xsd:simpleType>
	<!--===== FT: cccCodeExtType (FT0101)===== -->
	<xsd:simpleType name="cccCodeExtType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:length value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: AuthorityCodeType (FT0102)===== -->
	<xsd:simpleType name="AuthorityCodeType">
		<xsd:restriction base="ft:FundamentalCodeType">
			<xsd:maxLength value="8"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FundamentalIdentifierType (FT0020)=====
	 ===== ===== ===== ===== ===== ===== ===== ===== =====-->
	<xsd:simpleType name="FundamentalIdentifierType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: IdentifierType (FT0021)===== -->
	<xsd:simpleType name="IdentifierType">
		<xsd:restriction base="ft:FundamentalIdentifierType">
			<xsd:maxLength value="35"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: BusinessIdentifierType (FT0022)===== -->
	<xsd:simpleType name="BusinessIdentifierType">
		<xsd:restriction base="ft:FundamentalIdentifierType">
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: DocumentMessageIdentifierType (FT0023)===== -->
	<xsd:simpleType name="DocumentMessageIdentifierType">
		<xsd:restriction base="ft:FundamentalIdentifierType">
			<xsd:maxLength value="35"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FundamentalNameType (FT0030)===== 
		 ===== ===== ===== ===== ===== ===== ===== ===== =====-->
	<xsd:simpleType name="FundamentalNameType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: NameType (FT0031)===== -->
	<xsd:simpleType name="NameType">
		<xsd:restriction base="ft:FundamentalNameType">
			<xsd:maxLength value="120"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: BusinessNameType (FT0032)===== -->
	<xsd:simpleType name="BusinessNameType">
		<xsd:restriction base="ft:FundamentalNameType">
			<xsd:maxLength value="120"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: ProductNameType (FT0033)===== -->
	<xsd:simpleType name="ProductNameType">
		<xsd:restriction base="ft:FundamentalNameType">
			<xsd:maxLength value="390"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FundamentalQuantityType (FT0040)===== 
  ===== ===== ===== ===== ===== ===== ===== ===== =====-->
	<xsd:simpleType name="FundamentalQuantityType">
		<xsd:restriction base="xsd:decimal"/>
	</xsd:simpleType>
	<!-- ===== FT: QuantityType (FT0041)===== -->
	<xsd:simpleType name="QuantityType">
		<xsd:restriction base="ft:FundamentalQuantityType">
			<xsd:totalDigits value="16"/>
			<xsd:fractionDigits value="4"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: WeightType (FT0042)===== -->
	<xsd:simpleType name="WeightType">
		<xsd:restriction base="ft:FundamentalQuantityType">
			<xsd:totalDigits value="16"/>
			<xsd:fractionDigits value="4"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: MonetaryAmountType (FT0043)===== -->
	<xsd:simpleType name="MonetaryAmountType">
		<xsd:restriction base="ft:FundamentalQuantityType">
			<xsd:totalDigits value="16"/>
			<xsd:fractionDigits value="4"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: CurrencyRateType (FT0044)===== -->
	<xsd:simpleType name="CurrencyRateType">
		<xsd:restriction base="ft:FundamentalQuantityType">
			<xsd:totalDigits value="16"/>
			<xsd:fractionDigits value="5"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FundamentalNumberType (FT0050)===== 
		 ===== ===== ===== ===== ===== ===== ===== ===== =====-->
	<xsd:simpleType name="FundamentalNumberType">
		<xsd:restriction base="xsd:nonNegativeInteger"/>
	</xsd:simpleType>
	<!-- ===== FT: ItemNumberType (FT0051)===== -->
	<xsd:simpleType name="ItemNumberType">
		<xsd:restriction base="ft:FundamentalNumberType">
			<xsd:totalDigits value="4"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: IntegerQuantityType (FT0052)===== -->
	<xsd:simpleType name="IntegerQuantityType">
		<xsd:restriction base="ft:FundamentalNumberType">
			<xsd:totalDigits value="6"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: GoodsDeclarationNumberType (FT0060)===== -->
	<xsd:simpleType name="GoodsDeclarationNumberType">
		<xsd:restriction base="xsd:string">
			<xsd:length value="14"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--===== FT: CommunicationNumberType (FT0070)===== -->
	<xsd:simpleType name="CommunicationNumberType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FundamentalFreeFormTextType (FT0080)===== 
	 ===== ===== ===== ===== ===== ===== ===== ===== ===== =====-->
	<xsd:simpleType name="FundamentalFreeFormTextType">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FreeFormTextType (FT0081)===== -->
	<xsd:simpleType name="FreeFormTextType">
		<xsd:restriction base="ft:FundamentalFreeFormTextType">
			<xsd:maxLength value="999"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: AddressType (FT0082)===== -->
	<xsd:simpleType name="AddressType">
		<xsd:restriction base="ft:FundamentalFreeFormTextType">
			<xsd:maxLength value="120"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ===== FT: FreeFormTextType (FT0083)===== -->
	<xsd:simpleType name="UnlimitedTextType">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<!-- ===== FT: IndicatorType (FT0090)===== -->
	<xsd:simpleType name="IndicatorType">
		<xsd:restriction base="xsd:string">
			<xsd:length value="1"/>
			<!-- <xsd:enumeration value="Y"/>
			<xsd:enumeration value="N"/> -->
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="ENTER_NAME_OF_ROOT_ELEMENT_HERE">
		<xsd:annotation>
			<xsd:documentation>Comment describing your root element</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
</xsd:schema>
