                                                                                <xsd:length value="11"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="Constituent">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>33A</ccts:UniqueID>
                                                                <ccts:Definition>Identifies the element or component element in a commodity including description, percentage, quantity, name, active ingredient and yield amount.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="ElementDescription">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID259</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Constituent. Element Description. Text</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Additional textual description of the materials contained within the product.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Element Description</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>成分及規格</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..256</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:ConstituentElementDescriptionTextType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="256"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="InvoiceLine">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>79A</ccts:UniqueID>
                                                                <ccts:Definition>Information relating to the line item of an invoice.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="tw_ChargesTypeCode">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>371*</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice Line. Charges Type. Code</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Code to indicate applicable incoterm under which seller undertakes to deliver merchandise to buyer e.g. FOB or CFR or CIF.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Charges Type</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>單價條件</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an3</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="twds:InvoiceLineChargesTypeCodeType">
                                                                                <xsd:length value="3"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                                <xsd:element name="tw_CurrencyTypeCode">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>135*</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice Line. Currency Type. Code</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Code specifying a monetary unit or currency.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Currency Type</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>幣別代碼</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>a3</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="twds:InvoiceLineCurrencyTypeCodeType">
                                                                                <xsd:length value="3"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                                <xsd:element minOccurs="0" name="tw_UnitPriceAmount">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>TW025</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice Line. Unit Price. Amount</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Value per unit  declared for Customs purposes of those goods in a consignment.</ccts:Definition>
                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Unit Price</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Amount</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>單價金額</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>n..18,6</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="twds:InvoiceLineUnitPriceAmountType">
                                                                                <xsd:pattern value="[0-9]{0,12}(\.[0-9]{1,6}){0,1}"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                                <xsd:element name="tw_SubTotalAmount">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>TW134</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice Line. Sub Total. Amount</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Sub total amount of goods item.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Sub Total</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Amount</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>金額小計</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>n..18,6</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="twds:InvoiceLineSubTotalAmountType">
                                                                                <xsd:pattern value="[0-9]{0,12}(\.[0-9]{1,6}){0,1}"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="GoodsMeasure">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>65A</ccts:UniqueID>
                                                    <ccts:Definition>Details about the goods weight, quantities, and amounts.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="TariffQuantity">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID130</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Tariff. Quantity</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity of the goods in the unit as required by Customs for tariff, statistical or fiscal purposes.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Tariff</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Quantity</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>數量</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..15,4</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:GoodsMeasureTariffQuantityType">
                                                                    <xsd:pattern value="[0-9]{0,11}(\.[0-9]{1,4}){0,1}"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="tw_UnitCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW026</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Unit. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity unit of the goods.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Unit</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>數量單位</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..3</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:GoodsMeasureUnitCodeType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="3"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="Origin">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>92A</ccts:UniqueID>
                                                    <ccts:Definition>Details about the origin of the goods.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Origin</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="CountryCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID063</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Origin. Country. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>To identify the country in which the goods have been produced or manufactured, according to criteria laid down for the application of the Customs tariff or quantitative restrictions, or any measure related to trade.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Origin</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Country</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>生產國別代碼</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>a2</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:OriginCountryCodeType">
                                                                    <xsd:length value="2"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element minOccurs="0" name="Seller">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>09B</ccts:UniqueID>
                                        <ccts:Definition>Party selling merchandise to a buyer.</ccts:Definition>
                                        <ccts:Cardinality>0..1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="Name">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDR050</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Name [and address] of a party selling merchandise or services to a buyer.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(或賣方)英文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..80</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:SellerNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="80"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Address">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>04A</ccts:UniqueID>
                                                    <ccts:Definition>Details relating to an address.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="CountryCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID242</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Country. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Identification of the name of the country or other geographical entity as specified in ISO 3166 and UN/ECE Rec 3.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Country</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(或賣方)國家代碼</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>a2</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AddressCountryCodeType">
                                                                    <xsd:length value="2"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="Line">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID239</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Address. Line. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Specification of the postal delivery point such as street and number or post office box.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Address</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Line</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>出口人(或賣方)英文地址</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..120</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:AddressLineTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="120"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element minOccurs="0" name="tw_AdditionalDeclaration">
                    <xsd:annotation>
                        <xsd:documentation xml:lang="en">
                            <ccts:UniqueID>TW12A</ccts:UniqueID>
                            <ccts:Definition>Any additional statement or action about the declaration to government.</ccts:Definition>
                            <ccts:Cardinality>0..1</ccts:Cardinality>
                            <ccts:ObjectClassTerm>Additional Declaration</ccts:ObjectClassTerm>
                            <tsw:Remark/>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="tw_ID">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>D014*</ccts:UniqueID>
                                        <ccts:DictionaryEntryName>Additional Declaration. Identification. Identifier</ccts:DictionaryEntryName>
                                        <ccts:Definition>Reference number identifying a specific document.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Additional Declaration</ccts:ObjectClassTerm>
                                        <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                        <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                        <tsw:ChineseName>會辦識別碼</tsw:ChineseName>
                                        <tsw:Remark/>
                                        <tsw:Format>an19</tsw:Format>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:restriction base="twds:AdditionalDeclarationIdentificationIDType">
                                            <xsd:length value="19"/>
                                        </xsd:restriction>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="tw_Application">
                    <xsd:annotation>
                        <xsd:documentation xml:lang="en">
                            <ccts:UniqueID>TW41A</ccts:UniqueID>
                            <ccts:Definition>Details about the application information including special request, sample return, payment method, etc.</ccts:Definition>
                            <ccts:Cardinality>1</ccts:Cardinality>
                            <ccts:ObjectClassTerm>Application</ccts:ObjectClassTerm>
                            <tsw:Remark/>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="tw_TypeCode">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>TW106</ccts:UniqueID>
                                        <ccts:DictionaryEntryName>Application. Type. Code</ccts:DictionaryEntryName>
                                        <ccts:Definition>Type of application.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Application</ccts:ObjectClassTerm>
                                        <ccts:PropertyTerm>Type</ccts:PropertyTerm>
                                        <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                        <tsw:ChineseName>申請業務別</tsw:ChineseName>
                                        <tsw:Remark/>
                                        <tsw:Format>an..3</tsw:Format>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:simpleContent>
                                        <xsd:restriction base="twds:ApplicationTypeCodeType">
                                            <xsd:minLength value="0"/>
                                            <xsd:maxLength value="3"/>
                                        </xsd:restriction>
                                    </xsd:simpleContent>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element maxOccurs="10" minOccurs="0" name="AdditionalDocument">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>02A+</ccts:UniqueID>
                                        <ccts:Definition>Details related to additional documents supplied as part of a declaration or sought as part of a response.</ccts:Definition>
                                        <ccts:Cardinality>0..10</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Additional Document</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element minOccurs="0" name="ID">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDD005</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Additional Document. Identification. Identifier</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Identifier of a document providing additional information.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Additional Document</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>檢核文件字號</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..50</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:AdditionalDocumentIdentificationIDType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="50"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="tw_ImageFileFormat">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW101</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Additional Document. Image File Format. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Image File Format Type.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Additional Document</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Image File Format</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
