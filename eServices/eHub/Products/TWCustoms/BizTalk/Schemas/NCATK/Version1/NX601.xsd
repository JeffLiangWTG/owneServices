                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="AdValoremTaxBaseAmount">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID116</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Duty Tax Fee. AdValorem Tax Base. Amount</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>To specify the amount on which a duty or tax or fee will be assessed.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Duty Tax Fee</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>AdValorem Tax Base</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Amount</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>完稅價格</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>n..14</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:DutyTaxFeeAdValoremTaxBaseAmountType">
                                                                                <xsd:minInclusive value="0"/>
                                                                                <xsd:maxInclusive value="99999999999999"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element maxOccurs="9" name="Handling">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>73A+</ccts:UniqueID>
                                                                <ccts:Definition>Details of handling and special handling of a consignment and/or delivery.</ccts:Definition>
                                                                <ccts:Cardinality>1..9</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Handling</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="InstructionsCode">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID093</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Handling. Instructions. Code</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>To indicate directions for handling a consignment and/or delivery for a shipment.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Handling</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Instructions</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>儲運條件代碼</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an1</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:HandlingInstructionsCodeType">
                                                                                <xsd:length value="1"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_Food">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW09A</ccts:UniqueID>
                                                                <ccts:Definition>Details about food information.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Food</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element minOccurs="0" name="tw_PHValueNumeric">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>TW098</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Food. PH Value. Numeric</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>The finished equilibrium pH value of goods.</ccts:Definition>
                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Food</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>PH Value</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Numeric</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>最終產品pH值</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>n..2,1</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:simpleType>
                                                                        <xsd:restriction base="twds:FoodPHValueNumericType">
                                                                            <xsd:pattern value="[0-9]{0,1}(\.[0-9]{1,1}){0,1}"/>
                                                                        </xsd:restriction>
                                                                    </xsd:simpleType>
                                                                </xsd:element>
                                                                <xsd:element minOccurs="0" name="tw_SterilizationValueNumeric">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>TW099</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Food. Sterilization Value. Numeric</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Standard Sterilization Value (F0) of goods.</ccts:Definition>
                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Food</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Sterilization Value</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Numeric</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>產品殺菌值</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>n..2,1</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:simpleType>
                                                                        <xsd:restriction base="twds:FoodSterilizationValueNumericType">
                                                                            <xsd:pattern value="[0-9]{0,1}(\.[0-9]{1,1}){0,1}"/>
                                                                        </xsd:restriction>
                                                                    </xsd:simpleType>
                                                                </xsd:element>
                                                                <xsd:element maxOccurs="99" minOccurs="0" name="Constituent">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>33A+</ccts:UniqueID>
                                                                            <ccts:Definition>Identifies the element or component element in a commodity including description, percentage, quantity, name, active ingredient and yield amount.</ccts:Definition>
                                                                            <ccts:Cardinality>0..99</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                            <tsw:Remark/>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:sequence>
                                                                            <xsd:element name="ElementName">
                                                                                <xsd:annotation>
                                                                                    <xsd:documentation xml:lang="en">
                                                                                        <ccts:UniqueID>WCOID348</ccts:UniqueID>
                                                                                        <ccts:DictionaryEntryName>Constituent. Element Name. Text</ccts:DictionaryEntryName>
                                                                                        <ccts:Definition>The name of the specified material within the product, e.g. asbestos or milk solids.</ccts:Definition>
                                                                                        <ccts:Cardinality>1</ccts:Cardinality>
                                                                                        <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                                        <ccts:PropertyTerm>Element Name</ccts:PropertyTerm>
                                                                                        <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                                        <tsw:ChineseName>成分名稱</tsw:ChineseName>
                                                                                        <tsw:Remark/>
                                                                                        <tsw:Format>an..100</tsw:Format>
                                                                                    </xsd:documentation>
                                                                                </xsd:annotation>
                                                                                <xsd:complexType>
                                                                                    <xsd:simpleContent>
                                                                                        <xsd:restriction base="ds:ConstituentElementNameTextType">
                                                                                            <xsd:minLength value="0"/>
                                                                                            <xsd:maxLength value="100"/>
                                                                                        </xsd:restriction>
                                                                                    </xsd:simpleContent>
                                                                                </xsd:complexType>
                                                                            </xsd:element>
                                                                            <xsd:element minOccurs="0" name="ElementPercentNumeric">
                                                                                <xsd:annotation>
                                                                                    <xsd:documentation xml:lang="en">
                                                                                        <ccts:UniqueID>WCOID311</ccts:UniqueID>
                                                                                        <ccts:DictionaryEntryName>Constituent. Element Percent. Numeric</ccts:DictionaryEntryName>
                                                                                        <ccts:Definition>The percentage of a specified material contained within the product.</ccts:Definition>
                                                                                        <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                                        <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                                        <ccts:PropertyTerm>Element Percent</ccts:PropertyTerm>
                                                                                        <ccts:RepresentationTerm>Numeric</ccts:RepresentationTerm>
                                                                                        <tsw:ChineseName>含量</tsw:ChineseName>
                                                                                        <tsw:Remark/>
                                                                                        <tsw:Format>n..14,4</tsw:Format>
                                                                                    </xsd:documentation>
                                                                                </xsd:annotation>
                                                                                <xsd:simpleType>
                                                                                    <xsd:restriction base="ds:ConstituentElementPercentNumericType">
                                                                                        <xsd:pattern value="[0-9]{0,10}(\.[0-9]{1,4}){0,1}"/>
                                                                                    </xsd:restriction>
                                                                                </xsd:simpleType>
                                                                            </xsd:element>
                                                                        </xsd:sequence>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="GoodsMeasure">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>65A</ccts:UniqueID>
                                                    <ccts:Definition>Details about the goods weight, quantities, and amounts.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="NetWeightMeasure">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID128</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Net Weight. Measure</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Weight (mass) of the goods themselves without any packing.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Net Weight</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Measure</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>淨重</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..16,6</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:GoodsMeasureNetWeightMeasureType">
                                                                    <xsd:pattern value="[0-9]{0,10}(\.[0-9]{1,6}){0,1}"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="TariffQuantity">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID130</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Tariff. Quantity</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity of the goods in the unit as required by Customs for tariff, statistical or fiscal purposes.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Tariff</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Quantity</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>數量</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..15,4</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:GoodsMeasureTariffQuantityType">
                                                                    <xsd:pattern value="[0-9]{0,11}(\.[0-9]{1,4}){0,1}"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="tw_UnitCode">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW026</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Goods Measure. Unit. Code</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Quantity unit of the goods.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Unit</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>數量單位</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..3</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:GoodsMeasureUnitCodeType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="3"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element maxOccurs="99" minOccurs="0" name="tw_ShippingIdentification">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW13A</ccts:UniqueID>
                                                    <ccts:Definition>Information about goods lot number, manufactured date and expiration date, etc.</ccts:Definition>
                                                    <ccts:Cardinality>0..99</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Shipping Identification</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element minOccurs="0" name="tw_LotNumberID">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>265*</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Shipping Identification. Lot Number. Identifier</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Identification number of a production lot.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Shipping Identification</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Lot Number</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>製造批號</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..150</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:ShippingIdentificationLotNumberIDType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="150"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_ProductBestBeforeDateTime" type="twds:ShippingIdentificationProductBestBeforeDateTimeType">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>266*</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Shipping Identification. Product Best Before. Date Time</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Indication that freshness of goods is limited in time to the date shown.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Shipping Identification</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Product Best Before</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Date Time</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>有效日期</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an8</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                    </xsd:element>
                                                    <xsd:element minOccurs="0" name="tw_ProductManufacturedDate" type="twds:ShippingIdentificationProductManufacturedDateType">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>TW057</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Shipping Identification. Product Manufactured. Date</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Product Manufactured Date.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Shipping Identification</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Product Manufactured</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Date</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>製造日期</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an8</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="Seller">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>09B</ccts:UniqueID>
                                        <ccts:Definition>Party selling merchandise to a buyer.</ccts:Definition>
                                        <ccts:Cardinality>1</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element minOccurs="0" name="ID">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDR051</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Identification. Identifier</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Identifier of the party selling merchandise or services to a buyer.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(或賣方)統一編號或國外廠商英文名稱縮寫</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..14</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:SellerIdentificationIDType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="14"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Name">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>WCOIDR050</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Name [and address] of a party selling merchandise or services to a buyer.</ccts:Definition>
                                                    <ccts:Cardinality>1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(或賣方)英文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..80</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="ds:SellerNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="80"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="tw_ChineseName">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW008</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Chinese Name. Text</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Chinese name of party selling merchandise to a buyer.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Chinese Name</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>出口人(或賣方)中文名稱</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..70</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="twds:SellerChineseNameTextType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="70"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element minOccurs="0" name="tw_TypeCode">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW104</ccts:UniqueID>
                                                    <ccts:DictionaryEntryName>Seller. Type. Code</ccts:DictionaryEntryName>
                                                    <ccts:Definition>Code giving specific meaning to a party type, example passport number,identification number,BAN ID.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Seller</ccts:ObjectClassTerm>
                                                    <ccts:PropertyTerm>Type</ccts:PropertyTerm>
                                                    <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                    <tsw:ChineseName>身分識別代碼</tsw:ChineseName>
                                                    <tsw:Remark/>
                                                    <tsw:Format>an..3</tsw:Format>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:restriction base="twds:SellerTypeCodeType">
                                                        <xsd:minLength value="0"/>
                                                        <xsd:maxLength value="3"/>
                                                    </xsd:restriction>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Address">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>04A</ccts:UniqueID>
                                                    <ccts:Definition>Details relating to an address.</ccts:Definition>
