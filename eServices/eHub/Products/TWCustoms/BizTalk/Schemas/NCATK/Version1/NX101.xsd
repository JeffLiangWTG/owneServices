                                                                            <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Element Description</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>成分及規格</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..256</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:ConstituentElementDescriptionTextType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="256"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="Invoice" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>78A+</ccts:UniqueID>
                                                                <ccts:Definition>Information of a commercial invoice.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Invoice</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="ID" minOccurs="0">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOIDD016</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice. Identification. Identifier</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Reference number to identify an invoice.</ccts:Definition>
                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>發票編號</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..35</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:InvoiceIdentificationIDType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="35"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                                <xsd:element name="IssueDateTime" type="ds:InvoiceIssueDateTimeType" minOccurs="0">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOIDD015</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice. Issue. Date Time</ccts:DictionaryEntryName>
