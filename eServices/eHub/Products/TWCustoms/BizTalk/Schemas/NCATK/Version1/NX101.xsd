                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Issue</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Date Time</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>發票日期</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an8</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="InvoiceLine" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>79A</ccts:UniqueID>
                                                                <ccts:Definition>Information relating to the line item of an invoice.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="ItemChargeAmount" minOccurs="0">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID112</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice Line. Item Charge. Amount</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Amount due for each chargeable item of goods or services.</ccts:Definition>
                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Item Charge</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Amount</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>發票價格</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>n..18,4</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:InvoiceLineItemChargeAmountType">
                                                                                <xsd:pattern value="[0-9]{0,14}(\.[0-9]{1,4}){0,1}"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                                <xsd:element name="tw_CurrencyTypeCode" minOccurs="0">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>135*</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Invoice Line. Currency Type. Code</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>Code specifying a monetary unit or currency.</ccts:Definition>
                                                                            <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Invoice Line</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Currency Type</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>發票幣別</tsw:ChineseName>
                                                                            <tsw:Remark/>
