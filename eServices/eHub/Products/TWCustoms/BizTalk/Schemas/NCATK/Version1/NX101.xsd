                                                                            <ccts:ObjectClassTerm>Commodity Related Packaging</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Specification</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>包裝件數及種類</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..240</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="twds:CommodityRelatedPackagingSpecificationTextType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="240"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="Constituent" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>33A</ccts:UniqueID>
                                                                <ccts:Definition>Identifies the element or component element in a commodity including description, percentage, quantity, name, active ingredient and yield amount.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Constituent</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="ElementDescription">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID259</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Constituent. Element Description. Text</ccts:DictionaryEntryName>
