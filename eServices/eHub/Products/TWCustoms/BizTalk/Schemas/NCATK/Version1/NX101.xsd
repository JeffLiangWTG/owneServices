                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>65A</ccts:UniqueID>
                                        <ccts:Definition>Details about the goods weight, quantities, and amounts.</ccts:Definition>
                                        <ccts:Cardinality>0..9999</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Goods Measure</ccts:ObjectClassTerm>
