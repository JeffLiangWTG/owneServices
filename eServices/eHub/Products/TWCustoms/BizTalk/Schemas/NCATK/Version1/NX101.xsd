                                                                <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>製造廠商統一編號</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..14</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:ManufacturerIdentificationIDType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="14"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Packaging" minOccurs="0">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>93A</ccts:UniqueID>
                                                    <ccts:Definition>Details related to packaging.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Packaging</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="MarksNumbers">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>WCOID142</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Packaging. Marks Numbers. Text</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Free form description of the marks and numbers on a transport unit or package.</ccts:Definition>
                                                                <ccts:Cardinality>1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Packaging</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Marks Numbers</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Text</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>標記</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an..512</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="ds:PackagingMarksNumbersTextType">
                                                                    <xsd:minLength value="0"/>
                                                                    <xsd:maxLength value="512"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="tw_AdditionalDeclaration" minOccurs="0">
                                            <xsd:annotation>
                                                <xsd:documentation xml:lang="en">
                                                    <ccts:UniqueID>TW12A</ccts:UniqueID>
                                                    <ccts:Definition>Any additional statement or action about the declaration to government.</ccts:Definition>
                                                    <ccts:Cardinality>0..1</ccts:Cardinality>
                                                    <ccts:ObjectClassTerm>Additional Declaration</ccts:ObjectClassTerm>
                                                    <tsw:Remark/>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="tw_ID" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>D014*</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Additional Declaration. Identification. Identifier</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Reference number identifying a specific document.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Additional Declaration</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>報單號碼(ECFA)</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>an14</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:restriction base="twds:AdditionalDeclarationIdentificationIDType">
                                                                    <xsd:length value="14"/>
                                                                </xsd:restriction>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="tw_SequenceNumeric" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>006*</ccts:UniqueID>
                                                                <ccts:DictionaryEntryName>Additional Declaration. Sequence. Numeric</ccts:DictionaryEntryName>
                                                                <ccts:Definition>Number indicating the position in a sequence.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Additional Declaration</ccts:ObjectClassTerm>
                                                                <ccts:PropertyTerm>Sequence</ccts:PropertyTerm>
                                                                <ccts:RepresentationTerm>Numeric</ccts:RepresentationTerm>
                                                                <tsw:ChineseName>報單項次(ECFA)</tsw:ChineseName>
                                                                <tsw:Remark/>
                                                                <tsw:Format>n..4</tsw:Format>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:simpleType>
                                                            <xsd:restriction base="twds:AdditionalDeclarationSequenceNumericType">
                                                                <xsd:minInclusive value="0"/>
                                                                <xsd:maxInclusive value="9999"/>
                                                            </xsd:restriction>
                                                        </xsd:simpleType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="tw_AdditionalDeclaration" minOccurs="0" maxOccurs="9999">
                                <xsd:annotation>
                                    <xsd:documentation xml:lang="en">
                                        <ccts:UniqueID>TW12A</ccts:UniqueID>
                                        <ccts:Definition>Any additional statement or action about the declaration to government.</ccts:Definition>
                                        <ccts:Cardinality>0.9999</ccts:Cardinality>
                                        <ccts:ObjectClassTerm>Additional Declaration</ccts:ObjectClassTerm>
                                        <tsw:Remark/>
                                    </xsd:documentation>
