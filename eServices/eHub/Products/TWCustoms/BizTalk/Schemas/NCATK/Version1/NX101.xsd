                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="ID">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID145</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Classification. Identification. Identifier</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>The non-commercial categorization of a commodity by a standard-setting organization.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Classification</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Identification</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Identifier</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>貨品分類號列;進口國貨品分類號列</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..11</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:ClassificationIdentificationIDType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="11"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                                <xsd:element name="IdentificationTypeCode">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>WCOID337</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Classification. Identification Type. Code</ccts:DictionaryEntryName>
                                                                            <ccts:Definition>A qualifier to describe the commodity classification, e.g. Harmonized Tariff Schedule (HTS), Export Control Classification Code (ECCC), UNDG Code list, International Code of.</ccts:Definition>
                                                                            <ccts:Cardinality>1</ccts:Cardinality>
                                                                            <ccts:ObjectClassTerm>Classification</ccts:ObjectClassTerm>
                                                                            <ccts:PropertyTerm>Identification Type</ccts:PropertyTerm>
                                                                            <ccts:RepresentationTerm>Code</ccts:RepresentationTerm>
                                                                            <tsw:ChineseName>*貨品分類號類別代碼</tsw:ChineseName>
                                                                            <tsw:Remark/>
                                                                            <tsw:Format>an..3</tsw:Format>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:restriction base="ds:ClassificationIdentificationTypeCodeType">
                                                                                <xsd:minLength value="0"/>
                                                                                <xsd:maxLength value="3"/>
                                                                            </xsd:restriction>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="CommodityRelatedPackaging" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation xml:lang="en">
                                                                <ccts:UniqueID>24A</ccts:UniqueID>
                                                                <ccts:Definition>Details of packaging including packing material, size, dimension, hierarchy, certification and marking.</ccts:Definition>
                                                                <ccts:Cardinality>0..1</ccts:Cardinality>
                                                                <ccts:ObjectClassTerm>Commodity Related Packaging</ccts:ObjectClassTerm>
                                                                <tsw:Remark/>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="tw_Specification">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation xml:lang="en">
                                                                            <ccts:UniqueID>TW110</ccts:UniqueID>
                                                                            <ccts:DictionaryEntryName>Commodity Related Packaging. Specification. Text</ccts:DictionaryEntryName>
