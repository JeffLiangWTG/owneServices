            Logger.Log.InfoFormat("{0}Starting triggering retrieve process )", LogPrefix);
            
            mailboxId = TriggerMessage.StaffAndMailbox;
            
            if(mailboxId.Contains("|"))
            {
                staffId = mailboxId.Substring(0, mailboxId.IndexOf("|")); 
                mailboxId = mailboxId.Substring(mailboxId.IndexOf("|") + 1);
            }
            
            
