    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service ReceiveMessage
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses InsertInboxXml_PortType TWC_InsertIntoInboxWCF;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements ReceiveMessage_PortType TWC_RcvMessagesTriggerPort;
        message System.Xml.XmlDocument TWCustomsReponseMessage;
        message System.Xml.XmlDocument eHubInboxMessage;
        CargoWise.eHub.Core.Logging.OrchestrationLogger Logger;
        System.String LogPrefix;
        System.String messageTrackingID;
        System.String senderID;
        System.String recipientID;
        System.String messageBody;
        System.String sqlXmlString;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2fd5b657-095f-4138-ab5c-d4852edf31d7")]
            activate receive (TWC_RcvMessagesTriggerPort.ReceiveMessageXMLContent, TWCustomsReponseMessage);
            Logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            LogPrefix = "";
            messageTrackingID = "";
            senderID = "";
            recipientID = "";
            messageBody = "";
            sqlXmlString = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("0cbe2f34-49c0-43bb-845e-4007d682382a")]
            senderID = xpath(TWCustomsReponseMessage, "string(/*[local-name()='TWCustomsResponse']/*[local-name()='Header']/*[local-name()='Sender'])");
            recipientID = xpath(TWCustomsReponseMessage,"string(/*[local-name()='TWCustomsResponse']/*[local-name()='Header']/*[local-name()='Recipient'])");
            messageTrackingID = System.String.Format ("{0}", System.Guid.NewGuid ());
            LogPrefix =  System.String.Format ("({0})",messageTrackingID);
            Logger.Log.InfoFormat("{0}Starting triggering retrieve process with generated tracking id '{1}')", LogPrefix, messageTrackingID);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("621c3f1d-3153-4160-96d9-dff216c1b03a")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("03f016b5-79cc-44cb-b6ae-d651945ba91e")]
                    construct eHubInboxMessage
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("55a2b050-8dbd-4252-b5fd-952b4a9b8d16")]
                        messageBody = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(TWCustomsReponseMessage);
                        sqlXmlString = CargoWise.eHub.Products.TWCustoms.Orchestrations.Helpers.OrchestrationHelper.GetWcfInsertInboxOutboxQueries(senderID, recipientID, messageTrackingID, messageBody);
                        eHubInboxMessage = new System.Xml.XmlDocument();
                        eHubInboxMessage.LoadXml(sqlXmlString);
                        eHubInboxMessage(WCF.Action) = "CompositeOperation";
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("b0306ee1-b599-4227-a1e2-655d3bc7adbf")]
                    Logger.Log.InfoFormat("{0}(Sender '{1}'): Added new inbox message(TrackingID: '{2}')", LogPrefix, senderID, messageTrackingID);
                    Logger.Log.DebugFormat("{0}Message successfully received", LogPrefix);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("7aed48d8-f293-43f2-89f0-4bed4073622a")]
                    send (TWC_InsertIntoInboxWCF.InsertInboxXMLContent, eHubInboxMessage);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("64b2b9e4-d639-4f29-bc3f-114fe88ca6a3")]
                    Logger.Log.InfoFormat("{0}Complete process with tracking ID '{1}'", LogPrefix, messageTrackingID);
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ff6e3d4f-eaf6-4bae-a61f-cb7597e2194b")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("d5b394b6-feb6-4d8d-bd36-5179aa2b7c62")]
                        Logger.Log.ErrorFormat("{0}Error sending TWCUstoms message with tracking ID '{1}'\r\n{2}", LogPrefix, messageTrackingID, ex.ToString());
                    }
