                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("75501f38-455b-4408-8ad0-fcb969eef5e9")]
                                exit = true;
                                logger.Log.ErrorFormat("Plugin Returns a credential error with ErrorCode {0}, Error Type {1}", errorCode, errorType);
                                CargoWise.eHub.Products.TWCustoms.Orchestrations.Helpers.OrchestrationHelper.UpdateStatusToInvalid(senderID, staffCode, mailboxId, errorDescription, 0);
                            }
                            else 
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("311b6901-7d84-4e6d-b969-32351ff90a3d")]
                                if (errorType == "Plug-In" || errorCode == "-1")
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("89227545-451f-46c0-abc9-53505b3da922")]
                                    exit = false;
                                    logger.Log.ErrorFormat("Plugin Returns a {1} error with ErrorCode {0}, Error Type {1}", errorCode, errorType);
                                }
                                else 
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ac6fdaf6-afc6-419f-b9a4-14bd59da73d4")]
                                    exit = true;
                                    logger.Log.ErrorFormat("Plugin Returns a {1} error with ErrorCode {0}, Error Type {1}", errorCode, errorType);
                                }
                            }
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("eaeffbad-ead3-4283-be02-73487d9e1db3")]
                        if (!exit)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("ff9a8a11-0b28-414c-a712-d15fa1fcdcf2")]
                            retryTimes = retryTimes + 1 ;
                            logger.Log.ErrorFormat("TW Customs Retry times:{0}", retryTimes);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("955d273b-d6f1-4577-85d0-8ede1b5f1183")]
                            if (retryTimes < maxRetryTimes )
                            {
