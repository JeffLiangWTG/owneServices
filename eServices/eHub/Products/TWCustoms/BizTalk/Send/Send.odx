                                        <Context>
                                            <Type>MailBoxID</Type>
                                            <Value>{9}</Value>
                                        </Context>
                                    </ContextCollection>
                                </Event>
                            </UniversalEvent>", System.DateTime.UtcNow.AddHours(8), errorDescription, entryNumber, entryType, messageType, interchangeNumber, passwordType, ownerString, regStatus, mailboxId);
                        
                        logger.Log.Error("Error sending TWC message with tracking ID '" + messageTrackingID + "'\r\n" + ex.ToString());
                    }
                }
