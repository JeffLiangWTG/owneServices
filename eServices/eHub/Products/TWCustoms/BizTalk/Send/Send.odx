                    <om:Property Name="Expression" Value="senderID = OutboxMsg(BTS.SourceParty);&#xD;&#xA;recipientID = OutboxMsg(BTS.DestinationParty);&#xD;&#xA;messageTrackingID = OutboxMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);&#xD;&#xA;outboxPK = OutboxMsg(CargoWise.eHub.Core.PropertySchemas.OutboxPK);&#xD;&#xA;logger.Log.InfoFormat(&quot;Tracking ID:[{0}] Sending. Sender={1} Recipient={2}&quot;, messageTrackingID, senderID, recipientID);&#xD;&#xA;maxRetryTimes = 1000;" />
