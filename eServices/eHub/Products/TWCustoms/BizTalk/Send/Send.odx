                                retryIntervalInSeconds = 60;
                                maxRetryTimes = 1000;
                                logger.Log.WarnFormat("Failed to get values from code mapping, use default value instead (retryIntervalInSeconds = {1}, retryLimit = {2}). {4}", retryIntervalInSeconds, maxRetryTimes, ex.ToString());
                            }
                        }
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("dfe9fa53-4223-456e-8e9e-87e78be66685")]
                    construct OutboundMsg
