                            errorDescription = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries("TWCustoms", "TWCustoms", "TW Customs Configurations", "Error Code", "Description", errorCode, null ,null, null, null, logger.Log);
                            errorType = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries("TWCustoms", "TWCustoms", "TW Customs Configurations", "Error Code", "Type", errorCode, null ,null, null, null, logger.Log);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1272ebc7-695e-42d2-9b85-13959d03a831")]
                            if (errorType == "Credential")
