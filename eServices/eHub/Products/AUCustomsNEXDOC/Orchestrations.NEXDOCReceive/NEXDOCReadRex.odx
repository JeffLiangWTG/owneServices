                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault']
                                                            /*[local-name()='faultstring'])");
                        }
                        if (System.String.IsNullOrEmpty(fault))
                        {
                            fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault'])");
                        }
                        logger.Log.Info("Fault: " + fault + " [Client Group Token: " + clientGroupToken + "]");
                        
                        groupTokenInvalid = fault == "Client Group token provided is not valid.";
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("2c20a800-38d2-4a0e-b9f3-ac73435ad6ff")]
                        if (groupTokenInvalid)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("95c03186-c859-4fef-b0fb-783665a1e672")]
                            construct InvalidGroupTokenMsg
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("0ce39741-640e-4c69-a67c-ce75e66a9f48")]
