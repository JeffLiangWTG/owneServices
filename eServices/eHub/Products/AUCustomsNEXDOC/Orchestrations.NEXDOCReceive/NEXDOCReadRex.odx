                RequestMsg(WCF.Action) = "http://agriculture.gov.au/nexdoc/service/readRex/ReadRex";
                requestBodyString = System.String.Format("<read:ReadRex xmlns:read='http://agriculture.gov.au/nexdoc/ReadRexSoap_1.0' xmlns:com='http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0'><read:identification><com:rexNumber>{0}</com:rexNumber></read:identification></read:ReadRex>", rexNumber);
