                            fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault']
                                                            /*[local-name()='detail']
                                                            /*[local-name()='NexdocSoapFault']
