                certificateNumber = "";
                filename = "";
                
                xmlString = System.String.Format(
                @"<nexauth:authTokens xmlns:nexauth='http://agriculture.gov.au/header/auth'>
                         <vendorToken>{0}</vendorToken>
                         <clientGroupToken>{1}</clientGroupToken>
                         <clientToken>{2}</clientToken>
                      </nexauth:authTokens>
                      <wsse:Security xmlns:wsse='http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd'>
                         <wsse:UsernameToken>
                            <wsse:Username>{3}</wsse:Username>
                            <wsse:Password Type='http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText'>{4}</wsse:Password>
                         </wsse:UsernameToken>
                      </wsse:Security>
                ", vendorToken, clientGroupToken, clientToken, installationToken, installationPassword);
                
                RequestMsg = new System.Xml.XmlDocument();
                RequestMsg(WCF.OutboundCustomHeaders) = "<headers>" + xmlString + "</headers>";
                RequestMsg(WCF.Action) = "http://agriculture.gov.au/nexdoc/service/readcertificate/ReadCertificate";
                requestBodyString = System.String.Format("<not:ReadCertificate xmlns:not='http://agriculture.gov.au/nexdoc/ReadCertificateSoap_1.0' xmlns:com='http://agriculture.gov.au/nexdoc/common/CommonTypes_1.0'><not:identification><com:rexNumber>{0}</com:rexNumber></not:identification></not:ReadCertificate>", rexNumber);
                RequestMsg.LoadXml(requestBodyString);
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("91f74118-9119-40ea-8a93-02a378abec5b")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ad74c853-3836-4cb9-ac48-fad8fa1c9e0a")]
                    if (senderId == "NEXDOCS")
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("5b113b4b-330c-4bff-9ff9-c93f6d5c9f87")]
                        send (SendToNexdocReadCertProdSvc.RequestResponse, RequestMsg);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("b9f18f0a-f48e-4bd1-9158-b19ebcc59686")]
                        receive (SendToNexdocReadCertProdSvc.RequestResponse, ResponseMsg);
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("611c1a31-595d-4719-aa66-1f821d9896c1")]
                        send (SendToNexdocReadCertTestSvc.RequestResponse, RequestMsg);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("40573b68-e123-4e87-ad15-d73b66923e61")]
                        receive (SendToNexdocReadCertTestSvc.RequestResponse, ResponseMsg);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("c1938d49-6e4d-4839-b44f-f7dd93cc9cab")]
                    logger.Log.InfoFormat("Received Certificate response for [Rex Number: {0}]", rexNumber);
                    if(logger.Log.IsTraceEnabled)
                    {
                    	logger.Log.TraceFormat("Certificate reponse for [Rex Number: {0}]\r\n{1}", rexNumber, ResponseMsg.OuterXml);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("0a5c7b1a-cd2a-46eb-8463-bcef70c99916")]
                    if (xpath(ResponseMsg, @"/*[local-name()='Envelope' and namespace-uri()='http://schemas.xmlsoap.org/soap/envelope/']
                                             /*[local-name()='Body' and namespace-uri()='http://schemas.xmlsoap.org/soap/envelope/']
                                             /*[local-name()='Fault' and namespace-uri()='http://schemas.xmlsoap.org/soap/envelope/']") != null
                        )
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("bdedccf8-c009-4a34-92cb-86af4cf67b06")]
                        fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault']
                                                            /*[local-name()='detail']
                                                            /*[local-name()='fault']
                                                            /*[local-name()='details']
                                                            /*[local-name()='ReceivedFaultDetail']
                                                            /*[local-name()='faultstring'])");
                        
                        if (System.String.IsNullOrEmpty(fault))
                        {
                            fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault']
                                                            /*[local-name()='detail']
                                                            /*[local-name()='NexdocSoapFault']
                                                            /*[local-name()='NexdocSoapFaultItem']
                                                            /*[local-name()='FaultMessage'])");
                        }
                        if (System.String.IsNullOrEmpty(fault))
                        {
                            fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault']
                                                            /*[local-name()='faultstring'])");
                        }
                        if (System.String.IsNullOrEmpty(fault))
                        {
                            fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault'])");
                        }
                        logger.Log.Info("Fault: " + fault + " [Client Group Token: " + clientGroupToken + "]");
                        
                        groupTokenInvalid = fault == "Client Group token provided is not valid.";
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("2c20a800-38d2-4a0e-b9f3-ac73435ad6ff")]
                        if (groupTokenInvalid)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("95c03186-c859-4fef-b0fb-783665a1e672")]
                            construct InvalidGroupTokenMsg
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("0ce39741-640e-4c69-a67c-ce75e66a9f48")]
                                InvalidGroupTokenMsg = CargoWise.eHub.Products.AUCustomsNEXDOC.Configuration.SystemLevelConfigurationHandler
                                    .GetWcfSqlUpdateClientGroupTokenStatus(
                                       cw1ClientID,
                                        senderId,
                                        CargoWise.eHub.Products.AUCustomsNEXDOC.Configuration.ConfigurationStatus.INV.ToString());
                                
                                InvalidGroupTokenMsg(WCF.Action) = "CompositeOperation";
                            }
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1b5c397e-e841-400c-ac04-61b030717d93")]
                            send (eHubTransactionsOpsPort_ReadCertificate.SqlOp, InvalidGroupTokenMsg);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("cf2c3a0c-251c-40cd-80af-787891cd02a9")]
                            receive (eHubTransactionsOpsPort_ReadCertificate.SqlOp, InvalidGroupTokenMsg);
                        }
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("fdbc004c-fd03-4130-99f9-6fd2a0a367ab")]
                        certificateConsignee = CargoWise.eHub.Products.AUCustomsNEXDOC.Helpers.OrchestrationHelper.ExtractConsigneeInformation(ResponseMsg, certificateConsignee);
                        certificatePayload = CargoWise.eHub.Products.AUCustomsNEXDOC.Helpers.OrchestrationHelper.ExtractCertificatePayload(ResponseMsg, "ORIGINAL", certificatePayload, "");
                    }
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("f9424bda-a50f-4fb4-9664-9795b423a202")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("a35b218e-76d3-494b-816d-15a84636457f")]
                        logger.Log.Error("Error getting certificates AUCustoms NEXDOC [Rex Number: " + rexNumber + "]" + "'\r\n" + ex.ToString());
                    }
                }
            }
        }
    }
}

