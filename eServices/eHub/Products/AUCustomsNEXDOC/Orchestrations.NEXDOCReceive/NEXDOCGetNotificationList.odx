[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module CargoWise.eHub.Products.AUCustomsNEXDOC.Orchestrations.NEXDOCReceive
{
    internal porttype RcvTriggerPortType
    {
        oneway TypedPolling
        {
            eHubTransactions_AUCustomsNEXDOCRecTrigger.TypedPollingResultSet0
        };
    };
    internal porttype RequestResponsePortType
    {
        requestresponse RequestResponse
        {
            System.Xml.XmlDocument, System.Xml.XmlDocument
        };
    };
    internal porttype AlertService_PortType
    {
        oneway AlertServiceLoopback
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service NEXDOCGetNotificationList
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements RcvTriggerPortType RcvTriggerPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses RequestResponsePortType SendToNexdocProdSvc;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses RequestResponsePortType SendToNexdocTestSvc;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses eHubTransactionsOpsPortType eHubTransactionsOpsPort;
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port uses AlertService_PortType AlertService;
        message System.Xml.XmlDocument TableOpsResponse;
        message System.Xml.XmlDocument InvalidGroupTokenMsg;
        message eHubTransactions_AUCustomsNEXDOCRecTrigger.TypedPollingResultSet0 TriggerMsg;
        message System.Xml.XmlDocument RequestMsg;
        message System.Xml.XmlDocument ResponseMsg;
        message System.Xml.XmlDocument ErrorMsg;
        System.String eHubErrorResponse;
        System.Boolean groupTokenInvalid;
        System.String fault;
        System.String installationPassword;
        System.String vendorToken;
        CargoWise.eHub.Core.Logging.OrchestrationLogger logger;
        System.String installationToken;
        System.String xmlString;
        System.Int32 counter;
        System.String notificationId;
        System.String strPath;
        System.String clientGroupToken;
        System.String recipientId;
        System.String cw1ClientID;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("6d8a534b-06b6-4e87-a7a7-09066b7fb0eb")]
            activate receive (RcvTriggerPort.TypedPolling, TriggerMsg);
            eHubErrorResponse = "";
            groupTokenInvalid = true;
            fault = "";
            installationPassword = "";
            vendorToken = "";
            logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            installationToken = "";
            xmlString = "";
            notificationId = "";
            strPath = "";
            clientGroupToken = "";
            recipientId = "";
            cw1ClientID = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a702bd75-f9c9-499e-b706-7271433258f6")]
            clientGroupToken = CargoWise.eServices.Encryption.Server.Decryptor.EhubServerDecryptor.Decrypt(TriggerMsg.ClientGroupToken);
            cw1ClientID = TriggerMsg.ClientID;
            logger.Log.Info("Starting [Client Group Token: " + clientGroupToken + "]");
            
            if(TriggerMsg.TestFlag == 1)
            {
                recipientId = "NEXDOCS";
            }
            else
            {
                recipientId = "NEXDOCSTest";
            }
            
            
            installationToken = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries(recipientId,recipientId,"NEXDOCS Credentials","Default","Installation Token",null,null,null,null,null,logger.Log);
            installationPassword = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries(recipientId,recipientId,"NEXDOCS Credentials","Default","Password",null,null,null,null,null,logger.Log);
            vendorToken  = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue_WithRetries(recipientId,recipientId,"NEXDOCS Credentials","Default","Vendor Token",null,null,null,null,null,logger.Log);
            
            logger.Log.Info("Recipient: " + recipientId + "; Installation Token: " + installationToken + "; Vendor Token: " + vendorToken);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("33b59660-3a86-4eb5-8e60-dab069ad7332")]
            construct RequestMsg
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("6ef33ce7-de64-4396-aa0d-9f8ea729854c")]
                xmlString = System.String.Format(
                @"<nexauth:authTokens xmlns:nexauth='http://agriculture.gov.au/header/auth'>
                         <vendorToken>{0}</vendorToken>
                      </nexauth:authTokens>
                      <wsse:Security xmlns:wsse='http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd'>
                         <wsse:UsernameToken>
                            <wsse:Username>{1}</wsse:Username>
                            <wsse:Password Type='http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText'>{2}</wsse:Password>
                         </wsse:UsernameToken>
                      </wsse:Security>", vendorToken, installationToken, installationPassword);
                
                RequestMsg = new System.Xml.XmlDocument();
                RequestMsg(WCF.OutboundCustomHeaders) = "<headers>" + xmlString + "</headers>";
                RequestMsg(WCF.Action) = "http://agriculture.gov.au/nexdoc/service/notification/NotificationList";
                xmlString = System.String.Format(@"<not:NotificationList xmlns:not='http://agriculture.gov.au/nexdoc/NotificationSoap_1.0'>
                    <not:clientGroups>
                      	<not:clientGroup>{0}</not:clientGroup>
                    </not:clientGroups>
                    <not:showPreviouslyAcknowledged>false</not:showPreviouslyAcknowledged>
                </not:NotificationList>",clientGroupToken);
                RequestMsg.LoadXml(xmlString);
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("de03c8c8-4efd-4059-b5ae-576de2750e39")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("203f73df-abd7-4cca-b317-edced21791f5")]
                    if (recipientId == "NEXDOCS")
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("71392cdb-70d6-4fda-8699-95a438130e0b")]
                        send (SendToNexdocProdSvc.RequestResponse, RequestMsg);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("ddd0a12d-89e2-420b-8c5a-e2366256ef5b")]
                        receive (SendToNexdocProdSvc.RequestResponse, ResponseMsg);
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("3efd7143-48aa-4a75-bf1c-edeecbd00b0c")]
                        send (SendToNexdocTestSvc.RequestResponse, RequestMsg);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("a5ebb88a-4f68-4d99-9755-2773b2806a58")]
                        receive (SendToNexdocTestSvc.RequestResponse, ResponseMsg);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("07989219-6e55-4176-8604-f2f7f48827f5")]
                    if (xpath(ResponseMsg, @"/*[local-name()='Envelope' and namespace-uri()='http://schemas.xmlsoap.org/soap/envelope/']
                                             /*[local-name()='Body' and namespace-uri()='http://schemas.xmlsoap.org/soap/envelope/']
                                             /*[local-name()='Fault' and namespace-uri()='http://schemas.xmlsoap.org/soap/envelope/']") != null
                        )
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("4e996092-b267-4551-9700-79f0059096e2")]
                        fault = xpath(ResponseMsg, @"string(/*[local-name()='Envelope']
                                                            /*[local-name()='Body']
                                                            /*[local-name()='Fault']
                                                            /*[local-name()='detail']
                                                            /*[local-name()='fault']
                                                            /*[local-name()='details']
                                                            /*[local-name()='ReceivedFaultDetail']
                                                            /*[local-name()='faultstring'])");
                        logger.Log.Info("Fault: " + ResponseMsg.OuterXml + " [Client Group Token: " + clientGroupToken + "]");
                        
                        groupTokenInvalid = fault == "No Valid Tokens were provided.";
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("514cb8b1-6cdb-42ab-9917-e64bff013dfe")]
                        if (groupTokenInvalid)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("e4531273-a0d5-44f6-a01a-5ec5b7f9a7af")]
                            construct InvalidGroupTokenMsg
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("95898565-a1ec-4e12-a3d5-05e892cc82eb")]
                                InvalidGroupTokenMsg = CargoWise.eHub.Products.AUCustomsNEXDOC.Configuration.SystemLevelConfigurationHandler
                                    .GetWcfSqlUpdateClientGroupTokenStatus(
                                        cw1ClientID,
                                        recipientId,
                                        CargoWise.eHub.Products.AUCustomsNEXDOC.Configuration.ConfigurationStatus.INV.ToString());
                                
                                InvalidGroupTokenMsg(WCF.Action) = "CompositeOperation";
                            }
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2abdb73e-a731-49ac-9fe2-c7bd134c07ef")]
                            send (eHubTransactionsOpsPort.SqlOp, InvalidGroupTokenMsg);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("870806f5-a6da-41d9-838a-b347b19b041c")]
                            receive (eHubTransactionsOpsPort.SqlOp, InvalidGroupTokenMsg);
                        }
                    }
                    else if (!System.String.IsNullOrWhiteSpace(xpath(ResponseMsg, "string(//*[local-name()='NotificationListResponse']/*[local-name()='notification'][1]/*[local-name()='notificationId']/text())"))
                        )
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("93b07b29-4164-4b0a-a1bc-2d4008059851")]
                        counter = (System.Int32)(xpath(ResponseMsg,"count(//*[local-name()='NotificationListResponse']/*[local-name()='notification'])"));
                        logger.Log.Info(System.String.Format("Notification list returns {0} notifications using Client Group Token: {1}", counter.ToString(), clientGroupToken));
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("b415582a-2f72-4357-b022-d6a015ed0577")]
                        while (counter > 0)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("3f0e0103-bbeb-4195-98fa-788cc19c1c1c")]
                            strPath = System.String.Format("string(//*[local-name()='NotificationListResponse']/*[local-name()='notification'][{0}]/*[local-name()='notificationId']/text())", counter);
                            notificationId = xpath(ResponseMsg,strPath);
                            
                            counter = counter - 1;
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("23612c9b-abae-4acd-bf70-651a1993899a")]
                            call CargoWise.eHub.Products.AUCustomsNEXDOC.Orchestrations.NEXDOCReceive.NEXDOCReadNotification (vendorToken, installationPassword, installationToken, clientGroupToken, notificationId, logger, recipientId, cw1ClientID);
                        }
                    }
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("4f0e76d6-d4fb-4afd-80d9-88ce44e77024")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("e2bbfdf6-1f25-414a-8b72-b855a1c6bc2c")]
                        scope
                        {
                            body
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("e1fd840b-c393-4336-acde-ecf38e389cfc")]
                                logger.Log.Error("Error [Client Group Token: " + clientGroupToken + "] : " + ex.ToString());
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("a632ef25-d8d2-45b8-b07e-947b848c605f")]
                                construct ErrorMsg
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6b51c941-d771-4c4d-99b7-eecfe4771702")]
                                    ErrorMsg = RequestMsg;
                                    ErrorMsg(ErrorReport.Description) = ex.ToString();
                                    ErrorMsg(ErrorReport.ErrorType) = "FailedMessage";
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("71026d53-eda1-4062-b441-163605fb8bd1")]
                                send (AlertService.AlertServiceLoopback, ErrorMsg);
                            }
                            exceptions
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("985f3deb-9159-40da-9dee-b98f2d91571c")]
                                catch (System.Exception sendToAlertException)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("73388954-2f36-471d-8a9c-23f0ccea81cb")]
                                    logger.Log.Error("Error during error reporting [Client Group Token: " + clientGroupToken + "] : " + sendToAlertException.ToString());
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

