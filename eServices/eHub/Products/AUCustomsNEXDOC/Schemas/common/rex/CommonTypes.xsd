	<xsd:complexType name="ProductLineType">
		<xsd:annotation>
			<xsd:documentation>
				The productLine type contains the detailed information for a product relating to a Rex record. A
				given Rex record can contain multiple product line records, where each product line is identified by its designated
				line number, which must be unique for that given Rex record. For an amend operation, an existing productLine entry
				may be removed by quoting the lineNumber in addition to the removeEntry element set to 'true'.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:choice>
			<xsd:sequence>
				<xsd:element name="lineNumber" type="ct:Number2Digits" />
				<xsd:choice>
					<xsd:sequence maxOccurs="1">
						<xsd:element name="removeEntry" type="xsd:boolean" default="false" minOccurs="0" />
					</xsd:sequence>
					<xsd:sequence>
						<xsd:element name="productDetails" type="rct:ProductDetails" />

						<xsd:element name="containers" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>
									Wrapper element which allows
									multiple container elements to be
									applied against a productLine.
									Alternatively allows the deletion of
									the existing containers through an
									amend service call by applying
									removeExistingSet with a value of
									'true'.
								</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:choice minOccurs="0">
									<xsd:sequence maxOccurs="99">
										<xsd:element name="container" type="rct:ContainerType" />
									</xsd:sequence>
									<xsd:sequence maxOccurs="1">
										<xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
									</xsd:sequence>
								</xsd:choice>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="treatments" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>
									Wrapper element which allows
									multiple treatments to be applied
									against a productLine.
									Alternatively
									allows the deletion of the existing
									treatments through an amend service
									call by applying
									removeExistingSet
									with a value of 'true'.
								</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:choice minOccurs="0">
									<xsd:sequence maxOccurs="99">
										<xsd:element name="treatmentType" type="rct:TreatmentType" />
									</xsd:sequence>
									<xsd:sequence maxOccurs="1">
										<xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
									</xsd:sequence>
								</xsd:choice>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="productionProcesses" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>
									Wrapper element which allows
									multiple production processes to be
									applied against a productLine.
									Alternatively allows the deletion of
									the existing processes through an
									amend service call by applying
									removeExistingSet with a value of
									'true'.
								</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:choice minOccurs="0">
									<xsd:sequence maxOccurs="99">
										<xsd:element name="productionProcess" type="rct:ProductionProcessType" />
									</xsd:sequence>
									<xsd:sequence maxOccurs="1">
										<xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
									</xsd:sequence>
								</xsd:choice>
							</xsd:complexType>
						</xsd:element>

						<xsd:element name="sew" type="rct:ProductLineCustomsDetailsType" minOccurs="0"/>

						<!-- <xsd:element name="amlcPerformanceExporterNumber" type="ct:ExporterNumberType" minOccurs="0" /> -->
						<xsd:element name="durabilityStartDate" type="xsd:date" minOccurs="0" />
						<xsd:element name="durabilityEndDate" type="xsd:date" minOccurs="0" />
						<xsd:element name="aheccCode" type="ct:AheccCodeType" minOccurs="0" />
						<xsd:element name="batchCode" type="xsd:string" maxOccurs="1" minOccurs="0" />
						<xsd:element name="additionalTexts" type="rct:AdditionalTextsType" minOccurs="0" />
						<xsd:element name="productSourceCountries" minOccurs="0">
							<xsd:complexType>
								<xsd:choice minOccurs="0">
									<xsd:sequence maxOccurs="3">
										<xsd:element name="productSourceCountry" type="ct:CountryType" />
									</xsd:sequence>
									<xsd:sequence maxOccurs="1">
										<xsd:element name="removeExistingSet" type="xsd:boolean" default="false" />
									</xsd:sequence>
								</xsd:choice>
							</xsd:complexType>
						</xsd:element>
					</xsd:sequence>
				</xsd:choice>

			</xsd:sequence>
		</xsd:choice>
	</xsd:complexType>

	<xsd:complexType name="ProductLineCustomsDetailsType">
		<xsd:sequence>
			<xsd:element name="netCustomsWeight" type="ct:WeightType" minOccurs="0" />
			<xsd:element name="grossMetricWeight" type="ct:WeightType" minOccurs="0" />
			<xsd:element name="fobAmount" type="ct:CurrencyValueType" minOccurs="0" />
			<xsd:element name="productSourceState" type="ct:StateType" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ManufacturerDetailsType">
		<xsd:annotation>
			<xsd:documentation>
				Contains the elements which identify certificate request details. This includes the print
				information across the entire Rex record, as well as any specific certificate requests associated with the said Rex
				record.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="manufacturer" maxOccurs="99" type="rct:ManufacturerLineType" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ManufacturerLineType">
		<xsd:annotation>
			<xsd:documentation>
				A certificate request which encapsulates both the certificate request details, as well as the
				productLines applicable to the request.
			</xsd:documentation>
		</xsd:annotation>

		<xsd:sequence>
			<xsd:element name="lineNumbers">
				<xsd:complexType>
					<xsd:sequence maxOccurs="unbounded">
						<xsd:element name="lineNumber" type="ct:Number2Digits" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="manufacturerDetails" type="rct:LineManufacturerDetailsType" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="LineManufacturerDetailsType">
		<xsd:annotation>
			<xsd:documentation>
				A certificate request which encapsulates both the certificate request details, as well as the
				productLines applicable to the request.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="name" type="ct:AlphaNumeric50Type" />
			<xsd:element name="address" type="ct:AddressType" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="CertificateDetailsType">
		<xsd:annotation>
			<xsd:documentation>
				Contains the elements which identify certificate request details. This includes the print
				information across the entire Rex record, as well as any specific certificate requests associated with the said Rex
				record.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="certificatePrintControls" type="rct:CertificatePrintType" minOccurs="0" />
			<xsd:element name="certificates" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="certificate" maxOccurs="99" type="rct:CertificateLineType" minOccurs="0" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="CertificatePrintType">
		<xsd:annotation>
			<xsd:documentation>
				Provides the common certificate print information which relates to a Rex submission.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="certificatePrintIndicator" type="et:CertificatePrintIndicatorType" />
			<xsd:choice>
				<xsd:element name="certificatePrintRegion" type="ct:AlphaNumeric7Type" />
				<xsd:element name="certificateRequiredClientGroup" type="ct:PartyExternalIdType" />
			</xsd:choice>
			<!-- <xsd:element name="remotePrint" type="et:YesNoType" minOccurs="0" /> -->
			<xsd:element name="separateBy" type="et:CertificateSeparatorType" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>


	<xsd:complexType name="LineCertificatePrintType">
		<xsd:annotation>
			<xsd:documentation>
				Provides the common certificate print information which relates to a Rex submission.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="certificatePrintRegion" type="ct:AlphaNumeric7Type" />
				<xsd:element name="certificateRequiredClientGroup" type="ct:PartyExternalIdType" />
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="CertificateLineType">
		<xsd:annotation>
			<xsd:documentation>
				A certificate request which encapsulates both the certificate request details, as well as the
				productLines applicable to the request.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="removeEntry" type="xsd:boolean" default="false" minOccurs="0" />
				<xsd:element name="lineNumbers">
					<xsd:complexType>
						<xsd:sequence maxOccurs="unbounded">
							<xsd:element name="lineNumber" type="ct:Number2Digits" />
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:choice>
			<xsd:element name="certificateDetails" type="rct:LineCertificateDetailsType" />
			<xsd:element name="certificatePrintDetails" type="rct:LineCertificatePrintType" minOccurs="0" />
		</xsd:sequence>

	</xsd:complexType>

	<xsd:complexType name="LineCertificateDetailsType">
		<xsd:annotation>
			<xsd:documentation>
				Optional certificate print details which can override the respective details provided at the REX
				level.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="certificateTemplate" type="ct:CertificateTemplateType" />
			<xsd:element name="certificateEndorsement" type="ct:CertificateEndoresementType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="RexLinesResponseType">
		<xsd:sequence>
			<xsd:element name="rexLine" maxOccurs="99" type="rct:RexLineTypeResponse">
				<xsd:unique name="lineNumberUnique">
					<xsd:selector xpath="rexLine" />
					<xsd:field xpath="lineNumber" />
				</xsd:unique>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="TransportDetailsType">
		<xsd:annotation>
			<xsd:documentation>
				Contains the elements which identify the transportation information pertaining to a Rex record.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="transportMode" type="et:TransportType" minOccurs="0" />
			<xsd:element name="voyageOrFlightNumber" type="ct:AlphaNumeric6Type" minOccurs="0" nillable="true" />
			<xsd:element name="vesselName" type="ct:AlphaNumeric254Type" minOccurs="0" nillable="true" />
			<xsd:element name="shippingCompany" type="ct:AlphaNumeric254Type" minOccurs="0" nillable="true" />
			<xsd:element name="storeTransportTemperature" type="ct:TemperatureType" minOccurs="0"  nillable="true"/>
			<xsd:element name="vesselHoldSeals" type="rct:VesselHoldSealType" minOccurs="0" nillable="true" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="InspectionProcessType">
		<xsd:sequence>
			<xsd:element name="inspectionRequestedDate" type="xsd:date" />
			<xsd:element name="authorisedStartDate" type="xsd:date" />
			<xsd:element name="authorisedEndDate" type="xsd:date" />
			<xsd:element name="authorisedEstablishmentNumber" type="ct:EstablishmentNumberType" />
			<xsd:element name="authorisedOfficer" type="ct:UserIdType" />
			<xsd:element name="shipsHoldInspectionProcess" type="rct:ShipsHoldInspectionProcessType" minOccurs="0" />
			<xsd:element name="approvedCertifier" type="ct:AlphaNumeric5Type" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ShipsHoldInspectionProcessType">
		<xsd:sequence>
			<xsd:element name="compartments">
				<xsd:complexType>
					<xsd:sequence maxOccurs="unbounded">
						<xsd:element name="compartment" type="ct:AlphaNumeric3Type" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="inspectionPort" type="ct:PortType" />
			<xsd:element name="shipsHoldInspectionDate" type="xsd:date" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="AdditionalTextType">
		<xsd:sequence>
			<xsd:element name="code" type="xsd:token" minOccurs="1" maxOccurs="1" />
			<xsd:element name="text" type="xsd:string" minOccurs="1" maxOccurs="50" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="EUTransitType">
		<xsd:sequence>
			<xsd:element name="personResponsible" type="rct:PersonResponsibleType" minOccurs="0"/>
			<xsd:element name="placeOfDestinationDetails" type="rct:PlaceOfDestinationDetailsType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="PersonResponsibleType">
		<xsd:sequence>
			<xsd:element name="address" type="ct:AddressType" minOccurs="0"/>
			<xsd:element name="firstName" type="ct:AlphaNumeric100Type" />
			<xsd:element name="lastName" type="ct:AlphaNumeric100Type" />
			<xsd:element name="phoneNumber" type="ct:AlphaNumeric20Type" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="PlaceOfDestinationDetailsType">
		<xsd:sequence>
			<xsd:element name="name" type="ct:AlphaNumeric255Type" minOccurs="0"/>
			<xsd:element name="address" type="ct:AddressType" minOccurs="0"/>
			<xsd:element name="phoneNumber" type="ct:AlphaNumeric20Type" minOccurs="0" />
			<xsd:element name="approvalNumber" type="ct:AlphaNumeric50Type" minOccurs="0"/>
			<xsd:element name="transitLocationType" type="rct:TransitLocationType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<!-- REX Withdrawal response -->
	<xsd:complexType name="WithdrawalRexMessageResponse">
		<xsd:sequence>
			<xsd:element name="value" type="xsd:string" />
		</xsd:sequence>
	</xsd:complexType>

	<!-- REX copy response -->
	<xsd:complexType name="CopyRexMessageResponse">
		<xsd:sequence>
			<xsd:element name="value" type="xsd:string" />
			<xsd:element name="newRexNumber" type="xsd:string" />
		</xsd:sequence>
	</xsd:complexType>


	<!-- REX replace certificate response -->
	<xsd:complexType name="ReplaceCertificateMessageResponse">
		<xsd:sequence>
			<xsd:element name="value" type="xsd:string" />
			<xsd:element name="newRexNumber" type="xsd:string" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ReplaceReasonType">
		<xsd:choice>
			<xsd:element name="replaceReasonCode" type="ct:ReplaceReasonCodeType" maxOccurs="1" minOccurs="0" />
			<xsd:element name="replaceReasonText" type="ct:ReplaceReasonTextType" maxOccurs="1" minOccurs="0" />
		</xsd:choice>
	</xsd:complexType>



</xsd:schema>