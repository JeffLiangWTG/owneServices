      <xsd:documentation>A wrapper type which encapsulates the IMA Details Type.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="serialNumber" type="ct:AlphaNumeric100Type" minOccurs="0"/>
      <xsd:element name="containerNumber" type="ct:ContainerNumberType"/>
      <xsd:element name="invoiceDate" type="xsd:date" minOccurs="0"/>
      <xsd:element name="invoiceNumber" type="ct:AlphaNumeric20Type" minOccurs="0"/>
      <xsd:element name="grossWeight" type="ct:WeightType" minOccurs="0"/>
      <xsd:element name="netWeight" type="ct:WeightType" minOccurs="0"/>
      <xsd:element name="productDescription" type="ct:AlphaNumeric255Type" minOccurs="0"/>
      <xsd:element name="quotaYear" type="ct:Number4Digits" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

