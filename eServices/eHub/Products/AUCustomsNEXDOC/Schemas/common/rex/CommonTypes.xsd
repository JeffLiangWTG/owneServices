			<xsd:element minOccurs="0" name="identification" type="ct:IdentificationType" />
			<xsd:element minOccurs="0" name="complianceStatus" type="et:CompletionStatusType" />
			<xsd:element minOccurs="0" name="lastAmendDateTime" type="xsd:dateTime" />

			<!-- <xsd:element minOccurs="0" name="rexStatusDateTime" type="xsd:dateTime" /> <xsd:element minOccurs="0" name="rexLodgementDateTime" 
				type="xsd:dateTime" /> <xsd:element minOccurs="0" name="transferStatus" type="et:YesNoType" /> <xsd:element minOccurs="0" 
				name="embargoStatus" type="ct:AlphaNumeric1Type" /> <xsd:element minOccurs="0" name="exporterDetails" type="rct:ExporterDetailsResponseType" 
				/> -->
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ExporterDetailsType">
		<xsd:sequence>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ExporterDetailsResponseType">
		<xsd:complexContent>
			<xsd:extension base="rct:ExporterDetailsType">
				<xsd:sequence>
					<xsd:element minOccurs="0" name="exporterPermitNumber" type="ct:Number10Digits" />
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>

	<xsd:complexType name="CustomsDetailsType">
		<xsd:sequence>
			<xsd:element name="customsAgentIndicator" type="ct:CustomsAgentType" minOccurs="0" />
			<xsd:element name="edn" type="ct:ExportPermitNumberType" minOccurs="0" />
			<xsd:element name="currency" type="ct:CurrencyUnitType" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="RexLineTypeResponse">
		<xsd:sequence>
			<xsd:element name="lineNumber" type="ct:Number2Digits" />
			<!-- generated production description -->
			<xsd:element minOccurs="0" name="healthCertificateDescription" type="xsd:string" />
			<!-- assigned primary certificate -->
			<xsd:element minOccurs="0" name="primaryCertificate" type="rct:FormType" />
			<!-- assigned secondary certificate -->
			<xsd:element minOccurs="0" name="secondaryCertificate" type="rct:FormType" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="FormType">
		<xsd:sequence>
			<xsd:element name="templateCode" type="ct:AlphaNumeric6Type" />
			<xsd:element minOccurs="0" name="endorsementNumber" type="ct:Number5Digits" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ImportPermitType">
		<xsd:annotation>
			<xsd:documentation>This type identifies a import permit number, and it's associated date.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="importPermitNumber" type="ct:ImportPermitNumberType" />
			<xsd:element name="importPermitDate" type="xsd:date" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="EstablishmentType">
		<xsd:annotation>
			<xsd:documentation>
				This type recognises an establishment record by its name, address and a contact number. This is
				not an establishment contained within the establishment register.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="establishmentName" type="ct:AlphaNumeric50Type" />
			<xsd:element name="establishmentAddress" type="ct:AddressType" />
			<xsd:element name="contactPhoneNumber" type="ct:TelephoneNumberType" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ContainerType">
		<xsd:annotation>
			<xsd:documentation>
				Contains the container number and seal numbers associated with a container record.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="containerNumber" type="ct:ContainerNumberType" />
			<xsd:element name="containerSeals" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence maxOccurs="99" minOccurs="0">
						<xsd:element name="containerSeal" type="rct:ContainerSealType" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ContainerSealType">
		<xsd:annotation>
			<xsd:documentation>
				Specifies the container seal number applied to the container if relevant. Alternatively a range of
				seal numbers can be provided if relevant.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="sealNumber" type="ct:AlphaNumeric7Type" />
				<xsd:sequence>
					<xsd:element name="sealStartNumber" type="ct:AlphaNumeric7Type" minOccurs="0" />
					<xsd:element name="sealEndNumber" type="ct:AlphaNumeric7Type" minOccurs="0" />
				</xsd:sequence>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="VesselHoldSealType">
		<xsd:annotation>
			<xsd:documentation>Specifies the vessel hold seal number ranges applied to the vessel relevant.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="sealStartNumber" type="ct:AlphaNumeric7Type" minOccurs="0" />
			<xsd:element name="sealEndNumber" type="ct:AlphaNumeric7Type" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>


	<xsd:complexType name="ProductionProcessType">
		<xsd:annotation>
			<xsd:documentation>
				This type specifies the details pertaining to one of the production process relating to the
				enclosing Rex line record.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="processGroup" type="ct:ProcessType" minOccurs="0" />
			<xsd:element name="processingStartDate" type="xsd:date" />
			<xsd:element name="processingEndDate" type="xsd:date" />
			<xsd:element name="establishmentIndicator" type="ct:ProcessingIndicatorType" />
			<xsd:choice>
				<xsd:element name="processingEstablishmentNumber" type="ct:EstablishmentNumberType" />
				<xsd:element name="processingEstablishment" type="rct:EstablishmentType" />
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="TreatmentType">
		<xsd:annotation>
			<xsd:documentation>Specifies the treatments which have been applied to a particular product.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="treatmentCode" type="ct:TreatmentCodeType" />
			<xsd:element name="treatmentStartDate" type="xsd:date" />
			<xsd:element name="treatmentEndDate" type="xsd:date" />
			<xsd:element name="treatmentInformation" type="ct:TreatmentInformationType" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ProductDetails">
		<xsd:annotation>
			<xsd:documentation>Specifies the product details which relate to the enclosing Rex Line.</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="productType" type="ct:ProductType" />
			<xsd:element name="category" type="ct:ProductCategoryType" minOccurs="0" />
			<xsd:element name="packType" type="ct:PackageType" />
			<xsd:element name="preservationType" type="ct:PreservationType" />
			<xsd:element name="cutType" type="ct:CutType" minOccurs="0" />
			<xsd:element name="suppCode" type="ct:SuppCodeType" minOccurs="0" />
			<xsd:element name="outerProductPackaging" type="rct:OuterProductPackagingType" minOccurs="0" />
			<xsd:element name="intermediateProductPackaging" type="rct:ProductPackagingType" minOccurs="0" />
			<xsd:element name="innerProductPackaging" type="rct:ProductPackagingType" minOccurs="0" />
			<xsd:element name="netMetricWeight" type="ct:WeightType" minOccurs="0" />
			<xsd:element name="netImperialWeight" type="ct:WeightType" minOccurs="0" />
			<xsd:element name="importedProductFlag" type="et:YesNoType" default="N" minOccurs="0" />
			<xsd:element name="manualCertificateProductDescription" type="ct:AlphaNumeric254Type" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="ProductPackagingType">
		<xsd:annotation>
			<xsd:documentation>
				This type specifies the packaging and it's weight of the product related to the productLine. This
				can be either one of inner, outer or intermediate.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="quantity">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="ct:Number6Digits">
							<xsd:attribute name="packageType" type="ct:PackageType" />
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="unitAmount" type="ct:WeightType" />
			<xsd:element name="packageMeasureAccuracy" type="et:PackageMeasureAccuracyType" />
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="OuterProductPackagingType">
		<xsd:annotation>
			<xsd:documentation>
				An extension to packageType, this contains shipping marks applicable to outer packaging only.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexContent>
			<xsd:extension base="rct:ProductPackagingType">
				<xsd:sequence>
					<xsd:element name="shippingMarks" type="ct:ShippingMarksType" minOccurs="0" />
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	
	<xsd:simpleType name="TransitLocationType">
		<xsd:restriction base="xsd:token">
			<xsd:enumeration value="C">
				<xsd:annotation>
					<xsd:documentation>Custom Warehouse</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="S">
				<xsd:annotation>
					<xsd:documentation>Ship Supplier</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>

  <xsd:complexType name="ImaDetailsListType">
