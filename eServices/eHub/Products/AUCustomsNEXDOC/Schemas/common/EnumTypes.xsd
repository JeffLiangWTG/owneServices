<?xml version="1.0" encoding="UTF-8" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:et="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0"
            targetNamespace="http://agriculture.gov.au/nexdoc/common/EnumTypes_1.0" elementFormDefault="qualified">

    <xsd:simpleType name="RexResponseType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="AP">
                <xsd:annotation>
                    <xsd:documentation>Accepted</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="RE">
                <xsd:annotation>
                    <xsd:documentation>Rejected</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="TransportType">
        <xsd:restriction base="xsd:token">
            <!-- The value was 1 -->
            <xsd:enumeration value="S">
                <xsd:annotation>
                    <xsd:documentation>SEA</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <!-- The value was 4 -->
            <xsd:enumeration value="A">
                <xsd:annotation>
                    <xsd:documentation>AIR</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <!-- The value was 5 -->
            <xsd:enumeration value="M">
                <xsd:annotation>
                    <xsd:documentation>MAIL</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="YesNoType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Y"/>
            <xsd:enumeration value="N"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CompletionStatusType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="CANC">
                <xsd:annotation>
                    <xsd:documentation>CANCEL</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="COMP">
                <xsd:annotation>
                    <xsd:documentation>COMPLETED</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="EMHC">
                <xsd:annotation>
                    <xsd:documentation>EMERGENCY HEALTH CERTIFICATE</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="FINL">
                <xsd:annotation>
                    <xsd:documentation>FINAL</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="HCRD">
                <xsd:annotation>
                    <xsd:documentation>HEALTH CERTIFICATE READY</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="INIT">
                <xsd:annotation>
                    <xsd:documentation>INITIAL</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="INSP">
                <xsd:annotation>
                    <xsd:documentation>INSPECTED</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="ORDR">
                <xsd:annotation>
                    <xsd:documentation>ORDER</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="SUSP">
                <xsd:annotation>
                    <xsd:documentation>SUSPENDED</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="WTDRN">
                <xsd:annotation>
                    <xsd:documentation>WITHDRAWN</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="NotificationType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="RF">
                <xsd:annotation>
                    <xsd:documentation>REX FORWARD</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="ER">
                <xsd:annotation>
                    <xsd:documentation>EDN RECEIVED</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="RI">
                <xsd:annotation>
                    <xsd:documentation>REX INSPECTED</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="CR">
                <xsd:annotation>
                    <xsd:documentation>CERT READY</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="RelatedIdentifierType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="R">
                <xsd:annotation>
                    <xsd:documentation>REX NUMBER</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="C">
                <xsd:annotation>
                    <xsd:documentation>CERTIFICATE NUMBER</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CertificatePrintIndicatorType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="A">
                <xsd:annotation>
                    <xsd:documentation>AUTOMATIC</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="C">
                <xsd:annotation>
                    <xsd:documentation>CUSTOM CERTIFICATE</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="M">
                <xsd:annotation>
                    <xsd:documentation>MANUAL</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="N">
                <xsd:annotation>
                    <xsd:documentation>NOT REQUIRED</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="PackageMeasureAccuracyType">
        <xsd:restriction base="xsd:token">
            <xsd:maxLength value="1"/>
            <xsd:enumeration value="A">
                <xsd:annotation>
                    <xsd:documentation>APPROX</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="E">
                <xsd:annotation>
                    <xsd:documentation>EQUAL</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="PackageLevelType">
        <xsd:restriction base="xsd:token">
            <!-- The value was 1 -->
            <xsd:enumeration value="INN">
                <xsd:annotation>
                    <xsd:documentation>INNER</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <!-- The value was 2 -->
            <xsd:enumeration value="INT">
                <xsd:annotation>
                    <xsd:documentation>INTERMEDIATE</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <!-- The value was 3 -->
            <xsd:enumeration value="OUT">
                <xsd:annotation>
                    <xsd:documentation>OUTER</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="TelephoneType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="W"/>
            <xsd:enumeration value="M"/>
            <xsd:enumeration value="F"/>
            <xsd:enumeration value="P"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="NoticeType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="I">
                <xsd:annotation>
                    <xsd:documentation>INFORMATION</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="W">
                <xsd:annotation>
                    <xsd:documentation>WARNING</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="E">
                <xsd:annotation>
                    <xsd:documentation>ERROR</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CertificateStatesType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="A">
                <xsd:annotation>
                    <xsd:documentation>The Certificate Request has been approved</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="R">
                <xsd:annotation>
                    <xsd:documentation>The Certificate Request is waiting to be reviewed by an AQIS Officer
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="N">
                <xsd:annotation>
                    <xsd:documentation>The Certificate Request has been rejected by an AQIS Officer</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CertificateReasonType">
        <xsd:restriction base="xsd:token">
            <!-- The value was 9 -->
            <xsd:enumeration value="CRE">
                <xsd:annotation>
                    <xsd:documentation>Cert Request</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <!-- The value was 98 -->
            <xsd:enumeration value="CRA">
                <xsd:annotation>
                    <xsd:documentation>Cert Request Acknowledgement</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <!-- The value was 99 -->
            <xsd:enumeration value="RPA">
                <xsd:annotation>
                    <xsd:documentation>Remote Print Acknowledgement</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="DeclarationEstimateIndicatorType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="C">
                <xsd:annotation>
                    <xsd:documentation>Confirming</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="M">
                <xsd:annotation>
                    <xsd:documentation>Multiline</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="N">
                <xsd:annotation>
                    <xsd:documentation>Non-Confirming</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>


    <xsd:simpleType name="ProductUseType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="H">
                <xsd:annotation>
                    <xsd:documentation>Human Consumption</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="A">
                <xsd:annotation>
                    <xsd:documentation>Animal Feeding Stuff</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="F">
                <xsd:annotation>
                    <xsd:documentation>Further Process</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="T">
                <xsd:annotation>
                    <xsd:documentation>Technical Use</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
            <xsd:enumeration value="O">
                <xsd:annotation>
                    <xsd:documentation>Other</xsd:documentation>
                </xsd:annotation>
            </xsd:enumeration>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="TextType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="AAG"/>
            <xsd:enumeration value="AAW"/>
            <xsd:enumeration value="AAY"/>
            <xsd:enumeration value="ACB"/>
            <xsd:enumeration value="OCZ"/>
            <xsd:enumeration value="ZZZ"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CodeSetName">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="ECM_PRINT_REGION"/>
            <xsd:enumeration value="ECM_COUNTRY"/>
            <xsd:enumeration value="ECM_TREATMENT"/>
            <xsd:enumeration value="ECM_PACK_TYPE"/>
            <xsd:enumeration value="ECM_CUT_TYPE"/>
            <xsd:enumeration value="ECM_SUPPLEMENTARY_CODE"/>
            <xsd:enumeration value="ECM_COMMODITY_TYPE_SUPP_CODE"/>
            <xsd:enumeration value="ECM_AHECC_CODE"/>
            <xsd:enumeration value="ECM_PRESERVATION_TYPE"/>
            <xsd:enumeration value="ECM_SPECIES"/>
            <xsd:enumeration value="ECM_COMMODITY_TYPE"/>
            <xsd:enumeration value="ECM_DOCUMENT_TYPE"/>
            <xsd:enumeration value="ECM_PROCESS_CATEGORY"/>
            <xsd:enumeration value="ECM_PACKAGE_TYPE"/>
            <xsd:enumeration value="ECM_STATE"/>
            <xsd:enumeration value="ECM_UNIT_OF_MEASUREMENT"/>
            <xsd:enumeration value="ECM_CURRENCY"/>
            <xsd:enumeration value="ECM_PRODUCT_TYPE"/>
            <xsd:enumeration value="ECM_ESTABLISHMENT_INDICATOR"/>
            <xsd:enumeration value="ECM_PORT_LIST"/>
            <xsd:enumeration value="ECM_ADD_TEXT_FORMAT"/>
            <xsd:enumeration value="ECM_ADD_TEXT_LEVEL"/>
            <xsd:enumeration value="ECM_ADD_TEXT_TYPE"/>
            <xsd:enumeration value="ECM_CERTIFICATE_STATE"/>
            <xsd:enumeration value="ECM_CERTIFICATE_REASON"/>
            <xsd:enumeration value="ECM_TRANSPORT"/>
            <xsd:enumeration value="ECM_CERTIFICATE_PRINT_INDICATOR"/>
            <xsd:enumeration value="ECM_DECLARAION_CODES"/>
            <xsd:enumeration value="ECM_PRODUCT_USE"/>
            <xsd:enumeration value="ECM_CODES"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CodeValueType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="boolean"/>
            <xsd:enumeration value="integer"/>
            <xsd:enumeration value="float"/>
            <xsd:enumeration value="decimal"/>
            <xsd:enumeration value="double"/>
            <xsd:enumeration value="dateTime"/>
            <xsd:enumeration value="string"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="RexOwnershipEnumResponse">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Request Accepted."/>
            <xsd:enumeration value="Unable to be completed."/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="RexOwnershipType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="FORWARD"/>
            <xsd:enumeration value="TRANSFER"/>
            <xsd:enumeration value="WITHDRAWN"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="CertificateSeparatorType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="CONTAINER"/>
            <xsd:enumeration value="PACKING_ESTABLISHMENT"/>
            <xsd:enumeration value="SHIPPING_MARK"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="ExternalDetailIdType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="EXTERNAL_ID"/>
            <xsd:enumeration value="EXPORTER_ID"/>
            <xsd:enumeration value="LEGACY_EXPORTER_ID"/>
        </xsd:restriction>
    </xsd:simpleType>

    <xsd:simpleType name="RequestExporterResponseIdType">
        <xsd:restriction base="xsd:token">
            <xsd:enumeration value="REQUEST_ID"/>
            <xsd:enumeration value="EXPORTER_ID"/>
        </xsd:restriction>
    </xsd:simpleType>
</xsd:schema>
