<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPMA/CIN/756"
           targetNamespace="http://www.cargowise.com/Schemas/FPMA/CIN/756">

  <xs:element name="Xml756" type="xml756Type"/>
  <!-- XML756 -->
  <xs:complexType name="xml756Type">
    <xs:sequence>
      <xs:element type="customsType" name="Customs"/>
      <xs:element type="errorsType" name="Errors"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Customs -->
  <xs:complexType name="customsType">
    <xs:sequence>
      <xs:element type="dateTimeType" name="Datetime"/>
      <xs:element type="xs:string" name="Sender"/>
      <xs:element type="xs:string" name="TraderNumber"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Errors -->
  <xs:complexType name="errorsType">
    <xs:sequence>
      <xs:element type="errorType" name="Error" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <!-- Error -->
  <xs:complexType name="errorType">
    <xs:sequence>
      <xs:element type="erroCodeType" name="Code"/>
      <xs:element type="xs:string" name="Reason"/>
      <xs:element type="xs:string" name="Rejection"/>
    </xs:sequence>
  </xs:complexType>
  <!-- SIMPLE TYPES -->
  <xs:simpleType name="dateTimeType">
    <xs:restriction base="xs:token">
      <!-- Format : YYYYMMDDhhmm -->
      <xs:pattern value="(2[0-9]{3})(0[0-9]|1[0-2])([0-2][0-9]|3[0-1])([0-1][0-9]|2[0-3])([0-5][0-9])"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- ENUMERATION -->
  <xs:simpleType name="erroCodeType" final="restriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CSD001"/>
      <xs:enumeration value="CSD002"/>
      <xs:enumeration value="DAT001"/>
      <xs:enumeration value="DAT002"/>
      <xs:enumeration value="ZER001"/>
      <xs:enumeration value="DEC001"/>
      <xs:enumeration value="DEC002"/>
      <xs:enumeration value="DEC003"/>
      <xs:enumeration value="DOC001"/>
      <xs:enumeration value="NEU001"/>
      <xs:enumeration value="REF001"/>
      <xs:enumeration value="DEE001"/>
      <xs:enumeration value="DEE002"/>
      <xs:enumeration value="DEE003"/>
      <xs:enumeration value="AWB001"/>
      <xs:enumeration value="LOC001"/>
      <xs:enumeration value="LOC002"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>