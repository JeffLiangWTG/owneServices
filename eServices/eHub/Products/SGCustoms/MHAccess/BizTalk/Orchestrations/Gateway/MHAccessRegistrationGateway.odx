    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    public service MHAccessRegistrationGateway
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses Gateway_PortType1 GatewayProd;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses Gateway_PortType1 GatewayTest;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses eHubClientRegistration_PortType1 eHubTransactionOpsPort;
        message System.Xml.XmlDocument StatusUpdateReq;
        message System.Xml.XmlDocument InboxOutboxAckResMessage;
        message System.Xml.XmlDocument NewPasswordMessageRsp;
        message System.Xml.XmlDocument NewPasswordMessageReq;
        message CargoWise.eHub.Core.Schemas.WcfSql.Tables.eHubTransactions_eHubClientRegistration_Ops.Update UpdateRegReqMsg;
        message System.Xml.XmlDocument SelectRegReqMsg;
        message CargoWise.eHub.Core.Schemas.WcfSql.Tables.eHubTransactions_eHubClientRegistration_Ops.UpdateResponse UpdateRegRspMsg;
        message System.Xml.XmlDocument SelectRegRspMsg;
        message System.Xml.XmlDocument MHAccessGatewayChangePassword;
        message System.Xml.XmlDocument OutboxMsg;
        message System.Xml.XmlDocument InboxOutboxAckReqMessage;
        message System.Xml.XmlDocument StatusUpdateRes;
        System.String inboxOutboxContent;
        System.Guid outboxPK;
        System.Guid inboxPK;
        System.String sqlXmlString;
        System.String systemID;
        System.String Status;
        System.String State;
        System.Int32 ErrorCode;
        System.String ErrorCodeString;
        System.String newPassword;
        System.String tempString;
        System.String MHAccessMessage;
        System.Xml.XmlDocument tempXml;
        System.Boolean prodFlag;
        System.String recipientID;
        System.Boolean updatedSuccessfully;
        System.Guid MHAccessMessageTrackingID;
        System.String inboxOutboxXmlString;
        System.String inboxMessageTrackingID;
        System.String ErrorMessage;
        CargoWise.eHub.Core.Orchestrations.Helper.InvalidCredentialException invalidCredentialException;
        body (CargoWise.eHub.Core.Logging.OrchestrationLogger Logger, System.String AccountNo, out message System.Xml.XmlDocument GatewayActionRspMsg, System.String Password, System.String LogPrefix, System.Boolean ProdFlag)
        {
            inboxOutboxContent = "";
            sqlXmlString = "";
            systemID = "";
            Status = "";
            State = "";
            ErrorCodeString = "";
            newPassword = "";
            tempString = "";
            MHAccessMessage = "";
            tempXml = new System.Xml.XmlDocument();
            prodFlag = true;
            recipientID = "";
            updatedSuccessfully = false;
            inboxOutboxXmlString = "";
            inboxMessageTrackingID = "";
            ErrorMessage = "";
            invalidCredentialException = new CargoWise.eHub.Core.Orchestrations.Helper.InvalidCredentialException();
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("45ced5bf-dd51-4aec-8598-fb9a22932b5d")]
            newPassword = "";
            newPassword = CargoWise.eHub.Products.SGCustoms.Configuration.ConfigurationHandler.GenerateNewPassword(8,"");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("38a89577-8b82-47bd-bad9-953e7c363e08")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("4ad3c43a-dd18-4f3b-ade2-039c4272f48d")]
                    construct MHAccessGatewayChangePassword
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("785b8755-187c-461d-966f-8d35d75fe758")]
                        MHAccessMessageTrackingID = System.Guid.NewGuid();
                        tempString = System.String.Format(@"<ns0:changePassword xmlns:ns0=""http://cargowise.com/ehub/products/sgcustoms/MHAccessGateway"">
                          <username>{0}</username>
                          <password>{1}</password>
                          <newPassword>{2}</newPassword>
                        </ns0:changePassword>",
                        AccountNo,
                        Password,
                        newPassword);
                        
                        tempXml = new System.Xml.XmlDocument();
                        tempXml.LoadXml(tempString);
                        
                        MHAccessGatewayChangePassword = tempXml;
                        MHAccessGatewayChangePassword(WCF.Action)="ChangePassword";
                        
                        updatedSuccessfully = false;
                        
                        LogPrefix = System.String.Format("Account '{0}'", AccountNo);
                        prodFlag = recipientID == "SGCustoms";
                        
                        Logger.Log.InfoFormat("Account '{0}' Created request to MHGateway.", AccountNo);
                        
                        
                        
                        
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("3df6e4e5-8e5c-4fff-aad0-ab5a7fe114ff")]
                    if (ProdFlag)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("6dfa7999-5bd9-4717-b5a2-5cbac1c6f034")]
                        send (GatewayProd.Action, MHAccessGatewayChangePassword);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("1f469c85-8640-4358-a324-137f69c88649")]
                        receive (GatewayProd.Action, GatewayActionRspMsg);
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("88ff2dfb-d904-4bf1-b8cb-bf499825728f")]
                        send (GatewayTest.Action, MHAccessGatewayChangePassword);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("67364479-09d4-43d7-b5ed-19a3ccf4348d")]
                        receive (GatewayTest.Action, GatewayActionRspMsg);
                    }
                }
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d97d9301-f173-4e0f-91d7-15c548b9f573")]
            Logger.Log.InfoFormat("{0} Response message:\r\n{1}", LogPrefix, GatewayActionRspMsg.OuterXml);
            
            Status = xpath(GatewayActionRspMsg, "string(//*[local-name()='response']/*[local-name()='status'])");
            State = xpath(GatewayActionRspMsg, "string(//*[local-name()='response']/*[local-name()='state'])");
            ErrorMessage = xpath(GatewayActionRspMsg, "string(//*[local-name()='response']/*[local-name()='errorMessage'])");
            ErrorCodeString = xpath(GatewayActionRspMsg, "string(//*[local-name()='response']/*[local-name()='errorCode'])");
            ErrorCode = System.Convert.ToInt32("0" + ErrorCodeString);
            
            Logger.Log.ErrorFormat("{0} Status='{1}' State='{2}' ErrorCode='{3}'", LogPrefix, Status, State, ErrorCode);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("45c753cf-b766-4181-a686-79b5ac31db91")]
            if ((Status.ToLower() != "fail"))
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("a323ba66-03e6-41e7-a3a9-ba37a6379909")]
                construct NewPasswordMessageReq
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("eeef68f2-25bc-4e18-9e89-ea61b6661cc8")]
                    NewPasswordMessageReq = CargoWise.eHub.Products.SGCustoms.Configuration.ConfigurationHandler.GetWcfSqlToUpdateAccountPassword(AccountNo, newPassword); 
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("41c15b3e-2227-47e4-bf43-205e9d18344f")]
                send (eHubTransactionOpsPort.TableOps, NewPasswordMessageReq);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("6227786a-679e-4a63-b574-3d2a4e328f88")]
                receive (eHubTransactionOpsPort.TableOps, NewPasswordMessageRsp);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("2f8def09-a730-4729-9ee7-7f51baad38b2")]
                Status = xpath(NewPasswordMessageRsp, "string(//*[local-name()='response']/*[local-name()='status'])");
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("83ee3145-ec09-49df-babb-3476c56d6c39")]
                if ((Status.ToLower() == "success"))
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("5e6e0315-d4b3-41d2-9986-81d4dabf9fbf")]
                    Logger.Log.InfoFormat("{0} eHubTransaction database updated successfully for account {1} ", LogPrefix, AccountNo);
                }
                else 
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("a49262f2-84b5-4dd3-89b8-edfb7f49a4bd")]
                    Logger.Log.DebugFormat("{0} Error updating password in eHubTransaction database", LogPrefix);
                    Logger.Log.ErrorFormat("Error updating password in database for account '{0}'", AccountNo);
                }
            }
            else 
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("597ebd80-e84d-46ca-976e-fcb76bf966f2")]
                updatedSuccessfully = false;
                Logger.Log.ErrorFormat("{0} Error updating password", LogPrefix);
                Logger.Log.TraceFormat(GatewayActionRspMsg.OuterXml);
                Logger.Log.ErrorFormat("Error updating password for account '{0}' Error Code: {1}", AccountNo, ErrorCode);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("3fdedd25-875e-4b68-8e50-e9720211bde7")]
                construct StatusUpdateReq
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6b5f4794-b0f0-4182-a38b-747565ed7699")]
                    StatusUpdateReq = CargoWise.eHub.Products.SGCustoms.Configuration.ConfigurationHandler.GetWcfSqlToUpdateAccountStatusToInvalid(AccountNo, Password, ErrorCode, ErrorMessage);
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("f5de2699-8b09-4373-a2c1-0ad0e81ca8ab")]
                send (eHubTransactionOpsPort.TableOps, StatusUpdateReq);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("08f62881-7338-4707-b7dd-ec17c2b85f84")]
                receive (eHubTransactionOpsPort.TableOps, StatusUpdateRes);
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("12d27898-4801-4736-94aa-6e412dc1da38")]
                invalidCredentialException = new CargoWise.eHub.Core.Orchestrations.Helper.InvalidCredentialException("CargoWise.eHub.Products.SGCustoms.MHAccess.Orchestrations.Send.eHub2MHAccess - SG Customs MHAccess account '" + AccountNo + "' has become invalid.");
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("16f4c140-8ecf-4f17-b709-ae0642c6f62b")]
                throw invalidCredentialException;
            }
        }
    }
