                            <om:Property Name="Expression" Value="GatewayActionRspMsg = new System.Xml.XmlDocument();&#xD;&#xA;GatewayActionRspMsg.LoadXml(&quot;&lt;Dummy/&gt;&quot;);&#xD;&#xA;&#xD;&#xA;MessageXml = new System.Xml.XmlDocument();&#xD;&#xA;MessageXml.LoadXml(&#xD;&#xA;    &quot;&lt;ns0:Select xmlns:ns0='http://schemas.microsoft.com/Sql/2008/05/TableOp/dbo/eHubClientRegistration'&gt;&lt;ns0:Columns&gt;CX_PK,CX_Flag1,CX_RV&lt;/ns0:Columns&gt;&quot;&#xD;&#xA;    + &quot;&lt;ns0:Query&gt;WHERE CX_RT = (SELECT RT_PK FROM eHubRegistrationType WHERE RT_ID = 'SGCustomsAccount' AND CX_Code = '&quot; + AccountNo + &quot;' AND CX_Password1 = '&quot; + Password + &quot;')&lt;/ns0:Query&gt;&lt;/ns0:Select&gt;&quot;);&#xD;&#xA;SelectRegReqMsg = MessageXml;&#xD;&#xA;&#xD;&#xA;SelectRegReqMsg(CargoWise.eHub.Core.Orchestrations.Mutex.Properties.MutexName) = &quot;SGCustoms-Gateway&quot;;&#xD;&#xA;SelectRegReqMsg(CargoWise.eHub.Core.Orchestrations.Mutex.Properties.TriggerMutex) = &quot;SGC_MHAccess_&quot; + AccountNo;" />
