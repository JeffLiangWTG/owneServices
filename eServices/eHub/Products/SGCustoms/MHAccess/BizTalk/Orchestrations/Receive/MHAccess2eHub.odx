                                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("ffdbd207-8a56-4fb9-9ad9-f4e3f2430893")]
                                                            Logger.Log.DebugFormat("{0}Message was not saved to inbox and will be reprocessed in next scheduled receive process", LogPrefix);
                                                        }
                                                    }
                                                    exceptions
                                                    {
                                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("1307c10e-68d1-4f04-9050-f395e051e638")]
                                                        catch (System.Exception exception)
                                                        {
                                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("6fc98876-4b88-43a6-983c-2d0c9616e77f")]
                                                            Logger.Log.DebugFormat("{0}Fatal processing error", LogPrefix);
                                                            Logger.Log.ErrorFormat("CargoWise.eHub.Products.SGCustoms.MHAccess.BizTalk.Receive.Orchestrations.MHAccess2eHub - Error retrieving files for account '{0}':\r\n{1}", CredsMsg.AccountNo, exception);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("b6f14303-e443-4b28-bc45-c374b2410e64")]
                                    Index = Index + 1;
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("69045c0e-6da1-44bf-8f74-62ffcfd940f4")]
                                if (DeleteCount > 0)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("699e7e54-a6ed-47b9-8521-dac8c7b83c39")]
                                    construct DeleteMessagesReqMsg
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("a120b08a-bb22-4966-a04c-65cb69ba452f")]
                                        Logger.Log.DebugFormat("{0}Deleting {1} message(s) from server", LogPrefix, DeleteCount);
                                        
                                        DeleteFilesBuilder.Append("</ns0:deleteMessages>");
                                        MessageXml = new System.Xml.XmlDocument();
                                        MessageXml.LoadXml(DeleteFilesBuilder.ToString());
                                        DeleteMessagesReqMsg = MessageXml;
                                        DeleteMessagesReqMsg(WCF.Action) = "DeleteMessages";
                                        
                                        //Set IsGatewayMutexDetected to true to trigger the first attemp of deletion.
                                        IsGatewayMutexDetected = true;
                                    }
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("b4d1fbc6-6a41-4398-b065-1a95251791f7")]
                                    while (IsGatewayMutexDetected || soapErrorOccurred)
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("6494425b-5169-4017-aa6b-16c9151fdb03")]
                                        call CargoWise.eHub.Products.SGCustoms.MHAccess.Orchestrations.Gateway.MHAccessGateway (Logger, AccountNo, DeleteMessagesReqMsg, out DeleteMessagesRspMsg, Password, LogPrefix, ProdFlag, out IsGatewayMutexDetected, out soapErrorOccurred) CallGatewayDeleteMessage;
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("b10dd960-1d81-4e95-b1df-bd7b278113f2")]
                                        if (IsGatewayMutexDetected || soapErrorOccurred)
                                        {
                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("302e296a-d436-451a-ad7b-528d919bc094")]
                                            delay //Delay 10 seconds
                                                new System.TimeSpan(0, 0, 0, 10);
                                                if (IsGatewayMutexDetected)
                                                {
                                                    Logger.Log.InfoFormat("{0} Could not acquire the gateway mutex, will wait for 10 seconds and retry.", LogPrefix);
                                                }
                                                else
                                                {
                                                    Logger.Log.InfoFormat("{0} A SoapException occurred, will wait for 10 seconds and retry.", LogPrefix);
                                                }
                                        }
                                    }
                                }
                            }
                            else 
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("b439c486-e0c3-45e9-ba02-b6d0b6c0f5b3")]
                                Logger.Log.DebugFormat("{0}No messages", LogPrefix);
                            }
                        }
                        else 
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("c8acf046-491d-4564-bf9e-29a19bcad445")]
                            if (IsGatewayMutexDetected)
                            {
                                Logger.Log.InfoFormat("{0}Could not acquire gateway mutex on '{1}'. Skipping the following process. (Prod='{2}')", LogPrefix, AccountNo, ProdFlag);
                            }
                            else
                            {
                                Logger.Log.InfoFormat("{0}Account: '{1}'. (Prod='{2}'). A SoapException occurred, skipping the following process.", LogPrefix, AccountNo, ProdFlag);
                            }
                        }
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("362e68b0-2160-429f-b6f4-8aeece086524")]
                        Logger.Log.InfoFormat("{0}There is an existing receive mutex for '{1}'. Skipping the following process. (Prod='{2}')", LogPrefix, AccountNo, ProdFlag);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("90c09851-a5c4-4938-84e3-09329487b224")]
                    Logger.Log.DebugFormat("{0}Finished retrieve messages process", LogPrefix);
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e4f068f4-8aed-43b0-8802-dd98dd9d493f")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("e84284c6-8c28-4932-a40e-e65b1200fc32")]
                        Logger.Log.DebugFormat("{0}Fatal processing error", LogPrefix);
                        Logger.Log.ErrorFormat("CargoWise.eHub.Products.SGCustoms.MHAccess.BizTalk.Receive.Orchestrations.MHAccess2eHub - Error retrieving files for account '{0}':\r\n{1}", CredsMsg.AccountNo, ex);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("86606d84-5283-42d8-963f-781df733a3b8")]
                        terminate ex.ToString();;
                    }
                }
            }
        }
    }
}

