<!-- REVISION: 03.08 - 11/14/2013 tluu -->
<!-- Added EDIBookingNumber tag-->
<!-- REVISION: 03.08 - 04/03/2014 tluu -->
<!-- Added ReferenceType "TTID"-->
<!-- REVISION: 03.08 - 24-APR-2015 tluu -->
<!-- Added ReferenceType "VFNS"-->
