<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
						targetNamespace="http://www.cargowise.com/Schemas/2020/07/TrackAndTrace_CWTG"
						xmlns="http://www.cargowise.com/Schemas/2020/07/TrackAndTrace_CWTG"
						attributeFormDefault="unqualified"
						elementFormDefault="qualified">
  <xsd:element name="cwtgl_tat">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="export"/>
        <xsd:element ref="import"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="export" type="singles"/>
  <xsd:element name="import" type="singles"/>
  <xsd:complexType name="singles">
    <xsd:sequence minOccurs="0" maxOccurs="unbounded">
      <xsd:element ref="singles"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="singles">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element maxOccurs="unbounded" ref="single"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="single">
    <xsd:complexType>
      <xsd:choice maxOccurs="unbounded">
        <xsd:element ref="track_id"/>
        <xsd:element ref="stages"/>
        <xsd:element ref="booking"/>
        <xsd:element ref="cargos"/>
        <xsd:element ref="containers"/>
        <xsd:element ref="documents"/>
        <xsd:element ref="hbl"/>
        <xsd:element ref="remarks"/>
        <xsd:element ref="schedule"/>
      </xsd:choice>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="track_id" type="xsd:integer"/>
  <xsd:element name="stages">
    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="vessel_arrived"/>
        <xsd:element ref="cargo_unpacked"/>
        <xsd:element ref="booking_confirmed"/>
        <xsd:element ref="cargo_pickup"/>
        <xsd:element ref="cargo_received"/>
        <xsd:element ref="cargo_packed"/>
        <xsd:element ref="custom_clearance"/>
        <xsd:element ref="cargo_launched"/>
        <xsd:element ref="vessel_sailed"/>
        <xsd:element ref="bl_issued"/>
        <xsd:element ref="do_released"/>
        <xsd:element ref="cargo_released"/>
        <xsd:element ref="cargo_delivered"/>
      </xsd:choice>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="vessel_arrived" type="xsd:string"/>
  <xsd:element name="cargo_unpacked" type="xsd:string"/>
  <xsd:element name="booking_confirmed" type="xsd:string"/>
  <xsd:element name="cargo_pickup" type="xsd:string"/>
  <xsd:element name="cargo_received" type="xsd:string"/>
  <xsd:element name="cargo_packed" type="xsd:string"/>
  <xsd:element name="custom_clearance" type="xsd:string"/>
  <xsd:element name="cargo_launched" type="xsd:string"/>
  <xsd:element name="vessel_sailed" type="xsd:string"/>
  <xsd:element name="bl_issued" type="xsd:string"/>
  <xsd:element name="do_released" type="xsd:string"/>
  <xsd:element name="cargo_released" type="xsd:string"/>
  <xsd:element name="cargo_delivered" type="xsd:string"/>
  <xsd:element name="booking">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="booking_id"/>
        <xsd:element ref="booking_date"/>
        <xsd:element ref="cancelled_date"/>
        <xsd:element ref="custcomm_ref"/>
        <xsd:element ref="customer_id"/>
        <xsd:element ref="customer_name"/>
        <xsd:element ref="customer_ref"/>
        <xsd:element ref="shipper_name"/>
        <xsd:element ref="consignee_name"/>
        <xsd:element ref="pol_id"/>
        <xsd:element ref="pol"/>
        <xsd:element ref="pod_id"/>
        <xsd:element ref="pod"/>
        <xsd:element ref="fdest_id"/>
        <xsd:element ref="fdest"/>
        <xsd:element minOccurs="0" ref="eta_fdest"/>
        <xsd:element ref="pol_agent_id"/>
        <xsd:element ref="pol_agent"/>
        <xsd:element ref="pod_agent_id"/>
        <xsd:element ref="pod_agent"/>
        <xsd:element ref="fdest_agent_id"/>
        <xsd:element ref="fdest_agent"/>
        <xsd:element ref="cfs_id_orig"/>
        <xsd:element ref="cfs_orig"/>
        <xsd:element ref="cfs_id_dest"/>
        <xsd:element ref="cfs_dest"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="booking_id" type="xsd:string"/>
  <xsd:element name="booking_date" type="xsd:string"/>
  <xsd:element name="cancelled_date">
    <xsd:complexType/>
  </xsd:element>
  <xsd:element name="custcomm_ref" type="xsd:NMTOKEN"/>
  <xsd:element name="customer_id" type="xsd:NMTOKEN"/>
  <xsd:element name="customer_name" type="xsd:string"/>
  <xsd:element name="customer_ref" type="xsd:string"/>
  <xsd:element name="shipper_name" type="xsd:string"/>
  <xsd:element name="consignee_name" type="xsd:string"/>
  <xsd:element name="pol_id" type="xsd:string"/>
  <xsd:element name="pol" type="xsd:string"/>
  <xsd:element name="pod_id" type="xsd:string"/>
  <xsd:element name="pod" type="xsd:string"/>
  <xsd:element name="fdest_id" type="xsd:NMTOKEN"/>
  <xsd:element name="fdest" type="xsd:string"/>
  <xsd:element name="eta_fdest" type="xsd:integer"/>
  <xsd:element name="pol_agent_id" type="xsd:integer"/>
  <xsd:element name="pol_agent" type="xsd:string"/>
  <xsd:element name="pod_agent_id" type="xsd:integer"/>
  <xsd:element name="pod_agent" type="xsd:string"/>
  <xsd:element name="fdest_agent_id" type="xsd:string"/>
  <xsd:element name="fdest_agent" type="xsd:string"/>
  <xsd:element name="cfs_id_orig" type="xsd:string"/>
  <xsd:element name="cfs_orig" type="xsd:string"/>
  <xsd:element name="cfs_id_dest" type="xsd:NMTOKEN"/>
  <xsd:element name="cfs_dest" type="xsd:string"/>
  <xsd:element name="cargos">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="cargo"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="cargo">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="cargo_weight"/>
        <xsd:element ref="cargo_volume"/>
        <xsd:element ref="cargo_package_qty"/>
        <xsd:element ref="cargo_package_type"/>
        <xsd:element ref="container_no"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="cargo_weight" type="xsd:decimal"/>
  <xsd:element name="cargo_volume" type="xsd:decimal"/>
  <xsd:element name="cargo_package_qty" type="xsd:integer"/>
  <xsd:element name="cargo_package_type" type="xsd:string"/>
  <xsd:element name="containers">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="container"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="container">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="container_no"/>
        <xsd:element ref="container_size"/>
        <xsd:element ref="container_type"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="container_size" type="xsd:integer"/>
  <xsd:element name="container_type" type="xsd:string"/>
  <xsd:element name="documents">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="document"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="document">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="mode"/>
        <xsd:element ref="file"/>
        <xsd:element ref="type"/>
        <xsd:element ref="referenced_by"/>
        <xsd:element ref="referenced_id"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="hbl">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="bl_no"/>
        <xsd:element ref="port_id"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="bl_no" type="xsd:string"/>
  <xsd:element name="port_id" type="xsd:string"/>
  <xsd:element name="remarks">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="remark"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="remark">
    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="mode"/>
        <xsd:element ref="text"/>
        <xsd:element ref="file"/>
        <xsd:element ref="type"/>
        <xsd:element ref="referenced_by"/>
        <xsd:element ref="referenced_id"/>
      </xsd:choice>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="text" type="xsd:string"/>
  <xsd:element name="schedule">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="schedule_id"/>
        <xsd:element ref="eta"/>
        <xsd:element ref="etd"/>
        <xsd:element ref="vessel_name"/>
        <xsd:element ref="carrier_name"/>
        <xsd:element ref="voyage_no"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="schedule_id" type="xsd:NMTOKEN"/>
  <xsd:element name="eta" type="xsd:integer"/>
  <xsd:element name="etd" type="xsd:integer"/>
  <xsd:element name="vessel_name" type="xsd:string"/>
  <xsd:element name="carrier_name" type="xsd:string"/>
  <xsd:element name="voyage_no" type="xsd:NMTOKEN"/>
  <xsd:element name="mode" type="xsd:string"/>
  <xsd:element name="file" type="xsd:string"/>
  <xsd:element name="type" type="xsd:string"/>
  <xsd:element name="referenced_by" type="xsd:string"/>
  <xsd:element name="referenced_id" type="xsd:string"/>
  <xsd:element name="container_no" type="xsd:string"/>
</xsd:schema>
