                                    <om:Property Name="Signal" Value="False" />
                                </om:Element>
                                <om:Element Type="MessageAssignment" OID="33202a21-3952-4354-a6e8-70da39c838af" ParentLink="ComplexStatement_Statement" LowerBound="111.1" HigherBound="118.1">
                                    <om:Property Name="Expression" Value="xmlString = xpath(OutboxMsg, @&quot;string(/*[local-name()='GlobalElectronicInvoicing']/*[local-name()='Payload'])&quot;);&#xD;&#xA;HttpRequestMsg = CargoWise.eHub.Core.Orchestrations.Helper.Messages.CreateMessageFromString(&quot;HttpPost&quot;, System.Text.Encoding.UTF8.GetString(System.Convert.FromBase64String(xmlString)));&#xD;&#xA;&#xD;&#xA;HttpRequestMsg(WCF.Action) = &quot;POST&quot;;&#xD;&#xA;HttpRequestMsg(CargoWise.eHub.BizTalkAdapters.HTTPEx.Certificate) = certificate;&#xD;&#xA;HttpRequestMsg(CargoWise.eHub.BizTalkAdapters.HTTPEx.CertificatePassphrase) = certPassphrase;&#xD;&#xA;" />
                                    <om:Property Name="ReportToAnalyst" Value="False" />
                                    <om:Property Name="Name" Value="CreateReqMsg" />
