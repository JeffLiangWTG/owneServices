                    <om:Element Type="VariableAssignment" OID="daefbda2-5cf0-4b2a-ac7b-d8b1e9861595" ParentLink="ComplexStatement_Statement" LowerBound="79.1" HigherBound="105.1">
                        <om:Property Name="Expression" Value="senderID = OutboxMsg(BTS.SourceParty);&#xD;&#xA;recipientID = OutboxMsg(BTS.DestinationParty);&#xD;&#xA;&#xD;&#xA;messageTrackingID = OutboxMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);&#xD;&#xA;&#xD;&#xA;outboxPK = OutboxMsg(CargoWise.eHub.Core.PropertySchemas.OutboxPK);&#xD;&#xA;&#xD;&#xA;certificate = xpath(OutboxMsg, @&quot;string(/*[local-name()='GlobalElectronicInvoicing']/*[local-name()='Header']/*[local-name()='ElectronicInvoiceBatchRequest']/*[local-name()='Certificate'])&quot;);&#xD;&#xA;PAC = xpath(OutboxMsg, @&quot;string(/*[local-name()='GlobalElectronicInvoicing']/*[local-name()='Header']/*[local-name()='ElectronicInvoiceBatchRequest']/*[local-name()='Credentials']/*[local-name()='Credential'][*[local-name()='Key']='PAC']/*[local-name()='Value'])&quot;);&#xD;&#xA;&#xD;&#xA;TaxCoreVersion= xpath(OutboxMsg, @&quot;string(/*[local-name()='GlobalElectronicInvoicing']/*[local-name()='Header']/*[local-name()='ElectronicInvoiceBatchRequest']/*[local-name()='AdditionalDataItems']/*[local-name()='AdditionalDataItem'][*[local-name()='Key']='TaxCoreVersion']/*[local-name()='Value'])&quot;);&#xD;&#xA;&#xD;&#xA;certPassphrase = xpath(OutboxMsg, @&quot;string(/*[local-name()='GlobalElectronicInvoicing']/*[local-name()='Header']/*[local-name()='ElectronicInvoiceBatchRequest']/*[local-name()='Password'])&quot;);&#xD;&#xA;&#xD;&#xA;certPassphrase = CargoWise.eServices.Encryption.Server.Decryptor.EhubServerDecryptor.Decrypt(certPassphrase);&#xD;&#xA;&#xD;&#xA;if(System.String.IsNullOrEmpty(certificate) || System.String.IsNullOrEmpty(certPassphrase))&#xD;&#xA;{&#xD;&#xA;    throw new System.IO.InvalidDataException(&quot;Client Certificate and password must be provided&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;batchNumber =  xpath(OutboxMsg, @&quot;string(/*[local-name()='GlobalElectronicInvoicing']/*[local-name()='Header']/*[local-name()='ElectronicInvoiceBatchRequest']/*[local-name()='BatchNumber'])&quot;);&#xD;&#xA;&#xD;&#xA;logger.Log.InfoFormat(&quot;Sending. Sender={0} Recipient={1} MessageTrackingID={2}&quot;, &#xD;&#xA;    senderID, recipientID, messageTrackingID);" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="StartMessage" />
                        <om:Property Name="Signal" Value="True" />
                    </om:Element>
                    <om:Element Type="Decision" OID="32517d35-a31d-418a-82ed-70de41f2e5e8" ParentLink="ComplexStatement_Statement" LowerBound="105.1" HigherBound="136.1">
