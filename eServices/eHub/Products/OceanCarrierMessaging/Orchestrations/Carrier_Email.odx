[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module CargoWise.eHub.Products.OceanCarrierMessaging.Orchestrations
{
    internal messagetype EmailTypeWithoutEDIFact
    {
        body System.Xml.XmlDocument EmailBody;
        System.Xml.XmlDocument Attachment;
    };
    internal messagetype EmailType
    {
        body System.Xml.XmlDocument EmailBody;
        CargoWise.eHub.Core.PipelineComponents.Tools.RawString EDIFact;
        System.Xml.XmlDocument Attachment;
    };
    internal messagetype EmailTypeWithoutAttachment
    {
        CargoWise.eHub.Core.PipelineComponents.Tools.RawString EDIFact;
        body System.Xml.XmlDocument EmailBody;
    };
    internal messagetype EmailTypeWithoutAttachmentAndWithoutEDIFact
    {
        body System.Xml.XmlDocument EmailBody;
    };
    private porttype ReceivePortType
    {
        oneway Operation
        {
            System.Xml.XmlDocument
        };
    };
    internal porttype SendPortType
    {
        oneway Operation
        {
            EmailType
        };
        oneway OperationWithoutAttachment
        {
            EmailTypeWithoutAttachment
        };
        oneway OperationWithoutAttachmentAndWithoutEDIFact
        {
            EmailTypeWithoutAttachmentAndWithoutEDIFact
        };
        oneway OperationWithoutEDIFact
        {
            EmailTypeWithoutEDIFact
        };
    };
    internal porttype SendLoopbackType
    {
        requestresponse Operation
        {
            Schemas.VERMAS_D16A, System.Xml.XmlDocument
        };
    };
    internal porttype PortType_SendNACK
    {
        oneway Operation_SendNACK
        {
            System.Xml.XmlDocument
        };
    };
    internal correlationtype CorrelationType_NACK
    {
        BTS.AckReceivePortName, BTS.AckType
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service Carrier_Email
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements ReceivePortType ReceivePort;
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(CargoWise.eHub.Core.Pipelines.Snd_PassThruTransmitWithDeliveryNotification))]
        port uses dynamic SendPortType SendPort;
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port uses PortType_SendNACK Port_SendNACK;
        correlation CorrelationType_NACK Correlation_NACK;
        message System.Xml.XmlDocument Message_Envelope;
        message EmailType Email;
        message Schemas.VERMAS_D16A Message_Xml;
        message System.Xml.XmlDocument Message_Text;
        message System.Xml.XmlDocument NACK;
        message EmailTypeWithoutAttachment EmailWithoutAttachment;
        message EmailTypeWithoutAttachmentAndWithoutEDIFact EmailWithoutAttachmentAndWithoutEDIFact;
        message EmailTypeWithoutEDIFact EmailWithoutEDIFact;
        System.String attachmentFileNameDefault;
        System.String emailSubject;
        System.String emailType;
        System.String schemaName;
        System.String destinationPartyName;
        System.String attachmentFileName;
        System.String edifactText;
        System.String bookingRef;
        CargoWise.eHub.Core.Logging.OrchestrationLogger logger;
        Microsoft.XLANGs.Pipeline.SendPipelineInputMessages sendPipelineInput;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1be5830d-01b9-48d4-8790-192071087c62")]
            activate ((CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient") && (BTS.DestinationParty == "CARRIER_EMAIL_VM") || (BTS.DestinationParty == "CARRIER_EMAIL_BK") || (BTS.DestinationParty == "CARRIER_EMAIL_SI"))receive (ReceivePort.Operation, Message_Envelope);
            attachmentFileNameDefault = "";
            emailSubject = "";
            emailType = "";
            schemaName = "";
            destinationPartyName = "";
            attachmentFileName = "";
            edifactText = "";
            bookingRef = "";
            logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            sendPipelineInput = new Microsoft.XLANGs.Pipeline.SendPipelineInputMessages();
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("50406537-a39d-4160-8f89-72bf7f8b6b0f")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8bff185f-dfed-4bc8-95b4-c8183c3849ee")]
                    if (Message_Envelope(BTS.DestinationParty) == "CARRIER_EMAIL_VM")
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("e4de35c9-fabc-4791-9a24-1f05cbc33003")]
                        destinationPartyName = "CARRIER_EMAIL_VM";
                        schemaName = "EFACT_D16A_VERMAS";
                        emailType = "VERMAS";
                        emailSubject = xpath(Message_Envelope, "string(//*[local-name()='EmailSubject'])");
                        attachmentFileNameDefault = "VERMAS";
                        
                        logger.Log.DebugFormat(Message_Envelope(BTS.DestinationParty));
                    }
                    else if (Message_Envelope(BTS.DestinationParty) == "CARRIER_EMAIL_BK")
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("35ab405d-fad5-476c-94c9-78ade2d029ba")]
                        destinationPartyName = "CARRIER_EMAIL_BK";
                        schemaName = "EFACT_D99B_IFTMBF";
                        emailType = "Booking Request";
                        emailSubject = xpath(Message_Envelope, "string(//*[local-name()='EmailSubject'])");
                        attachmentFileNameDefault = "BookingRequest";
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("e511906f-79af-4bc8-a494-953bba0851eb")]
                        destinationPartyName = "CARRIER_EMAIL_SI";
                        schemaName = "EFACT_D99B_IFTMIN";
                        emailType = "Shipping Instruction";
                        emailSubject = xpath(Message_Envelope, "string(//*[local-name()='EmailSubject'])");
                        attachmentFileNameDefault = "ShippingInstruction";
                        
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6acb4873-1866-4e6c-8019-16227eb2870f")]
                    if (System.Convert.ToString(xpath(Message_Envelope, "string(//*[local-name()='" + schemaName + "'])")) != ""
                        )
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("a2ee6b97-6ce6-4738-9136-7a48e9fe2e12")]
                        construct Message_Xml, Message_Text
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("ebb8c19c-0639-45a2-99bd-19d577d87012")]
                            logger.Log.InfoFormat("Sending {0} Email. Outbox PK: {1}", emailType, Message_Envelope(CargoWise.eHub.Core.PropertySchemas.OutboxPK));
                            logger.Log.InfoFormat("schemaName: {0}, destinationPartyName: {1}, emailSubject: {2}", schemaName, destinationPartyName, emailSubject);
                            Message_Xml = xpath(Message_Envelope, "//*[local-name()='" + schemaName + "']");
                            Message_Xml(EDI.DestinationPartyName) = destinationPartyName;
                            
                            
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2c0d7deb-4341-4135-81da-8abae314faf8")]
                            logger.Log.DebugFormat("Executing Edi Assemble Pipeline.");
                            sendPipelineInput.Add(Message_Xml);
