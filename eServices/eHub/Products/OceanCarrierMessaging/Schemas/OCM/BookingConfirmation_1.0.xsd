<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="http://www.cargowise.com/Schemas/OCM/BookingConfirmation/1"
  targetNamespace="http://www.cargowise.com/Schemas/OCM/BookingConfirmation/1"
  elementFormDefault="qualified" version="1.0">
  <xs:element name="BookingConfirmation">
    <xs:complexType>
      <xs:sequence minOccurs="0">
        <xs:element name="MessageContext">
          <xs:complexType>
            <xs:sequence minOccurs="1">
              <xs:element minOccurs="0" name="SenderID">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="36"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="RecipientID">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="36"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="MessageDateTime">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="MessageNumber">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="35"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" name="ServiceType" type="ServiceType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" name="ConfirmationDatetime" type="xs:string"/>
        <xs:element minOccurs="0" name="ConfirmationType" type="ConfirmationType"/>
        <xs:element minOccurs="0" ref="Contact"/>
        <xs:element minOccurs="0" name="ReferenceNumberCollection">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element maxOccurs="unbounded" minOccurs="0" name="ReferenceNumber">
                <xs:complexType mixed="true">
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="Type" type="ReferenceNumberType"/>
                    <xs:element minOccurs="0" name="Value" type="StringMaxLength35"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" name="RemarkCollection">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element maxOccurs="unbounded" minOccurs="0" name="Remark">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="Type" type="RemarkType"/>
                    <xs:element minOccurs="0" name="Value" type="StringMaxLength512"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" name="LocationCollection">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element maxOccurs="unbounded" minOccurs="0" name="Location">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="Type" type="LocationType"/>
                    <xs:element minOccurs="0" name="UNLOCode">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="5"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="Name">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="35"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" ref="Country"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element maxOccurs="1" minOccurs="0" name="OrganizationAddressCollection">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element maxOccurs="unbounded" minOccurs="0" name="OrganizationAddress">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="Type" type="PartyType"/>
                    <xs:element minOccurs="0" name="OrganizationCode">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="12"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="Name">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="100"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="StreetAddress1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="StreetAddress2">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="City">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="25"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="Postcode">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="10"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="State">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="25"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" ref="Country"/>
                    <xs:element minOccurs="0" ref="Contact"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="DateTimeCollection" minOccurs="0">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element minOccurs="0" name="DateTime" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="Type" type="DateTimeType"/>
                    <xs:element minOccurs="0" name="Value" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" name="TransportLegCollection">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element maxOccurs="unbounded" minOccurs="0" name="TransportLeg">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="Type" type="TransportLegType"/>
                    <xs:element minOccurs="0" name="Mode" type="TransportLegMode"/>
                    <xs:element minOccurs="0" name="LegOrder" type="xs:byte"/>
                    <xs:element minOccurs="0" name="VesselName">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="35"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="VoyageNumber">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="10"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="LloydsNumber">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="7"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="CarrierCode">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="4"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" name="LocationCollection">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element maxOccurs="unbounded" minOccurs="0" name="Location">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type"
                                  type="TransportLegLocationType"/>
                                <xs:element minOccurs="0" name="UNLOCode">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="5"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="Name">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="35"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" ref="Country"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="DateTimeCollection" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element minOccurs="0" name="DateTime" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type"
                                  type="TransportLegDateTimeType"/>
                                <xs:element minOccurs="0" name="Value" type="xs:string"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" name="EquipmentCollection">
          <xs:complexType>
            <xs:sequence minOccurs="0">
              <xs:element maxOccurs="unbounded" minOccurs="0" name="Equipment">
                <xs:complexType>
                  <xs:sequence minOccurs="0">
                    <xs:element minOccurs="0" name="EquipmentNumber">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element minOccurs="0" name="Type" type="EquipmentNumberType"/>
                          <xs:element minOccurs="0" name="Value" type="StringMaxLength20"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="EquipmentType">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="StringMaxLength4">
                            <xs:attribute name="Description" type="StringMaxLength35"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="EquipmentOwner" type="EquipmentOwnerType"/>
                    <xs:element minOccurs="0" name="EquipmentShippedStatus"
                      type="EquipmentShippedStatusType"/>
                    <xs:element minOccurs="0" name="EquipmentCount" type="xs:int"/>
                    <xs:element minOccurs="0" name="HaulageArrangement">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="StringMaxLength2">
                            <xs:attribute name="Description" type="HaulageArrangementDesc"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="SpecialHandlingCollection">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element maxOccurs="9" minOccurs="0" name="SpecialHandling">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type"
                                  type="EquipmentSpecialHandlingType"/>
                                <xs:element minOccurs="0" name="Value" type="xs:string"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="SealNumberCollection">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element maxOccurs="unbounded" minOccurs="0" name="SealNumber">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type" type="EquipmentSealNumberType"/>
                                <xs:element minOccurs="0" name="Value" type="StringMaxLength20"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="RemarkCollection">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element maxOccurs="unbounded" minOccurs="0" name="Remark">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type" type="EquipmentRemarkType"/>
                                <xs:element minOccurs="0" name="Value" type="StringMaxLength512"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element minOccurs="0" name="ReferenceNumberCollection">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element maxOccurs="unbounded" minOccurs="0" name="ReferenceNumber">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type"
                                  type="EquipmentReferenceNumberType"/>
                                <xs:element minOccurs="0" name="Value" type="StringMaxLength35"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element maxOccurs="1" minOccurs="0" name="OrganizationAddressCollection">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element maxOccurs="1" minOccurs="0" name="OrganizationAddress">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type" type="EquipmentPartyType"/>
                                <xs:element minOccurs="0" name="OrganizationCode">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="12"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="Name">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="100"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="StreetAddress1">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="50"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="StreetAddress2">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="50"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="City">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="25"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="Postcode">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="10"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" name="State">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="25"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element minOccurs="0" ref="Country"/>
                                <xs:element minOccurs="0" ref="Contact"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="DateTimeCollection" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence minOccurs="0">
                          <xs:element minOccurs="0" name="DateTime" maxOccurs="1">
                            <xs:complexType>
                              <xs:sequence minOccurs="0">
                                <xs:element minOccurs="0" name="Type"
                                  type="EquipmentPartyDateTimeType"/>
                                <xs:element minOccurs="0" name="Value" type="xs:string"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Contact">
    <xs:complexType>
      <xs:sequence minOccurs="0">
        <xs:element minOccurs="0" name="Name">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="50"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" name="Phone">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="20"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" name="Email">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="60"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" name="Fax">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="20"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Country">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="StringMaxLength2">
          <xs:attribute name="Name" type="StringMaxLength35"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="MessageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BookingConfirmation"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ConfirmationType">
    <xs:annotation>
      <xs:documentation>PP-Pending Processing, CA-Conditionally Accepted, AP-Accepted, CR-Confirmation Replacement, RE-Booking Rejected, CN-Booking Cancelled</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AP"/>
      <xs:enumeration value="CA"/>
      <xs:enumeration value="AP"/>
      <xs:enumeration value="CR"/>
      <xs:enumeration value="RE"/>
      <xs:enumeration value="CN"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceType">
    <xs:annotation>
      <xs:documentation>VOCC, NVOCC</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="VOCC"/>
      <xs:enumeration value="NVOCC"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RemarkType">
    <xs:annotation>
      <xs:documentation>GeneralRemarks, CancellationReason, RejectionReason</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="GeneralRemarks"/>
      <xs:enumeration value="CancellationReason"/>
      <xs:enumeration value="RejectionReason"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReferenceNumberType">
    <xs:annotation>
      <xs:documentation>MessageReference, BookingNumber, ForwarderReference, ShipperReference, BillOfLadingNumber</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="MessageReference"/>
      <xs:enumeration value="BookingNumber"/>
      <xs:enumeration value="ForwarderReference"/>
      <xs:enumeration value="ShipperReference"/>
      <xs:enumeration value="BillOfLadingNumber"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DateTimeType">
    <xs:annotation>
      <xs:documentation>EstimatedPickupFrom, EstimatedDeliverTo, VGMCutOffDate, DocumentCutOffDate, FCLClosingDate, LCLClosingDate</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="EstimatedPickupFrom"/>
      <xs:enumeration value="EstimatedDeliverTo"/>
      <xs:enumeration value="VGMCutOffDate"/>
      <xs:enumeration value="DocumentCutOffDate"/>
      <xs:enumeration value="FCLClosingDate"/>
      <xs:enumeration value="LCLClosingDate"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LocationType">
    <xs:annotation>
      <xs:documentation>PlaceOfReceipt, PlaceOfDelivery</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="PlaceOfReceipt"/>
      <xs:enumeration value="PlaceOfDelivery"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TransportLegMode">
    <xs:annotation>
      <xs:documentation>Sea, Road, Rail</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Sea"/>
      <xs:enumeration value="Road"/>
      <xs:enumeration value="Rail"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TransportLegType">
    <xs:annotation>
      <xs:documentation>Main, PreCarriage, OnForwarding</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Main"/>
      <xs:enumeration value="PreCarriage"/>
      <xs:enumeration value="OnForwarding"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TransportLegDateTimeType">
    <xs:annotation>
      <xs:documentation>EstimatedDeparture, EstimatedArrival</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="EstimatedDeparture"/>
      <xs:enumeration value="EstimatedArrival"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TransportLegLocationType">
    <xs:annotation>
      <xs:documentation>PortOfLoading, PortOfDischarge</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="PortOfLoading"/>
      <xs:enumeration value="PortOfDischarge"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PartyType">
    <xs:annotation>
      <xs:documentation>BookingParty, Carrier, DepartureTerminal, ArrivalTerminal, PickupFrom, DeliverTo</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BookingParty"/>
      <xs:enumeration value="Carrier"/>
      <xs:enumeration value="DepartureTerminal"/>
      <xs:enumeration value="ArrivalTerminal"/>
      <xs:enumeration value="PickupFrom"/>
      <xs:enumeration value="DeliverTo"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EquipmentNumberType">
    <xs:annotation>
      <xs:documentation>Actual, Logical</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="Actual"/>
      <xs:enumeration value="Logical"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EquipmentSpecialHandlingType">
    <xs:annotation>
      <xs:documentation>NonOperativeReefer, VentSetting</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="NonOperativeReefer"/>
      <xs:enumeration value="VentSetting"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EquipmentRemarkType">
    <xs:annotation>
      <xs:documentation>EquipmentRemarks</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="EquipmentRemarks"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EquipmentReferenceNumberType">
