                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:maxLength value="10"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="FlashpointFlag" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>"F" = Fahrenheit "C" = Centigrade</xs:documentation>
                            </xs:annotation>
