<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2014 rel. 2 sp1 (http://www.altova.com) by NACA (NACA - dba Vanguard Logistics Services) -->
<!-- SHORTCUT:XST -->
<!-- LONGNAME:XML Ocean Bill of Lading Instructions-->
<!-- USED_BY: Vanguard internal use only-->
<!-- REVISION: 03.00 - 06/01/2010 jpatstone -->
<!-- Standardized all VLS schemas. -->
<!-- REVISION: 03.02 - 07/28/10 jpatstone -->
<!-- Made Parties unbounded. -->
<!-- REVISION: 03.03 - 09/08/10 jpatstone -->
<!-- Added CommodityCode for Expeditors. -->
<!-- REVISION: 03.04 - 07/16/12 jpatstone -->
<!-- Made the AESNumber tag unbounded (repeatable). -->
<!-- REVISION: 03.05 - 12/07/12 tluu -->
<!-- Added AlternateDescription -->
<!-- REVISION: 03.06 - 26/30/13 tluu -->
<!-- Made ETD, ETA, Voyage, NumberCopies, CustomerReference,VesselName optional-->
<!-- ShippingName tag, changed to optional, fixed the length from 30 - 50 and allowed to be repeat 3 max-->
<!-- AddFreightPayableAt, EmergencyContact, EmergencyPhoneArea, EmgercencyPhone, Comments, BLClause tags -->
<!-- REVISION: 03.06 - 01/04/13 tluu -->
<!-- Changed FreightPayableAt to two tags PayableAtCode and PayableAtName-->
<!-- REVISION: 03.06 - 08/05/13 tluu -->
<!-- Corrected DateOfIssue, changed from mandatory to optional-->
<!-- REVISION: 03.07 - 29-JUL-2014 tluu -->
<!-- Added BillOfLadingNumber tag-->
<!-- REVISION: 03.08 - 26-AUG-2014 tluu -->
<!-- Added ContactName, ContactPhoneArea, ontactPhone, ContactFaxArea, -->
<!--ContactFax and ContactEmail under Parties level-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
            targetNamespace="http://www.cargowise.com/Schemas/VANGUARD" 
            xmlns="http://www.cargowise.com/Schemas/VANGUARD"
            attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            version="03.08">
  <xsd:element name="OBLInstructions">
    <xsd:annotation>
      <xsd:documentation>Ocean Bill of Lading Instructions (aka SLI).</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="Envelope">
          <xsd:annotation>
            <xsd:documentation>Delivery details of the message.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="SenderID">
                <xsd:annotation>
                  <xsd:documentation>Code identifying who is sending the message.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="ReceiverID">
                <xsd:annotation>
                  <xsd:documentation>Code identifying who will receive the message.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="MessageType">
                <xsd:annotation>
                  <xsd:documentation>Coded name of the message.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="40"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="MessageVersion" type="VersionType">
                <xsd:annotation>
                  <xsd:documentation>Version number of the schema.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="EnvelopeID">
                <xsd:annotation>
                  <xsd:documentation>Unique identification number of the message.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="TransmissionDate" type="xsd:date">
                <xsd:annotation>
                  <xsd:documentation>Date the message was created. (YYYY-MM-DD)</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="TransmissionTime" type="xsd:time">
                <xsd:annotation>
                  <xsd:documentation>Time the message was created. (HH:MM:SS)</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="BLDetails">
          <xsd:annotation>
            <xsd:documentation>Details of the Bill of Lading.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="RequestType">
                <xsd:annotation>
                  <xsd:documentation>"N"=New, "U"=Update</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:minLength value="1"/>
                    <xsd:maxLength value="1"/>
                    <xsd:enumeration value="N"/>
                    <xsd:enumeration value="U"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="BookingNumber">
                <xsd:annotation>
                  <xsd:documentation>Vanguard Booking Number.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="BillOfLadingNumber" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>Vanguard Bill of Lading Number.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="CustomerControlCode" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>Code indicating the Booking Office to use.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="CommunicationReference">
                <xsd:annotation>
                  <xsd:documentation>Customer internal reference number.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="CustomerReference" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>Customer Reference Number.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="0"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="CustomerContact">
                <xsd:annotation>
                  <xsd:documentation>Customer Contact Name.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="CustomerPhone">
                <xsd:annotation>
                  <xsd:documentation>Customer Contact Phone Number.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="20"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="CustomerEmail">
                <xsd:annotation>
                  <xsd:documentation>Customer Contact Email Address.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="50"/>
                    <xsd:minLength value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="Remarks" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation>External Comments.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="40"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="BLClause" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation>External Comments.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:maxLength value="40"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element name="SailingDetails" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>Vessel and Routing details.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="VesselVoyageID" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Vanguard's unique ID for Vessel/Voyage/Origin/Destination set.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="20"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="VesselName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Vessel Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="30"/>
                          <xsd:minLength value="0"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="IMONumber" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Lloyd's Registration Number.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="7"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="Voyage" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Voyage Number.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="10"/>
                          <xsd:minLength value="0"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="ETD" type="xsd:date" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Estimated Date of Departure. (YYYY-MM-DD)</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="ETA" type="xsd:date" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Estimated Date of Arrival. (YYYY-MM-DD)</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PlaceOfReceipt" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Place of Receipt UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PlaceOfReceiptName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Place of Receipt City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="CFSOrigin" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>CFS Place of Origin UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="CFSOriginName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>CFS Place of Origin City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PortOfLoading" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Port of Loading UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PortOfLoadingName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Port of Loading City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PortOfTransshipment" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Port of Transshipment UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PortOfTransshipmentName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Port of Transshipment City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PortOfDischarge" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Port of Discharge UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PortOfDischargeName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Port of Discharge City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="CFSDestination" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>CFS Place of Destination UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="CFSDestinationName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>CFS Place of Destination  City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PlaceOfDelivery" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Place of Delivery UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PlaceOfDeliveryName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Place of Delivery City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="CargoDetails" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation>If BookingType="L" then CargoDetails is mandatory.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="ShippingMarks" minOccurs="0" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>Marks and Numbers.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="Pieces" type="xsd:integer">
                      <xsd:annotation>
                        <xsd:documentation>Number of Pieces.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Packaging">
                      <xsd:annotation>
                        <xsd:documentation>Package Type.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="20"/>
                          <xsd:minLength value="1"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="Commodity" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>Description of Goods.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                          <xsd:minLength value="1"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="AlternateDescription" minOccurs="0" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>Alternate Lading  Description.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="CommodityCode" minOccurs="0" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>Commodity/Harmonized System Code. </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="30"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="Weight" type="xsd:float">
                      <xsd:annotation>
                        <xsd:documentation>Commodity Weight.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="Volume" type="xsd:float">
                      <xsd:annotation>
                        <xsd:documentation>Commodity Volume.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="UOM">
                      <xsd:annotation>
                        <xsd:documentation>
                          "E"=English
                          "M"=Metric
                        </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="1"/>
                          <xsd:enumeration value="M"/>
                          <xsd:enumeration value="E"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="HazardousFlag">
                      <xsd:annotation>
                        <xsd:documentation>
                          "Y"=Commodity is hazardous
                          "N"=Commodity is not.
                        </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="1"/>
                          <xsd:enumeration value="N"/>
                          <xsd:enumeration value="Y"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="HazardousDetails" minOccurs="0" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>If HazardousFlag="Y" then HazadousDetails is mandatory.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="HazardousClass">
                            <xsd:annotation>
                              <xsd:documentation>Hazardous Classification Number.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="10"/>
                                <xsd:minLength value="1"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="Flashpoint" minOccurs="0">
                            <xsd:annotation>
                              <xsd:documentation>Flashpoint Termperature.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="10"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="FlashpointUOM" minOccurs="0">
                            <xsd:annotation>
                              <xsd:documentation>"F"=Fahrenheit, "C"=Centigrade.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="1"/>
                                <xsd:enumeration value="F"/>
                                <xsd:enumeration value="C"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="ShippingName" minOccurs="0" maxOccurs="3">
                            <xsd:annotation>
                              <xsd:documentation>Technical Name of Hazardous Goods.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="50"/>
                                <xsd:minLength value="0"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="UNNumber">
                            <xsd:annotation>
                              <xsd:documentation>UN Number of Hazardous Goods.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="10"/>
                                <xsd:minLength value="1"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="PackingGroup">
                            <xsd:annotation>
                              <xsd:documentation>Hazardous Packing Group Code.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="3"/>
                                <xsd:minLength value="1"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="EmergencyContact" minOccurs="0">
                            <xsd:annotation>
                              <xsd:documentation>Emergency Contact Name.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="35"/>
                                <xsd:minLength value="0"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="EmergencyPhoneArea" minOccurs="0">
                            <xsd:annotation>
                              <xsd:documentation>Emergency Contact Phone Area Code</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="5"/>
                                <xsd:minLength value="0"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="EmergencyPhone" minOccurs="0">
                            <xsd:annotation>
                              <xsd:documentation>Emergency Contact Phone Number.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="20"/>
                                <xsd:minLength value="0"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element name="Comments" minOccurs="0" maxOccurs="10">
                            <xsd:annotation>
                              <xsd:documentation>Hazardous Details Comments</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:maxLength value="60"/>
                                <xsd:minLength value="0"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="ContainerDetails" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation>If BookingType="F" then ContainerDetails is mandatory.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="ContainerNumber">
                      <xsd:annotation>
                        <xsd:documentation>Container Number including SCAC, number and check digit (eg. SUDU123456-7).</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="12"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="ContainerType" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Container Type Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="6"/>
                          <xsd:enumeration value="20G0"/>
                          <xsd:enumeration value="20G1"/>
                          <xsd:enumeration value="20H1"/>
                          <xsd:enumeration value="20T0"/>
                          <xsd:enumeration value="22B0"/>
                          <xsd:enumeration value="22G0"/>
                          <xsd:enumeration value="22G1"/>
                          <xsd:enumeration value="22H2"/>
                          <xsd:enumeration value="22P1"/>
                          <xsd:enumeration value="22P2"/>
                          <xsd:enumeration value="22P3"/>
                          <xsd:enumeration value="22P5"/>
                          <xsd:enumeration value="22R0"/>
                          <xsd:enumeration value="22R1"/>
                          <xsd:enumeration value="22T0"/>
                          <xsd:enumeration value="22T5"/>
                          <xsd:enumeration value="22U0"/>
                          <xsd:enumeration value="22U1"/>
                          <xsd:enumeration value="22V0"/>
                          <xsd:enumeration value="25G0"/>
                          <xsd:enumeration value="25R1"/>
                          <xsd:enumeration value="26T0"/>
                          <xsd:enumeration value="28P0"/>
                          <xsd:enumeration value="28U1"/>
                          <xsd:enumeration value="42B0"/>
                          <xsd:enumeration value="42G0"/>
                          <xsd:enumeration value="42G1"/>
                          <xsd:enumeration value="42P1"/>
                          <xsd:enumeration value="42P2"/>
                          <xsd:enumeration value="42P3"/>
                          <xsd:enumeration value="42P5"/>
                          <xsd:enumeration value="42R0"/>
                          <xsd:enumeration value="42R1"/>
                          <xsd:enumeration value="42U1"/>
                          <xsd:enumeration value="45G0"/>
                          <xsd:enumeration value="45P8"/>
                          <xsd:enumeration value="45R1"/>
                          <xsd:enumeration value="48P0"/>
                          <xsd:enumeration value="48U1"/>
                          <xsd:enumeration value="L5G1"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="ContainerQuantity" type="xsd:integer" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Number of Containers.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="InstructionDetails">
                <xsd:annotation>
                  <xsd:documentation>Details of the Instruction.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="TransportType">
                      <xsd:annotation>
                        <xsd:documentation>
                          1 = Port / Port
                          2 = Point / Port
                          3 = Port / Point
                          4 = Point / Point
                        </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="1"/>
                          <xsd:enumeration value="1"/>
                          <xsd:enumeration value="2"/>
                          <xsd:enumeration value="3"/>
                          <xsd:enumeration value="4"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="OBLType">
                      <xsd:annotation>
                        <xsd:documentation>
                          "1" = Bill of Lading
                          "2" = Sea Waybill
                        </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="1"/>
                          <xsd:enumeration value="1"/>
                          <xsd:enumeration value="2"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="OBLNumber" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Preadvised OBL Number.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="20"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="AESNumber" minOccurs="0" maxOccurs="unbounded">
                      <xsd:annotation>
                        <xsd:documentation>Automated Export System Number.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="20"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="NumberOriginals" type="xsd:integer" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Mandatory for OBLType 1</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="NumberCopies" type="xsd:integer" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Number of document copies to provide.</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="FreightPaymentIndicator">
                      <xsd:annotation>
                        <xsd:documentation>
                          "P" = Prepaid
                          "C" = Collect
                        </xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="1"/>
                          <xsd:enumeration value="P"/>
                          <xsd:enumeration value="C"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PlaceOfIssue" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Place of Issue UN Location Code.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PlaceOfIssueName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Place of Issue City Name.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="DateOfIssue" type="xsd:date" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>(YYYY-MM-DD)</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element name="PayableAtCode" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Freight Payable To UNLOCODE</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="5"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="PayableAtName" minOccurs="0">
                      <xsd:annotation>
                        <xsd:documentation>Freight Payable To Name Free Form</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:maxLength value="35"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element ref="Parties" maxOccurs="unbounded"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:simpleType name="VersionType">
    <xsd:restriction base="xsd:string">
      <xsd:length value="5"/>
      <xsd:pattern value="\d{2}.\d{2}"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:element name="Parties">
    <xsd:annotation>
      <xsd:documentation>Party Addresses.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="PartyType" nillable="false">
          <xsd:annotation>
            <xsd:documentation>
              "CN"=Consignee
              "FW"=Forwarder
              "N1"=Notify Party 1
              "N2"=Notify Party 2
              "SH"=Shipper
              "SU"=Supplier
            </xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:minLength value="2"/>
              <xsd:maxLength value="2"/>
              <xsd:enumeration value="SH"/>
              <xsd:enumeration value="CN"/>
              <xsd:enumeration value="N1"/>
              <xsd:enumeration value="N2"/>
              <xsd:enumeration value="FW"/>
              <xsd:enumeration value="SU"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="PartyID" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Code identifying the Party.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="20"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="PartyName">
          <xsd:annotation>
            <xsd:documentation>Name of the Party.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:minLength value="1"/>
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="Address" minOccurs="0" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation>Free-form address (recurring, as needed).</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:minLength value="1"/>
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="City" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>City Name.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="StateProvince" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>State or Province.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="PostalCode" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Postal or Zip Code.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="Country" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Country.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="UNLocCode" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>UN Location Code.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="5"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactFirstName" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Contact first name</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="70"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactLastName" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Contact last name.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="35"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactPhoneArea" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Phone Number of contact.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="5"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactPhone" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Phone Number of contact.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="25"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactFaxArea" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Fax Number of contact.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="5"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactFax" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Fax Number of contact.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="25"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ContactEmail" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Email address of contact.</xsd:documentation>
          </xsd:annotation>
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:maxLength value="50"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
