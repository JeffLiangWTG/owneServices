<!-- SHORTCUT:XST -->
<!-- LONGNAME:XML Booking Request -->
<!-- USED_BY: Vanguard internal use only -->
<!-- REVISION: 03.00 - 06/01/2010 jpatstone -->
<!-- Standardized all VLS schemas. -->
<!-- REVISION: 03.01 - 06/10/2010 jpatstone -->
<!-- Added tags required for Caterpillar (Parties, PartDetails, Facility/Dock Codes). -->
<!-- REVISION: 03.03 - 10/28/2010 jpatstone -->
<!-- Added ETD and ETA tags. -->
<!-- REVISION: 03.03 - 08/10/2012 tluu -->
<!-- Added BusinessType, LoadPort, TRSPort, DischargePort tags. -->
<!-- REVISION: 03.04 - 26/02/2013 tluu -->
<!-- Added EmergencyContact, EmergencyPhoneArea, and EmgercencyPhone tags -->
<!-- REVISION: 03.04 - 13/03/2013 tluu -->
<!-- Added Comments tag under HazardousDetails -->
<!-- REVISION: 03.04 - 01/04/2013 tluu -->
<!-- Made, LoadPort, TRSPort, DischargePort tags optional  -->
<!-- REVISION: 03.05 - 10-DEC-2013 tluu (changing the format of the revision date moving foward) -->
<!-- Added Length, Width, and Height tags-->
<!-- REVISION: 03.05 - 28-MAR-2014 tluu (found optional tags with min length of '1' should be '0') -->
<!-- Corrected CommunicationReference, ContractNumber, CustomerContact, CustomerPhone, CustomerEmail-->
<!-- REVISION: 03.06 - 17-SEP-2014 tluu -->
<!-- Added OwnerID and ManageBy tags-->
<!-- REVISION: 03.06 - 19-SEP-2014 tluu -->
<!-- Corrected maximum occurrence on Address tag. Originally unbounded, should be maximum 5 -->
<!-- REVISION: 03.07 - 11-NOV-2014 tluu -->
<!-- Added FreightPaymentIndicator -->
