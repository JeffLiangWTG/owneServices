<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="1.0">
    <xsd:complexType name="ZPARTY">
        <xsd:annotation>
            <xsd:documentation>Client Information</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="ASEC" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>ASEC number</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="5" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="BN9" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Client BN9</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="9" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME" minOccurs="1" maxOccurs="1" type="ZNAME" />
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ZNAME">
        <xsd:annotation>
            <xsd:documentation>Client Name</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="NAME_ORG1" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Numeric Data Type Char. 44</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="44" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG2" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Numeric Data Type Char. 44</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="44" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG3" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Numeric Data Type Char. 44</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="44" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG4" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Character field of length 43</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="43" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ZIMPORTER">
        <xsd:annotation>
            <xsd:documentation>Importer Identification</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="BN15" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>BN15</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="15" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG1" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Numeric Data Type Char. 44</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="44" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG2" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Numeric Data Type Char. 44</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="44" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG3" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Numeric Data Type Char. 44</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="44" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="NAME_ORG4" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Character field of length 43</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="43" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ZTOTALS">
        <xsd:annotation>
            <xsd:documentation>Importer Totals on the Daily Notice</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="DUTIES_TOT" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Customs Duties</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="SIMA_TOT" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>SIMA LMSI</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="EXCISE_TOT" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Excise Tax</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="GST_TOT" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>GST/HST/PST</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="OTHERS_TOT" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Other Receivables</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="TOTALS_TOT" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Total of all totals</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="RECS_TOT" minOccurs="1" maxOccurs="1" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Number of line items</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ZOTHTAB">
        <xsd:annotation>
            <xsd:documentation>Others Tables</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="item" type="ZOTHERTR" minOccurs="0" maxOccurs="unbounded" />
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ZOTHERTR">
        <xsd:annotation>
            <xsd:documentation>Other and Under Review Transactions</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="LINES" minOccurs="1" maxOccurs="1" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Number of line items</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="DOC_DATE" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Date</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:pattern value="....-..-.." />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="DOC_TYPE" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Document Type Description</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="20" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="DOC_NUMBER" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Reference document number</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="16" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="REL_DOC_NUMBER" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Reference document number</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="16" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="PAY_DUE" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Date</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:pattern value="....-..-.." />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="TOT_DUE" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Total of each receivable per type</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="STATUS" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Status of penalities, enforcement actions, DAS-AR decisions</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="1" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="REVIEW" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Penalty, enforcement action, or DAS A-R under review</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="1" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="ZAMOUNTS">
        <xsd:annotation>
            <xsd:documentation>Amounts on Daily Notice and SoA</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="DUTIES" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Customs Duties</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="SIMA" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>SIMA LMSI</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="EXCISE" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Excise Tax</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="GST" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>GST/HST/PST</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="OTHERS" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Other Receivables</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="TOTAL" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Total of each receivable per type</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:decimal">
                        <xsd:totalDigits value="13" />
                        <xsd:fractionDigits value="2" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>

