                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("6a5ad08c-c458-4b13-a117-165f2b6ff7de")]
                    outboxRootElementName = (xpath(OutboxACASBRMsg,"name(/*)"));
                    
                    recipient = OutboxACASBRMsg(BTS.DestinationParty);
                    responseACASSenderID = CargoWise.eHub.Products.ACAS.BR.Helpers.OrchestrationHelper.GetResponseSenderID(recipient);
                    cw1ClientID = OutboxACASBRMsg(BTS.SourceParty);
                    clientSystemID = cw1ClientID.Substring(0,3) + cw1ClientID.Substring(6,3);
                    messageTrackingID = OutboxACASBRMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);
                    outboxPK = OutboxACASBRMsg(CargoWise.eHub.Core.PropertySchemas.OutboxPK);
                    inboxPK = OutboxACASBRMsg(CargoWise.eHub.Core.PropertySchemas.InternalTrackingID);
                    retryCount = 0;
                    getAuthAndSend = true;
                    shouldRetrySend = true;
                    successSent = false;
                    Prefix = "(" + messageTrackingID + ")";
                    
                    
                    logger.Log.InfoFormat("{0} Starting [Message Name: {1}]", Prefix, outboxRootElementName);
                    
                    PR_PK = OutboxACASBRMsg(CargoWise.eHub.Core.PropertySchemas.OverrideEmailSubject);
                    xmlString = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetAsyncPollingConfig_WithRetries(PR_PK, logger.Log);
                    if (System.String.IsNullOrEmpty(xmlString))
                    {
                        throw new System.ApplicationException("Unable to find matching eHubAsyncPollingRegistration with PR_PK = " + PR_PK);
                    }
                    logger.Log.DebugFormat("{0} eHubAsyncPollingRegistration with PK='{1}', \r\nXML={2}", Prefix, PR_PK, xmlString);
                    asyncPollingConfig = new System.Xml.XmlDocument();
                    asyncPollingConfig.LoadXml(xmlString);
                    cnpj = CargoWise.eHub.Products.ACAS.BR.Helpers.eHubAsyncPollingRegistrationHelper.GetAsyncPollingConfig(asyncPollingConfig, "CNPJ");
                    staffID = CargoWise.eHub.Products.ACAS.BR.Helpers.eHubAsyncPollingRegistrationHelper.GetAsyncPollingConfig(asyncPollingConfig, "StaffID");
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ff032327-b977-4023-b0e1-c5f3b0c207b8")]
                    scope
                    {
                        body
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("69b5befa-1f86-477a-8965-e89824c1e3c8")]
