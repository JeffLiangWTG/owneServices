        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("26ff9462-387a-4e14-9a00-c5ad53dea69f")]
            activate ((CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient") && (BTS.DestinationParty == "ACAS_BR_FHL") || (CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient") && (BTS.DestinationParty == "ACAS_BR_FHL_TST") || (CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient") && (BTS.DestinationParty == "ACAS_BR_FZB") || (CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient") && (BTS.DestinationParty == "ACAS_BR_FZB_TST"))receive (ReceiveOutboxACASBRMsgPort.Op, OutboxACASBRMsg);
            isNonXml = false;
            shouldRetrySend = true;
            recipient = "";
            cw1ClientID = "";
            staffID = "";
            messageTrackingID = "";
            outboxRootElementName = "";
            retryCount = 0;
            logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            endPoint = "";
            cnpj = "";
            reasonResult = "";
            inboxPK = "";
            xmlString = "";
            isSuccessful = true;
            shouldSendNotification = true;
            outboxPK = "";
            Prefix = "";
            PR_PK = "";
            statusCodeDescription = "";
            responseACASSenderID = "";
            emptyString = "";
            errorDescription = "";
            getAuthAndSend = true;
            authorizationHeaders = "";
            successSent = true;
            clientSystemID = "";
            inboxRecipientID = "";
            CCTResponseString = "";
            asyncPollingConfig = new System.Xml.XmlDocument();
