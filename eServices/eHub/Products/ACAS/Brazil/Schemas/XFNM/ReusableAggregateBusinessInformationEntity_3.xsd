    xmlns:qdt="urn:un:unece:uncefact:data:standard:QualifiedDataType:7"
    xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:8"
    targetNamespace="iata:datamodel:3"
