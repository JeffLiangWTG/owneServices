                                    if (isProtocolFound)
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("5e5e4052-958c-4585-80a1-fe7ef75882bc")]
                                        construct SqlMsg
                                        {
                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2621ecc3-4c49-4336-90de-162d8df27689")]
                                            
                                            SqlMsg = CargoWise.eHub.Products.ACAS.BR.Helpers.OrchestrationHelper.GetWcfInsertInboxAndDeleteAsyncPollingRegistration(pollingRegistrationPk, clientID, responseACASSenderID, msgXml.InnerXml);
                                            SqlMsg(WCF.Action) = "CompositeOperation";
                                            
                                            logger.Log.InfoFormat(@"Inbox and update operation for Protocol Number: {0} polling registration PK {1}", protocolNumber, pollingRegistrationPk);
                                        }
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("b823bd0d-61c4-4819-b4bd-8fd0c202d4a5")]
                                        send (eHubTransactionsOpsPort.CompositeOperation, SqlMsg);
                                    }
                                    else 
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("3f4cb037-26f2-4fd7-8481-52ffc06aea3f")]
                                        logger.Log.DebugFormat("Protocol not found in CCT status response list - clientSystemID {0} StaffID {1} Protocol {2}", clientSystemID, staffId, protocolNumber);
                                        isSuccessful = false;
                                        error = "FileStatusNotReceived";
                                        errorText = "File Status not received for requested protocol";
                                    }
                                }
                                else 
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("34ba4f43-1513-490c-9373-aac20e7fb917")]
                                    logger.Log.DebugFormat("File Status not received - clientSystemID {0} StaffID {1}", clientSystemID, staffId);
                                    isSuccessful = false;
                                    error = "FileStatusNotReceived";
                                    errorText = "File Status not received";
                                }
                            }
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("470410bd-c60c-4c93-b196-551e50c06e7e")]
                            currentJobNumber = currentJobNumber + 1;
                            
                            if (!System.String.IsNullOrWhiteSpace(error))
                            {
                                logger.Log.ErrorFormat("Error processing protocol number {0}, clientSystemID {1} StaffID {2}. Error: {3} - {4}", protocolNumber, clientSystemID, staffId, error, errorText);
                            }
                        }
                    }
                    exceptions
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("f6b34614-fea1-4bd5-98ca-626ab4cfaa8d")]
                        catch (System.Exception ex)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("43ee3868-19d6-4b82-9a5e-31520c4dfca0")]
                            logger.Log.ErrorFormat("Fatal error processing job number {0}, clientSystemID {1} StaffID {2}. Error: {3}", currentJobNumber, clientSystemID, staffId, ex.ToString());
                        }
                    }
                }
            }
            else 
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("de3ddaee-37ab-4909-924e-b7d63a8ea84b")]
                logger.Log.Debug("Mutex found, Skipped!");
            }
        }
    }
