<?xml version="1.0" encoding="utf-8" ?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="ServiceName" value="USC_Inbound_Test_UEM" xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)"/>
    <add key="CertificationHostname" value="ordwp-ccmq-2-cert.wisecloud.zone" xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)"/>
    <add key="CertificationPassword" value="$CertificationPassword$" xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)"/>
  </appSettings>
  <connectionStrings>
    <add name="USCustoms" connectionString="Data Source=eHub-test.db.sand.wtg.zone, 1435;Initial Catalog=USCustoms;User Id=USCustoms;Password=$DatabasePassword$" xdt:Transform="SetAttributes"
         xdt:Locator="Match(name)"/>
  </connectionStrings>
</configuration>