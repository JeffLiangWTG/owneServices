<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup>
    <section name="PoisonMessageMQErrorCode" type="System.Configuration.NameValueSectionHandler" />
  </configSections>
  <common>
    <logging>
      <factoryAdapter type="Common.Logging.Log4Net.Log4NetLoggerFactoryAdapter, Common.Logging.Log4Net208">
        <arg key="configType" value="FILE-WATCH" />
        <arg key="configFile" value="~\CargoWise.eServices.USCustoms.OutboundProcessingService.log4net.config" />
      </factoryAdapter>
    </logging>
  </common>
  <appSettings>
    <add key="ServiceName" value="OutboundProcessingService" />
    <add key="ProductionHostname" value="localhost" />
    <add key="CertificationHostname" value="localhost" />
    <add key="ProductionPort" value="1414" />
    <add key="CertificationPort" value="1415" />
    <add key="ProductionQueueManager" value="QM_CRGWP" />
    <add key="CertificationQueueManager" value="QM_CRGWT" />
    <add key="AMSProductionQueueName" value="AMSP.OUTBOUND.TO.CBP" />
    <add key="AMSCertificationQueueName" value="AMST.OUTBOUND.TO.CBP" />
    <add key="AESProductionQueueName" value="AESP.OUTBOUND.TO.CBP" />
    <add key="AESCertificationQueueName" value="AEST.OUTBOUND.TO.CBP" />
    <add key="ABIProductionQueueName" value="ABIP.OUTBOUND.TO.CBP" />
    <add key="ABICertificationQueueName" value="ABIT.OUTBOUND.TO.CBP" />
    <add key="MANProductionQueueName" value="ACEP.OUTBOUND.TO.CBP" />
    <add key="MANCertificationQueueName" value="ACET.OUTBOUND.TO.CBP" />
    <add key="STWProductionQueueName" value="BAPLIE.OUTBOUND.TO.CBP" />
    <add key="STWCertificationQueueName" value="BAPLIE.OUTBOUND.TO.CBP" />
    <add key="AMAProductionQueueName" value="AMSP.AIR.OUTBOUND.TO.CBP"/>
    <add key="AMACertificationQueueName" value="AMST.AIR.OUTBOUND.TO.CBP"/>
    <add key="UEMSeaProductionQueueName" value="XPRTP.OUTBOUND.TO.CBP"/>
    <add key="UEMSeaCertificationQueueName" value="XPRTT.OUTBOUND.TO.CBP"/>
    <add key="UEMAirProductionQueueName" value="APRTP.OUTBOUND.TO.CBP"/>
    <add key="UEMAirCertificationQueueName" value="APRTT.OUTBOUND.TO.CBP"/>
    <add key="TransportType" value="MQSeries Managed Client" />
    <add key="IsProd" value="false" />
    <add key="ProductionUserId" value="EHUB_USR"/>
    <add key="CertificationUserId" value="EHUB_USR"/>
    <add key="ProductionPassword" value=""/>
    <add key="CertificationPassword" value=""/>
    <add key="ProductionChannel" value="EHUBP.SVRCONN"/>
    <add key="CertificationChannel" value="EHUBT.SVRCONN"/>
  </appSettings>
  <connectionStrings>
    <add name="USCustoms" connectionString="Data Source=localhost;Initial Catalog=USCustoms;Integrated Security=SSPI;" />
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="amqmdnet" publicKeyToken="dd3cb1c9aae9ec97" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.5.0.2" newVersion="7.5.0.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
</configuration>