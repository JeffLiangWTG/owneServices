<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
    <_BinPath>Bin</_BinPath>
    <_ServiceDisplayName>USC_Inbound_AMS</_ServiceDisplayName>
    <_ServiceName>USC_Inbound_AMS</_ServiceName>
    <_ServiceDescription>AMS inbound service.</_ServiceDescription>
    <_ServiceFilesPath>$(_BinPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eServices.USCustoms.InboundServiceAMS.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServices\USCustoms</_DeploymentFolder>
    <_BackupFolder>c:\eServices\Backup\USCustoms</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>
