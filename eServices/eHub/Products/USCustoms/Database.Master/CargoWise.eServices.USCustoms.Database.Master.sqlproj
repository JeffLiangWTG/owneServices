  <ItemGroup>
    <SqlCmdVariable Include="encryptionPassword">
      <Value>$(EncryptionPassword)</Value>
    </SqlCmdVariable>
  </ItemGroup>
  <Target Name="BeforeBuild">
    <PropertyGroup>
      <InputFile>%(DefaultSqlVariables.FullPath)</InputFile>
      <OutputFile>$(OutputPath)\%(DefaultSqlVariables.FileName).props</OutputFile>
      <EncryptionHelperPath>..\..\..\DevScripts\EhubEncryptionHelper.ps1</EncryptionHelperPath>
      <DecryptorAssemblyPath>..\..\..\Bin\CargoWise.eServices.Encryption.Server.Decryptor.dll</DecryptorAssemblyPath>
    </PropertyGroup>
    <ReadLinesFromFile File="%(KeyPassword.FullPath)">
      <Output TaskParameter="Lines" ItemName="EncryptedKeyPassword" />
    </ReadLinesFromFile>
    <Exec ConsoleToMSBuild="true" EchoOff="true" Condition="Exists('$(EncryptionHelperPath)') And Exists('$(DecryptorAssemblyPath)')" Command="powershell.exe –NonInteractive –ExecutionPolicy Unrestricted –command &quot;&amp; { . $(EncryptionHelperPath); Decrypt '@(EncryptedKeyPassword)' '$(DecryptorAssemblyPath)' }&quot;">
      <Output TaskParameter="ConsoleOutput" PropertyName="OutputPassword" />
    </Exec>
    <WriteLinesToFile File="$(OutputFile)" Lines="$([System.IO.File]::ReadAllText($(InputFile)).Replace('[PASSWORD]','$(OutputPassword)'))" Overwrite="true" Encoding="Unicode" />
  </Target>
</Project>