<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
        <_DeploymentPropsImported>$true</_DeploymentPropsImported>
		<_AppPoolName>$(_SiteName)</_AppPoolName>
		<_SiteName>JPCustomsGateway</_SiteName>
		<_ServiceName>JPCustomsGateway</_ServiceName>
		<_BackupFolder>c:\eServices\Backup\JPCustomsGateway</_BackupFolder>
		<_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
		<_LogsFolder>logs</_LogsFolder>
		<_EncryptConfigRequired>true</_EncryptConfigRequired>
		<_EncryptedSection>appSettings</_EncryptedSection>
	</PropertyGroup>
	<ItemGroup>
		<_Binding Include="1">
			<IPAddress>*</IPAddress>
			<Port>443</Port>
			<Protocol>https</Protocol>
		</_Binding>
	</ItemGroup>
