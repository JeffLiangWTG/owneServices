                                <om:Property Name="Expression" Value="messageBody = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(JPCustomsMessageRequest);&#xD;&#xA;Message = CargoWise.eHub.Core.Orchestrations.Helper.Messages.CreateMessageFromString(&quot;Body&quot;, messageBody);;&#xD;&#xA;logger.Log.Debug(&quot;Sending JP Customs Message&quot;);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" />
