                            <om:Property Name="Expression" Value="&#xD;&#xA;senderID = JPCustomsMessageRequest(BTS.SourceParty);&#xD;&#xA;messageTrackingID = JPCustomsMessageRequest(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);&#xD;&#xA;recipientID = JPCustomsMessageRequest(BTS.DestinationParty);&#xD;&#xA;outboxPK = JPCustomsMessageRequest(CargoWise.eHub.Core.PropertySchemas.OutboxPK);&#xD;&#xA;&#xD;&#xA;logger.Log.DebugFormat(&quot;Sending request to JP Customs Gateway messageTrackingID: {0}, SenderID:{1}, Recipient:{2}&quot;, messageTrackingID, senderID, recipientID);&#xD;&#xA;&#xD;&#xA;" />
