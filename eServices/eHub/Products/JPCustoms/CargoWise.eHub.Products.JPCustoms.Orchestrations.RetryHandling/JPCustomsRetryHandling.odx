                <RecipientID>{1}</RecipientID>
              </Header>
              <Body>
                {2}
              </Body>
            </UniversalInterchange>", recipientID, senderID, xmlString);
            
            xmlDoc.LoadXml(xmlString);
            notificationMessage = xmlDoc.OuterXml;
            logger.Log.Info("Call DeliveryNotification Update Message Status");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f981b96c-da85-4532-94bf-ab3ffca812bb")]
            call CargoWise.eHub.Core.Orchestrations.DeliveryNotificationProcessing.ProcessDeliveryNotifications (senderID, logger, recipientID, notificationMessage, shouldSendNotification, outboxPK, inboxPK, messageTrackingID, exceptionMessage, isSuccessful);
        }
    }
