[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module CargoWise.eHub.Products.JPCustoms.Orchestrations
{
    public porttype BiztalkMessageBox
    {
        oneway Operation
        {
            System.Xml.XmlDocument
        };
    };
    internal porttype JPCustomGatewayPortType
    {
        requestresponse Operation
        {
            System.Xml.XmlDocument, System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service RetryHandling
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding()]
        port implements BiztalkMessageBox BizTalkMessageBox;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses JPCustomGatewayPortType JPCustomGateway;
        message System.Xml.XmlDocument JPCustomsMessageRequest;
        message System.Xml.XmlDocument JPCustomsMessageResponse;
        message System.Xml.XmlDocument Message;
        System.String recipientID;
        System.String senderID;
        CargoWise.eHub.Core.Logging.OrchestrationLogger logger;
        System.Boolean exit;
        System.Int32 retryTimes;
        System.Int32 maxRetryTimes;
        System.String messageBody;
        System.String messageTrackingID;
        System.String exceptionMessage;
        System.String notificationMessage;
        System.Boolean shouldSendNotification;
        System.String outboxPK;
        System.String inboxPK;
        System.Boolean isSuccessful;
        System.String xmlString;
        System.Xml.XmlDocument xmlDoc;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("febbd71c-d83e-48eb-9d63-8362cab371c6")]
            activate ((BTS.DestinationParty == "JPCustoms") && (CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient"))receive (BizTalkMessageBox.Operation, JPCustomsMessageRequest);
            recipientID = "";
            senderID = "";
            logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            exit = true;
            messageBody = "";
            messageTrackingID = "";
            exceptionMessage = "";
            notificationMessage = "";
            shouldSendNotification = true;
            outboxPK = "";
            inboxPK = "";
            isSuccessful = true;
            xmlString = "";
            xmlDoc = new System.Xml.XmlDocument();
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("e0cecc42-7e3c-4917-b0f5-18d44a6ef8e4")]
            logger.Log.Info("Start JPCutsoms Orchestration");
            exit = false;
            retryTimes = 0;
            isSuccessful = true;
            maxRetryTimes = 1000;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a439e67b-b07e-44fa-95b0-4c5cf5af13a9")]
            while (!exit)
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("c4d3e624-05e8-49d9-9892-20f62f8e460f")]
                scope
                {
                    body
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("d63858df-0de8-4591-a3d2-695088b0a8bc")]
                        
                        senderID = JPCustomsMessageRequest(BTS.SourceParty);
                        messageTrackingID = JPCustomsMessageRequest(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);
                        recipientID = JPCustomsMessageRequest(BTS.DestinationParty);
                        outboxPK = JPCustomsMessageRequest(CargoWise.eHub.Core.PropertySchemas.OutboxPK);
                        
                        logger.Log.DebugFormat("Sending request to JP Customs Gateway messageTrackingID: {0}, SenderID:{1}, Recipient:{2}", messageTrackingID, senderID, recipientID);
                        
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("fd8ff9e4-2b31-43e4-a88f-9e5e272117b4")]
                        construct Message
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("b2fcc18a-7f61-412a-a8a0-219afb8d1f86")]
                            messageBody = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(JPCustomsMessageRequest);
                            Message = CargoWise.eHub.Core.Orchestrations.Helper.Messages.CreateMessageFromString("Body", messageBody);;
                            logger.Log.Debug("Sending JP Customs Message");
                            
                            
                            
                            
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("364bec38-56d7-4035-9043-026d90caaaf7")]
                        send (JPCustomGateway.Operation, Message);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("8123f163-848c-4592-a21a-9047304f302f")]
                        receive (JPCustomGateway.Operation, JPCustomsMessageResponse);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("0dff11d0-856d-4ae2-a21d-bd84ef5b294d")]
                        logger.Log.Info("Send successful. ");
                        exit = true;
                        isSuccessful = true;
                    }
                    exceptions
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("5a0c0f8c-2448-4670-8b29-e82dc664963d")]
                        catch (System.Web.Services.Protocols.SoapException soapException)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("334921a8-264d-4ec3-8649-b33a09364933")]
                            exceptionMessage = soapException.ToString();
                            logger.Log.ErrorFormat("SoapException catched in sending to JP Customs.  Error:\r\n{0}",  soapException.ToString());
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("932f1c12-2b75-4e8b-93bb-b7c4fc9c404b")]
                        catch (System.Exception ex)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("904a8dcb-c7b5-4035-8b62-c8f2843edc77")]
                            exceptionMessage = ex.ToString();
                            logger.Log.ErrorFormat("Error sending to JP Customs.  Error:\r\n{0}",  ex.ToString());
                            
                        }
                    }
                }
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("2bc7d1a2-f9dc-4f46-b765-bb5654e4dcff")]
                if (!exit)
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("dce2de95-028e-46f4-af43-1386165ff7a3")]
                    retryTimes = retryTimes + 1 ;
                    logger.Log.ErrorFormat("JP Customs Retry times:{0}", retryTimes);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("8f747c33-7f8a-42b8-b59f-78fb9c28492d")]
                    if (retryTimes < maxRetryTimes )
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("0d05669c-6973-41e9-94bf-e9ed4cf45f34")]
                        logger.Log.Debug("Waiting to retry. ");
                        
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("d61beec6-5787-413c-a46f-9e1ec720b2c5")]
                        delay System.TimeSpan.FromMinutes(1);
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("50ca21a8-124c-457a-92bb-66b038117926")]
                        logger.Log.DebugFormat("JP Customs Maxiumn Retry Time Reached, Exit Loop, Max Retry Times: {0}", maxRetryTimes);
                        isSuccessful = false;
                        exit = true;
                    }
                }
                else 
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("eee2ef01-3127-4352-b629-9467b66dccab")]
                    logger.Log.Info("Send Success, exit orchestration");
                    exit = true;
                }
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("bc48e4b8-beef-415c-ac79-6a1fb6ef5c6a")]
