<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.govtalk.gov.uk/enforcement/ICS/DownloadMessagesResponse/1" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msgs="http://www.govtalk.gov.uk/enforcement/ICS/messages/1" xmlns:err="http://www.govtalk.gov.uk/CM/errorresponse"
  targetNamespace="http://www.govtalk.gov.uk/enforcement/ICS/DownloadMessagesResponse/1" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:import namespace="http://www.govtalk.gov.uk/enforcement/ICS/messages/1" schemaLocation="UKDownloadResponse_v1-0.xsd" />
  <xs:import namespace="http://www.govtalk.gov.uk/CM/errorresponse" schemaLocation="errorresponse-v2.0.xsd" />
  <xs:element name="DownloadMessagesResponse">
    <xs:annotation>
      <xs:documentation>This schema is used to capture the response messages or error responses sent back to HMRC SOAP clients</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice>
        <xs:element ref="msgs:UKMessages" />
        <xs:element ref="err:ErrorResponse" />
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>