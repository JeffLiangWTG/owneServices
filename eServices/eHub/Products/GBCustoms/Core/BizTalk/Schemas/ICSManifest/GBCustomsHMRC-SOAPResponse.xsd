<?xml version="1.0" encoding="UTF-8"?>
<xs:schema attributeFormDefault="unqualified"
    elementFormDefault="qualified"
    targetNamespace="http://www.inlandrevenue.gov.uk/SOAP/Response/1"
    xmlns="http://www.inlandrevenue.gov.uk/SOAP/Response/1"
    xmlns:err="http://www.govtalk.gov.uk/CM/errorresponse"
    xmlns:succ="http://www.hmrc.gov.uk/successresponse/2" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:import namespace="http://www.hmrc.gov.uk/successresponse/2" schemaLocation="GBCustomsSuccessResponse.xsd"/>
    <xs:import namespace="http://www.govtalk.gov.uk/CM/errorresponse" schemaLocation="GBCustomsErrorResponse.xsd"/>
    <xs:element name="HMRCSOAPResponse">
        <xs:annotation>
            <xs:documentation>This schema is used to capture the success
                and error responses sent back to HMRC SOAP clients</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:choice>
                <xs:element ref="succ:SuccessResponse"/>
                <xs:element ref="err:ErrorResponse"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>
</xs:schema>
