<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:uk="http://www.govtalk.gov.uk/enforcement/ICS/messages/1" targetNamespace="http://www.govtalk.gov.uk/enforcement/ICS/messages/1" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:complexType name="UKMessages">
		<xs:annotation>
			<xs:documentation>
				High-level binder of UK messages being returned
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="uk:OutstandingMessages"/>
			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="UKMessages" type="uk:UKMessages">
		<xs:annotation>
			<xs:documentation>
				High-level binder of UK messages being returned
			</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="OutstandingMessages" type="xs:nonNegativeInteger">
		<xs:annotation>
			<xs:documentation>
				Element to indicate the number of messages still to download 
			</xs:documentation>
		</xs:annotation>
	</xs:element>
</xs:schema>