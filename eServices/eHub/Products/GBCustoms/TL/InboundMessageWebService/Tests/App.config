<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="GBCustomsRegistrationType" value="GBCustoms-Transport" />
    <add key="GBCustomsSubscriptionType" value="GBCTID" />
    <add key="SubscriptionProviderIDList" value ="GBCustomsTest-CTCGB,GBCustomsTest-EMCS,GBCustomsTest-GVMS,GBCustomsTest-ICSGB,GBCustoms-CTCGB,GBCustoms-EMCS,GBCustoms-GVMS,GBCustoms-ICSGB" />
    <add key="DatabaseAccessRetryTimeLimit" value="600"/>
    <add key="AuthorisationHeaderKey" value="Authorization" />
    <add key="SchemaValidation" value="False" />
    <add key="GetRecipientsRetryAttempts" value="3"/>
    <add key="GetRecipientsRetryWaitTime" value="1"/>
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="nunit.framework" publicKeyToken="2638cd05610744eb" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.13.3.0" newVersion="3.13.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>