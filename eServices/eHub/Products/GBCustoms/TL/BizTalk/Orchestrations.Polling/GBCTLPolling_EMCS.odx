                            <om:Property Name="Signal" Value="True" />
                            <om:Element Type="VariableAssignment" OID="b5ce807a-0e8e-4fec-81f7-0685e66f01e2" ParentLink="ComplexStatement_Statement" LowerBound="84.1" HigherBound="93.1">
                                <om:Property Name="Expression" Value="var_EMCSConfig = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.ExtractConfig(TypedPollingGBCTLPolling_EMCS.ConfigXML);&#xD;&#xA;var_EndpointConfiguration = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.EndpointConfiguration.GetConfig(var_EMCSConfig.Recipient + &quot;Polling&quot;, &quot;All&quot;);&#xD;&#xA;&#xD;&#xA;logger.Log.TraceFormat(&quot;{0}EndpointUrl [{1}]&quot;, var_LoggerPrefix, var_EndpointConfiguration.EndpointUrl);&#xD;&#xA;&#xD;&#xA;var_RequestRetryDuration = System.TimeSpan.FromMinutes(10);&#xD;&#xA;var_RequestRetryWaitPeriod = System.TimeSpan.FromMinutes(1);&#xD;&#xA;var_SqlRetryCount = 5;" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="Prepare RequestXml" />
