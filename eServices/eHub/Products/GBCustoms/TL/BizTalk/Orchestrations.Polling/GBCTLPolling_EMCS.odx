                                                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("1841cf48-9b8c-4450-a7e4-1f7500f4ae3c")]
                                                                delay System.TimeSpan.FromSeconds(10);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("522577b2-c4d7-4874-b402-0e623313ebc3")]
                                        logger.Log.DebugFormat("{0}Message processed and sent to CW1 for MovementID [{1}]", var_LoggerPrefix, var_MovementId);
                                        
                                        var_MessageCount = var_MessageCount - 1;
                                    }
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("ed15258d-8b53-446a-96ff-263dac83688f")]
                                    logger.Log.DebugFormat("{0}Processing completed for MovementID [{1}]", var_LoggerPrefix, var_MovementId);
                                    
                                    var_MovementCount = var_MovementCount - 1;
                                }
                            }
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("5e8cef32-f995-44ca-ac72-12a5784c4bac")]
                        if(var_Success)
                        {
                            var_EMCSConfig.LastPollingDate = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.GetFormattedUTC();
                        }
                        
                        CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.SaveConfiguration(var_EMCSConfig, TypedPollingGBCTLPolling_EMCS.Client, "GBCustoms-EMCS");
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("46270d65-3c34-4c02-b2ba-0b77888e49d3")]
                        logger.Log.TraceFormat("{0}Polling completed", var_LoggerPrefix);
                    }
                    exceptions
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c915215e-0932-4c7d-a5d5-5accf22ac748")]
                        catch (System.Exception ex)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7a24abe0-2429-4c12-8653-f63999211c76")]
                            logger.Log.ErrorFormat("{0}Unhandled Exception - {1} - {2}", var_LoggerPrefix, ex.Message, ex);
                        }
                    }
                }
            }
            else 
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("b0cf13b4-3e2c-45d1-aa68-bdf64a4a6aeb")]
                logger.Log.InfoFormat("{0}GBCTLPolling_EMCS - Mutex found, skipping this request", var_LoggerPrefix);
            }
        }
    }
