                                <om:Property Name="Signal" Value="True" />
                                <om:Element Type="DecisionBranch" OID="07a20f1a-2aa3-46aa-89a1-2977b65e35f1" ParentLink="ReallyComplexStatement_Branch" LowerBound="97.25" HigherBound="142.1">
                                    <om:Property Name="Expression" Value="!System.String.IsNullOrWhiteSpace(var_AuthToken)" />
                                    <om:Property Name="IsGhostBranch" Value="True" />
                                    <om:Property Name="ReportToAnalyst" Value="True" />
