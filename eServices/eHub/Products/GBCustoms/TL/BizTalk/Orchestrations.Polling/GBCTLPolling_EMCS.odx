                                        <om:Property Name="Expression" Value="var_QueryString = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.GetQueryString(var_EMCSConfig);&#xD;&#xA;var_HttpRetryRequest = new CargoWise.eHub.Core.Orchestrations.HttpRetry.Contract.HttpRequest();&#xD;&#xA;var_HttpRetryRequest.Method = var_EndpointConfiguration.Method;&#xD;&#xA;var_HttpRetryRequest.AddressUrl = var_EndpointConfiguration.EndpointUrl + var_QueryString;&#xD;&#xA;var_HttpRetryRequest.ContentType = var_EMCSConfig.ContentType;&#xD;&#xA;var_HttpRetryRequest.UserHeaderNamesWithoutValidation = &quot;User-Agent&quot;;&#xD;&#xA;var_HttpRetryRequest.UserHeaders = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.SetTokenHeader(var_EMCSConfig.RequestHeaders, var_AuthToken);&#xD;&#xA;var_HttpRetryRequest.ContentMessage = CargoWise.eHub.Core.Orchestrations.Helper.Messages.CreateMessageFromString(&quot;Body&quot;, &quot;&lt;Body&gt;&lt;/Body&gt;&quot;);&#xD;&#xA;&#xD;&#xA;logger.Log.InfoFormat(&quot;{0}LIST - Http Request with URL [{1}], Method [{2}], ContentType [{3}]&quot;, &#xD;&#xA;    var_LoggerPrefix, &#xD;&#xA;    var_HttpRetryRequest.AddressUrl, &#xD;&#xA;    var_HttpRetryRequest.Method,&#xD;&#xA;    var_HttpRetryRequest.ContentType);&#xD;&#xA;" />
