                                <om:Property Name="Expression" Value="var_AuthToken = CargoWise.eHub.Products.GBCustoms.Core.BT.Helpers.CredentialsHelpers.GetAccessToken(TypedPollingGBCTLPolling_EMCS.Client, &quot;EMCS&quot;);&#xD;&#xA;logger.Log.InfoFormat(&quot;{0}Auth Token={1}&quot;, var_LoggerPrefix, var_AuthToken);" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
                                <om:Property Name="Name" Value="AuthToken" />
                                <om:Property Name="Signal" Value="True" />
                            </om:Element>
                            <om:Element Type="Decision" OID="06dec86d-a250-4fd1-a9dd-d5124fcde52d" ParentLink="ComplexStatement_Statement" LowerBound="96.1" HigherBound="148.1">
                                <om:Property Name="ReportToAnalyst" Value="True" />
