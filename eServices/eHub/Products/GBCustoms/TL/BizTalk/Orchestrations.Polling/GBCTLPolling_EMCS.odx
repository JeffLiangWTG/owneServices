                    <om:Property Name="Expression" Value="var_LoggerPrefix = System.String.Format(&quot;ServiceID [{0}] - &quot;, System.Guid.NewGuid());&#xD;&#xA;&#xD;&#xA;logger.Log.DebugFormat(&quot;{0}Polling started for PK [{1}] Client [{2}] ConfigXML [{3}]&quot;, &#xD;&#xA;    var_LoggerPrefix,&#xD;&#xA;    TypedPollingGBCTLPolling_EMCS.PK,&#xD;&#xA;    TypedPollingGBCTLPolling_EMCS.Client,&#xD;&#xA;    TypedPollingGBCTLPolling_EMCS.ConfigXML&#xD;&#xA;);&#xD;&#xA;" />
