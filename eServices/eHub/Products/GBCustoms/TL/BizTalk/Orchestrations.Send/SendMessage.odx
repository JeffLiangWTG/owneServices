                        <om:Property Name="Expression" Value="logPrefix = System.String.Format (&quot;[{0}] &quot;, System.Guid.NewGuid ());&#xD;&#xA;&#xD;&#xA;sendStart = System.DateTime.UtcNow;&#xD;&#xA;account = OutboxMsg(CargoWise.eHub.Core.PropertySchemas.OverrideFilename);&#xD;&#xA;provider = OutboxMsg(BTS.DestinationParty);&#xD;&#xA;messageTrackingId = OutboxMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);&#xD;&#xA;serviceProvider = xpath(OutboxMsg, &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Provider'])&quot;);&#xD;&#xA;serviceName = xpath(OutboxMsg, &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Service'])&quot;);&#xD;&#xA;serviceReference = xpath(OutboxMsg, &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='ServiceReference'])&quot;);&#xD;&#xA;isLargeFileUpload = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.IsLargeFileUpload(OutboxMsg);&#xD;&#xA;&#xD;&#xA;logger.Log.InfoFormat(&quot;{0}Sending. Sender={1} Recipient={2} Account={3} MessageTrackingID={4} ServiceReference={5}&quot;, &#xD;&#xA;    logPrefix, OutboxMsg(BTS.SourceParty), provider, account, messageTrackingId, serviceReference);&#xD;&#xA;&#xD;&#xA;maxRetryingDuration = System.TimeSpan.FromHours(1);&#xD;&#xA;sleepingPeriodBetweenRetries = System.TimeSpan.FromMinutes(1);&#xD;&#xA;&#xD;&#xA;status = null;&#xD;&#xA;error = null;&#xD;&#xA;errorText = null;&#xD;&#xA;exit = false;&#xD;&#xA;retryCountOn401Response = 0;&#xD;&#xA;retrySqlCount = 5;" />
