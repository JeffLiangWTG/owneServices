                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("5ffe241f-0f16-43b1-8180-10c6e6354a3f")]
                            authToken = CargoWise.eHub.Products.GBCustoms.Core.BT.Helpers.CredentialsHelpers.GetAccessToken(account);
                            logger.Log.InfoFormat("{0}Auth Token={1}", logPrefix, authToken);
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7aa538b3-ca14-4b5c-b7a8-9f2a8378935b")]
