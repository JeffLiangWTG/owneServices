                                apiVersion = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Version'])");
                                contentType = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='ContentType'])");
                                acceptHeaderValue = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Accept'])");
                                
                                serviceNameForCodeMapping = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.GetCodeMappingService(logger.Log, provider, serviceName, serviceReference); 
                                
                                endpointConfig = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.EndpointConfiguration.GetConfig(provider, serviceNameForCodeMapping);
                                
                                url = endpointConfig.EndpointUrl.Replace("{ServiceReference}", serviceReference);
                                
                                if(serviceName == "GetPushData" || serviceName == "Unsolicited")
                                {
                                    getPushDataURL = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Body']/*[local-name()='PushData']/*[local-name()='MessageUri'])");
                                    requestID = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Body']/*[local-name()='PushData']/*[local-name()='RequestId'])");
                                    if(System.String.IsNullOrEmpty(requestID))
                                    {
                                        requestID = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='JobNumber'])");
                                    }
                                    url = url + getPushDataURL;
                                }
                                
                                httpMethod = endpointConfig.Method;
                                
                                if (System.String.IsNullOrEmpty(apiVersion)){
                                    apiVersion = endpointConfig.Version;
                                }
                                if (System.String.IsNullOrEmpty(contentType)){
                                    contentType = endpointConfig.ContentType;
                                }
                                
                                if(System.String.IsNullOrEmpty(acceptHeaderValue))
                                {
                                    acceptHeader = System.String.Format("application/vnd.hmrc.{0}+{1}", apiVersion, contentType);
                                }
                                else
                                {
                                    acceptHeader = acceptHeaderValue;
                                }
                                
                                logger.Log.InfoFormat("{0}HTTP Info. URL={1} API Version={2} Method={3} Content Type={4} Service={5} Service for CodeMapping={6}", 
                                    logPrefix, url, apiVersion, httpMethod, contentType, serviceName, serviceNameForCodeMapping);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("ad749a29-1266-42c4-b78c-2199a891131f")]
                                if (url != "" && apiVersion != "" && httpMethod != "" && contentType != "")
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("11da7645-a5e4-4b4e-afb3-4459143280a8")]
                                    if (!isLargeFileUpload)
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("88e0ef35-1e3f-4ea3-af91-519021a86073")]
                                        CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.SubscribePreSubmissionCorrelations(logger.Log, OutboxMsg.InnerXml.ToString(), provider, OutboxMsg(BTS.SourceParty));
                                        
                                        httpRetryRequest = new CargoWise.eHub.Core.Orchestrations.HttpRetry.Contract.HttpRequest();
                                        httpRetryRequest.AddressUrl = url;
                                        httpRetryRequest.UserHeaderNamesWithoutValidation = "User-Agent";
                                        
                                        if(System.String.IsNullOrEmpty(acceptHeaderValue))
                                        {
                                            httpRetryRequest.UserHeaders = CargoWise.eHub.Products.GBCustoms.Core.BT.Helpers.HttpHelpers.CreateHttpHeaders(
                                                "Accept", System.String.Format("application/vnd.hmrc.{0}+{1}", apiVersion, contentType),
                                                "Authorization", System.String.Format("Bearer {0}", authToken));
                                        
                                            charsetHeader = "; charset=UTF-8";
                                        }
                                        else
                                        {
                                            httpRetryRequest.UserHeaders = CargoWise.eHub.Products.GBCustoms.Core.BT.Helpers.HttpHelpers.CreateHttpHeaders(
                                                "Accept", acceptHeaderValue,
                                                "Authorization", System.String.Format("Bearer {0}", authToken));
                                        }
                                        
                                        httpRetryRequest.ContentType = System.String.Format("application/{0}{1}", contentType, charsetHeader);
                                        httpRetryRequest.Method = httpMethod;
                                        
                                        
                                        if(contentType.ToUpper() == "XML")
                                        {
                                        	contentXml = xpath(OutboxMsg, "/*[local-name()='GBCustoms']/*[local-name()='Body']/*[1]");
                                            contentString = contentXml.OuterXml;
                                        	httpRetryRequest.ContentMessage = CargoWise.eHub.Core.Orchestrations.Helper.Messages.CreateMessageFromString("Body", contentString);
                                        }
                                        else
                                        {
                                        	contentJSON = xpath(OutboxMsg, "string(/*[local-name()='GBCustoms']/*[local-name()='Body'])");
                                        	httpRetryRequest.ContentMessage = CargoWise.eHub.Core.Orchestrations.Helper.Messages.CreateMessageFromString("Body", contentJSON);
                                        	contentString = contentJSON;
                                        }
                                        
                                        logger.Log.InfoFormat("{0}{1}: Sending to {2}, ContentType: {3}", logPrefix, serviceName, httpRetryRequest.AddressUrl, httpRetryRequest.ContentType);
                                        
                                        if(logger.Log.IsTraceEnabled)
                                        {
                                            logger.Log.TraceFormat("{0}Content {1}", logPrefix, contentString);
                                            CargoWise.eHub.Products.GBCustoms.Core.BT.Helpers.HttpHelpers.LogHeaders(httpRetryRequest.UserHeaders, logger.Log, logPrefix);
                                        }
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("8b4443fd-ecea-417c-b6de-568f834c903b")]
                                        call CargoWise.eHub.Core.Orchestrations.HttpRetry.MakeHttpRequest (httpRetryRequest, maxRetryingDuration, sleepingPeriodBetweenRetries, out httpRetryResponse);
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("76dc9338-c3b7-4de7-9d76-4011de36d8ce")]
                                        statusCode = httpRetryResponse.StatusCode;
                                        statusCodeDescription = System.Convert.ToString(System.Enum.Parse(typeof(System.Net.HttpStatusCode), statusCode.ToString()));
                                        logger.Log.InfoFormat("{0}HTTP request completed with status ({1}) {2}", logPrefix, statusCode, statusCodeDescription);
                                        
                                        if(System.String.IsNullOrEmpty(httpRetryResponse.ExceptionMessage))
                                        {
                                            responseContent = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(httpRetryResponse.ContentMessage);
                                        }
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("474a591b-66c4-40c5-894b-c054516754a9")]
                                        if (statusCode >= 200 && statusCode <= 299 && !responseContent.Contains("ErrorResponse"))
                                        {
                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("b5355085-35ae-441e-a38c-22e64d9ba2ce")]
                                            logger.Log.DebugFormat("{0}Message accepted. account='{1}'", logPrefix, account);
                                            
                                            status = "Accepted";
                                            exit = true;
                                            
                                            if(serviceProvider == "EMCS")
                                            {
                                                logger.Log.DebugFormat("{0}Creating EMCSConfiguration for polling", logPrefix);
                                                emcsMessage = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(OutboxMsg);
                                                
                                                emcsConfig = CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.CreateConfig(
                                                    logger.Log,
                                            	    emcsMessage, 
                                                    OutboxMsg(BTS.SourceParty),
                                            	    CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.MessageType.GBCustomsRequest, 
                                            	    httpRetryRequest.UserHeaders,
                                            	    httpRetryResponse.Headers,
                                            	    account,
                                            	    httpRetryRequest.ContentType,
                                                    "GBCustoms-EMCS"
                                                );
                                                
                                                emcsConfig.Recipient = provider;
                                                CargoWise.eHub.Products.GBCustoms.TL.BT.Helpers.OrchestrationHelpers.SaveConfiguration(emcsConfig, OutboxMsg(BTS.SourceParty), "GBCustoms-EMCS");
                                            }
                                        }
                                        else if (statusCode == 401)
                                        {
                                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("5a57eb74-7cfc-4944-8a5d-04d380b3018a")]
                                            logger.Log.WarnFormat("{0}Auth Token for account {1} rejected. Requesting refresh.", logPrefix, account);
                                            errorText = System.String.Format("HTTP Status ({0}) {1}", statusCode, statusCodeDescription);
                                            
                                            CargoWise.eHub.Products.GBCustoms.Core.BT.Helpers.CredentialsHelpers.RequestAccessTokenRefresh(account, authToken);
                                            
                                            retryCountOn401Response = retryCountOn401Response + 1;
                                            
                                            if (retryCountOn401Response == 3)
                                            {
                                                status = "Error";
                                                error = "Authentication Failed";
                                                exit = true;
                                            }
