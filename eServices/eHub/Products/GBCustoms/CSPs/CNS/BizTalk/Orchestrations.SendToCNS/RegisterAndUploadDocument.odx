 EORI in XML. SourceClientId=[{1}] DestinationClientId=[{2}]\n{3}&quot;,&#xD;&#xA;            var_logPrefix,&#xD;&#xA;            var_SourceClientId,&#xD;&#xA;            var_DestinationClientId,&#xD;&#xA;            xpath(&#xD;&#xA;                msg_Outbox, &#xD;&#xA;                &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header'])&quot;));        &#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;                        &#xD;&#xA;var_Username = xpath(&#xD;&#xA;    msg_Outbox, &#xD;&#xA;    &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Credentials']/*[local-name()='User'])&quot;);&#xD;&#xA;&#xD;&#xA;var_Password = xpath(&#xD;&#xA;    msg_Outbox, &#xD;&#xA;    &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Credentials']/*[local-name()='Password'])&quot;);&#xD;&#xA;&#xD;&#xA;if (!System.String.IsNullOrEmpty(var_Password))&#xD;&#xA;{&#xD;&#xA;    var_Password = CargoWise.eServices.Server.Decryption.RSADecryptor.Decrypt(var_Password);&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    var_Logger.Log.InfoFormat(&#xD;&#xA;    &quot;{0}Password is empty. ClientSystemId=[{1}] Username=[{2}] Badge=[{3}]&quot;,&#xD;&#xA;    var_logPrefix,&#xD;&#xA;    var_SourceClientId,&#xD;&#xA;    var_Username,&#xD;&#xA;    var_OverridingFilename.Badge);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;var_Topic = xpath(&#xD;&#xA;    msg_Outbox, &#xD;&#xA;    &quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Credentials']/*[local-name()='Topic'])&quot;);&#xD;&#xA;&#xD;&#xA;var_Service = xpath(&#xD;&#xA;	msg_Outbox, &#xD;&#xA;	&quot;string(/*[local-name()='GBCustoms']/*[local-name()='Header']/*[local-name()='GBCustomsRequest']/*[local-name()='Service'])&quot;);&#xD;&#xA;&#xD;&#xA;var_Api = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue(&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms (CNS) System Configuration&quot;,&#xD;&#xA;	&quot;ServiceAPI&quot;,&#xD;&#xA;	&quot;API&quot;,&#xD;&#xA;	var_DestinationClientId,&#xD;&#xA;	var_Service,&#xD;&#xA;	null,&#xD;&#xA;	null,&#xD;&#xA;	null);&#xD;&#xA;&#xD;&#xA;var_CustomSubscription = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue(&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms (CNS) System Configuration&quot;,&#xD;&#xA;	&quot;ServiceAPI&quot;,&#xD;&#xA;	&quot;CustomSubscription&quot;,&#xD;&#xA;	var_DestinationClientId,&#xD;&#xA;	var_Service,&#xD;&#xA;	null,&#xD;&#xA;	null,&#xD;&#xA;	null);&#xD;&#xA;&#xD;&#xA;var_ContentType = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue(&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms (CNS) System Configuration&quot;,&#xD;&#xA;	&quot;ServiceAPI&quot;,&#xD;&#xA;	&quot;ContentType&quot;,&#xD;&#xA;	var_DestinationClientId,&#xD;&#xA;	var_Service,&#xD;&#xA;	null,&#xD;&#xA;	null,&#xD;&#xA;	null);&#xD;&#xA;&#xD;&#xA;var_CSPVersion = CargoWise.eHub.DataModel.Accessors.eHubTransactionsAccessor.GetCodeMappedValue(&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms&quot;,&#xD;&#xA;	&quot;GBCustoms (CNS) System Configuration&quot;,&#xD;&#xA;	&quot;ServiceAPI&quot;,&#xD;&#xA;	&quot;Version&quot;,&#xD;&#xA;	var_DestinationClientId,&#xD;&#xA;	var_Service,&#xD;&#xA;	null,&#xD;&#xA;	null,&#xD;&#xA;	null);&#xD;&#xA;&#xD;&#xA;var_AccountName = msg_Outbox(CargoWise.eHub.Core.PropertySchemas.OverrideFilename);&#xD;&#xA;&#xD;&#xA;var_MaxRetryingDuration = System.TimeSpan.FromHours(1);&#xD;&#xA;var_SleepingPeriodBetweenRetries = System.TimeSpan.FromMinutes(1);&#xD;&#xA;" />
