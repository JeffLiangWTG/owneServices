<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="AuthorisationHeaderValue" value="$AuthorisationHeaderValue$" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="AuthorisationHeaderKey" value="$AuthorisationHeaderKey$" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
  <system.webServer>
    <security xdt:Transform="Remove" />
  </system.webServer>
</configuration>