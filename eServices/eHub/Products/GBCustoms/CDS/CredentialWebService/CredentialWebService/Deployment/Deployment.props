<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_DeploymentPropsImported>$true</_DeploymentPropsImported>
		<_AnonymousAuthenticationEnabled>true</_AnonymousAuthenticationEnabled>
		<_SecurityAccessConfiguration>Ssl</_SecurityAccessConfiguration>
		<_Server></_Server>
		<_SiteName>Default Web Site</_SiteName>
		<_ServiceName>GBCustomsCredentialWebService</_ServiceName>
		<_BackupFolder>c:\eServicesTesting\GBCustomsCredentialWebService_backup</_BackupFolder>
		<_LogsFolder>logs</_LogsFolder>
		<_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
	</PropertyGroup>
	<ItemGroup>
		<_Binding Include="1">
			<IPAddress>*</IPAddress>
			<Port>443</Port>
			<Protocol>https</Protocol>
			<HostHeader></HostHeader>
		</_Binding>
	</ItemGroup>
</Project>