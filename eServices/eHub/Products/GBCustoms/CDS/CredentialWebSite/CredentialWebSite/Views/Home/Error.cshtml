@model CargoWise.eHub.Products.GBCustoms.CDS.CredentialWebSite.Models.ErrorDetails

<h3 class="text-center text-primary">There was a problem while authorising:</h3>
<div class="row">
    <div class="col-md-offset-2 col-md-8">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Error</th>
                        <th scope="col">Error Description</th>
                        <th scope="col">Error Code</th>
                        <th scope="col">Category</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.Error</td>
                        <td>@Model.ErrorDescription</td>
                        <td>@Model.ErrorCode</td>
                        <td>@Model.Category</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<h4 class="text-center">- Please raise a new eRequest for assistance, including a screenshot of this page and its URL -</h4>
<h4 class="text-center text-primary">Our Reference: @ViewBag.ReferenceNumber</h4>