@model CargoWise.eHub.Products.GBCustoms.CDS.CredentialWebSite.Models.NaturalKey

<h3 class="text-center text-primary">Thank you for authorising CargoWise One to access HMRC's Customs applications on your behalf</h3>
<br />
<p>
    WiseTech Global has received the request to commence the process to gain access to Customs applications on your behalf.
    The rest of the process will now complete in the background over the next couple of minutes, but you don't
    need to wait.  <b>You can close your browser now</b>.
</p>
<p>
    Once the process has completed, CargoWise One will be updated automatically to show that the authorisation was succesful.
    Only once this process has completed can you send data to Customs applications via CargoWise One.
</p>
<p class="text-primary text-center">
    HMRC have passed us this data:
</p>
<div class="row">
    <div class="col-md-offset-3 col-md-6">
        <div class="table-responsive">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">Enterprise and Database Code</th>
                    <th scope="col">EORI</th>
                    <th scope="col">Profile</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>@Model.EnterpriseDbCode</td>
                    <td>@Model.Eori</td>
                    <td>@Model.Profile</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<h4 class="text-center text-primary">Our Reference: @ViewBag.ReferenceNumber</h4>
