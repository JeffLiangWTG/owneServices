                        logger.Log.Error(System.String.Format("{0}Fatal error sending to GB Customs.", logPrefix), ex);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("61528b37-e69b-4982-87d4-d9ad8c8da6b5")]
