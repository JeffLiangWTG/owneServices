&#xD;&#xA;    &lt;ns1:eHubInboxMessage xmlns:ns1='http://schemas.microsoft.com/Sql/2008/05/Types/Tables/dbo'&gt;&#xD;&#xA;      &lt;ns1:EI_PK&gt;{0}&lt;/ns1:EI_PK&gt;&#xD;&#xA;      &lt;ns1:EI_MessageTrackingID&gt;{0}&lt;/ns1:EI_MessageTrackingID&gt;&#xD;&#xA;      &lt;ns1:EI_EnvelopeTrackingID&gt;00000000-0000-0000-0000-000000000000&lt;/ns1:EI_EnvelopeTrackingID&gt;&#xD;&#xA;      &lt;ns1:EI_CC_Sender&gt;{1}&lt;/ns1:EI_CC_Sender&gt;&#xD;&#xA;      &lt;ns1:EI_CC_Recipient&gt;{2}&lt;/ns1:EI_CC_Recipient&gt;&#xD;&#xA;      &lt;ns1:EI_MessageType&gt;http://cargowise.com/ehub/products/GBCustoms#GBCustomsTransportResponse&lt;/ns1:EI_MessageType&gt;&#xD;&#xA;      &lt;ns1:EI_IsFlatFile&gt;false&lt;/ns1:EI_IsFlatFile&gt;&#xD;&#xA;      &lt;ns1:EI_ApplicationCode&gt;UDM&lt;/ns1:EI_ApplicationCode&gt;&#xD;&#xA;      &lt;ns1:EI_Status&gt;0&lt;/ns1:EI_Status&gt;&#xD;&#xA;      &lt;ns1:EI_Content&gt;{3}&lt;/ns1:EI_Content&gt;&#xD;&#xA;    &lt;/ns1:eHubInboxMessage&gt;&#xD;&#xA;  &lt;/ns0:Rows&gt;&#xD;&#xA;&lt;/ns0:Insert&gt;&quot;, &#xD;&#xA;System.Convert.ToString(System.Guid.NewGuid()), pkRecipient, pkSender, inboxContent);&#xD;&#xA;&#xD;&#xA;if (conversationId != null)&#xD;&#xA;{&#xD;&#xA;    sqlString = System.String.Format(&#xD;&#xA;@&quot;&lt;ns0:InsertSubscriptionValue xmlns:ns0='http://schemas.microsoft.com/Sql/2008/05/Procedures/dbo'&gt;&#xD;&#xA;  &lt;ns0:ST_PK&gt;{0}&lt;/ns0:ST_PK&gt;&#xD;&#xA;  &lt;ns0:senderId&gt;{1}&lt;/ns0:senderId&gt;&#xD;&#xA;  &lt;ns0:recipientId&gt;{2}&lt;/ns0:recipientId&gt;&#xD;&#xA;  &lt;ns0:value&gt;{3}&lt;/ns0:value&gt;&#xD;&#xA;  &lt;ns0:reference&gt;{4}&lt;/ns0:reference&gt;&#xD;&#xA;&lt;/ns0:InsertSubscriptionValue&gt;&quot;,&#xD;&#xA;    pkSubscription, OutboxMsg(BTS.DestinationParty), OutboxMsg(BTS.SourceParty), conversationId, CargoWise.eHub.Products.GBCustoms.CDS.BT.Helpers.OrchestrationHelpers.EscapeXML(eHubTrackingID, logger.Log)) + sqlString;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (functionalReferenceID != &quot;&quot;)&#xD;&#xA;{&#xD;&#xA;    sqlString = System.String.Format(&#xD;&#xA;@&quot;&lt;ns0:InsertSubscriptionValue xmlns:ns0='http://schemas.microsoft.com/Sql/2008/05/Procedures/dbo'&gt;&#xD;&#xA;  &lt;ns0:ST_PK&gt;{0}&lt;/ns0:ST_PK&gt;&#xD;&#xA;  &lt;ns0:senderId&gt;{1}&lt;/ns0:senderId&gt;&#xD;&#xA;  &lt;ns0:recipientId&gt;{2}&lt;/ns0:recipientId&gt;&#xD;&#xA;  &lt;ns0:value&gt;{3}&lt;/ns0:value&gt;&#xD;&#xA;  &lt;ns0:reference&gt;{4}&lt;/ns0:reference&gt;&#xD;&#xA;&lt;/ns0:InsertSubscriptionValue&gt;&quot;,&#xD;&#xA;    pkSubscription, OutboxMsg(BTS.DestinationParty), OutboxMsg(BTS.SourceParty), functionalReferenceID, CargoWise.eHub.Products.GBCustoms.CDS.BT.Helpers.OrchestrationHelpers.EscapeXML(eHubTrackingID, logger.Log)) + sqlString;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (status == &quot;Accepted&quot;)&#xD;&#xA;{&#xD;&#xA;    ackType = &quot;ACK&quot;;&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    ackType = &quot;NACK&quot;;&#xD;&#xA;    ackDescription = errorText;&#xD;&#xA;}&#xD;&#xA;logger.Log.DebugFormat(&quot;{0}ConversationID [{1}] - Completed preparing the eHub message and subscription&quot;, logPrefix, conversationId);" />
