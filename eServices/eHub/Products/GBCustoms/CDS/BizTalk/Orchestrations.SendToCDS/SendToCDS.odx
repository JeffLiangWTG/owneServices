                        scope
                        {
                            body
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("b2d6dce8-f561-4039-b0d2-e74fc3ad2b26")]
                                send (SqlSendPort.CompositeOperation, SqlRequestMessage);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("9ed82a58-6b02-43df-b9d4-4d41560bfff6")]
                                receive (SqlSendPort.CompositeOperation, SqlResponseMessage);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("dada79bc-33cb-479c-af2c-b5585ca15e40")]
                                retrySqlCount = 0;
                                logger.Log.DebugFormat("{0}ConversationID [{1}] - eHub message and subscription inserted", logPrefix, conversationId);
                            }
                            exceptions
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("593c25f2-7165-4ac0-844d-e240c7f37ef2")]
                                catch (System.Exception ex)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("a8da6b6f-1f77-424e-a3e5-c56564747264")]
                                    logger.Log.WarnFormat("{0}Error inserting Message and Subscription. Waiting to retry. MessageTrackingId=[{1}], SQL=[{2}] Exception=[{3}]", logPrefix, OutboxMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID), sqlString, ex.Message);
                                    retrySqlCount = retrySqlCount - 1;
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("1a10c55d-31a3-4659-9d09-401d4885b7aa")]
                                    if (retrySqlCount == 0)
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("05aad801-b026-4499-a587-f911c63a21d3")]
                                        throw ex;
                                    }
                                    else 
                                    {
                                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("f3f83850-990c-4402-a164-3a695e49a72c")]
                                        delay System.TimeSpan.FromSeconds(10);
                                    }
                                }
                            }
                        }
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("a6db45b4-6603-421b-931d-d7ce89082b5a")]
                    construct DeliveryAcknowledgementMessage
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("54704483-4f78-410b-ada0-1767ac39ddf1")]
                        DeliveryAcknowledgementMessage = OutboxMsg;
                        DeliveryAcknowledgementMessage(BTS.AckType) = ackType;
                        DeliveryAcknowledgementMessage(BTS.AckDescription) = ackDescription;
