                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("42534abe-621e-4451-a85a-0f1566265c02")]
                    send (SendDeliveryAcknowledgementMessage.ProcessAcknowledgementMessage, DeliveryAcknowledgementMessage);
