                        pkSubscription, OutboxMsg(BTS.DestinationParty), OutboxMsg(BTS.SourceParty), functionalReferenceID, CargoWise.eHub.Products.GBCustoms.CDS.BT.Helpers.OrchestrationHelpers.EscapeXML(eHubTrackingID, logger.Log)) + sqlString;
                    }
                    
                    if (status == "Accepted")
                    {
                        ackType = "ACK";
                    }
                    else
                    {
                        ackType = "NACK";
                        ackDescription = errorText;
                    }
                    logger.Log.DebugFormat("{0}ConversationID [{1}] - Completed preparing the eHub message and subscription", logPrefix, conversationId);
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("2aaf781c-8bd9-491e-be4a-4d4ef47da3a6")]
                    construct SqlRequestMessage
