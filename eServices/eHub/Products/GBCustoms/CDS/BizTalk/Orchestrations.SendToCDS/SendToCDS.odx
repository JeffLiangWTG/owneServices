                        sqlString = System.String.Format(
                    @"<ns0:InsertSubscriptionValue xmlns:ns0='http://schemas.microsoft.com/Sql/2008/05/Procedures/dbo'>
                      <ns0:ST_PK>{0}</ns0:ST_PK>
                      <ns0:senderId>{1}</ns0:senderId>
                      <ns0:recipientId>{2}</ns0:recipientId>
                      <ns0:value>{3}</ns0:value>
