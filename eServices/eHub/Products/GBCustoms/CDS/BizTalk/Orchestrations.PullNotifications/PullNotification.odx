                                }
                            }
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("ffa4ad50-3242-4298-8fa5-769b65a54c3b")]
                            if (unpulledOrPulledURL == "pulled/")
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("1c83e352-0c09-40fe-b125-7dc0cd8fc9ea")]
                                unpulledOrPulledURL = "unpulled/";
                            }
                            else 
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("abb8c689-1c13-43e2-bd56-4b6cd66581ef")]
                                unpulledOrPulledURL = "";
                            }
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("ab035c97-4745-4f20-b49a-a68b07fed40e")]
                        logger.Log.Info("Finished processing.");
                    }
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e7edf0db-a756-4822-9cd5-33fb11585d37")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("9006d3b2-81e1-476f-b4db-6c9696964e93")]
                        logger.Log.Error("Fatal error receiving request trigger.", ex);
                    }
                }
            }
        }
    }
}

