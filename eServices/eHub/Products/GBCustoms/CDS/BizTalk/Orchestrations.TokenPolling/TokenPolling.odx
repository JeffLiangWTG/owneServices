                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("a11b4e66-8fca-4b07-afc4-c40f549678a1")]
                                    send (SndCredentialsSvcProd.Operation, CredentialServiceRequestMsg);
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("de89a518-ee9b-4aee-a287-a90a0391cedd")]
                                    receive (SndCredentialsSvcProd.Operation, CredentialServiceResponseMsg);
                                }
                                else 
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("f7aefefe-bf96-4338-b50a-cb0c7a59bb92")]
                                    send (SndCredentialsSvcTest.Operation, CredentialServiceRequestMsg);
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("9fccf22d-83be-4ed4-b6f1-2889bd3f115c")]
                                    receive (SndCredentialsSvcTest.Operation, CredentialServiceResponseMsg);
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("6d1c69b4-6468-4bbd-848a-7514b0f0e850")]
                                logger.Log.DebugFormat("{0}Send successful. Action='{1}' Key='{2}' Licence='{3}' IsSuccess='{4}' ErrorMessage='{5}'", 
                                    logPrefix, soapAction, key, licence, 
                                    xpath(CredentialServiceResponseMsg, "string(//*[local-name()='IsSuccess'])"),
                                    xpath(CredentialServiceResponseMsg, "string(//*[local-name()='ErrorMessage'])")
                                );
                                exit = true;
                            }
                            exceptions
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("dd14214f-130f-4e5e-b447-d1c36978d08a")]
                                catch (System.Exception ex)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("f913f5bc-8b3f-4e7f-b5e8-0a59ca8d77a3")]
                                    errorText = ex.Message;
                                    logger.Log.ErrorFormat("{0}Error sending to GB Customs Configuration Service. Action='{1}' Key='{2}' Licence='{3}' Error:\r\n{4}", 
                                        logPrefix, soapAction, key, licence, ex.ToString());
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("a7a1c471-40b7-43d0-9d17-ccc13bd3f588")]
                                catch (SndCredentialsSvcProd.Operation.Fault fault)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("d00a69c4-a3ce-4d91-ac2d-2a4555357e8a")]
                                    errorText = xpath(fault, "string(//*[local-name()='faultstring'])");
                                    logger.Log.ErrorFormat("{0}GB Customs Configuration Service returned an error. Action='{1}' Key='{2}' Licence='{3}' Error:\r\n{4}", 
                                        logPrefix, soapAction, key, licence, errorText);
                                    exit = true;
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("9174904e-7e68-4b80-a4a7-08f77c418603")]
                                catch (SndCredentialsSvcTest.Operation.Fault fault)
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("b4817995-301c-4e04-9fbd-3d453024d4de")]
                                    errorText = xpath(fault, "string(//*[local-name()='faultstring'])");
                                    logger.Log.ErrorFormat("{0}GB Customs Configuration Service returned an error. Action='{1}' Key='{2}' Licence='{3}' Error:\r\n{4}", 
                                        logPrefix, soapAction, key, licence, errorText);
                                    exit = true;
                                }
                            }
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("f8c6fb9c-a759-4c79-8173-eb008412472e")]
                        if (!exit)
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("671ad3d2-191f-4122-ae58-87b5055a40d4")]
                            if (System.TimeSpan.Compare(System.DateTime.UtcNow.Subtract(sendStart), System.TimeSpan.FromMinutes(retryTimeout)) >= 0)
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("dd992c78-0d43-4130-9c8d-cccae357f24a")]
                                logger.Log.ErrorFormat("{0}Timed-out sending to GB Customs Configuration Service. Action='{1}' Key='{2}' Licence='{3}' LastError:\r\n{4}", 
                                    logPrefix, soapAction, key, licence, errorText);
                                exit = true;
                            }
                            else 
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("2249ae62-7ec1-4d44-886d-e3d82eca847f")]
                                logger.Log.DebugFormat("{0}Waiting to retry. Type='{1}' Key='{2}' Licence='{3}'", logPrefix, soapAction, key, licence);
                                
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("20b20efe-e9d4-429c-98bd-7c7aa96f08ed")]
                                delay System.TimeSpan.FromMinutes(1);
                            }
                        }
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("66daf1a5-de06-4036-802d-f7d4f7b99351")]
                    if (errorText != null && isRefresh)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("12ae6c92-6b28-469f-b867-605a0f621bab")]
                        construct SqlMsg
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("d88adbbd-2864-4b8f-999c-f9c815fa3bce")]
                            msgXml.LoadXml(CargoWise.eHub.Products.GBCustoms.CDS.BT.Helpers.CredentialsHelpers
                                .GetSqlXmlWhenAccessTokenIsFailedToBeObtained(key, errorText, cdPk, cdRv, configSenderPk, configRecipientPk, configMsgTypePk));
                            SqlMsg = msgXml;
                        }
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("74a4841b-2aaa-45c2-bc3f-d87b91e316ee")]
                        send (SndSqlPort.CompositeOperation, SqlMsg);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c6be2fc4-a736-4cbf-947e-c5a0631a613f")]
                        receive (SndSqlPort.CompositeOperation, SqlResponse);
                    }
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("08e5d867-fd83-4cc7-b219-5766789f3d44")]
                    logger.Log.InfoFormat("{0}Finished processing. Type='{1}' Key='{2}' Licence='{3}'", logPrefix, soapAction, key, licence);
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("3270a93a-876c-43e4-b135-a22cf3d53567")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("c0df1900-5f18-41fb-85f9-d3ead3dd9542")]
                        logger.Log.Error(System.String.Format("{0}Fatal error sending to GB Customs Credential Service.", logPrefix), ex);
                    }
                }
            }
        }
    }
}

