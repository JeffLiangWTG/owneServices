<?xml version="1.0" encoding="utf-8"?>
<UniversalShipment xmlns="http://www.cargowise.com/Schemas/Universal/2011/11" version="1.1">
  <Shipment>
    <DataContext>
      <DataSourceCollection>
        <DataSource>
          <Type>INManHeader</Type>
          <Key>{INManHeader.ICH_JobReference}</Key>
        </DataSource>
      </DataSourceCollection>

      <ActionPurpose>
        <Code>ICM</Code>
        <Description>India Consol Manifest</Description>
      </ActionPurpose>
      <TriggerCount>0</TriggerCount>
      <TriggerDescription></TriggerDescription>
      <TriggerType>Manual</TriggerType>

      <RecipientRoleCollection>
        <RecipientRole>
          <Code>ICE</Code>
          <Description>Indian Customs EDI System</Description>
        </RecipientRole>
      </RecipientRoleCollection>
    </DataContext>

    <Branch>
      <Code>BOM</Code>
      <Name>Mumbai (ex Bombay)</Name>
    </Branch>
    <GoodsDescription>{INManHeader.ICH_GoodsDescription}</GoodsDescription>
    <TotalNoOfPieces>{INManHeader.ICH_TotalPackages}</TotalNoOfPieces>
    <TotalWeight>{INManHeader.ICH_TotalWeight}</TotalWeight>
    <TransportMode>
      <Code>AIR</Code>
      <Description>Air Freight</Description>
    </TransportMode>
    <VoyageFlightNo>{INManHeader.ICH_Voyage}</VoyageFlightNo>
    <WayBillNumber>{INManHeader.ICH_MasterBill}</WayBillNumber>
    <WayBillType>
      <Code>MWB</Code>
      <Description>Master Waybill</Description>
    </WayBillType>

    <AddInfoCollection>
      <AddInfo>
        <Key>INManInternalTransactionNumber</Key>
        <Value>{InterchangeNumber}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManCustomsHouse</Key>
        <Value>{INManHeader.ICH_CustomsHouseEdiCode}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManBranchEDICode</Key>
        <Value>{BranchEDICode}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManTestMode</Key>
        <Value>{TestModeIndicator}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManMasterCutDate</Key>
        <Value>{INManHeader.ICH_MasterBillDate}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManIGMNumber</Key>
        <Value>{INManHeader.ICH_IGMNumber}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManIGMDate</Key>
        <Value>{INManHeader.ICH_IGMDate}</Value>
      </AddInfo>
      <AddInfo>
        <Key>INManShipmentType</Key>
        <Value>{INManHeader.ICH_ShipmentType}</Value>
      </AddInfo>
    </AddInfoCollection>

    <DateCollection>
      <Date>
        <Type>Departure</Type>
        <IsEstimate>false</IsEstimate>
        <Value>2014-08-29T00:00:00</Value>
      </Date>
      <Date>
        <Type>Arrival</Type>
        <IsEstimate>false</IsEstimate>
        <Value>2014-10-08T00:00:00</Value>
      </Date>
    </DateCollection>

    <SubShipmentCollection>
      <SubShipment>
	  
        <DataContext>
          <DataSourceCollection>
            <DataSource>
              <Type>INManBill</Type>
              <Key></Key>
            </DataSource>
          </DataSourceCollection>

          <ActionPurpose>
            <Code>FIN</Code>
            <Description>Final Manifest</Description>
          </ActionPurpose>
          <TriggerCount>0</TriggerCount>
          <TriggerDescription></TriggerDescription>
          <TriggerType>Manual</TriggerType>
        </DataContext>

        <PortOfDestination>
          <Code>{INManBill.ICB_RL_NKDischarge}</Code>
          <Name>{RefUNLOCO.RL_PortName}</Name>
        </PortOfDestination>
        <PortOfOrigin>
          <Code>{INManBill. ICB_RL_NKOrigin}</Code>
           <Name>{RefUNLOCO.RL_PortName}</Name>
       </PortOfOrigin>
        <WayBillNumber>{INManBills.ICB_HouseBill}</WayBillNumber>
        <WayBillType>
          <Code>HWB</Code>
          <Description>House Waybill</Description>
        </WayBillType>

        <AddInfoCollection>
          <AddInfo>
            <Key>INManHouseCutDate</Key>
            <Value>{INManBill.ICB_HouseBillDate}</Value>
          </AddInfo>
          <AddInfo>
            <Key>INManShipmentType</Key>
            <Value>{INManBill.ICB_ShipmentType}</Value>
          </AddInfo>
        </AddInfoCollection>

        <DateCollection>
          <Date>
            <Type>Departure</Type>
            <IsEstimate>false</IsEstimate>
            <Value>2014-10-07T09:19:00</Value>
          </Date>
        </DateCollection>

        <PackingLineCollection>
          <PackingLine>
            <GoodsDescription>{INManBills.ICB_GoodsDescription}</GoodsDescription>
            <PackQty>{INManBills.ICB_ManifestQty}</PackQty>
            <PackType>
              <Code>PK</Code>
              <Description>Packages</Description>
            </PackType>
            <Weight>{INManBills.ICB_GrossWeight}</Weight>
            <WeightUnit>
              <Code>KG</Code>
              <Description>Kilograms</Description>
            </WeightUnit>
          </PackingLine>
        </PackingLineCollection>
     </SubShipment>
	 </SubShipmentCollection>
  </Shipment>
</UniversalShipment>
