<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<appSettings>
		<add key="CargoWise.eServices.Authentication.ServiceClient.Endpoint" value="https://aws-test.wtg.zone/authentication/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	</appSettings>
	<connectionStrings>
		<add name="eHubTransactionsContext"
				 connectionString="Data Source=eHub-test.db.sand.wtg.zone;Initial Catalog=eHubTransactions;App=RoutingWS;User ID=RoutingWS;Password=$DatabasePassword$"
				 providerName="System.Data.SqlClient"
				 xdt:Transform="Replace"
				 xdt:Locator="Match(name)"/>
	</connectionStrings>
</configuration>