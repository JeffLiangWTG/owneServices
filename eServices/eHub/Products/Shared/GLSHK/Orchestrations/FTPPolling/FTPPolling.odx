[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module CargoWise.eHub.Products.Shared.GLSHK.Orchestrations
{
    internal porttype PollFTPDetailsTriggerPortType
    {
        oneway Operation
        {
            CargoWise.eHub.Products.Shared.GLSHK.Schemas.GLSHKFTPDetails.TypedPollingResultSet0
        };
    };
    internal porttype FTPPollingPortType
    {
        requestresponse Operation
        {
            CargoWise.eHub.Products.Shared.GLSHK.Schemas.GLSHKFTPDetails.TypedPollingResultSet0, System.Xml.XmlDocument
        };
    };
    internal porttype eHubInboxSQLType
    {
        oneway Operation
        {
            System.Xml.XmlDocument
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service FTPPolling
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements PollFTPDetailsTriggerPortType PollFTPDetailsTriggerPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses eHubInboxSQLType eHubInboxSQL;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses FTPPollingPortType FTPPollingPort;
        message CargoWise.eHub.Products.Shared.GLSHK.Schemas.GLSHKFTPDetails.TypedPollingResultSet0 TriggerRequest;
        message System.Xml.XmlDocument FTPResponse;
        CargoWise.eHub.Core.Logging.OrchestrationLogger logger;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("a1294587-9a87-4302-8086-07ba500f85f3")]
            activate receive (PollFTPDetailsTriggerPort.Operation, TriggerRequest);
            logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("93296103-a55f-4aa2-bb31-23a3eabd4c4e")]
            scope
            {
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("90d54e6c-17a5-4532-a321-5e678ccff1ea")]
                    if (CargoWise.eHub.Core.Orchestrations.Helper.TriggerMutex.CheckNoParallelInstanceExist(logger.Log))
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("f685979f-525e-4e2c-a336-dbb6e7037b5b")]
                        logger.Log.Info("Start processing.");
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("8cfcdfae-7d3e-432a-b761-90efc125c2c5")]
                        send (FTPPollingPort.Operation, TriggerRequest);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("fbd2e1cc-af70-4467-812a-16be22527eaa")]
                        receive (FTPPollingPort.Operation, FTPResponse);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("a544881f-7503-43e7-8050-61b536d96039")]
                        logger.Log.Info("Received 1 messages.");
                        
                        // TODO: Debatch messages and looping to sending back to BiztalkMessageBox.
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("f128f9ba-3d61-4d5b-a8b5-0e600c440dd4")]
                        send (eHubInboxSQL.Operation, FTPResponse);
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("7bc83d47-76db-471c-b9af-14efcf1688e1")]
                        logger.Log.Info("Finished processing.");
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("3d68a3e5-378d-47ae-a3ec-73ac47f912d7")]
                        logger.Log.Debug("Mutex found, Skip!");
                    }
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("9ad26ee9-c561-4921-b6b8-a19bd6846ad9")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("2b654528-8c9e-4d9c-903c-1af81af9c956")]
                        logger.Log.Error("Fatal error.", ex);
                    }
                }
            }
        }
    }
}

