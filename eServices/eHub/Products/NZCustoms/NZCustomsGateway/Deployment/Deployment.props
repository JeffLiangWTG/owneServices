<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	  <_DeploymentPropsImported>$true</_DeploymentPropsImported>
	<_AnonymousAuthenticationEnabled>true</_AnonymousAuthenticationEnabled>
    <_SiteName>Default Web Site</_SiteName>
    <_ServiceName>NZCustomsGateway</_ServiceName>
    <_BackupFolder>c:\eServicesTesting\NZCustomsGateway_backup</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
    <_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
  </PropertyGroup>
  <ItemGroup>
    <_Binding Include="1">
      <IPAddress>*</IPAddress>
      <Port>80</Port>
      <Protocol>http</Protocol>
    </_Binding>
    <_Binding Include="2">
      <Protocol>net.tcp</Protocol>
      <BindingInformation>808:*</BindingInformation>
    </_Binding>
  </ItemGroup>
</Project>