<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<system.net>
		<defaultProxy xdt:Transform="Remove"/>
	</system.net>

	<system.serviceModel>
		<bindings>
			<customBinding>
				<binding name="NZGatewayBinding">
					<httpsTransport xdt:Transform="Remove" />
					<tcpTransport manualAddressing="false" maxBufferPoolSize="1048576" maxReceivedMessageSize="1048576000" connectionBufferSize="1048576"
				 hostNameComparisonMode="StrongWildcard" channelInitializationTimeout="00:00:05"
				 maxBufferSize="1048576000" maxPendingConnections="200" maxOutputDelay="00:00:00.2000000"
				 maxPendingAccepts="200" transferMode="Buffered" listenBacklog="200"
				 portSharingEnabled="false" teredoEnabled="false" xdt:Transform="Insert">
						<connectionPoolSettings groupName="default" leaseTimeout="00:05:00" idleTimeout="00:02:00" maxOutboundConnectionsPerEndpoint="200" />
					</tcpTransport>
				</binding>
			</customBinding>
		</bindings>

		<behaviors>
			<endpointBehaviors>
				<behavior name="jbms_credentials_behavior">
					<clientCredentialsExtension>
						<!-- extb2b.tsw.message.sig.cargowise -->
						<clientCertificate findValue="3ca842c237a469c710a4a47b55774f30716cc8de" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint" xdt:Transform="Replace" xdt:Locator="XPath(//*[local-name()='clientCertificate'])"/>
						<!-- extb2b.tsw.mutual.ssl.cargowise.net -->
						<transportCertificate findValue="644e219bb837a135b522a8b2f2b554a27bcb5796" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint" xdt:Transform="Replace" xdt:Locator="XPath(//*[local-name()='transportCertificate'])"/>
						<serviceCertificate>
							<!-- extb2b.tsw.message.sig.customs.govt.nz -->
							<defaultCertificate findValue="97ec86ad31c45a15356a17e924520a4f3097a834" storeLocation="LocalMachine" storeName="TrustedPeople" x509FindType="FindByThumbprint" xdt:Transform="Replace" xdt:Locator="XPath(//*[local-name()='defaultCertificate'])"/>
						</serviceCertificate>
					</clientCredentialsExtension>
				</behavior>
			</endpointBehaviors>
		</behaviors>
		<client>
			<endpoint address="https://extb2b.customs.govt.nz/soap?service=TSW_WS_SUBMIT_LODGEMENT&amp;TP=CARGOWISE"
			  binding="customBinding"
			  bindingConfiguration="jbms_swa_binding"
			  behaviorConfiguration="jbms_credentials_behavior"
			  contract="SubmitLodgement_v2"
			  name="SubmitLodgement"  xdt:Transform="Replace" xdt:Locator="Match(name)">
				<identity>
					<dns value="extb2b.tsw.message.sig.customs.govt.nz"/>
				</identity>
			</endpoint>
		</client>
	</system.serviceModel>
</configuration>