<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
	<_DeploymentPropsImported>$true</_DeploymentPropsImported>
	<_ServiceName>NZCustomsPullWindowsService</_ServiceName>
    <_ServiceDisplayName>NZCustomsPullWindowsService</_ServiceDisplayName>
    <_ServiceDescription>NZCustomsPullWindowsService</_ServiceDescription>
    <_ServiceFilesPath>$(OutputPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eHub.Products.NZCustoms.PullService.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServicesTesting\NZCustomsServices</_DeploymentFolder>
    <_BackupFolder>c:\eServicesTesting\NZCustoms_backup</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>