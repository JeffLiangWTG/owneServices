<?xml version="1.0" encoding="UTF-8"?><!-- edited with XMLSpy v2013 sp1 (http://www.altova.com) by Glenn Dodd (Express Couriers Limited) --><!-- edited with XMLSPY v2004 rel. 3 U (http://www.xmlspy.com) by NZ POST (NZ Post) --><xs:schema xmlns:b="http://schemas.microsoft.com/BizTalk/2003" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://ECL.Online.BT.Preadvice.Preadvice_v1_5_XML.xsd" targetNamespace="http://ECL.Online.BT.Preadvice.Preadvice_v1_5_XML.xsd" elementFormDefault="qualified" attributeFormDefault="unqualified">	<xs:element name="PreAdviceEDI">		<xs:annotation>			<xs:documentation>A preadvice is used to sent barcode and address information to the Auckland Operation Centres sorting machine. This helps the machine to auto sort the items.</xs:documentation>		</xs:annotation>		<xs:complexType>			<xs:sequence>				<xs:element name="PAHeader">					<xs:annotation>						<xs:documentation>Message Header</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="MessageID">								<xs:annotation>									<xs:documentation>Customer Message ID for this message</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="20"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="MessageDatetime" type="xs:dateTime">								<xs:annotation>									<xs:documentation>Time this message is created and submitted to ECL. EXAMPLE: 2011-06-09T10:00:00</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="AccountNo" minOccurs="0">								<xs:annotation>									<xs:documentation>Account Number (TPID) can be supplied.</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="20"/>									</xs:restriction>								</xs:simpleType>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>				<xs:element name="PADetail" maxOccurs="unbounded">					<xs:annotation>						<xs:documentation>One record per Barcode</xs:documentation>					</xs:annotation>					<xs:complexType>						<xs:sequence>							<xs:element name="ItemBarcode">								<xs:annotation>									<xs:documentation>CourierPost tracking Number. This is the one the courier scans on the label.</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="40"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="Address1">								<xs:annotation>									<xs:documentation>Delivery Address details</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="150"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="Address2">								<xs:annotation>									<xs:documentation>Delivery Address details</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="150"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="Address3">								<xs:annotation>									<xs:documentation>Delivery Address details</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="150"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="CompanyName" minOccurs="0">								<xs:annotation>									<xs:documentation>Company Delivery Address detail</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="100"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="StreetNo" type="xs:integer" minOccurs="0">								<xs:annotation>									<xs:documentation>This value can be returned by the Address Validation Web Service</xs:documentation>								</xs:annotation>							</xs:element>							<xs:element name="StreetName" minOccurs="0">								<xs:annotation>									<xs:documentation>This value can be returned by the Address Validation Web Service</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="150"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="Suburb" minOccurs="0">								<xs:annotation>									<xs:documentation>This value can be returned by the Address Validation Web Service. It may already be part of the Address 1/2/3 values. Please repeat ot here if you have specific data.</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="150"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="Town" minOccurs="0">								<xs:annotation>									<xs:documentation>This value can be returned by the Address Validation Web Service. It may already be part of the Address 1/2/3 values. Please repeat it here if you have specific data.</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="150"/>									</xs:restriction>								</xs:simpleType>							</xs:element>							<xs:element name="ServiceLevel" default="CPOLP" minOccurs="0">								<xs:annotation>									<xs:documentation>Service Level. CPOLP for Overnight Parcel, CPOLE for Economy Parcel, CPOLTP for Trackpaks.</xs:documentation>								</xs:annotation>								<xs:simpleType>									<xs:restriction base="xs:string">										<xs:maxLength value="10"/>									</xs:restriction>								</xs:simpleType>							</xs:element>						</xs:sequence>					</xs:complexType>				</xs:element>			</xs:sequence>		</xs:complexType>	</xs:element></xs:schema>