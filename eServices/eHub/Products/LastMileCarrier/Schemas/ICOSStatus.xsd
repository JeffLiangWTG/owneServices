<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="Message">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Header" minOccurs="1">
					<xs:complexType>
						<xs:sequence minOccurs="1">
							<xs:element name="SenderID" type="xs:string"/>
							<xs:element name="RecipientID" type="xs:string"/>
							<xs:element name="Timestamp" type="xs:dateTime"/>
							<xs:element name="MessageSystem" type="xs:string" fixed="ICOS LIVE"/>
							<xs:element name="MessageType" type="xs:string" fixed="CONSIGNMENT_UPDATE"/>
							<xs:element name="MessageToken" type="xs:integer"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Body">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Consignment" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ConsignmentID" type="xs:string"/>
										<xs:element name="Docket" type="xs:string"/>
										<xs:element name="ICOSID" type="xs:string"/>
										<xs:element name="ContainerNumber">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:length value="11"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="StatusChange" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="EventToken" type="xs:integer"/>
													<xs:element name="Date" type="xs:dateTime"/>
													<xs:element name="Actioncode" type="xs:string"/>
													<xs:element name="Action" type="xs:string"/>
													<xs:element name="ChangedBy" type="xs:string"/>
													<xs:element name="VehicleID" type="xs:string"/>
													<xs:element name="Comments" type="xs:string"/>
													<xs:element name="EventDetail">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="DeliveredTo" type="xs:string"/>
																<xs:element name="Signature" type="xs:string"/>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
