<xs:schema targetNamespace="http://ECL.Online.BT.Preadvice.PreadviceResponse_v1_0_XML.xsd" xmlns:b="http://schemas.microsoft.com/BizTalk/2003" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://ECL.Online.BT.Preadvice.PreadviceResponse_v1_0_XML.xsd" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="PreadviceResponse">
		<xs:annotation>
			<xs:documentation>Response to the Pre-Advice Request from the ECL system</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="RespType" type="xs:string">
					<xs:annotation>
						<xs:documentation>"AP" for an acceptance. "RE" for a rejection.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageID" type="xs:string">
					<xs:annotation>
						<xs:documentation>Customer Message ID as submitted in the request</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageDateTime" type="xs:dateTime">
					<xs:annotation>
						<xs:documentation>Time this message is created and submitted to back to the customer. EXAMPLE: 2011-06-09T10:00:00</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="RejectCode" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>If RespType is "RE" then the reject code will be here</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="RejectReason" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>If RespType is "RE" then the reject reason will be here</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
