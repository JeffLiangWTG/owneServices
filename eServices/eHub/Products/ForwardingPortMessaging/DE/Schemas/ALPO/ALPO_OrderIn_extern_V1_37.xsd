            <xs:maxLength value="7" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ALPOAuftragNr" type="xs:string">
        <xs:annotation>
          <xs:documentation>ALPO order number of the existing BHT port order</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="MRN">
        <xs:annotation>
          <xs:documentation>MRN within the BHT port order</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="18" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="MRNStatusCode">
        <xs:annotation>
          <xs:documentation>Code of the new MRN status

                        “RE” = MRN wurde in ATL@S-EAS erstellt/registriert
                        “KO” = Kontrollmaßnahme der Zollbehörde zur MRN “02” = Überlassen
                        “03” = Ausgang Untersagt
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="2" />
            <xs:enumeration value="RE" />
            <xs:enumeration value="KO" />
            <xs:enumeration value="02" />
            <xs:enumeration value="03" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="MRNKontrollCode">
        <xs:annotation>
          <xs:documentation>Means of control
                        Mandatory if MRNStatusCode = KO

                        “D001” = papiermäßige Überprüfung
                        “P001” = vollständige Kontrolle
                        “R001” = Kontrolle in Bezug auf nukleare/radioaktive Materialien
                        “S001” = Verschlusskontrolle “X001” = Röntgenkontrolle (inkl. andere von außen vorzunehmende
                        Untersuchungen)
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="4" />
            <xs:enumeration value="D001" />
            <xs:enumeration value="P001" />
            <xs:enumeration value="R001" />
            <xs:enumeration value="S001" />
            <xs:enumeration value="X001" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
