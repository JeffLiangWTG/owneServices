<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xsd:element name="SubmitInstruction">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Header" nillable="false">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="InterchangeSenderId" nillable="false" type="xsd:string"/>
							<xsd:element name="InterchangeReceipientId" nillable="false" type="xsd:string"/>
							<xsd:element name="DateTimeStamp" nillable="true" type="xsd:string"/>
							<xsd:element name="InterchangeNumber" nillable="true" type="xsd:string"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="Transactions" nillable="false">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Transaction" nillable="false">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="Properties" nillable="false">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="TransactionStatus" nillable="false" type="xsd:string"/>
													<xsd:element name="TransactionVersion" nillable="true" type="xsd:string"/>
													<xsd:element name="TransactionSource" nillable="true" type="xsd:string"/>
													<xsd:element name="DocumentIdentifier" nillable="false" type="xsd:string"/>
													<xsd:element name="DocumentRevisionNumber" nillable="true" type="xsd:string"/>
													<xsd:element name="DocumentRevisionReason" nillable="true" type="xsd:string"/>
													<xsd:element name="ShipmentID" nillable="false" type="xsd:string"/>
													<xsd:element name="DateTime" nillable="true">
														<xsd:complexType mixed="true">
															<xsd:attribute name="Type" type="xsd:string" use="required"/>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="Document" nillable="true" minOccurs="0">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="DocumentName" nillable="false" type="xsd:string"/>
																<xsd:element name="OrderNumber" nillable="true" type="xsd:string"/>
																<xsd:element name="ReferenceInformation" nillable="true">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="TPTEnquiryNumber" nillable="true" type="xsd:string"/>
																			<xsd:element name="ContractNumber" nillable="true" type="xsd:string"/>
																			<xsd:element name="CustomsReleaseAttachment" nillable="true" type="xsd:base64Binary"/>
																		</xsd:sequence>
																	</xsd:complexType>
																</xsd:element>
																<xsd:element name="LinerTerms" nillable="true" type="xsd:string"/>	
                                                                <xsd:element name="TransportMode" nillable="false" type="xsd:string" minOccurs="1"/>
																<xsd:element name="RailAccountNumber" nillable="true" type="xsd:string" minOccurs="0"/>
															    <xsd:element name="RailDestination" nillable="true" type="xsd:string" minOccurs="0"/>	
															    <xsd:element name="RailSidingNumber" nillable="true" type="xsd:string" minOccurs="0"/>	   
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="Charges" nillable="true" minOccurs="0" maxOccurs="10">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="Description" nillable="true" type="xsd:string"/>
																<xsd:element name="Tons" nillable="true" type="xsd:string"/>
																<xsd:element name="Rates" nillable="true" type="xsd:string"/>
																<xsd:element name="Value" nillable="true" type="xsd:string"/>
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="TransportationDetails" nillable="false" maxOccurs="2">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="ConveyanceInformation" nillable="false">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="TransportMode" nillable="false"  minOccurs="1" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="TransportStage" nillable="false"  minOccurs="1" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="VesselType" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="VesselName" nillable="false"  minOccurs="1" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="InVoyageNumber" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="OutVoyageNumber" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="EstimatedTimeArrival" nillable="false"  minOccurs="1" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="LloydsCode" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="CallSign" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string" />
																			<xsd:element name="ShippingLineCode" nillable="true"   minOccurs="0" maxOccurs="1" type="xsd:string"/>
																		</xsd:sequence>
																	</xsd:complexType>
																</xsd:element>
																<xsd:element name="Location" nillable="true">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="PortOfLoad" nillable="true">
																				<xsd:complexType>
																					<xsd:sequence>
																						<xsd:element name="PortId" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string"/>
																						<xsd:element name="PortIdConvention" nillable="true"  minOccurs="0" type="xsd:string"/>
																						<xsd:element name="PortName" nillable="true" minOccurs="0" maxOccurs="1" type="xsd:string" />
																					</xsd:sequence>
																				</xsd:complexType>
																			</xsd:element>
																			<xsd:element name="PortOfDischarge" nillable="true">
																				<xsd:complexType>
																					<xsd:sequence>
																						<xsd:element name="PortId" nillable="true" minOccurs="0" maxOccurs="1" type="xsd:string" />
																						<xsd:element name="PortIdConvention" nillable="true"  minOccurs="0" type="xsd:string"/>
																						<xsd:element name="PortName" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string"/>
																					</xsd:sequence>
																				</xsd:complexType>
																			</xsd:element>
																		</xsd:sequence>
																	</xsd:complexType>
																</xsd:element>
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="Party" nillable="true" minOccurs="1" maxOccurs="3">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="Role" nillable="true" type="xsd:string"/>
																<xsd:element name="Name" nillable="true" type="xsd:string"/>
																<xsd:element name="Identifier" nillable="true" minOccurs="0" maxOccurs="1">
																	<xsd:complexType mixed="true">
																		<xsd:attribute name="Type" type="xsd:string" use="required"/>
																	</xsd:complexType>
																</xsd:element>
																<xsd:element name="Contacts" nillable="true" minOccurs="0">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="Type" nillable="true" type="xsd:string"/>
																			<xsd:element name="Name" nillable="true" type="xsd:string"/>
																			<xsd:element name="CommunicationDetails" nillable="true">
																				<xsd:complexType>
																					<xsd:sequence>
																						<xsd:element name="Phone" nillable="true" type="xsd:string"/>
																						<xsd:element name="Fax" nillable="true" type="xsd:string"/>
																						<xsd:element name="Email" nillable="true" type="xsd:string"/>
																					</xsd:sequence>
																				</xsd:complexType>
																			</xsd:element>
																		</xsd:sequence>
																	</xsd:complexType>
																</xsd:element>
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="ControlTotal" nillable="false">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="NumberOfEquipment" nillable="true" type="xsd:string"/>
																<xsd:element name="NumberOfPackages" nillable="true" type="xsd:string"/>
																<xsd:element name="GrossWeight" nillable="true">
																	<xsd:complexType mixed="true">
																		<xsd:attribute name="UOM" type="xsd:string" use="required"/>
																	</xsd:complexType>
																</xsd:element>
																<xsd:element name="GrossVolume" nillable="true">
																	<xsd:complexType mixed="true">
																		<xsd:attribute name="UOM" type="xsd:string" use="required"/>
																	</xsd:complexType>
																</xsd:element>
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="Details" nillable="false" >
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="GoodsDetails" nillable="false"  maxOccurs="99999">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="LineNumber" nillable="false" type="xsd:string"/>
																<xsd:element name="PackageDetail" nillable="false">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="OuterPack" nillable="false">
																				<xsd:complexType>
																					<xsd:sequence>
																					<xsd:element name="NumberOfEquipment" nillable="false" minOccurs="1" maxOccurs="1"  type="xsd:string" />
																					<xsd:element name="NumberOfPackages" nillable="false" minOccurs="1" maxOccurs="1"  type="xsd:string" />
																						<xsd:element name="PackageTypeCode" nillable="false" minOccurs="1" maxOccurs="1"  type="xsd:string" />
																						<xsd:element name="PackageTypeDescription" nillable="true"  minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																						<xsd:element name="GoodGrossVolume" nillable="true" minOccurs="0" maxOccurs="1" >
																							<xsd:complexType mixed="true">
																								<xsd:attribute name="UOM" type="xsd:string" use="optional"/>
																							</xsd:complexType>
																						</xsd:element>
																						<xsd:element name="GoodGrossWeight" nillable="true" minOccurs="0" maxOccurs="1" >
																							<xsd:complexType mixed="true">
																								<xsd:attribute name="UOM" type="xsd:string" use="optional"/>
																							</xsd:complexType>
																						</xsd:element>
																						<xsd:element name="GoodsLength" nillable="true" minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																						<xsd:element name="GoodsWidth" nillable="true" minOccurs="0" maxOccurs="1"   type="xsd:string"/>
																						<xsd:element name="GoodsHeight" nillable="true"  minOccurs="0" maxOccurs="1"   type="xsd:string"/>
																						<xsd:element name="GoodDescription" nillable="false"  minOccurs="1" maxOccurs="1"  type="xsd:string"/>
																						<xsd:element name="CommodityClassification" nillable="true" minOccurs="0" maxOccurs="1"  >
																							<xsd:complexType>
																								<xsd:sequence>
																									<xsd:element name="HasOwnWheels" nillable="true"  minOccurs="0" maxOccurs="1" type="xsd:string"/>
																									<xsd:element name="NewUsedCargo" nillable="true"  minOccurs="0" maxOccurs="1"  type="xsd:string" />
																									<xsd:element name="PalletisedCargo" nillable="true" minOccurs="0" maxOccurs="1"   type="xsd:string" />
																									<xsd:element name="CoastwiseCargo" nillable="true"  minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																								</xsd:sequence>
																							</xsd:complexType>
																						</xsd:element>
																						<xsd:element name="CustomsReferenceInformation" nillable="true"  minOccurs="0" maxOccurs="1">
																							<xsd:complexType>
																								<xsd:sequence>
																									<xsd:element name="BillofLading" nillable="true" minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																									<xsd:element name="BillofEntry" nillable="false"  minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																									<xsd:element name="BillofEntryDate" nillable="false"  minOccurs="0" maxOccurs="1"/>
																									<xsd:element name="MRNNumber" nillable="false"  minOccurs="1" maxOccurs="1"   type="xsd:string"/>
																									<xsd:element name="LRNNumber" nillable="true"  minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																								</xsd:sequence>
																							</xsd:complexType>
																						</xsd:element>
																						<xsd:element name="HazardousGoods" nillable="true" minOccurs="0">
																							<xsd:complexType>
																								<xsd:sequence>
																									<xsd:element name="IMOClassCode" nillable="true" type="xsd:string"/>
																								</xsd:sequence>
																							</xsd:complexType>
																						</xsd:element>
																						<xsd:element name="MarksAndNumbers" nillable="false"  minOccurs="1" maxOccurs="999" type="xsd:string"/>
																						<xsd:element name="InnerPack" nillable="true" minOccurs="0" maxOccurs="unbounded" >
																							<xsd:complexType>
																								<xsd:sequence>
																									<xsd:element name="EquipmentIdentifier" nillable="false"  minOccurs="1" maxOccurs="1"   type="xsd:string"/>
																									<xsd:element name="NumberOfPackages" nillable="false"  minOccurs="1" maxOccurs="1" type="xsd:string" />
																									<xsd:element name="PackageTypeCode" nillable="false"  minOccurs="1" maxOccurs="1"    type="xsd:string"/>
																									<xsd:element name="PackageTypeDescription" nillable="true"  minOccurs="0" maxOccurs="1"   type="xsd:string"/>
																									<xsd:element name="GoodGrossVolume" nillable="true" minOccurs="0" maxOccurs="1"  >
																										<xsd:complexType mixed="true">
																											<xsd:attribute name="UOM" type="xsd:string" use="optional"/>
																										</xsd:complexType>
																									</xsd:element>
																									<xsd:element name="GoodGrossWeight" nillable="true" minOccurs="0" maxOccurs="1"  >
																										<xsd:complexType mixed="true">
																											<xsd:attribute name="UOM" type="xsd:string" use="optional"/>
																										</xsd:complexType>
																									</xsd:element>
																									<xsd:element name="GoodsLength" nillable="true" minOccurs="0" maxOccurs="1"   type="xsd:string"/>
																									<xsd:element name="GoodsWidth" nillable="true"  minOccurs="0" maxOccurs="1"  type="xsd:string"/>
																									<xsd:element name="GoodsHeight" nillable="true"  minOccurs="0" maxOccurs="1"   type="xsd:string"/>
																									<xsd:element name="GoodDescription" nillable="false"  minOccurs="1" maxOccurs="1"   type="xsd:string"/>
																									<xsd:element name="MarksAndNumbers" nillable="true"  minOccurs="0" maxOccurs="999"   type="xsd:string"/>
																								</xsd:sequence>
																							</xsd:complexType>
																						</xsd:element>
																					</xsd:sequence>
																				</xsd:complexType>
																			</xsd:element>
																		</xsd:sequence>
																	</xsd:complexType>
																</xsd:element>
															</xsd:sequence>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>