<?xml version="1.0" encoding="iso-8859-1"?>
<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/DOSExport"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/DOSExport">

  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>
  <xs:complexType name="dossier_export_type">
    <xs:sequence>
      <xs:element name="reference-dos" type="reference_dos_type"/>
      <xs:element name="tiers-dos" type="tiers_dos_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="reference-annexe-dos" type="reference_annexe_dos_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="booking-dos" type="booking_dos_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="billOfLading-dos" type="billOfLading_dos_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="amq-dos" type="amq_dos_type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="reference_dos_type">
    <xs:sequence>
      <xs:element name="commentaires-dos" type="commentaires_dos_type" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="ext" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tri" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="tre" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="baeti" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="baete" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="ndu" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="last" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="comp" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="ndp" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="nb-decl" type="xs:integer" use="optional"/>
  </xs:complexType>
  <xs:complexType name="tiers_dos_type">
    <xs:sequence>
      <xs:element name="commentaires-dos" type="commentaires_dos_type" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="code" type="xs:string" use="optional"/>
    <xs:attribute name="nom" type="xs:string" use="optional"/>
    <xs:attribute name="ref" type="xs:string" use="optional"/>
    <xs:attribute name="nad" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:simpleType name="reference_annexe_dos_type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="17"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="commentaires_dos_type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="210"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="booking_dos_type">
    <xs:attribute name="refBooking" type="xs:string" use="optional"/>
    <xs:attribute name="agentFret" type="xs:string" use="optional"/>
    <xs:attribute name="armement" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="billOfLading_dos_type">
    <xs:attribute name="refBL" type="xs:string" use="optional"/>
    <xs:attribute name="agentFret" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="amq_dos_type">
    <xs:attribute name="sic" type="xs:string" use="optional"/>
    <xs:attribute name="hist" type="xs:integer" use="optional"/>
    <xs:attribute name="baed" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="nbDecl" type="xs:string" use="optional"/>
    <xs:attribute name="dernDecl" type="std:Booleen_type" use="optional"/>
  </xs:complexType>
</xs:schema>
