                    <xs:documentation>Commentaires des détails de la demande de déplacement.</xs:documentation>
                  </xs:annotation>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="autorisation-dec" type="autorisation_dec_type" minOccurs="0">
