    <xs:attribute name="port-lib" type="xs:string" use="optional"/>
    <xs:attribute name="tiers-a-facturer" type="xs:string" use="optional"/>
    <xs:attribute name="tiers-lib" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="demande_depl_type">
    <xs:annotation>
      <xs:documentation>Type Racine pour la Request</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="reference-req" type="reference_req_type">
        <xs:annotation>
          <xs:documentation>Informations générales: demandeur, lieu prenant, lieu cédant, référence, statut, Motif (Sic ou libre) de la demande + commentaires + masse et volume à 15°</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="lmarchandise-req" type="lmarchandise_req_type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Infos de l'amq à déplacer</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="droits-req" type="droits_req_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Droits de port</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="autorisation-req" type="autorisation_req_type" minOccurs="0">
