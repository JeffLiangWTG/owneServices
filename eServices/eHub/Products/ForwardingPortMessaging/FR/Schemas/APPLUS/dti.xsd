<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/DTI"
           xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/DTI">

  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>
  <!-- Les  schémas unitaires -->
  
  <xs:complexType name="typeselection_sesy_type">
    <xs:attribute name="indselection-scanner" type="std:Booleen_type">
      <xs:annotation>
        <xs:documentation>Selection causee par scanner</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indselection-depotage" type="std:Booleen_type">
      <xs:annotation>
        <xs:documentation>Selection causee par depotage</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indselection-ouverture" type="std:Booleen_type">
      <xs:annotation>
        <xs:documentation>Selection causee par ouverture</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="indselection-controle" type="std:Booleen_type">
      <xs:annotation>
        <xs:documentation>Selection causee par controle</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="user_type">
    <xs:attribute name="user" use="required">
      <xs:annotation>
        <xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiersProf" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="email" type="xs:string" use="optional"/>
    <xs:attribute name="adresse" type="xs:string" use="optional"/>
    <xs:attribute name="reseau" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="notification_type">
    <xs:choice>
      <xs:element ref="deplacement"/>
      <!-- ** xs:element ref="liste-lpc"/ -->
      <!-- ** xs:element ref="lpe"/ -->
    </xs:choice>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du document envoyé ou imprimé.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document notifié ou imprimé (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|PRINT|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" type="xs:string" use="optional"/>
    <xs:attribute name="ref" type="xs:string" use="optional"/>
    <xs:attribute name="aerien" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="request_type">
    <xs:choice>
      <xs:element name="demande-depl" type="demande_depl_type">
        <xs:annotation>
          <xs:documentation>Request d'une demande de déplacement</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du message utilisé pour effectuer le suivi de l intégration.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document à intégrer (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Request" type="request_type">
    <xs:annotation>
      <xs:documentation>Request précise la nature du document à intégrer.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Notification" type="notification_type">
    <xs:annotation>
      <xs:documentation>Notification précise la nature du document à notifier ou imprimer</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Interchanges">
    <xs:annotation>
      <xs:documentation>Interchanges décrit le contexte de la transmission des données entre le SIC et le système partenaire.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MessageSet" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="from" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système émetteur</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="to" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système destinataire</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="servername" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="MessageSet">
    <xs:annotation>
      <xs:documentation>MessageSet identifie le message et permet d'assurer le suivi des échanges.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Destinataire"/>
        <xs:element ref="Emetteur"/>
        <xs:element name="Messages" type="messages_type">
          <xs:annotation>
            <xs:documentation>Messages contient le document à integrer, à notifier, à imprimer ou à acquitter</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="icid" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange de rattachement du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="date" type="std:DateLongue_type" use="required">
        <xs:annotation>
          <xs:documentation>"31/12/2004 23:59:59" Date d'envoi du message.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Destinataire" type="user_type">
    <xs:annotation>
      <xs:documentation>Identification du tiers destinataire du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Emetteur" type="user_type">
    <xs:annotation>
      <xs:documentation>Identification de l'émetteur du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="deplacement" type="deplacement_type">
    <xs:annotation>
      <xs:documentation>Déplacement décrit une demande de déplacement de marchandise.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="reference_dec_type">
    <xs:annotation>
      <xs:documentation>Reférences à laquelle est rattachée la demande de déplacement.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="sic" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la demande de déplacement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ori" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Origine de la demande de déplacement (Utilisateur ou généré par le système comme par exemple le changement de booking).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date à laquelle la demnade de transfert a été validée.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:annotation>
        <xs:documentation>Statut de la demande de déplacement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sens" use="optional">
      <xs:annotation>
        <xs:documentation>Sens de la demande pour le transfert Interzone.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" type="xs:string" use="optional"/>
    <xs:attribute name="num" type="xs:integer" use="optional"/>
    <xs:attribute name="ref" type="xs:string" use="optional"/>
    <xs:attribute name="efr" type="xs:string" use="optional"/>
    <xs:attribute name="update-douane-dso" use="optional">
      <xs:annotation>
        <xs:documentation>Permet de savoir si c'est un update sur une DSO qui est fait par la douane.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="num-doss" type="xs:string" use="optional"/>
    <xs:attribute name="extdoc" use="optional">
      <xs:annotation>
        <xs:documentation>Référence BL</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="doc" use="optional">
      <xs:annotation>
        <xs:documentation>Id. AP+ BL</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="11"/>
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="refotc" use="optional">
      <xs:annotation>
        <xs:documentation>Référence OTC</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="voyage_dec_type">
    <xs:annotation>
      <xs:documentation>Voyage à laquelle est rattachée la demande de déplacement</xs:documentation>
    </xs:annotation>
    <xs:attribute name="atp" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'Annonce de Transport Physique à laquelle est rattachée la demande de déplacement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="atm" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'Annonce de Transport Massifiée dans le cas de transit Interzone.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ref-voyage-atm" use="optional">
      <xs:annotation>
        <xs:documentation>Référence voyage de l'ATM</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="35"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ref-interne-atm" use="optional">
      <xs:annotation>
        <xs:documentation>Référence interne de l'ATM</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="35"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="reptrans" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du représentant du transporteur de l'Annonce de Transport Physique.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="date" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date de passage du voyage.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="nav" type="xs:string" use="optional"/>
    <xs:attribute name="reptrans-lib" type="xs:string" use="optional"/>
    <xs:attribute name="terrestre" type="std:Booleen_type" use="optional"/>
  </xs:complexType>
  <xs:complexType name="tiers_dec_type">
    <xs:annotation>
      <xs:documentation>Tiers concernés par la demande de déplacement.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="dem" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du demandeur du déplacement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="afret" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'agent fret.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="hors" type="xs:string" use="optional"/>
    <xs:attribute name="dem-lib" type="xs:string" use="optional"/>
    <xs:attribute name="rec" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rec-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fac" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fac-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trport" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trport-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dec" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dec-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="lieu_dec_type">
    <xs:annotation>
      <xs:documentation>Lieu de réception concerné par la demande de déplacement.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="zone" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la zone à laquelle appartient le lieu de livraison.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de réception livraison.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionnaire du lieu de réception livraison.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="md" type="xs:string" use="optional"/>
    <xs:attribute name="zone-lib" type="xs:string" use="optional"/>
    <xs:attribute name="lieu-lib" type="xs:string" use="optional"/>
    <xs:attribute name="manut-lib" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="bureau_dec_type">
    <xs:annotation>
      <xs:documentation>Bureau de douane auquel est rattaché le lieu de réception livraison.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="pays" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC du pays du bureau de douane.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="2"/>
          <xs:maxLength value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="code" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC du bureau de douane.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="num" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur numéro de garantie.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="optional">
      <xs:annotation>
        <xs:documentation>Type de garantie.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="garantie" use="optional">
      <xs:annotation>
        <xs:documentation>Code garantie du demandeur de la demande de déplacement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bpc-lib" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="detail_dec_type">
    <xs:annotation>
      <xs:documentation>Détails spécifiques de la demande de transfert.</xs:documentation>
    </xs:annotation>
    <xs:attribute name="code" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du motif de la demande de déplacement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="motif" use="optional">
      <xs:annotation>
        <xs:documentation>Motif littéral de la demande de déplacement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="horodatage" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date d'exécution de la demande de déplacement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="horo-depart" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date de départ de la demande de déplacement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="masse" type="std:Poids_type" use="optional">
      <xs:annotation>
        <xs:documentation>Masse Nette à 15°.</xs:documentation>
      </xs:annotation>
      <!--<xs:simpleType>
                <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                    <xs:maxInclusive value="999999"/>
                </xs:restriction>
            </xs:simpleType>-->
    </xs:attribute>
    <xs:attribute name="vol" use="optional">
      <xs:annotation>
        <xs:documentation>Volume Total à 15°.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:minInclusive value="1"/>
          <xs:maxInclusive value="999999"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="optional">
      <xs:annotation>
        <xs:documentation>Type d'enlèvement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
