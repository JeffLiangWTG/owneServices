  <xs:complexType name="droits_dec_type">
    <xs:annotation>
      <xs:documentation>Indique le montant des droits de port</xs:documentation>
    </xs:annotation>
    <xs:attribute name="montant-total" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:integer">
