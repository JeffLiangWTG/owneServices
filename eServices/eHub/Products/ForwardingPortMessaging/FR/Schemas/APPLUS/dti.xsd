          <xs:documentation>Autorisation services Vétérinaires ou Phytosanitaires (si besoin)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="acheminement-req" type="acheminement_req_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Info d'acheminement: transporteur (Sic ou libre), identifiant du moyen de transport et type de moyen de transport</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="interzone-req" type="interzone_req_type" minOccurs="0">
