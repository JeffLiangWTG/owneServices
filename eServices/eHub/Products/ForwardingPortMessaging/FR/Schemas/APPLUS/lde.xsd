<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/LDE"
           xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/LDE">

  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>

  <xs:element name="empotage">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="reference-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="lpe" type="xs:string" use="optional"/>
            <xs:attribute name="cbk" type="xs:string" use="optional"/>
            <xs:attribute name="extcbk" type="xs:string" use="optional"/>
            <xs:attribute name="statut" type="xs:string" use="optional"/>
            <xs:attribute name="rang" type="std:Integer_type" use="optional"/>
            <xs:attribute name="rec" type="xs:string" use="optional"/>
            <xs:attribute name="ref" type="xs:string" use="optional"/>
            <xs:attribute name="lde" type="xs:string" use="optional"/>
            <xs:attribute name="sic" type="xs:string" use="optional"/>
            <xs:attribute name="hist" type="std:Integer_type" use="optional"/>
            <xs:attribute name="extempotage" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="lieu-emp">
          <xs:complexType>
            <xs:attribute name="lieu" type="xs:string" use="required"/>
            <xs:attribute name="zone" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="voyage-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="otc" type="xs:string" use="optional"/>
            <xs:attribute name="ser" type="xs:string" use="optional"/>
            <xs:attribute name="atp" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="tiers-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="afret" use="optional">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:maxLength value="9"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="trport" use="optional">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:maxLength value="9"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
        <xs:element name="reference-annexe-emp" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="commentaire-emp" type="xs:string" minOccurs="0"/>
        <xs:element name="deplacement-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="sic" type="xs:string" use="optional"/>
            <xs:attribute name="code" type="xs:string" use="optional"/>
            <xs:attribute name="nom" type="xs:string" use="optional"/>
            <xs:attribute name="lieu" type="xs:string" use="optional"/>
            <xs:attribute name="zone" type="xs:string" use="optional"/>
            <xs:attribute name="id" type="xs:string" use="optional"/>
            <xs:attribute name="date" type="std:DateComplete_type" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="equipement-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="id" type="xs:string" use="optional"/>
            <xs:attribute name="tare" type="std:Poids_type" use="optional"/>
            <xs:attribute name="code" type="xs:string" use="optional"/>
            <xs:attribute name="poids" type="std:Poids_type" use="optional"/>
            <xs:attribute name="dim" type="std:Booleen_type" use="optional"/>
            <xs:attribute name="frigo" type="std:Booleen_type" use="optional"/>
            <xs:attribute name="polluant" type="std:Booleen_type" use="optional"/>
            <xs:attribute name="dgx" type="std:Booleen_type" use="optional"/>
            <xs:attribute name="oh" type="std:Integer_type" use="optional"/>
            <xs:attribute name="owl" type="std:Integer_type" use="optional"/>
            <xs:attribute name="owr" type="std:Integer_type" use="optional"/>
            <xs:attribute name="olf" type="std:Integer_type" use="optional"/>
            <xs:attribute name="olb" type="std:Integer_type" use="optional"/>
            <xs:attribute name="min" type="std:Temperature_type" use="optional"/>
            <xs:attribute name="max" type="std:Temperature_type" use="optional"/>
            <xs:attribute name="unite" use="optional">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:pattern value="CEL|FAH"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="long" type="std:Integer_type" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="support-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="id" type="xs:string" use="optional"/>
            <xs:attribute name="code" type="xs:string" use="optional"/>
            <xs:attribute name="tare" type="std:Poids_type" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="acheminement-emp" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="sic" type="xs:string" use="optional"/>
            <xs:attribute name="id" type="xs:string" use="optional"/>
            <xs:attribute name="code" type="xs:string" use="optional"/>
            <xs:attribute name="nom" type="xs:string" use="optional"/>
            <xs:attribute name="date" type="std:DateComplete_type" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="instruction-emp" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="commentaire-frigo-emp" type="xs:string" minOccurs="0"/>
              <xs:element name="commentaire-fum-emp" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="frigo" type="std:Booleen_type" use="optional"/>
            <xs:attribute name="tiers-frigo" type="xs:string" use="optional"/>
            <xs:attribute name="fum" type="std:Booleen_type" use="optional"/>
            <xs:attribute name="tiers-fum" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="marchandise-emp" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="marques-emp" type="xs:string" minOccurs="0"/>
              <xs:element name="mesurage-emp" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="marques-emp" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                  <xs:attribute name="code" type="xs:string" use="optional"/>
                  <xs:attribute name="qte" type="std:Integer_type" use="optional"/>
                  <xs:attribute name="vol" type="std:Integer_type" use="optional"/>
                  <xs:attribute name="num" type="xs:long" use="optional"/>
                  <xs:attribute name="ref" type="xs:string" use="optional"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="declaration-emp" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="total" type="std:Booleen_type" use="optional"/>
                  <xs:attribute name="nb" type="std:Integer_type" use="optional"/>
                  <xs:attribute name="poids" type="std:Poids_type" use="optional"/>
                  <xs:attribute name="dec" type="xs:string" use="optional"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="sic" type="xs:string" use="optional"/>
            <xs:attribute name="poids" type="std:Poids_type" use="optional"/>
            <xs:attribute name="ref" type="xs:string" use="optional"/>
            <xs:attribute name="cbk" type="xs:string" use="optional"/>
            <xs:attribute name="rang" type="std:Integer_type" use="optional"/>
            <xs:attribute name="otc" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="scelle-emp" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="num" type="xs:string" use="optional"/>
            <xs:attribute name="ori" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="liste-emp" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="sic" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="dgx-emp" type="dgx_emp_type" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="drpo-emp" type="drpo_emp_type" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="dgx_emp_type">
    <xs:annotation>
      <xs:documentation>0..n</xs:documentation>
    </xs:annotation>
    <xs:attribute name="classe" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Classe de la matière dangereuse.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="un" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Numéro ONU de la marchandise dangereuse.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="groupe-emb" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="etat-matiere" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="qtelimitee" type="std:Booleen_type" use="optional"/>
  </xs:complexType>
  <xs:complexType name="drpo_emp_type">
    <xs:annotation>
      <xs:documentation>Type droit de port empotage</xs:documentation>
    </xs:annotation>
    <xs:attribute name="montant" type="std:Integer_type" use="optional"/>
    <xs:attribute name="devise" type="xs:string" use="optional"/>
    <xs:attribute name="tiers" type="xs:string" use="optional"/>
    <xs:attribute name="per" type="xs:string" use="optional"/>
  </xs:complexType>
  <!-- Enveloppe du message Interchanges/MessageSet/Messages/Request -->
  <xs:complexType name="lde_user_type">
    <xs:attribute name="user" use="required">
      <xs:annotation>
        <xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiersProf" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="email" type="xs:string" use="optional"/>
    <xs:attribute name="adresse" type="xs:string" use="optional"/>
    <xs:attribute name="reseau" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="lde_request_type">
    <xs:sequence>
      <xs:element ref="empotage"/>
    </xs:sequence>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du message utilisé pour effectuer le suivi de l intégration.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document à intégrer (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Request" type="lde_request_type">
    <xs:annotation>
      <xs:documentation>Request précise la nature du document à intégrer.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Interchanges">
    <xs:annotation>
      <xs:documentation>Interchanges décrit le contexte de la transmission des données entre le SIC et le système partenaire.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MessageSet" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="from" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système émetteur</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="to" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système destinataire</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="servername" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="MessageSet">
    <xs:annotation>
      <xs:documentation>MessageSet identifie le message et permet d'assurer le suivi des échanges.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Destinataire"/>
        <xs:element ref="Emetteur"/>
        <xs:element name="Messages" type="lde_messages_type">
          <xs:annotation>
            <xs:documentation>Messages contient le document à integrer, à notifier, à imprimer ou à acquitter</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="icid" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange de rattachement du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="date" type="std:DateLongue_type" use="required">
        <xs:annotation>
          <xs:documentation>"31/12/2004 23:59:59" Date d'envoi du message.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Destinataire" type="lde_user_type">
    <xs:annotation>
      <xs:documentation>Identification du tiers destinataire du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Emetteur" type="lde_user_type">
    <xs:annotation>
      <xs:documentation>Identification de l'émetteur du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="lde_messages_type">
    <xs:choice maxOccurs="unbounded">
      <xs:element ref="Request"/>
    </xs:choice>
  </xs:complexType>
</xs:schema>
