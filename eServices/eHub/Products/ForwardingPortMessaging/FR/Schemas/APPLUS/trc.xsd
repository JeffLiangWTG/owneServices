<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/TRC"
           xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/TRC">

  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>

  <xs:element name="Interchanges">
    <xs:annotation>
      <xs:documentation>Interchanges décrit le contexte de la transmission des données entre le SIC et le système partenaire.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MessageSet" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="from" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système émetteur</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="to" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système destinataire</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="MessageSet">
    <xs:annotation>
      <xs:documentation>MessageSet identifie le message et permet d'assurer le suivi des échanges.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Destinataire"/>
        <xs:element ref="Emetteur"/>
        <xs:element name="Messages" type="trc_messages_type">
          <xs:annotation>
            <xs:documentation>Messages contient le document à integrer, à notifier, à imprimer ou à acquitter</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="icid" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange de rattachement du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="date" type="std:DateLongue_type" use="required">
        <xs:annotation>
          <xs:documentation>"31/12/2004 23:59:59" Date d'envoi du message.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="trc_user_type">
    <xs:attribute name="user" use="required">
      <xs:annotation>
        <xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiersProf" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Destinataire" type="trc_user_type">
    <xs:annotation>
      <xs:documentation>Identification du tiers destinataire du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Emetteur" type="trc_user_type">
    <xs:annotation>
      <xs:documentation>Identification de l'émetteur du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="trc_messages_type">
    <xs:choice maxOccurs="unbounded">
      <xs:element ref="Request"/>
      <xs:element ref="Notification"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="trc_request_type">
    <xs:choice>
      <xs:element ref="tracing"/>
    </xs:choice>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du message utilisé pour effectuer le suivi de l intégration.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document à intégrer (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ref" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Request" type="trc_request_type">
    <xs:annotation>
      <xs:documentation>Request précise la nature du document à intégrer.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="notification_type">
    <xs:choice>
      <!-- ** xs:element ref="liste-lpc"/ -->
      <!-- ** xs:element ref="lpe"/ -->
      <xs:element ref="statut"/>
    </xs:choice>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du document envoyé ou imprimé.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document notifié ou imprimé (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|PRINT|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" type="xs:string" use="optional"/>
    <xs:attribute name="ref" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="source">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MessageSet" minOccurs="0"/>
        <xs:element name="donnees-brutes" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="error_type">
    <xs:sequence>
      <xs:element name="libelle" type="xs:string">
        <xs:annotation>
          <xs:documentation>Description littérale de l'erreur renvoyée parle système.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element ref="source" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="code">
      <xs:annotation>
        <xs:documentation>Code erreur renvoyé par le SIC.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fatal" type="xs:string"/>
  </xs:complexType>
  <xs:element name="Notification" type="notification_type">
    <xs:annotation>
      <xs:documentation>Notification précise la nature du document à notifier ou imprimer</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="statut_type">
    <xs:sequence>
      <xs:element ref="reference" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="statut" type="statut_type">
    <xs:annotation>
      <xs:documentation>Statut caractérise l'attibution d'un statut à une entité par le SIC.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="tracing" type="tracing_type">
    <xs:annotation>
      <xs:documentation>Tracing</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="trc_response_element_type">
    <xs:sequence>
      <xs:element name="erreur" type="error_type" minOccurs="0"/>
      <xs:element name="information" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="libelle" type="xs:string" use="optional"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element ref="source" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="tiers" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du tiers concerné par l'entité.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sic" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'entité à laquelle le SIC attribue un statut.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date à laquelle le SIC a attribué le statut à une entité.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:annotation>
        <xs:documentation>Nature du statut attribué par le SIC à une entité.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ref" use="optional">
      <xs:annotation>
        <xs:documentation>Référence du tiers pour laquelle un statut est attribué par le SIC.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiers-lib" type="xs:string" use="optional"/>
    <xs:attribute name="src" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="tracing_type">
    <xs:annotation>
      <xs:documentation>Type tracing</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="reference-tracing">
        <xs:annotation>
          <xs:documentation>Description du tracing</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="reference_tracing_type"/>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="evenement-tracing" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Elts declencheurs du tracing</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="evenement_tracing_type"/>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="commentaire-tracing" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="210"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="reference" type="trc_response_element_type">
    <xs:annotation>
      <xs:documentation>Référence identifie les references SIC ou partenaire du document acquitte positivement ou negativement.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="evenement_tracing_type">
    <xs:attribute name="code" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="import" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:length value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="export" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:length value="1"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="reference_tracing_type">
    <xs:annotation>
      <xs:documentation>Type Description du tracing</xs:documentation>
    </xs:annotation>
    <xs:attribute name="sic" use="optional">
      <xs:annotation>
        <xs:documentation>Code SIC du tracing</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="11"/>
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ref" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="35"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:length value="3"/>
          <xs:enumeration value="INV"/>
          <xs:enumeration value="INA"/>
          <xs:enumeration value="ACT"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="horodebut" type="std:DateComplete_type" use="optional"/>
    <xs:attribute name="horofin" type="std:DateComplete_type" use="optional"/>
    <xs:attribute name="atp" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:length value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="refum" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="blref" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="blsic" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="16"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cbkref" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cbksic" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cbkafret" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cbkotc" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cbkrang" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="amq" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="declsic" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="declnum" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="decltype" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="declbddpays" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:length value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="declbddcode" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dosssic" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dossresp" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dossref" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="email" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="256"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone-sic" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rgr" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="35"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
</xs:schema>
