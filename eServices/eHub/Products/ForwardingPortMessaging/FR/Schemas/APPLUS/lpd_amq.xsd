<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS">
  <xs:include schemaLocation="patterns.xsd"/>
  <xs:include schemaLocation="parties.xsd"/>

  <xs:complexType name="reference_lpd_amq_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="commentaires" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Commentaires littéraux relatifs à l'avis de mise
            à quai.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="commentaires-dgx" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Commentaires littéraux relatifs à la
            modification des dangereux de l'avis de mise à
            quai.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="depotage-amq" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Information liste de dépotage pour les marchandises dépotées</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="reference-lpd-amq" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="sic" type="xs:string" use="optional"/>
                <xs:attribute name="ref-prop" type="xs:string" use="optional"/>
                <xs:attribute name="ref-gest" type="xs:string" use="optional"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute name="enPlus" type="xs:string" use="optional">
            <xs:annotation>
              <xs:documentation>Notifcation LDD - Indicateur qui détermine si la marchandise n'est pas annoncée dans une LPD (en plus)</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
      <xs:element name="shipper-amq" type="party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: Expediteur</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="consignee-amq" type="party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: Destinataire</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agent-amq" type="party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: Agent</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="notifyOne-amq" type="party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: A notifier 1</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="notifyTwo-amq" type="party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: A notifier 2</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="notifyThree-amq" type="party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: A notifier 3</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="tax-amq" type="tax_lpd_amq_type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Taxes (aka taux de fret) dans LPD</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="sic" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC de l'avis de mise à quai.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extliste" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cbk" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC de la confirmation de booking de
          rattachement de l'avis de mise à quai.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rang" use="optional">
      <xs:annotation>
        <xs:documentation>
          Numéro de rang associé à la référence de
          confirmation de booking de l'agent fret à laquelle
          l'AMQ est rattaché.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="extcbk" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence externe de la confirmation de booking à
          laquelle est rattachée l'avis de mise à quai.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="extamq" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence externe de l'avis de mise à quai.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="extamqlpd" type="xs:string" use="optional"/>
    <xs:attribute name="last" type="Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Indicateur dernier AMQ d'un dossier (Uniquement
          Export).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="reco" use="optional">
      <xs:annotation>
        <xs:documentation>
          Indicateur de reconnaissance de l'avis de mise à
          quai.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="IMP|EXP|NDE"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="required">
      <xs:annotation>
        <xs:documentation>
          Statut de l'avis de mise à quai (PRO= Provisoire,
          VAL=Validé, INV=Invalidé).
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dos" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC du dossier auquel est rattaché
          l'avis de mise à quai.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extdos" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence externe du dossier auquel est rattaché le
          dossier.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extdoslpd" type="xs:string" use="optional"/>
    <xs:attribute name="hist" use="optional">
      <xs:annotation>
        <xs:documentation>
          Indicateur de la version de l'avis de mise à quai.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="baet" use="optional">
      <xs:annotation>
        <xs:documentation>
          Indicateur d'autorisation d'embarquement de l'avis
          de mise à quai par le transitaire (EXP= Explicite,
          IMP=Implicite).
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="EXP|IMP|NDE"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="date" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Date d'attibution du statut à l'avis de mise à quai
          par le SIC.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dgx" type="xs:string" use="optional"/>
    <xs:attribute name="doc" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC du document principal.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extdoc" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence du document principal de l'agent fret.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bad" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC du bon à délivrer.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extbad" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence externe du BAD attribué par l'agent fret.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="random" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence aléatoire au BAD fournie par le SIC.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="alotissement" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="numentree" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="datentree" type="DateLongue_type" use="optional"/>
    <xs:attribute name="statutdouane" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="20"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="datebaed" type="DateLongue_type" use="optional"/>
    <xs:attribute name="datearr" type="DateLongue_type" use="optional"/>
    <xs:attribute name="numreception" type="xs:string" use="optional"/>
    <xs:attribute name="inddel" type="xs:string" use="optional"/>
    <xs:attribute name="qte-bae" type="xs:integer" use="optional"/>
    <xs:attribute name="poids-bae" type="Poids_type" use="optional"/>
    <xs:attribute name="bact" type="IdSic_type" use="optional"/>
    <xs:attribute name="random-bact" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="prevlpd" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="11"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="transit" type="Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          indique si le BL a l indicateur "transit" coché
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sec" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="voyage_lpd_amq_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="otc" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de lOffre de Transport Commerciale  auquel est rattaché l'avis de mise à quai.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="atp" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'Annonce de Transport Physique auquel est rattaché l'avis de mise à quai.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ser" type="IdSic_type" use="optional"/>
    <xs:attribute name="nav" use="optional">
      <xs:annotation>
        <xs:documentation>Nom du navire de l'ATP.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="refotc" use="optional">
      <xs:annotation>
        <xs:documentation>Référence externe de l'OTC.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="refser" use="optional">
      <xs:annotation>
        <xs:documentation>Référence externe du service.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="armement" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="armement-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sens" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="aerien" type="Booleen_type" use="optional"/>
    <xs:attribute name="terrestre" type="Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>indicateur terrestre - type du voyage</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="reference-armement" type="xs:string" use="optional"/>
    <xs:attribute name="ref-annonce" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="lieux_lpd_amq_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="ori" use="optional">
      <xs:annotation>
        <xs:documentation>Code SIC du port d'origine de l'avis de mise à quai (AMQ import uniquement).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ori-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Code SIC du port d'origine de l'avis de mise à quai (AMQ import uniquement).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dpc" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du dernier port de chargement de l'avis de mise à quai (Uniquement avis de mise à quai import).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dpc-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du dernier port de chargement de l'avis de mise à quai (Uniquement avis de mise à quai import).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lori" use="optional">
      <xs:annotation>
        <xs:documentation>Lieu d'origine de l'avis de mise à quai (Avis de mise à quai import uniquement).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lori-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Lieu d'origine de l'avis de mise à quai (Avis de mise à quai import uniquement).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fin" use="optional">
      <xs:annotation>
        <xs:documentation>Codification du lieu de destination finale de l'avis de mise à quai (Uniquement avis de mise à quai Export).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fin-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification du lieu de destination finale de l'avis de mise à quai (Uniquement avis de mise à quai Export).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="eta" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date estimée d'arrivée du navire.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="etd" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date de départ estimé du navire.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tbt" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du premier port de déchargement de l'avis de mise à quai (Export uniquement).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tbt-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du premier port de déchargement de l'avis de mise à quai (Export uniquement).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dest" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du port de destination de l'avis de mise à quai (Uniquement Export).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dest-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du port de destination de l'avis de mise à quai (Uniquement Export).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="date" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date de passage de l'OTC à laquelle l'avis de mise à quai est rattachée.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paq-lieu" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="paq-zone" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="lieu_lpd_amq_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="zone" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC de la zone du lieu de RL de l'avis de mise à quai.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC de la zone du lieu de RL de l'avis de mise à quai.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de RL de l'avis de mise à quai.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de RL de l'avis de mise à quai.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du manutentionnaire responsable du lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
