<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema elementFormDefault="qualified" attributeFormDefault="unqualified"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/DOA"
	xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS" targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/DOA">

	<xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>

	<xs:complexType name="reference-doc-type">
		<xs:attribute name="rca" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="13"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="eqd" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="17"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="num" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="22"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="ref" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="22"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="type" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="6"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="numt" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="8"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="indsta" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="last" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="circuit" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="4"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="dateval" type="std:DateComplete_type" use="optional"/>
		<xs:attribute name="statut" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="3"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="date" type="std:DateComplete_type" use="optional"/>
		<xs:attribute name="siret-exp" type="xs:string" use="optional"/>
		<xs:attribute name="decl-asso" type="xs:string" use="optional"/>
		<xs:attribute name="scelles-douane" type="xs:string" use="optional"/>
		<xs:attribute name="code-restit" type="xs:string" use="optional"/>
		<xs:attribute name="type-lib" type="xs:string" use="optional"/>
		<xs:attribute name="anticip" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="ref-voya" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Référence voyage - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="percep-port" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">Port de perception - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="num-doss" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">Numéro de dossier - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="cle-eqt" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">Cle Equipement - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="sic" type="xs:string" use="optional"/>
		<xs:attribute name="statut-douane" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="tiers-doc-type">
		<xs:attribute name="sic" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="9"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="nom" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="75"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="hors" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="9"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="code" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="7"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="hors-lib" type="xs:string" use="optional"/>
		<xs:attribute name="sic-lib" type="xs:string" use="optional"/>
		<xs:attribute name="code-lib" type="xs:string" use="optional"/>
		<xs:attribute name="adr" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">Adresse - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ville" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation>Ville - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="cp" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">CP - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="afret" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="lieux-doc-type">
		<xs:attribute name="zone" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="4"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="lieu" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="9"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="md" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="6"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="bdd" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="8"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="bds" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="8"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="bpc" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="8"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="bdd-lib" type="xs:string" use="optional"/>
		<xs:attribute name="bpc-lib" type="xs:string" use="optional"/>
		<xs:attribute name="bds-lib" type="xs:string" use="optional"/>
		<xs:attribute name="zone-lib" type="xs:string" use="optional"/>
		<xs:attribute name="lieu-lib" type="xs:string" use="optional"/>
		<xs:attribute name="bde" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="8"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="dateEmission" type="std:DateComplete_type" use="optional"/>
		<xs:attribute name="bde-lib" type="xs:string" use="optional"/>
		<xs:attribute name="port-dech" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">Port de déchargement - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dest-final" type="xs:string" use="optional">
			<xs:annotation>
				<xs:documentation xml:lang="fr">Destination final - IDM</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dest-final-lib" type="xs:string" use="optional"/>
		<xs:attribute name="port-dech-lib" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="droits-doc-type">
		<xs:attribute name="montant" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="999999999"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="unite" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="3"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="port" type="xs:string" use="optional"/>
		<xs:attribute name="port-lib" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="lmarchandise-doc-type">
		<xs:attribute name="nb" type="xs:integer" use="required"/>
		<xs:attribute name="poids" type="xs:integer" use="optional"/>
		<xs:attribute name="poidsnet" type="xs:integer" use="optional"/>
		<xs:attribute name="vol" type="xs:integer" use="optional"/>
		<xs:attribute name="nature" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="17"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="acc" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="afd" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="sensible" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="scelle" type="std:Booleen_type" use="optional"/>
		<xs:attribute name="dst" type="std:Booleen_type" use="optional"/>
	</xs:complexType>
	<xs:complexType name="description-doc-type">
		<xs:sequence>
			<xs:element name="description">
				<xs:simpleType>
					<xs:restriction base="xs:string"/>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="ndp" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="13"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="code-restit" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="da_type">
		<xs:sequence>
			<xs:element name="reference-doc" type="reference-doc-type"/>
			<xs:element name="voyage-doc" type="voyage-doc-type" minOccurs="0"/>
			<xs:element name="tiers-doc" type="tiers-doc-type"/>
			<xs:element name="lieux-doc" type="lieux-doc-type"/>
			<xs:element name="lmarchandise-doc" type="lmarchandise-doc-type"/>
			<xs:element name="droits-doc" type="droits-doc-type" minOccurs="0"/>
			<xs:element name="description-doc" type="description-doc-type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>0 a n pour permettre integration des regul sans description/ nomenclature</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="controle-doc" type="controle-doc-type" minOccurs="0"/>
			<xs:element name="equipement-doc" type="equipement-lo42-type" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="controle-doc-type">
		<xs:restriction base="xs:string"/>
	</xs:simpleType>
	<xs:complexType name="equipement-lo42-type">
		<xs:attribute name="sic" type="xs:string" use="optional"/>
		<xs:attribute name="id" type="xs:string" use="optional"/>
		<xs:attribute name="lieu" type="xs:string" use="optional"/>
		<xs:attribute name="zone" type="xs:string" use="optional"/>
		<xs:attribute name="rec" type="std:DateLongue_type" use="optional"/>
		<xs:attribute name="bpc" type="xs:string" use="optional"/>
		<xs:attribute name="lieu-lib" type="xs:string" use="optional"/>
		<xs:attribute name="zone-lib" type="xs:string" use="optional"/>
		<xs:attribute name="bpc-lib" type="xs:string" use="optional"/>
		<xs:attribute name="vab" type="std:DateLongue_type" use="optional"/>
	</xs:complexType>
	<xs:complexType name="voyage-doc-type">
		<xs:attribute name="atp" type="xs:string" use="optional"/>
		<xs:attribute name="etd" type="std:DateComplete_type" use="optional"/>
		<xs:attribute name="nav" type="xs:string" use="optional"/>
		<xs:attribute name="otc" type="xs:string" use="optional"/>
		<xs:attribute name="fin" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="user-type">
		<xs:attribute name="user" use="required">
			<xs:annotation>
				<xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="1"/>
					<xs:maxLength value="9"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="tiersProf" use="required">
			<xs:annotation>
				<xs:documentation>Identifiant tiers profession du message.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="1"/>
					<xs:maxLength value="9"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="email" type="xs:string" use="optional"/>
		<xs:attribute name="adresse" type="xs:string" use="optional"/>
		<xs:attribute name="reseau" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="request-type">
		<xs:choice>
			<xs:element name="document-accompagnement" type="da_type">
				<xs:annotation>
					<xs:documentation>Comment describing your root element</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
		<xs:attribute name="action" use="optional">
			<xs:annotation>
				<xs:documentation>Code fonction du document (Codification SIC).</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|UKN"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="id" use="required">
			<xs:annotation>
				<xs:documentation>Identifiant fonctionnel du message utilisé pour effectuer le suivi de l intégration.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="1"/>
					<xs:maxLength value="75"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="type" use="required">
			<xs:annotation>
				<xs:documentation>Type du document à intégrer (Codification SIC).</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="0"/>
					<xs:maxLength value="7"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="statut" use="optional">
			<xs:simpleType>
				<xs:restriction base="xs:string"/>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="Request" type="request-type">
		<xs:annotation>
			<xs:documentation>Request précise la nature du document à intégrer.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Interchanges">
		<xs:annotation>
			<xs:documentation>Interchanges décrit le contexte de la transmission des données entre le SIC et le système partenaire.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="MessageSet" maxOccurs="unbounded"/>
			</xs:sequence>
			<xs:attribute name="id" use="required">
				<xs:annotation>
					<xs:documentation>Identifiant interchange</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="14"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="from" use="required">
				<xs:annotation>
					<xs:documentation>Nom du système émetteur</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="75"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="to" use="required">
				<xs:annotation>
					<xs:documentation>Nom du système destinataire</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="75"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="servername" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="MessageSet">
		<xs:annotation>
			<xs:documentation>MessageSet identifie le message et permet d'assurer le suivi des échanges.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Destinataire"/>
				<xs:element ref="Emetteur"/>
				<xs:element name="Messages" type="messages-type">
					<xs:annotation>
						<xs:documentation>Messages contient le document à integrer, à notifier, à imprimer ou à acquitter</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="id" use="required">
				<xs:annotation>
					<xs:documentation>Identifiant du message</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="14"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="icid" use="required">
				<xs:annotation>
					<xs:documentation>Identifiant interchange de rattachement du message</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="14"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
			<xs:attribute name="date" type="std:DateLongue_type" use="required">
				<xs:annotation>
					<xs:documentation>"31/12/2004 23:59:59" Date d'envoi du message.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Destinataire" type="user-type">
		<xs:annotation>
			<xs:documentation>Identification du tiers destinataire du message</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Emetteur" type="user-type">
		<xs:annotation>
			<xs:documentation>Identification de l'émetteur du message</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="messages-type">
		<xs:choice maxOccurs="unbounded">
			<xs:element ref="Request"/>
		</xs:choice>
	</xs:complexType>
</xs:schema>
