        <xs:documentation>
          Référence externe de l'agent fret de l'avis de mise
          à quai objet du constat (confirmation de booking à
          l'export et référence du BL à l'import).
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="inter" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence de l'interchange du constat indiquée par
          le manutentionnaire.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ind" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Indicateur constat particulier (Exemple: enlèvement
          temporaire).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Date d'attribution du statut au constat par le SIC.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="res" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Indicateur réserves (Y=Oui N=Non).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:annotation>
        <xs:documentation>
          Statut attribué par le SIC au constat.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut-lib" use="optional">
      <xs:annotation>
        <xs:documentation>
          Statut attribué par le SIC au constat.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lastdate" type="std:DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Date de dernière modification du constat.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="agsic" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC de l'agent fret rattaché à l'avis de
          mise à quai objet du constat (Confirmation de
          booking à l'export ou Document principal à
          l'import).
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extamq" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence externe de l'AMQ fournie par son créateur.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dos" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC du dossier rattaché à l'avis de mise
          à quai objet du constat.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extdos" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence externe du dossier rattaché à l'avis de
          mise à quai objet du constat.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cri" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>
          Identifiant SIC de la réservation interieur rattachée à l'avis de mouvement interieur du constat.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="extcri" use="optional">
      <xs:annotation>
        <xs:documentation>
          Référence de la réservation interieur rattachée à l'avis de mouvement interieur du constat.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="35"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rang" use="optional">
      <xs:annotation>
        <xs:documentation>
          Valeur du rang du booking rattaché à l'avis de mise
          à quai objet du constat.
        </xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:minInclusive value="1"/>
          <xs:totalDigits value="3"/>
          <xs:maxInclusive value="999"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sens" type="xs:string" use="optional"/>
    <xs:attribute name="gen" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="numentree" type="xs:integer" use="optional"/>
    <xs:attribute name="type-doc" type="xs:string" use="optional"/>
    <xs:attribute name="en-plus" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="non-depote" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="premier-vaq" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="sec" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="scelles" type="std:Booleen_type"/>
    <xs:attribute name="client">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="30"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fournisseur">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="30"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="cdm_user_type">
    <xs:attribute name="user" use="required">
      <xs:annotation>
        <xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiersProf" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="email" type="xs:string" use="optional"/>
    <xs:attribute name="adresse" type="xs:string" use="optional"/>
    <xs:attribute name="reseau" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="cdm_request_type">
    <xs:choice>
      <xs:element name="constat-depotage-masse">
        <xs:annotation>
          <xs:documentation>Constat de dépotage en masse</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="constat-depotage" type="constat_message_type" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Constat de dépotage</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="constat-fin-depotage" type="constat_message_type" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Fin de depotage</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:choice>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du message utilisé pour effectuer le suivi de l intégration.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document à intégrer (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Request" type="cdm_request_type">
    <xs:annotation>
      <xs:documentation>Request précise la nature du document à intégrer.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Interchanges">
    <xs:annotation>
      <xs:documentation>Interchanges décrit le contexte de la transmission des données entre le SIC et le système partenaire.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MessageSet" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="from" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système émetteur</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="to" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système destinataire</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="servername" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="MessageSet">
    <xs:annotation>
      <xs:documentation>MessageSet identifie le message et permet d'assurer le suivi des échanges.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Destinataire"/>
        <xs:element ref="Emetteur"/>
        <xs:element name="Messages" type="cdm_messages_type">
          <xs:annotation>
            <xs:documentation>Messages contient le document à integrer, à notifier, à imprimer ou à acquitter</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="icid" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange de rattachement du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="date" type="std:DateLongue_type" use="required">
        <xs:annotation>
          <xs:documentation>"31/12/2004 23:59:59" Date d'envoi du message.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Destinataire" type="cdm_user_type">
    <xs:annotation>
      <xs:documentation>Identification du tiers destinataire du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Emetteur" type="cdm_user_type">
    <xs:annotation>
      <xs:documentation>Identification de l'émetteur du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="cdm_messages_type">
    <xs:choice maxOccurs="unbounded">
      <xs:element ref="Request"/>
    </xs:choice>
  </xs:complexType>
</xs:schema>
