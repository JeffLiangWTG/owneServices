<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/CDM"
           xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/CDM">

  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>
  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="parties.xsd"/>

  <xs:complexType name="lieu_constat_type">
    <xs:annotation>
      <xs:documentation>Lieu Constat 1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="zone" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC de la zone portuaire dont dépend le lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC de la zone portuaire dont dépend le lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="loc" use="optional">
      <xs:annotation>
        <xs:documentation>Localisation de la marchandise dans le lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <!-- VPL: Change from 1 to 0 -->
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mag" use="optional">
      <xs:annotation>
        <xs:documentation>code doane du lieu RL (champ magasinDouane)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="13"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="tiers_constat_type">
    <xs:annotation>
      <xs:documentation>Tiers 1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="manut" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionnaire du lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionnaire du lieu de RL.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut-tin" use="optional">
      <xs:annotation>
        <xs:documentation>Code tin du manut</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="agfret" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'agent fret.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="agfret-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'agent fret.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="agfret-tin" use="optional">
      <xs:annotation>
        <xs:documentation>code tin de l'agent fret</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="amq" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du responsable de l'AMQ.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="amq-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du responsable de l'AMQ.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="amq-tin" use="optional">
      <xs:annotation>
        <xs:documentation>code tin du responsable de l'amq</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rtsm" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du représentant du transporteur sortie maritime.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rtsm-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du représentant du transporteur sortie maritime.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rtsm-tin" use="optional">
      <xs:annotation>
        <xs:documentation>code tin du representant transporteur en Sortie Maritime</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rtem" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du représentant du transporteur entrée maritime.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rtem-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du représentant du transporteur entrée maritime.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="rtem-tin" use="optional">
      <xs:annotation>
        <xs:documentation>code tin du représentant transporteur Entree Mer</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="equipement_constat_type">
    <xs:annotation>
      <xs:documentation>Equipement 0..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="sic" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>A supprimer.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant de l'équipement constaté.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="code" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC de l'équipement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="code-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC de l'équipement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="nb" use="optional">
      <xs:annotation>
        <xs:documentation>Nombre d'unités de condiionnement de l'équipement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tare" type="std:Poids_type" use="optional">
      <!--<xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="9"/>
        </xs:restriction>
      </xs:simpleType>-->
    </xs:attribute>
    <xs:attribute name="poids" type="std:Poids_type" use="optional">
      <xs:annotation>
        <xs:documentation>Poids brut de l'équipement.</xs:documentation>
      </xs:annotation>
      <!--<xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="9"/>
        </xs:restriction>
      </xs:simpleType>-->
    </xs:attribute>
    <xs:attribute name="vide" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur Vide de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frigo" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur frigo de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dim" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur sur-dimension de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dgx" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur dangereux de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="polluant" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur polluant de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="oh" use="optional">
      <xs:annotation>
        <xs:documentation>Valeur de dépassement en hauteur de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="owl" use="optional">
      <xs:annotation>
        <xs:documentation>Valeur de dépassement largeur gauche de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="owr" use="optional">
      <xs:annotation>
        <xs:documentation>Valeur de dépassement largeur droite de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="olf" use="optional">
      <xs:annotation>
        <xs:documentation>Valeur dépassement longueur avant de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="olb" use="optional">
      <xs:annotation>
        <xs:documentation>Valeur dépassement longueur arrière de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="long" use="optional">
      <xs:annotation>
        <xs:documentation>Longueur de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="larg" use="optional">
      <xs:annotation>
        <xs:documentation>Largeur de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="haut" use="optional">
      <xs:annotation>
        <xs:documentation>Hauteur de l'équipement exprimée en centimètre.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="valid-scelle" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="valid-scelle-commentaires" type="xs:string" use="optional"/>
    <xs:attribute name="date-pvaq" type="std:DateComplete_type" use="optional"/>
  </xs:complexType>
  <xs:complexType name="marchandise_constat_type">
    <xs:annotation>
      <xs:documentation>Marchandise 0..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="sic" type="std:IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>A supprimer.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Référence de la marchandise constaté.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="scelle_constat_type">
    <xs:annotation>
      <xs:documentation>Scelle 0..*</xs:documentation>
    </xs:annotation>
    <xs:attribute name="num" use="required">
      <xs:annotation>
        <xs:documentation>Numéro de scellé de l'équipement.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="35"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ori" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ori-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="ligne-marchandise_constat_type">
    <xs:annotation>
      <xs:documentation>Ligne de marchandise 0..1</xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0">
      <xs:element name="designation-cst" type="xs:string" minOccurs="0"/>
      <xs:element name="dgx-cst" type="dgx_constat_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="mode-controle-cst" type="mode_controle_cst_type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="sic" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la ligne marchandise</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ref" use="optional">
      <xs:annotation>
        <xs:documentation>Référence externe de la ligne marchandise fournie par le créateur de la marchandise</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <!--VPL: Change from 1 to 0-->
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="eqd" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Numero equipement</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="eqdsic" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>ID AP+  Equipement</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="march" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>Référence marchandise</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="marchsic" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>ID AP+ Marchandise</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="agfret" type="xs:string" use="optional">
      <xs:annotation>
        <xs:documentation>A supprimer?</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="nb" use="required">
      <xs:annotation>
        <xs:documentation>Nombre d'unités de condiionnement de la ligne marchandise.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="code" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC de l'unité de conditionnement de la ligne marchandise.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="code-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC de l'unité de conditionnement de la ligne marchandise.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="poids" type="std:Poids_type" use="optional">
      <xs:annotation>
        <xs:documentation>Poids brut de la marchandise de la ligne marchandise exprimé en kilogrammes.</xs:documentation>
      </xs:annotation>
      <!--<xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="9"/>
        </xs:restriction>
      </xs:simpleType>-->
    </xs:attribute>
    <xs:attribute name="vol" type="std:Integer_type" use="optional">
      <!--VPL : change from xs:Integer to std:Integer_type-->
      <xs:annotation>
        <xs:documentation>Volume annoncé de la ligne marchandise exprimé en décimètre cube.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mesure" type="xs:integer" use="optional"/>
    <xs:attribute name="volmes" type="Volume_type" use="optional">
      <xs:annotation>
        <xs:documentation>Volume de la ligne marchandise mesuré exprimé en décimètre cube.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="frigo" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur frigo de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dgx" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur dangereux de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="polluant" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Indicateur polluant de l'équipement.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="std:Temperature_type" use="optional"/>
    <xs:attribute name="max" type="std:Temperature_type" use="optional"/>
    <xs:attribute name="unite" type="xs:string" use="optional"/>
    <xs:attribute name="poids-net" type="std:Poids_type" use="optional"/>
    <xs:attribute name="date-pvaq" type="std:DateComplete_type" use="optional"/>
    <xs:attribute name="ind-conforme" type="std:Booleen_type" use="optional">
      <xs:annotation>
        <xs:documentation>Aérien: indicateur conforme</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hawb-ref" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="mesurage_constat_type">
    <xs:annotation>
      <xs:documentation>Mesurage 0..*</xs:documentation>
    </xs:annotation>
    <xs:attribute name="nb" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:integer">
          <xs:totalDigits value="6"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="code" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC de l'unité de manutention de la ligne marchandise.</xs:documentation>
      </xs:annotation>
