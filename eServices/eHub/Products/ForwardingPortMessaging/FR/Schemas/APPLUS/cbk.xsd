<?xml version="1.0" encoding="iso-8859-1"?>

<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS">

  <xs:include schemaLocation="patterns.xsd"/>

  <xs:complexType name="user_type">
    <xs:attribute name="user" use="required">
      <xs:annotation>
        <xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiersProf" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="email" type="xs:string" use="optional"/>
    <xs:attribute name="adresse" type="xs:string" use="optional"/>
    <xs:attribute name="reseau" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="notification_type">
    <xs:choice>
      <xs:element name="confirmation-booking">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="references-cbk" type="reference_cbk_type">
              <xs:annotation>
                <xs:documentation>Ensemble des references de rattachement de la confirmation de booking.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="voyage-cbk">
              <xs:annotation>
                <xs:documentation>Voyage sur lequel est affectee la confirmation de booking.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:complexContent>
                  <xs:extension base="voyage_cbk_type">
                    <xs:sequence>
                      <xs:element name="lieux-cbk" type="lieux_cbk_type">
                        <xs:annotation>
                          <xs:documentation>Lieux de destination de la marchandise de la confirmation de booking.</xs:documentation>
                        </xs:annotation>
                      </xs:element>
                    </xs:sequence>
                  </xs:extension>
                </xs:complexContent>
              </xs:complexType>
            </xs:element>
            <xs:element name="tiers-cbk" type="tiers_cbk_type">
              <xs:annotation>
                <xs:documentation>Ensemble des tiers concernes par la confirmation de booking.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="lieu-reception-cbk" type="lieu_reception_cbk_type" minOccurs="0">
              <xs:annotation>
                <xs:documentation>Lieu de réception de la confirmation de booking.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="reference-annexe" type="xs:string" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Reference(s) annexe(s) a laquelle la confirmation de booking est rattachee.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="equipement-cbk" type="equipement_cbk_type" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Equipement(s) contenu(s) dans la confirmation de booking.</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="lmarchandise-cbk" type="lmarchandise_cbk_type" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Ligne(s) marchandise(s) contenue(s) dans la confirmation de booking.</xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- ** xs:element ref="liste-lpc"/ -->
      <!-- ** xs:element ref="lpe"/ -->
    </xs:choice>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du document envoyé ou imprimé.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document notifié ou imprimé (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|PRINT|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" type="xs:string" use="optional"/>
    <xs:attribute name="ref" type="xs:string" use="optional"/>
    <xs:attribute name="aerien" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="reference_cbk_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="commentaires" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Commentaires generaux relatifs a la confirmation de booking.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="210"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="sic" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identification SIC de la confirmation de booking (Obligatoire en notification)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ext" use="required">
      <xs:annotation>
        <xs:documentation>Reference booking de l'agent fret</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cot" use="optional">
      <xs:annotation>
        <xs:documentation>Reference de cotation de l'agent fret associee a la reference booking</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dem" use="optional">
      <xs:annotation>
        <xs:documentation>Reference du dossier du demandeur du booking</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trans" use="optional">
      <xs:annotation>
        <xs:documentation>Reference du dossier du transitaire portuaire</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="required">
      <xs:annotation>
        <xs:documentation>
          Statut du document. Les valeurs sont codifiees dans le SIC.
        </xs:documentation>
        <xs:documentation>PRO = Provisoire</xs:documentation>
        <xs:documentation>VAF = Valide Agent Fret</xs:documentation>
        <xs:documentation>VTP = Valide Transitaire Portuaire</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="3"/>
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trsic" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du dossier du transitaire portuaire</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="demsic" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du dossier du demandeur du booking.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>Date d'attribution du statut de la confirmation de booking dans le SIC (31/12/2004 10:00).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="carriermerchant" type="xs:string" use="optional"/>
    <xs:attribute name="MAD" type="Booleen_type"/>
    <xs:attribute name="paiement" type="xs:string"/>
    <xs:attribute name="version" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="voyage_cbk_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="refotc" use="optional">
      <xs:annotation>
        <xs:documentation>Reference OTC de l'agent fret</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="refser" use="optional">
      <xs:annotation>
        <xs:documentation>Reference service de l'agent fret</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="armement" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'arment du service ou de l'OTC</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="armement-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'arment du service ou de l'OTC</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="atp" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'ATP</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="refarm" type="xs:string" use="optional"/>
    <xs:attribute name="otc" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'OTC</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="ser" type="IdSic_type" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du service (Codification SIC).</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="eta" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>"30/12/2004" Date estimee de l'arrivee du navire. Renseignee en notification et impression si l'OTC du booking est rattachee a un booking.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="etd" type="DateLongue_type" use="optional">
      <xs:annotation>
        <xs:documentation>"31/12/2004" Date estimee de depart du navire. Renseignee si l'OTC de la confirmation de booking est rattachee a une OTC.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="nav" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dateDepart" type="DateLongue_type" use="optional"/>
    <xs:attribute name="dateDestination" type="DateLongue_type" use="optional"/>
  </xs:complexType>
  <xs:complexType name="lieux_cbk_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="fin" use="required">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de destination finale.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fin-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de destination finale.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tbt" use="optional">
      <xs:annotation>
        <xs:documentation>Codification du premier port de dechargement</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tbt-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de destination finale.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dest" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du port de destination.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="5"/>
          <xs:maxLength value="5"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dest-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Codification SIC du lieu de destination finale.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="tiers_cbk_type">
    <xs:annotation>
      <xs:documentation>1..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="creat" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du createur de la confirmation de booking. (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="creat-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du createur de la confirmation de booking. (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dem" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du demandeur du booking (Codification SIC)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="dem-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du demandeur du booking (Codification SIC)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trans" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du transitaire portuaire (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trans-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du transitaire portuaire (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="exp" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'expediteur (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="exp-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de l'expediteur (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionaire responsable de la zone de RL où doit être receptionnee la marchandise de la confirmation de booking (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionaire responsable de la zone de RL où doit être receptionnee la marchandise de la confirmation de booking (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du lieu de RL où la marchandise doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du lieu de RL où la marchandise doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la zone portuaire où la marchandise de la confirmation de booking doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la zone portuaire où la marchandise de la confirmation de booking doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="nomdem" use="optional">
      <xs:annotation>
        <xs:documentation>Nom du demandeur du booking. A renseigner obligatoirement si l'attribut "creat " n'est pas renseigne.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ctatrans" use="optional">
      <xs:annotation>
        <xs:documentation>Contact chez le transitaire portuaire.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="ctadem" use="optional">
      <xs:annotation>
        <xs:documentation>Contact du demandeur du booking.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="17"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="afret" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="afret-lib" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="lieu_reception_cbk_type">
    <xs:annotation>
      <xs:documentation>0..1</xs:documentation>
    </xs:annotation>
    <xs:attribute name="manut" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionaire responsable de la zone de RL où doit être receptionnee la marchandise de la confirmation de booking (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="manut-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du manutentionaire responsable de la zone de RL où doit être receptionnee la marchandise de la confirmation de booking (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du lieu de RL où la marchandise doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="8"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lieu-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC du lieu de RL où la marchandise doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la zone portuaire où la marchandise de la confirmation de booking doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="4"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="zone-lib" use="optional">
      <xs:annotation>
        <xs:documentation>Identifiant SIC de la zone portuaire où la marchandise de la confirmation de booking doit être receptionnee (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
