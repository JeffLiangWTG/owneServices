<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS">

  <xs:simpleType name="DateComplete_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)[0-9][0-9] ([2][0-3]|[0][0-9]|[1][0-9])[:]([0-5][0-9])"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DateLongue_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)[0-9][0-9] ([2][0-3]|[0][0-9]|[1][0-9])[:]([0-5][0-9])([:]([0-5][0-9]))?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DateCourte_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)[0-9][0-9]"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Heure_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="([2][0-3]|[0][0-9]|[1][0-9])[:]([0-5][0-9])[:]([0-5][0-9])"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Booleen_type">
    <xs:restriction base="xs:string">
      <!--VPL: added "|" to avoid error when value is blank-->
      <xs:pattern value="Y|N|"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="IdSic_type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="17"/>
      <!-- xs:pattern value="([A-Z0-9]{3})[0-9]{8}"/-->
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Temperature_type">
    <xs:restriction base="xs:string">
      <!--VPL: added "|" to avoid error when value is blank-->
      <xs:pattern value="[-?|\+?]?[0-9]{1,3}|"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DateNsti_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)[0-9][0-9]( ([2][0-3]|[0][0-9]|[1][0-9])[:]([0-5][0-9]))?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Poids_type">
    <xs:annotation>
      <xs:documentation>Poids.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <!--VPL: added "|" to avoid error when value is blank-->
      <xs:pattern value="[0-9]{1,9}[,|\.][0-9]{0,3}|[,|\.][0-9]{1,3}|[0-9]{1,9}|"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PoidsCalcul_type">
    <xs:annotation>
      <xs:documentation>Poids Calcul. utilise pour la restitution des sommes et totaux</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,12}[,|\.][0-9]{0,3}|[,|\.][0-9]{1,3}|[0-9]{1,12}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DateCourteOuLongue_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)[0-9][0-9]( ([2][0-3]|[0][0-9]|[1][0-9])[:]([0-5][0-9])([:]([0-5][0-9]))?)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Integer_type">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?\d*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="signedInt">
    <xs:restriction base="xs:integer">
      <xs:pattern value="(\+|\-)[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
