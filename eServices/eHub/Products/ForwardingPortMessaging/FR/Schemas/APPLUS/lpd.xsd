<?xml version="1.0" encoding="utf-8"?>
<!-- edited with XMLSPY v2004 rel. 4 U (http://www.xmlspy.com) by Christian Allemand (Marseille Gyptis International) -->
<xs:schema elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.cargowise.com/Schemas/FPM/APPLUS/LPD"
           xmlns:std="http://www.cargowise.com/Schemas/FPM/APPLUS"
           targetNamespace="http://www.cargowise.com/Schemas/FPM/APPLUS/LPD">

  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="patterns.xsd"/>
  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="parties.xsd"/>
  <xs:import namespace="http://www.cargowise.com/Schemas/FPM/APPLUS" schemaLocation="lpd_amq.xsd"/>

  <xs:complexType name="lpd_notification_type">
    <xs:choice>
      <xs:element name="lpd">
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="std:liste_depotage_type">
              <xs:attribute name="id" use="optional">
                <xs:annotation>
                  <xs:documentation>Identifiant SIC de la LPD (ex: LPD12345678)</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="11"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:attribute>
              <xs:attribute name="ref" use="optional">
                <xs:annotation>
                  <xs:documentation>Référence de la LPD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="35"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:attribute>
              <xs:attribute name="indAerien" type="std:Booleen_type" use="optional"/>
              <xs:attribute name="refLTA" use="optional">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="17"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:attribute>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
    </xs:choice>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du document envoyé ou imprimé.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document notifié ou imprimé (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC)</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|PRINT|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" type="xs:string" use="optional"/>
    <xs:attribute name="ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="Notification" type="lpd_notification_type">
    <xs:annotation>
      <xs:documentation>Notification précise la nature du document à notifier ou imprimer</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="lieux_dep_type">
    <xs:attribute name="zone" type="xs:string" use="required"/>
    <xs:attribute name="lieu" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="voyage_dep_type">
    <xs:attribute name="atp" type="xs:string" use="required"/>
    <xs:attribute name="otc" type="xs:string" use="optional"/>
    <xs:attribute name="pch" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="equipement_dep_type">
    <xs:sequence>
      <xs:element name="marchandise-dep" type="marchandise_dep_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="scelle-dep" type="scelle_dep_type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="sic" type="xs:string" use="optional"/>
    <xs:attribute name="id" type="xs:string" use="optional"/>
    <xs:attribute name="code" type="xs:string" use="optional"/>
    <xs:attribute name="tare" type="std:Poids_type" use="optional"/>
    <xs:attribute name="poids" type="std:Poids_type" use="optional"/>
  </xs:complexType>
  <xs:complexType name="marchandise_dep_type">
    <xs:sequence>
      <xs:element name="description-dep">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="3500"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="marques-dep" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="350"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="commentaire-dep" type="xs:string" minOccurs="0"/>
      <xs:element name="dgx-dep" type="dgx_dep_type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="shipper-dep" type="std:party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: Expediteur</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="consignee-dep" type="std:party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: Destinataire</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="notifyOne-dep" type="std:party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: A notifier 1</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="notifyTwo-dep" type="std:party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: A notifier 2</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="notifyThree-dep" type="std:party_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Party: A notifier 3</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="tax-dep" type="tax_dep_type" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Taxe (= Taux de Fret dans les BL)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="rec" type="xs:string" use="optional"/>
    <xs:attribute name="ext-doc" type="xs:string" use="required"/>
    <xs:attribute name="type-doc" type="xs:string" use="optional"/>
    <xs:attribute name="ori" type="xs:string" use="optional"/>
    <xs:attribute name="last" type="xs:string" use="optional"/>
    <xs:attribute name="sic" type="xs:string" use="optional"/>
    <xs:attribute name="ref" type="xs:string" use="required"/>
    <xs:attribute name="nb" type="xs:integer" use="required"/>
    <xs:attribute name="code" type="xs:string" use="required"/>
    <xs:attribute name="poids" type="std:Poids_type" use="required"/>
    <xs:attribute name="vol" type="xs:integer" use="optional"/>
    <xs:attribute name="poids-net" type="std:Poids_type" use="optional"/>
    <xs:attribute name="polluant" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="dgx" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="frigo" type="std:Booleen_type" use="optional"/>
    <xs:attribute name="min" type="std:Temperature_type" use="optional"/>
    <xs:attribute name="max" type="std:Temperature_type" use="optional"/>
    <xs:attribute name="unite" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="dgx_dep_type">
    <xs:attribute name="classe" type="xs:string" use="optional"/>
    <xs:attribute name="onu" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="scelle_dep_type">
    <xs:attribute name="ori" type="xs:string" use="optional"/>
    <xs:attribute name="num" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="liste_dep_type">
    <xs:sequence>
      <xs:element name="reference-dep" type="reference_dep_type"/>
      <xs:element name="voyage-dep" type="voyage_dep_type" minOccurs="0"/>
      <xs:element name="lieux-dep" type="lieux_dep_type" minOccurs="0"/>
      <xs:element name="tiers-dep" type="tiers_dep_type"/>
      <xs:element name="equipement-dep" type="equipement_dep_type" minOccurs="0"/>
      <xs:element name="conventionnel-dep" type="conventionnel_dep_type" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Element conventionnel a depoter</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="drpo-dep" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="montant" type="xs:integer" use="optional"/>
          <xs:attribute name="devise" type="xs:string" use="optional"/>
          <xs:attribute name="tiers" type="xs:string" use="optional"/>
          <xs:attribute name="per" type="xs:string" use="optional"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="deplacement-dep" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="sic" type="xs:string" use="optional"/>
          <xs:attribute name="code" use="optional">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="9"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="nom" use="optional">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="20"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="immatr" use="optional">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="20"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="mode" use="optional">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:maxLength value="3"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="DateLPD_type">
    <xs:annotation>
      <xs:documentation>Type date dd/MM/yyyy( hh:mm)</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[012])/(19|20)[0-9][0-9]( ([2][0-3]|[0][0-9]|[1][0-9])[:]([0-5][0-9]))?"/>
    </xs:restriction>
  </xs:simpleType>
  <!--<xs:element name="agent-dep" type="std:party_type">
    <xs:annotation>
      <xs:documentation>Party: Agent</xs:documentation>
    </xs:annotation>
  </xs:element>-->
  <xs:complexType name="conventionnel_dep_type">
    <xs:annotation>
      <xs:documentation>Type representant le conventionnel a depoter</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="marchandise-dep" type="marchandise_dep_type" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="sic" type="xs:string" use="optional"/>
    <xs:attribute name="id" type="xs:string" use="optional"/>
    <xs:attribute name="code" type="xs:string" use="optional"/>
    <xs:attribute name="poids" type="std:Poids_type" use="optional"/>
    <xs:attribute name="lta" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="tax_dep_type">
    <xs:annotation>
      <xs:documentation>type de tax-dep: Taxe (= Taux de Fret dans les BL)</xs:documentation>
    </xs:annotation>
    <xs:attribute name="typeTaxation" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="typeTaxation-lib" type="xs:string" use="optional"/>
    <xs:attribute name="typeTaxationText" type="xs:string" use="optional"/>
    <xs:attribute name="amount" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="18"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="currencyCode" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="currencyQualifier" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="status" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="3"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="tiers_dep_type">
    <xs:attribute name="creat" type="xs:string" use="optional"/>
    <xs:attribute name="prop" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="reference_dep_type">
    <xs:sequence>
      <xs:element name="commentaire-dep" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="ext-prop" type="xs:string" use="required"/>
    <xs:attribute name="ext-gest" type="xs:string" use="optional"/>
    <xs:attribute name="lpd" type="xs:string" use="optional"/>
    <xs:attribute name="date-arr" type="DateLPD_type" use="optional"/>
    <xs:attribute name="statut" type="xs:string" use="optional"/>
    <xs:attribute name="aerien" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="lpd_user_type">
    <xs:attribute name="user" use="required">
      <xs:annotation>
        <xs:documentation>Code utilisateur du tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="tiersProf" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant tiers profession du message.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="9"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="email" type="xs:string" use="optional"/>
    <xs:attribute name="adresse" type="xs:string" use="optional"/>
    <xs:attribute name="reseau" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:complexType name="lpd_request_type">
    <xs:choice>
      <xs:element name="liste-depotage" type="liste_dep_type">
        <xs:annotation>
          <xs:documentation>Comment describing your root element</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="action" use="optional">
      <xs:annotation>
        <xs:documentation>Code fonction du document (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="CREATE|UPDATE|DELETE|ADD|ERASE|UKN"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:annotation>
        <xs:documentation>Identifiant fonctionnel du message utilisé pour effectuer le suivi de l intégration.</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="1"/>
          <xs:maxLength value="75"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required">
      <xs:annotation>
        <xs:documentation>Type du document à intégrer (Codification SIC).</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="0"/>
          <xs:maxLength value="7"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="statut" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string"/>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Request" type="lpd_request_type">
    <xs:annotation>
      <xs:documentation>Request précise la nature du document à intégrer.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Interchanges">
    <xs:annotation>
      <xs:documentation>Interchanges décrit le contexte de la transmission des données entre le SIC et le système partenaire.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="MessageSet" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="from" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système émetteur</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="to" use="required">
        <xs:annotation>
          <xs:documentation>Nom du système destinataire</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="75"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="servername" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="MessageSet">
    <xs:annotation>
      <xs:documentation>MessageSet identifie le message et permet d'assurer le suivi des échanges.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Destinataire"/>
        <xs:element ref="Emetteur"/>
        <xs:element name="Messages" type="lpd_messages_type">
          <xs:annotation>
            <xs:documentation>Messages contient le document à integrer, à notifier, à imprimer ou à acquitter</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="icid" use="required">
        <xs:annotation>
          <xs:documentation>Identifiant interchange de rattachement du message</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="14"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="date" type="std:DateLongue_type" use="required">
        <xs:annotation>
          <xs:documentation>"31/12/2004 23:59:59" Date d'envoi du message.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Destinataire" type="lpd_user_type">
    <xs:annotation>
      <xs:documentation>Identification du tiers destinataire du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Emetteur" type="lpd_user_type">
    <xs:annotation>
      <xs:documentation>Identification de l'émetteur du message</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="lpd_messages_type">
    <xs:choice maxOccurs="unbounded">
      <xs:element ref="Request"/>
      <xs:element ref="Notification"/>
    </xs:choice>
  </xs:complexType>
</xs:schema>
