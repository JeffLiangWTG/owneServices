                                else
                                {
                                    logger.Log.Info("No more messages.");
                                }
                            }
                        }
                    }
                }
                exceptions
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("7060a68c-8213-4a7f-9c7b-2c566ea47298")]
                    catch (System.Exception ex)
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("bf433dbb-e2dd-4d8c-bcc6-5b075c162838")]
                        logger.Log.Error("Caught Unexpected Exception: "+ ex.ToString());
                    }
                }
            }
        }
    }
}

