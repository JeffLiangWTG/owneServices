<xs:schema xmlns:tns="urn:PCM"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           elementFormDefault="qualified"
           targetNamespace="urn:PCM"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="CommonSimpleType.xsd" />

  <!-- Segments-->
  <!-- =================== -->
  <!-- UNH = MessageHeader -->
  <!-- =================== -->
  <xs:complexType name="STypeMessageHeader">
    <xs:sequence>
      <xs:element name="MessageIdentifier">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="MessageTypeIdentifier">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength6">
                  <xs:enumeration value="APERAK" />
                  <xs:enumeration value="BERMAN" />
                  <xs:enumeration value="IFTSTA" />
                  <xs:enumeration value="IFTSAI" />
                  <xs:enumeration value="APSTFI" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="MessageTypeVersionNumber">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="D" />
                  <xs:enumeration value="Z" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="MessageTypeReleaseNumber">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="03A" />
                  <xs:enumeration value="ZZZ" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="ControllingAgency">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:maxLength value="2" />
                  <xs:enumeration value="UN" />
                  <xs:enumeration value="ZZ" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="AssociationAssignedCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength6">
                  <xs:enumeration value="PROT20" />
                  <xs:enumeration value="EBL" />
                  <xs:enumeration value="BTS" />
                  <xs:enumeration value="APICS" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ======================= -->
  <!-- BGM = BeginningOfMessage -->
  <!-- ======================= -->
  <xs:complexType name="STypeBeginningOfMessage">
    <xs:sequence>
      <xs:element name="DocumentMessageName">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DocumentNameCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="7" />
                  <xs:enumeration value="22" />
                  <xs:enumeration value="23" />
                  <xs:enumeration value="44" />
                  <xs:enumeration value="96" />
                  <xs:enumeration value="124" />
                  <xs:enumeration value="127" />
                  <xs:enumeration value="185" />
                  <xs:enumeration value="186" />
                  <xs:enumeration value="287" />
                  <xs:enumeration value="294" />
                  <xs:enumeration value="316" />
                  <xs:enumeration value="317" />
                  <xs:enumeration value="318" />
                  <xs:enumeration value="349" />
                  <xs:enumeration value="404" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="DocumentMessageIdentification">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DocumentIdentifier" type="tns:TypeStringMaxLength35" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="MessageFunctionCode">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="9" />
            <xs:enumeration value="5" />
            <xs:enumeration value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="ResponseTypeCode">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="AI" />
            <xs:enumeration value="AP" />
            <xs:enumeration value="CA" />
            <xs:enumeration value="RE" />
            <xs:enumeration value="AQ" />
            <xs:enumeration value="RP" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ======================= -->
  <!-- DTM = DateTimePeriod UTC -->
  <!-- ======================= -->
  <xs:complexType name="STypeDateTimePeriod">
    <xs:sequence>
      <xs:element name="DateTimeFunctionQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="9" />
            <xs:enumeration value="46" />
            <xs:enumeration value="133" />
            <xs:enumeration value="137" />
            <xs:enumeration value="178" />
            <xs:enumeration value="186" />
            <xs:enumeration value="232" />
            <xs:enumeration value="293" />
            <xs:enumeration value="475" />
            <xs:enumeration value="558" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="DateOrTimeOrPeriodText" type="xs:dateTime" />
    </xs:sequence>
  </xs:complexType>
  <!-- ============ -->
  <!-- FTX = FreeText -->
  <!-- ============ -->
  <xs:complexType name="STypeFreeText">
    <xs:sequence>
      <xs:element name="TextSubjectCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="AAI" />
            <xs:enumeration value="CHG" />
            <xs:enumeration value="PRI" />
            <xs:enumeration value="ACF" />
            <xs:enumeration value="AGK" />
            <xs:enumeration value="HAN" />
            <xs:enumeration value="SPA" />
            <xs:enumeration value="AAO" />
            <xs:enumeration value="TDT" />
            <xs:enumeration value="AEG" />
            <!-- eLoket -->
            <!-- BTS -->
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="TextReference">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="FreeTextDescriptionCode">
              <xs:simpleType>
                <xs:union memberTypes="tns:ServiceCancellationCodeType tns:ServiceUpdateCodeType tns:MovementCancellationCodeType tns:StayCancellationCodeType tns:BTSFreeTextCodeType" />
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="TextLiteral">
        <xs:complexType>
          <xs:sequence>
            <xs:element maxOccurs="5" name="FreeText" type="tns:TypeStringMaxLength255" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ============== -->
  <!-- DOC = Document/MessageDetails  -->
  <!-- ============== -->
  <xs:complexType name="STypeDocumentMessageDetails">
    <xs:sequence>
      <xs:element name="DocumentMessageName">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DocumentNameCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="7" />
                  <xs:enumeration value="127" />
                  <xs:enumeration value="185" />
                  <xs:enumeration value="186" />
                  <xs:enumeration value="187" />
                  <xs:enumeration value="305" />
                  <xs:enumeration value="316" />
                  <xs:enumeration value="317" />
                  <xs:enumeration value="318" />
                  <xs:enumeration value="349" />
                  <xs:enumeration value="404" />
                  <xs:enumeration value="44" />
                  <xs:enumeration value="22" />
                  <xs:enumeration value="294"/>
                  <xs:enumeration value="298"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="DocumentMessageDetails">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DocumentIdentifier" type="tns:TypeStringMaxLength50" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ============== -->
  <!-- RFF = Reference  -->
  <!-- ============== -->
  <xs:complexType name="STypeReference">
    <xs:sequence>
      <xs:element name="ReferenceCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="ACW" />
            <xs:enumeration value="ACD" />
            <xs:enumeration value="ACL" />
            <xs:enumeration value="AES" />
            <xs:enumeration value="DFT" />
            <xs:enumeration value="PBT" />
            <xs:enumeration value="PTC" />
            <xs:enumeration value="SBT" />
            <xs:enumeration value="AGI" />
            <!-- BTS -->
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="ReferenceIdentifier" type="tns:TypeStringMaxLength70" />
      <xs:element minOccurs="0" name="RevisionIdentifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeNumericMaxLength6">
            <xs:minInclusive value="1" />
            <xs:maxInclusive value="999999" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ==================== -->
  <!-- DTM = Date/Time/Period RFF -->
  <!-- ==================== -->
  <xs:complexType name="STypeDateTimePeriodRFF">
    <xs:sequence>
      <xs:element name="DateTimeFunctionQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="182" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="DateOrTimeOrPeriodText" type="xs:dateTime" />
    </xs:sequence>
  </xs:complexType>
  <!-- ============ -->
  <!-- QTY = Quantity  -->
  <!-- ============ -->
  <xs:complexType name="STypeQuantity">
    <xs:sequence>
      <xs:element minOccurs="0" name="QuantityDetails">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="QuantityTypeCodeQualifier">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="TIM" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="Quantity" type="tns:TypeStringMaxLength35" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ==================== -->
  <!-- NAD = NameAndAddress -->
  <!-- ==================== -->
  <xs:complexType name="STypeNameAndAddress">
    <xs:sequence>
      <xs:element name="PartyFunctionCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="CG" />
            <xs:enumeration value="MS" />
            <xs:enumeration value="MR" />
            <xs:enumeration value="CPE" />
            <xs:enumeration value="CA" />
            <!-- BTS -->
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="PartyIdentificationDetails">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="PartyIdentifier" type="tns:TypeStringMaxLength35" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="NameAndAddress">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="NameAndAddressDescription" type="tns:TypeStringMaxLength35" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ======================== -->
  <!-- CTA = ContactInformation -->
  <!-- ======================== -->
  <xs:complexType name="STypeContactInformation">
    <xs:sequence>
      <xs:element name="ContactFunctionCode">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="IC" />
            <xs:enumeration value="WI" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="DepartmentOrEmployeeDetails">
        <xs:complexType>
          <xs:sequence>
            <xs:element minOccurs="0" name="DepartmentOrEmployeeNameCode" type="tns:TypeStringMaxLength17" />
            <xs:element name="DepartmentOrEmployeeName" type="tns:TypeStringMaxLength35" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ========================== -->
  <!-- COM = CommunicationContact -->
  <!-- ========================== -->
  <xs:complexType name="STypeCommunicationContact">
    <xs:sequence>
      <xs:element name="CommunicationContact">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="CommunicationAddressIdentifier" type="tns:TypeStringMaxLength255" />
            <xs:element name="CommunicationAddressCodeQualifier">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="EM" />
                  <xs:enumeration value="FX" />
                  <xs:enumeration value="TE" />
                  <xs:enumeration value="AL" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ======================== -->
  <!-- ERC = Application Error Information -->
  <!-- ======================== -->
  <xs:complexType name="STypeApplicationErrorInformation">
    <xs:sequence>
      <xs:element name="ApplicationErrorDetail">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ApplicationErrorCode" type="tns:TypeStringMaxLength8" />
            <xs:element minOccurs="0" name="CodeListIdentificationCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength17">
                  <xs:enumeration value="REJ" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element minOccurs="0" name="CodeListResponsibleAgencyCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="APA" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ============== -->
  <!-- FTX = FreeText  ERC -->
  <!-- ============== -->
  <xs:complexType name="STypeFreeTextERC">
    <xs:sequence>
      <xs:element name="TextSubjectCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="AAO" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="TextLiteral">
        <xs:complexType>
          <xs:sequence>
            <xs:element maxOccurs="5" name="FreeText">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength255" />
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- =================== -->
  <!-- CNT = Control Total -->
  <!-- =================== -->
  <xs:complexType name="STypeControlTotal">
    <xs:sequence>
      <xs:element name="Control">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ControlTotalTypeCodeQualifier" type="tns:TypeStringMaxLength3" />
            <xs:element name="ControlTotalValue" type="tns:TypeNumericMaxLength18" />
            <xs:element name="MeasurementUnitCode" type="tns:TypeStringMaxLength3" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ====================== -->
  <!-- EQD = EquipmentDetails -->
  <!-- ====================== -->
  <xs:complexType name="STypeEquipmentDetails">
    <xs:sequence>
      <xs:element name="EquipmentTypeCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="BRN" />
            <xs:enumeration value="BRY" />
            <xs:enumeration value="CN" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="EquipmentIdentification">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="EquipmentIdentifier" type="tns:TypeStringMaxLength17" />
            <xs:element name="CodeListIdentificationCode" type="tns:BargeIdentificationType" />
            <xs:element name="CountryNameCode" type="tns:TypeStringMaxLength3" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="EquipmentSizeAndType">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="EquipmentSizeAndTypeDescriptionCode" type="tns:TypeStringMaxLength10" />
            <xs:element minOccurs="0" name="EquipmentSizeAndTypeDescription" type="tns:TypeStringMaxLength35" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="FullOrEmptyIndicatorCode">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="4" />
            <xs:enumeration value="5" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- =================== -->
  <!-- EQN = NumberOfUnits -->
  <!-- =================== -->
  <xs:complexType name="STypeNumberOfUnitsEQD">
    <xs:sequence>
      <xs:element name="NumberOfUnitDetails">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="UnitsQuantity">
              <xs:simpleType>
                <xs:restriction base="tns:TypeNumericMaxLength15" />
              </xs:simpleType>
            </xs:element>
            <xs:element name="UnitTypeCodeQualifier">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="3" />
                  <xs:enumeration value="4" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ================== -->
  <!-- MEA = Measurements -->
  <!-- ================== -->
  <xs:complexType name="STypeMeasurementsEQD">
    <xs:sequence>
      <xs:element minOccurs="0" name="MeasurementPurposeCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="AAE" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="MeasurementDetails">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="MeasuredAttributeCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="ACS" />
                  <xs:enumeration value="WM" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="ValueRange">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="MeasurementUnitCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="CMT" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="Measure">
              <xs:simpleType>
                <xs:restriction base="tns:TypeNumericMaxLength6">
                  <xs:minInclusive value="1" />
                  <xs:maxInclusive value="999999" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ================= -->
  <!-- RFF = Reference EQD -->
  <!-- ================= -->
  <xs:complexType name="STypeReferenceEQD">
    <xs:sequence>
      <xs:element name="ReferenceCodeQualifier" type="tns:EqdReferenceCode" />
      <xs:element name="ReferenceIdentifier" type="tns:TypeStringMaxLength70" />
      <xs:element name="RevisionIdentifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeNumericMaxLength6">
            <xs:minInclusive value="1" />
            <xs:maxInclusive value="999999" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ======================== -->
  <!-- TDT = DetailsOfTransport -->
  <!-- ======================== -->
  <xs:complexType name="STypeDetailsOfTransport">
    <xs:sequence>
      <xs:element minOccurs="0" name="TransportStageCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="20" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element minOccurs="0" name="MeansOfTransportJourneyIdentifier" type="tns:TypeStringMaxLength17" />
      <xs:element minOccurs="0" name="ModeOfTransport">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="TransportModeNameCode">
              <xs:simpleType>
                <xs:restriction base="tns:TypeStringMaxLength3">
                  <xs:enumeration value="1" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="TransportMeans">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="TransportMeansDescriptionCode" type="tns:TypeStringMaxLength8" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="Carrier">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="CarrierIdentifier" type="tns:TypeStringMaxLength17" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element minOccurs="0" name="TransportIdentification">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="TransportMeansIdentificationNameIdentifier" type="tns:TypeStringMaxLength9" />
            <xs:element name="TransportMeansIdentificationName" type="tns:TypeStringMaxLength35" />
            <xs:element name="TransportMeansNationalityCode" type="tns:TypeStringMaxLength3" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ================= -->
  <!-- RFF = Reference TDT -->
  <!-- ================= -->
  <xs:complexType name="STypeReferenceTDT">
    <xs:sequence>
      <xs:element name="ReferenceCodeQualifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeStringMaxLength3">
            <xs:enumeration value="ACD" />
            <xs:enumeration value="ACL" />
            <xs:enumeration value="ATZ" />
            <xs:enumeration value="VM" />
            <xs:enumeration value="AGI" />
            <xs:enumeration value="SQ" />
            <xs:enumeration value="AES" />
            <!-- BTS -->
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="ReferenceIdentifier" type="tns:TypeStringMaxLength70" />
      <xs:element minOccurs="0" name="RevisionIdentifier">
        <xs:simpleType>
          <xs:restriction base="tns:TypeNumericMaxLength6">
            <xs:minInclusive value="1" />
            <xs:maxInclusive value="999999" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <!-- ====================== -->
  <!-- MEA = Measurements  TDT  -->
  <!-- ====================== -->
  <xs:complexType name="STypeMeasurementsTDT">
    <xs:sequence>
      <xs:element minOccurs="0" name="MeasurementPurposeCodeQualifier">
        <xs:simpleType>
