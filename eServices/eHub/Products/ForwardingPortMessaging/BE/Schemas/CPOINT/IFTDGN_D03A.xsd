<?xml version="1.0" encoding="utf-8"?><xs:schema xmlns:tns="urn:PCM"           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"           xmlns:xs="http://www.w3.org/2001/XMLSchema"           targetNamespace="urn:PCM"           elementFormDefault="qualified">    <xs:include schemaLocation="CommonSimpleType.xsd" />  <xs:element name="IFTDGN" >    <xs:complexType>      <xs:sequence>        <xs:element name="MessageHeader" type="tns:STypeMessageHeader_IFTDGN"/>        <xs:element name="BeginningOfMessage" type="tns:STypeBeginningOfMessage_IFTDGN"/>        <xs:element name="DateTimePeriod" type="tns:STypeDateTimePeriod_IFTDGN" />        <xs:element name="FreeText" type="tns:STypeFreeText_IFTDGN" minOccurs="0" maxOccurs="9"/>        <xs:element name="HandlingInstructions" type="tns:STypeHandlingInstructions_IFTDGN" />        <xs:element name="GroupReference" minOccurs="0" maxOccurs="9">          <xs:complexType>            <xs:sequence>              <xs:element name="Reference" type="tns:STypeReference_IFTDGN"/>              <!--xs:element name="DateTimePeriod" type="tns:STypeDateTimePeriod" minOccurs="0" maxOccurs="9"/-->            </xs:sequence>          </xs:complexType>        </xs:element>        <xs:element name="GroupDetailsOfTransport">          <xs:complexType>            <xs:sequence>              <xs:element name="DetailsOfTransport" type="tns:STypeDetailsOfTransport_IFTDGN"/>              <!--xs:element name="DateTimePeriod" type="tns:STypeDateTimePeriod" minOccurs="0" maxOccurs="9"/-->              <xs:element name="Reference" type="tns:STypeReference_IFTDGN" minOccurs="0" maxOccurs="2"/>              <xs:element name="GroupPlaceLocationIdentification" maxOccurs="3">                <xs:complexType>                  <xs:sequence>                    <xs:element name="PlaceLocationIdentification" type="tns:STypePlaceLocationIdentificationTDT_IFTDGN"/>                    <xs:element name="DateTimePeriod" type="tns:STypeDateTimePeriodTDTLOC_IFTDGN" minOccurs="0" maxOccurs="2"/>                  </xs:sequence>                </xs:complexType>              </xs:element>            </xs:sequence>          </xs:complexType>        </xs:element>        <xs:element name="GroupNameAndAddress" minOccurs="3" maxOccurs="9">          <xs:complexType>            <xs:sequence>              <xs:element name="NameAndAddress" type="tns:STypeNameAndAddress_IFTDGN"/>              <xs:element name="GroupContactInformation" minOccurs="0" maxOccurs="2">                <xs:complexType>                  <xs:sequence>                    <xs:element name="ContactInformation" type="tns:STypeContactInformation_IFTDGN"/>                    <xs:element name="CommunicationContact" type="tns:STypeCommunicationContact_IFTDGN" minOccurs="0" maxOccurs="3"/>                  </xs:sequence>                </xs:complexType>              </xs:element>            </xs:sequence>          </xs:complexType>        </xs:element>        <xs:element name="GroupEquipmentDetails" minOccurs="0" maxOccurs="999">          <xs:complexType>            <xs:sequence>              <xs:element name="EquipmentDetails" type="tns:STypeEquipmentDetails_IFTDGN"/>              <xs:element name="Measurements" type="tns:STypeMeasurementsEQD_IFTDGN" minOccurs="0" maxOccurs="1"/>            </xs:sequence>          </xs:complexType>        </xs:element>        <xs:element name="GroupConsignmentInformation" maxOccurs="999">          <xs:complexType>            <xs:sequence>              <xs:element name="ConsignmentInformation" type="tns:STypeConsignmentInformation_IFTDGN"/>              <xs:element name="HandlingInstructions" type="tns:STypeHandlingInstructions_IFTDGN" minOccurs="0"/>              <xs:element name="DateTimePeriod" type="tns:STypeDateTimePeriod_IFTDGN" minOccurs="0" maxOccurs="2"/>              <xs:element name="PlaceLocationIdentification" type="tns:STypePlaceLocationIdentificationCNI_IFTDGN" minOccurs="0" maxOccurs="3"/>              <xs:element name="GroupDetailsOfTransport" minOccurs="0">                <xs:complexType>                  <xs:sequence>                    <xs:element name="DetailsOfTransport" type="tns:STypeDetailsOfTransportCNI_IFTDGN"/>                    <xs:element name="Reference" type="tns:STypeReference_IFTDGN" minOccurs="0" maxOccurs="9"/>                    <!--xs:element name="GroupPlaceLocationIdentification" minOccurs="0" maxOccurs="99">											<xs:complexType>												<xs:sequence>													<xs:element name="PlaceLocationIdentification" type="tns:STypePlaceLocationIdentificationCNITDT"/>													<xs:element name="DateTimePeriod" type="tns:STypeDateTimePeriod" minOccurs="0" maxOccurs="9"/>												</xs:sequence>											</xs:complexType>										</xs:element-->                  </xs:sequence>                </xs:complexType>              </xs:element>              <xs:element name="GroupNameAndAddress" minOccurs="0" maxOccurs="6">                <xs:complexType>                  <xs:sequence>                    <xs:element name="NameAndAddress" type="tns:STypeNameAndAddress_IFTDGN"/>                    <xs:element name="GroupContactInformation" minOccurs="0" maxOccurs="2">                      <xs:complexType>                        <xs:sequence>                          <xs:element name="ContactInformation" type="tns:STypeContactInformation_IFTDGN"/>                          <xs:element name="CommunicationContact" type="tns:STypeCommunicationContact_IFTDGN" minOccurs="0" maxOccurs="3"/>                        </xs:sequence>                      </xs:complexType>                    </xs:element>                    <xs:element name="Reference" type="tns:STypeReference_IFTDGN" minOccurs="0" maxOccurs="9"/>                  </xs:sequence>                </xs:complexType>              </xs:element>              <xs:element name="GroupGoodsItemDetails" maxOccurs="99">                <xs:complexType>                  <xs:sequence>                    <xs:element name="GoodsItemDetails" type="tns:STypeGoodsItemDetailsCNI_IFTDGN"/>                    <xs:element name="FreeText" type="tns:STypeFreeText_IFTDGN" minOccurs="0" maxOccurs="2"/>                    <xs:element name="PackageIdentification" type="tns:STypePackageIdentification_IFTDGN" minOccurs="0"/>                    <xs:element name="GroupSplitGoodsPlacement" minOccurs="0" maxOccurs="99">                      <xs:complexType>                        <xs:sequence>                          <xs:element name="SplitGoodsPlacement" type="tns:STypeSplitGoodsPlacement_IFTDGN"/>                          <xs:element name="Measurements" type="tns:STypeMeasurementsSGP_IFTDGN" minOccurs="0"/>                        </xs:sequence>                      </xs:complexType>                    </xs:element>                    <xs:element name="GroupDangerousGoods">                      <xs:complexType>                        <xs:sequence>                          <xs:element name="DangerousGoods" type="tns:STypeDangerousGoods_IFTDGN"/>                          <xs:element name="FreeText" type="tns:STypeFreeText_IFTDGN" minOccurs="1" maxOccurs="9"/>                          <xs:element name="Measurements" type="tns:STypeMeasurementsDGS_IFTDGN" minOccurs="1" maxOccurs="5"/>                          <xs:element name="PlaceLocationIdentification" type="tns:STypePlaceLocationIdentificationDGS_IFTDGN" minOccurs="0" maxOccurs="99"/>                          <xs:element name="Reference" type="tns:STypeReference_IFTDGN" minOccurs="0" maxOccurs="9"/>                          <xs:element name="GroupSplitGoodsPlacement" minOccurs="0" maxOccurs="99">                            <xs:complexType>                              <xs:sequence>                                <xs:element name="SplitGoodsPlacement" type="tns:STypeSplitGoodsPlacement_IFTDGN"/>                                <xs:element name="PlaceLocationIdentification" type="tns:STypePlaceLocationIdentificationSGP_IFTDGN" minOccurs="0"/>                                <xs:element name="Measurements" type="tns:STypeMeasurementsSGP_IFTDGN" minOccurs="0" maxOccurs="5"/>                              </xs:sequence>                            </xs:complexType>                          </xs:element>                        </xs:sequence>                      </xs:complexType>                    </xs:element>                  </xs:sequence>                </xs:complexType>              </xs:element>            </xs:sequence>          </xs:complexType>        </xs:element>      </xs:sequence>      <xs:attribute name="VersionMajor" type="xs:integer" use="required" fixed="2"/>      <xs:attribute name="VersionMinor" type="xs:integer" use="required" fixed="0"/>    </xs:complexType>  </xs:element>  <!-- Segments-->  <!-- =================== -->  <!-- UNH = MessageHeader -->  <!-- =================== -->  <xs:complexType name="STypeMessageHeader_IFTDGN">    <xs:sequence>      <xs:element name="MessageIdentifier">        <xs:complexType>          <xs:sequence>            <xs:element name="MessageTypeIdentifier">              <xs:simpleType>                <xs:restriction base="tns:TypeStringMaxLength6">                  <xs:enumeration value="IFTDGN"/>                </xs:restriction>              </xs:simpleType>            </xs:element>            <xs:element name="MessageTypeVersionNumber">              <xs:simpleType>                <xs:restriction base="tns:TypeStringMaxLength3">                  <xs:enumeration value="D"/>                </xs:restriction>              </xs:simpleType>            </xs:element>            <xs:element name="MessageTypeReleaseNumber">              <xs:simpleType>                <xs:restriction base="tns:TypeStringMaxLength3">                  <xs:enumeration value="03A"/>                </xs:restriction>              </xs:simpleType>            </xs:element>            <xs:element name="ControllingAgency">              <xs:simpleType>                <xs:restriction base="xs:string">                  <xs:maxLength value="2"/>                  <xs:enumeration value="UN"/>                </xs:restriction>              </xs:simpleType>            </xs:element>            <xs:element name="AssociationAssignedCode">              <xs:simpleType>                <xs:restriction base="tns:TypeStringMaxLength6">                  <xs:enumeration value="PROT20"/>                </xs:restriction>              </xs:simpleType>            </xs:element>          </xs:sequence>        </xs:complexType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ======================= -->  <!-- BGM = BeginningOfMessage -->  <!-- ======================= -->  <xs:complexType name="STypeBeginningOfMessage_IFTDGN">    <xs:sequence>      <xs:element name="DocumentMessageName">        <xs:complexType>          <xs:sequence>            <xs:element name="DocumentNameCode">              <xs:simpleType>                <xs:restriction base="tns:TypeStringMaxLength3">                  <xs:enumeration value="89N"/>                  <xs:enumeration value="89T"/>                </xs:restriction>              </xs:simpleType>            </xs:element>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="DocumentMessageIdentification">        <xs:complexType>          <xs:sequence>            <xs:element name="DocumentIdentifier" type="tns:TypeStringMaxLength35"/>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="MessageFunctionCode">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="9"/>            <xs:enumeration value="5"/>            <xs:enumeration value="1"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="ResponseTypeCode" minOccurs="0">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="AP"/>            <xs:enumeration value="CA"/>            <xs:enumeration value="RE"/>          </xs:restriction>        </xs:simpleType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ======================= -->  <!-- DTM = DateTimePeriod UTC -->  <!-- ======================= -->  <xs:complexType name="STypeDateTimePeriod_IFTDGN">    <xs:sequence>      <xs:element name="DateTimeFunctionQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="132"/>            <xs:enumeration value="133"/>            <xs:enumeration value="137"/>            <xs:enumeration value="369"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="DateOrTimeOrPeriodText" type="xs:dateTime"/>    </xs:sequence>  </xs:complexType>  <!-- ============ -->  <!-- FTX = FreeText -->  <!-- ============ -->  <xs:complexType name="STypeFreeText_IFTDGN">    <xs:sequence>      <xs:element name="TextSubjectCodeQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="AAC"/>            <xs:enumeration value="AAD"/>            <xs:enumeration value="AAO"/>            <xs:enumeration value="CHG"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="TextReference" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="FreeTextDescriptionCode">              <xs:simpleType>                <xs:union memberTypes="tns:DGNCancellationCodeType tns:LimitedQuantityCodeType tns:DGSAdditionalInfoCodeType"/>              </xs:simpleType>            </xs:element>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="TextLiteral" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="FreeText" type="tns:TypeStringMaxLength512" maxOccurs="5"/>          </xs:sequence>        </xs:complexType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ========================== -->  <!-- HAN = HandlingInstructions -->  <!-- ==========================-->  <xs:complexType name="STypeHandlingInstructions_IFTDGN">    <xs:sequence>      <!--xs:element name="HandlingInstructions">				<xs:complexType>					<xs:sequence-->      <xs:element name="HandlingInstructionDescriptionCode">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="LDI"/>            <xs:enumeration value="LLO"/>            <xs:enumeration value="T"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <!--/xs:sequence>				</xs:complexType>			</xs:element-->    </xs:sequence>  </xs:complexType>  <!-- ============== -->  <!-- RFF = Reference  -->  <!-- ============== -->  <xs:complexType name="STypeReference_IFTDGN">    <xs:sequence>      <xs:element name="ReferenceCodeQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="AAY"/>            <xs:enumeration value="ALG"/>            <xs:enumeration value="ALH"/>            <xs:enumeration value="ATZ"/>            <xs:enumeration value="CNI"/>            <xs:enumeration value="FF"/>            <xs:enumeration value="GID"/>            <xs:enumeration value="VM"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="ReferenceIdentifier" type="tns:TypeStringMaxLength70"/>      <xs:element name="RevisionIdentifier" minOccurs="0">        <xs:simpleType>          <xs:restriction base="tns:TypeNumericMaxLength6">            <xs:minInclusive value="1"/>            <xs:maxInclusive value="999999"/>          </xs:restriction>        </xs:simpleType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ======================== -->  <!-- TDT = DetailsOfTransport -->  <!-- ======================== -->  <xs:complexType name="STypeDetailsOfTransport_IFTDGN">    <xs:sequence>      <xs:element name="TransportStageCodeQualifier" minOccurs="0">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="20"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="MeansOfTransportJourneyIdentifier" type="tns:TypeStringMaxLength17" minOccurs="0"/>      <xs:element name="ModeOfTransport" >        <xs:complexType>          <xs:sequence>            <xs:element name="TransportModeNameCode">              <xs:simpleType>                <xs:restriction base="tns:TypeStringMaxLength3">                  <xs:enumeration value="1"/>                  <xs:enumeration value="2"/>                  <xs:enumeration value="3"/>                  <xs:enumeration value="7"/>                  <xs:enumeration value="8"/>                </xs:restriction>              </xs:simpleType>            </xs:element>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="TransportMeans" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="TransportMeansDescriptionCode" type="tns:TypeStringMaxLength8"/>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element minOccurs="0" name="Carrier">        <xs:complexType>          <xs:sequence>            <xs:element name="CarrierIdentifier" type="tns:TypeStringMaxLength17" />          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="TransportIdentification" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="TransportMeansIdentificationNameIdentifier" type="tns:TypeStringMaxLength9"/>            <xs:element name="TransportMeansIdentificationName" type="tns:TypeStringMaxLength35"/>            <xs:element name="TransportMeansNationalityCode" type="tns:TypeStringMaxLength3" minOccurs="0"/>          </xs:sequence>        </xs:complexType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ==================================== -->  <!-- LOC = PlaceLocationIdentification TDT-->  <!-- ==================================== -->  <xs:complexType name="STypePlaceLocationIdentificationTDT_IFTDGN">    <xs:sequence>      <xs:element name="LocationFunctionCodeQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="153"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="LocationIdentification">        <xs:complexType>          <xs:sequence>            <xs:element name="LocationNameCode">              <xs:simpleType>                <xs:union memberTypes="tns:UNLocodeCodeType"/>              </xs:simpleType>            </xs:element>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="RelatedLocationOneIdentification" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="FirstRelatedLocationNameCode" type="tns:TypeStringMaxLength25"/>            <xs:element name="CodeListIdentificationCode" type="tns:TypeStringMaxLength17" minOccurs="0"/>            <xs:element name="CodeListResponsibleAgencyCode" type="tns:TypeStringMaxLength3" minOccurs="0"/>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="RelatedLocationTwoIdentification" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="SecondRelatedLocationNameCode" type="tns:TypeStringMaxLength25"/>            <xs:element name="CodeListIdentificationCode" type="tns:TypeStringMaxLength17" minOccurs="0"/>            <xs:element name="CodeListResponsibleAgencyCode" type="tns:TypeStringMaxLength3" minOccurs="0"/>          </xs:sequence>        </xs:complexType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ============================= -->  <!-- DTM = DateTimePeriod UTC TDTLOC -->  <!-- ============================= -->  <xs:complexType name="STypeDateTimePeriodTDTLOC_IFTDGN">    <xs:sequence>      <xs:element name="DateTimeFunctionQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="132"/>            <xs:enumeration value="133"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="DateOrTimeOrPeriodText" type="xs:dateTime"/>    </xs:sequence>  </xs:complexType>  <!-- ==================== -->  <!-- NAD = NameAndAddress -->  <!-- ==================== -->  <xs:complexType name="STypeNameAndAddress_IFTDGN">    <xs:sequence>      <xs:element name="PartyFunctionCodeQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="CG"/>            <xs:enumeration value="CN"/>            <xs:enumeration value="CZ"/>            <xs:enumeration value="DA"/>            <xs:enumeration value="DF"/>            <xs:enumeration value="FU"/>            <xs:enumeration value="FW"/>            <xs:enumeration value="MS"/>            <xs:enumeration value="MR"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="PartyIdentificationDetails" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="PartyIdentifier" type="tns:TypeStringMaxLength35"/>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="NameAndAddress" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="NameAndAddressDescription" type="tns:TypeStringMaxLength35" maxOccurs="5"/>          </xs:sequence>        </xs:complexType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ======================== -->  <!-- CTA = ContactInformation -->  <!-- ======================== -->  <xs:complexType name="STypeContactInformation_IFTDGN">    <xs:sequence>      <xs:element name="ContactFunctionCode">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="HE"/>            <xs:enumeration value="IC"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="DepartmentOrEmployeeDetails">        <xs:complexType>          <xs:sequence>            <xs:element name="DepartmentOrEmployeeNameCode" type="tns:TypeStringMaxLength17" minOccurs="0"/>            <xs:element name="DepartmentOrEmployeeName" type="tns:TypeStringMaxLength35"/>          </xs:sequence>        </xs:complexType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ========================== -->  <!-- COM = CommunicationContact -->  <!-- ========================== -->  <xs:complexType name="STypeCommunicationContact_IFTDGN">    <xs:sequence>      <xs:element name="CommunicationAddressIdentifier" type="tns:TypeStringMaxLength255"/>      <xs:element name="CommunicationAddressCodeQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="EM"/>            <xs:enumeration value="FX"/>            <xs:enumeration value="TE"/>          </xs:restriction>        </xs:simpleType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ====================== -->  <!-- EQD = EquipmentDetails -->  <!-- ====================== -->  <xs:complexType name="STypeEquipmentDetails_IFTDGN">    <xs:sequence>      <xs:element name="EquipmentTypeCodeQualifier">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="CN"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="EquipmentIdentification" minOccurs="0">        <xs:complexType>          <xs:sequence>            <xs:element name="EquipmentIdentifier" type="tns:TypeStringMaxLength17"/>            <xs:element name="CodeListIdentificationCode" type="tns:BargeIdentificationType_IFTDGN" minOccurs="0"/>            <xs:element name="CountryNameCode" type="tns:TypeStringMaxLength3" minOccurs = "0"/>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="EquipmentSizeAndType">        <xs:complexType>          <xs:sequence>            <xs:element name="EquipmentSizeAndTypeDescriptionCode" type="tns:TypeStringMaxLength10"/>            <xs:element name="EquipmentSizeAndTypeDescription" type="tns:TypeStringMaxLength35" minOccurs="0"/>          </xs:sequence>        </xs:complexType>      </xs:element>      <xs:element name="FullOrEmptyIndicatorCode" minOccurs="0">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="4"/>          </xs:restriction>        </xs:simpleType>      </xs:element>    </xs:sequence>  </xs:complexType>  <!-- ====================== -->  <!-- MEA = Measurements EQD -->  <!-- ====================== -->  <xs:complexType name="STypeMeasurementsEQD_IFTDGN">    <xs:sequence>      <xs:element name="MeasurementPurposeCodeQualifier" minOccurs="0">        <xs:simpleType>          <xs:restriction base="tns:TypeStringMaxLength3">            <xs:enumeration value="AAE"/>          </xs:restriction>        </xs:simpleType>      </xs:element>      <xs:element name="MeasurementDetails">        <xs:complexType>          <xs:sequence>            <xs:element name="MeasuredAttributeCode">              <xs:simpleType>           