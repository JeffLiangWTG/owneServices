<xs:schema xmlns:tns="urn:PCM"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           elementFormDefault="qualified"
           targetNamespace="urn:PCM"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- ================ -->
  <!-- new simple types -->
  <!-- ================ -->
  <!-- string simple types -->
  <xs:simpleType name="TypeStringLength4">
    <xs:restriction base="xs:string">
      <xs:length value="4"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength3">
    <xs:restriction base="xs:string">
      <xs:maxLength value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength4">
    <xs:restriction base="xs:string">
      <xs:maxLength value="4"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength5">
    <xs:restriction base="xs:string">
      <xs:maxLength value="5"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength6">
    <xs:restriction base="xs:string">
      <xs:maxLength value="6" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength7">
    <xs:restriction base="xs:string">
      <xs:maxLength value="7" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength8">
    <xs:restriction base="xs:string">
      <xs:maxLength value="8" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength9">
    <xs:restriction base="xs:string">
      <xs:maxLength value="9" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength10">
    <xs:restriction base="xs:string">
      <xs:maxLength value="10" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength17">
    <xs:restriction base="xs:string">
      <xs:maxLength value="17" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength18">
    <xs:restriction base="xs:string">
      <xs:maxLength value="18" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength25">
    <xs:restriction base="xs:string">
      <xs:maxLength value="25" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength26">
    <xs:restriction base="xs:string">
      <xs:maxLength value="26" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength35">
    <xs:restriction base="xs:string">
      <xs:maxLength value="35" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength50">
    <xs:restriction base="xs:string">
      <xs:maxLength value="50" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength70">
    <xs:restriction base="xs:string">
      <xs:maxLength value="70" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength255">
    <xs:restriction base="xs:string">
      <xs:maxLength value="255" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeStringMaxLength512">
    <xs:restriction base="xs:string">
      <xs:maxLength value="512" />
    </xs:restriction>
  </xs:simpleType>
  <!-- number simple types -->
  <xs:simpleType name="TypeNumericMaxLength4">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="4" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeNumericMaxLength5">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="5" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeNumericMaxLength6">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="6" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeNumericMaxLength8">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="8"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeNumericMaxLength15">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="15" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TypeNumericMaxLength18">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="18" />
    </xs:restriction>
  </xs:simpleType>
  <!-- code lists simple types -->
  <xs:simpleType name="UNLocodeCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: UN/139 (LOCODE)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="5" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ERITerminalCode">
    <xs:annotation>
      <xs:appinfo>Codelist: ERI Terminal Code</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="15" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SEBerthCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: SE/140 (BERTH)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
      <xs:maxLength value="4" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PilotageCodeType">
    <xs:annotation>
      <xs:appinfo />
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="N">
        <xs:annotation>
          <xs:appinfo>Geen loods</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="S">
        <xs:annotation>
          <xs:appinfo>Speciale bestelling</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="J">
        <xs:annotation>
          <xs:appinfo>Loods op het volledige traject</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HeliPilotageType">
    <xs:restriction base="tns:TypeStringMaxLength3">
      <xs:enumeration value="HPN">
        <xs:annotation>
          <xs:appinfo>Heli piloting not required</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HPS">
        <xs:annotation>
          <xs:appinfo>Heli piloting required when service is suspended</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HPY">
        <xs:annotation>
          <xs:appinfo>Heli piloting required</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ImportantRemarkCodeType">
    <xs:restriction base="xs:string">
      <xs:length value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ThrusterCodeType">
    <xs:annotation>
      <xs:appinfo>
        Indication that vessel has a working bow thruster and or stern
        thruster
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="BON">
        <xs:annotation>
          <xs:appinfo>No working bow thruster</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BOW">
        <xs:annotation>
          <xs:appinfo>Working bow thruster</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STN">
        <xs:annotation>
          <xs:appinfo>No working stern thruster</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="STW">
        <xs:annotation>
          <xs:appinfo>Working stern thruster</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VesselExchangeCodeType">
    <xs:annotation>
      <xs:appinfo>
        Indication that verification by the Harbour Master's Office is required
        concerning the Vessel Exchange that will take place (mandatory to be used in case of a Shift
        movement, not to be used in case of a Departure movement).
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="SWN">
        <xs:annotation>
          <xs:appinfo>No Vessel Exchange (Niet Uitwisselen)</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SWP">
        <xs:annotation>
          <xs:appinfo> Vessel Exchange (Uitwisselen)</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MovementCancellationCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/CAN (Reason for cancellation)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="CTJ" />
      <xs:enumeration value="DNA" />
      <xs:enumeration value="CAG" />
      <!-- aanvullen-->
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="StayCancellationCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: subset of APA/CAN (Reason for cancellation)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="CTJ" />
      <xs:enumeration value="DNA" />
      <xs:enumeration value="CAG" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceCancellationCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/186A (Reason for cancellation)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceUpdateCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/186U (Reason for update)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PriorityCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/PI (Type of priority)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="3" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReductionHarbourDuesCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/RHA (Reduction of harbour dues)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="2" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MovementCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/MOV (Movement Type)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="A">
        <xs:annotation>
          <xs:appinfo>Arrive</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="D">
        <xs:annotation>
          <xs:appinfo>Depart</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="S">
        <xs:annotation>
          <xs:appinfo>Shift</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VesselConditionCodeType">
    <xs:annotation>
      <xs:appinfo>Codelist: APA/VC (Vessel Condition)</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="B">
        <xs:annotation>
          <xs:appinfo>Ballasted</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="G">
        <xs:annotation>
          <xs:appinfo>Loaded</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="L">
        <xs:annotation>
          <xs:appinfo>Empty</xs:appinfo>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BTSFreeTextCodeType">
    <xs:annotation>
      <xs:appinfo>BTS Free Text</xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="BRY" />
      <xs:enumeration value="BRN" />
      <xs:enumeration value="CRE" />
      <xs:enumeration value="REP" />
      <xs:enumeration value="CAN" />
      <xs:enumeration value="Y" />
      <xs:enumeration value="N" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BargeIdentificationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OFS" />
      <xs:enumeration value="IMO" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EqdReferenceCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="AGI" />
      <xs:enumeration value="ENI" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>