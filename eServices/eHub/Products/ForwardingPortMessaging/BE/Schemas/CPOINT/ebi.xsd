<?xml version="1.0" encoding="utf-8" ?>
<xs:schema targetNamespace="http://www.myvan.descartes.com/ebi/2004/r1"
           xmlns:tns="http://www.myvan.descartes.com/ebi/2004/r1"
           elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           id="version1.0">
  <xs:element name="Sequence" type="tns:Sequence">
    <xs:annotation>
      <xs:documentation source="dtolsma@descartes.com" xml:lang="en">The sequence element is intended to proof the completeness of a series of messages.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Created" type="xs:dateTime">
    <xs:annotation>
      <xs:documentation source="dtolsma@descartes.com" xml:lang="en">Date/time stamp of document creation. Preferably expressed in Universal Time Coordinated. Use to measure latency in delivery and processing</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="TestIndicator">
    <xs:annotation>
      <xs:documentation source="dtolsma@descartes.com" xml:lang="en">
        Indication of whether the content needs to be processed as a test message or as a production message. Often the test indicator is determined by the destination (i.e. service access point to which the document was submitted), this element however provides to option to override this behaviour.
        Supported values are 'P' for production and 'T' for test
      </xs:documentation>
    </xs:annotation>
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="P"/>
        <xs:enumeration value="T"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:element>
  <xs:element name="ExternalDocId" type="xs:string">
    <xs:annotation>
      <xs:documentation source="dtolsma@descartes.com" xml:lang="en">The External Document Identifier is a reference to the document as known in the sender environment</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="CorrelationId" type="xs:string">
    <xs:annotation>
      <xs:documentation source="dtolsma@descartes.com" xml:lang="en">The correlation identifier is a reference intended to correlate requests and responses to each other. Including the reference does not automatically guarantee the correlation id to be preserved, application support for correlation is often required to provide the correct value in the response</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="Sequence">
    <xs:annotation/>
    <xs:sequence>
      <xs:element name="MessageNumber" type="xs:integer">
        <xs:annotation>
          <xs:documentation source="dtolsma@descartes.com" xml:lang="en">The message number contains a monotonically incrementing range of integer numbers that establish an ordering between messages.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
