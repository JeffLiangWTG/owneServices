<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
	<PropertyGroup>
		<DeploymentProjectsPath>$(MsBuildThisFileDirectory)Bin\Deployment</DeploymentProjectsPath>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MsBuildThisFileDirectory)EDI-Release-private.snk</AssemblyOriginatorKeyFile>
		<!-- There is a bug with SCOM. When an assembly is built with Deterministic, SCOM agent crashes. It stops the app pool! This setting is disabled until the SCOM issue is resolved.
		<Deterministic>true</Deterministic>!-->
	</PropertyGroup>
</Project>