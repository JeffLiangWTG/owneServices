                            <om:Property Name="Expression" Value="logger.Log.DebugFormat(&quot;AddAttachment: Enter ({0})&quot;, index);&#xD;&#xA;&#xD;&#xA;nodeTemp = msgXml.CreateElement(&quot;string&quot;, &quot;http://schemas.microsoft.com/2003/10/Serialization/Arrays&quot;);&#xD;&#xA;nodeTemp.InnerText = (System.String)email[index].GetPartProperty(typeof(MIME.FileName));&#xD;&#xA;nodeNames.AppendChild(nodeTemp);&#xD;&#xA;&#xD;&#xA;nodeTemp = msgXml.CreateElement(&quot;string&quot;, &quot;http://schemas.microsoft.com/2003/10/Serialization/Arrays&quot;);&#xD;&#xA;nodeTemp.InnerText = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessagePartBase64String(email, index);&#xD;&#xA;nodeContents.AppendChild(nodeTemp);&#xD;&#xA;&#xD;&#xA;index = index + 1;&#xD;&#xA;&#xD;&#xA;logger.Log.DebugFormat(&quot;AddAttachment: Leave&quot;);" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
