                    <om:Element Type="VariableAssignment" OID="dbc261c8-b091-4185-b919-6fcb15808807" ParentLink="ComplexStatement_Statement" LowerBound="72.1" HigherBound="102.1">
                        <om:Property Name="Expression" Value="logger.Log.Debug(&quot;Initialise: Enter&quot;);&#xD;&#xA;&#xD;&#xA;msgXml.LoadXml(&quot;&lt;ImportEmail xmlns='http://www.wisetechglobal.com/sapphire/'&gt;&lt;incoming&gt;true&lt;/incoming&gt;&lt;from/&gt;&lt;to/&gt;&lt;cc/&gt;&lt;bcc/&gt;&lt;subject/&gt;&lt;sent/&gt;&lt;body/&gt;&lt;attachmentFileNames/&gt;&lt;attachmentBase64Contents/&gt;&lt;/ImportEmail&gt;&quot;);&#xD;&#xA;nodeTemp = msgXml.SelectSingleNode(&quot;//*[local-name()='from']&quot;);&#xD;&#xA;nodeTemp.InnerText = EmailMsg(POP3.From);&#xD;&#xA;nodeTemp = msgXml.SelectSingleNode(&quot;//*[local-name()='to']&quot;);&#xD;&#xA;nodeTemp.InnerText = EmailMsg(POP3.To);&#xD;&#xA;if (POP3.CC exists EmailMsg)&#xD;&#xA;{&#xD;&#xA;    nodeTemp = msgXml.SelectSingleNode(&quot;//*[local-name()='cc']&quot;);&#xD;&#xA;    nodeTemp.InnerText = EmailMsg(POP3.CC);&#xD;&#xA;}&#xD;&#xA;nodeTemp = msgXml.SelectSingleNode(&quot;//*[local-name()='subject']&quot;);&#xD;&#xA;nodeTemp.InnerText = EmailMsg(POP3.Subject);&#xD;&#xA;if (POP3.Date exists EmailMsg)&#xD;&#xA;{&#xD;&#xA;    nodeTemp = msgXml.SelectSingleNode(&quot;//*[local-name()='sent']&quot;);&#xD;&#xA;    sent = System.DateTime.Parse(EmailMsg(POP3.Date));&#xD;&#xA;    nodeTemp.InnerText = sent.ToString(&quot;s&quot;);&#xD;&#xA;}&#xD;&#xA;nodeTemp = msgXml.SelectSingleNode(&quot;//*[local-name()='body']&quot;);&#xD;&#xA;nodeTemp.InnerText = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(EmailMsg);&#xD;&#xA;&#xD;&#xA;nodeNames = msgXml.SelectSingleNode(&quot;//*[local-name()='attachmentFileNames']&quot;);&#xD;&#xA;nodeContents = msgXml.SelectSingleNode(&quot;//*[local-name()='attachmentBase64Contents']&quot;);&#xD;&#xA;&#xD;&#xA;email = EmailMsg;&#xD;&#xA;&#xD;&#xA;logger.Log.Debug(&quot;Initialise: Leave&quot;);&#xD;&#xA;" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Initialise" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="While" OID="2f3d856f-e3cf-498e-b71c-073ac086af35" ParentLink="ComplexStatement_Statement" LowerBound="102.1" HigherBound="120.1">
