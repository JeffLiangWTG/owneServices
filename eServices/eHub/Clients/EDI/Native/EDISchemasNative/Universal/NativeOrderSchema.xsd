<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Native" version="1.0" elementFormDefault="qualified" xmlns="http://www.cargowise.com/Schemas/Native" xmlns:cw="http://www.cargowise.com/Schemas/Native" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="NativeCommonSchema.xsd" />
  <xs:element name="Order">
    <xs:complexType>
      <xs:all>
        <xs:element name="JobOrderHeader" type="NativeOrder" />
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="NativeOrder">
    <xs:all>
      <xs:element name="OrderNumber" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="35" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="OrderDate" minOccurs="0" type="xs:dateTime" />
      <xs:element name="OrderGoodsDescription" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="35" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="TransportMode" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="3" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:all>
    <xs:attribute name="Action" type="Action" />
  </xs:complexType>
</xs:schema>