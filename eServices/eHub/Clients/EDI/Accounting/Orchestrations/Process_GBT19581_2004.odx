            activate ((CargoWise.eHub.Core.PropertySchemas.NextStep == "DistributeToRecipient") && (BTS.DestinationParty == "ChinaAccounting"))receive (ReceivePort.Operation, CN_GBT19581_2004);
            msgBodyBuilder = new System.Text.StringBuilder();
            attachmentFileName = "";
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("2ca4e977-25ed-449d-a507-0b76bfdff8e4")]
            construct Email
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("c150ac01-0748-465d-8654-6d9ef5a5d53d")]
                msgBodyBuilder = new System.Text.StringBuilder();
                msgBodyBuilder.AppendLine("<html><body><span style=\"font-family: calibri,arial,sans-serif\">");
                msgBodyBuilder.AppendLine("<pre>" + "Enclosed please find the mapped GBT19581_2004 file. You can open it with Notepad or other text file editors." + "</pre>");
                msgBodyBuilder.AppendLine("</span></body></html>");
                
                Email.EmailBody = new CargoWise.eHub.Core.PipelineComponents.Tools.RawString(msgBodyBuilder.ToString());
                Email.EmailBody(Microsoft.XLANGs.BaseTypes.ContentType) = "text/html";
                Email.Attachment = CN_GBT19581_2004;
                attachmentFileName = CN_GBT19581_2004(CargoWise.eHub.Core.PropertySchemas.OverrideFilename);
                attachmentFileName = attachmentFileName.Replace(".xml", ".txt");
                Email.Attachment(MIME.FileName) = attachmentFileName;
                
                Email(SMTP.Subject) = "Mapped GBT19581_2004 File - " + attachmentFileName;
                Email(SMTP.From) = "eHubNoReply@cargowise.com";
                Email(SMTP.EmailBodyFileCharset) = "UTF-8";
                
                Email(SMTP.MessagePartsAttachments) = 2;
                
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("68cf87ff-9a03-4375-976a-700dc0f9f80c")]
            SendPort(Microsoft.XLANGs.BaseTypes.Address) = "mailto:" + CN_GBT19581_2004(CargoWise.eHub.Core.PropertySchemas.OverrideEmailSubject);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("593765cf-9d5f-4fbc-9dd3-91976952310e")]
            [Microsoft.XLANGs.BaseTypes.Transaction(Retry=true,Batch=true,Timeout=60,TranIsolationLevel=System.Data.IsolationLevel.Serializable)]
            scope atomic transaction UpdateStatusTransaction
            {
                CargoWise.eHub.DataAccess.Integration.IOutboxAccessor OutboxAccessor;
                body
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("a675ff8b-fb5f-4ece-8e93-27966242802c")]
                    OutboxAccessor = CargoWise.eHub.DataAccess.Integration.DataAccessFactories.NewOutboxAccessorInstance();
                    OutboxAccessor.UpdateMessageDistributionStatus(
                                                CN_GBT19581_2004(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID), 
                                                CN_GBT19581_2004(BTS.SourceParty), 
