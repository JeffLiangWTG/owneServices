<xs:schema targetNamespace="http://www.cargowise.com/Schemas/Universal" version="1.0" elementFormDefault="qualified" xmlns="http://www.cargowise.com/Schemas/Universal" xmlns:cw="http://www.cargowise.com/Schemas/Universal" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="UniversalOrder" type="UniversalOrderData" />

  <xs:complexType name="UniversalOrderData">
    <xs:all>
      <xs:element name="Order" type="Order"/>
    </xs:all>
    <xs:attribute name="Version" type="xs:decimal" />
  </xs:complexType>

  <xs:complexType name="Order">
    <xs:all>
      <xs:element name="OrderNumber" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="35" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="OrderDate" minOccurs="0" type="xs:dateTime" />
      <xs:element name="OrderGoodsDescription" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="35" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="TransportMode" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="3" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:all>
  </xs:complexType>
</xs:schema>