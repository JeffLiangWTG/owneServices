<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://www.cargowise.com/Schemas/Universal/2011/11" xmlns:b="http://schemas.microsoft.com/BizTalk/2003" targetNamespace="http://www.cargowise.com/Schemas/Universal/2011/11" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:include schemaLocation="..\Schemas\UniversalTransactionBatch.xsd" />
  <xs:include schemaLocation="..\Schemas\UniversalTransaction.xsd" />
  <xs:include schemaLocation="..\Schemas\UniversalShipment.xsd" />
  <xs:include schemaLocation="..\Schemas\UniversalSchedule.xsd" />
  <xs:include schemaLocation="..\Schemas\UniversalEvent.xsd" />
  <xs:annotation>
    <xs:appinfo>
      <b:schemaInfo root_reference="UniversalInterchangeInclude" />
    </xs:appinfo>
  </xs:annotation>
  <xs:element name="UniversalInterchangeInclude">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="SenderID" type="xs:string" />
              <xs:element name="RecipientID" type="xs:string" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Body">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="UniversalEvent">
                <xs:complexType>
                  <xs:complexContent mixed="false">
                    <xs:extension base="UniversalEventData" />
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="UniversalSchedule">
                <xs:complexType>
                  <xs:complexContent mixed="false">
                    <xs:extension base="UniversalScheduleData" />
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="UniversalShipment">
                <xs:complexType>
                  <xs:complexContent mixed="false">
                    <xs:extension base="UniversalShipmentData" />
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="UniversalTransaction">
                <xs:complexType>
                  <xs:complexContent mixed="false">
                    <xs:extension base="UniversalTransactionData" />
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="UniversalTransactionBatch">
                <xs:complexType>
                  <xs:complexContent mixed="false">
                    <xs:extension base="UniversalTransactionBatchData" />
                  </xs:complexContent>
                </xs:complexType>
              </xs:element>
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>