					<xsd:element name="logisticServicesBuyer" type="TransactionalPartyType"/>
					<xsd:element minOccurs="0" name="billTo" type="TransactionalPartyType"/>
					<xsd:element maxOccurs="unbounded" minOccurs="0"
						name="transportInstructionShipment" type="TransportInstructionShipmentType"
					/>
				</xsd:sequence>
			</xsd:extension>
		</xsd:complexContent>
	</xsd:complexType>
	<xsd:simpleType name="TransportInstructionFunctionEnumerationType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CONSIGNMENT"/>
			<xsd:enumeration value="SHIPMENT"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="DocumentIdentification">
		<xsd:sequence>
