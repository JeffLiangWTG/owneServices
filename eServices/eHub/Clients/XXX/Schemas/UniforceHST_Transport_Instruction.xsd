		<xsd:sequence>
			<xsd:element ref="StandardBusinessDocumentHeader"/>
			<xsd:element maxOccurs="unbounded" name="transportInstruction"
				type="TransportInstructionType"/>
		</xsd:sequence>
	</xsd:complexType>
