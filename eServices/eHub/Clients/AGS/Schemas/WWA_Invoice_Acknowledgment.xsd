<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:element name="InvoiceAcknowledgement">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="InvoiceAcknowledgementEnvelope">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="SenderID" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ReceiverID" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="6"/>
                    <xs:maxLength value="100"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Password" nillable="false" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="6"/>
                    <xs:maxLength value="100"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Type" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Version" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="8"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="EnvelopeID" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="40"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="InvoiceAcknowledgementDetails">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="InvoiceNumber" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="25"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="HouseBillOfLadingNumber" nillable="true" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ArrivalNoticeNumber" nillable="true" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="InvoiceType" nillable="false">
                <xs:annotation>
                  <xs:documentation>"I" = Import, "E" = Export</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ReferenceType" nillable="false">
                <xs:annotation>
                  <xs:documentation>"1"=Container # "2"=MBL # "3"=HBL # "4"=Others
                                                </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="PayorReference" nillable="true">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="StatusCode" nillable="false">
                <xs:annotation>
                  <xs:documentation>"301" = BusinessAccept, "302" = BusinessPaid, "303" = BusinessReject, "304" = TechnicalReject,"305" = BusinessDisputed, "307" = TechnicalAccept</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="3"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="StatusDateTimeDetails">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Date" type="xs:date" nillable="false"/>
                    <xs:element name="Time" type="xs:time" nillable="false"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Description" nillable="true">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="100"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="InvoiceDate" nillable="false">
                <xs:simpleType>
                  <xs:restriction base="xs:date"></xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="InvoiceTime" nillable="true">
                <xs:simpleType>
                  <xs:restriction base="xs:time"></xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="UUID" nillable="true">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
