					<xs:documentation>Netto amount</xs:documentation>
					<xs:documentation>db field: eafako_t.rech_betrag</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VATInformation" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Contains information about VAT</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="VAT" minOccurs="0">
							<xs:annotation>
								<xs:documentation>VAT Code</xs:documentation>
								<xs:documentation>db field: eafako_t.fk_ust_sch</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Description" type="xs:string" minOccurs="0">
										<xs:annotation>
											<xs:documentation>Optional will not be processed</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="Codes" type="Codes" minOccurs="0"/>
									<xs:element name="VATRate" type="xs:double" minOccurs="0">
										<xs:annotation>
											<xs:documentation>VAT Rate in %</xs:documentation>
											<xs:documentation>db field: ust_tab.ust_proz_nto</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="VATAmount" type="Amounts" minOccurs="0">
							<xs:annotation>
								<xs:documentation>VAT amount</xs:documentation>
								<xs:documentation>db field: eafako_t.ust_betrag
</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
