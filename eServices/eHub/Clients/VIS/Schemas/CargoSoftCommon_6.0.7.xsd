	<xs:complexType name="Amounts">
		<xs:sequence>
			<xs:element name="Amount" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>For each currency one amount tag will be generated</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Currency" type="Currency" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Currency Code</xs:documentation>
								<xs:documentation>db_field: eafako_t.fk_wg_sch</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="Value" type="xs:double"/>
						<xs:element name="ExchangeRate" type="xs:double" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Based on the domestic currency</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="isDomesticCurrency" type="xs:boolean">
						<xs:annotation>
							<xs:documentation>Import: Will be ignored
Export: Will be set to true if the domesticCurrency will be exported</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Currency">
		<xs:sequence>
			<xs:element name="Description" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Optional will not be processed</xs:documentation>
