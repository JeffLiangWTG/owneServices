	<xs:element name="Message">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SenderID">
					<xs:annotation>
						<xs:documentation>Sender of the message</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="ReceiverID">
					<xs:annotation>
						<xs:documentation>Receiver of the message</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="30"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Timezone" minOccurs="0">
					<xs:annotation>
						<xs:documentation>MET, UTC, EST, ...</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageID" type="xs:string" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Unique id for this Message</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="MessageDate" type="DateTimeType">
					<xs:annotation>
						<xs:documentation>Date / time of preparation</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Provider" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CargoSoftDatabaseVersion" type="xs:string" minOccurs="0"/>
							<xs:element name="CargoServiceVersion" type="xs:string" minOccurs="0"/>
							<xs:element name="InterfaceRevisionNumber" type="xs:string" minOccurs="0"/>
							<xs:element name="InterfaceModificationDate" type="xs:string" minOccurs="0"/>
							<xs:element name="InterfaceModificationUser" type="xs:string" minOccurs="0"/>
							<xs:element name="InterfaceConfigurationHash" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Timezone" type="xs:string">
		<xs:annotation>
			<xs:documentation>MET, UTC, ...</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="DateTimeType">
		<xs:annotation>
			<xs:documentation>Single dateTime or seperated date/time values</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="DateTime" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>yyyy-mm-ddThh:mm:ss</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:sequence>
				<xs:element name="Date" type="xs:date">
					<xs:annotation>
						<xs:documentation>yyyy-mm-dd</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Time" type="xs:time" minOccurs="0">
					<xs:annotation>
						<xs:documentation>hh:mm:ss</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="AddressType">
