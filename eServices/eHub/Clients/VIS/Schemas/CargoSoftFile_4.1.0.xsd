									<xs:sequence>
										<xs:element ref="SenderID" minOccurs="0"/>
										<xs:element name="LineNumber" type="xs:integer" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Zeilenummer zum sortieren</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="Quantity" type="xs:integer">
											<xs:annotation>
												<xs:documentation>Kartonanzahl</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="Measureunit" minOccurs="0">
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:enumeration value="in"/>
													<xs:enumeration value="cm"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="Length" type="xs:decimal" minOccurs="0"/>
										<xs:element name="Height" type="xs:decimal" minOccurs="0"/>
										<xs:element name="Width" type="xs:decimal" minOccurs="0"/>
										<xs:element name="Upright" type="xs:string" minOccurs="0"/>
										<xs:element name="Stackable" type="xs:boolean" minOccurs="0"/>
										<xs:element name="Weight" type="xs:decimal" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Brutto</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="Volume" minOccurs="0">
											<xs:complexType>
												<xs:simpleContent>
													<xs:extension base="xs:decimal">
														<xs:attribute name="unit" type="xs:string">
															<xs:annotation>
																<xs:documentation>cbm, cuft</xs:documentation>
															</xs:annotation>
														</xs:attribute>
													</xs:extension>
												</xs:simpleContent>
											</xs:complexType>
										</xs:element>
										<xs:element name="ChargeableVolume" type="xs:decimal" minOccurs="0"/>
										<xs:element name="Charges" minOccurs="0">
											<xs:complexType>
