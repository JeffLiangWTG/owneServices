						</xs:extension>
					</xs:simpleContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="CountryCode" type="xs:string" minOccurs="0"/>
			<xs:element name="AdditionalFields" type="AdditionalFieldType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>CONDITION, LOADINGORDERNR, BOOKINGNR</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="Event">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Codes">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Code" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>CS Codes: DISPATCH,  
PICKUP, WAREHOUSE
POL_ARRIVAL, 
LOADING_START, LOADING_END, POL_DEPARTURE, POD_ARRIVAL, CLEARANCE_START, CLEARANCE_END, CONSTOMS_CLEARANCE, AVAILABLE, ACCEPTANCE, FINAL_DESTINATION</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="type">
												<xs:annotation>
													<xs:documentation>cs, foreign</xs:documentation>
												</xs:annotation>
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:enumeration value="cs"/>
														<xs:enumeration value="foreign"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:attribute>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Description" type="xs:string" minOccurs="0"/>
				<xs:element name="Location" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Codes" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Code" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>attr: type (unloc, iata, cs, foreign)</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:simpleContent>
													<xs:extension base="xs:string">
														<xs:attribute name="type" use="required">
															<xs:simpleType>
																<xs:restriction base="xs:string">
																	<xs:enumeration value="unloc"/>
																	<xs:enumeration value="iata"/>
																	<xs:enumeration value="cs"/>
																	<xs:enumeration value="foreign"/>
																</xs:restriction>
															</xs:simpleType>
														</xs:attribute>
													</xs:extension>
												</xs:simpleContent>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Name" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element ref="Timezone" minOccurs="0"/>
				<xs:element name="Estimated" minOccurs="0">
					<xs:complexType>
						<xs:complexContent>
							<xs:extension base="DateTimeType">
								<xs:sequence minOccurs="0">
									<xs:element name="From" minOccurs="0">
										<xs:complexType>
											<xs:complexContent>
												<xs:extension base="DateTimeType"/>
											</xs:complexContent>
										</xs:complexType>
									</xs:element>
									<xs:element name="To" minOccurs="0">
										<xs:complexType>
											<xs:complexContent>
												<xs:extension base="DateTimeType"/>
											</xs:complexContent>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:extension>
						</xs:complexContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="Actual" minOccurs="0">
					<xs:complexType>
						<xs:complexContent>
							<xs:extension base="DateTimeType">
								<xs:sequence minOccurs="0">
									<xs:element name="From" minOccurs="0">
										<xs:complexType>
											<xs:complexContent>
												<xs:extension base="DateTimeType"/>
											</xs:complexContent>
										</xs:complexType>
									</xs:element>
									<xs:element name="To" minOccurs="0">
										<xs:complexType>
											<xs:complexContent>
												<xs:extension base="DateTimeType"/>
											</xs:complexContent>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:extension>
						</xs:complexContent>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Container">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Number" type="xs:string"/>
				<xs:element name="SealNo" type="xs:string" minOccurs="0"/>
				<xs:element name="SealNo2" type="xs:string" minOccurs="0"/>
				<xs:element name="SealNo3" type="xs:string" minOccurs="0"/>
				<xs:element name="SealedBy" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="2"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Size" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Code" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>attr: type (iso, cs, foreign)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="type" use="required">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:enumeration value="iso"/>
														<xs:enumeration value="cs"/>
														<xs:enumeration value="foreign"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:attribute>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Full" type="xs:boolean" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Voll/Leer Kennzeichen aus TMS. Wenn 1 dann voll.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SuppliedBy" minOccurs="0">
					<xs:annotation>
						<xs:documentation>V = Versender, F = Frachtführer</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Code" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>attr: type (iso, cs, foreign)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="type" use="required">
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:enumeration value="iso"/>
														<xs:enumeration value="cs"/>
														<xs:enumeration value="foreign"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:attribute>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Incoterm" type="xs:string" minOccurs="0"/>
				<xs:element name="Temperature" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Temperature of the Container. Unit specifies whether the temp is given in Celsius or Fahrenheit</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence minOccurs="0">
							<xs:element name="Actual" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:decimal">
										<xs:fractionDigits value="3"/>
										<xs:totalDigits value="8"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="RangeFrom" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:decimal">
										<xs:totalDigits value="8"/>
										<xs:fractionDigits value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="RangeTo" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:decimal">
										<xs:totalDigits value="8"/>
										<xs:fractionDigits value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:sequence minOccurs="0" maxOccurs="99">
								<xs:element name="TemperatureText" minOccurs="0">
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:maxLength value="80"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:sequence>
						</xs:sequence>
						<xs:attribute name="unit">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="F"/>
									<xs:enumeration value="C"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
				<xs:element name="PreCarriage" minOccurs="0">
					<xs:complexType>
						<xs:sequence minOccurs="0">
							<xs:element name="CarriageNumber" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="40"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="DeliveryDate" type="xs:dateTime" minOccurs="0"/>
							<xs:element name="ExportDate" type="xs:dateTime" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="OnCarriage" minOccurs="0">
					<xs:complexType>
						<xs:sequence minOccurs="0">
							<xs:element name="ModeOfTransportCode" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Code" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>attr: type (iso, cs, foreign)</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:simpleContent>
													<xs:extension base="xs:string">
														<xs:attribute name="type" use="required">
															<xs:simpleType>
																<xs:restriction base="xs:string">
																	<xs:enumeration value="iso"/>
																	<xs:enumeration value="cs"/>
																	<xs:enumeration value="foreign"/>
																</xs:restriction>
															</xs:simpleType>
														</xs:attribute>
													</xs:extension>
												</xs:simpleContent>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ModeOfTransportText" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="40"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="NumberPlate" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="40"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="AirFlow" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Indicates also if Ventilation is required</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:decimal">
							<xs:totalDigits value="8"/>
							<xs:fractionDigits value="3"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Humidity" minOccurs="0">
					<xs:simpleType>
						<xs:restriction base="xs:decimal">
							<xs:totalDigits value="8"/>
							<xs:fractionDigits value="3"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TaraWeight" minOccurs="0">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:decimal">
								<xs:attribute name="unit" use="optional">
									<xs:annotation>
										<xs:documentation>KGM, LBS</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:enumeration value="KGM"/>
											<xs:enumeration value="LBS"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="Fumigation" type="xs:boolean" minOccurs="0"/>
				<xs:element name="Unpacking" type="xs:boolean" minOccurs="0"/>
				<xs:element name="GrossWeight" minOccurs="0">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:decimal">
								<xs:attribute name="unit" use="optional">
									<xs:annotation>
										<xs:documentation>KGM, LBS</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:enumeration value="KGM"/>
											<xs:enumeration value="LBS"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element ref="SenderID" minOccurs="0"/>
				<xs:element name="Events" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Event" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="AddressReferences" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="AddressReference" type="xs:int" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Reference to the address id from above</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Addresses" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Address" type="AddressType" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="AdditionalFields" type="AdditionalFieldType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>RELEASENUMBER, RELEASEPASSWORD, ORIGINCOUNTRY, DESTINATIONCOUNTRY, MESSAGEREFERENCE, REDELIVERYREFERENCE
BOOKINGNR</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ShippersOwned" type="xs:boolean" minOccurs="0"/>
				<xs:element name="NetWeight" minOccurs="0">
					<xs:complexType>
						<xs:simpleContent>
							<xs:extension base="xs:decimal">
								<xs:attribute name="unit" use="optional">
									<xs:annotation>
										<xs:documentation>KGM, LBS</xs:documentation>
									</xs:annotation>
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:enumeration value="KGM"/>
											<xs:enumeration value="LBS"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:attribute>
							</xs:extension>
						</xs:simpleContent>
					</xs:complexType>
				</xs:element>
				<xs:element name="Remarks" type="Remarks" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Good">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SenderID" minOccurs="0"/>
				<xs:element name="Marks" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="Packaging" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Quantity" type="xs:int" minOccurs="0"/>
							<xs:element name="Code" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>attr: type (cs, foreign)</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:simpleContent>
										<xs:extension base="xs:string">
											<xs:attribute name="type" use="required">
												<xs:annotation>
													<xs:documentation>cs, un, iso, foreign</xs:documentation>
												</xs:annotation>
												<xs:simpleType>
													<xs:restriction base="xs:string">
														<xs:enumeration value="cs"/>
														<xs:enumeration value="foreign"/>
														<xs:enumeration value="un"/>
														<xs:enumeration value="iso"/>
													</xs:restriction>
												</xs:simpleType>
											</xs:attribute>
										</xs:extension>
									</xs:simpleContent>
								</xs:complexType>
							</xs:element>
							<xs:element name="Description" type="xs:string" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="PackageInformations" minOccurs="0">
