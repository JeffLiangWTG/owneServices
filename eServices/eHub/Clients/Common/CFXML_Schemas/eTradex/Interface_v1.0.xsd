<?xml version="1.0" encoding="utf-8"?>
<!--
GTS Interface Schema:
Defines a list data elements to control integration on EXRILO V3 Messages.

(C) eTradex (Pty) Ltd
Last Updated: 03 February 2014
Last Updated By: Anton Eccles
-->
<xs:schema targetNamespace="http://schemas.exrilov3.com/Interface_v1.0.xsd"
    elementFormDefault="qualified"
    xmlns:interface="http://schemas.exrilov3.com/Interface_v1.0.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>

  <xs:complexType name="InterfaceHeader">
    <xs:sequence>
      <xs:element type="xs:token" name="Name" minOccurs="1" maxOccurs="1"/>
      <xs:element type="xs:dateTime" name="DateTimeCreated" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IntefaceFooter">
    <xs:sequence>
      <xs:element name="NumberOfRecords" type="xs:unsignedInt" minOccurs="1" maxOccurs="1" />
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="InterfaceAction">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Insert"/>
      <xs:enumeration value="Update"/>
      <xs:enumeration value="Delete"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MessageType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Error"/>
      <xs:enumeration value="Warning"/>
      <xs:enumeration value="Sucess"/>
      <xs:enumeration value="Authorisation"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="MessageList">
    <xs:sequence>
      <xs:element type="interface:Message" name="Message" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="Message">
    <xs:sequence>
      <xs:element type="xs:string" name="Message" minOccurs="1" maxOccurs="1"/>
      <xs:element type="interface:MessageType" name="MessageType" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RecordStatusList">
    <xs:sequence>
      <xs:element type="interface:RecordStatus" name="RecordStatus" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RecordStatus">
    <xs:sequence>
      <xs:element type="xs:boolean" name="Success" minOccurs="1" maxOccurs="1"/>
      <xs:element type="xs:token" name="OwnerEntityCode" minOccurs="0" maxOccurs="1"/>
      <xs:element type="xs:token" name="UniqueCode" minOccurs="0" maxOccurs="1"/>
      <xs:element type="interface:MessageList" name="MessageList" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="InterfaceResponse">
    <xs:sequence>
      <xs:element type="xs:boolean" name="Success" minOccurs="1" maxOccurs="1"/>
      <xs:element type="interface:RecordStatusList" name="RecordStatusList" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="EV3InterfaceResponse" type="interface:InterfaceResponse"/>

</xs:schema>
