<Window x:Class="eHubDeploymentTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:eHubDeploymentTools.Controls"
        Title="eHub Deployment Tools" Height="511" Width="843" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" Icon="icon.ico">

    <Window.Resources>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100px" />
            <Setter Property="Height" Value="30px" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

    </Window.Resources>

    <Grid>
        <DockPanel Name="MainPanel">
            <DockPanel DockPanel.Dock="Bottom" Name="ButtonPanel">
                <Button DockPanel.Dock="Left" Name="CloseButton" Content="Close" Click="CloseButton_Click"></Button>
                <Button DockPanel.Dock="Right" Name="RunButton" Click="RunButton_Click">Run</Button>
                <StackPanel></StackPanel>
            </DockPanel>
            <Border BorderThickness="0,0,0,1" BorderBrush="Black">
                <DockPanel Name="BodyPanel" >
                    <Border BorderThickness="0,0,1,0" BorderBrush="Black" Background="LightGray">
                    <controls:Navigation x:Name ="TaskNavigation" DockPanel.Dock="Left" Width="200px"/>
                    </Border>
                    <Border BorderThickness="0,0,1,0" BorderBrush="Black">
                        <controls:Task x:Name ="TaskManager" Width="Auto"/>
                    </Border>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
