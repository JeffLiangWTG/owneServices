
<Project DefaultTargets="DeployBtsSolutionDev" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\ExtensionPack\MSBuild.ExtensionPack.tasks"/>
  <Import Project="$(MSBuildExtensionsPath)\MSBuildCommunityTasks\MSBuild.Community.Tasks.Targets"/>

  <!--Settings-->
  <PropertyGroup>
    <BtsInstallLocation>c:\Program Files (x86)\Microsoft BizTalk Server 2013 R2</BtsInstallLocation>
    <MSSQLDataLocation>C:\Program Files\Microsoft SQL Server\MSSQL10_50.MSSQLSERVER\MSSQL\DATA</MSSQLDataLocation>
    <DatabaseBackupLocation>C:\Backups\Biztalk</DatabaseBackupLocation>
    <GacUtilFilePath>c:\Program Files (x86)\Microsoft SDKs\Windows\v7.0A\Bin\NETFX 4.0 Tools\x64\gacutil.exe</GacUtilFilePath>

    <BizTalkMachineName>SYD-WIKB-1</BizTalkMachineName>
    <BinPath>C:\eServices\eHub\bin</BinPath>
    <DevBindingBasePath>c:\eServices\eHub\Bin\Bindings</DevBindingBasePath>
    <MSIBasePath>c:\eServices\eHub\Bin\Msi</MSIBasePath>

    <ConnectionString>Server=SYD-WIKB-1;Integrated Security=True</ConnectionString>
    <eHubDBName>eHubTransactions</eHubDBName>
    <eHubDBSqlScriptFile>C:\eServices\eHub\DataAccess\Sql\eHubTransactions.sql</eHubDBSqlScriptFile>
  </PropertyGroup>

  <ItemGroup>
    <SqlScriptFiles Include="$(eHubDBSqlScriptFile)"/>
  </ItemGroup>

  <ItemGroup>
    <DataBaseList Include ="BizTalkDTADb">
      <BackupName>BizTalkDTADb.bak</BackupName>
    </DataBaseList>
    <DataBaseList Include ="BizTalkMgmtDb">
      <BackupName>BizTalkMgmtDb.bak</BackupName>
    </DataBaseList>
    <DataBaseList Include ="BizTalkMsgBoxDb">
      <BackupName>BizTalkMsgBoxDb.bak</BackupName>
    </DataBaseList>
    <DataBaseList Include ="BizTalkRuleEngineDb">
      <BackupName>BizTalkRuleEngineDb.bak</BackupName>
    </DataBaseList>
  </ItemGroup>

  <!--Applications-->
  <ItemGroup>
    <BtsApplicationList Include="CargoWise.eHub"/>
  </ItemGroup>

  <!-- Bindings -->
  <ItemGroup>
    <DevBindingList Include ="CargoWise.eHub.Core.BindingInfo.LOCAL.xml">
      <Application>CargoWise.eHub</Application>
    </DevBindingList>
    <DevBindingList Include ="CargoWise.eHub.Gateway.BindingInfo.LOCAL.xml">
      <Application>CargoWise.eHub</Application>
    </DevBindingList>
    <DevBindingList Include ="CargoWise.eHub.AlertService.BindingInfo.xml">
      <Application>CargoWise.eHub</Application>
    </DevBindingList>
  </ItemGroup>

  <!--Pipelines Components Dev Only-->
  <ItemGroup>
    <PipelineComponentsAssemblyListDevOnly Include="CargoWise.eHub.Core.PipelineComponents.dll"/>
    <PipelineComponentsAssemblyListDevOnly Include="CargoWise.eHub.AlertService.PipelineComponents.dll"/>
  </ItemGroup>

