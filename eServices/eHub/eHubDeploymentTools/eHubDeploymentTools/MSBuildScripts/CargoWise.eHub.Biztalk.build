  <!-- Run Targets -->
  <Target Name="Clean">
    <CallTarget Targets="StopApplication"/>
    <CallTarget Targets="DeletingApplication"/>
    <CallTarget Targets="RemoveGacAssemblyDevOnly"/>
  </Target>


  <Target Name="DeployBtsSolutionDev">
    <CallTarget Targets="Clean"/>
    <CallTarget Targets="CreateApplication"/>
    <CallTarget Targets="CopyPipelineComponentsDelvelpmentOnnly"/>
    <CallTarget Targets="AddGacAssemblyDevOnly"/>
    <CallTarget Targets="DeployBtsResources"/>
    <CallTarget Targets="DeployDevBindings" />
    <CallTarget Targets="StartApplication" />
  </Target>


  <!-- Task Private Targets -->
  <Target Name="StopApplication">
    <MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="StopAll" Applications="@(BtsApplicationList)" MachineName="$(BizTalkMachineName)" />
  </Target>

  <Target Name="StartApplication">
    <MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="StartAll" Applications="@(BtsApplicationList)" MachineName="$(BizTalkMachineName)"/>
  </Target>


  <Target Name="DeletingApplication">
    <MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="Delete" Applications="@(BtsApplicationList)" MachineName="$(BizTalkMachineName)" />
  </Target>
  <Target Name="CreateApplication">
    <MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="Create" Applications="@(BtsApplicationList)" MachineName="$(BizTalkMachineName)" Force="true" />
  </Target>

  <Target Name="AddResourceReference">
    <MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="AddReference"  Application="%(BtsResourceAssemplyReferenceList.Identity)" MachineName="$(BizTalkMachineName)" References="%(BtsResourceAssemplyReferenceList.Reference)" Force="true"/>
  </Target>

  <Target Name="DeployBtsResources">
    <MSBuild.ExtensionPack.BizTalk.BizTalkAssembly TaskAction="Add" Assemblies="$(BinPath)\%(BtsResourceAssemplyList.Identity)" Application="%(BtsResourceAssemplyList.Application)" MachineName="$(BizTalkMachineName)" Gac="false" Force="true"/>
  </Target>

  <Target Name="DeployDevBindings">
    <Exec Command ='"$(BtsInstallLocation)\BTSTask" ImportBindings /Source:"$(DevBindingBasePath)\%(DevBindingList.Identity)" /ApplicationName:%(DevBindingList.Application)' />
  </Target>

  <Target Name="ExportMsi">
    <Exec Command ='"$(BtsInstallLocation)\BTSTask" ExportApp /ApplicationName:%(BtsApplicationList.Identity) /Package:"$(MSIBasePath)\%(BtsApplicationList.Identity).msi"' />
  </Target>

  <!--Developemnt Only Targets-->
  <Target Name="CopyPipelineComponentsDelvelpmentOnnly">
    <Copy SourceFiles="$(BinPath)\%(PipelineComponentsAssemblyListDevOnly.Identity)" DestinationFolder="$(BtsInstallLocation)\Pipeline Components" />
  </Target>

  <Target Name="RemoveGacAssemblyDevOnly">
    <Exec Command="%22$(GacUtilFilePath)%22 -u %(GacAssemplyList.AssemblyName) /f /nologo" IgnoreExitCode="true"/>
  </Target>

  <Target Name="AddGacAssemblyDevOnly">
    <Exec Command="%22$(GacUtilFilePath)%22 -i $(BinPath)\%(GacAssemplyList.Identity) /f /nologo" IgnoreExitCode="true"/>
  </Target>

  <Target Name="CreateeHubTransactionDB">
    <MSBuild.ExtensionPack.Sql2008.Database TaskAction="CheckExists" DatabaseItem="$(eHubDBName)">
      <Output TaskParameter="Exists" PropertyName="DoesExist"/>
    </MSBuild.ExtensionPack.Sql2008.Database>
    <Message Text="Database Exists: $(DoesExist)"/>
    <MSBuild.ExtensionPack.Sql2008.Database TaskAction="Delete" DatabaseItem="$(eHubDBName)" Condition="$(DoesExist)==true"/>
    <MSBuild.ExtensionPack.Sql2008.Database TaskAction="Create" DatabaseItem="$(eHubDBName)"/>
    <MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Retry="true" UseTransaction="true" Files="@(SqlScriptFiles)" ConnectionString="$(ConnectionString)"/>
  </Target>

  <Target Name="RestoreBiztalkDB">
    <MSBuild.ExtensionPack.Sql2008.Database TaskAction="Restore" DatabaseItem="%(DataBaseList.Identity)" DataFilePath="$(DatabaseBackupLocation)\%(DataBaseList.BackupName)" NewDataFilePath="$(MSSQLDataLocation)\%(DataBaseList.Identity).mdf" LogFilePath="$(MSSQLDataLocation)\%(DataBaseList.Identity)_log.ldf" ReplaceDatabase="True"/>
  </Target>

</Project>
