<?xml version="1.0" encoding="utf-8" ?>
<mvcSiteMap xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="http://mvcsitemap.codeplex.com/schemas/MvcSiteMap-File-4.0"
            xsi:schemaLocation="http://mvcsitemap.codeplex.com/schemas/MvcSiteMap-File-4.0 MvcSiteMapSchema.xsd">
  <mvcSiteMapNode title="Home" controller="Home" action="Index">

    <mvcSiteMapNode title="Setup" controller="Home" action="Setup">

      <mvcSiteMapNode title="Transformation Sets" controller="TransformationSet" action="Index" >
        <mvcSiteMapNode title="Create" action="Create"/>
        <mvcSiteMapNode title="Details" action="Details"/>
        <mvcSiteMapNode title="Edit" action="Edit"/>
        <mvcSiteMapNode title="Delete" action="Delete"/>
      </mvcSiteMapNode>

      <mvcSiteMapNode controller="CodeMapping" action="Index" title="Code Mapping"/>

      <mvcSiteMapNode controller="Client" action="Index" title="Clients">
        <mvcSiteMapNode action="DetailsModal" title="Client Details"/>
        <mvcSiteMapNode action="Create" title="Create"/>
        <mvcSiteMapNode action="CreateModal" title="Create Client"/>
        <mvcSiteMapNode title="Details" action="Details"/>
        <mvcSiteMapNode title="Edit" action="Edit"/>
		<mvcSiteMapNode title="Delete" action="Delete"/>
		<mvcSiteMapNode title="Client Authorisations" action="IntegrationAccountAuthorisations"/>
      </mvcSiteMapNode>

		<mvcSiteMapNode controller="AsyncPollingRegistrations" action="Index" title="Async Polling Registrations"/>
      <mvcSiteMapNode controller="ClientRegistrations" action="Index" title="Client Registrations"/>
      <mvcSiteMapNode controller="ClientSystemRegistrations" action="Index" title="Client System Registrations"/>

      <mvcSiteMapNode controller="ClientCertificates" action="Index" title="Client Certificates"/>

      <mvcSiteMapNode controller="MessageType" action="Index" title="Message Types">
        <mvcSiteMapNode action="DetailsModal" title="Edit Message Type"/>
        <mvcSiteMapNode action="EditModal" title="Edit Message Type"/>
        <mvcSiteMapNode action="Details" title="Details"/>
        <mvcSiteMapNode action="Edit" title="Edit"/>
      </mvcSiteMapNode>

      <mvcSiteMapNode controller="Service" action="Index" title="Airline Messaging">
        <mvcSiteMapNode action="Delete" title="Delete"/>
        <mvcSiteMapNode controller="Service" action="Details" title="Details">
          <mvcSiteMapNode controller="ClientPIMA" action="Index" title="PIMA Management">
            <mvcSiteMapNode controller="ClientPIMA" action="Edit" title="PIMA Edit"/>
          </mvcSiteMapNode>
          <mvcSiteMapNode controller="MessageRouting" action="Index" title="Message Routing">
            <mvcSiteMapNode controller="MessageRouting" action="EditClientProvider" title="Edit Client Provider"/>
            <mvcSiteMapNode controller="MessageRouting" action="EditMessageTypeProvider" title="Edit MessageType Provider"/>
            <mvcSiteMapNode controller="MessageRouting" action="EditAirlineProvider" title="Edit Airline Provider"/>
          </mvcSiteMapNode>
        </mvcSiteMapNode>
      </mvcSiteMapNode>

      <mvcSiteMapNode controller="OceanCarrierMessaging" action="Index" title="Ocean Carrier Messaging"/>
        
      <mvcSiteMapNode controller="USCustoms" action="Index" title="US Customs">
        <mvcSiteMapNode action="AddClient" title="Quick Add New Client"/>
      </mvcSiteMapNode>
      <mvcSiteMapNode controller="ITCustoms" action="Index" title="IT Customs Job Status"/>
      <mvcSiteMapNode controller="ZACustoms" action="Index" title="ZA Customs"/>

      <mvcSiteMapNode controller="Subscriptions" action="Index" title="Subscriptions"/>

      <mvcSiteMapNode controller="BroadcastSubscriptions" action="Index" title="Broadcast Subscriptions"/>

      <mvcSiteMapNode controller="eHubMessageReference" action="Index" title="eHub Message Reference"/>
      
      <mvcSiteMapNode controller="ServiceProvider" action="Index" title="Client Provided Services"/>
      
    </mvcSiteMapNode>
  </mvcSiteMapNode>

</mvcSiteMap>