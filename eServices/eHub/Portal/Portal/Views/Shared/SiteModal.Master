<%@ Master Language="C#" Inherits="System.Web.Mvc.ViewMasterPage" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="description" content="CargoWise"/>
    <meta name="keywords" content="CargoWise"/>
    <meta name="robots" content="index,all"/>
    <meta name="classification" content="software"/>
    <meta name="author" content="CargoWise"/>

    <title><%=Html.MvcSiteMap().SiteMapTitle() %></title>

    <link rel="SHORTCUT ICON" href="<%:Url.Content("~/Content/Images/favicon.ico")%>"/>
    <link href="<%:Url.Content("~/Content/Main.css")%>" rel="stylesheet" type="text/css" media="screen" />
    <link href="<%:Url.Content("~/Content/Site.css")%>" rel="stylesheet" type="text/css" media="screen" />
    <link href="<%:Url.Content("~/PlugIns/jQueryUI/1.8.9/jquery-ui.css")%>" rel="stylesheet" type="text/css" media="screen" />
    <script src="<%:Url.Content("~/Scripts/jquery-1.4.4.js")%>" type="text/javascript"></script>
    <script src="<%:Url.Content("~/PlugIns/jQueryUI/1.8.9/jquery-ui.min.js")%>" type="text/javascript"></script>
    <% if (false) {%> <script src="/Scripts/jquery-1.4.4-vsdoc.js" type="text/javascript"></script> <%} %>
    <asp:ContentPlaceHolder ID="HeaderContent" runat="server" />
</head>
<body>
    <div id="modalContent">
        <h2><%=Html.MvcSiteMap().SiteMapTitle() %></h2>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
