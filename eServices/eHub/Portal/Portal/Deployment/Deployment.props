<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
    <_DeploymentPropsImported>$true</_DeploymentPropsImported>
		<_SiteName>Default Web Site</_SiteName>
		<_ServiceName></_ServiceName>
    <_AnonymousAuthenticationEnabled>true</_AnonymousAuthenticationEnabled>
    <_WindowsAuthenticationEnabled>true</_WindowsAuthenticationEnabled>
    <_BackupFolder>c:\eHubPortal_backup</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
		<_ServicePackagePath>$(PackageFileName)</_ServicePackagePath>
	</PropertyGroup>
	<ItemGroup>
		<_Binding Include="1">
			<IPAddress>*</IPAddress>
			<Port>443</Port>
			<Protocol>https</Protocol>
			<HostHeader></HostHeader>
		</_Binding>
	</ItemGroup>
</Project>
