  <logger name="OCMCsvLogger" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="OCMCsv" />
  </logger>
  <logger name="ClientCertificatesLogger" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="ClientCertificates" />
  </logger>
	<logger name="AsyncPollingRegistrationsLogger" additivity="false">
		<level value="DEBUG" />
		<appender-ref ref="AsyncPollingRegistrations" />
	</logger>
  <logger name="ClientRegistrationsLogger" additivity="false">
    <level value="DEBUG" />
    <appender-ref ref="ClientRegistrations" />
  </logger>
  <logger name="ClientSystemRegistrationsLogger" additivity="false">
