<?xml version="1.0" encoding="utf-8"?>
<log4net>
  <appender name="OCMCsv" type="log4net.Appender.RollingFileAppender">
    <file value="logs/OCM/OCMCsv.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="100" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <threshold value="DEBUG" />
  </appender>
  <appender name="OCMSaving" type="log4net.Appender.RollingFileAppender">
    <file value="logs/OCM/OCMSaving.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="100" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <filter type="log4net.Filter.LoggerMatchFilter">
      <LoggerToMatch value="CargoWise.eHub.Portal.Models.View.OceanCarrierMessaging.IOceanCarrierMessagingType" />
    </filter>
    <filter type="log4net.Filter.DenyAllFilter" />
    <threshold value="DEBUG" />
  </appender>
  <appender name="ClientCertificates" type="log4net.Appender.RollingFileAppender">
    <file value="logs/Portal/ClientCertificates.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maxSizeRollBackups value="100" />
    <maximumFileSize value="10MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%4thread] %-5level - %message%newline" />
    </layout>
    <threshold value="DEBUG" />
  </appender>
	<appender name="AsyncPollingRegistrations" type="log4net.Appender.RollingFileAppender">
		<file value="logs/Portal/AsyncPollingRegistrations.log" />
		<appendToFile value="true" />
		<rollingStyle value="Size" />
		<maxSizeRollBackups value="100" />
		<maximumFileSize value="10MB" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%4thread] %-5level - %message%newline" />
		</layout>
		<threshold value="DEBUG" />
	</appender>
  <appender name="ClientRegistrations" type="log4net.Appender.RollingFileAppender">
