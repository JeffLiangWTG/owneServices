<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>WiseTech Global Pty Ltd</Company>
    <Product>eHub</Product>
    <Copyright>© Copyright WiseTech Global</Copyright>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <AssemblyFileVersion>3.0.0.0</AssemblyFileVersion>
    <OutputPath>..\..\Bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <Import Project="..\..\packages\NUnit3TestAdapter\build\net462\NUnit3TestAdapter.props" Condition="Exists('..\..\packages\NUnit3TestAdapter\build\net462\NUnit3TestAdapter.props')" />
  <Import Project="..\..\packages\NUnit\build\NUnit.props" Condition="Exists('..\..\packages\NUnit\build\NUnit.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Integration\CargoWise.eHub.DataAccess.Integration.csproj" />
    <ProjectReference Include="..\Sql\CargoWise.eHub.DataAccess.Sql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CargoWise.eHub.Common">
      <HintPath>..\..\Bin\CargoWise.eHub.Common.dll</HintPath>
    </Reference>
    <Reference Include="CargoWise.eHub.Integration">
      <HintPath>..\..\Bin\CargoWise.eHub.Integration.dll</HintPath>
    </Reference>
    <Reference Include="nunit.framework">
      <SpecificVersion>false</SpecificVersion>
      <HintPath>..\..\Bin\nunit.framework.dll</HintPath>
    </Reference>
    <Reference Include="Moq">
      <SpecificVersion>false</SpecificVersion>
      <HintPath>..\..\Bin\Moq.dll</HintPath>
    </Reference>
    <Reference Include="eServices.eHubDataAccess.Integration">
      <SpecificVersion>false</SpecificVersion>
      <HintPath>..\..\Bin\eServices.eHubDataAccess.Integration.dll</HintPath>
    </Reference>
    <Reference Include="eServices.eHubDataAccess.Sql">
      <SpecificVersion>false</SpecificVersion>
      <HintPath>..\..\Bin\eServices.eHubDataAccess.Sql.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.BizTalk.Pipeline, Version=3.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35, processorArchitecture=MSIL">
      <HintPath>$(BTSINSTALLPATH)Microsoft.BizTalk.Pipeline.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>