                    <om:Element Type="DNFPredicate" OID="3fbd1558-afe0-4d8b-8613-6a16714241e1" ParentLink="Receive_DNFPredicate">
                        <om:Property Name="LHS" Value="CargoWise.eHub.Core.PropertySchemas.NextStep" />
                        <om:Property Name="RHS" Value="&quot;SendToAlertOrchestration&quot;" />
                        <om:Property Name="Grouping" Value="AND" />
                        <om:Property Name="Operator" Value="Equals" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                </om:Element>
                <om:Element Type="Scope" OID="69d5bf85-c8ed-4976-b856-91d95700a5d2" ParentLink="ServiceBody_Statement" LowerBound="78.1" HigherBound="315.1">
                    <om:Property Name="InitializedTransactionType" Value="True" />
                    <om:Property Name="IsSynchronized" Value="False" />
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="Start" />
                    <om:Property Name="Signal" Value="True" />
