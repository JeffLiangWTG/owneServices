[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module CargoWise.eHub.AlertService.Orchestrations
{
    internal messagetype EmailType
    {
        body CargoWise.eHub.Core.PipelineComponents.Tools.RawString EmailBody;
    };
    internal porttype ReadErrorFromDBPortType
    {
        oneway Operation_1
        {
            CargoWise.eHub.AlertService.Schemas.AlertData
        };
    };
    internal porttype SMTPAlertPortType
    {
        oneway Operation_1
        {
            EmailType
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service ErrorAlerter
    {
        [Microsoft.XLANGs.BaseTypes.PhysicalBinding(typeof(Microsoft.BizTalk.DefaultPipelines.PassThruTransmit))]
        port uses dynamic SMTPAlertPortType SMTPAlertPort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements ReadErrorFromDBPortType ReadErrorFromDBPort;
        message EmailType Email;
        message CargoWise.eHub.AlertService.Schemas.AlertData AlertData;
        CargoWise.eHub.Core.Logging.OrchestrationLogger logger;
        System.Exception exceptionForEmailRecipientsTooLong;
        System.String emailRecipients;
        System.Boolean hasIssue;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1d78b49a-6ee7-45f2-ab62-18fca2d524ed")]
            activate receive (ReadErrorFromDBPort.Operation_1, AlertData);
            logger = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
            exceptionForEmailRecipientsTooLong = new System.Exception();
            emailRecipients = "";
            hasIssue = true;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("0a816e08-240a-49d1-89c9-873a3bad50c4")]
            logger.Log.Info("ErrorPK: " + AlertData.ErrorPK + ", Recipients List: " + AlertData.EmailRecipients);
            
            emailRecipients = System.Convert.ToString(AlertData.EmailRecipients);
            
            hasIssue = emailRecipients.Contains("EHUB.ISSUE;");
            emailRecipients = emailRecipients.Replace("EHUB.ISSUE;", "");
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("957f187e-7ce8-44a2-80da-0b7ebafd37a8")]
            parallel
            {
                task
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("4b752e93-6856-4ede-bca5-3b0933e6554f")]
                    scope
                    {
                        CargoWise.eHub.Core.Logging.OrchestrationLogger issueLog;
                        body
                        {
                            issueLog = new CargoWise.eHub.Core.Logging.OrchestrationLogger();
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("886c52e0-c283-4de2-ac1a-b2bf2006a7b3")]
                            if (hasIssue)
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("898cda06-665e-4e3a-89cc-515234d45831")]
                                CargoWise.eHub.AlertService.Helpers.OrchestrationHelper.ReportAlertToIssueManager(
                                    issueLog.Log,
                                    AlertData.ErrorPK,  
                                    AlertData.MessageTrackingID,  
                                    AlertData.ReceivedDateTimeUTC, 
                                    AlertData.DateTimeUTC, 
                                    AlertData.Sender, 
                                    AlertData.Recipient, 
                                    AlertData.Source, 
                                    AlertData.ErrorMessage
                                );
                            }
                        }
                    }
                }
                task
                {
                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("e3763c82-f71a-475c-9323-4c96f8acb092")]
                    scope
                    {
                        System.Text.StringBuilder msgBody;
                        body
                        {
                            msgBody = new System.Text.StringBuilder();
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("601d5311-b1e8-41a8-a992-551e4bac259f")]
                            if ((emailRecipients.Length >= 3) && (emailRecipients.Length < 1024))
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("a2f59160-a0c3-45a8-bdfb-d1bdcf738563")]
                                msgBody = new System.Text.StringBuilder();
                                msgBody.AppendLine("<html><body><span style=\"font-family: calibri,arial,sans-serif\">");
                                msgBody.AppendLine("Server Name: <i>" + System.Environment.MachineName + "</i><br/>");
                                msgBody.AppendLine("eHub Message Tracking ID: <i>" + AlertData.MessageTrackingID + "</i><br/>");
                                msgBody.AppendLine("Received From Sender UTC: <i>" + System.Convert.ToString(AlertData.ReceivedDateTimeUTC)  + "</i><br/>");
                                msgBody.AppendLine("Error Time UTC: <i>" + System.Convert.ToString(AlertData.DateTimeUTC)  + "</i><br/>");
                                msgBody.AppendLine("Sender: <i>" + AlertData.Sender  + "</i></p>");
                                msgBody.AppendLine("Recipient: <i>" + AlertData.Recipient + "</i><br/>");
                                msgBody.AppendLine("Source: <i>" + AlertData.Source + "</i><br/><br/>");
                                msgBody.AppendLine("Message: <pre>" + AlertData.ErrorMessage + "</pre>");
                                msgBody.AppendLine("</span></body></html>");
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("0237e2ab-0c68-4a71-ac39-879ed05be1eb")]
                                construct Email
                                {
                                    [Microsoft.XLANGs.BaseTypes.DesignerPosition("c9d5b3f3-6c42-43d6-b84a-7a0f7c78e987")]
                                    Email.EmailBody = new CargoWise.eHub.Core.PipelineComponents.Tools.RawString(msgBody.ToString());
                                    Email.EmailBody(Microsoft.XLANGs.BaseTypes.ContentType) = "text/html";
                                    
                                    Email(SMTP.Subject) = System.Environment.MachineName + " - Failed message notification";
                                    Email(SMTP.From) = "eHubNoReply@cargowise.com";
                                    Email(SMTP.EmailBodyFileCharset) = "UTF-8";
                                    Email(SMTP.MessagePartsAttachments) = 1;
                                    
                                    logger.Log.Debug("ErrorPK: " + AlertData.ErrorPK + ", Mail to: (First Email address), " + emailRecipients.Substring(0,emailRecipients.IndexOf(';')+1));
                                    SMTPAlertPort(Microsoft.XLANGs.BaseTypes.Address) = "mailto:" + emailRecipients.Substring(0,emailRecipients.IndexOf(';')+1) ;
                                    Email(SMTP.CC) = emailRecipients.Substring(emailRecipients.IndexOf(';')+1, (emailRecipients.LastIndexOf(';')- emailRecipients.IndexOf(';')));
                                    logger.Log.Debug("ErrorPK: " + AlertData.ErrorPK + ", CC to:" + emailRecipients.Substring(emailRecipients.IndexOf(';')+1, (emailRecipients.LastIndexOf(';')- emailRecipients.IndexOf(';'))));
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("b9299bf7-9f2d-40ef-85b8-d2b99c609222")]
                                send (SMTPAlertPort.Operation_1, Email);
                            }
                            else if (System.String.IsNullOrWhiteSpace(emailRecipients) || emailRecipients.Length < 3)
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("58a52548-e066-4ca8-9d31-9d3eea5147da")]
                                logger.Log.Debug("ErrorPK:" + AlertData.ErrorPK + ", No email recipients detected, no email will be sent");
                            }
                            else 
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("d21fa6e2-d4a4-431c-a463-77ffd75e08e0")]
                                logger.Log.Debug("ErrorPK:" + AlertData.ErrorPK + ", No email sent as email recipients length exceeds 1024.");
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("7f717033-8b9e-46c6-812d-59b5347d31c4")]
                                
                                 exceptionForEmailRecipientsTooLong = new System.NotSupportedException("Email Recipients length is greater than 1024");
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("6b2186fe-8c15-4f32-9dda-bc175c2b4a7c")]
                                throw exceptionForEmailRecipientsTooLong;
                            }
                        }
                        exceptions
                        {
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("e8eeed04-fcb7-4f31-97af-670f1f0f9de6")]
                            catch (System.Exception ex)
                            {
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("9489e482-8ea0-4479-aa3c-ed29b51f2d05")]
                                logger.Log.Error("ErrorPK" + AlertData.ErrorPK, ex);
                            }
                        }
                    }
                }
            }
        }
    }
}

