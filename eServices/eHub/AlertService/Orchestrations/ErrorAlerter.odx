                                <om:Element Type="DecisionBranch" OID="091188ef-83a8-4ff0-9834-3fa8fe15478e" ParentLink="ReallyComplexStatement_Branch" LowerBound="91.29" HigherBound="125.1">
                                    <om:Property Name="Expression" Value="(emailRecipients.Length &gt;= 3) &amp;&amp; (emailRecipients.Length &lt; 1024)" />
                                    <om:Property Name="IsGhostBranch" Value="True" />
                                    <om:Property Name="ReportToAnalyst" Value="True" />
                                    <om:Property Name="Name" Value="Send" />
                                    <om:Property Name="Signal" Value="True" />
                                    <om:Element Type="VariableAssignment" OID="a2f59160-a0c3-45a8-bdfb-d1bdcf738563" ParentLink="ComplexStatement_Statement" LowerBound="93.1" HigherBound="105.1">
                                        <om:Property Name="Expression" Value="msgBody = new System.Text.StringBuilder();&#xD;&#xA;msgBody.AppendLine(&quot;&lt;html&gt;&lt;body&gt;&lt;span style=\&quot;font-family: calibri,arial,sans-serif\&quot;&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Server Name: &lt;i&gt;&quot; + System.Environment.MachineName + &quot;&lt;/i&gt;&lt;br/&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;eHub Message Tracking ID: &lt;i&gt;&quot; + AlertData.MessageTrackingID + &quot;&lt;/i&gt;&lt;br/&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Received From Sender UTC: &lt;i&gt;&quot; + System.Convert.ToString(AlertData.ReceivedDateTimeUTC)  + &quot;&lt;/i&gt;&lt;br/&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Error Time UTC: &lt;i&gt;&quot; + System.Convert.ToString(AlertData.DateTimeUTC)  + &quot;&lt;/i&gt;&lt;br/&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Sender: &lt;i&gt;&quot; + AlertData.Sender  + &quot;&lt;/i&gt;&lt;/p&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Recipient: &lt;i&gt;&quot; + AlertData.Recipient + &quot;&lt;/i&gt;&lt;br/&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Source: &lt;i&gt;&quot; + AlertData.Source + &quot;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;Message: &lt;pre&gt;&quot; + AlertData.ErrorMessage + &quot;&lt;/pre&gt;&quot;);&#xD;&#xA;msgBody.AppendLine(&quot;&lt;/span&gt;&lt;/body&gt;&lt;/html&gt;&quot;);" />
                                        <om:Property Name="ReportToAnalyst" Value="True" />
                                        <om:Property Name="Name" Value="Make msg" />
                                        <om:Property Name="Signal" Value="False" />
                                    </om:Element>
                                    <om:Element Type="Construct" OID="0237e2ab-0c68-4a71-ac39-879ed05be1eb" ParentLink="ComplexStatement_Statement" LowerBound="105.1" HigherBound="122.1">
                                        <om:Property Name="ReportToAnalyst" Value="True" />
                                        <om:Property Name="Name" Value="CreateEmail" />
                                        <om:Property Name="Signal" Value="True" />
                                        <om:Element Type="MessageAssignment" OID="c9d5b3f3-6c42-43d6-b84a-7a0f7c78e987" ParentLink="ComplexStatement_Statement" LowerBound="108.1" HigherBound="121.1">
                                            <om:Property Name="Expression" Value="Email.EmailBody = new CargoWise.eHub.Core.PipelineComponents.Tools.RawString(msgBody.ToString());&#xD;&#xA;Email.EmailBody(Microsoft.XLANGs.BaseTypes.ContentType) = &quot;text/html&quot;;&#xD;&#xA;&#xD;&#xA;Email(SMTP.Subject) = System.Environment.MachineName + &quot; - Failed message notification&quot;;&#xD;&#xA;Email(SMTP.From) = &quot;eHubNoReply@cargowise.com&quot;;&#xD;&#xA;Email(SMTP.EmailBodyFileCharset) = &quot;UTF-8&quot;;&#xD;&#xA;Email(SMTP.MessagePartsAttachments) = 1;&#xD;&#xA;&#xD;&#xA;logger.Log.Debug(&quot;ErrorPK: &quot; + AlertData.ErrorPK + &quot;, Mail to: (First Email address), &quot; + emailRecipients.Substring(0,emailRecipients.IndexOf(';')+1));&#xD;&#xA;SMTPAlertPort(Microsoft.XLANGs.BaseTypes.Address) = &quot;mailto:&quot; + emailRecipients.Substring(0,emailRecipients.IndexOf(';')+1) ;&#xD;&#xA;Email(SMTP.CC) = emailRecipients.Substring(emailRecipients.IndexOf(';')+1, (emailRecipients.LastIndexOf(';')- emailRecipients.IndexOf(';')));&#xD;&#xA;logger.Log.Debug(&quot;ErrorPK: &quot; + AlertData.ErrorPK + &quot;, CC to:&quot; + emailRecipients.Substring(emailRecipients.IndexOf(';')+1, (emailRecipients.LastIndexOf(';')- emailRecipients.IndexOf(';'))));&#xD;&#xA;" />
                                            <om:Property Name="ReportToAnalyst" Value="False" />
                                            <om:Property Name="Name" Value="AssignEmail" />
                                            <om:Property Name="Signal" Value="True" />
                                        </om:Element>
                                        <om:Element Type="MessageRef" OID="a81b70c1-8c6d-4b9c-9050-6b7eb3039138" ParentLink="Construct_MessageRef" LowerBound="106.43" HigherBound="106.48">
                                            <om:Property Name="Ref" Value="Email" />
                                            <om:Property Name="ReportToAnalyst" Value="True" />
                                            <om:Property Name="Signal" Value="False" />
                                        </om:Element>
                                    </om:Element>
                                    <om:Element Type="Send" OID="b9299bf7-9f2d-40ef-85b8-d2b99c609222" ParentLink="ComplexStatement_Statement" LowerBound="122.1" HigherBound="124.1">
                                        <om:Property Name="PortName" Value="SMTPAlertPort" />
