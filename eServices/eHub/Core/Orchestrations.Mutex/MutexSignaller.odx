[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module CargoWise.eHub.Core.Orchestrations.Mutex
{
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service MutexSignaller
    {
        [Microsoft.XLANGs.BaseTypes.DirectBinding(typeof(CargoWise.eHub.Core.Orchestrations.Mutex.MutexSignaller), "MutexSignal")]
        port uses MutexSignalPort MutexSignal;
        correlation RequestCorrelationType RequestCorrelation;
        body (System.String LogPrefix, CargoWise.eHub.Core.Logging.OrchestrationLogger Logger, message MutexMessage MutexMsg, System.String RequestID)
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("5a22bc43-3456-45ea-8e10-758f056e2acf")]
            send (MutexSignal.Signal, MutexMsg, initialize RequestCorrelation);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("87c44eb6-8ab9-4342-84be-a043d4ed9e9b")]
            Logger.Log.DebugFormat("{0}Signalled request '{1}'", LogPrefix, RequestID);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7d4321b4-fa11-4042-af9a-33540b5e7e4d")]
            receive (MutexSignal.Signal, MutexMsg);
        }
    }
}

