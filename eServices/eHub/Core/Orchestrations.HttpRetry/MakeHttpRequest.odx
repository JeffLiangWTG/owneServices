                    <om:Property Name="Expression" Value="if (in_MaxRetryingDuration.Ticks &lt;= 0)&#xD;&#xA;{&#xD;&#xA;    in_MaxRetryingDuration = System.TimeSpan.FromHours(8);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (in_SleepingPeriodBetweenRetries.Ticks &lt;= 0)&#xD;&#xA;{&#xD;&#xA;    in_SleepingPeriodBetweenRetries = System.TimeSpan.FromMinutes(1);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (System.String.IsNullOrEmpty(in_HttpRequest.Method))&#xD;&#xA;{&#xD;&#xA;    in_HttpRequest.Method = &quot;POST&quot;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (in_HttpRequest.UserHeaderNamesWithoutValidation == null)&#xD;&#xA;{&#xD;&#xA;    in_HttpRequest.UserHeaderNamesWithoutValidation = System.String.Empty;&#xD;&#xA;}" />
