                                    <om:Property Name="Expression" Value="var_HttpError = new CargoWise.eHub.Core.Orchestrations.HttpRetry.Contract.HttpError();&#xD;&#xA;var_HttpError.StatusCode = (System.UInt16)msg_HttpResponse(HTTP.ResponseStatusCode);&#xD;&#xA;var_HttpError.Message = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(msg_HttpResponse);&#xD;&#xA;" />
