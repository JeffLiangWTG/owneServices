                                                    <OI_PK>{0}</OI_PK>
                                                    <OI_CC_Sender>{1}</OI_CC_Sender>
                                                    <OI_CC_Recipient>{2}</OI_CC_Recipient>
                                                    <OI_EnvelopeTrackingID/>
                                                    <OI_EI_InboxPK>{3}</OI_EI_InboxPK>
                                                    <OI_MessageTrackingID>{4}</OI_MessageTrackingID>
                                                    <OI_OverrideEmailSubject/>
                                                    <OI_OverrideFilename/>
                                                    <OI_Status>255</OI_Status>
                                                    <OI_InsertUTC>{5}</OI_InsertUTC>
                                                    <OI_Content>{6}</OI_Content>
                                                </eHubOutboxMessage>
                                            </Rows>
                                        </Insert>
                                    </CompositeOperation>", outboxPK, senderPK, recipientPK, inboxPK, messageTrackingID, currentUTCTime, inboxContent));
                                    
                                    InsertOutboxMsg = xmlInsertOutbox;
