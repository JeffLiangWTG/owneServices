                    <om:Element Type="DNFPredicate" OID="fcdc4252-38c9-4a75-87d9-1b024e358101" ParentLink="Receive_DNFPredicate">
                        <om:Property Name="LHS" Value="CargoWise.eHub.Core.PropertySchemas.NextStep" />
                        <om:Property Name="RHS" Value="&quot;DeliverToNotificationOrchestration&quot;" />
                        <om:Property Name="Grouping" Value="AND" />
                        <om:Property Name="Operator" Value="Equals" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                </om:Element>
                <om:Element Type="Decision" OID="1487da56-ca27-447b-a613-e46a718386f5" ParentLink="ServiceBody_Statement" LowerBound="74.1" HigherBound="284.1">
                    <om:Property Name="ReportToAnalyst" Value="True" />
                    <om:Property Name="Name" Value="IsFailedMessage" />
                    <om:Property Name="Signal" Value="True" />
                    <om:Element Type="DecisionBranch" OID="8409186b-b153-45d7-b507-482a636228b0" ParentLink="ReallyComplexStatement_Branch" LowerBound="75.13" HigherBound="78.1">
                        <om:Property Name="Expression" Value="ErrorReport.ErrorType exists NotificationMsg" />
                        <om:Property Name="IsGhostBranch" Value="True" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Yes" />
                        <om:Property Name="Signal" Value="False" />
                    </om:Element>
                    <om:Element Type="DecisionBranch" OID="673abc00-0748-4ab4-9c28-078c052cb61f" ParentLink="ReallyComplexStatement_Branch">
                        <om:Property Name="IsGhostBranch" Value="True" />
                        <om:Property Name="ReportToAnalyst" Value="True" />
                        <om:Property Name="Name" Value="Else" />
                        <om:Property Name="Signal" Value="False" />
                        <om:Element Type="VariableAssignment" OID="6a45f838-37de-4f2b-8e8d-431f08d9a763" ParentLink="ComplexStatement_Statement" LowerBound="80.1" HigherBound="109.1">
                            <om:Property Name="Expression" Value="logger.Log.InfoFormat(&quot;Acknowledgement Message Captured.&quot;);&#xD;&#xA;&#xD;&#xA;outboxPK = &quot;&quot;;&#xD;&#xA;if(CargoWise.eHub.Core.PropertySchemas.InternalTrackingID exists NotificationMsg)&#xD;&#xA;{&#xD;&#xA;    inboxPK = NotificationMsg(CargoWise.eHub.Core.PropertySchemas.InternalTrackingID);&#xD;&#xA;}&#xD;&#xA;if(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID exists NotificationMsg)&#xD;&#xA;{&#xD;&#xA;    messageTrackingID = NotificationMsg(CargoWise.eHub.Core.PropertySchemas.MessageTrackingID);&#xD;&#xA;}&#xD;&#xA;ackType = NotificationMsg(CargoWise.eHub.Core.PropertySchemas.ErrorCode);&#xD;&#xA;errorDescription = NotificationMsg(CargoWise.eHub.Core.PropertySchemas.ErrorDescription);&#xD;&#xA;if(CargoWise.eHub.Core.PropertySchemas.OutboxPK exists NotificationMsg)&#xD;&#xA;{   &#xD;&#xA;    outboxPK = NotificationMsg(CargoWise.eHub.Core.PropertySchemas.OutboxPK);&#xD;&#xA;}&#xD;&#xA;if(CargoWise.eHub.Core.PropertySchemas.DestinationPartyForMessageProcessing exists NotificationMsg)&#xD;&#xA;{&#xD;&#xA;    destinationParty = NotificationMsg(CargoWise.eHub.Core.PropertySchemas.DestinationPartyForMessageProcessing);&#xD;&#xA;}&#xD;&#xA;logger.Log.InfoFormat(&quot;Processing Acknowledgement Message. InboxPK: {0}, OutboxPK: {1}, MessageTrackingID: {2}, AckType: {3}&quot;, inboxPK, outboxPK, messageTrackingID, ackType);&#xD;&#xA;&#xD;&#xA;if(ackType != &quot;ACK&quot;)&#xD;&#xA;{&#xD;&#xA;    isSuccessful = false;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;" />
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="Starting" />
                            <om:Property Name="Signal" Value="False" />
                        </om:Element>
                        <om:Element Type="Decision" OID="889b07a8-6158-4961-8c8e-12d18e18ea16" ParentLink="ComplexStatement_Statement" LowerBound="109.1" HigherBound="283.1">
                            <om:Property Name="ReportToAnalyst" Value="True" />
                            <om:Property Name="Name" Value="UseDeliveryNotificationUpdateStatus" />
                            <om:Property Name="Signal" Value="True" />
                            <om:Element Type="DecisionBranch" OID="c0fd6c3f-2fc8-4133-aaeb-a4c40595dfa0" ParentLink="ReallyComplexStatement_Branch" LowerBound="110.17" HigherBound="119.1">
                                <om:Property Name="Expression" Value="BTS.CorrelationToken exists NotificationMsg &amp;&amp; NotificationMsg(BTS.CorrelationToken) == &quot;UseDeliveryNotificationUpdateStatus&quot;" />
                                <om:Property Name="IsGhostBranch" Value="True" />
                                <om:Property Name="ReportToAnalyst" Value="True" />
