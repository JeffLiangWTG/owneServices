                                    logger.Log.InfoFormat("Copy inbox message content and insert into outbox.");
                                }
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("5cc483ae-e1ff-4fad-8482-5a8c63744012")]
                                send (eHubTransactionsOpsPort.SqlOp, InsertOutboxMsg);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("18de8c0f-244d-4bc2-82ee-339d1e346d92")]
                                receive (eHubTransactionsOpsPort.SqlOp, InsertOutboxResponseMsg);
                                [Microsoft.XLANGs.BaseTypes.DesignerPosition("a65eb089-3943-46b7-bb84-10ef9d3d806d")]
                                
                                inboxContentDecoded = System.String.Format(@"<ns0:DeliveryNotificationMessage xmlns:ns0='http://cargowise.com/ehub/core/2018/06'>
                                  <ns0:InternalTrackingID>{0}</ns0:InternalTrackingID>
                                  <ns0:OutboxPK>{1}</ns0:OutboxPK>
                                  <ns0:MessageTrackingID>{2}</ns0:MessageTrackingID>
                                  <ns0:NotificationType>{3}</ns0:NotificationType>
                                  <ns0:ErrorDescription><![CDATA[{4}]]></ns0:ErrorDescription>
                                  <ns0:OutboxRecipientId>{5}</ns0:OutboxRecipientId>
                                  <ns0:InboxMessageContent>{6}</ns0:InboxMessageContent>
                                </ns0:DeliveryNotificationMessage>", inboxPK, outboxPK, messageTrackingID, ackType, errorDescription, destinationParty, inboxContentDecoded);
                                
                                
                            }
                            [Microsoft.XLANGs.BaseTypes.DesignerPosition("1ddf49d8-4963-41ca-b34a-af5e292312d7")]
                            call CargoWise.eHub.Core.Orchestrations.DeliveryNotificationProcessing.ProcessDeliveryNotifications (inboxSenderID, logger, inboxRecipient, inboxContentDecoded, shouldSendNotification, outboxPK, inboxPK, messageTrackingID, errorDescription, isSuccessful);
                        }
                    }
                    else 
                    {
                        [Microsoft.XLANGs.BaseTypes.DesignerPosition("b2f8681a-9293-4a97-985e-98470aad0e76")]
                        xmlString = CargoWise.eHub.Core.Orchestrations.Helper.Messages.GetMessageBodyString(NotificationMsg);
                        logger.Log.WarnFormat("DeliveryNotificationService required at least one tracking key. Message content: {0}", xmlString);
                    }
                }
            }
        }
    }
