                                        <om:Property Name="Expression" Value="xmlString = System.String.Format(@&quot;&#xD;&#xA;&lt;CompositeOperation&gt;&#xD;&#xA;    &lt;ns0:SelectInboxMessageContentForDeliveryNotification xmlns:ns0='http://schemas.microsoft.com/Sql/2008/05/TypedProcedures/dbo'&gt;&#xD;&#xA;        &lt;ns0:InboxPK&gt;{0}&lt;/ns0:InboxPK&gt;&#xD;&#xA;        &lt;ns0:OutboxPK&gt;{1}&lt;/ns0:OutboxPK&gt;&#xD;&#xA;        &lt;ns0:MessageTrackingID&gt;{2}&lt;/ns0:MessageTrackingID&gt;&#xD;&#xA;    &lt;/ns0:SelectInboxMessageContentForDeliveryNotification&gt;&#xD;&#xA;&lt;/CompositeOperation&gt;&quot;, InboxPK, OutboxPK, MessageTrackingID);&#xD;&#xA;SelectInboxContentRequestMsg = new System.Xml.XmlDocument();&#xD;&#xA;SelectInboxContentRequestMsg.LoadXml(xmlString);&#xD;&#xA;SelectInboxContentRequestMsg(WCF.Action) = &quot;CompositeOperation&quot;;&#xD;&#xA;&#xD;&#xA;loggerIn.Log.InfoFormat(&quot;Select inbox message.Inbox PK: {0}, outbox PK: {1}, messageTrackingID: {2}&quot;, InboxPK, OutboxPK, MessageTrackingID);" />
