<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="CargoWise.eHub.Core.DataAccess.SecirutyAccessor" value="CargoWise.eHub.Core.DataAccess.Sql.SecirutyAccessor, CargoWise.eHub.Core.DataAccess.Sql, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=4f570df270576350"/>
    <add key="CargoWise.eHub.Core.DataAccess.ExceptionsAccessor" value="CargoWise.eHub.Core.DataAccess.Sql.ExceptionsAccessor, CargoWise.eHub.Core.DataAccess.Sql, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=4f570df270576350"/>
    <add key="CargoWise.eHub.Core.DataAccess.PartyAccessor" value="CargoWise.eHub.Core.DataAccess.Cache.PartyAccessor, CargoWise.eHub.Core.DataAccess.Cache, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=4f570df270576350"/>
    <add key="CargoWise.eHub.Core.DataAccess.TransformAccessor" value="CargoWise.eHub.Core.DataAccess.Cache.TransformAccessor, CargoWise.eHub.Core.DataAccess.Cache, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=4f570df270576350"/>
    <add key="CargoWise.eHub.Core.DataAccess.Cache.PartyAccessor" value="CargoWise.eHub.Core.DataAccess.Sql.PartyAccessor, CargoWise.eHub.Core.DataAccess.Sql, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=4f570df270576350"/>
    <add key="CargoWise.eHub.Core.DataAccess.Cache.TransformAccessor" value="CargoWise.eHub.Core.DataAccess.Sql.TransformAccessor, CargoWise.eHub.Core.DataAccess.Sql, Version=1.0.0.0, Culture=Neutral, PublicKeyToken=4f570df270576350"/>
    <!--Data cache expiry time in minutes-->
    <add key="DataCacheExpiry" value="10"/>
    <!-- Used during logging to allow a redirect in the BAM portal to the custom message viewer ASP page -->
    <add key="MessageViewerUrl" value="http://biztalk-web.ausyd.eservices.cargowise.net/eHubMessageViewer/Default.aspx"/>
    <!-- Used to determine when to compress a stream before logging it in BAM-->
    <add key="CompressionThresholdBytes" value="1048576"/>
    <!--Size of buffers used when programmatically managing streams (eg) xpathreader, re-encoding, etc-->
    <add key="StreamingBufferSize" value="81920"/>
  </appSettings>
  <connectionStrings>
    <add name="CargoWise.eHub.Core.DataAccess.Sql.eHubTransactions" connectionString="Data Source=ehubtransactions.db.wisegrid.net;Initial Catalog=eHubTransactions;Integrated Security=SSPI;" />
    <add name="CargoWise.eHub.Core.DataAccess.Sql.EsbExceptionDb" connectionString="Data Source=biztalk-db.ausyd.eservices.cargowise.net;Initial Catalog=EsbExceptionDb;Integrated Security=SSPI;" />
  </connectionStrings>
  <system.diagnostics>
    <switches>
      <!-- 0,1,2,3, and 4 correspond to Off, Error, Warning, Info, and Verbose -->
      <add name="eHubTraceLevel" value="0" />
      <add name="BizTalkESBToolkit20" value="0" />
    </switches>
  </system.diagnostics>
</configuration>