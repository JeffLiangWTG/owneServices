	</Target>

	<Target Name="Application">
		<Exec Command="&quot;%BTSINSTALLPATH%\BTSTask.exe&quot; AddApp -ApplicationName:CargoWise.eHub -Default" IgnoreExitCode="true" />
		<MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="AddReference" Application="CargoWise.eHub" References="BizTalk EDI Application" DatabaseServer=".\BT2013R2"/>
		<Exec Command="&quot;%BTSINSTALLPATH%\BTSTask.exe&quot; RemoveApp -ApplicationName:&quot;BizTalk Application 1&quot;" IgnoreExitCode="true" />
	</Target>

	<Target Name="NuGet">
		<Exec Command="powershell -ExecutionPolicy RemoteSigned -Command &quot;[IO.File]::WriteAllBytes('nuget.exe', (Invoke-WebRequest -Uri https://www.nuget.org/nuget.exe -Method Get -Proxy http://sydco-spxy-1.wtg.zone:8080 -ProxyUseDefaultCredentials).Content)&quot;" />
		<Exec Command="nuget.exe install" />
		<ItemGroup>
			<NuGetAssemblies Include="Common.Logging.2.2.0\lib\net40\Common.Logging.dll" />
			<NuGetAssemblies Include="Common.Logging.Core.2.2.0\lib\net40\Common.Logging.Core.dll" />
			<NuGetAssemblies Include="Common.Logging.Log4Net1211.2.2.0\lib\net40\Common.Logging.Log4Net1211.dll" />
			<NuGetAssemblies Include="EntityFramework.6.1.1\lib\net40\EntityFramework.dll" />
			<NuGetAssemblies Include="EntityFramework.6.1.1\lib\net40\EntityFramework.SqlServer.dll" />
			<NuGetAssemblies Include="log4net.2.0.0\lib\net40-full\log4net.dll" />
			<NuGetAssemblies Include="Microsoft.Web.Xdt.2.1.1\lib\net40\Microsoft.Web.XmlTransform.dll" />
		</ItemGroup>
		<MSBuild.ExtensionPack.Framework.Gac TaskAction="AddAssembly" AssemblyPath="%(NuGetAssemblies.FullPath)"/>
	</Target>

	<Target Name="Assemblies">
		<ItemGroup>
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.AlertService.Orchestrations.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.AlertService.Pipelines.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.AlertService.Schemas.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.AlertService.Transformations.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.Pipelines.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.PropertySchemas.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.Schemas.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.Transforms.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Gateway.Pipelines.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Gateway.Schemas.dll" />
			<BizTalkAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Gateway.Transforms.dbo_SelectInboxMessagesByStatus2SendRequestStream.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.AlertService.PipelineComponents.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Common.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.Logging.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.Orchestrations.Helper.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.PipelineComponents.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Core.Transforms.Helper.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.DataAccess.Cache.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.DataAccess.Integration.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.DataAccess.Models.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.DataAccess.Sql.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.DataModel.Common.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.DataModel.eHubTransactions.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Integration.dll" />
			<GacAssemblies Include="\\sydco-stfb-1.wtg.zone\eHubBuilds\eHubLatestRelease\CargoWise.eHub.Shared.RoutingRuleEngine.dll" />
		</ItemGroup>
		<MakeDir Directories="BizTalkAssemblies;GacAssemblies" />
		<Copy SourceFiles="@(BizTalkAssemblies)" DestinationFolder="BizTalkAssemblies" />
		<Copy SourceFiles="@(GacAssemblies)" DestinationFolder="GacAssemblies" />
		<ItemGroup>
			<LocalBizTalkAssemblies Include="BizTalkAssemblies\*.*" />
			<LocalGacAssemblies Include="GacAssemblies\*.*" />
			<AllLocalAssemblies Include="@(LocalBizTalkAssemblies);@(LocalGacAssemblies)" />
		</ItemGroup>
		<MakeDir Directories="..\..\..\bin" />
		<Copy SourceFiles="@(AllLocalAssemblies)" DestinationFolder="..\..\..\bin" />
		<MSBuild.ExtensionPack.Framework.Gac TaskAction="AddAssembly" AssemblyPath="%(AllLocalAssemblies.FullPath)"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAssembly TaskAction="Add" Application="CargoWise.eHub" Assemblies="@(LocalBizTalkAssemblies)" Force="true" Gac="true" GacOnAddResource="true" GacOnMSIFileImport="true" GacOnMSIFileInstall="true" DatabaseServer=".\BT2013R2"/>
	</Target>

	<Target Name="Bindings">
		<MSBuild.ExtensionPack.BizTalk.BizTalkApplication TaskAction="ImportBindings" Application="CargoWise.eHub" BindingFile="CargoWise.eHub.BindingInfo.xml" DatabaseServer=".\BT2013R2"/> 
	</Target>

	<Target Name="Database">
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="sp_dropserver [EHUB-DEV-BT];" ConnectionString="Data Source=localhost;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="declare @host nvarchar(250) = (select HOST_NAME()); exec sp_addserver @host, local;" ConnectionString="Data Source=localhost;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="declare @host nvarchar(250) = (select HOST_NAME()); exec sp_serveroption @host, 'data access', 'true';" ConnectionString="Data Source=localhost;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="sp_dropserver [EHUB-DEV-BT\EHUBTEST];" ConnectionString="Data Source=localhost\EHUBTEST;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="declare @host nvarchar(250) = (select HOST_NAME()) + '\EHUBTEST'; exec sp_addserver @host, local;" ConnectionString="Data Source=localhost\EHUBTEST;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="declare @host nvarchar(250) = (select HOST_NAME()) + '\EHUBTEST'; exec sp_serveroption @host, 'data access', 'true';" ConnectionString="Data Source=localhost\EHUBTEST;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="sp_dropserver [EHUB-DEV-BT\BT2013R2];" ConnectionString="Data Source=localhost\BT2013R2;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="declare @host nvarchar(250) = (select HOST_NAME()) + '\BT2013R2'; exec sp_addserver @host, local;" ConnectionString="Data Source=localhost\BT2013R2;Integrated Security=SSPI" ContinueOnError="True" />
		<MSBuild.ExtensionPack.SqlServer.SqlExecute TaskAction="Execute" Sql="declare @host nvarchar(250) = (select HOST_NAME()) + '\BT2013R2'; exec sp_serveroption @host, 'data access', 'true';" ConnectionString="Data Source=localhost\BT2013R2;Integrated Security=SSPI" ContinueOnError="True" />
	</Target>

	<Target Name="Configs">
		<Exec Command="powershell -ExecutionPolicy RemoteSigned -File Config.Dev.UpdateScript.ps1" />
	</Target>

</Project>