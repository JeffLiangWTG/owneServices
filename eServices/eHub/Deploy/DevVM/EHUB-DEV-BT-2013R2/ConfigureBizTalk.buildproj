<Project ToolsVersion="4.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<Import Project="$(MSBuildExtensionsPath)\ExtensionPack\4.0\MSBuild.ExtensionPack.tasks"/>

	<PropertyGroup>
		<AccountName Condition="'$(AccountName)'==''">DevAdmin</AccountName>
		<AccountPassword Condition="'$(AccountPassword)'==''">3hubRock$</AccountPassword>
	</PropertyGroup>

	<Target Name="Default">
 		<CallTarget Targets="Adapters" ContinueOnError="true" />
		<CallTarget Targets="Hosts" ContinueOnError="true" />
		<CallTarget Targets="HostInstances" ContinueOnError="true" />
		<CallTarget Targets="Handlers" ContinueOnError="true" />
		<CallTarget Targets="Application" ContinueOnError="true" />
		<CallTarget Targets="NuGet" ContinueOnError="true" />
		<CallTarget Targets="Assemblies" ContinueOnError="true" />
 		<CallTarget Targets="Bindings" ContinueOnError="true" />
		<CallTarget Targets="Database" ContinueOnError="true" />
		<CallTarget Targets="Configs" ContinueOnError="true" />
	</Target>

	<Target Name="Adapters">
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor TaskAction="CheckExists" AdaptorName="WCF-SQL" DatabaseServer=".\BT2013R2">
			<Output TaskParameter="Exists" PropertyName="Exists" />
		</MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor Condition="'$(Exists)'=='False'" TaskAction="Create" AdaptorName="WCF-SQL" MgmtCLSID="{59b35d03-6a06-4734-a249-ef561254ecf7}" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor TaskAction="CheckExists" AdaptorName="FTPEx" DatabaseServer=".\BT2013R2">
			<Output TaskParameter="Exists" PropertyName="Exists" />
		</MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor Condition="'$(Exists)'=='False'" TaskAction="Create" AdaptorName="FTPEx" MgmtCLSID="{a164bee6-4eec-4a72-bff0-221a75c18ef0}" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor TaskAction="CheckExists" AdaptorName="SFTPEx" DatabaseServer=".\BT2013R2">
			<Output TaskParameter="Exists" PropertyName="Exists" />
		</MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor Condition="'$(Exists)'=='False'" TaskAction="Create" AdaptorName="SFTPEx" MgmtCLSID="{b28837dd-cb92-4357-9ae6-c34f3932b7e1}" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor TaskAction="CheckExists" AdaptorName="NULL" DatabaseServer=".\BT2013R2">
			<Output TaskParameter="Exists" PropertyName="Exists" />
		</MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor>
		<MSBuild.ExtensionPack.BizTalk.BizTalkAdaptor Condition="'$(Exists)'=='False'" TaskAction="Create" AdaptorName="NULL" MgmtCLSID="{d6f3a77c-b641-45dc-8aa5-3ee3503f59fc}" DatabaseServer=".\BT2013R2"/>
	</Target>

	<Target Name="Hosts">
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="TrackingHost" Tracking="true" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="AlertSend" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ErrorReceive" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="InboxReceive" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="InboxSend" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="OutboxReceive" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="OutboxSend" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ReceiveHost_FILE" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ReceiveHost_FTP" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ReceiveHost_POP3" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ReceiveHost_WCFBasicHttp" Tracking="false" WindowsGroup="BizTalk Isolated Host Users" HostType="Isolated" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ReceiveHost_WCFSQL" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="ReceiveHost_FTPEx" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
