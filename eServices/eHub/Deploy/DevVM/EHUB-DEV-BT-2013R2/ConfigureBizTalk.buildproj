		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_FTP" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_SMTP" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_WCF" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_WCFSQL" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_FTPEx" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_SFTPEx" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Create" HostName="SendHost_SFTPEx" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="false" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHost TaskAction="Update" HostName="BizTalkServerApplication" Tracking="false" WindowsGroup="BizTalk Application Users" HostType="InProcess" Use32BitHostOnly="true" Default="true" DatabaseServer=".\BT2013R2"/>
	</Target>

	<Target Name="HostInstances">
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="TrackingHost" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="AlertSend" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ErrorReceive" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="InboxReceive" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="InboxSend" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="OutboxReceive" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="OutboxSend" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_FILE" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_FTP" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_POP3" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_WCFBasicHttp" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_WCFSQL" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_FTPEx" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="ReceiveHost_SFTPEx" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="SendHost_FTP" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="SendHost_SMTP" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="SendHost_WCF" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="SendHost_WCFSQL" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="SendHost_FTPEx" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkHostInstance TaskAction="Create" HostName="SendHost_SFTPEx" AccountName="$(AccountName)" AccountPassword="$(AccountPassword)" Force="true"/>
	</Target>

	<Target Name="Handlers">
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="AlertSend" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="InboxReceive" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="OutboxReceive" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="ErrorReceive" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="InboxSend" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="OutboxSend" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>

		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="ReceiveHost_FILE" AdapterName="FILE" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="ReceiveHost_FTP" AdapterName="FTP" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="ReceiveHost_POP3" AdapterName="POP3" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="ReceiveHost_WCFSQL" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="ReceiveHost_FTPEx" AdapterName="FTPEx" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkReceiveHandler TaskAction="Create" HostName="ReceiveHost_SFTPEx" AdapterName="SFTPEx" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="SendHost_FTP" AdapterName="FTP" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="SendHost_SMTP" AdapterName="SMTP" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="SendHost_WCFSQL" AdapterName="WCF-SQL" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="SendHost_WCF" AdapterName="WCF-BasicHttp" Force="true" DatabaseServer=".\BT2013R2"/>
		<MSBuild.ExtensionPack.BizTalk.BizTalkSendHandler TaskAction="Create" HostName="SendHost_FTPEx" AdapterName="FTPEx" Force="true" DatabaseServer=".\BT2013R2"/>
