  <!--Data cache expiry time in minutes-->
	<add key="DataCacheExpiry" value="10"/>
	<!-- Used during logging to allow a redirect in the BAM portal to the custom message viewer ASP page -->
	<add key="MessageViewerUrl" value="http://biztalk-web.dev.ausyd.eservices.cargowise.net/eHubMessageViewer/Default.aspx"/>
	<!-- Used to determine when to compress a stream before logging it in BAM-->
	<add key="CompressionThresholdBytes" value="1048576"/>
	<!--Size of buffers used when programmatically managing streams (eg) xpathreader, re-encoding, etc-->
	<add key="StreamingBufferSize" value="32768"/>
  </appSettings>
  <connectionStrings>
	<add name="CargoWise.eHub.DataAccess.Sql.eHubTransactions" connectionString="Data Source=ehub-db.dev.eservices.cargowise.net;Initial Catalog=eHubTransactions;Integrated Security=SSPI;" />
	<add name="CargoWise.eHub.DataAccess.Sql.EsbExceptionDb" connectionString="Data Source=biztalk-db.dev.eservices.cargowise.net;Initial Catalog=EsbExceptionDb;Integrated Security=SSPI;" />
	<add name="eHubTransactionsContext" connectionString="Data Source=ehub-db.dev.eservices.cargowise.net;Initial Catalog=eHubTransactions;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.diagnostics>
	<switches>
	  <!-- 0,1,2,3, and 4 correspond to Off, Error, Warning, Info, and Verbose -->
	  <add name="eHubTraceLevel" value="0" />
	  <add name="BizTalkESBToolkit20" value="0" />
	</switches>
  </system.diagnostics>
