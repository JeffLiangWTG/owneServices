<SendPort Name="${SendPort_Name}" IsStatic="${SendPort_IsStatic}" IsTwoWay="true" BindingOption="${SendPort_BindingOption}" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Description xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${SendPort_Description}</Description>
  <TransmitPipeline Name="${SendPort_Pipeline_Name}" FullyQualifiedName="${SendPort_Pipeline_FullyQualifiedName}" Type="${SendPort_Pipeline_Type}" TrackingOption="${SendPort_Pipeline_TrackingOption}" Description="${SendPort_Pipeline_Description}" />
  <ReceivePipeline Name="${SendPort_ReceivePipeline_Name}" FullyQualifiedName="${SendPort_ReceivePipeline_FullyQualifiedName}" Type="${SendPort_ReceivePipeline_Type}" TrackingOption="${SendPort_ReceivePipeline_TrackingOption}" Description="${SendPort_ReceivePipeline_Description}" />
  <ReceivePipelineData xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" />
  <Tracking>0</Tracking>
  <Filter />
  <Transforms />
  <InboundTransforms />
  <OrderedDelivery>${SendPort_OrderedDelivery}</OrderedDelivery>
  <Priority>${SendPort_Priority}</Priority>
  <StopSendingOnFailure>${SendPort_StopSendingOnFailure}</StopSendingOnFailure>
  <RouteFailedMessage>${SendPort_RouteFailedMessage}</RouteFailedMessage>
  <ApplicationName>${SendPort_ApplicationName}</ApplicationName>
</SendPort>