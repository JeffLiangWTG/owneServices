    "ReceivePort_ReceiveLocation_TransportType_Binding_pollingStatement":  "SELECT CD_Attr1 AccountNo, CD_Attr2 Password, CASE LD_LicenceType WHEN \u0027PRD\u0027 THEN 1 ELSE 0 END ProdFlag\r\nFROM eHubRegistrationType\r\nJOIN eHubClientSystemRegistration CD ON CD_RT = RT_PK\r\nJOIN eHubClientSystem EH ON EH_PK = CD_EH\r\nJOIN ediProdCache.dbo.LicenceTypeView ON EH_ID COLLATE Latin1_General_CI_AS = LE_EnterpriseCode + LD_ServerCode\r\nWHERE RT_ID = \u0027SGCustomsAccount\u0027\r\nGROUP BY CD_Attr1, CD_Attr2, LD_LicenceType\r\nHAVING MIN(CD_Flag1) = 1",
