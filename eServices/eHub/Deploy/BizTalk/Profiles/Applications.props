<?xml version="1.0" encoding="UTF-8" ?>

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <ApplicationsImported>$true</ApplicationsImported>
    </PropertyGroup>

    <!-- BizTalk Applications -->
    <ItemGroup>
        <BizTalkApplications Include="CargoWise.eHub">
            <Default>true</Default>
            <Description>CargoWise.eHub Application</Description>
            <Reference>BizTalk EDI Application</Reference>
        </BizTalkApplications>

        <BizTalkApplications Include="CargoWise.eHub.Products">
            <Default>false</Default>
            <Description>CargoWise.eHub Products</Description>
        </BizTalkApplications>

        <BizTalkApplications Include="CargoWise.eHub.Products.AUCustoms">
            <Default>false</Default>
            <Description>CargoWise.eHub Products</Description>
            <Reference>CargoWise.eHub.Products</Reference>
        </BizTalkApplications>
    </ItemGroup>
</Project>