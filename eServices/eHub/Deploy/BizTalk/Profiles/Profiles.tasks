<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- properties defined in the imported $(var-file) take precedents -->
  <Import Project="$(var-file)" Condition="'$(var-file)'!=''" />

  <PropertyGroup>
    <ProfilesIncluded>$true</ProfilesIncluded>
    <ProfiledDirectory Condition="'$(Profile)'!=''">$(MSBuildThisFileDirectory)$(Profile)\</ProfiledDirectory>
    <ThisFile>$(MSBuildThisFileDirectory)$(MSBuildThisFile)</ThisFile>

    <DeploymentProps>Deployment.props</DeploymentProps>

    <GlobalsProps>Globals.props</GlobalsProps>
    <ApplicationsProps>Applications.props</ApplicationsProps>
    <HandlersProps>Handlers.props</HandlersProps>
    <AdaptersProps>Adapters.props</AdaptersProps>
    <HostsProps>Hosts.props</HostsProps>
    <GACFilesList>GAC.txt</GACFilesList>
    <ExcludeFilesList>Exclude.txt</ExcludeFilesList>

    <BizTalkConfig>Config.BizTalk.xdt</BizTalkConfig>
    <MachineConfig>Config.Machine.xdt</MachineConfig>

    <VarFileName>var-file.props</VarFileName>
    <VarFilePath>$(ProfilesDirectory)$(VarFileName)</VarFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PropFiles Include="$(MSBuildThisFileDirectory)$(DeploymentProps)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(GlobalsProps)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(ApplicationsProps)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(HandlersProps)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(HostsProps)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(GACFilesList)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(ExcludeFilesList)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(AdaptersProps)" />

    <PropFiles Include="$(MSBuildThisFileDirectory)$(BizTalkConfig)" />
    <PropFiles Include="$(MSBuildThisFileDirectory)$(MachineConfig)" />
  </ItemGroup>

  <ItemGroup>
    <!-- profiled properties overwrite all above -->
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(DeploymentProps)" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(GlobalsProps)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(ApplicationsProps)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(HandlersProps)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(HostsProps)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(GACFilesList)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(ExcludeFilesList)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(AdaptersProps)" Condition="'$(Profile)'!=''" />

    <ProfiledPropFiles Include="$(ProfiledDirectory)$(BizTalkConfig)" Condition="'$(Profile)'!=''" />
    <ProfiledPropFiles Include="$(ProfiledDirectory)$(MachineConfig)" Condition="'$(Profile)'!=''" />
  </ItemGroup>

  <Import Project="$(VarFilePath)" Condition="Exists('$(VarFilePath)')" />

  <Import Project="$(MSBuildThisFileDirectory)$(DeploymentProps)" Condition="'$(DeploymentPropsImported)'==''" />

  <Import Project="$(MSBuildThisFileDirectory)$(GlobalsProps)" Condition="'$(GlobalsImported)'==''" />
  <Import Project="$(MSBuildThisFileDirectory)$(ApplicationsProps)" Condition="'$(ApplicationsImported)'==''" />
  <Import Project="$(MSBuildThisFileDirectory)$(HandlersProps)" Condition="'$(HandlersImported)'==''" />
  <Import Project="$(MSBuildThisFileDirectory)$(AdaptersProps)" Condition="'$(AdaptersImported)'==''" />
  <Import Project="$(MSBuildThisFileDirectory)$(HostsProps)" Condition="'$(HostsImported)'==''" />

  <Import Project="$(ProfiledDirectory)$(DeploymentProps)" Condition="'$(DeploymentPropsImported)'=='' and '$(Profile)'!=''" />

  <Import Project="$(ProfiledDirectory)$(GlobalsProps)" Condition="'$(ProfiledGlobalsImported)'=='' and '$(Profile)'!=''" />
  <Import Project="$(ProfiledDirectory)$(ApplicationsProps)" Condition="'$(ProfiledApplicationsImported)'=='' and '$(Profile)'!=''" />
  <Import Project="$(ProfiledDirectory)$(HandlersProps)" Condition="'$(ProfiledHandlersImported)'=='' and '$(Profile)'!=''" />
  <Import Project="$(ProfiledDirectory)$(AdaptersProps)" Condition="'$(ProfiledAdaptersImported)'=='' and '$(Profile)'!=''" />
  <Import Project="$(ProfiledDirectory)$(HostsProps)" Condition="'$(ProfiledHostsImported)'=='' and '$(Profile)'!=''" />

  <Target Name="bat:profiles:copy-output">
    <Error Text="Output path $(_ZipContentsDirectory} does not exist" Condition="!Exists($(_ZipContentsDirectory))" />

    <Copy SourceFiles="@(PropFiles)" DestinationFolder="$(_ZipContentsDirectory)\Profiles" />
    <Copy SourceFiles="@(ProfiledPropFiles)" DestinationFolder="$(_ZipContentsDirectory)\Profiles\$(Profile)" Condition="'$(Profile)'!=''" />
    <Copy SourceFiles="$(ThisFile)" DestinationFolder="$(_ZipContentsDirectory)\Profiles" />
    <Copy SourceFiles="$(var-file)" DestinationFiles="$(_ZipContentsDirectory)\Profiles\$(VarFileName)" Condition="'$(var-file)'!='' and Exists('$(var-file)')" />
  </Target>

</Project>