<?xml version="1.0" encoding="utf-8" ?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_DeploymentPropsImported>True</_DeploymentPropsImported>
    <_ServiceName>eHubNudging</_ServiceName>
    <_ServiceDisplayName>Nudging Service - eHub</_ServiceDisplayName>
    <_ServiceDescription>This service nudges the EHI service task of the target systems to which there is OutMessage to deliver.</_ServiceDescription>
    <_ServiceFilesPath>$(OutputPath)</_ServiceFilesPath>
    <_ServiceExeFileName>CargoWise.eHub.Nudge.NudgeWindowsService.exe</_ServiceExeFileName>
    <_DeploymentFolder>c:\eServices</_DeploymentFolder>
    <_BackupFolder>c:\eServices\Backup\NudgingService</_BackupFolder>
    <_LogsFolder>logs</_LogsFolder>
  </PropertyGroup>
</Project>