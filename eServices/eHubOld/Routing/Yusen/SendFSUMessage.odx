        oneway ResponseToSender
        {
            CargoWise.eServices.eHub.Schema.SendResponse
        };
    };
    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    public service longrunning transaction SendFSUMessage
    {
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port implements FSUMessagePortType FSUMessagePort;
        [Microsoft.XLANGs.BaseTypes.LogicalBinding()]
        port uses ReponseToFSUSenderTyoe ReponseToFSUSender;
        message Yusen.FSUMessage FSUMessage;
        message CargoWise.eServices.eHub.Schema.Interchange Interchange;
        message CargoWise.eServices.eHub.Schema.SendResponse SendResponse;
        System.Xml.XmlDocument FSUMessageXML;
        Microsoft.XLANGs.Pipeline.SendPipelineInputMessages FSUMessageToSend;
        System.Type TransformType;
        System.Type PipelineType;
        body ()
        {
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("706ed9c0-bbd6-4c4b-896f-995e3a2d6d87")]
            activate receive (FSUMessagePort.SendFSU, FSUMessage);
            FSUMessageXML = new System.Xml.XmlDocument();
            FSUMessageToSend = new Microsoft.XLANGs.Pipeline.SendPipelineInputMessages();
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("58b7bb21-eb20-4613-91cd-9d1b39bfb216")]
            construct Interchange
            {
                [Microsoft.XLANGs.BaseTypes.DesignerPosition("860c8c13-fea6-4955-a24b-c034f9a747b6")]
                FSUMessageXML = FSUMessage;
                Interchange = CargoWise.eServices.eHub.Business.InterchageWrapHelper.WrapIntoInterchange(FSUMessageXML.OuterXml, "FSU");
                Interchange.InterchangeHeader.SenderID = "FSUSender";
                Interchange.InterchangeHeader.RecipientID = "Yusen";
            }
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("f0fe5926-5cb4-4e9a-864e-a8fcdf5ccb1b")]
            TransformType = typeof(CargoWise.eServices.eHub.Routing.Yusen.TransformToYusenFSU);
            PipelineType = typeof(CargoWise.eServices.eHub.Routing.Yusen.TransformFSU);
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("7e21a3cc-0e83-489a-93bf-8004279e0ac3")]
            call CargoWise.eServices.eHub.Routing.Shared.SendMessageInternal (Interchange, out SendResponse, TransformType, PipelineType) CallSendMessageInternal;
            [Microsoft.XLANGs.BaseTypes.DesignerPosition("dcb6a7ab-aa72-4c76-a643-00a0dcf79cb4")]
            send (ReponseToFSUSender.ResponseToSender, SendResponse);
        }
    }
