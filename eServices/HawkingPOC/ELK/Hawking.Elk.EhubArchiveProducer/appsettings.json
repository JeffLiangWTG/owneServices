{
    "Kafka": {
        "Producers": [
            {
                "producer": "Hawking.Elk.EhubArchiveProducer.MQ.Kafka.KafkaProducer",
                "bootstrap.servers": "localhost:9092",
                "topic": "thubarchivemessages"
            },
            {
                "producer": "hawking.tracking.message-events",
                "bootstrap.servers": "SYDCO-WBLN-2:9092",
                "topic": "hawking.tracking.message-events"
            }
        ],
        "Consumers": [
            {
                "consumer": "Hawking.Elk.ElasticSearchLoggingConsumer.MQ.Kafka.KafkaConsumer",
                "subscriptions": [
                    {
                        "topic": "thubarchivemessages",
                        "group.id": "Hawking.Elk.ElasticSearchLoggingConsumer",
                        "config.filepath": "thubarchivemessages.ini",
                        "bootstrap.servers": "localhost:9092",
                        "enable.auto.commit": false,
                        "auto.offset.reset": "earliest"
                    },
                    {
                        "topic": "hawking.tracking.message-events",
                        "group.id": "Hawking.Elk.ElasticSearchLoggingConsumer",
                        "config.filepath": "hawking.tracking.message-events.ini",
                        "bootstrap.servers": "SYDCO-WBLN-2:9092",
                        "enable.auto.commit": false,
                        "auto.offset.reset": "earliest"
                    }
                ]
            }
        ]
    },
