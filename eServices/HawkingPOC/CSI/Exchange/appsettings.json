{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "None"
    }
  },
  "HttpContentStoreClient": {
    "Uri": "http://content-store/v1/contents/"
  },
  "HttpMessageEventClient": {
    "Uri": "http://tracking/v1/events/"
  },
  "HttpForwardClient": {
    "Uri": "http://forward/v1/messages/"
  },
  "AllowedHosts": "*"
}