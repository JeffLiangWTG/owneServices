@page "/identity/details/{id}"
@attribute [Authorize(Policy = "eServicesAdmins")]
@using System.Security.Cryptography
@using System.Text

@inject UserManager<AppUser> UserManager
@inject AppAccessService AppAccessService
@inject NavigationManager NavigationManager

<PageTitle>App Access Details</PageTitle>

<h2>App Access</h2>

<div>
    <h4>Details</h4>
    <hr />
    @if (user is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">ID</dt>
            <dd class="col-sm-10">@user.UserName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Claims</dt>
            <dd class="col-sm-10">
                @foreach (var role in (claims ?? []).Order())
                {
                    @role<br/>
                }</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Contact</dt>
            <dd class="col-sm-10">@user.Email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Locked Out?</dt>
            <dd class="col-sm-10">@(user.LockoutEnd.GetValueOrDefault() > DateTimeOffset.UtcNow)</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Access Failed Count</dt>
            <dd class="col-sm-10">@user.AccessFailedCount</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Authorization Header</dt>
            <dd class="col-sm-10">@authHeader</dd>
        </dl>
        <div>
            <a href="@($"/identity/edit/{user.UserName}")">Edit</a> |
            <a href="@($"/identity")">Back to List</a>
        </div>
    }
</div>

@code {
    AppUser? user;
    IList<string>? claims;
    string? authHeader;

    [Parameter]
    public required string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.FindByNameAsync(Id);

        if (user is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        claims = await UserManager.GetRolesAsync(user);

        if (user?.AccessKey is not null)
        {
            authHeader = AppAccessService.GetBasicAuthHeader(user.UserName!, user.AccessKey);
        }
    }
}
