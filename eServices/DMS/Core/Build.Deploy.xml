  <!-- Common Settings
         Default settings that are available in deployments are:
            DAT_DEPLOYMENT_CONFIGURATION  - Value of DeploymentConfiguration in Build.xml.
            DAT_DEPLOYMENT_NAME           - DeploymentConfiguration with special characters removed.
            DAT_SOURCE_PATH               - Path to root of repo source files.
            DAT_BIN_PATH                  - Path to Bin folder.
            TIMESTAMP                     - UTC time at start of build. Format is "yyyyMMdd.HHmmssZ".-->
  <Settings>
    <Add Name="MSDEPLOY" Value="&quot;%ProgramFiles%\IIS\Microsoft Web Deploy V3\msdeploy.exe&quot; -allowUntrusted -verbose" />
    <Add Name="PUBLISH_PATH_ROOT" Value="%DAT_BIN_PATH%\Publish" />
    <Add Name="DEPLOY_STAGING_ROOT" Value="C:\eServices.Deploy" />
    <Add Name="CMD_CLEANUP_BACKUPS">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell if (Test-Path %DEPLOY_STAGING_ROOT%\%PROJECT_NAME%) { Get-ChildItem %DEPLOY_STAGING_ROOT%\%PROJECT_NAME% ^| Sort-Object Name ^| Select-Object -SkipLast 20 ^| Where-Object { ($_.Name -match '^^\d{8}\.\d{6}Z(\.Backup)?') } ^| Where-Object { ([DateTime]::ParseExact($_.Name.Substring(0,16), 'yyyyMMdd.HHmmssZ', $null) -lt [DateTime]::UtcNow.AddDays(-30)) } ^| Remove-Item -Recurse }",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]>
    </Add>
    <Add Name="CMD_PUBLISH_TO_STAGING_DIR">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:dirPath="%PUBLISH_PATH_ROOT%\%PROJECT_NAME%" -dest:dirPath="%DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%",%DEST_CONNECTION%
%MSDEPLOY% -verb:sync -source:dirPath="%DAT_SOURCE_PATH%\Scripts" -dest:dirPath="%DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%.Scripts",%DEST_CONNECTION%
]]>
    </Add>
    <Add Name="CMD_UPDATE_SETTINGS">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell %DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%.Scripts\webconfig-addsettings.ps1 %DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%\web.config @{ %SETTINGS% }",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%]]>
    </Add>
    <Add Name="CMD_BACKUP_CURRENT_SITE">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:apphostconfig="%SITE_NAME%",%DEST_CONNECTION% -dest:archivedir="%DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%.Backup\%SITE_NAME%.zip",%DEST_CONNECTION% -skip:objectName=dirPath,absolutePath='logs'
]]>
    </Add>
    <Add Name="CMD_INSTALL_DOTNET">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:runCommand="powershell -ExecutionPolicy RemoteSigned -Command %DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%.Scripts\dotnet-install.ps1 -Runtime aspnetcore -Channel 8.0 -InstallDir 'C:\Program Files\dotnet\' -NoPath",waitAttempts=1,waitInterval=60000 -dest:auto,%DEST_CONNECTION%
]]>
    </Add>
    <Add Name="CMD_DEPLOY_SITE">
      <![CDATA[
%MSDEPLOY% -verb:sync -source:iisApp="%DEPLOY_STAGING_ROOT%\%PROJECT_NAME%\%TIMESTAMP%",%DEST_CONNECTION% -dest:iisApp="%SITE_NAME%",%DEST_CONNECTION% -skip:objectName=dirPath,absolutePath='logs' -enablerule:AppOffline
]]>
    </Add>
  </Settings>
