# Top-most EditorConfig file
root = true

# C# code files
[*.cs]
indent_style = tab
tab_width = 4
end_of_line = crlf
trim_trailing_whitespace = true
dotnet_sort_system_directives_first = true

# XML-based project files
[{*.{xml,*proj,targets,props,nuspec},Build*.xml}]
indent_style = space
indent_size = 2
