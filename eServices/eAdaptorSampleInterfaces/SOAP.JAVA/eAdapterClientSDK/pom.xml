<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.cargowise.eservices.eadapter.client.sdk</groupId>
  <artifactId>eadapter-client-sdk</artifactId>
  <name>eAdapter Client SDK</name>
  <packaging>pom</packaging>
  <scm>
    <connection>scm:tfs:http://tfs.wtg.zone:8080:CargoWise:$/eServices/eAdaptorSampleInterfaces/SOAP.JAVA/eAdapterClientSDK</connection>
    <developerConnection>scm:tfs:http://tfs.wtg.zone:8080:CargoWise:$/eServices/eAdaptorSampleInterfaces/SOAP.JAVA/eAdapterClientSDK</developerConnection>
  </scm>
  <parent>
    <groupId>com.cargowise.eservices</groupId>
    <artifactId>eservices-repo-pom</artifactId>
    <version>1.0.0</version>
  </parent>
  <modules>
  	<module>../eAdapterClient</module>
  	<module>../eAdapterClientSample</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>2.10</version>
        <executions>
          <execution>
            <id>jar-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <failOnMissingClassifierArtifact>false</failOnMissingClassifierArtifact>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>com.cargowise.eservices.eadapter.client</groupId>
                  <artifactId>eadapter-client</artifactId>
                  <version>1.0.0</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.cargowise.eservices.eadapter.client</groupId>
                  <artifactId>eadapter-client</artifactId>
                  <version>1.0.0</version>
                  <classifier>javadoc</classifier>
                </artifactItem>
                <artifactItem>
                  <groupId>com.cargowise.eservices.eadapter.client.sample</groupId>
                  <artifactId>eadapter-client-sample</artifactId>
                  <version>1.0.0</version>
                </artifactItem>
                <artifactItem>
                  <groupId>com.cargowise.eservices.eadapter.client.sample</groupId>
                  <artifactId>eadapter-client-sample</artifactId>
                  <version>1.0.0</version>
                  <classifier>sources</classifier>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.5.4</version>
	    <configuration>
	      <descriptor>zip.xml</descriptor>
	      <finalName>eAdapterSDK-${project.version}</finalName>
	      <appendAssemblyId>false</appendAssemblyId>
	    </configuration>
	    <executions>
	      <execution>
	      	<id>packaging-zip</id>
	        <phase>package</phase>
	        <goals>
	          <goal>single</goal>
	        </goals>
	      </execution>
	    </executions>
	  </plugin>
    </plugins>
  </build>
</project>
