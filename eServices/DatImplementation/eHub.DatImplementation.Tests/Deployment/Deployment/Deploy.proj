<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildProjectDirectory)\Deployment.props"/>
  <Import Project="$(MSBuildProjectDirectory)\Profiles\$(Profile)\Deployment.props" Condition="'$(Profile)' != ''"/>

  <Target Name="dat:package">
    <Message Text="dat:package" Importance="high"/>
  </Target>
  
  <Target Name="dat:deploy">		
    <Message Text="dat:deploy" Importance="high"/>
  </Target>

  <Target Name="dat:remove">
    <Message Text="dat:remove" Importance="high"/>
  </Target>

  <Target Name="bat:deploy">
    <Message Text="bat:deploy" Importance="high"/>
  </Target>

</Project>